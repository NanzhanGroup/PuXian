# xmlrpc 0.1.0 测试
import "../registry/xmlrpc/0.1.0/xmlrpc.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def _find_from(s, sub, start):
    var i = start
    while i <= len(s) - len(sub):
        var ok = true
        var j = 0
        while j < len(sub):
            if s[i + j] != sub[j]:
                ok = false
            j += 1
        if ok:
            return i
        i += 1
    return -1
def main():
    # build request
    var req = xr_build_request("add", [1, 2])
    expect(req.find("<methodName>add</methodName>") >= 0, "method name")
    expect(req.find("<int>1</int>") >= 0, "int 1")
    expect(req.find("<int>2</int>") >= 0, "int 2")
    # encode values
    expect(xr_encode_value(42) == "<value><int>42</int></value>", "encode int")
    expect(xr_encode_value(true) == "<value><boolean>1</boolean></value>", "encode bool true")
    expect(xr_encode_value(false) == "<value><boolean>0</boolean></value>", "encode bool false")
    expect(xr_encode_value("hello") == "<value><string>hello</string></value>", "encode string")
    # build response
    var resp = xr_build_response(42)
    expect(resp.find("<methodResponse>") >= 0, "response has methodResponse")
    expect(resp.find("<int>42</int>") >= 0, "response has int 42")
    # build fault
    var fault = xr_build_fault(404, "Not Found")
    expect(fault.find("<int>404</int>") >= 0, "fault code")
    expect(fault.find("Not Found") >= 0, "fault message")
    # extract method
    expect(xr_extract_method(req) == "add", "extract method: " + xr_extract_method(req))
    # parse response
    var parsed = xr_parse_response(resp)
    expect(parsed["ok"] == true, "parsed ok")
    expect(parsed["value"] == 42, "parsed value: " + str(parsed["value"]))
    # parse fault
    var parsed_fault = xr_parse_response(fault)
    expect(parsed_fault["ok"] == false, "parsed fault not ok")
    expect(parsed_fault["code"] == 404, "parsed fault code: " + str(parsed_fault["code"]))
    # parse string response
    var str_resp = xr_build_response("hello")
    var parsed_str = xr_parse_response(str_resp)
    expect(parsed_str["ok"] == true, "parsed str ok")
    expect(parsed_str["value"] == "hello", "parsed str value: " + str(parsed_str["value"]))
    print("xmlrpc: PASS")
