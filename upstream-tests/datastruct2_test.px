# datastruct 0.2.0 测试
import "../registry/datastruct/0.2.0/datastruct.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- 0.1.0 回归 ----
    var h = ds_heap_new()
    ds_heap_push(h, 3, "c")
    ds_heap_push(h, 1, "a")
    ds_heap_push(h, 2, "b")
    var top = ds_heap_pop(h).unwrap()
    expect(top == "a", "heap pop a: " + str(top))
    # ---- 0.1.0 stack 回归 ----
    var st = ds_stack_new()
    ds_stack_push(st, 1)
    ds_stack_push(st, 2)
    expect(ds_stack_pop(st).unwrap() == 2, "stack pop 2")
    expect(ds_stack_pop(st).unwrap() == 1, "stack pop 1")
    expect(ds_stack_len(st) == 0, "stack empty")
    # ---- 0.2.0 deque ----
    var dq = ds_deque_new()
    ds_deque_push_back(dq, 1)
    ds_deque_push_back(dq, 2)
    expect(ds_deque_pop_front(dq).unwrap() == 1, "deque pop_front 1")
    # ---- 0.2.0 sorted_insert ----
    var arr = ds_sorted_insert([1, 3, 5], 2)
    expect(arr == [1, 2, 3, 5], "sorted_insert: " + str(arr))
    # ---- 0.2.0 bsearch ----
    var idx = ds_bsearch([1, 2, 3, 4, 5], 3).unwrap()
    expect(idx == 2, "bsearch 3 at 2: " + str(idx))
    print("PASS: datastruct 0.2.0")
