# datetime.px 测试：双模式一致（参考 Go time 子集）
import "../registry/datetime/0.1.0/datetime.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    var sec = dt_parse("2026-09-20 12:00:00")
    expect(sec == 1789905600, "parse 已知秒: " + str(sec))
    expect(dt_format(sec) == "2026-09-20 12:00:00", "format UTC 一致往返: " + dt_format(sec))
    # 运算
    expect(dt_add(sec, 3600) == sec + 3600, "add 秒")
    expect(dt_diff(sec + 60, sec) == 60, "diff")
    expect(dt_add_days(sec, 1) == sec + 86400, "add days")
    expect(dt_add_days(sec, -1) == sec - 86400, "sub days")
    # 天数差
    expect(dt_days_between(sec, sec + 86400) == 1, "1 天")
    expect(dt_days_between(sec, sec + 86400 * 3) == 3, "3 天")
    expect(dt_days_between(sec, sec - 86400) == -1, "负 1 天")
    expect(dt_days_between(sec, sec + 3600) == 0, "不足 1 天取 0")
    # now 系列
    var n = dt_now_sec()
    expect(abs(dt_now_sec() - n) < 5, "now_sec 近实时")
    var ns = dt_now()
    expect(len(ns) == 19, "now 长度 19: " + ns)
    # 自定义 fmt
    var s2 = dt_parse("2026/09/20", "%Y/%m/%d")
    expect(s2 > 0, "自定义格式 parse: " + str(s2))
    # 工作日（Zeller；Python date.weekday() 对拍）
    expect(dt_weekday(1970, 1, 1) == 3, "1970-01-01 周四(3)")
    expect(dt_weekday(2000, 1, 1) == 5, "2000-01-01 周六(5)")
    expect(dt_weekday(2024, 2, 29) == 3, "2024-02-29 周四(3)")
    expect(dt_weekday(2026, 9, 24) == 3, "2026-09-24 周四(3)")
    expect(dt_weekday(2026, 9, 25) == 4, "2026-09-25 周五(4)")
    # ISO8601 解析（UTC 基准 + 时区换算）
    var base2 = dt_parse("2026-09-24 06:22:23")
    expect(dt_iso_parse("2026-09-24T06:22:23Z").unwrap() == base2, "ISO Z 解析")
    expect(dt_iso_parse("2026-09-24T06:22:23+08:00").unwrap() == base2 - 28800, "ISO +08:00 换算")
    expect(dt_iso_parse("2026-09-24T06:22:23+0800").unwrap() == base2 - 28800, "ISO +0800 换算")
    expect(dt_iso_parse("2026-09-24").unwrap() == dt_parse("2026-09-24 00:00:00"), "ISO 纯日期")
    expect(dt_iso_parse("2026-09-24T06:22:23.123Z").unwrap() == base2, "ISO 小数秒截断")
    expect(dt_iso_parse("not a date").is_err(), "ISO 非法 Err")
    # ISO8601 格式化（UTC Z）
    expect(dt_iso_format(base2) == "2026-09-24T06:22:23Z", "ISO format: " + dt_iso_format(base2))
    # 相对时间
    expect(dt_humane(sec + 30, sec) == "刚刚", "30s 刚刚")
    expect(dt_humane(sec + 180, sec) == "3分钟前", "3分钟前")
    expect(dt_humane(sec + 7200, sec) == "2小时前", "2小时前")
    expect(dt_humane(sec + 3 * 86400, sec) == "3天前", "3天前")
    expect(dt_humane(sec - 7200, sec) == "2小时后", "未来 2 小时后")
    expect(dt_humane(sec + 61 * 86400, sec) == "2个月前", "61 天 2 个月前")
    expect(dt_humane(sec + 400 * 86400, sec) == "1年前", "400 天 1 年前")
    print("datetime: PASS")
