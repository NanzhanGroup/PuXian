# tdtest.px 测试：表驱动测试增强（双模式一致）
import "../registry/tdtest/0.1.0/tdtest.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def add1(x):
    return x + 1
def double(x):
    return x * 2
def is_two(x):
    return x == 2
def is_hi(x):
    return x == "hi"
def main():
    # 全过
    var cases = []
    cases.append({"name": "add1", "fn": add1, "args": 1, "want": 2})
    cases.append({"name": "add1-neg", "fn": add1, "args": -1, "want": 0})
    cases.append({"name": "double", "fn": double, "args": 21, "want": 42})
    cases.append({"name": "check-谓词", "fn": add1, "args": 1, "check": is_two})
    var r1 = td_run(cases)
    expect(r1.is_ok(), "td_run Ok")
    var s1 = r1.unwrap()
    expect(s1["pass"] == 4 and s1["fail"] == 0 and s1["total"] == 4,
        "4/4 过, got " + str(s1))
    # 含失败
    var cases2 = []
    cases2.append({"name": "ok", "fn": add1, "args": 1, "want": 2})
    cases2.append({"name": "bad", "fn": add1, "args": 1, "want": 99})
    cases2.append({"name": "bad-check", "fn": double, "args": 2, "check": is_hi})
    var r2 = td_run(cases2)
    var s2 = r2.unwrap()
    expect(s2["pass"] == 1 and s2["fail"] == 2 and s2["total"] == 3,
        "1/3 过, got " + str(s2))
    expect(len(s2["failures"]) == 2, "失败明细 2 条")
    expect(s2["failures"][0]["name"] == "bad" and s2["failures"][0]["got"] == 2
        and s2["failures"][0]["want"] == 99, "want 失败项内容")
    expect(s2["failures"][1]["name"] == "bad-check", "check 失败项内容")
    # 缺 want/check → 记为失败
    var cases3 = []
    cases3.append({"name": "no-assert", "fn": add1, "args": 1})
    var s3 = td_run(cases3).unwrap()
    expect(s3["fail"] == 1, "缺断言应失败")
    print("tdtest: PASS")
    return Ok(0)
