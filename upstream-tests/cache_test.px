# cache.px 测试：TTL / LRU 缓存（显式 now，双模式一致）
import "../registry/cache/0.1.0/cache.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    var c = ca_new(3)
    # 基础存取
    ca_set(c, "a", 1, 0, 1000)
    ca_set(c, "b", 2, 0, 1000)
    expect(ca_get(c, "a", 1000).unwrap() == 1, "get a")
    expect(ca_has(c, "b", 1000), "has b")
    expect(ca_len(c, 1000) == 2, "len=2")
    ca_delete(c, "a")
    expect(ca_get(c, "a", 1000).is_err(), "delete 后 Err")
    expect(ca_len(c, 1000) == 1, "len=1 after delete")
    # TTL 过期
    ca_set(c, "tmp", "x", 100, 1000)
    expect(ca_get(c, "tmp", 1050).unwrap() == "x", "未过期")
    expect(ca_get(c, "tmp", 1100).is_err(), "1100 过期（<=）")
    expect(ca_has(c, "tmp", 1200) == false, "过期后 has false")
    # LRU 驱逐：max=2
    var c2 = ca_new(2)
    ca_set(c2, "a", 1, 0, 1000)
    ca_set(c2, "b", 2, 0, 1000)
    ca_get(c2, "a", 1000)  # 触达 a
    ca_set(c2, "c", 3, 0, 1000)  # 满 → 驱逐最久未用 b
    expect(ca_get(c2, "a", 1000).unwrap() == 1, "a 保留（刚触达）")
    expect(ca_get(c2, "c", 1000).unwrap() == 3, "c 在")
    expect(ca_get(c2, "b", 1000).is_err(), "b 被驱逐")
    expect(ca_len(c2, 1000) == 2, "len=2")
    # 覆盖刷新过期时间
    ca_set(c2, "a", 99, 50, 1000)
    expect(ca_get(c2, "a", 1040).unwrap() == 99, "覆盖后新值")
    expect(ca_get(c2, "a", 1060).is_err(), "覆盖后过期")
    # max_entries=1
    var c3 = ca_new(1)
    ca_set(c3, "x", 1, 0, 0)
    ca_set(c3, "y", 2, 0, 0)
    expect(ca_get(c3, "x", 0).is_err() and ca_get(c3, "y", 0).unwrap() == 2, "max=1 驱逐")
    print("cache: PASS")
    return Ok(0)