# bitset 0.2.0 测试
import "../registry/bitset/0.2.0/bitset.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    var b = bs_new(16).unwrap()
    bs_set(b, 1)
    bs_set(b, 3)
    bs_set(b, 5)
    expect(bs_test(b, 1).unwrap() == true, "test 1")
    expect(bs_test(b, 2).unwrap() == false, "test 2")
    expect(bs_count(b) == 3, "count 3")
    expect(bs_to_list(b) == [1, 3, 5], "to_list: " + str(bs_to_list(b)))
    # ---- 0.2.0 and/or/xor ----
    var a2 = bs_new(16).unwrap()
    bs_set(a2, 1)
    bs_set(a2, 7)
    var band = bs_and(b, a2).unwrap()
    expect(bs_to_list(band) == [1], "and: " + str(bs_to_list(band)))
    var bor = bs_or(b, a2).unwrap()
    expect(bs_to_list(bor) == [1, 3, 5, 7], "or: " + str(bs_to_list(bor)))
    var bxor = bs_xor(b, a2).unwrap()
    expect(bs_to_list(bxor) == [3, 5, 7], "xor: " + str(bs_to_list(bxor)))
    # ---- 0.2.0 not ----
    var bnot = bs_not(b).unwrap()
    expect(bs_count(bnot) == 13, "not count 13")
    # ---- 0.2.0 intersects/is_subset ----
    expect(bs_intersects(b, a2) == true, "intersects true")
    var b3 = bs_new(16).unwrap()
    bs_set(b3, 9)
    expect(bs_intersects(b, b3) == false, "intersects false")
    expect(bs_is_subset(band, bor) == true, "subset true")
    # ---- 0.2.0 from_list/to_string ----
    var bf = bs_from_list(8, [0, 2, 4]).unwrap()
    expect(bs_to_list(bf) == [0, 2, 4], "from_list: " + str(bs_to_list(bf)))
    expect(bs_to_string(bf) == "10101000", "to_string: " + bs_to_string(bf))
    print("PASS: bitset 0.2.0")
