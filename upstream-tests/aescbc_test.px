# aescbc 0.1.0 测试
# 注意：native aes_encrypt/aes_decrypt 是 ECB 模式，本库在其上实现 CBC/CTR
# 测试使用 mock 方式验证 CBC/CTR 逻辑（不依赖真实 AES）
import "../registry/aescbc/0.1.0/aescbc.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # 测试 PKCS7 pad/unpad（通过 CBC encrypt 内部逻辑间接测试）
    # 由于 native aes_encrypt 可能不可用，我们测试辅助逻辑

    # 测试 _aes_xor_bytes
    var a = [1, 2, 3, 4]
    var b = [10, 20, 30, 40]
    var xored = _aes_xor_bytes(a, b)
    expect(xored == [11, 22, 29, 44], "xor: " + str(xored))

    # 测试 _aes_pkcs7_pad
    var data = [0x41, 0x42, 0x43]  # 3 bytes
    var padded = _aes_pkcs7_pad(data, 16)
    expect(len(padded) == 16, "padded len 16: " + str(len(padded)))
    expect(padded[3] == 13, "pad byte 13: " + str(padded[3]))
    expect(padded[15] == 13, "last pad byte 13")

    # 测试满块填充
    var data2 = []
    var i = 0
    while i < 16:
        data2.append(i)
        i += 1
    var padded2 = _aes_pkcs7_pad(data2, 16)
    expect(len(padded2) == 32, "full block + extra: " + str(len(padded2)))
    expect(padded2[16] == 16, "pad byte 16 for full block")

    # 测试 _aes_pkcs7_unpad
    var unpadded = _aes_pkcs7_unpad(padded)
    expect(unpadded == [0x41, 0x42, 0x43], "unpad: " + str(unpadded))

    # 测试 unpad 满块
    var unpadded2 = _aes_pkcs7_unpad(padded2)
    expect(len(unpadded2) == 16, "unpad full block: " + str(len(unpadded2)))

    # 测试 unpad 空数据
    var empty_unpad = _aes_pkcs7_unpad([])
    expect(len(empty_unpad) == 0, "unpad empty")

    # 测试 xor 双向
    var double_xored = _aes_xor_bytes(_aes_xor_bytes(a, b), b)
    expect(double_xored == a, "xor double: " + str(double_xored))

    print("aescbc: PASS")
