# parser 0.2.0 测试
import "../registry/parser/0.2.0/parser.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- 0.1.0 回归 ----
    var r = p_digit("5", 0).unwrap()
    expect(r[1] == "5", "digit 5: " + str(r))
    var r2 = p_letter("a", 0).unwrap()
    expect(r2[1] == "a", "letter a: " + str(r2))
    # ---- 0.2.0 parse_int ----
    var ri = p_parse_int("123abc", 0)
    expect(ri[0] == true and ri[1] == 123, "parse_int 123: " + str(ri))
    var ri2 = p_parse_int("-45xyz", 0)
    expect(ri2[0] == true and ri2[1] == -45, "parse_int -45: " + str(ri2))
    # ---- 0.2.0 parse_float ----
    var rf = p_parse_float("3.14abc", 0)
    expect(rf[0] == true and rf[1] == 3.14, "parse_float 3.14: " + str(rf))
    # ---- 0.2.0 parse_quoted ----
    var rq = p_parse_quoted("\"hello\" rest", 0)
    expect(rq[0] == true and rq[1] == "hello", "parse_quoted hello: " + str(rq))
    print("PASS: parser 0.2.0")
