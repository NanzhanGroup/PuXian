# jsonschema 0.1.0 测试
import "../registry/jsonschema/0.1.0/jsonschema.px"

def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)

def main():
    # 类型验证
    var r = js_validate("hello", {"type": "string"})
    expect(r["valid"] == true, "type string valid")
    r = js_validate(42, {"type": "string"})
    expect(r["valid"] == false, "type string invalid")
    r = js_validate(42, {"type": "integer"})
    expect(r["valid"] == true, "type integer valid")
    r = js_validate(3.14, {"type": "number"})
    expect(r["valid"] == true, "type number valid")
    r = js_validate(true, {"type": "boolean"})
    expect(r["valid"] == true, "type boolean valid")
    r = js_validate([1, 2], {"type": "array"})
    expect(r["valid"] == true, "type array valid")
    r = js_validate({"a": 1}, {"type": "object"})
    expect(r["valid"] == true, "type object valid")
    # 字符串约束
    r = js_validate("abc", {"type": "string", "minLength": 2, "maxLength": 5})
    expect(r["valid"] == true, "string constraints valid")
    r = js_validate("a", {"type": "string", "minLength": 2})
    expect(r["valid"] == false, "string too short: " + str(r["errors"]))
    r = js_validate("abcdef", {"type": "string", "maxLength": 5})
    expect(r["valid"] == false, "string too long: " + str(r["errors"]))
    # 数字约束
    r = js_validate(5, {"type": "integer", "minimum": 1, "maximum": 10})
    expect(r["valid"] == true, "number constraints valid")
    r = js_validate(0, {"type": "integer", "minimum": 1})
    expect(r["valid"] == false, "number below minimum: " + str(r["errors"]))
    r = js_validate(11, {"type": "integer", "maximum": 10})
    expect(r["valid"] == false, "number above maximum: " + str(r["errors"]))
    r = js_validate(4, {"type": "integer", "multipleOf": 2})
    expect(r["valid"] == true, "number multipleOf valid")
    r = js_validate(3, {"type": "integer", "multipleOf": 2})
    expect(r["valid"] == false, "number multipleOf invalid: " + str(r["errors"]))
    # 数组约束
    r = js_validate([1, 2, 3], {"type": "array", "minItems": 2, "maxItems": 5})
    expect(r["valid"] == true, "array constraints valid")
    r = js_validate([1], {"type": "array", "minItems": 2})
    expect(r["valid"] == false, "array too few: " + str(r["errors"]))
    r = js_validate([1, 2, 3], {"type": "array", "items": {"type": "integer", "minimum": 0}})
    expect(r["valid"] == true, "array items valid")
    r = js_validate([1, -2, 3], {"type": "array", "items": {"type": "integer", "minimum": 0}})
    expect(r["valid"] == false, "array items invalid: " + str(r["errors"]))
    # 对象约束
    var schema = {"type": "object", "required": ["name", "age"], "properties": {"name": {"type": "string", "minLength": 1}, "age": {"type": "integer", "minimum": 0}}}
    r = js_validate({"name": "Alice", "age": 30}, schema)
    expect(r["valid"] == true, "object valid")
    r = js_validate({"name": "Alice"}, schema)
    expect(r["valid"] == false, "object missing required: " + str(r["errors"]))
    r = js_validate({"name": "", "age": 30}, schema)
    expect(r["valid"] == false, "object property invalid: " + str(r["errors"]))
    r = js_validate({"name": "Alice", "age": -5}, schema)
    expect(r["valid"] == false, "object property negative: " + str(r["errors"]))
    # 枚举
    r = js_validate("red", {"type": "string", "enum": ["red", "green", "blue"]})
    expect(r["valid"] == true, "enum valid")
    r = js_validate("yellow", {"type": "string", "enum": ["red", "green", "blue"]})
    expect(r["valid"] == false, "enum invalid: " + str(r["errors"]))
    # 嵌套
    var nested = {"type": "object", "properties": {"items": {"type": "array", "items": {"type": "integer"}}}}
    r = js_validate({"items": [1, 2, 3]}, nested)
    expect(r["valid"] == true, "nested valid")
    r = js_validate({"items": [1, "a", 3]}, nested)
    expect(r["valid"] == false, "nested invalid: " + str(r["errors"]))
    print("jsonschema: PASS")
