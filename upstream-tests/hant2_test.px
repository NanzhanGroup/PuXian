# hant 0.2.0 测试
import "../registry/hant/0.2.0/hant.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- 0.1.0 回归 ----
    var t = hant_s2t("简体中文").unwrap()
    expect(len(t) > 0, "s2t non-empty")
    var s = hant_t2s(t).unwrap()
    expect(s == "简体中文", "t2s(s2t(x)) == x: " + s)
    # ---- 0.2.0 count_traditional ----
    var cnt = hant_count_traditional("繁體字")
    expect(cnt > 0, "count_traditional > 0: " + str(cnt))
    # ---- 0.2.0 count_simplified ----
    var cnt2 = hant_count_simplified("简体字")
    expect(cnt2 > 0, "count_simplified > 0: " + str(cnt2))
    # ---- 0.2.0 batch ----
    var batch = hant_s2t_batch("中国语言").unwrap()
    expect(len(batch) > 0, "s2t_batch non-empty")
    print("PASS: hant 0.2.0")
