# passhash.px 测试：双模式一致（参考 Go bcrypt/pbkdf2）
import "../registry/passhash/0.1.0/passhash.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # hash + verify roundtrip
    var r = pass_hash("hunter2")
    expect(r.is_ok(), "hash 应 Ok")
    var stored = r.unwrap()
    expect(starts_with(stored, "pbkdf2$10000$"), "存储格式前缀: " + stored)
    expect(pass_verify("hunter2", stored), "正确密码 verify true")
    expect(not pass_verify("wrong", stored), "错误密码 verify false")
    # 指定 salt → 确定性
    var r2 = pass_hash("pw", "aabbccddeeff00112233445566778899", 1000)
    expect(r2.is_ok() and r2.unwrap() ==
        "pbkdf2$1000$aabbccddeeff00112233445566778899$" + r2.unwrap().split("$")[3],
        "指定 salt 结构")
    # 与 Python hashlib.pbkdf2_hmac 交叉验证（salt 按 16 字节 hex 解码）
    var r3 = pass_hash("pw", "aabbccddeeff00112233445566778899", 1000)
    var seg = split(r3.unwrap(), "$")
    expect(seg[3] == "79be141a3e02d5acf4cc3f50cde2c54725070cf1f1e3e75dac4a8120e9035278",
        "Python golden 一致: " + seg[3])
    # 不同 salt → 不同 hash
    var h1 = pass_hash("pw").unwrap()
    var h2 = pass_hash("pw").unwrap()
    expect(h1 != h2, "随机 salt 产生不同 hash")
    expect(pass_verify("pw", h1) and pass_verify("pw", h2), "各自可验证")
    # 无效存储串
    expect(not pass_verify("pw", "garbage"), "乱串 false")
    expect(not pass_verify("pw", "bcrypt$10$xxx"), "非 pbkdf2 格式 false")
    expect(not pass_verify("pw", "pbkdf2$abc$x$y"), "iters 非整数 false")
    print("passhash: PASS")
