# xmlstream 0.1.0 测试
import "../registry/xmlstream/0.1.0/xmlstream.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    var w = xw_new()
    xw_start_document(w)
    xw_start_element(w, "root", {"version": "1.0", "lang": "en"})
    xw_write_element(w, "name", "test")
    xw_start_element(w, "items", {})
    xw_write_element(w, "item", "a")
    xw_write_element(w, "item", "b")
    xw_end_element(w, "items")
    xw_comment(w, "a comment")
    xw_write_cdata(w, "<raw>data</raw>")
    xw_end_element(w, "root")
    xw_end_document(w)
    var out = xw_get_output(w)
    expect(out.find("<?xml") >= 0, "has declaration")
    expect(out.find("<root version=\"1.0\" lang=\"en\">") >= 0, "has root with attrs: " + out)
    expect(out.find("<name>test</name>") >= 0, "has name element")
    expect(out.find("<item>a</item>") >= 0, "has item a")
    expect(out.find("</root>") >= 0, "has closing root")
    expect(out.find("<!-- a comment -->") >= 0, "has comment")
    expect(out.find("<![CDATA[<raw>data</raw>]]>") >= 0, "has CDATA")
    # reader — 验证属性解析
    var r = xr_new(out)
    var tag1 = xr_read_next(r)
    expect(tag1 != null, "read first tag")
    expect(tag1["type"] == "pi", "first is PI")
    var tag2 = xr_read_next(r)
    expect(tag2 != null, "read second tag")
    expect(tag2["type"] == "start", "second is start")
    expect(tag2["name"] == "root", "root name: " + tag2["name"])
    expect(tag2["attrs"]["version"] == "1.0", "attr version: " + str(tag2["attrs"]["version"]))
    expect(tag2["attrs"]["lang"] == "en", "attr lang: " + str(tag2["attrs"]["lang"]))
    # 读取 name 元素
    var tag3 = xr_read_next(r)
    expect(tag3["name"] == "name", "name tag: " + tag3["name"])
    # 读取 </name> 和 items 元素
    var tag_end_name = xr_read_next(r)
    expect(tag_end_name["type"] == "end", "end name tag")
    var tag4 = xr_read_next(r)
    expect(tag4["name"] == "items", "items tag: " + tag4["name"])
    # 测试自闭合标签
    var w2 = xw_new()
    xw_start_document(w2)
    xw_write_raw(w2, "<br/>")
    var out2 = xw_get_output(w2)
    var r2 = xr_new(out2)
    var pi = xr_read_next(r2)
    var br = xr_read_next(r2)
    expect(br["name"] == "br", "br tag: " + br["name"])
    expect(br["self_closing"] == true, "br self-closing")
    print("xmlstream: PASS")
