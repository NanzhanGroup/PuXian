# ntp 0.1.0 测试
import "../registry/ntp/0.1.0/ntp.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # 构造请求包
    var req = ntp_build_request()
    expect(len(req) == 48, "packet length 48: " + str(len(req)))
    expect(req[0] == 0x1B, "LI/VN/Mode byte: " + str(req[0]))
    # NTP 时间戳转换
    var unix_ts = ntp_to_unix([NTP_EPOCH_DELTA + 1000, 0])
    expect(unix_ts == 1000.0, "ntp_to_unix: " + str(unix_ts))
    # 带小数的 NTP 时间戳
    var unix_ts2 = ntp_to_unix([NTP_EPOCH_DELTA + 100, 2147483648])
    expect(unix_ts2 > 100.0 and unix_ts2 < 101.0, "ntp_to_unix with frac: " + str(unix_ts2))
    # offset 计算
    # T1=100, T2=101, T3=101, T4=102 → offset = ((101-100)+(101-102))/2 = 0
    var off1 = ntp_offset(100.0, 101.0, 101.0, 102.0)
    expect(off1 == 0.0, "offset 0: " + str(off1))
    # T1=100, T2=102, T3=102, T4=103 → offset = ((102-100)+(102-103))/2 = 0.5
    var off2 = ntp_offset(100.0, 102.0, 102.0, 103.0)
    expect(off2 == 0.5, "offset 0.5: " + str(off2))
    # roundtrip 计算
    # T1=100, T2=101, T3=101, T4=102 → roundtrip = (102-100)-(101-101) = 2
    var rt1 = ntp_roundtrip(100.0, 101.0, 101.0, 102.0)
    expect(rt1 == 2.0, "roundtrip 2: " + str(rt1))
    # T1=100, T2=101, T3=102, T4=104 → roundtrip = (104-100)-(102-101) = 3
    var rt2 = ntp_roundtrip(100.0, 101.0, 102.0, 104.0)
    expect(rt2 == 3.0, "roundtrip 3: " + str(rt2))
    # 解析响应（构造一个简化的 NTP 响应包）
    var resp = []
    var i = 0
    while i < 48:
        resp.append(0)
        i += 1
    resp[0] = 0x1C  # LI=0, VN=4, Mode=4 (server)
    resp[1] = 1     # Stratum=1
    # 设置 Transmit Timestamp (bytes 40-43) = NTP 纪元 + 2000
    var tx_secs = NTP_EPOCH_DELTA + 2000
    resp[40] = (tx_secs >> 24) & 0xFF
    resp[41] = (tx_secs >> 16) & 0xFF
    resp[42] = (tx_secs >> 8) & 0xFF
    resp[43] = tx_secs & 0xFF
    # 设置 Receive Timestamp (bytes 32-35) = NTP 纪元 + 1999
    var rx_secs = NTP_EPOCH_DELTA + 1999
    resp[32] = (rx_secs >> 24) & 0xFF
    resp[33] = (rx_secs >> 16) & 0xFF
    resp[34] = (rx_secs >> 8) & 0xFF
    resp[35] = rx_secs & 0xFF
    var parsed = ntp_parse_response(resp, 0)
    expect(parsed["mode"] == 4, "server mode: " + str(parsed["mode"]))
    expect(parsed["stratum"] == 1, "stratum 1")
    expect(parsed["t3"] == 2000.0, "t3 (tx): " + str(parsed["t3"]))
    expect(parsed["t2"] == 1999.0, "t2 (rx): " + str(parsed["t2"]))
    print("ntp: PASS")
