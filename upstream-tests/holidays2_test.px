# holidays 0.2.0 测试
import "../registry/holidays/0.2.0/holidays.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- 0.1.0 回归 ----
    expect(hd_is_leap(2024) == true, "2024 is leap")
    expect(hd_is_leap(2023) == false, "2023 not leap")
    expect(hd_days_in_month(2024, 2) == 29, "Feb 2024 = 29")
    expect(hd_weekday(2024, 1, 1) == 1, "2024-01-01 is Monday")
    # ---- 0.2.0 format ----
    expect(hd_format(2024, 1, 5) == "2024-01-05", "format: " + hd_format(2024, 1, 5))
    expect(hd_format(2024, 10, 15) == "2024-10-15", "format 10/15")
    # ---- 0.2.0 quarter ----
    expect(hd_quarter(2024, 1) == 1, "Q1")
    expect(hd_quarter(2024, 4) == 2, "Q2")
    expect(hd_quarter(2024, 7) == 3, "Q3")
    expect(hd_quarter(2024, 10) == 4, "Q4")
    # ---- 0.2.0 is_weekend ----
    expect(hd_is_weekend(2024, 1, 6) == true, "2024-01-06 is weekend")
    expect(hd_is_weekend(2024, 1, 1) == false, "2024-01-01 not weekend")
    # ---- 0.2.0 diff ----
    expect(hd_diff(2024, 1, 1, 2024, 1, 2) == 1, "diff 1 day")
    expect(hd_diff(2024, 1, 1, 2024, 2, 1) == 31, "diff 31 days: " + str(hd_diff(2024, 1, 1, 2024, 2, 1)))
    # ---- 0.2.0 add_days ----
    var d = hd_add_days(2024, 1, 1, 31)
    expect(d["m"] == 2 and d["d"] == 1, "add 31 days: " + str(d))
    print("PASS: holidays 0.2.0")
