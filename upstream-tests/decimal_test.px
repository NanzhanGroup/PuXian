# decimal.px 测试：双模式一致 + 与 Python Decimal(OpenSSL/精确) 对拍
import "../registry/decimal/0.1.0/decimal.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- add / sub / mul（Python Decimal 对拍）----
    var addcases = [["1.5", "2.25", "3.75"], ["1", "0.5", "1.5"], ["0.1", "0.2", "0.3"],
        ["-1.5", "2.25", "0.75"], ["123.456", "0.001", "123.457"],
        ["999999999999.99", "0.01", "1000000000000"], ["0.5", "-0.25", "0.25"],
        ["100", "-0.001", "99.999"]]
    var i = 0
    while i < len(addcases):
        var c = addcases[i]
        expect(dec_add(c[0], c[1]).unwrap() == c[2], "add " + c[0] + "+" + c[1] + " 应 " + c[2] + " 得 " + str(dec_add(c[0], c[1])))
        i += 1
    var subcases = [["1.5", "2.25", "-0.75"], ["1", "0.5", "0.5"], ["0.1", "0.2", "-0.1"],
        ["123.456", "0.001", "123.455"], ["0.5", "-0.25", "0.75"], ["100", "-0.001", "100.001"]]
    i = 0
    while i < len(subcases):
        var c = subcases[i]
        expect(dec_sub(c[0], c[1]).unwrap() == c[2], "sub " + c[0] + "-" + c[1] + " 应 " + c[2] + " 得 " + str(dec_sub(c[0], c[1])))
        i += 1
    var mulcases = [["1.5", "2.25", "3.375"], ["0.1", "0.2", "0.02"], ["-1.5", "2.25", "-3.375"],
        ["123.456", "0.001", "0.123456"], ["999999999999.99", "0.01", "9999999999.9999"],
        ["100", "-0.001", "-0.1"]]
    i = 0
    while i < len(mulcases):
        var c = mulcases[i]
        expect(dec_mul(c[0], c[1]).unwrap() == c[2], "mul " + c[0] + "*" + c[1] + " 应 " + c[2] + " 得 " + str(dec_mul(c[0], c[1])))
        i += 1
    # ---- div（places=4，half-up）----
    var divcases = [["1", "3", "0.3333"], ["10", "4", "2.5"], ["-7", "2", "-3.5"],
        ["0.1", "0.3", "0.3333"], ["1", "7", "0.1429"]]
    i = 0
    while i < len(divcases):
        var c = divcases[i]
        expect(dec_div(c[0], c[1], 4).unwrap() == c[2], "div " + c[0] + "/" + c[1] + " 应 " + c[2] + " 得 " + str(dec_div(c[0], c[1], 4)))
        i += 1
    expect(dec_div("1", "0", 4).is_err(), "除零应 Err")
    # ---- round（多种 mode）----
    expect(dec_round("1.25", 1).unwrap() == "1.3", "round 1.25 half_up")
    expect(dec_round("1.25", 1, "half_even").unwrap() == "1.2", "round 1.25 half_even")
    expect(dec_round("1.25", 1, "down").unwrap() == "1.2", "round 1.25 down")
    expect(dec_round("1.25", 1, "up").unwrap() == "1.3", "round 1.25 up")
    expect(dec_round("1.35", 1).unwrap() == "1.4", "round 1.35 half_up")
    expect(dec_round("1.35", 1, "half_even").unwrap() == "1.4", "round 1.35 half_even")
    expect(dec_round("1.35", 1, "down").unwrap() == "1.3", "round 1.35 down")
    expect(dec_round("2.675", 2).unwrap() == "2.68", "round 2.675 half_up")
    expect(dec_round("2.675", 2, "down").unwrap() == "2.67", "round 2.675 down")
    expect(dec_round("0.125", 2).unwrap() == "0.13", "round 0.125 half_up")
    expect(dec_round("0.125", 2, "half_even").unwrap() == "0.12", "round 0.125 half_even")
    expect(dec_round("-1.25", 1).unwrap() == "-1.3", "round -1.25 half_up")
    expect(dec_round("-1.25", 1, "half_even").unwrap() == "-1.2", "round -1.25 half_even")
    expect(dec_round("-1.25", 1, "up").unwrap() == "-1.3", "round -1.25 up")
    expect(dec_round("-1.35", 1, "down").unwrap() == "-1.3", "round -1.35 down")
    expect(dec_round("1.24", 1).unwrap() == "1.2", "round 1.24 half_up")
    expect(dec_round("9.99", 1).unwrap() == "10", "round 9.99 进位")
    # ---- cmp ----
    expect(dec_cmp("1", "2") == -1, "cmp 1 2")
    expect(dec_cmp("2", "1") == 1, "cmp 2 1")
    expect(dec_cmp("1.0", "1") == 0, "cmp 1.0 1")
    expect(dec_cmp("-2", "-1") == -1, "cmp -2 -1")
    expect(dec_cmp("-2", "-3") == 1, "cmp -2 -3")
    expect(dec_cmp("0.5", "0.6") == -1, "cmp 0.5 0.6")
    # ---- 工具 ----
    expect(dec_abs("-3.14").unwrap() == "3.14", "abs -3.14")
    expect(dec_neg("3.14").unwrap() == "-3.14", "neg 3.14")
    expect(dec_is_zero("0.000"), "is_zero 0.000")
    expect(dec_is_zero("-0"), "is_zero -0")
    expect(not dec_is_zero("0.001"), "not is_zero 0.001")
    # ---- 非法输入 ----
    expect(dec_add("", "1").is_err(), "空串 Err")
    expect(dec_add("abc", "1").is_err(), "abc Err")
    expect(dec_add("1.2.3", "1").is_err(), "多小数点 Err")
    expect(dec_add("1e3", "1").is_err(), "科学计数法不支持（0.1.0）")
    expect(dec_add("--1", "1").is_err(), "双负号 Err")
    # ---- 大数（无溢出，字符串算法）----
    expect(dec_mul("99999999999999999999", "99999999999999999999").unwrap()
        == "9999999999999999999800000000000000000001", "大数乘法")
    print("decimal: PASS")
