# progress 0.2.0 测试
import "../registry/progress/0.2.0/progress.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- 0.1.0 回归 ----
    var bar = pg_bar(50, 100, 20).unwrap()
    expect(len(bar) > 0, "bar non-empty")
    # ---- 0.2.0 spinner ----
    expect(pg_spinner(0) == "|", "spinner 0")
    expect(pg_spinner(1) == "/", "spinner 1")
    expect(pg_spinner(2) == "-", "spinner 2")
    expect(pg_spinner(3) == "\\", "spinner 3")
    # ---- 0.2.0 percent ----
    expect(pg_percent(50, 100) == "50%", "percent 50%")
    expect(pg_percent(0, 100) == "0%", "percent 0%")
    expect(pg_percent(100, 100) == "100%", "percent 100%")
    # ---- 0.2.0 eta ----
    var eta = pg_eta(50, 100, 10)
    expect(len(eta) > 0, "eta non-empty: " + eta)
    # ---- 0.2.0 format_time ----
    expect(pg_format_time(30) == "30s", "format 30s")
    expect(pg_format_time(90) == "1m30s", "format 1m30s")
    expect(pg_format_time(3700) == "1h1m", "format 1h1m")
    # ---- 0.2.0 bar_custom ----
    var bc = pg_bar_custom(5, 10, 10, "#", "-")
    expect(bc == "#####-----", "bar_custom: " + bc)
    # ---- 0.2.0 bar_num ----
    var bn = pg_bar_num(5, 10, 10)
    expect(contains(bn, "5/10") == true, "bar_num: " + bn)
    # ---- 0.2.0 speed ----
    expect(contains(pg_speed(1024, 1), "KB") == true, "speed KB")
    expect(contains(pg_speed(1048576, 1), "MB") == true, "speed MB")
    print("PASS: progress 0.2.0")
