# holidays.px 测试：中国法定节假日/工作日历（双模式一致）
import "../registry/holidays/0.1.0/holidays.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # ---- 日期算法 ----
    expect(hd_weekday_cn(2024, 1, 1) == 1, "2024-01-01 周一")
    expect(hd_weekday_cn(2025, 1, 1) == 3, "2025-01-01 周三")
    expect(hd_weekday_cn(2024, 10, 1) == 2, "2024-10-01 周二")
    expect(hd_weekday_cn(2025, 10, 1) == 3, "2025-10-01 周三")
    expect(hd_is_leap(2024), "2024 闰年")
    expect(not hd_is_leap(2025), "2025 非闰年")
    expect(hd_is_leap(2000), "2000 闰年")
    expect(not hd_is_leap(1900), "1900 非闰年（整百年）")
    expect(hd_days_in_month(2024, 2) == 29, "2024-02 29 天")
    expect(hd_days_in_month(2025, 2) == 28, "2025-02 28 天")
    # ---- 法定假日 ----
    expect(hd_is_holiday(2024, 2, 10).unwrap(), "2024-02-10 春节初一")
    expect(hd_is_holiday(2024, 10, 1).unwrap(), "2024-10-01 国庆")
    expect(hd_is_holiday(2024, 4, 4).unwrap(), "2024-04-04 清明")
    expect(hd_is_holiday(2024, 6, 10).unwrap(), "2024-06-10 端午")
    expect(hd_is_holiday(2025, 10, 6).unwrap(), "2025-10-06 中秋")
    expect(hd_is_holiday(2025, 1, 28).unwrap(), "2025-01-28 除夕（春节假期）")
    expect(not hd_is_holiday(2024, 2, 9).unwrap(), "2024-02-09 除夕非假日（当年假从初一始）")
    expect(not hd_is_holiday(2025, 10, 9).unwrap(), "2025-10-09 非假日")
    # ---- 工作日判定 ----
    expect(hd_is_workday(2024, 2, 4).unwrap(), "2024-02-04 调休上班")
    expect(hd_is_workday(2024, 9, 14).unwrap(), "2024-09-14 调休上班")
    expect(hd_is_workday(2025, 9, 28).unwrap(), "2025-09-28 调休上班")
    expect(hd_is_workday(2025, 1, 26).unwrap(), "2025-01-26 调休上班")
    expect(hd_is_workday(2025, 2, 8).unwrap(), "2025-02-08 调休上班")
    expect(not hd_is_workday(2024, 2, 10).unwrap(), "2024-02-10 春节非工作日")
    expect(not hd_is_workday(2024, 6, 10).unwrap(), "2024-06-10 端午非工作日")
    expect(not hd_is_workday(2024, 6, 9).unwrap(), "2024-06-09 周日非工作日")
    expect(hd_is_workday(2024, 7, 1).unwrap(), "2024-07-01 普通周一工作日")
    # ---- 下一个工作日 ----
    var n1 = hd_next_workday(2025, 10, 8).unwrap()
    expect(n1[0] == 2025 and n1[1] == 10 and n1[2] == 9, "next_workday 2025-10-08 → 10-09")
    var n2 = hd_next_workday(2024, 10, 7).unwrap()
    expect(n2[0] == 2024 and n2[1] == 10 and n2[2] == 8, "next_workday 2024-10-07 → 10-08")
    var n3 = hd_next_workday(2024, 2, 10).unwrap()
    expect(n3[0] == 2024 and n3[1] == 2 and n3[2] == 18, "next_workday 2024-02-10 → 02-18（调休上班）")
    var n4 = hd_next_workday(2024, 9, 14).unwrap()
    expect(n4[0] == 2024 and n4[1] == 9 and n4[2] == 18, "next_workday 2024-09-14 → 09-18")
    # ---- 下一个法定假日（含当日；跨年） ----
    var h1 = hd_next_holiday(2024, 9, 10).unwrap()
    expect(h1[0] == 2024 and h1[1] == 9 and h1[2] == 15, "next_holiday 2024-09-10 → 中秋 09-15")
    expect(h1[3] == "中秋节", "next_holiday 名称")
    var h2 = hd_next_holiday(2025, 10, 2).unwrap()
    expect(h2[1] == 10 and h2[2] == 2 and h2[3] == "国庆节", "next_holiday 含当日")
    var h3 = hd_next_holiday(2024, 12, 1).unwrap()
    expect(h3[0] == 2025 and h3[1] == 1 and h3[2] == 1 and h3[3] == "元旦"
        , "next_holiday 跨年 → 2025-01-01")
    # ---- 列表 ----
    var hl24 = hd_holidays(2024).unwrap()
    expect(len(hl24) == 28, "2024 法定假日 28 天，got " + str(len(hl24)))
    var hl25 = hd_holidays(2025).unwrap()
    expect(len(hl25) == 28, "2025 法定假日 28 天，got " + str(len(hl25)))
    var wk25 = hd_workdays(2025).unwrap()
    expect(len(wk25) == 5, "2025 调休 5 天，got " + str(len(wk25)))
    var wk24 = hd_workdays(2024).unwrap()
    expect(len(wk24) == 8, "2024 调休 8 天，got " + str(len(wk24)))
    # ---- 错误路径 ----
    expect(hd_is_holiday(2026, 1, 1).is_err(), "2026 未收录 → Err")
    expect(hd_is_workday(2026, 1, 1).is_err(), "2026 未收录 → Err")
    expect(hd_valid_date(2025, 2, 29).is_err(), "2025-02-29 非法 → Err")
    expect(hd_valid_date(2024, 2, 29).is_ok(), "2024-02-29 合法")
    expect(hd_valid_date(2025, 13, 1).is_err(), "月份越界 → Err")
    print("holidays: PASS")
    return Ok(0)
