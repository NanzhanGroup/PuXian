# fractions.px 测试：双模式一致（精确有理数）
import "../registry/fractions/0.1.0/fractions.px"

def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)

def main():
    # 构造与约分
    expect(frac(1, 2).unwrap()[0] == 1 and frac(1, 2).unwrap()[1] == 2, "frac(1,2)")
    expect(frac(2, 4).unwrap()[0] == 1 and frac(2, 4).unwrap()[1] == 2, "frac(2,4) 约分")
    expect(frac(1, -2).unwrap()[0] == -1 and frac(1, -2).unwrap()[1] == 2, "frac(1,-2) 分母正化")
    expect(frac(-2, -4).unwrap()[0] == 1 and frac(-2, -4).unwrap()[1] == 2, "frac(-2,-4)")
    expect(frac(0, 5).unwrap()[0] == 0 and frac(0, 5).unwrap()[1] == 1, "frac(0,5) 零值")
    expect(frac(1, 0).is_err(), "frac(1,0) Err")
    # 解析
    expect(frac_from_str("1/2").unwrap()[1] == 2, "from_str 1/2")
    expect(frac_from_str("5").unwrap()[0] == 5 and frac_from_str("5").unwrap()[1] == 1, "from_str 5")
    expect(frac_from_str("-3/4").unwrap()[0] == -3, "from_str -3/4")
    expect(frac_from_str("6/8").unwrap()[0] == 3 and frac_from_str("6/8").unwrap()[1] == 4, "from_str 6/8")
    expect(frac_from_str("+2/3").unwrap()[0] == 2, "from_str +2/3")
    expect(frac_from_str("1/0").is_err(), "from_str 1/0 Err")
    expect(frac_from_str("abc").is_err(), "from_str abc Err")
    expect(frac_from_str("1/2/3").is_err(), "from_str 多斜杠 Err")
    expect(frac_from_str("/2").is_err(), "from_str /2 Err")
    expect(frac_from_str("2/").is_err(), "from_str 2/ Err")
    expect(frac_from_str("12ab").is_err(), "from_str 宽容前缀应 Err（PX-DEF-002 绕行）")
    expect(frac_from_str("").is_err(), "from_str 空 Err")
    # 算术
    var a = frac(1, 2).unwrap()
    var b = frac(1, 3).unwrap()
    var s = frac_add(a, b).unwrap()
    expect(s[0] == 5 and s[1] == 6, "1/2 + 1/3 = 5/6")
    var d = frac_sub(a, b).unwrap()
    expect(d[0] == 1 and d[1] == 6, "1/2 - 1/3 = 1/6")
    var m = frac_mul(a, b).unwrap()
    expect(m[0] == 1 and m[1] == 6, "1/2 * 1/3 = 1/6")
    var q = frac_div(a, b).unwrap()
    expect(q[0] == 3 and q[1] == 2, "1/2 / 1/3 = 3/2")
    expect(frac_div(a, frac(0, 1).unwrap()).is_err(), "除以零 Err")
    var ng = frac_neg(a)
    expect(ng[0] == -1 and ng[1] == 2, "neg 1/2 = -1/2")
    # 比较
    expect(frac_cmp(frac(1, 2).unwrap(), frac(2, 3).unwrap()) == -1, "cmp 1/2 < 2/3")
    expect(frac_cmp(frac(2, 3).unwrap(), frac(4, 6).unwrap()) == 0, "cmp 2/3 == 4/6")
    expect(frac_cmp(frac(3, 2).unwrap(), frac(1, 1).unwrap()) == 1, "cmp 3/2 > 1")
    expect(frac_eq(frac(2, 4).unwrap(), frac(1, 2).unwrap()), "eq 2/4 == 1/2")
    expect(not frac_eq(frac(1, 2).unwrap(), frac(1, 3).unwrap()), "neq 1/2 != 1/3")
    expect(frac_is_zero(frac(0, 9).unwrap()), "is_zero")
    expect(not frac_is_zero(frac(1, 9).unwrap()), "not is_zero")
    # 浮点/字符串/幂
    expect(frac_to_float(frac(1, 2).unwrap()) == 0.5, "to_float 1/2")
    expect(frac_to_str(frac(1, 2).unwrap()) == "1/2", "to_str 1/2")
    expect(frac_to_str(frac(3, 1).unwrap()) == "3", "to_str 3")
    expect(frac_to_str(frac(-3, 4).unwrap()) == "-3/4", "to_str -3/4")
    var p = frac_pow(frac(2, 3).unwrap(), 3).unwrap()
    expect(p[0] == 8 and p[1] == 27, "pow (2/3)^3 = 8/27")
    var pn = frac_pow(frac(2, 3).unwrap(), -1).unwrap()
    expect(pn[0] == 3 and pn[1] == 2, "pow (2/3)^-1 = 3/2")
    var p0 = frac_pow(frac(5, 7).unwrap(), 0).unwrap()
    expect(p0[0] == 1 and p0[1] == 1, "pow ^0 = 1")
    # gcd
    expect(frac_gcd(12, 18) == 6, "gcd(12,18) = 6")
    expect(frac_gcd(-12, 18) == 6, "gcd(-12,18) = 6")
    expect(frac_gcd(0, 7) == 7, "gcd(0,7) = 7")
    print("fractions: PASS")