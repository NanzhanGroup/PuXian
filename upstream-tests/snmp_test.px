# snmp 0.1.0 测试
import "../registry/snmp/0.1.0/snmp.px"
def expect(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
def main():
    # BER encoding
    var len1 = snmp_ber_encode_length(5)
    expect(len1 == [5], "short length")
    var len2 = snmp_ber_encode_length(200)
    expect(len2 == [0x81, 200], "long length: " + str(len2))
    var int1 = snmp_ber_encode_int(3)
    expect(int1 == [0x02, 1, 3], "ber int 3: " + str(int1))
    var int2 = snmp_ber_encode_int(300)
    expect(int2[0] == 0x02, "ber int 300 tag")
    expect(int2[1] == 2, "ber int 300 len 2")
    var str1 = snmp_ber_encode_string("public")
    expect(str1[0] == 0x04, "ber string tag")
    expect(str1[1] == 6, "ber string len: " + str(str1[1]))
    # OID encoding — 小值
    var oid = snmp_ber_encode_oid("1.3.6.1.2.1.1.1")
    expect(oid[0] == 0x06, "oid tag")
    expect(oid[2] == 0x2B, "oid first byte 1.3=43=0x2B: " + str(oid[2]))
    # OID encoding — 大值 (> 127)
    # 1.3.6.1.2.1.1.1.0 中的分量都 < 128，但 1.3.6.1.4.1.9.9.23.1.1.1.1.0 中的 9 < 128
    # 真正需要多字节的：1.3.6.1.2.1.200 → 200 需要 0x81,0x48
    var oid2 = snmp_ber_encode_oid("1.3.6.1.2.1.200")
    expect(oid2[0] == 0x06, "oid2 tag")
    # 200 = 0x81, 0x48 in BER
    var has_200 = false
    var i = 0
    while i < len(oid2):
        if oid2[i] == 0x81 and i + 1 < len(oid2) and oid2[i + 1] == 0x48:
            has_200 = true
        i += 1
    expect(has_200, "oid2 has 200 encoded as 0x81 0x48")
    # OID with very large component
    var oid3 = snmp_ber_encode_oid("1.3.6.1.4.1.32768")
    expect(oid3[0] == 0x06, "oid3 tag")
    expect(len(oid3) > 8, "oid3 longer for big value: " + str(len(oid3)))
    # get request
    var req = snmp_build_get_request("public", "1.3.6.1.2.1.1.1.0", 1)
    expect(len(req) > 0, "get request non-empty")
    # getnext request
    var req2 = snmp_build_getnext_request("public", "1.3.6.1.2.1", 2)
    expect(len(req2) > 0, "getnext request non-empty")
    # version name
    expect(snmp_version_name(0) == "v1", "v1")
    expect(snmp_version_name(1) == "v2c", "v2c")
    expect(snmp_version_name(3) == "v3", "v3")
    expect(snmp_version_name(99) == "unknown", "unknown")
    print("snmp: PASS")
