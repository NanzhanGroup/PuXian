# ============================================================
# 普贤标准库：std.png —— 纯语言 PNG 编码器（M61-S2 起；957 加可选真压缩）
# 用法：import std.png
#   png_encode(w, h, pixels, opts?) -> bytes  完整 PNG 文件（8bit RGB truecolor，逐行 filter=0）
#     opts 缺省 / {} ⇒ level 0 = **stored 无压缩**（与 M61-S2 产物逐字节相同，保兼容）
#     {"level": 1..9} ⇒ IDAT 用 zlib_compress 真压缩（体积通常小 3–10 倍）；
#                       越界值按 0 处理，FFI 返回 null 时自动回退 stored（不产出坏文件）
#   pixels = list[int]（w*h），每像素 0xRRGGBB —— 与 std.gfx 画布像素布局一致
# 实现：签名 + IHDR/IDAT/IEND chunk + 纯语言 CRC-32（IEEE）
#       level=0 ⇒ 纯语言 zlib stored block（CMF=0x78 FLG=0x01 + BFINAL/BTYPE≤65535 + ADLER32）
#       level>0 ⇒ extern zlib_compress（runtime_zlib.c 的 compress2；解释/编译两轨均可用，
#                 见 examples/m61_zlib）—— 只有显式开 level 才会调用 FFI，默认零 FFI 依赖
# 依赖 builtin：bytes/bytes_len/bytes_get/bytes_concat/bytes_slice/int_to_bytes/hex_to_bytes
# 说明：PNG chunk 内 CRC 覆盖 type+data；stored 流 0x78 0x01 是标准 no-compression zlib 头
#       缺陷 957 判据见 docs/EXTERNAL_REQUESTS.md
# ============================================================
# ---- FFI（仅 opts.level > 0 时调用；默认路径不碰它）----
# 注册点在 runtime/runtime_zlib.c：px_ffi_register("zlib_compress", ...) → compress2
extern def zlib_compress(data: bytes, level: int) -> bytes
# ---- 内部：CRC-32 查表（IEEE poly 0xEDB88320）----
def _crc32_table():
    var t = []
    var i = 0
    while i < 256:
        var cc = i
        var j = 0
        while j < 8:
            if (cc & 1) == 1:
                cc = (cc >>> 1) ^ 0xEDB88320
            else:
                cc = cc >>> 1
            j = j + 1
        t.append(cc)
        i = i + 1
    return t
def _crc32(t, d):
    var cc = 0xFFFFFFFF
    var n = bytes_len(d)
    var i = 0
    while i < n:
        cc = (cc >>> 8) ^ t[(cc ^ bytes_get(d, i)) & 0xff]
        i = i + 1
    return cc ^ 0xFFFFFFFF
# ---- 内部：ADLER-32（zlib 流校验）----
def _adler32(d):
    var a = 1
    var b = 0
    var n = bytes_len(d)
    var i = 0
    while i < n:
        a = (a + bytes_get(d, i)) % 65521
        b = (b + a) % 65521
        i = i + 1
    return (b << 16) | a
# ---- 内部：zlib stored（no compression）流 ----
def _zlib_stored(d):
    var n = bytes_len(d)
    var out = hex_to_bytes("7801")  # CMF FLG（no compression）
    var off = 0
    while off < n:
        var blen = n - off
        if blen > 65535:
            blen = 65535
        var final = 0
        if off + blen >= n:
            final = 1
        out = bytes_concat(out, int_to_bytes(final, 1))
        out = bytes_concat(out, int_to_bytes(blen, 2, "little"))
        out = bytes_concat(out, int_to_bytes((65535 - blen) & 0xffff, 2, "little"))
        out = bytes_concat(out, bytes_slice(d, off, off + blen))
        off = off + blen
    out = bytes_concat(out, int_to_bytes(_adler32(d), 4))
    return out
# ---- 内部：IDAT 流（level<=0 → stored；否则 zlib_compress，失败回退 stored）----
def _zlib_stream(d, level):
    if level > 0:
        var c = zlib_compress(d, level)
        if c != null and bytes_len(c) > 2:
            return c
    return _zlib_stored(d)
# ---- 内部：一个 PNG chunk ----
def _chunk(tbl, type_s, data):
    var td = bytes_concat(bytes(type_s), data)
    var crc = _crc32(tbl, td)
    var c = bytes_concat(int_to_bytes(bytes_len(data), 4), td)
    return bytes_concat(c, int_to_bytes(crc, 4))
# ---- 主入口：PNG 编码 ----
def png_encode(w, h, pixels, opts = {}):
    # 0) 取 level：默认 0（stored，与 M61-S2 逐字节一致）；显式 1..9 才真压缩
    var level = 0
    if type(opts) == "dict" and opts.has("level"):
        var lv = opts["level"]
        if type(lv) == "int" and lv > 0 and lv <= 9:
            level = lv
    # 1) 图像数据：逐行 filter=0 + RGB
    var rows = bytes("")
    var y = 0
    while y < h:
        var row = int_to_bytes(0, 1)
        var x = 0
        while x < w:
            var p = pixels[y * w + x]
            row = bytes_concat(row, int_to_bytes(p, 3))
            x = x + 1
        rows = bytes_concat(rows, row)
        y = y + 1
    # 2) IHDR：width(4) height(4) bitdepth=8 colortype=2 compression=0 filter=0 interlace=0
    var ihdr = bytes_concat(int_to_bytes(w, 4), int_to_bytes(h, 4))
    ihdr = bytes_concat(ihdr, int_to_bytes(8, 1))
    ihdr = bytes_concat(ihdr, int_to_bytes(2, 1))
    ihdr = bytes_concat(ihdr, int_to_bytes(0, 1))
    ihdr = bytes_concat(ihdr, int_to_bytes(0, 1))
    ihdr = bytes_concat(ihdr, int_to_bytes(0, 1))
    # 3) 组装
    var tbl = _crc32_table()
    var out = hex_to_bytes("89504e470d0a1a0a")
    out = bytes_concat(out, _chunk(tbl, "IHDR", ihdr))
    out = bytes_concat(out, _chunk(tbl, "IDAT", _zlib_stream(rows, level)))
    out = bytes_concat(out, _chunk(tbl, "IEND", bytes("")))
    return out
