# ============================================================
# pxrepo-sync.service —— PuXian 发布镜像同步（GitHub → 自建静态站点）
# ------------------------------------------------------------
# 落地位置示例（按本机路径改）：/etc/systemd/system/pxrepo-sync.service
# 依赖：packaging/pxrepo_mirror.sh（参考实现，<300 行）
#
# 契约（与 packaging/pxrepo_mirror.sh 一致）：
#   暂存目录 **必须放在 --dest 之外**（否则会被 soft-mirror 一起分发出去）
#   全链路校验通过才写 DEST；任一步失败 ⇒ DEST 保持上一版（不半残）
#   退出码 0 = 成功（含「已是最新」）/ 1 = 失败（DEST 未改）/ 2 = 用法环境错
#   周期 30min + 开机 2min 后即跑一次（详见 pxrepo-sync.timer）
# ============================================================
[Unit]
Description=PuXian 发布镜像同步（rpm 仓库 + 发布 tarball → 静态站点）
Documentation=https://github.com/NanzhanGroup/PuXian
Wants=network-online.target
After=network-online.target
# 可选：失败时触发你自己的通知单元（群帖 / 邮件 / webhook），默认注释掉
#OnFailure=pxrepo-sync-alert.service

[Service]
Type=oneshot
# ↓↓↓ 按本机路径改这两行 ↓↓↓
ExecStart=/usr/bin/bash /data/app/pxrepo-sync/pxrepo_mirror.sh \
    --dest /data/www/soft_wsai_chat/puxian \
    --work /var/tmp/pxrepo-staging
# 单轮最坏情形：~186MB 下载（116MB rpm + 70MB tarball）+ 校验，给足 30min
TimeoutStartSec=1800s
Nice=10
IOSchedulingClass=idle
# 失败重试由 timer 的下一轮承担（oneshot 不设 Restart，避免与 timer 打架）

[Install]
WantedBy=multi-user.target
