# ============================================================
# M89-S3-A1: bc_emit.px —— AST → 字节码 发射器（PuXian 自举）
# ------------------------------------------------------------
# 定位（docs/M89_vm_design.md D1/D4/D8）：单一执行引擎 —— 现 codegen
# （AST→C 文本 fn_*）平行开发的目标=「把 C 文本换成字节码指令 + 登记
# 常量/名字/槽」。本文件 = 发射器（PuXian，纯 importable，无 main/全局
# 声明/import —— 由主文件 bc_cli.px 或将来 compiler.px import，运行时
# 引用主文件全局与 parser/cg_* 函数），执行器在 runtime/vm.c（C）。
#
# A1 状态（2026-09-08）：
#   - 首个真实发射切片：BCModule K/N/G/Func 收集（K 去重/N/G 去重）、
#     函数级槽分配（参数 0..arity-1 + hoist 局部 + 临时）、语句/表达式
#     A1 子集接线：
#       语句 VarDecl/Assign(Var)/Return/ExprStmt/If/While/Empty
#       表达式 Int/Float/Str/Bool/Null/Var
#     指令：LOADK/IMM/MOV/GETG/SETG/SRCLINE/RET/RET0/HALT + JMP/JMPT/JMPF
#     （if/while 控制流用 JMPF/JMP 回填；JMPT 留 and/or 短路 A2）
#   - 不支持（panic 未实现，A2+ 逐批）：算术/比较、容器、调用/方法、
#     字段/索引、推导式/match、闭包、默认参数、for/break/continue 等。
#   - 顶层处理对齐 codegen：顶层可执行语句 → 合成 top 函数（末尾 HALT）；
#     顶层 VarDecl/Assign = 全局 SETG；函数内 VarDecl = 局部槽（遮蔽全局，
#     同 codegen cg_gen_func_named 语义）；函数内 Assign 到未声明名 = SETG。
#   - 槽分配对齐 codegen _v 编号体系（D4）：函数内 hoist 变量（VarDecl +
#     Assign 目标 + for 变量）预占槽；帧槽 calloc 零 = PX_NULL → 声明无需
#     初始化指令，声明处仅赋值（对齐 M62-L5 函数级作用域）。
#
# BCModule 目标形态（与 runtime/vm.h struct 对应）：
#   { name, k_pool:[{kind,i,f,s}], n_pool:[...], globals:[...],
#     funcs:[{name,arity,ndefault,nslots,bc:[inst...],is_top}], top }
#   bc 指令 inst = [op, a, b, c]（op 用名，dump 直读；C 输出时映射 PXOP_*）。
#   N 池（n_pool）为字段/方法/类型名预留，A1 尚无消费方（空表）。
# ============================================================

# ---------- 模块级当前状态（bc_emit_program 设置；helper 引用） ----------
var g_bcm = null          # 当前 BCModule dict

# ---------- 空 dict/列表工具（PuXian：{} 是空块=null） ----------
def bc_new_dict():
    let d = {"_": 0}
    d.remove("_")
    return d

# ---------- 表构建 ----------
# 常量池登记（去重：同 kind 同值只入一次）；返回池下标
def bc_k_find(pool, kind, i, f, s):
    var idx = 0
    while idx < len(pool):
        let e = pool[idx]
        if e["kind"] == kind:
            if kind == "int":
                if e["i"] == i:
                    return idx
            elif kind == "float":
                if e["f"] == f:
                    return idx
            elif kind == "str":
                if e["s"] == s:
                    return idx
            else:
                # bool/null 仅按 kind（i 承载 true/false 或恒 0）
                if e["i"] == i:
                    return idx
        idx += 1
    return -1

def bc_k_add(pool, kind, i, f, s):
    let ex = bc_k_find(pool, kind, i, f, s)
    if ex >= 0:
        return ex
    let e = bc_new_dict()
    e["kind"] = kind
    e["i"] = i
    e["f"] = f
    e["s"] = s
    pool.push(e)
    return len(pool) - 1

# 名字池登记（A1 预留：字段/方法/类型名；按值去重）；返回 N 下标
def bc_n_add(pool, name):
    var i = 0
    while i < len(pool):
        if pool[i] == name:
            return i
        i += 1
    pool.push(name)
    return len(pool) - 1

# 全局槽登记（顶层声明/读到的全局名：函数名/顶层 var）；返回 G 下标
def bc_g_add(globals_list, name):
    var i = 0
    while i < len(globals_list):
        if globals_list[i] == name:
            return i
        i += 1
    globals_list.push(name)
    return len(globals_list) - 1

# 名字是否为已登记全局
def bc_is_global(name):
    if g_bcm == null:
        return false
    return contains(g_bcm["globals"], name)

# 新建空 BCModule
def bc_new_module(name):
    let m = bc_new_dict()
    m["name"] = name
    m["k_pool"] = []
    m["n_pool"] = []
    m["globals"] = []
    m["funcs"] = []
    m["top"] = -1
    # B2：类型元数据 —— structs=[{name,fnames}...]（声明序）；enums={name:[变体..]}；
    #   consts={name:[{n,e}]}（TypeConst 值表达式，Field 访问处展开对齐 codegen 内联）
    m["structs"] = []
    m["enums"] = bc_new_dict()
    m["consts"] = bc_new_dict()
    m["nclosure"] = 0          # B4: 闭包/lambda 命名计数 "<closureN>"
    return m

# B2：struct 类型名 → structs 元数据下标（无则 -1）
def bc_struct_index(name):
    var i = 0
    while i < len(g_bcm["structs"]):
        if g_bcm["structs"][i]["name"] == name:
            return i
        i += 1
    return -1

# B2：enum 类型名是否登记且含变体名
def bc_enum_has(tname, vname):
    if not g_bcm["enums"].has(tname):
        return false
    return contains(g_bcm["enums"][tname], vname)

# B2：TypeConst 查找 —— consts[tname] 里找 iname，命中返回值表达式（null=无）
def bc_const_find(tname, iname):
    if not g_bcm["consts"].has(tname):
        return null
    let items = g_bcm["consts"][tname]
    var i = 0
    while i < len(items):
        if items[i]["n"] == iname:
            return items[i]["e"]
        i += 1
    return null

# B2：递归收集 TypeConst（顶层 + 函数体 + 嵌套块，对齐 cg_collect_consts）
def bc_collect_consts(stmts):
    var i = 0
    while i < len(stmts):
        let st = stmts[i]
        let ty = st[0]
        if ty == "TypeConst":
            let tname = rust_unescape(st[1])
            if not g_bcm["consts"].has(tname):
                g_bcm["consts"][tname] = []
            var ti = 0
            while ti < len(st[2]):
                let it = st[2][ti]
                let d2 = bc_new_dict()
                d2["n"] = rust_unescape(it[1])
                d2["e"] = it[2]
                g_bcm["consts"][tname].push(d2)
                ti += 1
        elif ty == "FuncDef":
            bc_collect_consts(st[4])
        elif ty == "ImplDef":
            var mi = 0
            while mi < len(st[3]):
                bc_collect_consts(st[3][mi][4])
                mi += 1
        elif ty == "If":
            let brs = st[1]
            var bi = 0
            while bi < len(brs):
                bc_collect_consts(brs[bi][1])
                bi += 1
            if st[2] != null:
                bc_collect_consts(st[2])
        elif ty == "While":
            bc_collect_consts(st[2])
        elif ty == "For":
            bc_collect_consts(st[3])
        i += 1

# B2：收集 impl 方法列表 [[type_name, method_func]..]，按 "Type.method" 字典序
#   （对齐 codegen M-B6 确定性排序）
def bc_collect_impl_list(items):
    let out = []
    var i = 0
    while i < len(items):
        let st = items[i]
        if st[0] == "ImplDef":
            let tn = rust_unescape(st[1])
            var mi = 0
            while mi < len(st[3]):
                out.append([tn, st[3][mi]])
                mi += 1
        i += 1
    # 插入排序（按 "Type.method" 字典序）
    var si = 1
    while si < len(out):
        var j = si
        while j > 0:
            let ka = out[j - 1][0] + "." + rust_unescape(out[j - 1][1][1])
            let kb = out[j][0] + "." + rust_unescape(out[j][1][1])
            if kb < ka:
                let tmp2 = out[j]
                out[j] = out[j - 1]
                out[j - 1] = tmp2
            j -= 1
        si += 1
    return out

# ---------- 函数级槽分配（对齐 codegen _v 编号体系） ----------
# 参数先占 0..nparams-1（A1 无默认参数，arity=nparams）；hoist 局部随声明序；
# 临时槽 next_slot 单调递增（A1 不回收，nslots=峰值；A2 起可栈式复用）。
def bc_new_func(name, arity):
    let func = bc_new_dict()
    func["name"] = name
    func["arity"] = arity
    func["ndefault"] = 0
    func["nslots"] = arity
    func["bc"] = []
    func["smap"] = bc_new_dict()
    func["next_slot"] = arity
    func["is_top"] = false
    func["loops"] = []          # A3：循环上下文栈 [{breaks:[idx],conts:[idx]}]
    return func

# 变量名 → 槽号（无则分配）
def bc_slot(func, name):
    if func["smap"].has(name):
        return func["smap"][name]
    let s = func["next_slot"]
    func["next_slot"] = s + 1
    func["smap"][name] = s
    return s

# 临时槽（表达式目标/暂存）：单调递增
def bc_tmp(func):
    let s = func["next_slot"]
    func["next_slot"] = s + 1
    return s

# ---------- 指令发射 ----------
# 发射一条指令到 func bc 列表：inst = [op, a, b, c]（op 用名字）
def bc_emit_inst(func, op, a, b, c):
    # M89-S3-B B1：指令升 5 元组 [op, fl, a, b, c]（fl 预留；CALLM 用 fl 存
    # argc）。dump / C 输出跳过 fl → golden 文本不变。
    func["bc"].push([op, 0, a, b, c])

# 回填跳转 off（JMP/JMPT/JMPF 的 b 字段=off，相对「下一条」）：
#   bc[idx] 从 idx 跳到 target → off = target - (idx+1)
def bc_patch_off(func, idx, target):
    func["bc"][idx][3] = target - (idx + 1)

# ---------- hoist 局部收集（对齐 cg_collect_hoist_vars：函数级作用域） ----------
def bc_collect_hoist(stmts, out):
    var i = 0
    while i < len(stmts):
        let st = stmts[i]
        let ty = st[0]
        if ty == "Assign":
            let tgt = st[1]
            if tgt[0] == "Var":
                let name = rust_unescape(tgt[1])
                if not contains(out, name):
                    out.append(name)
        elif ty == "VarDecl":
            let name = rust_unescape(st[2])
            if not contains(out, name):
                out.append(name)
        elif ty == "If":
            let brs = st[1]
            var bi = 0
            while bi < len(brs):
                bc_collect_hoist(brs[bi][1], out)
                bi += 1
            if st[2] != null:
                bc_collect_hoist(st[2], out)
        elif ty == "While":
            bc_collect_hoist(st[2], out)
        elif ty == "For":
            # B1：for 循环变量（Python 语义：循环后保留最后值）+ 遍历 body
            let fv = rust_unescape(st[1])
            if not contains(out, fv):
                out.append(fv)
            bc_collect_hoist(st[3], out)
        elif ty == "ChanDecl":
            # B5：通道声明变量（函数级 hoist，body 引用前预占槽）
            let cn = rust_unescape(st[1])
            if not contains(out, cn):
                out.append(cn)
        i += 1

# 发 null 常量到 dst 槽（LOADK nullK；K 去重）
def bc_emit_null(func, dst):
    let k = bc_k_add(g_bcm["k_pool"], "null", 0, 0.0, "")
    bc_emit_inst(func, "LOADK", dst, k, 0)

# 发 int 常量到 dst 槽：int16 内 → IMM；否则 K 池 LOADK
def bc_emit_int(func, dst, i):
    if i >= -32768 and i <= 32767:
        bc_emit_inst(func, "IMM", dst, i, 0)
    else:
        let k = bc_k_add(g_bcm["k_pool"], "int", i, 0.0, "")
        bc_emit_inst(func, "LOADK", dst, k, 0)

# 发 float 常量到 dst 槽（K 池 LOADK）
def bc_emit_float(func, dst, f):
    let k = bc_k_add(g_bcm["k_pool"], "float", 0, f, "")
    bc_emit_inst(func, "LOADK", dst, k, 0)

# ---------- op 名 → 指令名（对齐 vm.h B 表；A2） ----------
def bc_unop_op(op):
    if op == "Neg":
        return "NEG"
    if op == "Not":
        return "NOT"
    if op == "BitNot":
        return "BITNOT"
    panic("bc_unop_op 未知一元 op: " + str(op))

def bc_binop_op(op):
    if op == "Add":
        return "ADD"
    if op == "Sub":
        return "SUB"
    if op == "Mul":
        return "MUL"
    if op == "Div":
        return "DIV"
    if op == "IntDiv":
        return "IDIV"
    if op == "Mod":
        return "MOD"
    if op == "Pow":
        return "POW"
    if op == "Eq":
        return "EQ"
    if op == "Ne":
        return "NE"
    if op == "Lt":
        return "LT"
    if op == "Le":
        return "LE"
    if op == "Gt":
        return "GT"
    if op == "Ge":
        return "GE"
    if op == "BitAnd":
        return "BITAND"
    if op == "BitOr":
        return "BITOR"
    if op == "BitXor":
        return "BITXOR"
    if op == "Shl":
        return "SHL"
    if op == "Shr":
        return "SHR"
    if op == "ShrU":
        return "SHRU"
    panic("bc_binop_op 未知二元 op: " + str(op))

# ---------- 表达式发射（A1 子集） ----------
# 把 expr 值发射到 dst 槽。返回「值所在槽」（A1 恒 dst；优化留 A2）。
# 支持的 tag：Int/Float/Str/Bool/Null → 加载；Var → 局部 MOV / 全局 GETG。
def bc_emit_expr(expr, dst, func):
    let ty = expr[0]
    if ty == "Int":
        bc_emit_int(func, dst, expr[1])
        return dst
    if ty == "Float":
        bc_emit_float(func, dst, expr[1])
        return dst
    if ty == "Unary":
        # 负字面量常量折叠优先（-Int/-Float，parser 把 -1 解析为 Unary Neg Int）；
        # 一般 Neg/Not/BitNot → NEG/NOT/BITNOT（A2 算术批）
        let inner = expr[2]
        let op = expr[1]
        if inner[0] == "Int" and op == "Neg":
            bc_emit_int(func, dst, 0 - inner[1])
            return dst
        if inner[0] == "Float" and op == "Neg":
            bc_emit_float(func, dst, 0 - inner[1])
            return dst
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        let s = bc_tmp(func)
        bc_emit_expr(inner, s, func)
        bc_emit_inst(func, bc_unop_op(op), d, s, 0)
        return d
    if ty == "Str":
        let k = bc_k_add(g_bcm["k_pool"], "str", 0, 0.0, rust_unescape(expr[1]))
        if dst >= 0:
            bc_emit_inst(func, "LOADK", dst, k, 0)
        return dst
    if ty == "Bool":
        var bi = 0
        if expr[1]:
            bi = 1
        let k = bc_k_add(g_bcm["k_pool"], "bool", bi, 0.0, "")
        if dst >= 0:
            bc_emit_inst(func, "LOADK", dst, k, 0)
        return dst
    if ty == "Null":
        if dst >= 0:
            bc_emit_null(func, dst)
        return dst
    if ty == "Var":
        let name = rust_unescape(expr[1])
        if func["smap"].has(name):
            # 局部变量：MOV dst←槽（dst==槽时省）
            let s = func["smap"][name]
            if dst >= 0 and dst != s:
                bc_emit_inst(func, "MOV", dst, s, 0)
            return dst
        # 全局：GETG dst, g
        let g = bc_g_add(g_bcm["globals"], name)
        if dst >= 0:
            bc_emit_inst(func, "GETG", dst, g, 0)
        return dst
    if ty == "Binary":
        # A2：算术/比较/位运算批（两地址：ADD dst,dst,s2）；A3：and/or 短路（D5）
        let op = expr[1]
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        if op == "And":
            # and：左假 → 结果=左；左真 → 求右覆写
            bc_emit_expr(expr[2], d, func)
            let je = len(func["bc"])
            bc_emit_inst(func, "JMPF", d, 0, 0)
            bc_emit_expr(expr[3], d, func)
            bc_patch_off(func, je, len(func["bc"]))
            return d
        if op == "Or":
            # or：左真 → 结果=左；左假 → 求右覆写
            bc_emit_expr(expr[2], d, func)
            let je = len(func["bc"])
            bc_emit_inst(func, "JMPT", d, 0, 0)
            bc_emit_expr(expr[3], d, func)
            bc_patch_off(func, je, len(func["bc"]))
            return d
        bc_emit_expr(expr[2], d, func)      # 左值直接入 dst（两地址）
        let s2 = bc_tmp(func)
        bc_emit_expr(expr[3], s2, func)
        bc_emit_inst(func, bc_binop_op(op), d, d, s2)
        return d
    if ty == "NullCoalesce":
        # ??：左为 null → 取右；否则保留左（对齐 codegen px_is_null ? r : l）
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        bc_emit_expr(expr[1], d, func)
        let tn = bc_tmp(func)
        bc_emit_null(func, tn)
        let te = bc_tmp(func)
        bc_emit_inst(func, "EQ", te, d, tn)     # te = (d == null)
        let je = len(func["bc"])
        bc_emit_inst(func, "JMPF", te, 0, 0)    # 非 null → 保留 d
        bc_emit_expr(expr[2], d, func)
        bc_patch_off(func, je, len(func["bc"]))
        return d
    if ty == "IfExpr":
        # if c: a else: b 表达式 → JMPF/JMP 分支（结果槽 d）
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        let tc = bc_tmp(func)
        bc_emit_expr(expr[1], tc, func)
        let jf = len(func["bc"])
        bc_emit_inst(func, "JMPF", tc, 0, 0)
        bc_emit_expr(expr[2], d, func)          # then
        let jj = len(func["bc"])
        bc_emit_inst(func, "JMP", 0, 0, 0)
        bc_patch_off(func, jf, len(func["bc"])) # 假 → else 起点（JMP 之后）
        bc_emit_expr(expr[3], d, func)          # else
        bc_patch_off(func, jj, len(func["bc"]))
        return d
    if ty == "Try":
        # A5：?expr → 求值入 d；TRY d（Err/null 就地返回传播；Ok 解包覆写）。
        # 顶层 ?（is_top 帧）语义：Err/null 经 RET 到 run_module → driver 报错退出
        # （对齐 codegen "顶层不能传播" 报错意图；文案差异记录）。
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        bc_emit_expr(expr[1], d, func)
        bc_emit_inst(func, "TRY", d, 0, 0)
        return d
    if ty == "ForceUnwrap":
        # A5：!expr → 求值入 d；FORCE d（Err/null px_error；Ok 解包覆写）
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        bc_emit_expr(expr[1], d, func)
        bc_emit_inst(func, "FORCE", d, 0, 0)
        return d
    if ty == "List" or ty == "Tuple":
        # B1：容器字面量 —— 项连续槽 base..base+n-1 → NEWLIST/NEWTUPLE dst, base, n
        let items = expr[1]
        let n = len(items)
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        let base = bc_tmp(func)
        while func["next_slot"] < base + n:
            bc_tmp(func)
        var li = 0
        while li < n:
            bc_emit_expr(items[li], base + li, func)
            li += 1
        if ty == "List":
            bc_emit_inst(func, "NEWLIST", d, base, n)
        else:
            bc_emit_inst(func, "NEWTUPLE", d, base, n)
        return d
    if ty == "Dict":
        # B1：dict 字面量 —— entries [[k,v]..]；NEWDICT dst, base, 项数（str 键入池）
        let entries = expr[1]
        let n = len(entries)
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        let base = bc_tmp(func)
        while func["next_slot"] < base + 2 * n:
            bc_tmp(func)
        var di = 0
        while di < n:
            bc_emit_expr(entries[di][0], base + 2 * di, func)
            bc_emit_expr(entries[di][1], base + 2 * di + 1, func)
            di += 1
        bc_emit_inst(func, "NEWDICT", d, base, n)
        return d
    if ty == "Index":
        # B1：obj[idx] 读取 → INDEX dst, obj, idx
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        let so = bc_tmp(func)
        bc_emit_expr(expr[1], so, func)
        let si = bc_tmp(func)
        bc_emit_expr(expr[2], si, func)
        bc_emit_inst(func, "INDEX", d, so, si)
        return d
    if ty == "Slice":
        # B1：obj[start:end:step] → SLICE dst, obj, base（base 起 3 连续槽，缺省 null）
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        let so = bc_tmp(func)
        bc_emit_expr(expr[1], so, func)
        let base = bc_tmp(func)
        while func["next_slot"] < base + 3:
            bc_tmp(func)
        if expr[2] == null:
            bc_emit_null(func, base)
        else:
            bc_emit_expr(expr[2], base, func)
        if expr[3] == null:
            bc_emit_null(func, base + 1)
        else:
            bc_emit_expr(expr[3], base + 1, func)
        if expr[4] == null:
            bc_emit_null(func, base + 2)
        else:
            bc_emit_expr(expr[4], base + 2, func)
        bc_emit_inst(func, "SLICE", d, so, base)
        return d
    if ty == "Field":
        # B1：obj.name → GETF dst, obj, N（px_field）。
        # B2：enum 变体（Color.Red → NEWENUM）与 const enum（LogLevel.Info → 值表达式
        #   内联，对齐 codegen cg_collect_consts 语义）编译期折叠，obj 不求值。
        let fname = rust_unescape(expr[2])
        let obj0 = expr[1]
        if obj0[0] == "Var":
            let oname = rust_unescape(obj0[1])
            let ce = bc_const_find(oname, fname)
            if ce != null:
                var d = dst
                if d < 0:
                    d = bc_tmp(func)
                bc_emit_expr(ce, d, func)
                return d
            if bc_enum_has(oname, fname):
                var d = dst
                if d < 0:
                    d = bc_tmp(func)
                let tn = bc_n_add(g_bcm["n_pool"], oname)
                let vn = bc_n_add(g_bcm["n_pool"], fname)
                bc_emit_inst(func, "NEWENUM", d, tn, vn)
                return d
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        let so = bc_tmp(func)
        bc_emit_expr(expr[1], so, func)
        let nn = bc_n_add(g_bcm["n_pool"], fname)
        bc_emit_inst(func, "GETF", d, so, nn)
        return d
    if ty == "OptionalField":
        # B1：obj?.name → GETF_OPT dst, obj, N（obj null→null）
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        let so = bc_tmp(func)
        bc_emit_expr(expr[1], so, func)
        let nn = bc_n_add(g_bcm["n_pool"], rust_unescape(expr[2]))
        bc_emit_inst(func, "GETF_OPT", d, so, nn)
        return d
    if ty == "Call":
        # A4 普通调用 / B1 方法调用（callee Field → CALLM px_method 桥）/
        # B2 struct/enum 构造（callee Var 为类型名 → NEWSTRUCT/NEWENUM）
        let callee = expr[1]
        if callee[0] == "Var":
            let cname = rust_unescape(callee[1])
            let sti = bc_struct_index(cname)
            if sti >= 0:
                return bc_emit_struct_new(cname, sti, expr[2], dst, func)
            if g_bcm["enums"].has(cname):
                return bc_emit_enum_new(cname, expr[2], dst, func)
        if callee[0] == "Field":
            return bc_emit_methodcall(callee[1], rust_unescape(callee[2]), expr[2], dst, func)
        return bc_emit_call(callee, expr[2], dst, func)
    if ty == "Constructor":
        # B2：类型构造器名(args)（parser 命名的构造表达式）→ struct/enum 构造
        let cname = rust_unescape(expr[1])
        let sti = bc_struct_index(cname)
        if sti >= 0:
            return bc_emit_struct_new(cname, sti, expr[2], dst, func)
        if g_bcm["enums"].has(cname):
            return bc_emit_enum_new(cname, expr[2], dst, func)
        # 其他构造名 → 普通函数调用（对齐 codegen Constructor 兜底 px_call 全局）
        return bc_emit_call(expr[1], expr[2], dst, func)
    if ty == "Pipe":
        # |>: 左值作为实参首参调用右函数；右为 Call → f(v, ...)（cg 同语义）
        let v = expr[1]
        let fn2 = expr[2]
        if fn2[0] == "Call":
            let al = []
            al.append(v)
            var a2i = 0
            while a2i < len(fn2[2]):
                al.append(fn2[2][a2i])
                a2i += 1
            return bc_emit_call(fn2[1], al, dst, func)
        let al = [v]
        return bc_emit_call(fn2, al, dst, func)

    if ty == "ListComp":
        # [elt for ...] → 空列表槽 + 嵌套循环展开 + cond 过滤 + push(elt)
        let clauses = expr[2]
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        bc_emit_inst(func, "NEWLIST", d, 0, 0)
        bc_emit_comp(func, "push", [expr[1]], expr[3], d, clauses, 0)
        return d
    if ty == "DictComp":
        # {k: v for ...} → 空 dict 槽 + 循环展开 + rv.set(k,v)（键 str，对齐 NEWDICT）
        let clauses = expr[3]
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        bc_emit_inst(func, "NEWDICT", d, 0, 0)
        bc_emit_comp(func, "dict", [expr[1], expr[2]], expr[4], d, clauses, 0)
        return d
    if ty == "GenExp":
        return bc_emit_genexp(expr, dst, func)
    if ty == "Match":
        # match subject { case pat: body ... } 表达式 → if-elif 链（对齐 cg Match：
        #   d 初=subject，命中 arm body 覆写 d 并跳 end；全不命中 → 返回 subject）
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        let t = bc_tmp(func)
        bc_emit_expr(expr[1], t, func)
        bc_emit_inst(func, "MOV", d, t, 0)
        let arms = expr[2]
        var pend = []
        var ai = 0
        while ai < len(arms):
            let arm = arms[ai]
            let pcond = bc_match_cond(arm[1], t, func)
            var skip = -1
            var gskip = -1
            if pcond == null:
                # 恒真模式：无 pattern 跳转；guard（arm[2]）有则查 guard
                if arm[2] != null:
                    let gb = bc_tmp(func)
                    bc_emit_expr(arm[2], gb, func)
                    let gf = len(func["bc"])
                    bc_emit_inst(func, "JMPF", gb, 0, 0)
                    gskip = gf
            else:
                let jf = len(func["bc"])
                bc_emit_inst(func, "JMPF", pcond, 0, 0)
                skip = jf
                if arm[2] != null:
                    let gb = bc_tmp(func)
                    bc_emit_expr(arm[2], gb, func)
                    let gf = len(func["bc"])
                    bc_emit_inst(func, "JMPF", gb, 0, 0)
                    gskip = gf
            bc_emit_expr(arm[3], d, func)
            let jj = len(func["bc"])
            bc_emit_inst(func, "JMP", 0, 0, 0)
            let land = len(func["bc"])
            if skip >= 0:
                bc_patch_off(func, skip, land)
            if gskip >= 0:
                bc_patch_off(func, gskip, land)
            pend.append(jj)
            ai += 1
        let end = len(func["bc"])
        var pi = 0
        while pi < len(pend):
            bc_patch_off(func, pend[pi], end)
            pi += 1
        return d
    if ty == "Block":
        # { stmts } 块表达式：顺序执行，块值 = 最后 ExprStmt 值（cg：_blk 初 null，
        #   每 ExprStmt 覆写；无 ExprStmt → null）。块内 VarDecl/Assign 就地分配槽
        #   （函数级 smap，帧槽零=PX_NULL；无块级作用域，对齐 codegen/M62-L5）。
        var d = dst
        if d < 0:
            d = bc_tmp(func)
        bc_emit_null(func, d)
        let stmts = expr[1]
        var bi2 = 0
        while bi2 < len(stmts):
            let st = stmts[bi2]
            if st[0] == "ExprStmt":
                bc_emit_expr(st[1], d, func)
            else:
                bc_emit_stmt(st, func)
            bi2 += 1
        return d
    if ty == "Closure":
        # fn(params) body → 无捕获闭包 PxVMFunc（LOADK PXK_FUNC 引用 funcs 下标）
        let pnames = []
        var pi = 0
        while pi < len(expr[1]):
            pnames.append(rust_unescape(expr[1][pi][1]))
            pi += 1
        let fidx = bc_emit_push_lambda(pnames, expr[3])
        let k = bc_k_add(g_bcm["k_pool"], "func", fidx, 0.0, "")
        bc_emit_inst(func, "LOADK", dst, k, 0)
        return dst
    panic("bc_emit_expr 未实现: " + str(expr))
# 通用调用发射（A4）：callee 求值到槽；实参连续区 callee+1..+argc（先预留防
# 内部临时碰撞）；CALL dst, callee_slot, argc。arg_list = 实参表达式列表。
def bc_emit_call(callee, arg_list, dst, func):
    var d = dst
    if d < 0:
        d = bc_tmp(func)
    let cslot = bc_tmp(func)
    let argc = len(arg_list)
    let need = cslot + 1 + argc
    while func["next_slot"] < need:
        bc_tmp(func)
    bc_emit_expr(callee, cslot, func)
    var ai = 0
    while ai < argc:
        bc_emit_expr(arg_list[ai], cslot + 1 + ai, func)
        ai += 1
    bc_emit_inst(func, "CALL", d, cslot, argc)
    return d

# 方法调用发射（B1）：obj.name(args) → CALLM
#   inst = ["CALLM", argc(fl), dst, obj槽, N(方法名)]
#   实参连续区 obj+1..obj+argc（对齐 CALL args 排布：obj 占 callee 位）；
#   先预留容量防内部临时碰撞（同 bc_emit_call）。
def bc_emit_methodcall(obj, mname, arg_list, dst, func):
    var d = dst
    if d < 0:
        d = bc_tmp(func)
    let cslot = bc_tmp(func)
    let argc = len(arg_list)
    let need = cslot + 1 + argc
    while func["next_slot"] < need:
        bc_tmp(func)
    bc_emit_expr(obj, cslot, func)
    var ai = 0
    while ai < argc:
        bc_emit_expr(arg_list[ai], cslot + 1 + ai, func)
        ai += 1
    let nn = bc_n_add(g_bcm["n_pool"], mname)
    func["bc"].push(["CALLM", argc, d, cslot, nn])
    return d

# ---------- B2：struct/enum 构造发射 ----------
# Point(1,2)：字段值连续槽 base..base+n-1（声明序）→ NEWSTRUCT dst, 元数据idx, base
def bc_emit_struct_new(cname, sti, args, dst, func):
    let sd = g_bcm["structs"][sti]
    let n = len(sd["fnames"])
    if len(args) != n:
        panic("结构体 " + cname + " 需要 " + str(n) + " 个字段，给出 " + str(len(args)))
    var d = dst
    if d < 0:
        d = bc_tmp(func)
    let base = bc_tmp(func)
    while func["next_slot"] < base + n:
        bc_tmp(func)
    var ai = 0
    while ai < n:
        bc_emit_expr(args[ai], base + ai, func)
        ai += 1
    bc_emit_inst(func, "NEWSTRUCT", d, sti, base)
    return d

# Color(Red) / Color("Red")：实参=变体名 → NEWENUM dst, N(类型), N(变体)
def bc_emit_enum_new(cname, args, dst, func):
    var vname = null
    if len(args) == 1:
        let a0 = args[0]
        if a0[0] == "Var":
            let vn = rust_unescape(a0[1])
            if bc_enum_has(cname, vn):
                vname = vn
        elif a0[0] == "Str":
            vname = rust_unescape(a0[1])
    if vname == null:
        panic("bc_emit enum 构造未实现（仅支持 Color(Variant)/Color(\"Variant\"): " + str(cname))
    var d = dst
    if d < 0:
        d = bc_tmp(func)
    let tn = bc_n_add(g_bcm["n_pool"], cname)
    let vn2 = bc_n_add(g_bcm["n_pool"], vname)
    bc_emit_inst(func, "NEWENUM", d, tn, vn2)
    return d

# ---------- B3/B4：推导式展开 + lambda/闭包基建 ----------
# 以槽号 obj 调方法（obj 已是槽号；args 元素=槽号(int)→MOV 或 表达式）
# 安全布局：obj 引用先 MOV 到新 cslot，实参区 cslot+1..cslot+argc 全新预留
#   （CALLM args=槽 b+1..；若直接在原 obj 槽后排布会与既有活跃槽（迭代变量/its 等）
#   重叠覆写 —— dictcomp set 暴露：obj 是收集容器槽，其后即循环临时槽）。
def bc_emit_methodcall_slot(func, obj_slot, mname, args, dst):
    let cslot = bc_tmp(func)
    bc_emit_inst(func, "MOV", cslot, obj_slot, 0)
    let argc = len(args)
    let need = cslot + 1 + argc
    while func["next_slot"] < need:
        bc_tmp(func)
    var ai = 0
    while ai < argc:
        let a = args[ai]
        if type(a) == "int":
            bc_emit_inst(func, "MOV", cslot + 1 + ai, a, 0)
        else:
            bc_emit_expr(a, cslot + 1 + ai, func)
        ai += 1
    let nn = bc_n_add(g_bcm["n_pool"], mname)
    func["bc"].push(["CALLM", argc, dst, cslot, nn])
    return dst

# 无捕获 lambda（对齐 cg_gen_lambda）：param_names + body 表达式 → PxVMFunc 入
#   funcs 返回下标（LOADK PXK_FUNC 引用；'<' 名不注册全局）
def bc_emit_push_lambda(param_names, body_expr):
    let name = "<closure" + str(g_bcm["nclosure"]) + ">"
    g_bcm["nclosure"] = g_bcm["nclosure"] + 1
    let func = bc_new_func(name, len(param_names))
    var pi = 0
    while pi < len(param_names):
        func["smap"][param_names[pi]] = pi
        pi += 1
    g_bcm["funcs"].push(func)
    let t = bc_tmp(func)
    bc_emit_expr(body_expr, t, func)
    bc_emit_inst(func, "RET", t, 0, 0)
    func["nslots"] = func["next_slot"]
    return len(g_bcm["funcs"]) - 1

# 推导式嵌套循环展开（ListComp/DictComp）。kind="push"（put=push(elems[0])）/
#   "dict"（put=rv.set(elems[0], elems[1])）。cond=过滤表达式或 null；rv=收集容器槽；
#   clauses=[[CompClause, vars, iterable]..]；ci=当前子句层（0 起，递归）。
# 迭代变量重绑定：进入子句时把用户变量 vn 绑到新临时槽（保存旧绑定/无），
#   循环完恢复 —— 对齐 cg_comp_collect/restore（comp 变量不泄漏外层）。
def bc_emit_comp(func, kind, elems, cond, rv, clauses, ci):
    let ncl = len(clauses)
    if ci >= ncl:
        var skip = -1
        if cond != null:
            let tc = bc_tmp(func)
            bc_emit_expr(cond, tc, func)
            skip = len(func["bc"])
            bc_emit_inst(func, "JMPF", tc, 0, 0)
        if kind == "dict":
            let kv = bc_tmp(func)
            let vv = bc_tmp(func)
            bc_emit_expr(elems[0], kv, func)
            bc_emit_expr(elems[1], vv, func)
            bc_emit_methodcall_slot(func, rv, "set", [kv, vv], bc_tmp(func))
        else:
            let ev = bc_tmp(func)
            bc_emit_expr(elems[0], ev, func)
            bc_emit_inst(func, "LISTPUSH", ev, rv, 0)
        if skip >= 0:
            bc_patch_off(func, skip, len(func["bc"]))
        return
    let cl = clauses[ci]
    let vars = cl[1]
    if len(vars) != 1:
        panic("bc_emit 推导式多变量子句未实现: " + str(cl))
    let vn = rust_unescape(vars[0])
    var had = false
    var sv = 0
    if func["smap"].has(vn):
        sv = func["smap"][vn]
        had = true
    let vs = bc_tmp(func)
    func["smap"][vn] = vs
    let its = bc_tmp(func)
    bc_emit_expr(cl[2], its, func)
    let fnl = bc_tmp(func)
    let nslot = bc_tmp(func)
    while func["next_slot"] < fnl + 2:
        bc_tmp(func)
    let gl = bc_g_add(g_bcm["globals"], "len")
    bc_emit_inst(func, "GETG", fnl, gl, 0)
    bc_emit_inst(func, "MOV", fnl + 1, its, 0)
    bc_emit_inst(func, "CALL", nslot, fnl, 1)
    let ctr = bc_tmp(func)
    bc_emit_int(func, ctr, 0)
    let loop_start = len(func["bc"])
    let lt = bc_tmp(func)
    bc_emit_inst(func, "LT", lt, ctr, nslot)
    let jf = len(func["bc"])
    bc_emit_inst(func, "JMPF", lt, 0, 0)
    bc_emit_inst(func, "INDEX", vs, its, ctr)
    bc_emit_comp(func, kind, elems, cond, rv, clauses, ci + 1)
    let one = bc_tmp(func)
    bc_emit_int(func, one, 1)
    bc_emit_inst(func, "ADD", ctr, ctr, one)
    let jb = len(func["bc"])
    bc_emit_inst(func, "JMP", 0, 0, 0)
    let end = len(func["bc"])
    bc_patch_off(func, jb, loop_start)
    bc_patch_off(func, jf, end)
    if had:
        func["smap"][vn] = sv
    else:
        func["smap"].remove(vn)

# GenExp 单 for 单变量 → NEWGEN 惰性（px_gen_lazy：seq + transform=fn(x){elt}
#   + filter=fn(x){cond}，对齐 codegen cg GenExp 单 for 惰性路径）
def bc_emit_genexp(expr, dst, func):
    let clauses = expr[2]
    if len(clauses) != 1 or len(clauses[0][1]) != 1:
        panic("bc_emit GenExp 仅支持单 for 单变量（多 for 物化路径待接入）: " + str(expr))
    let vn = rust_unescape(clauses[0][1][0])
    var d = dst
    if d < 0:
        d = bc_tmp(func)
    let seq = bc_tmp(func)
    bc_emit_expr(clauses[0][2], seq, func)
    let tidx = bc_emit_push_lambda([vn], expr[1])
    var fidx = -1
    if expr[3] != null:
        fidx = bc_emit_push_lambda([vn], expr[3])
    let base = bc_tmp(func)
    while func["next_slot"] < base + 2:
        bc_tmp(func)
    let tk = bc_k_add(g_bcm["k_pool"], "func", tidx, 0.0, "")
    bc_emit_inst(func, "LOADK", base, tk, 0)
    if fidx >= 0:
        let fk = bc_k_add(g_bcm["k_pool"], "func", fidx, 0.0, "")
        bc_emit_inst(func, "LOADK", base + 1, fk, 0)
    else:
        bc_emit_null(func, base + 1)
    bc_emit_inst(func, "NEWGEN", d, seq, base)
    return d

# ---------- B3b：match 模式条件 ----------
# 模式条件 → 布尔槽；恒真模式（Wildcard/小写 Binding/空 Tuple）返回 null（无跳转）
def bc_match_enumvar(vname, t, func):
    # subject 是 enum 且 variant==vname（对齐 cg subject.type==PX_ENUM && strcmp；
    #   px_enum_variant 对非 enum → null → EQ false，无需类型预判）
    let ev = bc_tmp(func)
    bc_emit_inst(func, "ENUMVAR", ev, t, 0)
    let k = bc_k_add(g_bcm["k_pool"], "str", 0, 0.0, vname)
    let ks = bc_tmp(func)
    bc_emit_inst(func, "LOADK", ks, k, 0)
    let eb = bc_tmp(func)
    bc_emit_inst(func, "EQ", eb, ev, ks)
    return eb

def bc_match_cond(pattern, t, func):
    let pty = pattern[0]
    if pty == "PatWildcard":
        return null
    if pty == "PatBinding":
        let name = rust_unescape(pattern[1])
        if len(name) > 0 and name[0] >= "A" and name[0] <= "Z":
            # 大写 → enum 变体名匹配（对齐 cg：变体名常量全大写惯例）
            return bc_match_enumvar(name, t, func)
        return null
    if pty == "PatTuple":
        let items = pattern[1]
        if len(items) > 0:
            return bc_match_cond(items[0], t, func)
        return null
    if pty == "PatConstructor":
        return bc_match_enumvar(rust_unescape(pattern[1]), t, func)
    if pty == "PatLiteral":
        let ev = bc_tmp(func)
        bc_emit_expr(pattern[1], ev, func)
        let eb = bc_tmp(func)
        bc_emit_inst(func, "EQ", eb, t, ev)
        return eb
    panic("bc_match_cond 未知 pattern: " + str(pattern))

# ---------- B1：赋值目标发射（Assign/复合赋值 目标 ∈ Var/Index/Field） ----------
# 复合赋值语义：先读目标旧值 → 求值 rhs → 二元运算 → 写回（对齐 cg_assign_op_*）
def bc_assign_local_slot(s, op, rhs, func):
    if op == "Assign":
        bc_emit_expr(rhs, s, func)
        return
    let tr = bc_tmp(func)
    bc_emit_expr(rhs, tr, func)
    bc_emit_inst(func, bc_binop_op(bc_assign_op_name(op)), s, s, tr)

def bc_assign_global(name, op, rhs, func):
    let g = bc_g_add(g_bcm["globals"], name)
    if op == "Assign":
        let t = bc_tmp(func)
        bc_emit_expr(rhs, t, func)
        bc_emit_inst(func, "SETG", g, t, 0)
        return
    let t = bc_tmp(func)
    bc_emit_inst(func, "GETG", t, g, 0)
    let tr = bc_tmp(func)
    bc_emit_expr(rhs, tr, func)
    bc_emit_inst(func, bc_binop_op(bc_assign_op_name(op)), t, t, tr)
    bc_emit_inst(func, "SETG", g, t, 0)

def bc_assign_index(tgt, op, rhs, func):
    # tgt = [Index, obj, idx, pos]：obj[idx] op= rhs
    let so = bc_tmp(func)
    bc_emit_expr(tgt[1], so, func)
    let si = bc_tmp(func)
    bc_emit_expr(tgt[2], si, func)
    let sv = bc_tmp(func)
    if op == "Assign":
        bc_emit_expr(rhs, sv, func)
    else:
        bc_emit_inst(func, "INDEX", sv, so, si)
        let tr = bc_tmp(func)
        bc_emit_expr(rhs, tr, func)
        bc_emit_inst(func, bc_binop_op(bc_assign_op_name(op)), sv, sv, tr)
    bc_emit_inst(func, "SETIDX", sv, so, si)

def bc_assign_field(tgt, op, rhs, func):
    # tgt = [Field, obj, name, pos]：obj.name op= rhs
    let so = bc_tmp(func)
    bc_emit_expr(tgt[1], so, func)
    let nn = bc_n_add(g_bcm["n_pool"], rust_unescape(tgt[2]))
    let sv = bc_tmp(func)
    if op == "Assign":
        bc_emit_expr(rhs, sv, func)
    else:
        bc_emit_inst(func, "GETF", sv, so, nn)
        let tr = bc_tmp(func)
        bc_emit_expr(rhs, tr, func)
        bc_emit_inst(func, bc_binop_op(bc_assign_op_name(op)), sv, sv, tr)
    bc_emit_inst(func, "SETF", sv, so, nn)

# 赋值 op 名 → 二元表达式 op 名（bc_binop_op 消费；映射对齐 cg_assign_op_*）
def bc_assign_op_name(op):
    if op == "Plus":
        return "Add"
    if op == "Minus":
        return "Sub"
    if op == "Star":
        return "Mul"
    if op == "Slash":
        return "Div"
    if op == "IntDiv":
        return "IntDiv"
    if op == "Mod":
        return "Mod"
    if op == "Pow":
        return "Pow"
    if op == "BitAnd":
        return "BitAnd"
    if op == "BitOr":
        return "BitOr"
    if op == "BitXor":
        return "BitXor"
    if op == "Shl":
        return "Shl"
    if op == "Shr":
        return "Shr"
    if op == "ShrU":
        return "ShrU"
    panic("bc_assign_op_name 未知赋值 op: " + str(op))

# ---------- 语句发射（A1 子集；B1 扩 容器/字段/方法/For） ----------
def bc_emit_stmt_inner(stmt, func):
    let ty = stmt[0]
    if ty == "VarDecl":
        # kind=stmt[1](Let/Var/Const) name=stmt[2] ty=stmt[3] init=stmt[4]
        let name = rust_unescape(stmt[2])
        if stmt[4] == null:
            # 无初值声明：函数内帧槽零=PX_NULL 无需指令；顶层 SETG null
            # （对齐 codegen rhs=px_null() → px_set_global）
            if func["is_top"]:
                let t = bc_tmp(func)
                bc_emit_null(func, t)
                let g = bc_g_add(g_bcm["globals"], name)
                bc_emit_inst(func, "SETG", g, t, 0)
            return
        if func["is_top"]:
            # 顶层（含顶层块内）VarDecl = 全局 SETG（codegen：err_labels 空）
            let t = bc_tmp(func)
            bc_emit_expr(stmt[4], t, func)
            let g = bc_g_add(g_bcm["globals"], name)
            bc_emit_inst(func, "SETG", g, t, 0)
            return
        # 函数内 VarDecl = 局部槽（hoist 已预占或就地分配；遮蔽同名全局）
        let s = bc_slot(func, name)
        bc_emit_expr(stmt[4], s, func)
        return
    if ty == "Assign":
        # B1：Assign 目标 ∈ Var/Index/Field；op ∈ Assign/复合/Append
        #   （Append `a <- rhs` ≡ a.append(rhs)，cg px_method 桥语义）
        let tgt = stmt[1]
        let op = stmt[2]
        let rhs = stmt[3]
        if op == "Append":
            let ar = [rhs]
            bc_emit_methodcall(tgt, "append", ar, -1, func)
            return
        let tty = tgt[0]
        if tty == "Var":
            let name = rust_unescape(tgt[1])
            if func["smap"].has(name):
                # 已声明局部（含 hoist）→ 局部槽赋值/复合
                bc_assign_local_slot(func["smap"][name], op, rhs, func)
                return
            if not func["is_top"] and not bc_is_global(name):
                # 函数内未声明名 → hoist 预提升为局部（Python 语义，对齐 codegen）
                let s = bc_slot(func, name)
                bc_assign_local_slot(s, op, rhs, func)
                return
            # 全局赋值（顶层 Assign / 函数内写全局名）
            bc_assign_global(name, op, rhs, func)
            return
        if tty == "Index":
            bc_assign_index(tgt, op, rhs, func)
            return
        if tty == "Field":
            bc_assign_field(tgt, op, rhs, func)
            return
        panic("bc_emit_stmt Assign 目标未实现: " + str(tgt))
    if ty == "Return":
        if stmt[1] != null:
            let t = bc_tmp(func)
            bc_emit_expr(stmt[1], t, func)
            bc_emit_inst(func, "RET", t, 0, 0)
            return
        bc_emit_inst(func, "RET0", 0, 0, 0)
        return
    if ty == "ExprStmt":
        # A1 表达式无副作用调用；发到临时槽丢弃（含未支持 tag 会 panic 暴露）
        let t = bc_tmp(func)
        bc_emit_expr(stmt[1], t, func)
        return
    if ty == "If":
        bc_emit_if(stmt, func)
        return
    if ty == "While":
        bc_emit_while(stmt, func)
        return
    if ty == "For":
        bc_emit_for(stmt, func)
        return
    if ty == "Break":
        # A3：跳当前最内层循环 end（占位待 patch）
        let loops = func["loops"]
        if len(loops) == 0:
            panic("bc_emit Break 不在循环内")
        let ctx = loops[len(loops) - 1]
        let j = len(func["bc"])
        bc_emit_inst(func, "JMP", 0, 0, 0)
        ctx["breaks"].append(j)
        return
    if ty == "Continue":
        # A3：跳当前最内层循环 cont_target（while=cond 起点）
        let loops = func["loops"]
        if len(loops) == 0:
            panic("bc_emit Continue 不在循环内")
        let ctx = loops[len(loops) - 1]
        let j = len(func["bc"])
        bc_emit_inst(func, "JMP", 0, 0, 0)
        ctx["conts"].append(j)
        return
    if ty == "Empty":
        return
    if ty == "TypeConst":
        # B2：函数体内 const enum 定义无运行时语句（值在访问处内联折叠）
        return
    if ty == "ChanDecl":
        # B5：ch = chan()（GETG chan native → CALL 0 参）；顶层 SETG / 函数内局部槽
        let name = rust_unescape(stmt[1])
        let t = bc_tmp(func)
        let cs = bc_tmp(func)
        let gs = bc_g_add(g_bcm["globals"], "chan")
        bc_emit_inst(func, "GETG", cs, gs, 0)
        bc_emit_inst(func, "CALL", t, cs, 0)
        if func["is_top"]:
            let g = bc_g_add(g_bcm["globals"], name)
            bc_emit_inst(func, "SETG", g, t, 0)
        else:
            let s = bc_slot(func, name)
            bc_emit_inst(func, "MOV", s, t, 0)
        return
    if ty == "Send":
        # B5：send ch, v ≡ ch.send(v)（chan.send 方法桥 → px_chan_send）
        let vl = [stmt[2]]
        bc_emit_methodcall(stmt[1], "send", vl, -1, func)
        return
    if ty == "Recv":
        # B5：recv ch ≡ ch.recv()（值丢弃）
        bc_emit_methodcall(stmt[1], "recv", [], -1, func)
        return
    if ty == "Spawn":
        # B5：spawn f(args) ≡ spawn("f", args...) —— spawn native 按名在全局表找函数
        #   （px_spawn_name 语义；VM 启动期注册 bi_vm_spawn）
        let ex = stmt[1]
        if ex[0] == "Call" and ex[1][0] == "Var":
            let fname = rust_unescape(ex[1][1])
            let args = ex[2]
            let t = bc_tmp(func)
            let cs = bc_tmp(func)
            let argc = 1 + len(args)
            let need = cs + 1 + argc
            while func["next_slot"] < need:
                bc_tmp(func)
            let gs = bc_g_add(g_bcm["globals"], "spawn")
            bc_emit_inst(func, "GETG", cs, gs, 0)
            let k = bc_k_add(g_bcm["k_pool"], "str", 0, 0.0, fname)
            bc_emit_inst(func, "LOADK", cs + 1, k, 0)
            var ai = 0
            while ai < len(args):
                bc_emit_expr(args[ai], cs + 2 + ai, func)
                ai += 1
            bc_emit_inst(func, "CALL", t, cs, argc)
            return
        panic("bc_emit Spawn 仅支持直接函数调用: " + str(ex))
    if ty == "Select":
        bc_emit_select(stmt, func)
        return
    panic("bc_emit_stmt 未实现: " + str(stmt))

# ---------- B5：select 语句（顺序 try_recv + else / 无 else 无限重试） ----------
# Select: arms=[[bind?, caseExpr(ch.recv()), body(stmts)..]..], else_b=stmt[2]。
# 语义对齐 cg_gen_select：每个 arm 的 chan 非阻塞 try（命中消费+执行 body+退出 select；
# 未命中试下一 arm；全未命中 → else（若有）否则重试循环）。命中值 t 绑到 bind 变量
# （若有）。chan_try_recv native 命中返回收到的值、未命中返回 null（EQ null 判未命中；
# 真 null 消息边缘误判，记录）。
def bc_emit_select(stmt, func):
    let arms = stmt[1]
    let else_b = stmt[2]
    let n = len(arms)
    # 求值各 arm chan 表达式（arm[1] = ch.recv() → obj = arm[1][1][1]）到 chs[i]
    let chs = []
    var ai = 0
    while ai < n:
        let case_e = arms[ai][1]
        # case 表达式形如 Call(Field(ch, recv))；取 chan 对象
        if case_e[0] != "Call" or case_e[1][0] != "Field":
            panic("bc_emit select case 仅支持 ch.recv(): " + str(case_e))
        let cslot = bc_tmp(func)
        bc_emit_expr(case_e[1][1], cslot, func)
        chs.append(cslot)
        ai += 1
    var loop_label = -1
    if else_b == null:
        loop_label = len(func["bc"])
    var last_miss = -1
    var pend = []
    var gtry = bc_g_add(g_bcm["globals"], "chan_try_recv")
    let nullk = bc_k_add(g_bcm["k_pool"], "null", 0, 0.0, "")
    ai = 0
    while ai < n:
        if last_miss >= 0:
            bc_patch_off(func, last_miss, len(func["bc"]))
        # t = chan_try_recv(ch_i)：GETG cs；args cs+1=ch
        let cs = bc_tmp(func)
        let t = bc_tmp(func)
        let need2 = cs + 2
        while func["next_slot"] < need2:
            bc_tmp(func)
        bc_emit_inst(func, "GETG", cs, gtry, 0)
        bc_emit_inst(func, "MOV", cs + 1, chs[ai], 0)
        bc_emit_inst(func, "CALL", t, cs, 1)
        # 未命中（t == null）→ last_miss
        let te = bc_tmp(func)
        let tn = bc_tmp(func)
        bc_emit_inst(func, "LOADK", tn, nullk, 0)
        bc_emit_inst(func, "EQ", te, t, tn)
        let mj = len(func["bc"])
        bc_emit_inst(func, "JMPT", te, 0, 0)
        last_miss = mj
        # 命中：bind 绑定 + body
        let bind = arms[ai][0]
        if bind != null:
            let bname = rust_unescape(bind)
            let bs = bc_slot(func, bname)
            bc_emit_inst(func, "MOV", bs, t, 0)
        bc_emit_stmts(arms[ai][2], func)
        let jj = len(func["bc"])
        bc_emit_inst(func, "JMP", 0, 0, 0)
        pend.append(jj)
        ai += 1
    # 全部未命中：else 起点（若有）；否则 JMP 回 retry
    if last_miss >= 0:
        bc_patch_off(func, last_miss, len(func["bc"]))
    if else_b != null:
        bc_emit_stmts(else_b, func)
    else:
        let jb = len(func["bc"])
        bc_emit_inst(func, "JMP", 0, 0, 0)
        bc_patch_off(func, jb, loop_label)
    let end = len(func["bc"])
    var pi = 0
    while pi < len(pend):
        bc_patch_off(func, pend[pi], end)
        pi += 1

# SRCLINE 追踪（对齐 cg_gen_stmt wrapper；stmt 末位 = pos [line,col]）
def bc_emit_stmt(stmt, func):
    var line = 0
    if len(stmt) > 0:
        let p = stmt[len(stmt) - 1]
        if type(p) == "list" and len(p) >= 1 and type(p[0]) == "int":
            line = p[0]
    if line > 0:
        bc_emit_inst(func, "SRCLINE", 0, line, 0)
    bc_emit_stmt_inner(stmt, func)

def bc_emit_stmts(stmts, func):
    var i = 0
    while i < len(stmts):
        bc_emit_stmt(stmts[i], func)
        i += 1

# ---------- if / while（JMPF/JMP 回填） ----------
# If: branches=[[cond,body]...]（elif 折叠），else_b=stmt[2] 或 null。
# 布局：cond→JMPF(假跳下一分支起点/else起点/end) → body → (JMP end)...
# JMPF_i 目标 = body_i 完的位置（下一分支 cond / else / end）。
def bc_emit_if(stmt, func):
    let brs = stmt[1]          # [[cond, body], ...]
    let else_b = stmt[2]
    let n = len(brs)
    var pend_jmp = []          # branch body 尾 JMP end 的占位 idx
    var bi = 0
    while bi < n:
        let cond = brs[bi][0]
        let body = brs[bi][1]
        let t = bc_tmp(func)
        bc_emit_expr(cond, t, func)
        let jf = len(func["bc"])
        bc_emit_inst(func, "JMPF", t, 0, 0)
        bc_emit_stmts(body, func)
        if bi < n - 1 or else_b != null:
            # 还有后续（elif 分支 / else）→ then 尾 JMP（pend 待 patch 到 end）；
            # JMPF 假值落点 = JMP 之后（下一分支 cond / else 起点）
            let j = len(func["bc"])
            bc_emit_inst(func, "JMP", 0, 0, 0)
            bc_patch_off(func, jf, len(func["bc"]))
            pend_jmp.append(j)
        else:
            # 无后续：假值直接落 body 完 = end
            bc_patch_off(func, jf, len(func["bc"]))
        bi += 1
    if else_b != null:
        bc_emit_stmts(else_b, func)
    let end = len(func["bc"])
    var ji = 0
    while ji < len(pend_jmp):
        bc_patch_off(func, pend_jmp[ji], end)
        ji += 1

# While: loop_start → cond → JMPF(假→end) → body → JMP(回 loop_start)
# A3：break/continue —— 循环上下文入 func.loops 栈；break=JMP end、
# continue=JMP loop_start（重新求 cond）；body 发完/end 确定后统一回填。
def bc_emit_while(stmt, func):
    let cond = stmt[1]
    let body = stmt[2]
    let loop_start = len(func["bc"])
    let t = bc_tmp(func)
    bc_emit_expr(cond, t, func)
    let jf = len(func["bc"])
    bc_emit_inst(func, "JMPF", t, 0, 0)
    let ctx = bc_new_dict()
    ctx["breaks"] = []
    ctx["conts"] = []
    func["loops"].push(ctx)
    bc_emit_stmts(body, func)
    func["loops"].pop()
    let jb = len(func["bc"])
    bc_emit_inst(func, "JMP", 0, 0, 0)
    let end = len(func["bc"])
    bc_patch_off(func, jb, loop_start)
    bc_patch_off(func, jf, end)
    var bi = 0
    while bi < len(ctx["breaks"]):
        bc_patch_off(func, ctx["breaks"][bi], end)
        bi += 1
    bi = 0
    while bi < len(ctx["conts"]):
        bc_patch_off(func, ctx["conts"][bi], loop_start)
        bi += 1

# B1: For —— 索引迭代（对齐 codegen cg For：i in 0..len(iter)，v=iter[i]）
# 展开：iter→槽 its → n = CALL len(its) → ctr=0 →
#       loop: cond(ctr<n) JMPF end → v=INDEX(its,ctr) → body →
#       ctr+=1 → JMP loop；break/continue 经 func.loops ctx 回填
#       （continue 跳 loop-back 处，即增量后重判 cond —— Python for 语义）。
def bc_emit_for(stmt, func):
    let vname = rust_unescape(stmt[1])
    let iter = stmt[2]
    let body = stmt[3]
    var vs = -1
    if func["smap"].has(vname):
        vs = func["smap"][vname]
    else:
        vs = bc_slot(func, vname)
    # iterable 求值一次入 its（先求值，len 用其结果）
    let its = bc_tmp(func)
    bc_emit_expr(iter, its, func)
    # n = len(its)：CALL native len（其真实参数区 fnl+1）
    let fnl = bc_tmp(func)
    let nslot = bc_tmp(func)
    while func["next_slot"] < fnl + 2:
        bc_tmp(func)
    let gl = bc_g_add(g_bcm["globals"], "len")
    bc_emit_inst(func, "GETG", fnl, gl, 0)
    bc_emit_inst(func, "MOV", fnl + 1, its, 0)
    bc_emit_inst(func, "CALL", nslot, fnl, 1)
    # ctr = 0
    let ctr = bc_tmp(func)
    bc_emit_int(func, ctr, 0)
    let loop_start = len(func["bc"])
    # cond: ctr < n
    let lt = bc_tmp(func)
    bc_emit_inst(func, "LT", lt, ctr, nslot)
    let jf = len(func["bc"])
    bc_emit_inst(func, "JMPF", lt, 0, 0)
    # 循环变量 = its[ctr]
    bc_emit_inst(func, "INDEX", vs, its, ctr)
    let ctx = bc_new_dict()
    ctx["breaks"] = []
    ctx["conts"] = []
    func["loops"].push(ctx)
    bc_emit_stmts(body, func)
    func["loops"].pop()
    # ctr += 1
    let one = bc_tmp(func)
    bc_emit_int(func, one, 1)
    bc_emit_inst(func, "ADD", ctr, ctr, one)
    let jb = len(func["bc"])
    bc_emit_inst(func, "JMP", 0, 0, 0)
    let end = len(func["bc"])
    bc_patch_off(func, jb, loop_start)
    bc_patch_off(func, jf, end)
    var bi = 0
    while bi < len(ctx["breaks"]):
        bc_patch_off(func, ctx["breaks"][bi], end)
        bi += 1
    bi = 0
    while bi < len(ctx["conts"]):
        bc_patch_off(func, ctx["conts"][bi], jb)
        bi += 1

# ---------- 函数发射 ----------
# 顶层 FuncDef → PxVMFunc（body 语句发射 + 尾 RET0 对齐 codegen return px_null()）
def bc_emit_func_def(f):
    let name = rust_unescape(f[1])
    return bc_emit_func_body(f, name)

# B2：impl 方法 → 注册名 "Type.method"（self=首参，与普通函数同构发射）
def bc_emit_impl_def(m, tname):
    let mname = rust_unescape(m[1])
    return bc_emit_func_body(m, tname + "." + mname)

# 统一函数体发射（顶层 FuncDef / impl 方法同构；name=注册名）
def bc_emit_func_body(f, name):
    let params = f[2]
    var arity = len(params)
    var pi = 0
    while pi < len(params):
        if params[pi][3] != null:
            panic("bc_emit 默认参数未实现（A2+）: " + name + " 参数 #" + str(pi))
        pi += 1
    let func = bc_new_func(name, arity)
    # 参数槽 0..arity-1（smap 登记）
    pi = 0
    while pi < arity:
        func["smap"][rust_unescape(params[pi][1])] = pi
        pi += 1
    # hoist 局部预占（跳过已登记名；A1 不处理嵌套 def/For）
    let hoist = []
    bc_collect_hoist(f[4], hoist)
    var hi = 0
    while hi < len(hoist):
        let nm = hoist[hi]
        if func["smap"].has(nm):
            hi += 1
            continue
        if bc_is_global(nm):
            hi += 1
            continue
        bc_slot(func, nm)
        hi += 1
    bc_emit_stmts(f[4], func)
    bc_emit_inst(func, "RET0", 0, 0, 0)
    func["nslots"] = func["next_slot"]
    return func

# 合成 top 函数（顶层可执行语句；末尾 HALT 或 main 调用约定 RET）
# A4：has_main=1 → 末尾 GETG main→CALL(argc=0)→RET（返回 main 结果给 run_module，
# driver 按 codegen 语义转退出码）；has_main=0 → HALT（顶层跑完 return 0）。
def bc_emit_func_top(stmts, topname, has_main):
    let func = bc_new_func(topname, 0)
    func["is_top"] = true
    bc_emit_stmts(stmts, func)
    if has_main:
        let cs = bc_tmp(func)
        let gmain = bc_g_add(g_bcm["globals"], "main")
        bc_emit_inst(func, "GETG", cs, gmain, 0)
        let rs = bc_tmp(func)
        bc_emit_inst(func, "CALL", rs, cs, 0)
        bc_emit_inst(func, "RET", rs, 0, 0)
    else:
        bc_emit_inst(func, "HALT", 0, 0, 0)
    func["nslots"] = func["next_slot"]
    return func

# ---------- 模块级入口（对齐 cg_generate 顶层流程） ----------
# prog = 解析+import 合并后的 Program（与现 codegen 同输入同粒度）
def bc_emit_program(prog):
    let items = prog[1]
    let m = bc_new_module("<module>")
    g_bcm = m
    # B2：收集类型元数据 —— structs/enums（顶层 StructDef/EnumDef）+ consts（递归
    #   含函数体内 TypeConst）+ impl 方法列表（对齐 cg_collect_types/cg_collect_consts）
    var i = 0
    while i < len(items):
        let st = items[i]
        let ty = st[0]
        if ty == "StructDef":
            let sd = bc_new_dict()
            sd["name"] = rust_unescape(st[1])
            let fnames = []
            var fi = 0
            while fi < len(st[2]):
                fnames.append(rust_unescape(st[2][fi][1]))
                fi += 1
            sd["fnames"] = fnames
            m["structs"].push(sd)
        elif ty == "EnumDef":
            let vnames = []
            var vi = 0
            while vi < len(st[2]):
                vnames.append(rust_unescape(st[2][vi][1]))
                vi += 1
            m["enums"][rust_unescape(st[1])] = vnames
        i += 1
    bc_collect_consts(items)
    let impl_list = bc_collect_impl_list(items)
    # 第一遍：收集全局名（对齐 cg_generate 顺序：FuncDef/ExternDef/VarDecl/Assign）
    i = 0
    while i < len(items):
        let st = items[i]
        let ty = st[0]
        if ty == "FuncDef":
            bc_g_add(m["globals"], rust_unescape(st[1]))
        elif ty == "VarDecl":
            bc_g_add(m["globals"], rust_unescape(st[2]))
        elif ty == "Assign":
            let tgt = st[1]
            if tgt[0] == "Var":
                bc_g_add(m["globals"], rust_unescape(tgt[1]))
        i += 1
    # 第二遍：funcs —— impl 方法（"Type.method" 字典序，对齐 cg_generate 先于
    #   顶层 def）+ 顶层 FuncDef（items 序）
    i = 0
    while i < len(impl_list):
        let im = impl_list[i]
        let f = bc_emit_impl_def(im[1], im[0])
        m["funcs"].push(f)
        i += 1
    i = 0
    while i < len(items):
        let st = items[i]
        if st[0] == "FuncDef":
            let f = bc_emit_func_def(st)
            m["funcs"].push(f)
        i += 1
    # 第三遍：顶层可执行语句 → top 函数（非定义类，含 main 的调用由 S3-B CALL 接入）
    let top_stmts = []
    i = 0
    while i < len(items):
        let st = items[i]
        let ty = st[0]
        if ty != "FuncDef" and ty != "StructDef" and ty != "EnumDef" and ty != "TraitDef" and ty != "ImplDef" and ty != "Import" and ty != "ExternDef" and ty != "TypeConst":
            top_stmts.append(st)
        i += 1
    # 顶层是否有 main 定义（A4：有 → Top 末尾 call main + RET，退出码由 driver 转换）
    var has_main = false
    i = 0
    while i < len(items):
        let st = items[i]
        if st[0] == "FuncDef" and rust_unescape(st[1]) == "main":
            has_main = true
        i += 1
    let top = bc_emit_func_top(top_stmts, "<top>", has_main)
    m["funcs"].push(top)
    m["top"] = len(m["funcs"]) - 1
    return m

# ---------- dump（A1 验证：BCModule 可读文本，直读断言） ----------
def bc_dump_module(m):
    print("# BCModule " + m["name"])
    print("# K " + str(len(m["k_pool"])))
    var ki = 0
    while ki < len(m["k_pool"]):
        let k = m["k_pool"][ki]
        if k["kind"] == "int":
            print("K " + str(ki) + " int " + str(k["i"]))
        elif k["kind"] == "float":
            print("K " + str(ki) + " float " + str(k["f"]))
        elif k["kind"] == "str":
            print("K " + str(ki) + " str \"" + cg_escape_str(k["s"]) + "\"")
        elif k["kind"] == "bool":
            var bv = "false"
            if k["i"] != 0:
                bv = "true"
            print("K " + str(ki) + " bool " + bv)
        elif k["kind"] == "func":
            print("K " + str(ki) + " func " + str(k["i"]))
        else:
            print("K " + str(ki) + " null")
        ki += 1
    print("# G " + str(len(m["globals"])))
    var gi = 0
    while gi < len(m["globals"]):
        print("G " + str(gi) + " " + m["globals"][gi])
        gi += 1
    print("# funcs " + str(len(m["funcs"])) + " top=" + str(m["top"]))
    var fi = 0
    while fi < len(m["funcs"]):
        let f = m["funcs"][fi]
        print("== func " + f["name"] + " arity=" + str(f["arity"]) + " ndefault=" + str(f["ndefault"]) + " nslots=" + str(f["nslots"]))
        var pc = 0
        while pc < len(f["bc"]):
            let ins = f["bc"][pc]
            print(str(pc) + ":" + ins[0] + " " + str(ins[2]) + " " + str(ins[3]) + " " + str(ins[4]))
            pc += 1
        fi += 1

# ---------- emit-c（A2：把 BCModule 序列化为可链接 C 静态初值） ----------
# 产出：含 main() 的完整 C 文件 —— 静态 PxK/N/G/funcs(bc)/PxBCModule 初值 +
#   main 调 px_vm_run_module（注册全局函数 + 跑 Top）。与 codegen 生成的 C
#   同入口（px_args_init/px_register_builtins）；顶层无 main 函数时 return 0
#   （对齐 codegen 行为）；PX_BC_DUMP 环境变量 → 打印非函数全局值（A 阶段对拍）。
def bc_emit_c_program(prog):
    let m = bc_emit_program(prog)
    var out = "/* 由 bc_emit.px (M89-S3) 自动生成 — 字节码模块（VM 执行） */\n"
    out += "#include \"runtime.h\"\n#include \"vm.h\"\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n"
    out += "static const PxBCModule s_mod;\n\n"
    # K 常量池
    out += "static const PxK s_K[] = {\n"
    var ki = 0
    while ki < len(m["k_pool"]):
        let k = m["k_pool"][ki]
        if k["kind"] == "int":
            out += "    {PXK_INT, " + str(k["i"]) + ", 0, NULL},\n"
        elif k["kind"] == "float":
            out += "    {PXK_FLT, 0, " + cg_fmt_float(k["f"]) + ", NULL},\n"
        elif k["kind"] == "str":
            out += "    {PXK_STR, 0, 0, \"" + cg_escape_str(k["s"]) + "\"},\n"
        elif k["kind"] == "bool":
            var bv = "0"
            if k["i"] != 0:
                bv = "1"
            out += "    {PXK_BOOL, " + bv + ", 0, NULL},\n"
        elif k["kind"] == "func":
            out += "    {PXK_FUNC, " + str(k["i"]) + ", 0, NULL},\n"
        else:
            out += "    {PXK_NULL, 0, 0, NULL},\n"
        ki += 1
    out += "};\n\n"
    # N 名字池（A1 预留，空表也输出保持结构完整）
    out += "static const char* s_N[] = {\n"
    var ni = 0
    while ni < len(m["n_pool"]):
        out += "    \"" + cg_escape_str(m["n_pool"][ni]) + "\",\n"
        ni += 1
    out += "};\n\n"
    # G 全局槽名表
    out += "static const char* s_G[] = {\n"
    var gi = 0
    while gi < len(m["globals"]):
        out += "    \"" + cg_escape_str(m["globals"][gi]) + "\",\n"
        gi += 1
    out += "};\n\n"
    # B2：struct 类型元数据表（NEWSTRUCT 运行时字段名来源）
    var sti = 0
    while sti < len(m["structs"]):
        let sd = m["structs"][sti]
        out += "static const char* s_st_" + str(sti) + "[] = {\n"
        var sfi = 0
        while sfi < len(sd["fnames"]):
            out += "    \"" + cg_escape_str(sd["fnames"][sfi]) + "\",\n"
            sfi += 1
        out += "};\n"
        sti += 1
    out += "static const PxStructDef s_structs[] = {\n"
    sti = 0
    while sti < len(m["structs"]):
        let sd = m["structs"][sti]
        out += "    {\"" + cg_escape_str(sd["name"]) + "\", s_st_" + str(sti) + ", " + str(len(sd["fnames"])) + "},\n"
        sti += 1
    out += "};\n\n"
    # funcs：每个函数一个 bc 数组（s_bc_<fi>）
    var fi = 0
    while fi < len(m["funcs"]):
        let f = m["funcs"][fi]
        out += "static const PxInst s_bc_" + str(fi) + "[] = {\n"
        var pc = 0
        while pc < len(f["bc"]):
            let ins = f["bc"][pc]
            out += "    {PXOP_" + ins[0] + ", " + str(ins[1]) + ", " + str(ins[2]) + ", " + str(ins[3]) + ", " + str(ins[4]) + "},\n"
            pc += 1
        out += "};\n"
        fi += 1
    out += "\n"
    # 函数表（mod 前向引用 s_mod）
    out += "static const PxVMFunc s_funcs[] = {\n"
    fi = 0
    while fi < len(m["funcs"]):
        let f = m["funcs"][fi]
        out += "    {.name=\"" + cg_escape_str(f["name"]) + "\", .arity=" + str(f["arity"]) + ", .ndefault=" + str(f["ndefault"]) + ", .nslots=" + str(f["nslots"]) + ", .bc=s_bc_" + str(fi) + ", .nbc=" + str(len(f["bc"])) + ", .mod=&s_mod, .upvals=NULL},\n"
        fi += 1
    out += "};\n\n"
    # 模块
    out += "static const PxBCModule s_mod = {\n"
    out += "    .name=\"<module>\", .K=s_K, .nK=" + str(len(m["k_pool"])) + ", .N=s_N, .nN=" + str(len(m["n_pool"])) + ",\n"
    out += "    .G=s_G, .nG=" + str(len(m["globals"])) + ", .funcs=s_funcs, .nfuncs=" + str(len(m["funcs"])) + ", .top_idx=" + str(m["top"]) + ",\n"
    out += "    .structs=s_structs, .nstructs=" + str(len(m["structs"])) + ",\n"
    out += "};\n\n"
    # main（A2：跑 Top；main() 用户函数调用约定随 S3-B/CALL 接入）
    out += "int main(int argc, char** argv) {\n"
    out += "    px_args_init(argc, argv);\n"
    out += "    px_register_builtins();\n"
    out += "    LXValue _r = px_vm_run_module(px_vm_state(), &s_mod);\n"
    out += "    int _code = 0;\n"
    out += "    if (px_is_result(_r)) {\n"
    out += "        if (!px_result_ok(_r)) {\n"
    out += "            fprintf(stderr, \"错误: %s\\n\", px_to_string(px_result_unwrap(_r)));\n"
    out += "            _code = 1;\n"
    out += "        } else {\n"
    out += "            LXValue _uv = px_result_unwrap(_r);\n"
    out += "            if (_uv.type == PX_INT) _code = (int)_uv.as.i;\n"
    out += "        }\n"
    out += "    } else if (_r.type == PX_INT) {\n"
    out += "        _code = (int)_r.as.i;\n"
    out += "    }\n"
    out += "    if (getenv(\"PX_BC_DUMP\")) {\n"
    out += "        int _i;\n"
    out += "        for (_i = 0; _i < (int)s_mod.nG; _i++) {\n"
    out += "            LXValue _v = px_get_global(s_mod.G[_i]);\n"
    out += "            if (_v.type != PX_FUNC && _v.type != PX_NATIVE)\n"
    out += "                printf(\"%s=%s\\n\", s_mod.G[_i], px_to_string(_v));\n"
    out += "        }\n"
    out += "    }\n"
    out += "    return _code;\n"
    out += "}\n"
    return out
