# ============================================================
# M-B6: codegen 用 PuXian 重写（自举第四步）—— AST → C 源码
# ------------------------------------------------------------
# 对拍契约（MINI_SUBSET §五 build 层）：Rust 版 px build 生成的
# C 源码（golden/*.c）与本 codegen.px 输出逐字节一致。
# 用法：
#   px run codegen.px <file.px>   # 输出 C 源码到 stdout
# 架构：
#   - 复用 parser.px 的 lex/parse（import；全局状态在本文件声明，
#     parser/pxlexer 函数运行时查主文件全局表）
#   - cg_stmt.px：语句生成（gen_stmt/gen_select）
#   - cg_expr.px：表达式生成（gen_expr/gen_pattern_cond/gen_lambda）
# 对齐 Rust compiler/src/codegen.rs（M-B6 起 impl 方法按
# "类型.方法" 字典序输出，保证跨进程确定性）
# ============================================================
import "parser.px"
import "cg_stmt.px"
import "cg_expr.px"
import "cg_module.px"
# ---------- lex/parser 全局状态（主文件声明；import 不注册模块顶层 let） ----------
var g_src = ""
var g_len = 0
var g_pos = 0
var g_line = 1
var g_col = 1
var g_indent_stack = [0]
var g_at_line_start = true
var g_toks = []
var g_count = 0
var g_pending = []
let KEYWORDS = {"let": "let", "var": "var", "const": "const", "def": "def", "fn": "fn", "struct": "struct", "enum": "enum", "trait": "trait", "impl": "impl", "match": "match", "case": "case", "if": "if", "elif": "elif", "else": "else", "for": "for", "while": "while", "in": "in", "and": "and", "or": "or", "not": "not", "return": "return", "break": "break", "continue": "continue", "import": "import", "from": "from", "pub": "pub", "as": "as", "spawn": "spawn", "chan": "chan", "send": "send", "recv": "recv", "select": "select", "true": "true", "false": "false", "null": "null", "None": "null", "self": "self", "capture": "capture", "extern": "extern"}
let CTRL_ALL = "\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{b}\u{c}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f}\u{7f}\u{80}\u{81}\u{82}\u{83}\u{84}\u{85}\u{86}\u{87}\u{88}\u{89}\u{8a}\u{8b}\u{8c}\u{8d}\u{8e}\u{8f}\u{90}\u{91}\u{92}\u{93}\u{94}\u{95}\u{96}\u{97}\u{98}\u{99}\u{9a}\u{9b}\u{9c}\u{9d}\u{9e}\u{9f}"
var p_toks = []
var p_pos = 0
var p_brack = 0  # M119：括号深度（parse 前重置）
# ---------- codegen 全局状态 ----------
var cg_closures = ""
var cg_structs = {"_": 0}
var cg_enums = {"_": 0}
var cg_impls = {"_": 0}
var cg_vars = {"_": 0}
var cg_var_types = {"_": 0}
# M129（qg-issue 87 缺陷 21）：本帧需要"装箱"的局部名（闭包捕获 → upvalue cell）
var cg_cells = {"_": 0}
var cg_immutables = {"_": 0}
var cg_nonnull = {"_": 0}
var cg_ffi = {"_": 0}
var cg_const_enums = {"_": 0}  # M44：type X const 简化枚举（name → {variant: C表达式}）
var cg_globals = []
var cg_err_labels = []
var cg_uidc = 0
var cg_closure_id = 0
var cg_seq_uid = 0  # M165（缺陷 178）：序列化临时变量计数器（见 cg_gen_expr 前的说明）
var loaded = {"_": 0}
# ---------- 工具 ----------
# 空 dict 创建（PuXian 限制：{} 是空块=null，非空 dict）
def cg_new_dict():
    let d = {"_": 0}
    d.remove("_")
    return d
def cg_dict_copy(d):
    var out = cg_new_dict()
    let ks = d.keys()
    var i = 0
    while i < len(ks):
        out[ks[i]] = d[ks[i]]
        i += 1
    return out
def cg_uid():
    cg_uidc = cg_uidc + 1
    return cg_uidc
def cg_tmp():
    return "_t" + str(cg_uid())
def cg_new_var(name):
    let v = "_v" + str(cg_uid())
    cg_vars[name] = v
    # M129（缺陷 21）：新绑定遮蔽同名旧绑定 ⇒ 旧 cell 标记必须失效
    #   （否则读该名会生成 px_cell_get(非 cell)，语义/类型全错）
    if cg_cells.has(name):
        cg_cells.remove(name)
    return v
def cg_var_of(name):
    if cg_vars.has(name):
        return cg_vars[name]
    return null
# ── M129（qg-issue 87 缺陷 21）：编译轨真词法闭包（upvalue cell）──
# 读：cell 变量自动解引用；写：cell 变量写回 cell。二者必须成对使用，
# 否则会出现"声明成 list 却当普通值用"的 C 类型错误（好在是**响的**，不是静默）。
def cg_load_of(name, cv):
    if cg_cells.has(name):
        return "px_cell_get(" + cv + ")"
    return cv
def cg_store_of(name, cv, val):
    if cg_cells.has(name):
        return "px_cell_set(" + cv + ", " + val + ")"
    return cv + " = " + val
def cg_name_add(out, n):
    if n != "" and not contains(out, n):
        out.append(n)
# 收集 AST（语句或表达式，深层）里出现的所有变量引用名
def cg_ast_used(x, out):
    if type(x) != "list" or len(x) == 0:
        return
    if type(x[0]) == "string" and x[0] == "Var" and len(x) >= 2 and type(x[1]) == "string":
        cg_name_add(out, rust_unescape(x[1]))
        return
    for c in x:
        cg_ast_used(c, out)
# 收集 AST（深层）里所有"绑定名"：VarDecl 名 / Assign 目标 / For 变量 / 闭包参数
def cg_ast_bound(x, out):
    if type(x) != "list" or len(x) == 0:
        return
    let h = x[0]
    if type(h) == "string":
        if h == "VarDecl":
            cg_name_add(out, rust_unescape(x[2]))
        # M160（第 46 轮 · 缺陷 160）：**Assign 目标不是"绑定"而是"使用"** ——
        #   在"按引用捕获"语义下（解释轨 env 链 / C 轨 cell / VM 轨 cell 三轨一致），
        #   闭包体内 `x = x + 1` 是对**外层** x 的读写，不是新建局部。
        #   此前把它记进 bound ⇒ 与 used 里的 x 相消 ⇒ 自由变量集漏掉 x
        #   ⇒ 外层不装箱、闭包体把 x 当成全局名 ⇒ 运行期「未定义变量: x」
        #   （实测：`var x = 0` + `let g = fn (): x = x + 1`）。
        #   注：cg_collect_hoist_vars 仍按函数级作用域把 Assign 目标提升为**本帧**局部，
        #   两者不矛盾 —— 只有当该函数**不是**闭包本身、而是外层帧时，提升出来的局部
        #   才会因本函数内闭包引用它而被装箱。
        #   （簇内 `var x = ...` 仍由上面的 VarDecl 分支计入 bound。）
        elif h == "For":
            cg_name_add(out, rust_unescape(x[1]))
        elif h == "Closure":
            for p in x[1]:
                cg_name_add(out, rust_unescape(p[1]))
    for c in x:
        cg_ast_bound(c, out)
# 单个闭包节点的自由变量集 = 体内引用名 − 体内绑定名 − 自身参数
def cg_closure_caps(cl, out):
    let used = []
    cg_ast_used(cl[3], used)
    let bound = []
    cg_ast_bound(cl[3], bound)
    for p in cl[1]:
        cg_name_add(bound, rust_unescape(p[1]))
    for n in used:
        if not contains(bound, n):
            cg_name_add(out, n)
# 扫描整个 AST，并集所有闭包的自由变量（**超集**：多标无妨，少标才会错）
def cg_scan_closure_caps(x, out):
    if type(x) != "list" or len(x) == 0:
        return
    if type(x[0]) == "string" and x[0] == "Closure":
        cg_closure_caps(x, out)
    if type(x[0]) == "string" and x[0] == "FuncDef":
        # M160（缺陷 160）：**函数体内的 `def`** 与匿名闭包同构（同一帧内可见、按引用捕获）
        #   ⇒ 它的自由变量同样必须让外层帧把对应局部装箱。顶层 def 不会出现在这里
        #   （cg_scan_closure_caps 只扫函数体），故无副作用。
        cg_closure_caps(["Closure", x[2], x[3], x[4], [], x[5]], out)
    for c in x:
        cg_scan_closure_caps(c, out)
# M41.2：不可变变量跟踪（E3002——对 let/const 变量赋值 = 编译错误）
def cg_mark_immutable(name):
    cg_immutables[name] = 1
def cg_is_immutable(name):
    return cg_immutables.has(name)
# M113-S0（Issue 57）：弃元 / 通配名 `_`
#   语义依据：`spec.md:349/357` 只在**模式位**把 `_` 定义为弃元；`spec.md:300` 的 E3002
#   只管 `let` 绑定的**变量**。`_ = f()` 是「求值后丢弃」的标准写法（Python/Go/Rust 同源），
#   `_` 从不绑定任何变量 ⇒ 对它赋值不是「改不可变变量」。
#   但 M41.2 的不可变跟踪把 `_` 当普通名字登记 ⇒ `let _ = x` 之后的任何 `_ = y` 都误报 E3002
#   （C 轨 / VM 轨同病）。豁免只在这一处（共享层）⇒ 两轨共享同一条真相。
def cg_is_wildcard(name):
    return name == "_"
# M112-S0（Issue 45）：诊断通道必须 = stderr
#   原先 print() 走 stdout，而 C 轨的产物正是 stdout → 错误文本被写进 .c，
#   用户看到的是 gcc 抱怨一个中括号（误导性失败，比静默失败更难查）。
def cg_perr(code, msg):
    print_err("编译错误 " + code + ": " + msg)
    exit(1)
# M112-S0（Issue 45）：非致命诊断（模块缺失等）同样走 stderr，不污染产物
def cg_pwarn(msg):
    print_err("[警告] " + msg)
# M41.3：空安全 E3003——null 赋给非可空类型 = 编译错误
# 渐进类型：仅显式标注非空类型时检查；省略标注（any）/TyOptional 不查
def cg_is_nonnull_ty(ty):
    if ty == null:
        return false
    if ty[0] == "TyOptional":
        return false
    return true
# 表达式是否为 null 字面量（字面量级检查，保守渐进）
def cg_is_null_lit(e):
    if e == null:
        return false
    if e[0] == "Null":
        return true
    return false
# ============================================================
# M112-S0（Issue 46）：轨无关共享语义检查 —— C 轨 / VM 轨唯一真相
# ------------------------------------------------------------
# 问题：E3002/E3003/E3004 原先是内联在 C 轨发射器（cg_stmt / cg_expr）里的。
#   M89 文档记着"VM 侧收口时对齐"，而 M91 把默认轨切成 VM ⇒ 欠账变成默认行为：
#   VM 轨语义错误码 0 个，C 轨 3 条；cases_bad 只在 C 轨跑 ⇒ 负例对默认轨零覆盖。
# 设计：三条检查抽到此共享层（两轨消费的是同一个 prog，天然可插）。
#   C 轨：cg_stmt.px / cg_expr.px 各调一行
#   VM 轨：bc_emit.px 在 VarDecl / Assign / Call 三个 hook 各调一行
#   → 单一真相：未来第三条轨（AOT/原生）白拿，不再靠"记得对齐"。
# 约束：本层只用 codegen.px 自己的状态（cg_immutables / cg_nonnull / cg_ffi），
#   零 C 轨发射器状态依赖 ⇒ bc_emit 侧调用安全。
# 形参一律用 AST 节点（与两轨喂法一致）。
# ============================================================
# 声明语义：let/const 记不可变；显式非空标注 + null 初值 = E3003
def cg_sem_vardecl(stmt):
    # kind=stmt[1] name=stmt[2] ty=stmt[3] init=stmt[4]
    let name = rust_unescape(stmt[2])
    # M113-S0（Issue 57）：`_` 不绑定变量 ⇒ 不登记不可变、不登记非空标注
    if cg_is_wildcard(name):
        return
    if stmt[1] == "Let" or stmt[1] == "Const":
        cg_mark_immutable(name)
    let decl_ty = stmt[3]
    if cg_is_nonnull_ty(decl_ty):
        cg_nonnull[name] = 1
        if cg_is_null_lit(stmt[4]):
            cg_perr("E3003", "无法将 null 赋给非可空类型 '" + cg_ty_name(decl_ty) + "'（可空类型请用 " + cg_ty_name(decl_ty) + "? 声明）")
# 赋值语义：对不可变变量赋值 = E3002；对非空变量赋 null = E3003
# 仅 Var 目标（Index/Field 目标两轨一致不查）
def cg_sem_assign(tgt, op, rhs):
    if tgt == null:
        return
    if tgt[0] != "Var":
        return
    let name = rust_unescape(tgt[1])
    # M113-S0（Issue 57）：`_ = expr` 是弃元写法（求值后丢弃），非变量赋值 ⇒ 不查 E3002/E3003
    if cg_is_wildcard(name):
        return
    if cg_is_immutable(name):
        cg_perr("E3002", "对不可变变量 '" + name + "' 赋值（let 默认不可变，需用 let mut/var 声明可变）")
    if cg_is_null_lit(rhs) and cg_nonnull.has(name):
        cg_perr("E3003", "无法将 null 赋给非可空类型变量 '" + name + "'（可空类型请声明为 " + name + ": T?）")
# 调用语义：extern def 声明的 FFI 函数实参个数不匹配 = E3004
def cg_sem_call(callee, args):
    if callee == null:
        return
    if callee[0] != "Var":
        return
    let cname = rust_unescape(callee[1])
    if cg_ffi.has(cname):
        let decl_params = cg_ffi[cname]
        if len(args) != len(decl_params):
            cg_perr("E3004", "FFI 函数 " + cname + " 需要 " + str(len(decl_params)) + " 个参数，给出 " + str(len(args)))
# 类型显示名（错误消息用）
def cg_ty_name(ty):
    if ty == null:
        return "any"
    if ty[0] == "TyOptional":
        return cg_ty_name(ty[1]) + "?"
    if ty[0] == "TyNamed":
        return rust_unescape(ty[1])
    if ty[0] == "TyList":
        return "list[" + cg_ty_name(ty[1]) + "]"
    if ty[0] == "TyDict":
        return "{" + cg_ty_name(ty[1]) + ": " + cg_ty_name(ty[2]) + "}"
    return "any"
def cg_func_cname(name):
    var _out = []
    var i = 0
    while i < len(name):
        let c = name[i]
        let a = c >= "a" and c <= "z"
        let b = c >= "A" and c <= "Z"
        let d = c >= "0" and c <= "9"
        if a or b or d:
            _out.append(c)
        else:
            _out.append("_")
        i += 1
    return join("", _out)
def cg_find(s, sub):
    let n = len(s)
    let m = len(sub)
    var i = 0
    while i + m <= n:
        var j = 0
        var ok = true
        while j < m:
            if s[i + j] != sub[j]:
                ok = false
                break
            j += 1
        if ok:
            return i
        i += 1
    return -1
def cg_pad(n):
    var _s = []
    var i = 0
    while i < n:
        _s.append("    ")
        i += 1
    return join("", _s)
# 字符串 debug 格式（rust_str_debug，带引号）→ 原始字符串
# M155（第 37 轮 · 缺陷 148）：NUL 字符的**运行时构造**（不用字面量 `"\u{0}"`）。
#   为什么：**自举安全** —— 修复前的编译器把 `"\u{0}"` 编成空串（旧发射器 NUL 丢弃 +
#   `px_str()` 按 C 串重造），于是"用旧编译器编新源码"时本文件里的 NUL 字面量会静默变 `""`
#   （这正是缺陷 148 的成因之一：三轨「一致地错」）。运行时构造在**新旧编译器下都正确**。
def cg_nul_char():
    return bytes_to_str(int_to_bytes(0, 1))
# M155：字面量里是否含 NUL（决定发射成 `px_str` 还是长度精确的 `PX_STR_LIT`）
def cg_has_nul(s):
    let n = cg_nul_char()
    var i = 0
    while i < len(s):
        if s[i] == n:
            return true
        i += 1
    return false
def rust_unescape(s):
    let body = s[1:len(s) - 1]
    var _out = []
    var i = 0
    while i < len(body):
        let c = body[i]
        if c == "\\":
            let nxt = body[i + 1]
            if nxt == "n":
                _out.append("\n")
                i += 2
            elif nxt == "t":
                _out.append("\t")
                i += 2
            elif nxt == "r":
                _out.append("\r")
                i += 2
            elif nxt == "0":
                _out.append(cg_nul_char())
                i += 2
            elif nxt == "\"":
                _out.append("\"")
                i += 2
            elif nxt == "\\":
                _out.append("\\")
                i += 2
            elif nxt == "u":
                var j = i + 3
                var _hex = []
                while j < len(body) and body[j] != "}":
                    _hex.append(body[j])
                    j += 1
                _out.append(hex_to_char(join("", _hex)))
                i = j + 1
            else:
                _out.append(nxt)
                i += 2
        else:
            _out.append(c)
            i += 1
    return join("", _out)
# 对齐 Rust codegen.escape_str（原始字符串 → C 字面量转义）
def cg_escape_str(s):
    var _out = []
    var i = 0
    while i < len(s):
        let c = s[i]
        if c == "\\":
            _out.append("\\\\")
        elif c == "\"":
            _out.append("\\\"")
        elif c == "\n":
            _out.append("\\n")
        elif c == "\r":
            _out.append("\\r")
        elif c == "\t":
            _out.append("\\t")
        elif c == cg_nul_char():
            # M155（缺陷 148）：NUL 改为 **C 八进制转义 `\\000`（恒 3 位）**。
            #   · 为什么是 3 位：C 的八进制转义最多吃 3 位 —— 写 `\\0` 时后随的八进制
            #     数字会被吞掉（`"a\\01"` 是 `0x01` 而不是 `NUL` + `'1'`），3 位后**必停**。
            #   · 旧的「NUL 丢弃」是 M-B8 为与 Rust 版逐字节一致而立项的（那时 C 串按
            #     strlen 重造，NUL 本就表达不出来）；M155 起配套 `PX_STR_LIT` / `PXK_STR_LIT`
            #     用 `sizeof(lit) - 1` 带长度 ⇒ **NUL 可被如实表达**（对齐 Go：`"\x00"` 是 1 字节串）。
            _out.append("\\000")
        else:
            _out.append(c)
        i += 1
    return join("", _out)
# 指数格式展开（编译版 C 运行时 %g 输出 "1.5e+10" → Rust f64 Display 定点 "15000000000"）
def cg_pad_zeros(n):
    var _s = []
    var i = 0
    while i < n:
        _s.append("0")
        i += 1
    return join("", _s)
def cg_expand_sci(s):
    var ei = -1
    var i = 0
    while i < len(s):
        if s[i] == "e" or s[i] == "E":
            ei = i
            break
        i += 1
    if ei < 0:
        return s
    var mant = s[0:ei]
    var exp_s = s[ei + 1:len(s)]
    var sign = 1
    if len(exp_s) > 0 and exp_s[0] == "+":
        exp_s = exp_s[1:len(exp_s)]
    elif len(exp_s) > 0 and exp_s[0] == "-":
        sign = -1
        exp_s = exp_s[1:len(exp_s)]
    let exp = int(exp_s) * sign
    var neg = false
    if len(mant) > 0 and mant[0] == "-":
        neg = true
        mant = mant[1:len(mant)]
    var mant_int = ""
    var mant_frac = ""
    var dot = -1
    var di = 0
    while di < len(mant):
        if mant[di] == ".":
            dot = di
            break
        di += 1
    if dot < 0:
        mant_int = mant
    else:
        mant_int = mant[0:dot]
        mant_frac = mant[dot + 1:len(mant)]
    let digits = mant_int + mant_frac
    let point = len(mant_int) + exp
    var out = ""
    if point <= 0:
        out = "0." + cg_pad_zeros(0 - point) + digits
    elif point >= len(digits):
        out = digits + cg_pad_zeros(point - len(digits))
    else:
        out = digits[0:point] + "." + digits[point:len(digits)]
    if neg:
        return "-" + out
    return out
# 对齐 Rust f64 Display（codegen 里 px_float({}) 用 Display：2.0 → "2"；1e15 → "1000000000000000"）
def cg_fmt_float(v):
    var s = str(v)
    if s == "inf" or s == "-inf" or s == "nan" or s == "-nan":
        return s
    s = cg_expand_sci(s)
    let n = len(s)
    if n >= 2 and s[n - 2:n] == ".0":
        # 缺陷 130：`-0.0` 去掉 `.0` 会得到 **`-0`**，而 C 里 `-0` 是**整型常量 0**
        #   ⇒ 赋给 float 字段就是 **+0.0**，符号位在这一步丢掉（M147 门照出：VM 轨
        #   `float64_bits(-0.0)` 给 0000000000000000，而 C 轨/解释轨都给 8000…）。
        #   修法：`-0.0` **保留 `.0`**（C 按浮点常量解析，得到负零）；
        #   其余（"3.0"→"3"、"0.0"→"0"）保持原样（不扰动既有产物）。
        let stripped = s[0:n - 2]
        if stripped == "-0":
            return s
        return stripped
    # M129（qg-issue 87 缺陷 17）：展开科学计数法后若只剩**纯整数字面量**，C 对
    #   **十进制整型常量**只允许 int/long long（unsigned 不在十进制常量的类型列表里），
    #   ≥ 19 位即可能越过 int64 上界 ⇒ 编译器按扩展规则环绕到 2^64，**浮点字面量静默变值**。
    #   实测：`1e21` / `1000000000000000000000.0` / `1.0e21` 全部变成 3.8758200196842127e+18
    #   （= 1e21 mod 2^64）；`1e19` 恰好 < 2^64 只是**碰巧**对，`1e300` 同样错。
    #   修法：位数 ≥ 19 时补 `.0`，强制 C 按**浮点常量**解析（数值不变；< 19 位保持原样，
    #   不扰动既有产物/golden）。
    if not contains(s, ".") and n >= 19:
        return s + ".0"
    return s
# ---------- 类型表收集 ----------
def cg_collect_types(prog):
    let items = prog[1]
    var i = 0
    while i < len(items):
        let st = items[i]
        let ty = st[0]
        if ty == "StructDef":
            let fnames = []
            var fi = 0
            while fi < len(st[2]):
                fnames.append(rust_unescape(st[2][fi][1]))
                fi += 1
            cg_structs[rust_unescape(st[1])] = fnames
        elif ty == "EnumDef":
            let vnames = []
            var vi = 0
            while vi < len(st[2]):
                vnames.append(rust_unescape(st[2][vi][1]))
                vi += 1
            cg_enums[rust_unescape(st[1])] = vnames
        elif ty == "ImplDef":
            let tn = rust_unescape(st[1])
            if cg_impls.has(tn):
                var mi = 0
                while mi < len(st[3]):
                    cg_impls[tn].append(st[3][mi])
                    mi += 1
            else:
                cg_impls[tn] = st[3]
        i += 1
    # M44：type X const 简化枚举（递归收集，含函数体内声明）
    # 值应为常量表达式（字面量为主）；cg_gen_expr 生成 C 表达式内联到使用处
    cg_collect_consts(items)
# ---------- M44：递归收集 TypeConst（顶层 + 函数体 + 嵌套块） ----------
def cg_collect_consts(stmts):
    var i = 0
    while i < len(stmts):
        let st = stmts[i]
        let ty = st[0]
        if ty == "TypeConst":
            let tname = rust_unescape(st[1])
            let d = cg_new_dict()
            var ti = 0
            while ti < len(st[2]):
                let item = st[2][ti]
                d[rust_unescape(item[1])] = cg_gen_expr(item[2])
                ti += 1
            cg_const_enums[tname] = d
        elif ty == "FuncDef":
            cg_collect_consts(st[4])
        elif ty == "If":
            var bi = 0
            while bi < len(st[1]):
                cg_collect_consts(st[1][bi][1])
                bi += 1
            if st[2] != null:
                cg_collect_consts(st[2])
        elif ty == "For":
            cg_collect_consts(st[3])
        elif ty == "While":
            cg_collect_consts(st[2])
        i += 1
# ---------- 收集需提升到函数顶的局部变量（递归 if/for/while） ----------
# M62-L5：Python/解释器语义 = 函数级作用域（if/for/while 不新建作用域）。
# 编译模式原只对「无声明赋值（Assign 目标）」做函数顶提升（px_null 声明 + 原位赋值）；
# VarDecl（let/var/const）与 For 循环变量在嵌套块内就地声明 → 块外引用 C undeclared。
# 现把 VarDecl 与 For 循环变量一并纳入提升集：函数顶统一声明，声明处仅赋值，
# 对齐解释器（istmt.px「if/for/while 沿用 Python 语义」）。同名 VarDecl 只提升一次
# （同函数同名 = 同一变量，Python 语义）。
def cg_collect_hoist_vars(stmts, out):
    var i = 0
    while i < len(stmts):
        let st = stmts[i]
        let ty = st[0]
        if ty == "Assign":
            let tgt = st[1]
            if tgt[0] == "Var":
                let name = rust_unescape(tgt[1])
                if not contains(out, name):
                    out.append(name)
        elif ty == "VarDecl":
            let name = rust_unescape(st[2])
            if not contains(out, name):
                out.append(name)
        elif ty == "FuncDef":
            # M160（缺陷 160）：**函数体内的 `def`** 是函数级局部绑定（对齐解释轨 istmt.px：
            #   `def` 在语句位置把函数值绑到当前 env）⇒ 提升为本帧局部，声明处赋值。
            #   顶层 def 走 cg_generate，不经此处。
            let name = rust_unescape(st[1])
            if not contains(out, name):
                out.append(name)
        elif ty == "If":
            let brs = st[1]
            var bi = 0
            while bi < len(brs):
                cg_collect_hoist_vars(brs[bi][1], out)
                bi += 1
            if st[2] != null:
                cg_collect_hoist_vars(st[2], out)
        elif ty == "For":
            let lv = rust_unescape(st[1])
            if not contains(out, lv):
                out.append(lv)
            cg_collect_hoist_vars(st[3], out)
        elif ty == "While":
            cg_collect_hoist_vars(st[2], out)
        i += 1
# ---------- 函数生成 ----------
def cg_gen_func(f):
    let cname = "fn_" + cg_func_cname(rust_unescape(f[1]))
    return cg_gen_func_named(f, cname)
def cg_gen_func_named(f, cname):
    var s = "static LXValue " + cname + "(LXValue* args, int nargs, void* ctx) {\n"
    s += "    (void)ctx;\n"
    # M72-S2（Issue 10 D1）：函数入口标记 .px 函数名（px_error 现场带函数上下文；
    # 与 cg_gen_stmt 每语句 px_srcline 配套 → "错误 [函数 行N]"）
    s += "    px_srcfunc(\"" + rust_unescape(f[1]) + "\");\n"
    let saved_vars = cg_dict_copy(cg_vars)
    let saved_types = cg_dict_copy(cg_var_types)
    let saved_cells = cg_dict_copy(cg_cells)
    let saved_imm = cg_dict_copy(cg_immutables)
    cg_vars = cg_new_dict()
    cg_var_types = cg_new_dict()
    cg_cells = cg_new_dict()
    cg_immutables = cg_dict_copy(saved_imm)
    # M129（缺陷 21）：**先**扫出本函数体内所有闭包的自由变量。凡"本帧局部名"命中者
    #   一律装箱成 cell（这一步必须在生成任何读/写之前定下来，否则先生成的读取点
    #   会按普通值生成，而声明变成 cell ⇒ C 类型错误）。
    let cap_free = []
    cg_scan_closure_caps(f[4], cap_free)
    # 参数绑定
    let params = f[2]
    var i = 0
    var param_decls = []
    while i < len(params):
        let p = params[i]
        let pname = rust_unescape(p[1])
        let v = cg_new_var(pname)
        if contains(cap_free, pname):
            cg_cells[pname] = 1
        var default_c = "px_null()"
        if p[3] != null:
            default_c = cg_gen_expr(p[3])
        param_decls.append([v, pname, "(nargs > " + str(i) + ") ? args[" + str(i) + "] : " + default_c])
        i += 1
    # 预扫描：函数体内需提升到函数顶的局部变量（Assign 目标 + VarDecl + For 循环变量，
    # Python 语义局部变量；顶层全局名除外）——M62-L5 块作用域对齐（解释器不新建块作用域）
    let hoist_names = []
    cg_collect_hoist_vars(f[4], hoist_names)
    var hoist_decls = []
    var ai = 0
    while ai < len(hoist_names):
        let name = hoist_names[ai]
        if cg_var_of(name) != null:
            ai += 1
            continue
        if contains(cg_globals, name):
            ai += 1
            continue
        let v = cg_new_var(name)
        if contains(cap_free, name):
            cg_cells[name] = 1
        hoist_decls.append([v, name])
        ai += 1
    # 声明区（参数 → 提升局部），cell 者包一层 px_cell
    var di = 0
    while di < len(param_decls):
        let d = param_decls[di]
        if cg_cells.has(d[1]):
            s += "    LXValue " + d[0] + " = px_cell(" + d[2] + ");\n"
        else:
            s += "    LXValue " + d[0] + " = " + d[2] + ";\n"
        di += 1
    di = 0
    while di < len(hoist_decls):
        let hd = hoist_decls[di]
        if cg_cells.has(hd[1]):
            s += "    LXValue " + hd[0] + " = px_cell(px_null());\n"
        else:
            s += "    LXValue " + hd[0] + " = px_null();\n"
        di += 1
    # M39：? 错误传播标签
    let err_tag = "px_err_" + str(cg_uid())
    cg_err_labels.append(err_tag)
    s += "    LXValue " + err_tag + "_val = px_null();\n"
    s += "    int " + err_tag + "_proped = 0;\n"
    # 函数体
    # M152（缺陷 141）：逐语句的字符串累加同样平方级（同一函数内 N 条语句 ⇒
    #   O(N × 函数体字数)）⇒ 语句块表 + 一次 join。
    let body = f[4]
    var bchunks = []
    var bi = 0
    while bi < len(body):
        bchunks.push(cg_gen_stmt(body[bi], 1))
        bi += 1
    s += join("", bchunks)
    s += err_tag + ":\n"
    s += "    if (" + err_tag + "_proped) return " + err_tag + "_val;\n"
    s += "    return px_null();\n"
    s += "}\n"
    cg_err_labels = cg_err_labels[0:len(cg_err_labels) - 1]
    cg_vars = saved_vars
    cg_var_types = saved_types
    cg_cells = saved_cells
    cg_immutables = saved_imm
    return s
# ---------- generate 主流程 ----------
def cg_generate(prog):
    var out = "/* 由普贤 (PuXian) 编译器自动生成 — px build */\n#include \"runtime.h\"\n#include <string.h>\n#include <stdio.h>\n\n"
    cg_closures = ""
    cg_structs = cg_new_dict()
    cg_enums = cg_new_dict()
    cg_impls = cg_new_dict()
    cg_vars = cg_new_dict()
    cg_var_types = cg_new_dict()
    cg_cells = cg_new_dict()
    cg_immutables = cg_new_dict()
    cg_nonnull = cg_new_dict()
    cg_ffi = cg_new_dict()
    cg_const_enums = cg_new_dict()
    cg_globals = []
    cg_err_labels = []
    cg_uidc = 0
    cg_closure_id = 0
    cg_seq_uid = 0
    cg_collect_types(prog)
    # 收集顶层全局名（函数 + 顶层变量赋值）
    let items = prog[1]
    var i = 0
    while i < len(items):
        let st = items[i]
        let ty = st[0]
        if ty == "FuncDef":
            cg_globals.append(rust_unescape(st[1]))
        elif ty == "ExternDef":
            # M42：extern def → FFI 声明表（name → params），调用生成 ffi_call 桥
            cg_ffi[rust_unescape(st[1])] = st[2]
        elif ty == "VarDecl":
            cg_globals.append(rust_unescape(st[2]))
            if st[1] == "Let" or st[1] == "Const":
                cg_immutables[rust_unescape(st[2])] = 1
        elif ty == "Assign":
            let tgt = st[1]
            if tgt[0] == "Var":
                cg_globals.append(rust_unescape(tgt[1]))
        i += 1
    # impl 方法列表（M-B6：按 "类型.方法" 字典序排序，确定性输出）
    let impl_list = []
    let tnames = cg_impls.keys()
    var ti = 0
    while ti < len(tnames):
        let type_name = tnames[ti]
        let methods = cg_impls[type_name]
        var mi = 0
        while mi < len(methods):
            impl_list.append([type_name, methods[mi]])
            mi += 1
        ti += 1
    # 插入排序（按 "类型.方法" 字典序，与 Rust sort_by 一致）
    var si = 1
    while si < len(impl_list):
        var j = si
        while j > 0:
            let ka = impl_list[j - 1][0] + "." + rust_unescape(impl_list[j - 1][1][1])
            let kb = impl_list[j][0] + "." + rust_unescape(impl_list[j][1][1])
            if kb < ka:
                let tmp2 = impl_list[j]
                impl_list[j] = impl_list[j - 1]
                impl_list[j - 1] = tmp2
            j -= 1
        si += 1
    # 生成 impl 方法函数（先于顶层函数，静态分派需要前置定义）
    # M152（第 34 轮 · 缺陷 141）：函数块先进**块表**，末尾一次 `join` 拼进 out ——
    #   旧版 `out += cg_gen_func_named(...)` 每次都整串重分配 + 整串拷贝（px_add），
    #   N 个函数 ⇒ O(N × 全文字数) 平方级；块表 push 摊还 O(1)。发射顺序/字节不变。
    var fn_chunks = []
    var ii = 0
    while ii < len(impl_list):
        let type_name = impl_list[ii][0]
        let m = impl_list[ii][1]
        let fname = "fn_" + cg_func_cname(type_name) + "_" + cg_func_cname(rust_unescape(m[1]))
        fn_chunks.push(cg_gen_func_named(m, fname))
        fn_chunks.push("\n")
        ii += 1
    # 生成顶层 def 函数
    var di = 0
    while di < len(items):
        let st = items[di]
        if st[0] == "FuncDef":
            fn_chunks.push(cg_gen_func(st))
            fn_chunks.push("\n")
        di += 1
    out += join("", fn_chunks)
    # main()
    out += "int main(int argc, char** argv) {\n"
    out += "    px_args_init(argc, argv);\n"
    out += "    px_register_builtins();\n"
    # 注册顶层函数
    var ri = 0
    while ri < len(items):
        let st = items[ri]
        if st[0] == "FuncDef":
            let fname = rust_unescape(st[1])
            let cname = "fn_" + cg_func_cname(fname)
            out += "    px_set_global(\"" + fname + "\", px_func(\"" + fname + "\", " + cname + ", NULL));\n"
        ri += 1
    # 注册 impl 方法为 "Type.method"
    var ii2 = 0
    while ii2 < len(impl_list):
        let type_name = impl_list[ii2][0]
        let m = impl_list[ii2][1]
        let mname = rust_unescape(m[1])
        let fname = "fn_" + cg_func_cname(type_name) + "_" + cg_func_cname(mname)
        out += "    px_set_global(\"" + type_name + "." + mname + "\", px_func(\"" + type_name + "." + mname + "\", " + fname + ", NULL));\n"
        ii2 += 1
    # 执行顶层语句（除定义/import 外）
    # M152（缺陷 141）：同上，块表 + 一次 join（顶层语句可能成百上千条）。
    var top_chunks = []
    var si2 = 0
    while si2 < len(items):
        let st = items[si2]
        let ty = st[0]
        if ty != "FuncDef" and ty != "StructDef" and ty != "EnumDef" and ty != "TraitDef" and ty != "ImplDef" and ty != "Import" and ty != "ExternDef":
            top_chunks.push(cg_gen_stmt(st, 1))
        si2 += 1
    out += join("", top_chunks)
    # 调用顶层 main()
    var has_main = false
    var mi3 = 0
    while mi3 < len(items):
        let st = items[mi3]
        if st[0] == "FuncDef" and rust_unescape(st[1]) == "main":
            has_main = true
            break
        mi3 += 1
    if has_main:
        let cname = "fn_main"
        out += "    { LXValue _r = " + cname + "(NULL, 0, NULL); int _code = 0;\n"
        out += "      if (px_is_result(_r)) {\n"
        out += "        if (!px_result_ok(_r)) {\n"
        out += "          fprintf(stderr, \"错误: %s\\n\", px_to_string(px_result_unwrap(_r)));\n"
        out += "          _code = 1;\n"
        out += "        } else {\n"
        out += "          LXValue _uv = px_result_unwrap(_r);\n"
        out += "          if (_uv.type == PX_INT) _code = (int)_uv.as.i;\n"
        out += "        }\n"
        out += "      } else if (_r.type == PX_INT) {\n"
        out += "        _code = (int)_r.as.i;\n"
        out += "      }\n"
        out += "      return px_exit_code_final(_code);   // M120（qg-issue 76 E1）\n"
        out += "    }\n"
    else:
        out += "    return px_exit_code_final(0);   // M120（qg-issue 76 E1）\n"
    out += "}\n"
    # 合并闭包定义（放在所有函数定义之前）
    let pos = cg_find(out, "int main(")
    if pos >= 0:
        let head = out[0:pos]
        let tail = out[pos:len(out)]
        let fpos = cg_find(head, "static LXValue")
        var final_out = ""
        if fpos >= 0:
            final_out = head[0:fpos] + cg_closures + "\n" + head[fpos:len(head)] + tail
        else:
            final_out = head + cg_closures + "\n" + tail
        return final_out
    return out
# ---------- 入口 ----------
def main():
    let f = args()[len(args()) - 1]
    let base_dir = cg_dirname(f)
    p_toks = lex_tokens(read_file(f))
    p_pos = 0
    p_brack = 0
    let ast = parse_program()
    let prog = cg_resolve_modules(ast, base_dir)
    var out = cg_generate(prog)
    # print 会追加一个换行：去掉末尾 \n 避免多一个空行（对齐 Rust 版写文件）
    let n = len(out)
    if n > 0 and out[n - 1] == "\n":
        out = out[0:n - 1]
    print(out)
