# ============================================================
# M-B7: i_err.px —— interp 错误构造与渲染（对齐 LxError）
# ------------------------------------------------------------
# 错误值表示（Result Err 载荷）：
#   真实错误 {"__err__": code, "msg": msg, "line": l, "col": c}
#   传播     {"__prop__": v}   （用户代码 ? 遇 Err/null 的传播值）
# 渲染对齐 LxError Display：错误 [code] line:col: msg
# ============================================================
# M407（缺陷 793/794/795）：三轨运行时错误报文**统一** —— 规范见 docs/ERROR_CODES.md §统一前缀：
#     运行时错误 [<fn> 行<N>]: <CODE>: <msg>
#   <fn> = 出错语句**所在**函数名（不是上一个被调函数）；顶层语句 = <top>
#   <N>  = 该语句在 .px 源中的行号；**不打列号**（编译两轨字节码无列信息，三轨须逐字节相等）
# 解释轨没有天然的「当前函数」概念 ⇒ 用 g_i_fn_stack 跟踪：icall.i_call_function 入口压、
#   exit 弹（wrapper 形式，保证 inner 的每条 return 路径都被覆盖）。i_err 在**构造时刻**
#   取栈顶写入 e["fn"]（错误对象随栈展开传播，事后查栈会拿到已弹掉的帧）。
var g_i_fn_stack = []
# M408（PX-002/PX-003）：用户语句的**当前行号**（i_exec_stmt 入口更新，只存 int —— 每条语句
#   都写一次 ⇒ 不在这里分配 list）。为什么需要：native 的 px_error 走 longjmp，跳过了所有
#   .px 层构造 Err 的时机 ⇒ 受保护调用（__guard_call）捕到错误时，位置只能从
#   「最后执行到的那条语句」拿。列号不进契约（编译两轨无列信息，见 M407 定稿）。
var g_i_cur_line = 0
def i_fn_push(name):
    g_i_fn_stack.append(name)
def i_fn_pop():
    if len(g_i_fn_stack) > 0:
        g_i_fn_stack.pop()
def i_cur_fn():
    let n = len(g_i_fn_stack)
    if n == 0:
        return "<top>"
    return g_i_fn_stack[n - 1]
# M407（缺陷 797）：语句源位置（parser 约定：语句末位是 pos [line, col]）；未知时退回 [0,0]
#   （M408 从 interp.px 移到这里：i_exec_stmt 与 i_run_program 都要用，单一真相。）
def i_stmt_pos(st):
    if len(st) > 0:
        let p = st[len(st) - 1]
        if type(p) == "list" and len(p) >= 2 and type(p[0]) == "int":
            return [p[0], p[1]]
    return [0, 0]
# M408：同上，但只取行号（语句热路径用 —— 不分配 list）
def i_stmt_line(st):
    if len(st) > 0:
        let p = st[len(st) - 1]
        if type(p) == "list" and len(p) >= 2 and type(p[0]) == "int":
            return p[0]
    return 0
def i_err(code, msg, pos):
    return {"__err__": code, "msg": msg, "line": pos[0], "col": pos[1], "fn": i_cur_fn()}
# M408：**无 R 码**的错误载体（库·环境族专用 —— docs/ERROR_CODES.md §1：域前缀族不带码，
#   如 "regex: 不支持的转义 \\p" / "zip 缺少 EOCD"）。`__err__` 置空串 = 渲染时不插码。
#   位置与函数名由**捕获点**给出（longjmp 已跳过了出错语句的 Err 构造时机）。
def i_rt_raw(msg, fname, line):
    return {"__err__": "", "msg": msg, "line": line, "col": 0, "fn": fname}
# 运行时错误前缀行（解释轨唯一出口，格式与 runtime.px_error 逐字节同形）
def i_err_rt(e):
    var fname = "<top>"
    if e.has("fn"):
        fname = e["fn"]
    if e["__err__"] == "":
        return "运行时错误 [" + fname + " 行" + str(e["line"]) + "]: " + e["msg"]
    return "运行时错误 [" + fname + " 行" + str(e["line"]) + "]: " + e["__err__"] + ": " + e["msg"]
def i_prop(v):
    return {"__prop__": v}
# ---- 常用错误构造（对齐 interp.rs LxError 辅助） ----
def i_r1001(name, pos):
    return i_err("R1001", "未定义变量: '" + name + "'", pos)
def i_r1002(msg, pos):
    return i_err("R1002", msg, pos)
def i_r1003(msg, pos):
    return i_err("R1003", msg, pos)
def i_r1004(msg, pos):
    return i_err("R1004", msg, pos)
def i_r1005(msg, pos):
    return i_err("R1005", msg, pos)
def i_r1006(msg, pos):
    return i_err("R1006", msg, pos)
def i_r1007(msg, pos):
    return i_err("R1007", msg, pos)
def i_r2001(msg, pos):
    return i_err("R2001", msg, pos)
def i_r1008(msg, pos):
    return i_err("R1008", msg, pos)
def i_r1011(msg, pos):
    return i_err("R1011", msg, pos)
# 错误渲染（对齐 LxError Display）
def i_err_display(e):
    return "错误 [" + e["__err__"] + "] " + str(e["line"]) + ":" + str(e["col"]) + ": " + e["msg"]
