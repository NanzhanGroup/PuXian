K 727 str "\", px_func(\""
K 728 str ", NULL));\n"
K 729 str "fn_main"
K 730 str "    { LXValue _r = "
K 731 str "(NULL, 0, NULL); int _code = 0;\n"
K 732 str "      if (px_is_result(_r)) {\n"
K 733 str "        if (!px_result_ok(_r)) {\n"
K 734 str "          fprintf(stderr, \"错误: %s\\n\", px_to_string(px_result_unwrap(_r)));\n"
K 735 str "          _code = 1;\n"
K 736 str "        } else {\n"
K 737 str "          LXValue _uv = px_result_unwrap(_r);\n"
K 738 str "          if (_uv.type == PX_INT) _code = (int)_uv.as.i;\n"
K 739 str "      } else if (_r.type == PX_INT) {\n"
K 740 str "        _code = (int)_r.as.i;\n"
K 741 str "      }\n"
K 742 str "      return _code;\n"
K 743 str "    return 0;\n"
