K 867 str "/* 由 bc_emit.px (M89-S3) 自动生成 — 字节码模块（VM 执行） */\n"
K 868 str "#include \"runtime.h\"\n#include \"vm.h\"\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n"
K 869 str "static const PxBCModule s_mod;\n\n"
K 870 str "static const PxK s_K[] = {\n"
K 871 str "    {PXK_INT, "
K 872 str ", 0, NULL},\n"
K 873 str "    {PXK_FLT, 0, "
K 874 str ", NULL},\n"
K 875 str "    {PXK_STR, 0, 0, \""
K 876 str "\"},\n"
K 877 str "1"
K 878 str "    {PXK_BOOL, "
K 879 str "    {PXK_FUNC, "
K 880 str "    {PXK_NULL, 0, 0, NULL},\n"
K 881 str "};\n\n"
K 882 str "static const char* s_N[] = {\n"
K 883 str "    \""
K 884 str "\",\n"
K 885 str "static const char* s_G[] = {\n"
K 886 str "static const char* s_st_"
K 887 str "[] = {\n"
K 888 str "static const PxStructDef s_structs[] = {\n"
K 889 str "    {\""
K 890 str "\", s_st_"
K 891 str "},\n"
K 892 str "static const PxInst s_bc_"
K 893 str "    {PXOP_"
K 894 str "static const PxVMFunc s_funcs[] = {\n"
K 895 str "    {.name=\""
K 896 str "\", .arity="
K 897 str ", .ndefault="
K 898 str ", .nslots="
K 899 str ", .bc=s_bc_"
K 900 str ", .nbc="
K 901 str ", .mod=&s_mod, .upvals=NULL},\n"
K 902 str "static const PxBCModule s_mod = {\n"
K 903 str "    .name=\"<module>\", .K=s_K, .nK="
K 904 str ", .N=s_N, .nN="
K 905 str "    .G=s_G, .nG="
K 906 str ", .funcs=s_funcs, .nfuncs="
K 907 str ", .top_idx="
K 908 str "    .structs=s_structs, .nstructs="
K 909 str "    LXValue _r = px_vm_run_module(px_vm_state(), &s_mod);\n"
K 910 str "    int _code = 0;\n"
K 911 str "    if (px_is_result(_r)) {\n"
K 912 str "            fprintf(stderr, \"错误: %s\\n\", px_to_string(px_result_unwrap(_r)));\n"
K 913 str "            _code = 1;\n"
K 914 str "            LXValue _uv = px_result_unwrap(_r);\n"
K 915 str "            if (_uv.type == PX_INT) _code = (int)_uv.as.i;\n"
K 916 str "    } else if (_r.type == PX_INT) {\n"
K 917 str "    if (getenv(\"PX_BC_DUMP\")) {\n"
K 918 str "        int _i;\n"
K 919 str "        for (_i = 0; _i < (int)s_mod.nG; _i++) {\n"
K 920 str "            LXValue _v = px_get_global(s_mod.G[_i]);\n"
K 921 str "            if (_v.type != PX_FUNC && _v.type != PX_NATIVE)\n"
K 922 str "                printf(\"%s=%s\\n\", s_mod.G[_i], px_to_string(_v));\n"
K 923 str "    return _code;\n"
