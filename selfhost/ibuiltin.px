            return Err(i_r1002("tcp_send_ex 需要 (fd, data)", pos))
        return Ok(tcp_send_ex(args[0], args[1]))
    # ═══ M150（第 32 轮）：摘要 / 密钥派生 + TLS 客户端族 ═══
    if name == "md5":
        # md5(data) → 32 字符小写 hex
        if len(args) != 1:
            return Err(i_r1002("md5 需要 (data)", pos))
        return Ok(md5(args[0]))
    if name == "md5_bytes":
        # md5_bytes(data) → 16 字节
        if len(args) != 1:
            return Err(i_r1002("md5_bytes 需要 (data)", pos))
        return Ok(md5_bytes(args[0]))
    if name == "pbkdf2_sha256":
        # pbkdf2_sha256(password, salt, iterations, dklen) → bytes
        if len(args) != 4:
            return Err(i_r1002("pbkdf2_sha256 需要 (password, salt, iterations, dklen)", pos))
        return Ok(pbkdf2_sha256(args[0], args[1], args[2], args[3]))
    if name == "tls_connect":
        # tls_connect(host, port[, opts]) → dict{ok,id,fd,peer,version,version_num,cipher,cipher_id,verify,stage,errno,err}
        if len(args) != 2 and len(args) != 3:
            return Err(i_r1002("tls_connect 需要 (host, port[, opts])", pos))
        if len(args) == 3:
            return Ok(tls_connect(args[0], args[1], args[2]))
        return Ok(tls_connect(args[0], args[1]))
    if name == "tls_send":
        # tls_send(id, data) → dict{ok,n,err}
        if len(args) != 2:
            return Err(i_r1002("tls_send 需要 (id, data)", pos))
        return Ok(tls_send(args[0], args[1]))
    if name == "tls_recv":
        # tls_recv(id, maxlen) → dict{ok,data,n,eof,timeout,err}
        if len(args) != 2:
            return Err(i_r1002("tls_recv 需要 (id, maxlen)", pos))
        return Ok(tls_recv(args[0], args[1]))
    if name == "tls_close":
        # tls_close(id) → bool（幂等）
        if len(args) != 1:
            return Err(i_r1002("tls_close 需要 (id)", pos))
        return Ok(tls_close(args[0]))
    if name == "tls_upgrade":
        # tls_upgrade(fd[, opts]) → dict{ok,id,fd,peer,version,version_num,cipher,cipher_id,verify,stage,errno,err}
        # M151-S1：在已连接 fd 上升级 TLS（PostgreSQL SSLRequest 协商必需）。
        #   成功 ⇒ 句柄表接管 fd；失败 ⇒ fd 仍归调用方。
        if len(args) != 1 and len(args) != 2:
            return Err(i_r1002("tls_upgrade 需要 (fd[, opts])", pos))
        if len(args) == 2:
            return Ok(tls_upgrade(args[0], args[1]))
        return Ok(tls_upgrade(args[0]))
    # ---- M156（第 38 轮）：零依赖 ONNX 解析面（原生 native 直转发；三轨同候选）----
    #   返回约定：onnx_model_open 成功给 dict、失败给 Err(result)；其余成功给值、失败给
    #   Err(result)（与 md5/tls_* 同族）。解释轨**只做参数个数预检**，语义全在 runtime。
    if name == "onnx_model_open":
        if len(args) != 1:
            return Err(i_r1002("onnx_model_open 需要 1 个参数 (path)", pos))
        return Ok(onnx_model_open(args[0]))
    if name == "onnx_info":
        if len(args) != 1:
            return Err(i_r1002("onnx_info 需要 1 个参数 (id)", pos))
        return Ok(onnx_info(args[0]))
    if name == "onnx_initializer":
        if len(args) != 2:
            return Err(i_r1002("onnx_initializer 需要 2 个参数 (id, name)", pos))
        return Ok(onnx_initializer(args[0], args[1]))
    if name == "onnx_initializer_names":
        if len(args) != 1:
            return Err(i_r1002("onnx_initializer_names 需要 1 个参数 (id)", pos))
        return Ok(onnx_initializer_names(args[0]))
    if name == "onnx_model_close":
        if len(args) != 1:
            return Err(i_r1002("onnx_model_close 需要 1 个参数 (id)", pos))
        return Ok(onnx_model_close(args[0]))
    # ---- M157（第 39 轮）：ONNX **执行面** + 张量字节助手（同样只做参数个数预检）----
    #   ⚠️ 缺陷 155 的教训：新 native 必须**同时**进 interp.px 名册（否则 R1001）与
    #   这里的分发（否则 R1002）—— 两件事，缺一不可。
    if name == "onnx_run":
        if len(args) != 2:
            return Err(i_r1002("onnx_run 需要 2 个参数 (id, feeds)", pos))
        return Ok(onnx_run(args[0], args[1]))
    if name == "onnx_op_names":
        if len(args) != 0:
            return Err(i_r1002("onnx_op_names 需要 0 个参数", pos))
        return Ok(onnx_op_names())
    if name == "f32_bytes":
        if len(args) != 1:
            return Err(i_r1002("f32_bytes 需要 1 个参数 (列表)", pos))
        return Ok(f32_bytes(args[0]))
    if name == "f32_at":
        if len(args) != 2:
            return Err(i_r1002("f32_at 需要 2 个参数 (bytes, i)", pos))
        return Ok(f32_at(args[0], args[1]))
    if name == "f32_count":
        if len(args) != 1:
            return Err(i_r1002("f32_count 需要 1 个参数 (bytes)", pos))
        return Ok(f32_count(args[0]))
    if name == "i64_bytes":
        if len(args) != 1:
            return Err(i_r1002("i64_bytes 需要 1 个参数 (列表)", pos))
        return Ok(i64_bytes(args[0]))
    if name == "i64_at":
        if len(args) != 2:
            return Err(i_r1002("i64_at 需要 2 个参数 (bytes, i)", pos))
        return Ok(i64_at(args[0], args[1]))
    if name == "i64_count":
        if len(args) != 1:
            return Err(i_r1002("i64_count 需要 1 个参数 (bytes)", pos))
        return Ok(i64_count(args[0]))
    return Err(i_r1002("未知内置函数: " + name, pos))
# ---- M59-S4 数学直调 helper（双模式对齐） ----
# 解释器参数错误返回 Err（不终止进程，区别于编译模式 px_error 终止）；
# 参数合法后直调同名 runtime C builtin（pxi 宿主已注册全部 M59 数学内置）。
def i_math_unary(cname, args, pos):
    if len(args) != 1:
        return Err(i_r1002(cname + " 需要 1 个参数", pos))
    let t = i_type_name(args[0])
    if t != "int" and t != "float":
        return Err(i_r1002(cname + " 参数必须是数字，实际是 " + t, pos))
    if cname == "sqrt":
        return Ok(sqrt(args[0]))
    if cname == "sin":
        return Ok(sin(args[0]))
    if cname == "cos":
        return Ok(cos(args[0]))
    if cname == "tan":
        return Ok(tan(args[0]))
    if cname == "floor":
        return Ok(floor(args[0]))
    if cname == "ceil":
        return Ok(ceil(args[0]))
    if cname == "round":
        return Ok(round(args[0]))
    if cname == "log":
        return Ok(log(args[0]))
    if cname == "log10":
        return Ok(log10(args[0]))
    return Ok(exp(args[0]))
def i_math_atan2(args, pos):
    if len(args) != 2:
        return Err(i_r1002("atan2 需要 2 个参数（先 y 后 x）", pos))
    var i = 0
    while i < 2:
        let t = i_type_name(args[i])
        if t != "int" and t != "float":
            return Err(i_r1002("atan2 参数必须是数字，实际是 " + t, pos))
        i += 1
    return Ok(atan2(args[0], args[1]))
def i_math_random(args, pos):
    if len(args) != 0:
        return Err(i_r1002("random 不需要参数", pos))
    return Ok(random())
def i_math_random_int(args, pos):
    if len(args) != 1:
        return Err(i_r1002("random_int 需要 1 个参数 n（正整数）", pos))
    if i_type_name(args[0]) != "int":
        return Err(i_r1002("random_int 的 n 需要 int", pos))
    if args[0] <= 0:
        return Err(i_r1002("random_int 的 n 必须 > 0，实际是 " + i_to_str(args[0]), pos))
    return Ok(random_int(args[0]))
def i_math_random_seed(args, pos):
    if len(args) != 1:
        return Err(i_r1002("random_seed 需要 1 个整数参数（种子）", pos))
    if i_type_name(args[0]) != "int":
        return Err(i_r1002("random_seed 的种子需要 int", pos))
    random_seed(args[0])
    return Ok(null)
# M42：FFI 调用（extern def 走 C 桥）
# args: [name(str), fn_args(list)] → ffi_call(name, args_list) → runtime 注册的 C 绑定
# 双模式统一：编译模式 codegen 生成 px_call(px_get_global("ffi_call"), ...)，
# 解释模式经此函数转发到同一 C 桥（pxi 已链 runtime_ffi.c）。
def i_builtin_ffi_call(args, pos):
    if len(args) != 2:
        return Err(i_r1002("ffi_call 需要 (name, args_list) 参数", pos))
    if type(args[0]) != "string":
        return Err(i_r1002("ffi_call 的 name 需要字符串", pos))
    if type(args[1]) != "list":
        return Err(i_r1002("ffi_call 的 args 需要列表", pos))
    return Ok(ffi_call(args[0], args[1]))
# ---------- len（对齐 builtin.rs Len） ----------
def i_builtin_len(args, pos):
    if len(args) != 1:
        return Err(i_r1002("len 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t == "string":
        return Ok(len(args[0]))
    if t == "list" or t == "tuple":
        return Ok(len(args[0]))
    if t == "dict":
        return Ok(len(args[0].keys()))
    if t == "generator":
        return Ok(len(args[0]["__gen__"]))
    if t == "bytes":
        return Ok(len(args[0]))
    if t == "range":
        return Ok(len(list(args[0])))
    return Err(i_r1002("len 不支持类型 " + t, pos))
# ---------- int（对齐 builtin.rs Int） ----------
def i_builtin_int(args, pos):
    if len(args) != 1:
        return Err(i_r1002("int 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t == "int":
        return Ok(args[0])
    if t == "float":
        return Ok(int(args[0]))
    if t == "bool":
        if args[0]:
            return Ok(1)
        return Ok(0)
    if t == "string":
        let s = args[0].trim()
        if s == "":
            return Err(i_r1002("无法将 '" + args[0] + "' 转为 int", pos))
        let n = int(s)
        return Ok(n)
    return Err(i_r1002("int 不支持此类型", pos))
# ---------- float（对齐 builtin.rs Float） ----------
def i_builtin_float(args, pos):
    if len(args) != 1:
        return Err(i_r1002("float 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t == "int":
        return Ok(float(args[0]))
    if t == "float":
        return Ok(args[0])
    if t == "string":
        let s = args[0].trim()
        let f = float(s)
        return Ok(f)
    return Err(i_r1002("float 不支持此类型", pos))
# ---------- range（对齐 builtin.rs Range） ----------
def i_builtin_range(args, pos):
    var start = 0
    var end = 0
    var step = 1
    if len(args) == 1:
        end = args[0]
    elif len(args) == 2:
        start = args[0]
        end = args[1]
    elif len(args) == 3:
        start = args[0]
        end = args[1]
        step = args[2]
    else:
        return Err(i_r1002("range 需要 1-3 个参数", pos))
    if type(start) != "int" or type(end) != "int" or type(step) != "int":
        return Err(i_r1002("期望整数，实际是 " + i_type_name(args[0]), pos))
    if step == 0:
        return Err(i_r1006("range step 不能为 0", pos))
    return Ok(range(start, end, step))
# ---------- sorted（对齐 builtin.rs Sorted：按 to_string 排序） ----------
def i_builtin_sorted(args, pos):
    if len(args) != 1:
        return Err(i_r1002("sorted 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t != "list" and t != "tuple":
        return Err(i_r1002("sorted 参数需要 list/tuple", pos))
    let items = []
    var i = 0
    while i < len(args[0]):
        items.append(args[0][i])
        i += 1
    let n = len(items)
    var ii = 0
    while ii < n:
        var j = 0
        while j < n - 1 - ii:
            if i_to_str(items[j]) > i_to_str(items[j + 1]):
                let tmp = items[j]
                items[j] = items[j + 1]
                items[j + 1] = tmp
            j += 1
        ii += 1
    return Ok(items)
# ---------- reversed（对齐 builtin.rs Reversed） ----------
def i_builtin_reversed(args, pos):
    if len(args) != 1:
        return Err(i_r1002("reversed 需要一个参数", pos))
    let t = i_type_name(args[0])
    let items = []
    if t == "list" or t == "tuple":
        var i = 0
        while i < len(args[0]):
            items.append(args[0][i])
            i += 1
    elif t == "string":
        var i = 0
        while i < len(args[0]):
            items.append(args[0][i])
            i += 1
    else:
        return Err(i_r1002("reversed 参数类型不支持", pos))
    let n = len(items)
    let out = []
    var i = n - 1
    while i >= 0:
        out.append(items[i])
        i -= 1
    return Ok(out)
# ---------- sum（对齐 builtin.rs Sum：从 0 累加） ----------
def i_builtin_sum(args, pos):
    if len(args) != 1:
        return Err(i_r1002("sum 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t != "list" and t != "tuple":
        return Err(i_r1002("sum 参数需要 list/tuple", pos))
    var acc = 0
    var i = 0
    while i < len(args[0]):
        let r = i_bin_add(acc, args[0][i], pos)
        if r.is_err():
            return Err(r.err())
        acc = r.unwrap()
        i += 1
    return Ok(acc)
# ---------- map（对齐 builtin Map：f(x) 收集） ----------
def i_builtin_map(args, pos):
    if len(args) != 2:
        return Err(i_r1002("map 需要 (列表, 函数) 两个参数", pos))
    let out = []
    var i = 0
    while i < len(args[0]):
        let r = i_call_value(args[1], [args[0][i]], pos)
        if r.is_err():
            return Err(r.err())
        out.append(r.unwrap())
        i += 1
    return Ok(out)
# ---------- filter（对齐 builtin Filter：f(x) 真值保留） ----------
def i_builtin_filter(args, pos):
    if len(args) != 2:
        return Err(i_r1002("filter 需要 (列表, 函数) 两个参数", pos))
    let out = []
    var i = 0
    while i < len(args[0]):
        let r = i_call_value(args[1], [args[0][i]], pos)
        if r.is_err():
            return Err(r.err())
        if i_truthy(r.unwrap()):
            out.append(args[0][i])
        i += 1
    return Ok(out)
# ---------- reduce（对齐 builtin Reduce：二元折叠） ----------
def i_builtin_reduce(args, pos):
    if len(args) < 2 or len(args) > 3:
        return Err(i_r1002("reduce 需要 (列表, 函数, [初始值])", pos))
    let lst = args[0]
    if len(lst) == 0:
        return Ok(null)
    var acc = 0
    if len(args) >= 3:
        acc = args[2]
    var i = 0
    while i < len(lst):
        let r = i_call_value(args[1], [acc, lst[i]], pos)
        if r.is_err():
            return Err(r.err())
        acc = r.unwrap()
        i += 1
    return Ok(acc)
