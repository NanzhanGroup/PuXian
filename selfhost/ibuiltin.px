            return Err(i_r1002("i64_at 需要 2 个参数 (bytes, i)", pos))
        return Ok(i64_at(args[0], args[1]))
    if name == "i64_count":
        if len(args) != 1:
            return Err(i_r1002("i64_count 需要 1 个参数 (bytes)", pos))
        return Ok(i64_count(args[0]))
    return Err(i_r1002("未知内置函数: " + name, pos))
# ---- M59-S4 数学直调 helper（双模式对齐） ----
# 解释器参数错误返回 Err（不终止进程，区别于编译模式 px_error 终止）；
# 参数合法后直调同名 runtime C builtin（pxi 宿主已注册全部 M59 数学内置）。
def i_math_arity_msg(cname):
    # M197（缺陷 233）：原生侧这几条 arity 文案**带说明**（弧度 / 自然对数），
    #   解释轨修前统一写 `X 需要 1 个参数` ⇒ 0 参调用时**三轨两文**。
    if cname == "sin" or cname == "cos" or cname == "tan":
        return cname + " 需要 1 个参数（弧度）"
    if cname == "log":
        return "log 需要 1 个参数（自然对数 ln）"
    if cname == "sqrt":
        return "sqrt 需要一个参数"
    return cname + " 需要 1 个参数"
def i_math_unary(cname, args, pos):
    if len(args) != 1:
        return Err(i_r1002(i_math_arity_msg(cname), pos))
    let t = i_type_name(args[0])
    if t != "int" and t != "float":
        return Err(i_r1002(cname + " 参数必须是数字，实际是 " + t, pos))
    if cname == "sqrt":
        return Ok(sqrt(args[0]))
    if cname == "sin":
        return Ok(sin(args[0]))
    if cname == "cos":
        return Ok(cos(args[0]))
    if cname == "tan":
        return Ok(tan(args[0]))
    if cname == "floor":
        return Ok(floor(args[0]))
    if cname == "ceil":
        return Ok(ceil(args[0]))
    if cname == "round":
        return Ok(round(args[0]))
    if cname == "log":
        return Ok(log(args[0]))
    if cname == "log10":
        return Ok(log10(args[0]))
    return Ok(exp(args[0]))
def i_math_atan2(args, pos):
    if len(args) != 2:
        return Err(i_r1002("atan2 需要 2 个参数（先 y 后 x）", pos))
    var i = 0
    while i < 2:
        let t = i_type_name(args[i])
        if t != "int" and t != "float":
            return Err(i_r1002("atan2 参数必须是数字，实际是 " + t, pos))
        i += 1
    return Ok(atan2(args[0], args[1]))
def i_math_random(args, pos):
    if len(args) != 0:
        return Err(i_r1002("random 不需要参数", pos))
    return Ok(random())
def i_math_random_int(args, pos):
    if len(args) != 1:
        return Err(i_r1002("random_int 需要 1 个参数 n（正整数）", pos))
    if i_type_name(args[0]) != "int":
        return Err(i_r1002("random_int 的 n 需要 int", pos))
    if args[0] <= 0:
        return Err(i_r1002("random_int 的 n 必须 > 0，实际是 " + i_to_str(args[0]), pos))
    return Ok(random_int(args[0]))
def i_math_random_seed(args, pos):
    if len(args) != 1:
        return Err(i_r1002("random_seed 需要 1 个整数参数（种子）", pos))
    if i_type_name(args[0]) != "int":
        return Err(i_r1002("random_seed 需要 1 个整数参数（种子）", pos))
    random_seed(args[0])
    return Ok(null)
# M42：FFI 调用（extern def 走 C 桥）
# args: [name(str), fn_args(list)] → ffi_call(name, args_list) → runtime 注册的 C 绑定
# 双模式统一：编译模式 codegen 生成 px_call(px_get_global("ffi_call"), ...)，
# 解释模式经此函数转发到同一 C 桥（pxi 已链 runtime_ffi.c）。
def i_builtin_ffi_call(args, pos):
    if len(args) != 2:
        return Err(i_r1002("ffi_call 需要 (name, args_list) 参数", pos))
    if type(args[0]) != "string":
        return Err(i_r1002("ffi_call 的 name 需要字符串", pos))
    if type(args[1]) != "list":
        return Err(i_r1002("ffi_call 的 args 需要列表", pos))
    return Ok(ffi_call(args[0], args[1]))
# ---------- len（对齐 builtin.rs Len） ----------
def i_builtin_len(args, pos):
    if len(args) != 1:
        return Err(i_r1002("len 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t == "string":
        return Ok(len(args[0]))
    if t == "list" or t == "tuple":
        return Ok(len(args[0]))
    if t == "dict":
        return Ok(len(args[0].keys()))
    if t == "generator":
        return Ok(len(args[0]["__gen__"]))
    if t == "bytes":
        return Ok(len(args[0]))
    if t == "range":
        return Ok(len(list(args[0])))
    return Err(i_r1002("len 不支持类型 " + t, pos))
# ---------- int（对齐 builtin.rs Int） ----------
# ---------- M184（第三方 PX-DEF-002）：字符串→数值的**严格**校验 ----------
#   runtime 侧已从 atoll/atof（宽容前缀解析：`int("12ab")`=12、`int("abc")`=0、
#   `float("1.2.3")`=1.2）改为**整体合法才接受**。解释轨这里做一次**同口径前置校验**，
#   目的是让报错带 `行:列`（解释轨风格）；**错误码与词条与编译轨逐字一致**
#   （`R1002 无法将 '<原文>' 转为 int/float`）。两边语义一致性由门
#   `examples/m184_num_strict/` 的「三轨对拍矩阵」（含边界与拒绝面）守住。
#   ⚠️ 空白集以 `trim()` 为准（space/\t/\n/\r 四种），与 runtime `px_num_span` 逐字符相等。
#   ⚠️ 正则里一律用字符类 `[.]` 而非 `\.`（少一层反斜杠转义，少一类口径漂移）。
# M185（缺陷 204）：**删掉本文件里 `i_str_is_int_literal` / `i_str_is_float_literal`
#   这两个与原生谓词「同规则的第二份实现」**。
#   它们是 M184 严格化之前的存在物：原生 `px_str_to_i64`/`px_str_to_f64` 负责**转换**，
#   解释轨为了报错带 `行:列` 又用 PuXian（+正则）把**同一条规则**写了一遍。
#   两处实现同一规则 = 结构性分叉隐患（M184 想根除的正是这类"两个地方各写一份解析"），
#   实测两者当时的接受集**恰好**一致（未爆），但只要任一侧动一下就分叉。
#   现在统一走原生判定器 `is_int_str`/`is_float_str`（判定与转换同源）
#   ⇒ `is_int_str(s) ⇔ int(s) 成功` 这条等式由**构造**保证，不再靠"两边都写对"。
def i_builtin_int(args, pos):
    if len(args) != 1:
        return Err(i_r1002("int 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t == "int":
        return Ok(args[0])
    if t == "float":
        return Ok(int(args[0]))
    if t == "bool":
        if args[0]:
            return Ok(1)
        return Ok(0)
    if t == "string":
        let s = args[0].trim()
        if not is_int_str(s):  # M185：与 int() 同一谓词（原生）
            return Err(i_r1002("无法将 '" + args[0] + "' 转为 int", pos))
        return Ok(int(s))
    return Err(i_r1002("int 不支持类型 " + i_type_name(args[0]), pos))
# ---------- float（对齐 builtin.rs Float） ----------
def i_builtin_float(args, pos):
    if len(args) != 1:
        return Err(i_r1002("float 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t == "int":
        return Ok(float(args[0]))
    if t == "float":
        return Ok(args[0])
    if t == "string":
        let s = args[0].trim()
        if not is_float_str(s):  # M185：与 float() 同一谓词（原生）
            return Err(i_r1002("无法将 '" + args[0] + "' 转为 float", pos))
        return Ok(float(s))
    return Err(i_r1002("float 不支持类型 " + i_type_name(args[0]), pos))
# ---------- range（对齐 builtin.rs Range） ----------
def i_builtin_range(args, pos):
    var start = 0
    var end = 0
    var step = 1
    if len(args) == 1:
        end = args[0]
    elif len(args) == 2:
        start = args[0]
        end = args[1]
    elif len(args) == 3:
        start = args[0]
        end = args[1]
        step = args[2]
    else:
        return Err(i_r1002("range 需要 1-3 个参数", pos))
    # M195（第 73 轮 · 缺陷 226）：修前**报错参数错位** —— `range(0, 1.5)` 报的是
    #   「期望整数，实际是 int」（取的是 args[0] 的类型，而错的其实是 end）⇒ 用户按消息
    #   去改第一个参数，改了也没用。且文案与 native 不一致（native 侧是
    #   `range 的 end 需要整数，实际是 float`）⇒ **同码不同文**。现在两侧同码同文，
    #   且点名**出错的那个参数**。
    if type(start) != "int":
        return Err(i_r1002("range 的 start 需要整数，实际是 " + i_type_name(start), pos))
    if type(end) != "int":
        return Err(i_r1002("range 的 end 需要整数，实际是 " + i_type_name(end), pos))
    if type(step) != "int":
        return Err(i_r1002("range 的 step 需要整数，实际是 " + i_type_name(step), pos))
    if step == 0:
        return Err(i_r1006("range step 不能为 0", pos))
    return Ok(range(start, end, step))
# ---------- sorted（对齐 builtin.rs Sorted：按 to_string 排序） ----------
def i_builtin_sorted(args, pos):
    if len(args) != 1:
        return Err(i_r1002("sorted 需要 1 个参数", pos))
    let t = i_type_name(args[0])
    # M178：可迭代实参统一（list/tuple/生成器/字符串）—— 文案与编译轨同形
    if t != "list" and t != "tuple" and t != "generator" and t != "string":
        return Err(i_r1002("sorted 参数需要 list/tuple/生成器/字符串，实际是 " + t, pos))
    let srcs = i_seq_of(args[0])
    let items = []
    var i = 0
    while i < len(srcs):
        items.append(srcs[i])
        i += 1
    let n = len(items)
    # M162（第 48 轮 · 缺陷 166/167）：**值比较** + **稳定**
    #   旧实现用 `i_to_str` 渲染串比较 ⇒ 与编译轨（runtime `compare_values`）不一致：
    #     `sorted([10, 9, 2])` 解释轨 [10, 2, 9] / 编译轨 [2, 9, 10]；
    #     `sorted([[1,"a"],[1,"a2"]])` 解释轨 [[1,a2],[1,a]] / 编译轨 [[1,a],[1,a2]]
    #     （后者 = 第三方 registry-px 登记的 PX-DEF-011）
    #   改用 `i_cmp_values`（对齐 compare_values 三态）；交换条件 `> 0`
    #   （等值不换 ⇒ **稳定**，与编译轨新算法同为稳定排序 ⇒ 同比较器下输出唯一）。
    var ii = 0
    while ii < n:
        var j = 0
        while j < n - 1 - ii:
            if i_cmp_values(items[j], items[j + 1]) > 0:
                let tmp = items[j]
                items[j] = items[j + 1]
                items[j + 1] = tmp
            j += 1
        ii += 1
    return Ok(items)
# ---------- reversed（对齐 builtin.rs Reversed） ----------
def i_builtin_reversed(args, pos):
    if len(args) != 1:
        return Err(i_r1002("reversed 需要一个参数", pos))
    let t = i_type_name(args[0])
    let items = []
    if t == "list" or t == "tuple" or t == "generator":
        let srcr = i_seq_of(args[0])
        var i = 0
        while i < len(srcr):
            items.append(srcr[i])
            i += 1
    elif t == "string":
        # M178：**字符串入参 → 字符串出参**（与编译轨同形）。
        #   修前解释轨把 rune 收进 list 返回 ⇒ 三轨分叉（`reversed("abc")`：
        #   解释轨 `[c, b, a]` / 编译轨 `cba`）。编译轨另有「按字节反转」缺陷
        #   （`reversed("中文")` 产出**非法 UTF-8**，实测 `\xad\x87...`），同批改 **rune 级**。
        var si = len(args[0]) - 1
        var s = ""
        while si >= 0:
            s = s + args[0][si]
            si -= 1
        return Ok(s)
    else:
        return Err(i_r1002("reversed 参数需要 list/tuple/生成器/字符串，实际是 " + t, pos))
    let n = len(items)
    let out = []
    var i = n - 1
    while i >= 0:
        out.append(items[i])
        i -= 1
    return Ok(out)
# ---------- sum（对齐 builtin.rs Sum：从 0 累加） ----------
# ---------- M177：可迭代实参规范化（解释轨侧） ----------
# 解释轨里「生成器」是 dict{"__gen__": [...]}（不是运行期的 PX_GEN）⇒ 一旦把它交给
# **runtime 原生** `list()`，会被当成 dict 迭代出**键**（实测 `sum((x for x in [1,2,3]))`
# 报 `+ 不支持: int + string` —— 因为拿到的是字符串键名）。
#   故在解释轨内部一律经本函数取「序列」：生成器看 __gen__，其余按 len/下标通用迭代。
def i_seq_of(v):
    let t = i_type_name(v)
    if t == "generator":
        return v["__gen__"]
    if t == "list":
        return v
    var out = []
    var si = 0
    while si < len(v):
        out.append(v[si])
        si += 1
    return out
def i_builtin_sum(args, pos):
    if len(args) != 1:
        return Err(i_r1002("sum 需要 1 个参数", pos))
    let t = i_type_name(args[0])
    # M177：生成器也收（物化）—— 与编译轨统一为「一条迭代语义」
    if t != "list" and t != "tuple" and t != "generator":
        return Err(i_r1002("sum 参数需要 list/tuple/生成器，实际是 " + t, pos))
    let items = i_seq_of(args[0])
    var acc = 0
    var i = 0
    while i < len(items):
        let r = i_bin_add(acc, items[i], pos)
        if r.is_err():
            return Err(r.err())
        acc = r.unwrap()
        i += 1
    return Ok(acc)
# ---------- map（对齐 builtin Map：f(x) 收集） ----------
def i_builtin_map(args, pos):
    if len(args) != 2:
        return Err(i_r1002("map 需要 (list, fn)", pos))
    let out = []
    var i = 0
    while i < len(args[0]):
        let r = i_call_value(args[1], [args[0][i]], pos)
        if r.is_err():
            return Err(r.err())
        out.append(r.unwrap())
        i += 1
    return Ok(out)
# ---------- filter（对齐 builtin Filter：f(x) 真值保留） ----------
def i_builtin_filter(args, pos):
    if len(args) != 2:
        return Err(i_r1002("filter 需要 (list, fn)", pos))
    let out = []
    var i = 0
    while i < len(args[0]):
        let r = i_call_value(args[1], [args[0][i]], pos)
        if r.is_err():
            return Err(r.err())
        if i_truthy(r.unwrap()):
            out.append(args[0][i])
        i += 1
    return Ok(out)
# ---------- reduce（对齐 builtin Reduce：二元折叠） ----------
def i_builtin_reduce(args, pos):
    if len(args) < 2 or len(args) > 3:
        return Err(i_r1002("reduce 需要 (list, fn, [init])", pos))
    let lst = args[0]
    if len(lst) == 0:
        return Ok(null)
    var acc = 0
    if len(args) >= 3:
        acc = args[2]
    var i = 0
    while i < len(lst):
        let r = i_call_value(args[1], [acc, lst[i]], pos)
        if r.is_err():
            return Err(r.err())
        acc = r.unwrap()
        i += 1
    return Ok(acc)
