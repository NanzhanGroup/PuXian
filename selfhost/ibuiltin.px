        #   键：size/mtime/mtime_ns/is_dir/mode（对齐 Go FileInfo 的常用面）
        if len(args) != 1:
            return Err(i_r1002("file_stat 需要一个路径参数", pos))
        return Ok(file_stat(args[0]))
    if name == "go_errno_string":
        # go_errno_string(errno) → str（M133：**Go** syscall.Errno.Error() 的文案；
        #   对齐 Go *PathError.Error() 的文案段。不用 libc strerror —— 大小写/实现均不同）
        if len(args) != 1:
            return Err(i_r1002("go_errno_string 需要 (errno)", pos))
        return Ok(go_errno_string(args[0]))
    if name == "tty_config":
        # tty_config(fd, baud, raw) → bool（串口 termios 波特率/raw）
        if len(args) != 3:
            return Err(i_r1002("tty_config 需要 (fd, baud, raw)", pos))
        return Ok(tty_config(args[0], args[1], args[2]))
    if name == "fd_wait":
        # fd_wait(fds, timeout_ms) → list<就绪 fd>（空=超时）| int -1（poll 错误）
        if len(args) != 2:
            return Err(i_r1002("fd_wait 需要 (fds, timeout_ms)", pos))
        return Ok(fd_wait(args[0], args[1]))
    if name == "tcp_connect_ex":
        # tcp_connect_ex(host, port[, opts]) → dict{ok,fd,addr,stage,errno,err}
        #   （M149：带超时 + 失败不杀进程；opts={"timeout_ms":int,"nodelay":bool}）
        if len(args) != 2 and len(args) != 3:
            return Err(i_r1002("tcp_connect_ex 需要 (host, port[, opts])", pos))
        if len(args) == 3:
            return Ok(tcp_connect_ex(args[0], args[1], args[2]))
        return Ok(tcp_connect_ex(args[0], args[1]))
    if name == "tcp_opt":
        # tcp_opt(fd, opts) → dict{ok,nodelay,keepalive,read_timeout_ms,write_timeout_ms,errno,err}
        #   （改完回读生效值 ⇒ 超时配置可编程验证）
        if len(args) != 2:
            return Err(i_r1002("tcp_opt 需要 (fd, opts)", pos))
        return Ok(tcp_opt(args[0], args[1]))
    if name == "tcp_recv_ex":
        # tcp_recv_ex(fd, maxlen) → dict{ok,data,n,eof,timeout,errno,err}
        #   （**EOF / 超时 / 出错可分辨** —— 旧 tcp_recv 三者都返回 ""）
        if len(args) != 2:
            return Err(i_r1002("tcp_recv_ex 需要 (fd, maxlen)", pos))
        return Ok(tcp_recv_ex(args[0], args[1]))
    if name == "tcp_send_ex":
        # tcp_send_ex(fd, data) → dict{ok,n,timeout,errno,err}（失败时 n=已写出字节数）
