# ============================================================
# M-B7: ibuiltin.px —— interp 内置函数分发（对齐 builtin.rs Mini 子集部分）
# ------------------------------------------------------------
# 内置函数值表示为 {"__builtin__": name}，eval Call 节点检测到后调
# i_call_builtin 分发。
# 策略：
#   1. 值感知类（参数可能含包装值 / 需 i_ 语义）→ 本文件内实现
#   2. 直接转发类（参数为原生值，行为已双模式对齐）→ Ok(同名内置调用)
#   3. 可失败类（read_file/int 转换等）→ 预检查返回 Err（对齐 Rust 错误消息）
# ============================================================
# ---------- 主分发 ----------
# ---- M63-L8: 网络类 C builtin 统一 Ok 包裹 helper ----
# 解释器 builtin 返回约定：Ok(实际返回值) 给 icall 自动 unwrap；Err 用于传播。
# C 网络函数成功返回普通值（str/dict/bool/...）、失败返回 Err("net: ...") result
# （px_net_err，M57 语义不杀进程）。一律 Ok(v)：unwrap 后成功=普通值、失败=Err result
# 交用户 .is_err()/`?` 处理（与 http_get 既有分支、编译模式行为一致）。
def i_call_c_net(v):
    return Ok(v)
def i_call_builtin(name, args, pos):
    # ---- 值感知类 ----
    if name == "print":
        let parts = []
        var i = 0
        while i < len(args):
            parts.append(i_to_str(args[i]))
            i += 1
        print(join(" ", parts))
        return Ok(null)
    if name == "flush":
        # M72-S1（Issue 9）：flush() —— 显式刷 stdout/stderr（宿主 runtime native）
        if len(args) != 0:
            return Err(i_r1002("flush 不接受参数", pos))
        flush()
        return Ok(null)
    if name == "print_err":
        # M72-S1（Issue 9/10）：print_err(...) —— 渲染对齐 print，输出到 stderr
        let parts = []
        var i = 0
        while i < len(args):
            parts.append(i_to_str(args[i]))
            i += 1
        print_err(join(" ", parts))
        return Ok(null)
    if name == "str":
        if len(args) != 1:
            return Err(i_r1002("str 需要一个参数", pos))
        return Ok(i_to_str(args[0]))
    if name == "type":
        if len(args) != 1:
            return Err(i_r1002("type 需要一个参数", pos))
        return Ok(i_type_name(args[0]))
    # M145：对象同一性（环检测 / 指针语义移植用；非堆值 0）
    if name == "object_id":
        if len(args) != 1:
            return Err(i_r1002("object_id 需要一个参数", pos))
        return Ok(object_id(args[0]))
    if name == "bool":
        if len(args) != 1:
            return Err(i_r1002("bool 需要一个参数", pos))
        return Ok(i_truthy(args[0]))
    if name == "len":
        return i_builtin_len(args, pos)
    if name == "int":
        return i_builtin_int(args, pos)
    if name == "float":
        return i_builtin_float(args, pos)
    # M185（第 63 轮）：严格解析判定器（第三方 PX-DEF-002 的配套）——
    #   判据与 int()/float() **同一谓词**（转发宿主 native，同一份 px_str_to_i64/f64），
    #   非 string ⇒ false（不报错；与编译轨同文同语义）。
    if name == "is_int_str" or name == "is_float_str":
        if len(args) != 1:
            return Err(i_r1002(name + " 需要一个参数", pos))
        if i_type_name(args[0]) != "string":
            return Ok(false)
        if name == "is_int_str":
            return Ok(is_int_str(args[0]))
        return Ok(is_float_str(args[0]))
    if name == "range":
        return i_builtin_range(args, pos)
    if name == "sorted":
        return i_builtin_sorted(args, pos)
    if name == "reversed":
        return i_builtin_reversed(args, pos)
    if name == "sum":
        return i_builtin_sum(args, pos)
    if name == "abs":
        if len(args) != 1:
            return Err(i_r1002("abs 需要一个参数", pos))
        let t = i_type_name(args[0])
        if t == "int":
            if args[0] < 0:
                return Ok(-args[0])
            return Ok(args[0])
        if t == "float":
            if args[0] < 0.0:
                return Ok(-args[0])
            return Ok(args[0])
        return Err(i_r1002("abs 不支持类型 " + i_type_name(args[0]), pos))
    if name == "min" or name == "max":
        # M177：与编译轨统一 —— ① nargs ≥ 1；② **单参数可迭代** ⇒ 取元素最值
        #   （修前解释轨只收 2 个参数 ⇒ `min([3,1,2])` 直接报错，而编译轨返回**原列表**，
        #    两轨一个报错一个静默给错值）
        if len(args) < 1:
            return Err(i_r1002(name + " 需要至少 1 个参数", pos))
        let want_gt = name == "max"
        if len(args) == 1:
            let t0 = i_type_name(args[0])
            if t0 == "list" or t0 == "tuple" or t0 == "generator" or t0 == "string":
                let items0 = i_seq_of(args[0])
                if len(items0) == 0:
                    return Err(i_r1002(name + " 需要至少一个元素", pos))
                var best0 = items0[0]
                var bi0 = 1
                while bi0 < len(items0):
                    # M179：全序值比较器（与编译轨 compare_values 同源；跨型按类型名定序）
                    let c0 = i_cmp_values(items0[bi0], best0)
                    if want_gt:
                        if c0 > 0:
                            best0 = items0[bi0]
                    else:
                        if c0 < 0:
                            best0 = items0[bi0]
                    bi0 += 1
                return Ok(best0)
            return Ok(args[0])
        var best = args[0]
        var mi = 1
        while mi < len(args):
            # M179：同上 —— 全序值比较器
            let c = i_cmp_values(args[mi], best)
            if want_gt:
                if c > 0:
                    best = args[mi]
            else:
                if c < 0:
                    best = args[mi]
            mi += 1
        return Ok(best)
    if name == "pow":
        if len(args) != 2:
            return Err(i_r1002("pow 需要 2 个参数", pos))
        let p0 = i_type_name(args[0])
        let p1 = i_type_name(args[1])
        if (p0 != "int" and p0 != "float"):
            return Err(i_r1002("pow 参数必须是数字，实际是 " + p0, pos))
        if (p1 != "int" and p1 != "float"):
            return Err(i_r1002("pow 参数必须是数字，实际是 " + p1, pos))
        let r = i_eval_binary("Pow", args[0], args[1], pos)
        return r
    # ---- M59-S4 数学（双模式同步：编译模式 bi_* 已注册；解释器参数预检后直调 C libm） ----
    # 语义对齐 M59-PLAN §3.3：参数个数/类型错 → Err（解释器不杀进程，区别于编译模式 px_error）；
    # 域错误（log(-1)→NaN、exp(1000)→+inf）透传 C libm（与编译模式一致，不返回 Err）。
    if name == "sqrt" or name == "sin" or name == "cos" or name == "tan" or name == "floor" or name == "ceil" or name == "round" or name == "log" or name == "log10" or name == "exp":
        return i_math_unary(name, args, pos)
    if name == "atan2":
        return i_math_atan2(args, pos)
    if name == "random":
        return i_math_random(args, pos)
    if name == "random_int":
        return i_math_random_int(args, pos)
    if name == "random_seed":
        return i_math_random_seed(args, pos)
    if name == "assert":
        if len(args) < 1 or len(args) > 2:
            return Err(i_r1002("assert 需要 1-2 个参数", pos))
        if not i_truthy(args[0]):
            var msg = "断言失败"
            if len(args) > 1:
                msg = "断言失败: " + i_to_str(args[1])
            return Err(i_r2001(msg, pos))
        return Ok(null)
    if name == "join":
        if len(args) != 2:
            return Err(i_r1002("join 需要 2 个参数（分隔符, 列表）", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("join 分隔符需要 string", pos))
        # M178：可迭代实参统一 + **先判类型** —— 修前直接 `len(args[1])` / `args[1][i]`，
        #   传生成器（解释轨里是 dict{"__gen__"}）时变成「dict 用整数下标」⇒ 报出一句
        #   与 join 毫无关系的 `字典索引键必须是字符串`（实测）。
        #   面 = list/tuple/生成器/**字符串**（str 按 rune；= Python `"-".join("abc")`）
        let t1 = i_type_name(args[1])
        if t1 != "list" and t1 != "tuple" and t1 != "generator" and t1 != "string":
            return Err(i_r1002("join 第二参数需要 list/tuple/生成器/字符串，实际是 " + t1, pos))
        let seqj = i_seq_of(args[1])
        let parts = []
        var i = 0
        while i < len(seqj):
            parts.append(i_to_str(seqj[i]))
            i += 1
        return Ok(join(args[0], parts))
    if name == "contains":
        if len(args) != 2:
            return Err(i_r1002("contains 需要 2 个参数", pos))
        let t0 = i_type_name(args[0])
        if t0 == "string":
            return Ok(contains(args[0], args[1]))
        if t0 == "list":
            var i = 0
            while i < len(args[0]):
                if i_eq(args[0][i], args[1]):
                    return Ok(true)
                i += 1
            return Ok(false)
        if t0 == "tuple" or t0 == "generator":
            let srcc = i_seq_of(args[0])
            var ic = 0
            while ic < len(srcc):
                if i_eq(srcc[ic], args[1]):
                    return Ok(true)
                ic += 1
            return Ok(false)
        return Err(i_r1002("contains 不支持类型 " + t0, pos))
    if name == "split":
        # M190（缺陷 213-e）：修前**只收恰 2 个参数**，而 C 层 `bi_split` 收 **1-2** ——
        #   1 参时默认分隔符是 **单个空格**（`sep = " "`，实测 `split("a b  c") == [a, b, , c]`，
        #   与 `.split(" ")` 同），不是「按空白」。⇒ `split("a b")` 解释轨响亮、VM/C 轨可用。
        #   统一为 **1-2**（放行 C 轨已有能力，删能力是退步）。文案对齐 C 层。
        if len(args) < 1 or len(args) > 2:
            return Err(i_r1002("split 需要 1-2 个参数（字符串, [分隔符]）", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("split 参数需要 string", pos))
        if len(args) == 1:
            return Ok(args[0].split(" "))
        if type(args[1]) != "string":
            return Err(i_r1002("split 参数需要 string", pos))
        return Ok(args[0].split(args[1]))
    if name == "trim":
        if len(args) != 1:
            return Err(i_r1002("trim 需要一个字符串参数", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("trim 需要一个字符串参数", pos))
        return Ok(args[0].trim())
    if name == "to_upper":
        if len(args) != 1:
            return Err(i_r1002("to_upper 需要一个字符串参数", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("to_upper 需要一个字符串参数", pos))
        return Ok(args[0].upper())
    if name == "to_lower":
        if len(args) != 1:
            return Err(i_r1002("to_lower 需要一个字符串参数", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("to_lower 需要一个字符串参数", pos))
        return Ok(args[0].lower())
    if name == "replace":
        # M199（缺陷 238 · [S10]「同操作三轨同一条真相」）：
        #   旧写法只查**个数**，随后经 `args[0].replace(...)` **方法面**执行 ⇒ 位置错时
        #   拿到的是方法面的词条（`方法 replace 参数 1 需要 string` / `R1007 类型 dict 没有方法 'replace'`），
        #   而编译轨是**函数面**（`R1002: replace 需要 3 个字符串参数`）⇒ 同一调用两套码两套词条。
        #   实测（M199 自动探针 replace__p0/p1/p2）：解释轨 R1007 ↔ VM·C 轨 R1002。
        #   现改为**先按函数面口径守卫**（与 C 层 `bi_replace` 同码同文），再执行。
        if len(args) != 3:
            return Err(i_r1002("replace 需要 3 个字符串参数", pos))
        if type(args[0]) != "string" or type(args[1]) != "string" or type(args[2]) != "string":
            return Err(i_r1002("replace 需要 3 个字符串参数", pos))
        return Ok(args[0].replace(args[1], args[2]))
    if name == "starts_with":
        if len(args) != 2:
            return Err(i_r1002("starts_with 需要 2 个字符串参数", pos))
        if type(args[0]) != "string" or type(args[1]) != "string":
            return Err(i_r1002("starts_with 需要 2 个字符串参数", pos))
        return Ok(args[0].starts_with(args[1]))
    if name == "ends_with":
        if len(args) != 2:
            return Err(i_r1002("ends_with 需要 2 个字符串参数", pos))
        if type(args[0]) != "string" or type(args[1]) != "string":
            return Err(i_r1002("ends_with 需要 2 个字符串参数", pos))
        return Ok(args[0].ends_with(args[1]))
    if name == "gen_next":
        # M41.2 补：解释器生成器 gen_next（对齐 C 层 bi_gen_next 逐项取值语义）
        # M196（缺陷 230）：**arity 检查必须在取 args[0] 之前** —— 修前先 `let g = args[0]`，
        #   于是 `gen_next()`（0 参）撞的是 `R1003 索引越界: 0 (len=0)`，
        #   而原生侧（三轨共用）给的是 `R1002: gen_next 需要生成器对象` ⇒ 同操作两码两文。
        if len(args) != 1:
            # M196：**arity 与类型分开**（原生侧两条不同：`gen_next 需要 1 个参数` /
            #   `gen_next 需要生成器对象`）—— 修前解释轨只有一条，arity 也报"需要生成器对象"。
            return Err(i_r1002("gen_next 需要 1 个参数", pos))
        let g = args[0]
        if i_type_name(g) != "generator":
            return Err(i_r1002("gen_next 需要生成器对象", pos))
        let items = g["__gen__"]
        let c = g["cursor"]
        if c < len(items):
            g["cursor"] = c + 1
            return Ok(items[c])
        return Ok(null)
    if name == "list":
        if len(args) != 1:
            return Err(i_r1002("list 需要 1 个参数", pos))
        let t = i_type_name(args[0])
        if t == "generator":
            return Ok(args[0]["__gen__"])
        return Ok(list(args[0]))
    if name == "tuple":
        if len(args) != 1:
            return Err(i_r1002("tuple 需要 1 个参数", pos))
        let t = i_type_name(args[0])
        if t == "list" or t == "tuple":
            return Ok(tuple(args[0]))
        return Err(i_r1002("tuple 参数需要 list/tuple", pos))
    if name == "dict":
        if len(args) != 0:
            return Err(i_r1002("dict 不需要参数", pos))
        return Ok(it_new_dict())
    if name == "unique":
        # std.collections.unique：去重保持顺序（M177：可迭代实参统一走 i_seq_of）
        if len(args) != 1:
            return Err(i_r1002("unique 需要 1 个参数", pos))
        let src = i_seq_of(args[0])
        let out = []
        var ui = 0
        while ui < len(src):
            if not contains(out, src[ui]):
                out.append(src[ui])
            ui += 1
        return Ok(out)
    if name == "flatten":
        # std.collections.flatten：嵌套列表展平一层（M177：可迭代实参统一走 i_seq_of）
        if len(args) != 1:
            return Err(i_r1002("flatten 需要 1 个参数", pos))
        let src2 = i_seq_of(args[0])
        let out = []
        var fi = 0
        while fi < len(src2):
            let sub = i_seq_of(src2[fi])
            var fj = 0
            while fj < len(sub):
                out.append(sub[fj])
                fj += 1
            fi += 1
        return Ok(out)
    if name == "map":
        return i_builtin_map(args, pos)
    if name == "filter":
        return i_builtin_filter(args, pos)
    if name == "reduce":
        return i_builtin_reduce(args, pos)
    # ---- 直接转发类（行为已双模式对齐，参数为原生值） ----
    if name == "read_file":
        if len(args) != 1:
            return Err(i_r1002("read_file 需要一个路径参数", pos))
        if not exists(args[0]):
            return Err(i_err("R2001", "io: 读取文件失败 " + args[0] + ": No such file or directory (os error 2)", pos))
        return Ok(read_file(args[0]))
    if name == "write_file":
        # M114 尾修（qg-issue 69）：第 3 参 mode **必须透传**。
        #   此前静默丢弃 ⇒ 解释器内 write_file(p, secret, 0o600) 落成 0644
        #   （与 C 轨行为不一致，且把「密钥文件」这类用法悄悄放宽权限）。
        if len(args) < 2 or len(args) > 3:
            return Err(i_r1002("write_file 需要 (路径, 内容[, mode])", pos))
        if len(args) == 3:
            return Ok(write_file(args[0], args[1], args[2]))
        return Ok(write_file(args[0], args[1]))
    if name == "append_file":
        # 同上：mode 透传（同一缺陷类）
        if len(args) < 2 or len(args) > 3:
            return Err(i_r1002("append_file 需要 (路径, 内容[, mode])", pos))
        if len(args) == 3:
            return Ok(append_file(args[0], args[1], args[2]))
        return Ok(append_file(args[0], args[1]))
    if name == "exists":
        if len(args) != 1:
            return Err(i_r1002("exists 需要一个路径参数", pos))
        return Ok(exists(args[0]))
    # M129（qg-issue 87 缺陷 44）：is_dir —— 「路径存在且是目录」（Go fi.IsDir() 等价物）
    if name == "is_dir":
        if len(args) != 1:
            return Err(i_r1002("is_dir 需要一个路径参数", pos))
        return Ok(is_dir(args[0]))
    if name == "remove":
        if len(args) != 1:
            return Err(i_r1002("remove 需要一个路径参数", pos))
        return Ok(remove(args[0]))
    if name == "mkdir":
        # M116（qg-issue 71 D6）：mode 透传（同 write_file/append_file 缺陷类：
        #   手写转发层漏列尾参 = 解释器轨静默丢弃，而解释器不校验实参个数）
        if len(args) < 1 or len(args) > 2:
            return Err(i_r1002("mkdir 需要 (path[, mode]) 参数", pos))
        if len(args) == 2:
            return Ok(mkdir(args[0], args[1]))
        return Ok(mkdir(args[0]))
    if name == "list_dir":
        if len(args) != 1:
            return Err(i_r1002("list_dir 需要一个路径参数", pos))
        return Ok(list_dir(args[0]))
    if name == "list_dir_opt":
        # M184（PX-DEF-014）：安全变体 —— 不存在/非目录 ⇒ Err（不再是进程终止）
        if len(args) != 1:
            return Err(i_r1002("list_dir_opt 需要一个路径参数", pos))
        return Ok(list_dir_opt(args[0]))
    if name == "file_size":
        if len(args) != 1:
            return Err(i_r1002("file_size 需要一个路径参数", pos))
        return Ok(file_size(args[0]))
    if name == "read_bytes":
        if len(args) != 1:
            return Err(i_r1002("read_bytes 需要一个路径参数", pos))
        return Ok(read_bytes(args[0]))
    if name == "write_bytes":
        if len(args) != 2:
            return Err(i_r1002("write_bytes 需要 (路径, bytes) 参数", pos))
        return Ok(write_bytes(args[0], args[1]))
    if name == "regex_match":
        if len(args) != 2:
            return Err(i_r1002("regex_match 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_match(args[0], args[1]))
    if name == "regex_find":
        if len(args) != 2:
            return Err(i_r1002("regex_find 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_find(args[0], args[1]))
    if name == "regex_search":
        if len(args) != 2:
            return Err(i_r1002("regex_search 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_search(args[0], args[1]))
    if name == "regex_find_all":
        if len(args) != 2:
            return Err(i_r1002("regex_find_all 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_find_all(args[0], args[1]))
    if name == "regex_replace":
        if len(args) != 3:
            return Err(i_r1002("regex_replace 需要 3 个参数: (pattern, text, repl)", pos))
        return Ok(regex_replace(args[0], args[1], args[2]))
    if name == "regex_split":
        if len(args) != 2:
            return Err(i_r1002("regex_split 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_split(args[0], args[1]))
    if name == "json_parse_opt":
        # M129（qg-issue 87 缺陷 38）：Result 版 JSON 解析（对齐 Go json.Unmarshal 的 err 通道）
        if len(args) != 1:
            return Err(i_r1002("json_parse_opt 需要一个参数", pos))
        return Ok(json_parse_opt(args[0]))
    if name == "json_parse":
        if len(args) != 1:
            return Err(i_r1002("json_parse 需要一个字符串参数", pos))
        return Ok(json_parse(args[0]))
    if name == "json_stringify":
        if len(args) != 1:
            return Err(i_r1002("json_stringify 需要一个参数", pos))
        return Ok(json_stringify(args[0]))
    if name == "json_stringify_go":
        # M129（qg-issue 87 缺陷 16）：Go encoding/json 兼容序列化（键排序 + HTML/控制符转义
