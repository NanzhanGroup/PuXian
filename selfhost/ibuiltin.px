# ============================================================
# M-B7: ibuiltin.px —— interp 内置函数分发（对齐 builtin.rs Mini 子集部分）
# ------------------------------------------------------------
# 内置函数值表示为 {"__builtin__": name}，eval Call 节点检测到后调
# i_call_builtin 分发。
# 策略：
#   1. 值感知类（参数可能含包装值 / 需 i_ 语义）→ 本文件内实现
#   2. 直接转发类（参数为原生值，行为已双模式对齐）→ Ok(同名内置调用)
#   3. 可失败类（read_file/int 转换等）→ 预检查返回 Err（对齐 Rust 错误消息）
# ============================================================
# ---------- 主分发 ----------
# ---- M63-L8: 网络类 C builtin 统一 Ok 包裹 helper ----
# 解释器 builtin 返回约定：Ok(实际返回值) 给 icall 自动 unwrap；Err 用于传播。
# C 网络函数成功返回普通值（str/dict/bool/...）、失败返回 Err("net: ...") result
# （px_net_err，M57 语义不杀进程）。一律 Ok(v)：unwrap 后成功=普通值、失败=Err result
# 交用户 .is_err()/`?` 处理（与 http_get 既有分支、编译模式行为一致）。
def i_call_c_net(v):
    return Ok(v)
def i_call_builtin(name, args, pos):
    # ---- 值感知类 ----
    if name == "print":
        let parts = []
        var i = 0
        while i < len(args):
            parts.append(i_to_str(args[i]))
            i += 1
        print(join(" ", parts))
        return Ok(null)
    if name == "flush":
        # M72-S1（Issue 9）：flush() —— 显式刷 stdout/stderr（宿主 runtime native）
        if len(args) != 0:
            return Err(i_r1002("flush 不需要参数", pos))
        flush()
        return Ok(null)
    if name == "print_err":
        # M72-S1（Issue 9/10）：print_err(...) —— 渲染对齐 print，输出到 stderr
        let parts = []
        var i = 0
        while i < len(args):
            parts.append(i_to_str(args[i]))
            i += 1
        print_err(join(" ", parts))
        return Ok(null)
    if name == "str":
        if len(args) != 1:
            return Err(i_r1002("str 需要一个参数", pos))
        return Ok(i_to_str(args[0]))
    if name == "type":
        if len(args) != 1:
            return Err(i_r1002("type 需要一个参数", pos))
        return Ok(i_type_name(args[0]))
    # M145：对象同一性（环检测 / 指针语义移植用；非堆值 0）
    if name == "object_id":
        if len(args) != 1:
            return Err(i_r1002("object_id 需要一个参数", pos))
        return Ok(object_id(args[0]))
    if name == "bool":
        if len(args) != 1:
            return Err(i_r1002("bool 需要一个参数", pos))
        return Ok(i_truthy(args[0]))
    if name == "len":
        return i_builtin_len(args, pos)
    if name == "int":
        return i_builtin_int(args, pos)
    if name == "float":
        return i_builtin_float(args, pos)
    if name == "range":
        return i_builtin_range(args, pos)
    if name == "sorted":
        return i_builtin_sorted(args, pos)
    if name == "reversed":
        return i_builtin_reversed(args, pos)
    if name == "sum":
        return i_builtin_sum(args, pos)
    if name == "abs":
        if len(args) != 1:
            return Err(i_r1002("abs 需要一个参数", pos))
        let t = i_type_name(args[0])
        if t == "int":
            if args[0] < 0:
                return Ok(-args[0])
            return Ok(args[0])
        if t == "float":
            if args[0] < 0.0:
                return Ok(-args[0])
            return Ok(args[0])
        return Err(i_r1002("abs 参数需要数值", pos))
    if name == "min":
        if len(args) != 2:
            return Err(i_r1002("min 需要两个参数", pos))
        let c = i_bin_compare("Lt", args[0], args[1], pos)
        if c.is_err():
            return Err(c.err())
        if c.unwrap():
            return Ok(args[0])
        return Ok(args[1])
    if name == "max":
        if len(args) != 2:
            return Err(i_r1002("max 需要两个参数", pos))
        let c = i_bin_compare("Gt", args[0], args[1], pos)
        if c.is_err():
            return Err(c.err())
        if c.unwrap():
            return Ok(args[0])
        return Ok(args[1])
    if name == "pow":
        if len(args) != 2:
            return Err(i_r1002("pow 需要两个参数", pos))
        let p0 = i_type_name(args[0])
        let p1 = i_type_name(args[1])
        if (p0 != "int" and p0 != "float"):
            return Err(i_r1002("pow 参数必须是数字，实际是 " + p0, pos))
        if (p1 != "int" and p1 != "float"):
            return Err(i_r1002("pow 参数必须是数字，实际是 " + p1, pos))
        let r = i_eval_binary("Pow", args[0], args[1], pos)
        return r
    # ---- M59-S4 数学（双模式同步：编译模式 bi_* 已注册；解释器参数预检后直调 C libm） ----
    # 语义对齐 M59-PLAN §3.3：参数个数/类型错 → Err（解释器不杀进程，区别于编译模式 px_error）；
    # 域错误（log(-1)→NaN、exp(1000)→+inf）透传 C libm（与编译模式一致，不返回 Err）。
    if name == "sqrt" or name == "sin" or name == "cos" or name == "tan" or name == "floor" or name == "ceil" or name == "round" or name == "log" or name == "log10" or name == "exp":
        return i_math_unary(name, args, pos)
    if name == "atan2":
        return i_math_atan2(args, pos)
    if name == "random":
        return i_math_random(args, pos)
    if name == "random_int":
        return i_math_random_int(args, pos)
    if name == "random_seed":
        return i_math_random_seed(args, pos)
    if name == "assert":
        if len(args) < 1 or len(args) > 2:
            return Err(i_r1002("assert 需要 1-2 个参数", pos))
        if not i_truthy(args[0]):
            var msg = "断言失败"
            if len(args) > 1:
                msg = i_to_str(args[1])
            return Err(i_r1003(msg, pos))
        return Ok(null)
    if name == "join":
        if len(args) != 2:
            return Err(i_r1002("join 需要 (分隔符, 列表) 两个参数", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("join 分隔符需要 string", pos))
        let parts = []
        var i = 0
        while i < len(args[1]):
            parts.append(i_to_str(args[1][i]))
            i += 1
        return Ok(join(args[0], parts))
    if name == "contains":
        if len(args) != 2:
            return Err(i_r1002("contains 需要两个参数", pos))
        let t0 = i_type_name(args[0])
        if t0 == "string":
            return Ok(contains(args[0], args[1]))
        if t0 == "list":
            var i = 0
            while i < len(args[0]):
                if i_eq(args[0][i], args[1]):
                    return Ok(true)
                i += 1
            return Ok(false)
        return Err(i_r1002("contains 参数类型不支持", pos))
    if name == "split":
        if len(args) != 2:
            return Err(i_r1002("split 需要 (字符串, 分隔符) 两个参数", pos))
        if type(args[0]) != "string" or type(args[1]) != "string":
            return Err(i_r1002("split 参数需要 string", pos))
        return Ok(args[0].split(args[1]))
    if name == "trim":
        if len(args) != 1:
            return Err(i_r1002("trim 需要一个参数", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("trim 参数需要 string", pos))
        return Ok(args[0].trim())
    if name == "to_upper":
        if len(args) != 1:
            return Err(i_r1002("to_upper 需要一个参数", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("to_upper 需要一个字符串参数", pos))
        return Ok(args[0].upper())
    if name == "to_lower":
        if len(args) != 1:
            return Err(i_r1002("to_lower 需要一个参数", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("to_lower 需要一个字符串参数", pos))
        return Ok(args[0].lower())
    if name == "replace":
        if len(args) != 3:
            return Err(i_r1002("replace 需要 3 个参数", pos))
        return Ok(args[0].replace(args[1], args[2]))
    if name == "starts_with":
        if len(args) != 2:
            return Err(i_r1002("starts_with 需要 2 个字符串参数", pos))
        if type(args[0]) != "string" or type(args[1]) != "string":
            return Err(i_r1002("starts_with 需要 2 个字符串参数", pos))
        return Ok(args[0].starts_with(args[1]))
    if name == "ends_with":
        if len(args) != 2:
            return Err(i_r1002("ends_with 需要 2 个字符串参数", pos))
        if type(args[0]) != "string" or type(args[1]) != "string":
            return Err(i_r1002("ends_with 需要 2 个字符串参数", pos))
        return Ok(args[0].ends_with(args[1]))
    if name == "gen_next":
        # M41.2 补：解释器生成器 gen_next（对齐 C 层 bi_gen_next 逐项取值语义）
        let g = args[0]
        if len(args) != 1:
            return Err(i_r1002("gen_next 需要一个生成器参数", pos))
        if i_type_name(g) != "generator":
            return Err(i_r1002("gen_next 需要生成器对象", pos))
        let items = g["__gen__"]
        let c = g["cursor"]
        if c < len(items):
            g["cursor"] = c + 1
            return Ok(items[c])
        return Ok(null)
    if name == "list":
        if len(args) != 1:
            return Err(i_r1002("list 需要一个参数", pos))
        let t = i_type_name(args[0])
        if t == "generator":
            return Ok(args[0]["__gen__"])
        return Ok(list(args[0]))
    if name == "tuple":
        if len(args) != 1:
            return Err(i_r1002("tuple 需要一个参数", pos))
        let t = i_type_name(args[0])
        if t == "list" or t == "tuple":
            return Ok(tuple(args[0]))
        return Err(i_r1002("tuple 参数需要 list/tuple", pos))
    if name == "dict":
        if len(args) != 0:
            return Err(i_r1002("dict 不需要参数", pos))
        return Ok(it_new_dict())
    if name == "unique":
        # std.collections.unique：去重保持顺序
        let out = []
        var ui = 0
        while ui < len(args[0]):
            if not contains(out, args[0][ui]):
                out.append(args[0][ui])
            ui += 1
        return Ok(out)
    if name == "flatten":
        # std.collections.flatten：嵌套列表展平一层
        let out = []
        var fi = 0
        while fi < len(args[0]):
            let sub = args[0][fi]
            var fj = 0
            while fj < len(sub):
                out.append(sub[fj])
                fj += 1
            fi += 1
        return Ok(out)
    if name == "map":
        return i_builtin_map(args, pos)
    if name == "filter":
        return i_builtin_filter(args, pos)
    if name == "reduce":
        return i_builtin_reduce(args, pos)
    # ---- 直接转发类（行为已双模式对齐，参数为原生值） ----
    if name == "read_file":
        if len(args) != 1:
            return Err(i_r1002("read_file 需要一个路径参数", pos))
        if not exists(args[0]):
            return Err(i_err("R2001", "io: 读取文件失败 " + args[0] + ": No such file or directory (os error 2)", pos))
        return Ok(read_file(args[0]))
    if name == "write_file":
        # M114 尾修（qg-issue 69）：第 3 参 mode **必须透传**。
        #   此前静默丢弃 ⇒ 解释器内 write_file(p, secret, 0o600) 落成 0644
        #   （与 C 轨行为不一致，且把「密钥文件」这类用法悄悄放宽权限）。
        if len(args) < 2 or len(args) > 3:
            return Err(i_r1002("write_file 需要 (路径, 内容[, mode])", pos))
        if len(args) == 3:
            return Ok(write_file(args[0], args[1], args[2]))
        return Ok(write_file(args[0], args[1]))
    if name == "append_file":
        # 同上：mode 透传（同一缺陷类）
        if len(args) < 2 or len(args) > 3:
            return Err(i_r1002("append_file 需要 (路径, 内容[, mode])", pos))
        if len(args) == 3:
            return Ok(append_file(args[0], args[1], args[2]))
        return Ok(append_file(args[0], args[1]))
    if name == "exists":
        if len(args) != 1:
            return Err(i_r1002("exists 需要一个路径参数", pos))
        return Ok(exists(args[0]))
    # M129（qg-issue 87 缺陷 44）：is_dir —— 「路径存在且是目录」（Go fi.IsDir() 等价物）
    if name == "is_dir":
        if len(args) != 1:
            return Err(i_r1002("is_dir 需要一个路径参数", pos))
        return Ok(is_dir(args[0]))
    if name == "remove":
        if len(args) != 1:
            return Err(i_r1002("remove 需要一个路径参数", pos))
        return Ok(remove(args[0]))
    if name == "mkdir":
        # M116（qg-issue 71 D6）：mode 透传（同 write_file/append_file 缺陷类：
        #   手写转发层漏列尾参 = 解释器轨静默丢弃，而解释器不校验实参个数）
        if len(args) < 1 or len(args) > 2:
            return Err(i_r1002("mkdir 需要 (路径[, mode])", pos))
        if len(args) == 2:
            return Ok(mkdir(args[0], args[1]))
        return Ok(mkdir(args[0]))
    if name == "list_dir":
        if len(args) != 1:
            return Err(i_r1002("list_dir 需要一个路径参数", pos))
        return Ok(list_dir(args[0]))
    if name == "file_size":
        if len(args) != 1:
            return Err(i_r1002("file_size 需要一个路径参数", pos))
        return Ok(file_size(args[0]))
    if name == "read_bytes":
        if len(args) != 1:
            return Err(i_r1002("read_bytes 需要一个路径参数", pos))
        return Ok(read_bytes(args[0]))
    if name == "write_bytes":
        if len(args) != 2:
            return Err(i_r1002("write_bytes 需要 (路径, bytes) 参数", pos))
        return Ok(write_bytes(args[0], args[1]))
    if name == "regex_match":
        if len(args) != 2:
            return Err(i_r1002("regex_match 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_match(args[0], args[1]))
    if name == "regex_find":
        if len(args) != 2:
            return Err(i_r1002("regex_find 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_find(args[0], args[1]))
    if name == "regex_search":
        if len(args) != 2:
            return Err(i_r1002("regex_search 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_search(args[0], args[1]))
    if name == "regex_find_all":
        if len(args) != 2:
            return Err(i_r1002("regex_find_all 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_find_all(args[0], args[1]))
    if name == "regex_replace":
        if len(args) != 3:
            return Err(i_r1002("regex_replace 需要 3 个参数: (pattern, text, repl)", pos))
        return Ok(regex_replace(args[0], args[1], args[2]))
    if name == "regex_split":
        if len(args) != 2:
            return Err(i_r1002("regex_split 需要 2 个参数: (pattern, text)", pos))
        return Ok(regex_split(args[0], args[1]))
    if name == "json_parse_opt":
        # M129（qg-issue 87 缺陷 38）：Result 版 JSON 解析（对齐 Go json.Unmarshal 的 err 通道）
        if len(args) != 1:
            return Err(i_r1002("json_parse_opt 需要一个字符串参数", pos))
        return Ok(json_parse_opt(args[0]))
    if name == "json_parse":
        if len(args) != 1:
            return Err(i_r1002("json_parse 需要一个字符串参数", pos))
        return Ok(json_parse(args[0]))
    if name == "json_stringify":
        if len(args) != 1:
            return Err(i_r1002("json_stringify 需要一个参数", pos))
        return Ok(json_stringify(args[0]))
    if name == "json_stringify_go":
        # M129（qg-issue 87 缺陷 16）：Go encoding/json 兼容序列化（键排序 + HTML/控制符转义
        #   + 最短往返浮点）。解释器轨必须**逐条显式转发**（本文件是手写转发层，漏写即静默丢参）。
        #   M129-2：可选 opts（{"sort_keys":bool,"escape_html":bool}）—— 少了这一支就是"丢参"。
        if len(args) == 1:
            return Ok(json_stringify_go(args[0]))
        if len(args) == 2:
            return Ok(json_stringify_go(args[0], args[1]))
        return Err(i_r1002("json_stringify_go 需要 (值[, opts]) 参数", pos))
    if name == "json_path":
        if len(args) != 2:
            return Err(i_r1002("json_path 需要 (json, path) 参数", pos))
        return Ok(json_path(args[0], args[1]))
    if name == "json_path_set":
        if len(args) != 3:
            return Err(i_r1002("json_path_set 需要 (json, path, value) 参数", pos))
        return Ok(json_path_set(args[0], args[1], args[2]))
    if name == "sha256":
        # M45：完整性哈希（lockfile 校验；runtime.c 已注册，pxi 直调）
        if len(args) != 1:
            return Err(i_r1002("sha256 需要一个参数", pos))
        return Ok(sha256(args[0]))
    if name == "http_get":
        # M45：远程依赖下载（runtime.c 已注册，pxi 直调）
        if len(args) != 1:
            return Err(i_r1002("http_get 需要 (url) 参数", pos))
        return Ok(http_get(args[0]))
    if name == "os_spawn":
        # M114 尾修（qg-issue 69）：第 3 参 group **必须透传**。
        #   此前静默丢弃 ⇒ 解释器内 os_spawn(cmd, argv, true) 不成进程组，
        #   随后 os_kill(pid, sig, true) / kill(-pgid) 语义失效（与 C 轨不一致）。
        if len(args) == 3:
            return Ok(os_spawn(args[0], args[1], args[2]))
        return Ok(os_spawn(args[0], args[1]))
    if name == "os_spawn_capture":
        # M65：子进程输出捕获（LSP 诊断器 / MCP run/test/bench 编排，双模式对齐）
        if len(args) != 2:
            return Err(i_r1002("os_spawn_capture 需要 (cmd, args) 参数", pos))
        return Ok(os_spawn_capture(args[0], args[1]))
    if name == "ffi_call":
        # M42：FFI C 桥 —— ffi_call(name, args_list) 调 runtime 注册的 C 绑定
        return i_builtin_ffi_call(args, pos)
    if name == "os_wait":
        if len(args) != 1:
            return Err(i_r1002("os_wait 需要 (pid) 参数", pos))
        return Ok(os_wait(args[0]))
    if name == "os_kill":
        # M66：支持 (pid, sig[, group])；pxi 传宿主同名函数（解释器自身是编译产物，宿主已注册）
        if len(args) >= 2 and len(args) <= 3:
            if len(args) == 2:
                return Ok(os_kill(args[0], args[1]))
            return Ok(os_kill(args[0], args[1], args[2]))
        return Ok(os_kill(args[0]))
    if name == "os_exec":
        # M66：进程替换（launcher 语义；解释器内执行将替换解释器自身，语义与编译模式一致）
        if len(args) == 1:
            return Ok(os_exec(args[0]))
        return Ok(os_exec(args[0], args[1]))
    if name == "os_rename":
        if len(args) != 2:
            return Err(i_r1002("os_rename 需要 (old_path, new_path) 参数", pos))
        return Ok(os_rename(args[0], args[1]))
    if name == "os_remove_all":
        if len(args) != 1:
            return Err(i_r1002("os_remove_all 需要 (path) 参数", pos))
        return Ok(os_remove_all(args[0]))
    if name == "os_random_hex":
        if len(args) != 1:
            return Err(i_r1002("os_random_hex 需要 (nbytes) 参数", pos))
        return Ok(os_random_hex(args[0]))
    if name == "os_file_sha256":
        if len(args) != 1:
            return Err(i_r1002("os_file_sha256 需要 (path) 参数", pos))
        return Ok(os_file_sha256(args[0]))
    if name == "os_capture":
        # M66：子进程 stdout/stderr 分离捕获 → {rc, stdout, stderr}
        if len(args) != 2:
            return Err(i_r1002("os_capture 需要 (cmd, args) 参数", pos))
        return Ok(os_capture(args[0], args[1]))
    if name == "os_popen":
        # M66：双向管道 → {pid, stdin_fd, stdout_fd}
        if len(args) != 2:
            return Err(i_r1002("os_popen 需要 (cmd, args) 参数", pos))
        return Ok(os_popen(args[0], args[1]))
    if name == "unix_connect":
        # M66：AF_UNIX 裸连接 → fd（复用 read/write 收发）
        if len(args) != 1:
            return Err(i_r1002("unix_connect 需要 (socket_path) 参数", pos))
        return Ok(unix_connect(args[0]))
    if name == "env":
        if len(args) != 1:
            return Err(i_r1002("env 需要一个变量名", pos))
        return Ok(env(args[0]))
    # M115：服务进程/环境原语（ws-center / ws-ddns PuXian 化实测缺口）
    # ⚠️ env_set 必须走 ffi_call 显式按名调用宿主 native：
    #   本文件与 selfhost/env.px（编译器内部**变量环境**）一起编译，env.px 里有同名
    #   PuXian 函数 `def env_set(env, name, value)` ⇒ 直接写 `env_set(a, b)` 会**静默**
    #   绑到内部辅助函数上（实参类型不符，报错还指向无关行列：实测
    #   `运行时错误 [env_set 行40]: 期望整数，实际是 string`）。ffi_call 是 M42 起的
