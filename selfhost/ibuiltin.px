# ============================================================
# M-B7: ibuiltin.px —— interp 内置函数分发（对齐 builtin.rs Mini 子集部分）
# ------------------------------------------------------------
# 内置函数值表示为 {"__builtin__": name}，eval Call 节点检测到后调
# i_call_builtin 分发。
# 策略：
#   1. 值感知类（参数可能含包装值 / 需 i_ 语义）→ 本文件内实现
#   2. 直接转发类（参数为原生值，行为已双模式对齐）→ Ok(同名内置调用)
#   3. 可失败类（read_file/int 转换等）→ 预检查返回 Err（对齐 Rust 错误消息）
# ============================================================

# ---------- 主分发 ----------
# ---- M63-L8: 网络类 C builtin 统一 Ok 包裹 helper ----
# 解释器 builtin 返回约定：Ok(实际返回值) 给 icall 自动 unwrap；Err 用于传播。
# C 网络函数成功返回普通值（str/dict/bool/...）、失败返回 Err("net: ...") result
# （px_net_err，M57 语义不杀进程）。一律 Ok(v)：unwrap 后成功=普通值、失败=Err result
# 交用户 .is_err()/`?` 处理（与 http_get 既有分支、编译模式行为一致）。
def i_call_c_net(v):
    return Ok(v)

def i_call_builtin(name, args, pos):
    # ---- 值感知类 ----
    if name == "print":
        let parts = []
        var i = 0
        while i < len(args):
            parts.append(i_to_str(args[i]))
            i += 1
        print(join(" ", parts))
        return Ok(null)
    if name == "str":
        if len(args) != 1:
            return Err(i_r1002("str 需要一个参数", pos))
        return Ok(i_to_str(args[0]))
    if name == "type":
        if len(args) != 1:
            return Err(i_r1002("type 需要一个参数", pos))
        return Ok(i_type_name(args[0]))
    if name == "bool":
        if len(args) != 1:
            return Err(i_r1002("bool 需要一个参数", pos))
        return Ok(i_truthy(args[0]))
    if name == "len":
        return i_builtin_len(args, pos)
    if name == "int":
        return i_builtin_int(args, pos)
    if name == "float":
        return i_builtin_float(args, pos)
    if name == "range":
        return i_builtin_range(args, pos)
    if name == "sorted":
        return i_builtin_sorted(args, pos)
    if name == "reversed":
        return i_builtin_reversed(args, pos)
    if name == "sum":
        return i_builtin_sum(args, pos)
    if name == "abs":
        if len(args) != 1:
            return Err(i_r1002("abs 需要一个参数", pos))
        let t = i_type_name(args[0])
        if t == "int":
            if args[0] < 0:
                return Ok(-args[0])
            return Ok(args[0])
        if t == "float":
            if args[0] < 0.0:
                return Ok(-args[0])
            return Ok(args[0])
        return Err(i_r1002("abs 参数需要数值", pos))
    if name == "min":
        if len(args) != 2:
            return Err(i_r1002("min 需要两个参数", pos))
        let c = i_bin_compare("Lt", args[0], args[1], pos)
        if c.is_err():
            return Err(c.err())
        if c.unwrap():
            return Ok(args[0])
        return Ok(args[1])
    if name == "max":
        if len(args) != 2:
            return Err(i_r1002("max 需要两个参数", pos))
        let c = i_bin_compare("Gt", args[0], args[1], pos)
        if c.is_err():
            return Err(c.err())
        if c.unwrap():
            return Ok(args[0])
        return Ok(args[1])
    if name == "pow":
        if len(args) != 2:
            return Err(i_r1002("pow 需要两个参数", pos))
        let r = i_eval_binary("Pow", args[0], args[1], pos)
        return r
    # ---- M59-S4 数学（双模式同步：编译模式 bi_* 已注册；解释器参数预检后直调 C libm） ----
    # 语义对齐 M59-PLAN §3.3：参数个数/类型错 → Err（解释器不杀进程，区别于编译模式 px_error）；
    # 域错误（log(-1)→NaN、exp(1000)→+inf）透传 C libm（与编译模式一致，不返回 Err）。
    if name == "sqrt" or name == "sin" or name == "cos" or name == "tan" or name == "floor" or name == "ceil" or name == "round" or name == "log" or name == "log10" or name == "exp":
        return i_math_unary(name, args, pos)
    if name == "atan2":
        return i_math_atan2(args, pos)
    if name == "random":
        return i_math_random(args, pos)
    if name == "random_int":
        return i_math_random_int(args, pos)
    if name == "random_seed":
        return i_math_random_seed(args, pos)
    if name == "assert":
        if len(args) < 1 or len(args) > 2:
            return Err(i_r1002("assert 需要 1-2 个参数", pos))
        if not i_truthy(args[0]):
            var msg = "断言失败"
            if len(args) > 1:
                msg = i_to_str(args[1])
            return Err(i_r1003(msg, pos))
        return Ok(null)
    if name == "join":
        if len(args) != 2:
            return Err(i_r1002("join 需要 (分隔符, 列表) 两个参数", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("join 分隔符需要 string", pos))
        let parts = []
        var i = 0
        while i < len(args[1]):
            parts.append(i_to_str(args[1][i]))
            i += 1
        return Ok(join(args[0], parts))
    if name == "contains":
        if len(args) != 2:
            return Err(i_r1002("contains 需要两个参数", pos))
        let t0 = i_type_name(args[0])
        if t0 == "string":
            return Ok(contains(args[0], args[1]))
        if t0 == "list":
            var i = 0
            while i < len(args[0]):
                if i_eq(args[0][i], args[1]):
                    return Ok(true)
                i += 1
            return Ok(false)
        return Err(i_r1002("contains 参数类型不支持", pos))
    if name == "split":
        if len(args) != 2:
            return Err(i_r1002("split 需要 (字符串, 分隔符) 两个参数", pos))
        if type(args[0]) != "string" or type(args[1]) != "string":
            return Err(i_r1002("split 参数需要 string", pos))
        return Ok(args[0].split(args[1]))
    if name == "trim":
        if len(args) != 1:
            return Err(i_r1002("trim 需要一个参数", pos))
        if type(args[0]) != "string":
            return Err(i_r1002("trim 参数需要 string", pos))
        return Ok(args[0].trim())
    if name == "to_upper":
        if len(args) != 1:
            return Err(i_r1002("to_upper 需要一个参数", pos))
        return Ok(args[0].upper())
    if name == "to_lower":
        if len(args) != 1:
            return Err(i_r1002("to_lower 需要一个参数", pos))
        return Ok(args[0].lower())
    if name == "replace":
        if len(args) != 3:
            return Err(i_r1002("replace 需要 3 个参数", pos))
        return Ok(args[0].replace(args[1], args[2]))
    if name == "starts_with":
        if len(args) != 2:
            return Err(i_r1002("starts_with 需要两个参数", pos))
        return Ok(args[0].starts_with(args[1]))
    if name == "ends_with":
        if len(args) != 2:
            return Err(i_r1002("ends_with 需要两个参数", pos))
        return Ok(args[0].ends_with(args[1]))
    if name == "gen_next":
        # M41.2 补：解释器生成器 gen_next（对齐 C 层 bi_gen_next 逐项取值语义）
        let g = args[0]
        if len(args) != 1:
            return Err(i_r1002("gen_next 需要一个生成器参数", pos))
        if i_type_name(g) != "generator":
            return Err(i_r1002("gen_next 需要生成器对象", pos))
        let items = g["__gen__"]
        let c = g["cursor"]
        if c < len(items):
            g["cursor"] = c + 1
            return Ok(items[c])
        return Ok(null)
    if name == "list":
        if len(args) != 1:
            return Err(i_r1002("list 需要一个参数", pos))
        let t = i_type_name(args[0])
        if t == "generator":
            return Ok(args[0]["__gen__"])
        return Ok(list(args[0]))
    if name == "tuple":
        if len(args) != 1:
            return Err(i_r1002("tuple 需要一个参数", pos))
        let t = i_type_name(args[0])
        if t == "list" or t == "tuple":
            return Ok(tuple(args[0]))
        return Err(i_r1002("tuple 参数需要 list/tuple", pos))
    if name == "dict":
        return Ok(it_new_dict())
    if name == "unique":
        # std.collections.unique：去重保持顺序
        let out = []
        var ui = 0
        while ui < len(args[0]):
            if not contains(out, args[0][ui]):
                out.append(args[0][ui])
            ui += 1
        return Ok(out)
    if name == "flatten":
        # std.collections.flatten：嵌套列表展平一层
        let out = []
        var fi = 0
        while fi < len(args[0]):
            let sub = args[0][fi]
            var fj = 0
            while fj < len(sub):
                out.append(sub[fj])
                fj += 1
            fi += 1
        return Ok(out)
    if name == "map":
        return i_builtin_map(args, pos)
    if name == "filter":
        return i_builtin_filter(args, pos)
    if name == "reduce":
        return i_builtin_reduce(args, pos)
    # ---- 直接转发类（行为已双模式对齐，参数为原生值） ----
    if name == "read_file":
        if len(args) != 1:
            return Err(i_r1002("read_file 需要一个路径参数", pos))
        if not exists(args[0]):
            return Err(i_err("R2001", "io: 读取文件失败 " + args[0] + ": No such file or directory (os error 2)", pos))
        return Ok(read_file(args[0]))
    if name == "write_file":
        return Ok(write_file(args[0], args[1]))
    if name == "append_file":
        return Ok(append_file(args[0], args[1]))
    if name == "exists":
        return Ok(exists(args[0]))
    if name == "remove":
        return Ok(remove(args[0]))
    if name == "mkdir":
        return Ok(mkdir(args[0]))
    if name == "list_dir":
        return Ok(list_dir(args[0]))
    if name == "file_size":
        return Ok(file_size(args[0]))
    if name == "read_bytes":
        return Ok(read_bytes(args[0]))
    if name == "write_bytes":
        return Ok(write_bytes(args[0], args[1]))
    if name == "regex_match":
        return Ok(regex_match(args[0], args[1]))
    if name == "regex_find":
        return Ok(regex_find(args[0], args[1]))
    if name == "regex_search":
        return Ok(regex_search(args[0], args[1]))
    if name == "regex_find_all":
        return Ok(regex_find_all(args[0], args[1]))
    if name == "regex_replace":
        return Ok(regex_replace(args[0], args[1], args[2]))
    if name == "regex_split":
        return Ok(regex_split(args[0], args[1]))
    if name == "json_parse":
        return Ok(json_parse(args[0]))
    if name == "json_stringify":
        return Ok(json_stringify(args[0]))
    if name == "json_path":
        return Ok(json_path(args[0], args[1]))
    if name == "json_path_set":
        return Ok(json_path_set(args[0], args[1], args[2]))
    if name == "sha256":
        # M45：完整性哈希（lockfile 校验；runtime.c 已注册，pxi 直调）
        return Ok(sha256(args[0]))
    if name == "http_get":
        # M45：远程依赖下载（runtime.c 已注册，pxi 直调）
        return Ok(http_get(args[0]))
    if name == "os_spawn":
        return Ok(os_spawn(args[0], args[1]))
    if name == "ffi_call":
        # M42：FFI C 桥 —— ffi_call(name, args_list) 调 runtime 注册的 C 绑定
        return i_builtin_ffi_call(args, pos)
    if name == "os_wait":
        return Ok(os_wait(args[0]))
    if name == "os_kill":
        return Ok(os_kill(args[0]))
    if name == "env":
        return Ok(env(args[0]))
    if name == "now":
        return Ok(now())
    if name == "sleep":
        sleep(args[0])
        return Ok(null)
    if name == "exit":
        return Ok(exit(args[0]))
    if name == "hex_to_int":
        return Ok(hex_to_int(args[0]))
    if name == "int_to_hex":
        return Ok(int_to_hex(args[0], args[1]))
    if name == "int_to_bytes":
        # C 层 int_to_bytes(n, size[, endian[, signed]])：2-4 参，按实参数量透传
        if len(args) >= 3:
            return Ok(int_to_bytes(args[0], args[1], args[2]))
        return Ok(int_to_bytes(args[0], args[1]))
    if name == "bytes_to_int":
        return Ok(bytes_to_int(args[0]))
    # ---- M62-L7：bytes 族白名单补齐（pxi 双模式对齐编译模式；C runtime 已注册，pxi 直调） ----
    # 语义：参数个数/类型错误由 C 层 px_error 终止（编程契约，与编译模式一致——与
    # read_file 等 io 可恢复错误走 Err 不同，bytes 族参数错属编程契约）。
    if name == "bytes":
        # bytes(x) → bytes（str/bytes/数值按 UTF-8/十进制字节原样）
        return Ok(bytes(args[0]))
    if name == "bytes_len":
        # bytes_len(b) → int
        return Ok(bytes_len(args[0]))
    if name == "bytes_get":
        # bytes_get(b, i) → int|null（负索引支持）
        return Ok(bytes_get(args[0], args[1]))
    if name == "bytes_set":
        # bytes_set(b, i, v) → bytes（函数式：返回新 bytes，v ∈ 0..255）
        return Ok(bytes_set(args[0], args[1], args[2]))
    if name == "bytes_slice":
        # bytes_slice(b[, start[, end]]) → bytes（start/end 可 null/int，负索引/越界 clamp）
        if len(args) == 1:
            return Ok(bytes_slice(args[0]))
        if len(args) == 2:
            return Ok(bytes_slice(args[0], args[1]))
        if len(args) == 3:
            return Ok(bytes_slice(args[0], args[1], args[2]))
        return Err(i_r1002("bytes_slice 需要 (bytes[, start[, end]]) 参数", pos))
    if name == "bytes_concat":
        # bytes_concat(a, b, ...) → bytes（≥1 参；解释器两两折叠，等价 C 变参）
        if len(args) < 1:
            return Err(i_r1002("bytes_concat 至少需要一个参数", pos))
        var acc = args[0]
        var bci = 1
        while bci < len(args):
            acc = bytes_concat(acc, args[bci])
            bci += 1
        return Ok(acc)
    if name == "bytes_to_str":
        # bytes_to_str(b) → str（UTF-8）
        return Ok(bytes_to_str(args[0]))
    if name == "bytes_to_hex":
        # bytes_to_hex(b) → str（hex 小写）
        return Ok(bytes_to_hex(args[0]))
    if name == "hex_to_bytes":
        # hex_to_bytes(s) → bytes|null
        return Ok(hex_to_bytes(args[0]))
    if name == "bytes_find":
        # bytes_find(b, sub) → int|null（子串下标；sub 可 bytes/str）
        return Ok(bytes_find(args[0], args[1]))
    if name == "bytes_base64":
        # bytes_base64(b) → str（base64）
        return Ok(bytes_base64(args[0]))
    if name == "base64_to_bytes":
        # base64_to_bytes(s) → bytes|null（严格解码）
        return Ok(base64_to_bytes(args[0]))
    if name == "base64_encode":
        # base64_encode(s) → str（字符串 base64）
        return Ok(base64_encode(args[0]))
    if name == "base64_decode":
        # base64_decode(s) → str|null
        return Ok(base64_decode(args[0]))
    if name == "Ok":
        if len(args) == 0:
            return Ok(Ok(null))
        return Ok(Ok(args[0]))
    if name == "Err":
        if len(args) == 0:
            return Ok(Err(null))
        return Ok(Err(args[0]))
    if name == "Some":
        if len(args) == 0:
            return Ok(null)
        return Ok(args[0])
    # ---- M57 边缘设备层（直接转发 runtime C builtin；可选参数按实参个数透传） ----
    if name == "open":
        # open(path[, mode]) → fd
        if len(args) < 1 or len(args) > 2:
            return Err(i_r1002("open 需要 (path[, mode])", pos))
        if len(args) == 2:
            return Ok(open(args[0], args[1]))
        return Ok(open(args[0]))
    if name == "close":
        # close(fd) → bool
        if len(args) != 1:
            return Err(i_r1002("close 需要一个 fd 参数", pos))
        return Ok(close(args[0]))
    if name == "ioctl":
        # ioctl(fd, request[, arg]) → int（arg: 缺省→NULL / int 直传 / bytes 就地）
        if len(args) < 2 or len(args) > 3:
            return Err(i_r1002("ioctl 需要 (fd, request[, arg])", pos))
        if len(args) == 3:
            return Ok(ioctl(args[0], args[1], args[2]))
        return Ok(ioctl(args[0], args[1]))
    if name == "os_errno":
        # os_errno() → int（线程局部 errno 查询）
        if len(args) != 0:
            return Err(i_r1002("os_errno 不需要参数", pos))
        return Ok(os_errno())
    if name == "read":
        # read(fd, maxlen) → bytes
        if len(args) != 2:
            return Err(i_r1002("read 需要 (fd, maxlen)", pos))
        return Ok(read(args[0], args[1]))
    if name == "write":
        # write(fd, data) → int
        if len(args) != 2:
            return Err(i_r1002("write 需要 (fd, data)", pos))
        return Ok(write(args[0], args[1]))
    if name == "mmap":
        # mmap(fd, length[, offset]) → bytes
        if len(args) < 2 or len(args) > 3:
            return Err(i_r1002("mmap 需要 (fd, length[, offset])", pos))
        if len(args) == 3:
            return Ok(mmap(args[0], args[1], args[2]))
        return Ok(mmap(args[0], args[1]))
    if name == "munmap":
        # munmap(bytes) → bool（显式解除映射）
        if len(args) != 1:
            return Err(i_r1002("munmap 需要一个 mmap bytes 参数", pos))
        return Ok(munmap(args[0]))
    if name == "mem_write":
        # mem_write(mmap_bytes, offset, data) → int（就地写映射区）
        if len(args) != 3:
            return Err(i_r1002("mem_write 需要 (mmap_bytes, offset, data)", pos))
        return Ok(mem_write(args[0], args[1], args[2]))
    if name == "http_unix":
        # M56：http_unix(sock_path, url_path, method[, body[, headers]]) → dict
        if len(args) < 3 or len(args) > 5:
            return Err(i_r1002("http_unix 需要 (sock_path, url_path, method[, body[, headers]])", pos))
        if len(args) == 3:
            return Ok(http_unix(args[0], args[1], args[2]))
        if len(args) == 4:
            return Ok(http_unix(args[0], args[1], args[2], args[3]))
        return Ok(http_unix(args[0], args[1], args[2], args[3], args[4]))
    # ---- M63-L8: 网络真实应用补白名单（http_request 连接池 / S3 客户端） ----
    # Result 透传（i_call_c_net）：C 网络函数失败返回 Err("net: ...") result，不杀进程
    # （M57 语义），直接透传保失败路径双模式一致；成功返回普通值 Ok 包裹。
    if name == "http_post":
        # http_post(url, body) → 响应体字符串（支持 http/https，自动跟随重定向）
        if len(args) != 2:
            return Err(i_r1002("http_post 需要 (url, body) 参数", pos))
        return i_call_c_net(http_post(args[0], args[1]))
    if name == "http_request":
        # http_request(url, method[, body[, headers[, opts]]]) → dict{status,headers,body}
        if len(args) < 2 or len(args) > 5:
            return Err(i_r1002("http_request 需要 (url, method[, body[, headers[, opts]]]) 参数", pos))
        if len(args) == 2:
            return i_call_c_net(http_request(args[0], args[1]))
        if len(args) == 3:
            return i_call_c_net(http_request(args[0], args[1], args[2]))
        if len(args) == 4:
            return i_call_c_net(http_request(args[0], args[1], args[2], args[3]))
        return i_call_c_net(http_request(args[0], args[1], args[2], args[3], args[4]))
    if name == "s3_get":
        # s3_get(endpoint, bucket, key, ak, sk) → body（200）| null（非200）
        if len(args) != 5:
            return Err(i_r1002("s3_get 需要 (endpoint, bucket, key, ak, sk) 参数", pos))
        return i_call_c_net(s3_get(args[0], args[1], args[2], args[3], args[4]))
    if name == "s3_put":
        # s3_put(endpoint, bucket, key, data, ak, sk) → bool
        if len(args) != 6:
            return Err(i_r1002("s3_put 需要 (endpoint, bucket, key, data, ak, sk) 参数", pos))
        return i_call_c_net(s3_put(args[0], args[1], args[2], args[3], args[4], args[5]))
    if name == "s3_list":
        # s3_list(endpoint, bucket, prefix, ak, sk) → list<key>
        if len(args) != 5:
            return Err(i_r1002("s3_list 需要 (endpoint, bucket, prefix, ak, sk) 参数", pos))
        return i_call_c_net(s3_list(args[0], args[1], args[2], args[3], args[4]))
    if name == "s3_delete":
        # s3_delete(endpoint, bucket, key, ak, sk) → bool
        if len(args) != 5:
            return Err(i_r1002("s3_delete 需要 (endpoint, bucket, key, ak, sk) 参数", pos))
        return i_call_c_net(s3_delete(args[0], args[1], args[2], args[3], args[4]))
    # ---- M60-S1/S2 边缘设备（us 级时钟 + fd 控制 + 设备组；直接转发 runtime C builtin） ----
    # 语义对齐 M60-PLAN §3.3：参数错误 → Err（解释器不杀进程，区别于编译模式 px_error）；
    # 设备失败 -1/false + os_errno() 透传（与 M57 fd 原语一致，不包装）。
    if name == "sleep_us":
        # sleep_us(us) → null（us 级睡眠，<=0 不睡）
        if len(args) != 1:
            return Err(i_r1002("sleep_us 需要 1 个参数（微秒）", pos))
        sleep_us(args[0])
        return Ok(null)
    if name == "now_us":
        # now_us() → int（CLOCK_MONOTONIC 微秒，测量语义）
        if len(args) != 0:
            return Err(i_r1002("now_us 不需要参数", pos))
        return Ok(now_us())
    if name == "fcntl":
        # fcntl(fd, cmd[, arg]) → int（标准 fcntl；失败 -1 + os_errno）
        if len(args) < 2 or len(args) > 3:
            return Err(i_r1002("fcntl 需要 (fd, cmd[, arg])", pos))
        if len(args) == 3:
            return Ok(fcntl(args[0], args[1], args[2]))
        return Ok(fcntl(args[0], args[1]))
    if name == "tty_config":
        # tty_config(fd, baud, raw) → bool（串口 termios 波特率/raw）
        if len(args) != 3:
            return Err(i_r1002("tty_config 需要 (fd, baud, raw)", pos))
        return Ok(tty_config(args[0], args[1], args[2]))
    if name == "fd_wait":
        # fd_wait(fds, timeout_ms) → list<就绪 fd>（空=超时）| int -1（poll 错误）
        if len(args) != 2:
            return Err(i_r1002("fd_wait 需要 (fds, timeout_ms)", pos))
        return Ok(fd_wait(args[0], args[1]))
    return Err(i_r1002("未知内置函数: " + name, pos))

# ---- M59-S4 数学直调 helper（双模式对齐） ----
# 解释器参数错误返回 Err（不终止进程，区别于编译模式 px_error 终止）；
# 参数合法后直调同名 runtime C builtin（pxi 宿主已注册全部 M59 数学内置）。
def i_math_unary(cname, args, pos):
    if len(args) != 1:
        return Err(i_r1002(cname + " 需要 1 个参数", pos))
    let t = i_type_name(args[0])
    if t != "int" and t != "float":
        return Err(i_r1002(cname + " 参数必须是数字，实际是 " + t, pos))
    if cname == "sqrt":
        return Ok(sqrt(args[0]))
    if cname == "sin":
        return Ok(sin(args[0]))
    if cname == "cos":
        return Ok(cos(args[0]))
    if cname == "tan":
        return Ok(tan(args[0]))
    if cname == "floor":
        return Ok(floor(args[0]))
    if cname == "ceil":
        return Ok(ceil(args[0]))
    if cname == "round":
        return Ok(round(args[0]))
    if cname == "log":
        return Ok(log(args[0]))
    if cname == "log10":
        return Ok(log10(args[0]))
    return Ok(exp(args[0]))

def i_math_atan2(args, pos):
    if len(args) != 2:
        return Err(i_r1002("atan2 需要 2 个参数（先 y 后 x）", pos))
    var i = 0
    while i < 2:
        let t = i_type_name(args[i])
        if t != "int" and t != "float":
            return Err(i_r1002("atan2 参数必须是数字，实际是 " + t, pos))
        i += 1
    return Ok(atan2(args[0], args[1]))

def i_math_random(args, pos):
    if len(args) != 0:
        return Err(i_r1002("random 不需要参数", pos))
    return Ok(random())

def i_math_random_int(args, pos):
    if len(args) != 1:
        return Err(i_r1002("random_int 需要 1 个参数 n（正整数）", pos))
    if i_type_name(args[0]) != "int":
        return Err(i_r1002("random_int 的 n 需要 int", pos))
    if args[0] <= 0:
        return Err(i_r1002("random_int 的 n 必须 > 0，实际是 " + i_to_str(args[0]), pos))
    return Ok(random_int(args[0]))

def i_math_random_seed(args, pos):
    if len(args) != 1:
        return Err(i_r1002("random_seed 需要 1 个整数参数（种子）", pos))
    if i_type_name(args[0]) != "int":
        return Err(i_r1002("random_seed 的种子需要 int", pos))
    random_seed(args[0])
    return Ok(null)

# M42：FFI 调用（extern def 走 C 桥）
# args: [name(str), fn_args(list)] → ffi_call(name, args_list) → runtime 注册的 C 绑定
# 双模式统一：编译模式 codegen 生成 px_call(px_get_global("ffi_call"), ...)，
# 解释模式经此函数转发到同一 C 桥（pxi 已链 runtime_ffi.c）。
def i_builtin_ffi_call(args, pos):
    if len(args) != 2:
        return Err(i_r1002("ffi_call 需要 (name, args_list) 参数", pos))
    if type(args[0]) != "string":
        return Err(i_r1002("ffi_call 的 name 需要字符串", pos))
    if type(args[1]) != "list":
        return Err(i_r1002("ffi_call 的 args 需要列表", pos))
    return Ok(ffi_call(args[0], args[1]))

# ---------- len（对齐 builtin.rs Len） ----------
def i_builtin_len(args, pos):
    if len(args) != 1:
        return Err(i_r1002("len 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t == "string":
        return Ok(len(args[0]))
    if t == "list" or t == "tuple":
        return Ok(len(args[0]))
    if t == "dict":
        return Ok(len(args[0].keys()))
    if t == "generator":
        return Ok(len(args[0]["__gen__"]))
    if t == "bytes":
        return Ok(len(args[0]))
    if t == "range":
        return Ok(len(list(args[0])))
    return Err(i_r1002("len 不支持类型 " + t, pos))

# ---------- int（对齐 builtin.rs Int） ----------
def i_builtin_int(args, pos):
    if len(args) != 1:
        return Err(i_r1002("int 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t == "int":
        return Ok(args[0])
    if t == "float":
        return Ok(int(args[0]))
    if t == "bool":
        if args[0]:
            return Ok(1)
        return Ok(0)
    if t == "string":
        let s = args[0].trim()
        if s == "":
            return Err(i_r1002("无法将 '" + args[0] + "' 转为 int", pos))
        let n = int(s)
        return Ok(n)
    return Err(i_r1002("int 不支持此类型", pos))

# ---------- float（对齐 builtin.rs Float） ----------
def i_builtin_float(args, pos):
    if len(args) != 1:
        return Err(i_r1002("float 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t == "int":
        return Ok(float(args[0]))
    if t == "float":
        return Ok(args[0])
    if t == "string":
        let s = args[0].trim()
        let f = float(s)
        return Ok(f)
    return Err(i_r1002("float 不支持此类型", pos))

# ---------- range（对齐 builtin.rs Range） ----------
def i_builtin_range(args, pos):
    var start = 0
    var end = 0
    var step = 1
    if len(args) == 1:
        end = args[0]
    elif len(args) == 2:
        start = args[0]
        end = args[1]
    elif len(args) == 3:
        start = args[0]
        end = args[1]
        step = args[2]
    else:
        return Err(i_r1002("range 需要 1-3 个参数", pos))
    if type(start) != "int" or type(end) != "int" or type(step) != "int":
        return Err(i_r1002("range 参数需要整数", pos))
    if step == 0:
        return Err(i_r1006("range step 不能为 0", pos))
    return Ok(range(start, end, step))

# ---------- sorted（对齐 builtin.rs Sorted：按 to_string 排序） ----------
def i_builtin_sorted(args, pos):
    if len(args) != 1:
        return Err(i_r1002("sorted 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t != "list" and t != "tuple":
        return Err(i_r1002("sorted 参数需要 list/tuple", pos))
    let items = []
    var i = 0
    while i < len(args[0]):
        items.append(args[0][i])
        i += 1
    let n = len(items)
    var ii = 0
    while ii < n:
        var j = 0
        while j < n - 1 - ii:
            if i_to_str(items[j]) > i_to_str(items[j + 1]):
                let tmp = items[j]
                items[j] = items[j + 1]
                items[j + 1] = tmp
            j += 1
        ii += 1
    return Ok(items)

# ---------- reversed（对齐 builtin.rs Reversed） ----------
def i_builtin_reversed(args, pos):
    if len(args) != 1:
        return Err(i_r1002("reversed 需要一个参数", pos))
    let t = i_type_name(args[0])
    let items = []
    if t == "list" or t == "tuple":
        var i = 0
        while i < len(args[0]):
            items.append(args[0][i])
            i += 1
    elif t == "string":
        var i = 0
        while i < len(args[0]):
            items.append(args[0][i])
            i += 1
    else:
        return Err(i_r1002("reversed 参数类型不支持", pos))
    let n = len(items)
    let out = []
    var i = n - 1
    while i >= 0:
        out.append(items[i])
        i -= 1
    return Ok(out)

# ---------- sum（对齐 builtin.rs Sum：从 0 累加） ----------
def i_builtin_sum(args, pos):
    if len(args) != 1:
        return Err(i_r1002("sum 需要一个参数", pos))
    let t = i_type_name(args[0])
    if t != "list" and t != "tuple":
        return Err(i_r1002("sum 参数需要 list/tuple", pos))
    var acc = 0
    var i = 0
    while i < len(args[0]):
        let r = i_bin_add(acc, args[0][i], pos)
        if r.is_err():
            return Err(r.err())
        acc = r.unwrap()
        i += 1
    return Ok(acc)

# ---------- map（对齐 builtin Map：f(x) 收集） ----------
def i_builtin_map(args, pos):
    if len(args) != 2:
        return Err(i_r1002("map 需要 (列表, 函数) 两个参数", pos))
    let out = []
    var i = 0
    while i < len(args[0]):
        let r = i_call_value(args[1], [args[0][i]], pos)
        if r.is_err():
            return Err(r.err())
        out.append(r.unwrap())
        i += 1
    return Ok(out)

# ---------- filter（对齐 builtin Filter：f(x) 真值保留） ----------
def i_builtin_filter(args, pos):
    if len(args) != 2:
        return Err(i_r1002("filter 需要 (列表, 函数) 两个参数", pos))
    let out = []
    var i = 0
    while i < len(args[0]):
        let r = i_call_value(args[1], [args[0][i]], pos)
        if r.is_err():
            return Err(r.err())
        if i_truthy(r.unwrap()):
            out.append(args[0][i])
        i += 1
    return Ok(out)

# ---------- reduce（对齐 builtin Reduce：二元折叠） ----------
def i_builtin_reduce(args, pos):
    if len(args) < 2 or len(args) > 3:
        return Err(i_r1002("reduce 需要 (列表, 函数, [初始值])", pos))
    let lst = args[0]
    if len(lst) == 0:
        return Ok(null)
    var acc = 0
    if len(args) >= 3:
        acc = args[2]
    var i = 0
    while i < len(lst):
        let r = i_call_value(args[1], [acc, lst[i]], pos)
        if r.is_err():
            return Err(r.err())
        acc = r.unwrap()
        i += 1
    return Ok(acc)
