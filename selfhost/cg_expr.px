# ============================================================
# M-B6: cg_expr.px —— 表达式生成（对齐 Rust codegen.gen_expr）
# ------------------------------------------------------------
# 被 codegen.px import；函数引用主文件全局状态。
# 推导式公共逻辑抽为 cg_comp_* 辅助（uid 消耗顺序与 Rust 一致）。
# ============================================================
# ---------- 推导式公共：收集 clauses（生成 iterable/迭代变量/绑定） ----------
def cg_comp_collect(clauses):
    let r = {"_": 0}
    r.remove("_")
    r["its"] = []
    r["ivs"] = []
    r["itms"] = []
    r["idxs"] = []
    r["binds"] = []
    r["saved_all"] = []
    var ci = 0
    while ci < len(clauses):
        let cl = clauses[ci]
        let it = cg_gen_expr(cl[2])
        r["its"].append(it)
        r["ivs"].append(cg_tmp())
        r["itms"].append(cg_tmp())
        r["idxs"].append(cg_tmp())
        var bind = ""
        let saved = []
        if len(cl[1]) == 1:
            let lcvar = "_cv" + str(cg_uid())
            let vn = rust_unescape(cl[1][0])
            var sv = null
            if cg_vars.has(vn):
                sv = cg_vars[vn]
            cg_vars[vn] = lcvar
            if cg_cells.has(vn):
                cg_cells.remove(vn)
            saved.append([vn, sv])
            bind = "LXValue " + lcvar + " = " + r["itms"][len(r["itms"]) - 1] + "; "
        else:
            var vi = 0
            while vi < len(cl[1]):
                let vn = rust_unescape(cl[1][vi])
                let lcvar = "_cv" + str(cg_uid()) + "_" + str(vi)
                var sv = null
                if cg_vars.has(vn):
                    sv = cg_vars[vn]
                cg_vars[vn] = lcvar
                if cg_cells.has(vn):
                    cg_cells.remove(vn)
                saved.append([vn, sv])
                bind += "LXValue " + lcvar + " = px_index(" + r["itms"][len(r["itms"]) - 1] + ", px_int(" + str(vi) + ")); "
                vi += 1
        r["binds"].append(bind)
        r["saved_all"].append(saved)
        ci += 1
    return r
def cg_comp_restore(saved_all):
    var i = 0
    while i < len(saved_all):
        let saved = saved_all[i]
        var j = 0
        while j < len(saved):
            let vn = saved[j][0]
            var sv = saved[j][1]
            if sv == null:
                cg_vars.remove(vn)
            else:
                cg_vars[vn] = sv
            j += 1
        i += 1
# 组装嵌套循环（从内到外）；put 是每层迭代体
def cg_comp_body(r, cond_c, put):
    var body = ""
    if cond_c != null:
        body = "if (px_is_truthy(" + cond_c + ")) { " + put + "} "
    else:
        body = put
    let n = len(r["its"])
    var i = n - 1
    while i >= 0:
        var inner_decl = ""
        if i + 1 < n:
            inner_decl = "LXValue " + r["ivs"][i + 1] + " = " + r["its"][i + 1] + "; "
        # M164（缺陷 170）：推导式展开的**迭代**步走 px_iter_at（dict 推导 `{k: d[k] for k in d}`
        #   需要「第 i 个键」）；内层解包（itms/字段）仍走 px_index（那是用户语义的索引）。
        # M166（缺陷 176）：迭代源长度**进入该层时快照**（for 初始化子句内取一次），循环体开头
        #   复核 ⇒ 迭代期间长度变化报 R1003（与 for 语句 / VM 轨 / 解释轨同一条真相）。
        let lv = cg_iter_len_tmp()
        body = "for (int " + lv + " = (int)px_len(" + r["ivs"][i] + "), " + r["idxs"][i] + "=0; " + r["idxs"][i] + "<" + lv + "; " + r["idxs"][i] + "++) { px_iter_ck(" + r["ivs"][i] + ", " + lv + "); LXValue " + r["itms"][i] + " = px_iter_at(" + r["ivs"][i] + ", px_int(" + r["idxs"][i] + ")); " + r["binds"][i] + inner_decl + body + " } "
        i -= 1
    return body
# ---------- 表达式生成 ----------
# ---------- M160（缺陷 160）：闭包 / 函数体内 def 的统一发射 ----------
# params/body = 形参与函数体；dispname = 函数值名（匿名 "<closureN>" / 具名 def 的名字）。
# 捕获规则（对齐解释轨 env 链、C 轨 M129 cell）：自由变量 ∩ 当前帧局部 = 捕获集，
#   捕获按**引用**（cell）：外层把该局部装箱，闭包共享同一个 cell。
def cg_gen_closure(params, body, dispname):
    cg_closure_id = cg_closure_id + 1
    let cid = cg_closure_id
    let fnname = "fn_closure_" + str(cid)
    # M129（缺陷 21）：自由变量 ∩ 当前帧局部 = 本次捕获集（**必须先于清空 cg_vars 求**）
    let cap_free = []
    cg_closure_caps(["Closure", params, null, body, [], null], cap_free)
    let caps = []
    for cn in cap_free:
        if cg_var_of(cn) != null:
            caps.append(cn)
    # env 构造表达式（在**外层**作用域求值，读的是外层 cell 变量）
    var env_expr = "px_null()"
    if len(caps) > 0:
        var ee = "({ LXValue _capenv = px_dict(); "
        for cn in caps:
            let cv = cg_var_of(cn)
            # 外层已是 cell → 直接共享该 cell（引用语义）；否则按值新建 cell
            #   （仅当"闭包体里的局部又被内层闭包捕获"这类未支持场景才会走到）
            if cg_cells.has(cn):
                ee += "px_dict_set(_capenv, \"" + cn + "\", " + cv + "); "
            else:
                ee += "px_dict_set(_capenv, \"" + cn + "\", px_cell(" + cv + ")); "
        ee += "_capenv; })"
        env_expr = ee
    var fdef = "static LXValue " + fnname + "(LXValue* args, int nargs, void* ctx) {\n"
    if len(caps) > 0:
        fdef += "    (void)nargs;\n"
    else:
        fdef += "    (void)ctx;\n"
    let saved_vars = cg_dict_copy(cg_vars)
    let saved_types = cg_dict_copy(cg_var_types)
    let saved_cells = cg_dict_copy(cg_cells)
    cg_vars = cg_new_dict()
    cg_var_types = cg_new_dict()
    cg_cells = cg_new_dict()
    var pi = 0
    while pi < len(params):
        let v = cg_new_var(rust_unescape(params[pi][1]))
        fdef += "    LXValue " + v + " = (nargs > " + str(pi) + ") ? args[" + str(pi) + "] : px_null();\n"
        pi += 1
    # 捕获名：闭包体内各绑定一个同名的**新 C 变量**持 cell，并标记为 cell
    for cn in caps:
        let cv2 = cg_new_var(cn)
        cg_cells[cn] = 1
        fdef += "    LXValue " + cv2 + " = px_env_lookup(ctx, \"" + cn + "\");\n"
    let b = cg_gen_expr(body)
    fdef += "    return " + b + ";\n"
    fdef += "}\n"
    cg_closures += fdef
    cg_vars = saved_vars
    cg_var_types = saved_types
    cg_cells = saved_cells
    # M129b（缺陷 54）：**无捕获**的闭包沿用 `px_func(..., NULL)` —— 不必建 env、
    #   不必让 ctx 指向自身 env 字段（省一次字段写 + 与既有 golden 形式一致：
    #   仅"确有捕获"的闭包才需要 px_func_env 携带 upvalue cell）。
    if len(caps) > 0:
        return "px_func_env(\"" + dispname + "\", " + fnname + ", " + env_expr + ")"
    return "px_func(\"" + dispname + "\", " + fnname + ", NULL)"
# M160：cg_gen_closure 与下方 cg_gen_expr 之间不留空行（pxfmt 口径）—— 行号刻意不动
# ---------- M165（第 51 轮 · 缺陷 178）：C 轨实参求值顺序 = 左→右 ----------
# C 标准**不规定**函数实参求值顺序，gcc 实测为**右→左**；而解释轨（AST 序）与
#   VM 轨（字节码序）都是**左→右** ⇒ 同一个 C 表达式里出现 ≥2 个带副作用的操作数
#   就三轨分叉。实测（修前）：
#     · `"${f()}${g()}"`        → 解释/VM 轨 F,G；**C 轨 G,F**
#     · `f() + g()`             → 同上（px_add 的两实参）
#     · `str(l.pop()) + str(len(l))` → C 轨 len 先求 ⇒ 打印 len=3（解释/VM 轨 2）
#   语义裁定（对齐 **Go 规范**：函数/方法实参按**词法左→右**求值；C 未定义）：
#   一个 C 表达式里若 **≥2 个操作数含副作用**，按序把它们提升为临时变量
#   （语句表达式 `({ LXValue _tN = <src>; <最终表达式>; })`），纯操作数保留内联
#   （无副作用 ⇒ 相对顺序无关）。**只有 ≥2 个时才序列化** ⇒ 其余发射文本一字不变。
def cg_side_effect(x):
    if type(x) != "list" or len(x) == 0:
        return false
    let h = x[0]
    if type(h) == "string":
        if h == "Call" or h == "Pipe" or h == "ListComp" or h == "DictComp" or h == "GenExp":
            return true
        # ⚠️ Closure（lambda）：**创建**它不产生副作用，且体内表达式**此刻不求值**
        #   ⇒ 既不算副作用，也不能往下递归（否则会把体内 Call 误当副作用）。
        if h == "Closure":
            return false
    var i = 0
    while i < len(x):
        if cg_side_effect(x[i]):
            return true
        i += 1
    return false
# srcs = [C 源文本...]，imps = [是否含副作用...] ⇒ [decls, names]；<2 个副作用 ⇒ [null, null]
def cg_seq_operands(srcs, imps):
    var n = 0
    var i = 0
    while i < len(imps):
        if imps[i]:
            n += 1
        i += 1
    if n < 2:
        return [null, null]
    var decls = ""
    let names = []
    i = 0
    while i < len(srcs):
        if imps[i]:
            # ⚠️ 用**专用计数器**（`_sN`）而不是 cg_tmp()（`_tN`）：cg_tmp 是全局编号，
            #   若在这里消耗序号，后面所有 _tN 都会位移 ⇒ 发射文本大面积变化（与本次
            #   语义改动无关的行也被改动），冻结门/基准的差异面会失控。
            cg_seq_uid = cg_seq_uid + 1
            let t = "_s" + str(cg_seq_uid)
            decls = decls + "LXValue " + t + " = " + srcs[i] + "; "
            names.append(t)
        else:
            names.append(srcs[i])
        i += 1
    return [decls, names]
# 便捷：nodes = [AST...]，parts = [C 源文本...] ⇒ [decls, names]
#   ⚠️ names 是**逐操作数的文本列表**（不是 join 后的串）—— 有的站点把部分实参留在
#   列表外（`px_call(c, (LXValue[]){...}, n)` 的 c、`px_method(o, 名, {...}, n)` 的 o），
#   这类站点必须按下标取名字；只有「整个实参表都在 names 里」的站点才 join。
#   ⚠️ nodes 与 parts 必须**一一对应**。
def cg_seq_join(nodes, parts):
    let imps = []
    var i = 0
    while i < len(nodes):
        imps.append(cg_side_effect(nodes[i]))
        i += 1
    let sp = cg_seq_operands(parts, imps)
    if sp[0] == null:
        return [null, parts]
    return [sp[0], sp[1]]
# decls 非 null ⇒ 包成语句表达式（最后一条语句即值）
def cg_seq_wrap(decls, fin):
    if decls == null:
        return fin
    return "({ " + decls + fin + "; })"
def cg_gen_expr(expr):
    let ty = expr[0]
    if ty == "Int":
        return "px_int(" + str(expr[1]) + "LL)"
    if ty == "Float":
        return "px_float(" + cg_fmt_float(expr[1]) + ")"
    if ty == "Str":
        let sv = rust_unescape(expr[1])
        # M155（缺陷 148）：含 NUL 的常量改用长度精确的 `PX_STR_LIT`
        #   （`sizeof(lit)-1` 在 C 编译期给出**含内嵌 NUL 的**真字节长）；
        #   不含 NUL 的常量发射文本**一字不变**（emitc_freeze 门守）。
        if cg_has_nul(sv):
            return "PX_STR_LIT(\"" + cg_escape_str(sv) + "\")"
        return "px_str(\"" + cg_escape_str(sv) + "\")"
    if ty == "Bool":
        if expr[1]:
            return "px_bool(true)"
        return "px_bool(false)"
    if ty == "Null":
        return "px_null()"
    if ty == "List":
        let parts = []
        let items = expr[1]
        var i = 0
        while i < len(items):
            parts.append(cg_gen_expr(items[i]))
            i += 1
        let sj = cg_seq_join(items, parts)  # M165（缺陷 178）：≥2 个含副作用的元素 ⇒ 按序提升
        return cg_seq_wrap(sj[0], "px_list_n((LXValue[]){" + join(", ", sj[1]) + "}, " + str(len(parts)) + ")")
    if ty == "Tuple":
        let parts = []
        let items = expr[1]
        var i = 0
        while i < len(items):
            parts.append(cg_gen_expr(items[i]))
            i += 1
        let sj = cg_seq_join(items, parts)  # M165（缺陷 178）
        return cg_seq_wrap(sj[0], "px_tuple((LXValue[]){" + join(", ", sj[1]) + "}, " + str(len(parts)) + ")")
    if ty == "Dict":
        var s = "({ LXValue _d = px_dict(); "
        let entries = expr[1]
        var i = 0
        while i < len(entries):
            let ke = cg_gen_expr(entries[i][0])
            let ve = cg_gen_expr(entries[i][1])
            # M163（第 49 轮 · 缺陷 168）：非字符串键**不再静默丢弃** —— 走
            #   `px_dict_set_checked`（非字符串 ⇒ R1002「字典键必须是字符串，实际是 <t>」，与解释轨同词条）。
            #   保留「先求键、再求值、后置入」的**显式序列**（原 if 写法就是显式序列；
            #   C 的函数实参求值顺序未定义 ⇒ 不把两式并进一个调用）。
            s += "{ LXValue _k = " + ke + "; LXValue _v = " + ve + "; px_dict_set_checked(_d, _k, _v); } "
            i += 1
        s += "_d; })"
        return s
    if ty == "Var":
        let name = rust_unescape(expr[1])
        let v = cg_var_of(name)
        if v != null:
            # M129（缺陷 21）：本帧局部若是闭包捕获目标 → 已装箱成 cell，读须解引用
            return cg_load_of(name, v)
        return "px_get_global(\"" + name + "\")"
    if ty == "Field":
        let obj = expr[1]
        let fname = rust_unescape(expr[2])
        # M44：简化枚举 type X const 访问 LogLevel.Info → 绑定值（常量内联）
        if obj[0] == "Var":
            let oname = rust_unescape(obj[1])
            if cg_const_enums.has(oname) and cg_const_enums[oname].has(fname):
                return cg_const_enums[oname][fname]
        # enum 变体访问：Color.Red
        if obj[0] == "Var":
            let oname = rust_unescape(obj[1])
            if cg_enums.has(oname):
                return "px_enum(\"" + oname + "\", \"" + fname + "\")"
        let o = cg_gen_expr(obj)
        return "px_field(" + o + ", \"" + fname + "\")"
    if ty == "OptionalField":
        let o = cg_gen_expr(expr[1])
        let t = cg_tmp()
        let fname = rust_unescape(expr[2])
        return "({ LXValue " + t + " = " + o + "; px_is_null(" + t + ") ? px_null() : px_field(" + o + ", \"" + fname + "\"); })"
    if ty == "Index":
        let o = cg_gen_expr(expr[1])
        var i = cg_gen_expr(expr[2])
        let sj = cg_seq_join([expr[1], expr[2]], [o, i])  # M165（缺陷 178）
        return cg_seq_wrap(sj[0], "px_index(" + sj[1][0] + ", " + sj[1][1] + ")")
    if ty == "Slice":
        let o = cg_gen_expr(expr[1])
        var s = "px_null()"
        if expr[2] != null:
            s = cg_gen_expr(expr[2])
        var e = "px_null()"
        if expr[3] != null:
            e = cg_gen_expr(expr[3])
        var k = "px_null()"
        if expr[4] != null:
            k = cg_gen_expr(expr[4])
        let sj = cg_seq_join([expr[1], expr[2], expr[3], expr[4]], [o, s, e, k])  # M165（缺陷 178）
        return cg_seq_wrap(sj[0], "px_slice(" + sj[1][0] + ", " + sj[1][1] + ", " + sj[1][2] + ", " + sj[1][3] + ")")
    if ty == "Call":
        let callee = expr[1]
        let args = expr[2]
        if callee[0] == "Var":
            let cname = rust_unescape(callee[1])
            # M42：extern def → FFI 调用（统一走 ffi_call C 桥，双模式一致）
            # M112-S0（Issue 46）：E3004 移交共享语义层（VM 轨同一条）
            cg_sem_call(callee, args)
            if cg_ffi.has(cname):
                let decl_params = cg_ffi[cname]
                let parts = []
                var ai = 0
                while ai < len(args):
                    parts.append(cg_gen_expr(args[ai]))
                    ai += 1
                let sj = cg_seq_join(args, parts)  # M165（缺陷 178）
                return cg_seq_wrap(sj[0], "px_call(px_get_global(\"ffi_call\"), (LXValue[]){px_str(\"" + cname + "\"), px_list_n((LXValue[]){" + join(", ", sj[1]) + "}, " + str(len(parts)) + ")}, 2)")
            if cname == "chan":
                var cap = "0"
                if len(args) > 0:
                    if args[0][0] == "Int":
                        cap = str(args[0][1])
                    else:
                        cap = "(int)(" + cg_gen_expr(args[0]) + ").as.i"
                return "px_chan_create(" + cap + ")"
            if cname == "mutex":
                return "px_mutex_create()"
            if cname == "rwlock":
                return "px_rwlock_create()"
            # 结构体/枚举构造
            if cg_structs.has(cname):
                let fields = cg_structs[cname]
                if len(fields) != len(args):
                    return "结构体 " + cname + " 需要 " + str(len(fields)) + " 个字段，给出 " + str(len(args))
                let parts = []
                var ai = 0
                while ai < len(args):
                    parts.append(cg_gen_expr(args[ai]))
                    ai += 1
                let fnames = []
                var fi = 0
                while fi < len(fields):
                    fnames.append("\"" + fields[fi] + "\"")
                    fi += 1
                let sj = cg_seq_join(args, parts)  # M165（缺陷 178）
                return cg_seq_wrap(sj[0], "px_struct(\"" + cname + "\", (char*[]){" + join(", ", fnames) + "}, (LXValue[]){" + join(", ", sj[1]) + "}, " + str(len(fields)) + ")")
            if cg_enums.has(cname):
                if len(args) != 1:
                    return "枚举 " + cname + " 构造需要一个变体名"
                let v = cg_gen_expr(args[0])
                return "px_enum(\"" + cname + "\", (" + v + ").as.obj->as.enum_inst.variant)"
        # 方法调用
        if callee[0] == "Field":
            let obj = callee[1]
            let mname = rust_unescape(callee[2])
            # 静态分派：已知类型 + impl 方法
            var static_type = null
            if obj[0] == "Var":
                let oname = rust_unescape(obj[1])
                if cg_var_types.has(oname):
                    static_type = cg_var_types[oname]
            if static_type != null and cg_impls.has(static_type):
                let methods = cg_impls[static_type]
                var has_m = false
                var mi = 0
                while mi < len(methods):
                    if rust_unescape(methods[mi][1]) == mname:
                        has_m = true
                        break
                    mi += 1
                if has_m:
                    let o = cg_gen_expr(obj)
                    let parts = [o]
                    let nodes = [obj]  # M165（缺陷 178）：与 parts 同序（词法左→右）
                    var ai = 0
                    while ai < len(args):
                        parts.append(cg_gen_expr(args[ai]))
                        nodes.append(args[ai])
                        ai += 1
                    let fnname = "fn_" + cg_func_cname(static_type) + "_" + cg_func_cname(mname)
                    let sj = cg_seq_join(nodes, parts)
                    return cg_seq_wrap(sj[0], fnname + "((LXValue[]){" + join(", ", sj[1]) + "}, " + str(len(parts)) + ", NULL)")
            # 运行时方法分派
            # M165（缺陷 178）：接收者**词法上最先** ⇒ 与实参一起进序列化表（nodes/parts 一一对应），
            #   但 `(LXValue[])` 实参数组只放 names[1:]（接收者是 px_method 的第 1 个参数）。
            let o = cg_gen_expr(obj)
            let parts = [o]
            let nodes = [obj]
            var ai = 0
            while ai < len(args):
                parts.append(cg_gen_expr(args[ai]))
                nodes.append(args[ai])
                ai += 1
            let sj = cg_seq_join(nodes, parts)
            return cg_seq_wrap(sj[0], "px_method(" + sj[1][0] + ", \"" + mname + "\", (LXValue[]){" + join(", ", sj[1][1:]) + "}, " + str(len(args)) + ")")
        # 普通调用
        # M165（缺陷 178）：被调方**词法上最先** ⇒ 与实参一起进序列化表（nodes/parts 一一对应），
        #   但 `(LXValue[])` 实参数组只放 names[1:]（被调方是 px_call 的第 1 个参数）。
        let c = cg_gen_expr(callee)
        let parts = [c]
        let nodes = [callee]
        var ai = 0
        while ai < len(args):
            parts.append(cg_gen_expr(args[ai]))
            nodes.append(args[ai])
            ai += 1
        let sj = cg_seq_join(nodes, parts)
        return cg_seq_wrap(sj[0], "px_call(" + sj[1][0] + ", (LXValue[]){" + join(", ", sj[1][1:]) + "}, " + str(len(args)) + ")")
    if ty == "Unary":
        let o = cg_gen_expr(expr[2])
        let op = expr[1]
        if op == "Neg":
            return "px_neg(" + o + ")"
        if op == "Not":
            return "px_not(" + o + ")"
        return "px_bitnot(" + o + ")"
    if ty == "Binary":
        let l = cg_gen_expr(expr[2])
        let r = cg_gen_expr(expr[3])
        let op = expr[1]
        if op == "And":
            let t = cg_tmp()
            return "({ LXValue " + t + " = " + l + "; px_is_truthy(" + t + ") ? " + r + " : " + t + "; })"
        if op == "Or":
            let t = cg_tmp()
            return "({ LXValue " + t + " = " + l + "; px_is_truthy(" + t + ") ? " + t + " : " + r + "; })"
        let f = cg_binop_cname(op)
        let sj = cg_seq_join([expr[2], expr[3]], [l, r])  # M165（缺陷 178）：两侧都含副作用 ⇒ 按序提升
        return cg_seq_wrap(sj[0], f + "(" + sj[1][0] + ", " + sj[1][1] + ")")
    if ty == "Pipe":
        let v = cg_gen_expr(expr[1])
        let func = expr[2]
        if func[0] == "Call":
            let c = cg_gen_expr(func[1])
            let parts = [v]
            let nodes = [expr[1]]  # M165（缺陷 178）
            var ai = 0
            while ai < len(func[2]):
                parts.append(cg_gen_expr(func[2][ai]))
                nodes.append(func[2][ai])
                ai += 1
            let sj = cg_seq_join(nodes, parts)
            return cg_seq_wrap(sj[0], "px_call(" + c + ", (LXValue[]){" + join(", ", sj[1]) + "}, " + str(len(parts)) + ")")
        let f = cg_gen_expr(func)
        let sj = cg_seq_join([expr[1], expr[2]], [v, f])
        return cg_seq_wrap(sj[0], "px_call(" + sj[1][1] + ", (LXValue[]){" + sj[1][0] + "}, 1)")
    if ty == "NullCoalesce":
        let l = cg_gen_expr(expr[1])
        let r = cg_gen_expr(expr[2])
        let t = cg_tmp()
        return "({ LXValue " + t + " = " + l + "; px_is_null(" + t + ") ? " + r + " : " + t + "; })"
    if ty == "Try":
        var e = cg_gen_expr(expr[1])
        let t = cg_tmp()
        if len(cg_err_labels) > 0:
            let tag = cg_err_labels[len(cg_err_labels) - 1]
            return "({ LXValue " + t + " = " + e + "; if (px_is_result(" + t + ")) { if (!px_result_ok(" + t + ")) { " + tag + "_val = " + t + "; " + tag + "_proped = 1; goto " + tag + "; } " + t + " = px_result_unwrap(" + t + "); } else if (px_is_null(" + t + ")) { " + tag + "_val = px_null(); " + tag + "_proped = 1; goto " + tag + "; } " + t + "; })"
        return "({ LXValue " + t + " = " + e + "; if (px_is_result(" + t + ") && !px_result_ok(" + t + ")) px_error(\"错误传播 ?: 顶层不能传播 Err\"); if (px_is_null(" + t + ")) px_error(\"错误传播 ?: 顶层不能传播 null\"); if (px_is_result(" + t + ")) " + t + " = px_result_unwrap(" + t + "); " + t + "; })"
    if ty == "ForceUnwrap":
        var e = cg_gen_expr(expr[1])
        let t = cg_tmp()
        return "({ LXValue " + t + " = " + e + "; if (px_is_result(" + t + ")) { if (!px_result_ok(" + t + ")) px_error(\"force unwrap Err\"); " + t + " = px_result_unwrap(" + t + "); } if (px_is_null(" + t + ")) px_error(\"force unwrap null\"); " + t + "; })"
    if ty == "IfExpr":
        let c = cg_gen_expr(expr[1])
        let a = cg_gen_expr(expr[2])
        let b = cg_gen_expr(expr[3])
        let t = cg_tmp()
        return "({ LXValue " + t + "; if (px_is_truthy(" + c + ")) { " + t + " = " + a + "; } else { " + t + " = " + b + "; } " + t + "; })"
    if ty == "ListComp":
        let rv = cg_tmp()
        let r = cg_comp_collect(expr[2])
        var e = cg_gen_expr(expr[1])
        var cond_c = null
        if expr[3] != null:
            cond_c = cg_gen_expr(expr[3])
        cg_comp_restore(r["saved_all"])
        let put = "px_list_push(" + rv + ", " + e + "); "
        var body = cg_comp_body(r, cond_c, put)
        return "({ LXValue " + rv + " = px_list(0); LXValue " + r["ivs"][0] + " = " + r["its"][0] + "; " + body + " " + rv + "; })"
    if ty == "GenExp":
        let clauses = expr[2]
        if len(clauses) == 1 and len(clauses[0][1]) == 1:
            let xname = rust_unescape(clauses[0][1][0])
            let seq_val = cg_gen_expr(clauses[0][2])
            let transform_val = cg_gen_lambda([xname], expr[1])
            var filter_val = "px_null()"
            if expr[3] != null:
                filter_val = cg_gen_lambda([xname], expr[3])
            return "px_gen_lazy(" + seq_val + ", " + transform_val + ", " + filter_val + ")"
        # M32 物化路径
        let rv = cg_tmp()
        let r = cg_comp_collect(clauses)
        var e = cg_gen_expr(expr[1])
        var cond_c = null
        if expr[3] != null:
            cond_c = cg_gen_expr(expr[3])
        cg_comp_restore(r["saved_all"])
        let put = "px_list_push(" + rv + ", " + e + "); "
        var body = cg_comp_body(r, cond_c, put)
        return "({ LXValue " + rv + " = px_list(0); LXValue " + r["ivs"][0] + " = " + r["its"][0] + "; " + body + " px_gen_from_list(" + rv + "); })"
    if ty == "DictComp":
        let rv = cg_tmp()
        let r = cg_comp_collect(expr[3])
        let ke = cg_gen_expr(expr[1])
        let ve = cg_gen_expr(expr[2])
        var cond_c = null
        if expr[4] != null:
            cond_c = cg_gen_expr(expr[4])
        cg_comp_restore(r["saved_all"])
        let put = "{ LXValue _k = " + ke + "; LXValue _v = " + ve + "; px_dict_set_checked(" + rv + ", _k, _v); } "
        var body = cg_comp_body(r, cond_c, put)
        return "({ LXValue " + rv + " = px_dict(); LXValue " + r["ivs"][0] + " = " + r["its"][0] + "; " + body + " " + rv + "; })"
    if ty == "Closure":
        # M160（缺陷 160）：发射逻辑抽到 cg_gen_closure —— 与「函数体内 def」共用同一条
        #   真相（同一份自由变量分析 + 同一份 cell 捕获协议）。dispname 取本次将分配的 id。
        return cg_gen_closure(expr[1], expr[3], "<closure" + str(cg_closure_id + 1) + ">")
    if ty == "Block":
        var s = "({ "
        s += "LXValue _blk = px_null(); "
        let stmts = expr[1]
        var si = 0
        while si < len(stmts):
            let st = stmts[si]
            if st[0] == "ExprStmt":
                var e = cg_gen_expr(st[1])
                s += "_blk = " + e + "; "
            else:
                s += cg_gen_stmt(st, 0)
            si += 1
        s += "_blk; })"
        return s
    if ty == "Match":
        let sub = cg_gen_expr(expr[1])
        let t = cg_tmp()
        var s = "({ LXValue " + t + " = " + sub + "; "
        let arms = expr[2]
        var first = true
        var ai = 0
        while ai < len(arms):
            var cond_c = cg_gen_pattern_cond(arms[ai][1], t)
            let body_c = cg_gen_expr(arms[ai][3])
            var kw = "if"
            if not first:
                kw = "else if"
            s += kw + " (" + cond_c + ") { " + t + " = " + body_c + "; } "
            first = false
            ai += 1
        s += t + "; })"
        return s
    if ty == "Constructor":
        let name = rust_unescape(expr[1])
        let args = expr[2]
        if cg_structs.has(name):
            let fields = cg_structs[name]
            if len(fields) != len(args):
                return "结构体 " + name + " 需要 " + str(len(fields)) + " 个字段，给出 " + str(len(args))
            let parts = []
            var ai = 0
            while ai < len(args):
                parts.append(cg_gen_expr(args[ai]))
                ai += 1
            let fnames = []
            var fi = 0
            while fi < len(fields):
                fnames.append("\"" + fields[fi] + "\"")
                fi += 1
            let sj = cg_seq_join(args, parts)  # M165（缺陷 178）
            return cg_seq_wrap(sj[0], "px_struct(\"" + name + "\", (char*[]){" + join(", ", fnames) + "}, (LXValue[]){" + join(", ", sj[1]) + "}, " + str(len(fields)) + ")")
        if cg_enums.has(name):
            if len(args) != 1:
                return "枚举 " + name + " 构造需要一个变体名"
            let v = cg_gen_expr(args[0])
            return "px_enum(\"" + name + "\", (" + v + ").as.obj->as.enum_inst.variant)"
        let parts = []
        var ai = 0
        while ai < len(args):
            parts.append(cg_gen_expr(args[ai]))
            ai += 1
        let sj = cg_seq_join(args, parts)  # M165（缺陷 178）
        return cg_seq_wrap(sj[0], "px_call(px_get_global(\"" + name + "\"), (LXValue[]){" + join(", ", sj[1]) + "}, " + str(len(parts)) + ")")
    return "px_null()"
# ---------- 二元运算符 → C 函数 ----------
def cg_binop_cname(op):
    if op == "Add":
        return "px_add"
    if op == "Sub":
        return "px_sub"
    if op == "Mul":
        return "px_mul"
    if op == "Div":
        return "px_div"
    if op == "IntDiv":
        return "px_idiv"
    if op == "Mod":
        return "px_mod"
    if op == "Pow":
        return "px_pow"
    if op == "Eq":
        return "px_eq"
    if op == "Ne":
        return "px_ne"
    if op == "Lt":
        return "px_lt"
    if op == "Le":
        return "px_le"
    if op == "Gt":
        return "px_gt"
    if op == "Ge":
        return "px_ge"
    if op == "BitAnd":
        return "px_bitand"
    if op == "BitOr":
        return "px_bitor"
    if op == "BitXor":
        return "px_bitxor"
    if op == "Shl":
        return "px_shl"
    if op == "Shr":
        return "px_shr"
    if op == "ShrU":
        return "px_ushr"
    return "px_add"
# ---------- match 模式条件 ----------
def cg_gen_pattern_cond(pattern, subject):
    let pty = pattern[0]
    if pty == "PatLiteral":
        var e = cg_gen_expr(pattern[1])
        return "px_is_truthy(px_eq(" + subject + ", " + e + "))"
    if pty == "PatBinding":
        let name = rust_unescape(pattern[1])
        if len(name) > 0 and name[0] >= "A" and name[0] <= "Z":
            return "(" + subject + ".type == PX_ENUM && strcmp(" + subject + ".as.obj->as.enum_inst.variant, \"" + name + "\") == 0)"
        return "true"
    if pty == "PatWildcard":
        return "true"
    if pty == "PatTuple":
        let items = pattern[1]
        if len(items) > 0:
            return cg_gen_pattern_cond(items[0], subject)
        return "true"
    if pty == "PatConstructor":
        let name = rust_unescape(pattern[1])
        return "(" + subject + ".type == PX_ENUM && strcmp(" + subject + ".as.obj->as.enum_inst.variant, \"" + name + "\") == 0)"
    return "true"
# ---------- M34：无捕获闭包函数（生成器 transform/filter） ----------
def cg_gen_lambda(params, body):
    cg_closure_id = cg_closure_id + 1
    let cid = cg_closure_id
    let fnname = "fn_closure_" + str(cid)
    # M129（缺陷 21）：生成器 transform/filter 同样是闭包 —— 自由变量按 cell 捕获
    let lam_used = []
    cg_ast_used(body, lam_used)
    var caps = []
    for cn in lam_used:
        if not contains(params, cn) and cg_var_of(cn) != null:
            caps.append(cn)
    var env_expr = "px_null()"
    if len(caps) > 0:
        var ee = "({ LXValue _capenv = px_dict(); "
        for cn in caps:
            let cv = cg_var_of(cn)
            # M161（缺陷 164）：生成器的捕获必须**按值快照** —— 即使外层已把该局部装箱为
            #   cell（因被同帧闭包按引用捕获），生成器也要取**当前值**再造新 cell，
            #   对齐解释轨（GenExp 创建时求值）与 VM 轨（bc_emit_caps_snapshot: CELLGET+CELLNEW）。
            if cg_cells.has(cn):
                ee += "px_dict_set(_capenv, \"" + cn + "\", px_cell(px_cell_get(" + cv + "))); "
            else:
                ee += "px_dict_set(_capenv, \"" + cn + "\", px_cell(" + cv + ")); "
        ee += "_capenv; })"
        env_expr = ee
    var fdef = "static LXValue " + fnname + "(LXValue* args, int nargs, void* ctx) {\n"
    if len(caps) > 0:
        fdef += "    (void)nargs;\n"
    else:
        fdef += "    (void)ctx;\n"
    let saved_vars = cg_dict_copy(cg_vars)
    let saved_types = cg_dict_copy(cg_var_types)
    let saved_cells = cg_dict_copy(cg_cells)
    cg_vars = cg_new_dict()
    cg_var_types = cg_new_dict()
    cg_cells = cg_new_dict()
    var pi = 0
    while pi < len(params):
        let v = cg_new_var(params[pi])
        fdef += "    LXValue " + v + " = (nargs > " + str(pi) + ") ? args[" + str(pi) + "] : px_null();\n"
        pi += 1
    for cn in caps:
        let cv2 = cg_new_var(cn)
        cg_cells[cn] = 1
        fdef += "    LXValue " + cv2 + " = px_env_lookup(ctx, \"" + cn + "\");\n"
    let b = cg_gen_expr(body)
    let err_tag = "px_err_" + str(cg_uid())
    cg_err_labels.append(err_tag)
    fdef += "    LXValue " + err_tag + "_val = px_null();\n"
    fdef += "    int " + err_tag + "_proped = 0;\n"
    fdef += "    return " + b + ";\n"
    fdef += err_tag + ":\n"
    fdef += "    if (" + err_tag + "_proped) return " + err_tag + "_val;\n"
    fdef += "    return px_null();\n"
    fdef += "}\n"
    cg_err_labels = cg_err_labels[0:len(cg_err_labels) - 1]
    cg_closures += fdef
    cg_vars = saved_vars
    cg_var_types = saved_types
    cg_cells = saved_cells
    # M129b（缺陷 54）：同 cg_closure —— 无捕获的生成器 lambda 用 px_func(..., NULL)。
    if len(caps) > 0:
        return "px_func_env(\"<closure" + str(cid) + ">\", " + fnname + ", " + env_expr + ")"
    return "px_func(\"<closure" + str(cid) + ">\", " + fnname + ", NULL)"
