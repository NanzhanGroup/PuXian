# M41.4 定义级泛型正例：def first[T] + struct Box[T] + 约束 T: Comparable
# 语义：类型擦除（T 视为动态），运行时无泛型开销；编译+解释双模式输出一致
# ---------- 泛型函数：返回列表首元素 ----------
def first[T](items: list[T]) -> T:
    return items[0]

# ---------- 泛型函数：多泛型参数 + 约束（约束仅记录，渐进不强制） ----------
def swap2[K, V](k: K, v: V) -> V:
    return v

def max2[T: Comparable](a: T, b: T) -> T:
    if a > b:
        return a
    return b

# ---------- 泛型结构体 ----------
struct Box[T]:
    value: T
    tag: str

struct Pair[A, B]:
    x: A
    y: B

# ---------- 调用 ----------
print("first-int:", first([10, 20, 30]))
print("first-str:", first(["甲", "乙", "丙"]))
print("first-nested:", first([[1, 2], [3, 4]])[1])
print("swap:", swap2(1, "one"))
print("max2-int:", max2(3, 7))
print("max2-str:", max2("香蕉", "苹果"))

let bx = Box(42, "盒子")
print("Box.value:", bx.value)
print("Box.tag:", bx.tag)

let bx2 = Box("内层", "s")
print("Box2.value:", bx2.value)

let pair = Pair(1, "一")
print("Pair:", pair.x, pair.y)

# ---------- 泛型与类型标注混用（渐进：标注不参与运行时） ----------
var nums: list[int] = [5, 6, 7]
print("typed-first:", first(nums))
