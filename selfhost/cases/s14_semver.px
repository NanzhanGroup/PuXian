# M45：registry 版本化用例（semver 解析/比较/范围匹配/选版本）
# 验证：stdlib/semver.px 纯函数（编译/解释双模式输出逐字节一致）
import std.semver

def main():
    # 解析
    let p = sv_parse("1.2.3-alpha.1+build5")
    print("major: " + str(p["major"]) + " minor: " + str(p["minor"]) + " patch: " + str(p["patch"]))
    print("pre: " + p["pre"] + " build: " + p["build"])
    print("bad: " + str(sv_parse("1.2") == null) + " " + str(sv_parse("01.2.3") == null) + " " + str(sv_parse("1.2.3-01") == null))

    # 比较
    print("cmp 1.2.3 vs 1.2.10: " + str(sv_cmp("1.2.3", "1.2.10")))
    print("cmp 1.0.0-alpha vs 1.0.0: " + str(sv_cmp("1.0.0-alpha", "1.0.0")))
    print("cmp alpha.2 vs alpha.10: " + str(sv_cmp("1.0.0-alpha.2", "1.0.0-alpha.10")))
    print("cmp 1 vs alpha: " + str(sv_cmp("1.0.0-1", "1.0.0-alpha")))

    # 范围匹配
    print("^1.2.0: " + str(sv_satisfies("1.2.5", "^1.2.0")) + " " + str(sv_satisfies("2.0.0", "^1.2.0")))
    print("^0.2.3: " + str(sv_satisfies("0.2.9", "^0.2.3")) + " " + str(sv_satisfies("0.3.0", "^0.2.3")))
    print("~1.2.3: " + str(sv_satisfies("1.2.9", "~1.2.3")) + " " + str(sv_satisfies("1.3.0", "~1.2.3")))
    print("1.2.x: " + str(sv_satisfies("1.2.9", "1.2.x")) + " " + str(sv_satisfies("1.3.0", "1.2.x")))
    print("exact: " + str(sv_satisfies("1.2.3", "1.2.3")) + " " + str(sv_satisfies("1.2.4", "1.2.3")))
    print("pre reject: " + str(sv_satisfies("1.2.3-alpha", "1.2.3")))

    # 选版本（registry 场景：满足范围取最高）
    let versions = ["1.2.0", "1.2.5", "2.0.0", "1.0.0"]
    print("best ^1.2.0: " + sv_best(versions, "^1.2.0"))
    print("best ^2.0.0: " + sv_best(versions, "^2.0.0"))
    print("best ^0.5.0: " + str(sv_best(versions, "^0.5.0") == null))
    print("best ~1.2: " + sv_best(["1.2.0", "1.2.9", "1.3.0"], "~1.2"))
    print("semver ok")
