# Mini 子集用例 s03：list/dict
def main():
    let lst = [3, 1, 2]
    lst.append(4)
    print(len(lst))
    print(lst[0])
    print(lst[-1])
    print(sorted(lst))
    print(reversed(lst))
    let d = {"a": 1, "b": 2}
    d["c"] = 3
    print(d["c"])
    print(d.has("a"))
    print(d.keys())
    print(d.values())
    print(d.get("zz", 9))
