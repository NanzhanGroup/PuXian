# ============================================================
# M-B7: icall.px —— interp 调用层（对齐 interp.rs 调用/方法/内置）
# ------------------------------------------------------------
# 对齐项：
#   call_value → i_call_value
#   call_function → i_call_function（含默认参数/self 绑定/隐式返回/错误传播边界）
#   call_method → i_call_method
#   builtin 调用（builtin.rs call_builtin 的 Mini 子集部分）→ i_call_builtin
# ------------------------------------------------------------
# 关键：i_call_function 是"函数边界"——用户代码 ? 传播（__prop__）在此
# 捕获转为正常返回值（对齐 Rust LxError::propagate 边界语义）。
# 内置函数失败（如 read_file 不存在）在 PuXian 里是运行时错误（不可捕获），
# interp 对已知可失败的做预检查返回 Err；其余直接转发（记录已知限制）。
# ============================================================
# ---------- 调用任意可调用值（对齐 call_value） ----------
def i_call_value(cv, args, pos):
    let t = i_type_name(cv)
    if t == "function":
        return i_call_function(cv["__ufn__"], args, null, pos)
    if t == "native":
        return i_call_builtin(cv["__builtin__"], args, pos)
    if t == "type":
        if cv["__typeref__"] == "struct":
            let name = cv["name"]
            if not g_structs.has(name):
                return Err(i_r1002("未知结构体: '" + name + "'", pos))
            let sdef = g_structs[name]
            let fields = it_new_dict()
            var fi = 0
            while fi < len(sdef["fields"]):
                let fname = sdef["fields"][fi]["name"]
                if fi < len(args):
                    fields[fname] = args[fi]
                else:
                    fields[fname] = null
                fi += 1
            if len(args) > len(sdef["fields"]):
                return Err(i_r1005("结构体 " + name + " 字段过多", pos))
            return Ok(it_struct(name, fields))
        return Err(i_r1004("枚举类型 " + cv["name"] + " 不能直接调用（用 " + cv["name"] + ".Variant）", pos))
    return Err(i_r1004("值不可调用: " + i_to_str(cv), pos))
# ---------- 调用用户函数（对齐 call_function） ----------
def i_call_function(fd, args, selfv, pos):
    let call_env = env_new(fd["closure"])
    # M181（缺陷 193）：帧入口先登记**本帧声明式绑定**为「已声明、尚未执行」——
    #   读到即 R1001（与编译两轨的 hoist 槽哨兵同一条真相）。**必须先于形参定义**
    #   （形参 env_define 会解除同名登记 ⇒ `def f(x): let x = 1` 这类重声明仍以形参为准）。
    let decls = []
    i_collect_decl_names(fd["body"], decls)
    var di = 0
    while di < len(decls):
        env_mark_unbound(call_env, decls[di])
        di += 1
    if selfv != null:
        env_define(call_env, "self", selfv)
    var idx = 0
    var pi = 0
    let nparams = len(fd["params"])
    while pi < nparams:
        let p = fd["params"][pi]
        let pname = rust_unescape(p[1])
        if pname == "self":
            pi += 1
            continue
        if idx < len(args):
            env_define(call_env, pname, args[idx])
            idx += 1
        else:
            let dflt = p[3]
            if dflt != null:
                let dvr = i_eval_expr(dflt, fd["closure"])
                if dvr.is_err():
                    let e = dvr.err()
                    if e.has("__prop__"):
                        return Ok(e["__prop__"])
                    return Err(e)
                env_define(call_env, pname, dvr.unwrap())
            else:
                return Err(i_r1005("调用 " + fd["name"] + " 缺少参数 '" + pname + "'", pos))
        pi += 1
    if idx < len(args):
        return Err(i_r1005("调用 " + fd["name"] + " 参数过多（" + str(len(args)) + " 个实参，" + str(nparams) + " 个形参）", pos))
    # 闭包隐式返回：body 最后 ExprStmt 转 Return（构造闭包时已做，这里直接执行）
    let r = i_exec_block(fd["body"], call_env)
    if r.is_err():
        let e = r.err()
        if e.has("__prop__"):
            return Ok(e["__prop__"])
        return Err(e)
    let fl = r.unwrap()
    if fl == null:
        return Ok(null)
    if type(fl) == "dict" and fl.has("__flow__"):
        if fl["__flow__"] == "return":
            return Ok(fl["value"])
        return Err(i_r1005("函数 " + fd["name"] + " 内出现非法控制流", pos))
    return Ok(null)
# ---------- 方法分派（对齐 call_method） ----------
def i_call_method(rcv, name, args, pos):
    let t = i_type_name(rcv)
    if t == "string":
        return i_str_method(rcv, name, args, pos)
    if t == "list":
        return i_list_method(rcv, name, args, pos)
    if t == "dict":
        return i_dict_method(rcv, name, args, pos)
    if t == "result":
        return i_result_method(rcv, name, args, pos)
    if t == "struct":
        let tn = rcv["__struct__"]
        if g_impls.has(tn) and g_impls[tn].has(name):
            # M41.2 修复：解包 __ufn__（it_ufn 返回 {"__ufn__": {...}}，对齐 i_call_value fn 分支）
            return i_call_function(g_impls[tn][name]["__ufn__"], args, rcv, pos)
        return Err(i_r1007("类型 " + tn + " 没有方法 '" + name + "'", pos))
    if t == "tuple":
        if name == "len":
            # M190（缺陷 213-k）：补参数校验（native 侧本轮同步补齐 tuple.len）。
            if len(args) != 0:
                return Err(i_r1005("方法 len 不接受参数", pos))
            return Ok(len(rcv))
        return Err(i_r1007("类型 tuple 没有方法 '" + name + "'", pos))
    return Err(i_r1007("类型 " + t + " 没有方法 '" + name + "'", pos))
# 期望字符串参数（对齐 expect_str_arg）
def i_expect_str_arg(args, idx, mname, pos):
    if idx < len(args) and type(args[idx]) == "string":
        return Ok(args[idx])
    return Err(i_r1002("方法 " + mname + " 参数 " + str(idx + 1) + " 需要 string", pos))
# ---- string 方法（对齐 call_str_method） ----
def i_str_method(s, name, args, pos):
    # M190（缺陷 213-i）：本区四个方法修前**完全不查实参**⇒ `s.upper(9)` 解释轨静默
    #   忽略、编译轨响亮 ⇒ 三轨分叉。现在与 native `px_method` **逐字同文**。
    if name == "upper":
        if len(args) != 0:
            return Err(i_r1005("方法 upper 不接受参数", pos))
        return Ok(s.upper())
    if name == "lower":
        if len(args) != 0:
            return Err(i_r1005("方法 lower 不接受参数", pos))
        return Ok(s.lower())
    if name == "trim":
        if len(args) != 0:
            return Err(i_r1005("方法 trim 不接受参数", pos))
        return Ok(s.trim())
    if name == "len":
        if len(args) != 0:
            return Err(i_r1005("方法 len 不接受参数", pos))
        return Ok(len(s))
    # M190（缺陷 213-i）：修前这几个方法**只校验第 1 个实参的类型**、不查个数 ⇒
    #   `s.contains("a","b")` / `s.replace("a","b","c")` 解释轨静默忽略多余实参，
    #   而 native 侧精确 `nargs != N` 响亮。现在两侧逐字同文。
    if name == "split":
        if len(args) > 1:
            return Err(i_r1005("方法 split 需要 0-1 个参数", pos))
        if len(args) == 0:
            # 0 参 = 按**单个空格**切分（与内置 `split(s)` 的默认分隔符同）
            return Ok(s.split(" "))
        let r = i_expect_str_arg(args, 0, "split", pos)
        if r.is_err():
            return Err(r.err())
        return Ok(s.split(r.unwrap()))
    if name == "contains":
        if len(args) != 1:
            return Err(i_r1005("方法 contains 需要 1 个参数", pos))
        let r = i_expect_str_arg(args, 0, "contains", pos)
        if r.is_err():
            return Err(r.err())
        return Ok(s.contains(r.unwrap()))
    if name == "replace":
        if len(args) != 2:
            return Err(i_r1005("方法 replace 需要 2 个参数", pos))
        let r0 = i_expect_str_arg(args, 0, "replace", pos)
        if r0.is_err():
            return Err(r0.err())
        let r1 = i_expect_str_arg(args, 1, "replace", pos)
        if r1.is_err():
            return Err(r1.err())
        return Ok(s.replace(r0.unwrap(), r1.unwrap()))
    if name == "starts_with":
        if len(args) != 1:
            return Err(i_r1005("方法 starts_with 需要 1 个参数", pos))
        let r = i_expect_str_arg(args, 0, "starts_with", pos)
        if r.is_err():
            return Err(r.err())
        return Ok(s.starts_with(r.unwrap()))
    if name == "ends_with":
        if len(args) != 1:
            return Err(i_r1005("方法 ends_with 需要 1 个参数", pos))
        let r = i_expect_str_arg(args, 0, "ends_with", pos)
        if r.is_err():
            return Err(r.err())
        return Ok(s.ends_with(r.unwrap()))
    # ═══ M188-STR-FACE（PX-DEF-025/027）：四别名 —— 与 C 层 `px_method` **逐字同文** ═══
    # 实现不复制：find → 宿主 native str_index_of（rune 轴）；其余三个 → 既有语言级方法。
    if name == "find":
        if len(args) != 1:
            return Err(i_r1005("方法 find 需要 1 个参数", pos))
        let r = i_expect_str_arg(args, 0, "find", pos)
        if r.is_err():
            return Err(r.err())
        return Ok(str_index_of(s, r.unwrap()))
    if name == "strip":
        if len(args) != 0:
            return Err(i_r1005("方法 strip 不接受参数", pos))
        return Ok(s.trim())
    if name == "has_prefix":
        if len(args) != 1:
            return Err(i_r1005("方法 has_prefix 需要 1 个参数", pos))
        let r = i_expect_str_arg(args, 0, "has_prefix", pos)
        if r.is_err():
            return Err(r.err())
        return Ok(s.starts_with(r.unwrap()))
    if name == "has_suffix":
        if len(args) != 1:
            return Err(i_r1005("方法 has_suffix 需要 1 个参数", pos))
        let r = i_expect_str_arg(args, 0, "has_suffix", pos)
        if r.is_err():
            return Err(r.err())
        return Ok(s.ends_with(r.unwrap()))
    return Err(i_r1007("类型 string 没有方法 '" + name + "'", pos))
# ---- list 方法（对齐 call_list_method） ----
def i_list_method(l, name, args, pos):
    if name == "len":
        if len(args) != 0:
            return Err(i_r1005("方法 len 不接受参数", pos))
        return Ok(len(l))
    if name == "append" or name == "push":
        # M190（缺陷 213-h）：修前只查下限（`len(args) == 0`）⇒ `l.append(1, 2)` 解释轨
        #   **静默丢弃第 2 个实参**（rc=0），而 native 侧是精确的 `nargs != 1` ⇒ 三轨分叉。
        if len(args) != 1:
            return Err(i_r1005("方法 " + name + " 需要 1 个参数", pos))
        l.append(args[0])
        return Ok(null)
    if name == "pop":
        # M190（缺陷 213-a）：修前**忽略实参个数** ⇒ `l.pop(1)` 解释轨静默删掉一个元素
        #   （rc=0），而 VM/C 轨响亮「pop 不接受参数」⇒ 三轨分叉（静默数据丢失）。
        if len(args) != 0:
            return Err(i_r1005("pop 不接受参数", pos))
        if len(l) == 0:
            return Err(i_r1003("pop 空列表", pos))
        return Ok(l.pop())
    if name == "join":
        if len(args) != 1:
            return Err(i_r1005("方法 join 需要 1 个参数", pos))
        let r = i_expect_str_arg(args, 0, "join", pos)
        if r.is_err():
            return Err(r.err())
        let sep = r.unwrap()
        let parts = []
        var i = 0
        while i < len(l):
            parts.append(i_to_str(l[i]))
            i += 1
        return Ok(join(sep, parts))
    if name == "contains":
        if len(args) != 1:
            return Err(i_r1005("方法 contains 需要 1 个参数", pos))
        var i = 0
        while i < len(l):
            if i_eq(l[i], args[0]):
                return Ok(true)
            i += 1
        return Ok(false)
    if name == "reverse":
        # M190（缺陷 213-j）：补参数校验（native 侧同文案）。
        if len(args) != 0:
            return Err(i_r1005("方法 reverse 不接受参数", pos))
        let n = len(l)
        var i = 0
        while i < n // 2:
            let tmp = l[i]
            l[i] = l[n - 1 - i]
            l[n - 1 - i] = tmp
            i += 1
        return Ok(null)
    if name == "sort":
        # M190（缺陷 213-j）：补参数校验；并修**比较口径** —— 修前用 `i_to_str`（渲染串）
        #   比较，正是 M162 在 `sorted` 上修掉的那个 bug（`sort([10,9,2])` = `[10,2,9]`）；
        #   改用 `i_cmp_values`（对齐 `compare_values` 三态），交换条件保持 `> 0`（稳定）。
        if len(args) != 0:
            return Err(i_r1005("方法 sort 不接受参数", pos))
        let n = len(l)
        var i = 0
        while i < n:
            var j = 0
            while j < n - 1 - i:
                if i_cmp_values(l[j], l[j + 1]) > 0:
                    let tmp = l[j]
                    l[j] = l[j + 1]
                    l[j + 1] = tmp
                j += 1
            i += 1
        return Ok(null)
    if name == "index":
        # M190（缺陷 213-g）：与 native 侧 `list.index`（本轮补齐）同形 —— 恰 1 个参数。
        #   修前只查下限 ⇒ `l.index(1, 2)` 解释轨静默忽略第 2 个实参。
        if len(args) != 1:
            return Err(i_r1005("list.index 需要 1 个参数", pos))
        var i = 0
        while i < len(l):
            if i_eq(l[i], args[0]):
                return Ok(i)
            i += 1
        return Err(i_r1003("list.index 未找到元素", pos))
    return Err(i_r1007("类型 list 没有方法 '" + name + "'", pos))
# ---- dict 方法（对齐 call_dict_method） ----
def i_dict_method(d, name, args, pos):
    if name == "len":
        return Ok(len(d.keys()))
    if name == "get":
        let r = i_expect_str_arg(args, 0, "get", pos)
        if r.is_err():
            return Err(r.err())
        let k = r.unwrap()
        if d.has(k):
            return Ok(d[k])
        if len(args) > 1:
            return Ok(args[1])
        return Ok(null)
    if name == "set" or name == "put":
        # M190（缺陷 213-b）：修前**缺参时把值当 null 写入** ⇒ `d.set("b")` 解释轨
        #   静默插入 `b: null`（rc=0，**数据污染**），而 VM/C 轨响亮「方法 set 需要 2 个参数」。
        if len(args) != 2:
            return Err(i_r1005("方法 set 需要 2 个参数", pos))
        let r = i_expect_str_arg(args, 0, "set", pos)
        if r.is_err():
            return Err(r.err())
        var v = args[1]
        d[r.unwrap()] = v
        return Ok(null)
    if name == "keys":
        return Ok(d.keys())
    if name == "values":
        let out = []
        let ks = d.keys()
        var i = 0
        while i < len(ks):
            out.append(d[ks[i]])
            i += 1
        return Ok(out)
    if name == "items":
        # M167：[[k, v], …] 插入序**快照**（同 keys()/values()）——
        #   `for k, v in d.items()` = Go `for k, v := range m` 的对应写法。
        #   为什么单开方法：dict 直接迭代只产**键**（字符串）⇒ `for k, v in d` 会因
        #   解包校验响亮报 R1002（不静默），指引用户写 .items()。
        let out = []
        let ks = d.keys()
        var i = 0
        while i < len(ks):
            out.append([ks[i], d[ks[i]]])
            i += 1
        return Ok(out)
    if name == "has" or name == "contains":
        let r = i_expect_str_arg(args, 0, name, pos)
        if r.is_err():
            return Err(r.err())
        return Ok(d.has(r.unwrap()))
    if name == "remove":
        let r = i_expect_str_arg(args, 0, "remove", pos)
        if r.is_err():
            return Err(r.err())
        let k = r.unwrap()
        if d.has(k):
            var v = d[k]
            d.remove(k)
            return Ok(v)
        return Err(i_r1008("字典没有键 '" + k + "'", pos))
    return Err(i_r1007("类型 dict 没有方法 '" + name + "'", pos))
# ---- result 方法（对齐 call_method 的 Result 分支） ----
def i_result_method(r, name, args, pos):
    if name == "is_ok":
        if len(args) != 0:
            return Err(i_r1005("is_ok 不接受参数", pos))
        return Ok(r.is_ok())
    if name == "is_err":
        if len(args) != 0:
            return Err(i_r1005("is_err 不接受参数", pos))
        return Ok(r.is_err())
    if name == "unwrap":
        # M190（缺陷 213-c）：修前**忽略实参** ⇒ `Ok(1).unwrap(2)` 解释轨 rc=0 返回 1，
        #   而 VM/C 轨响亮「unwrap 不接受参数」。（`unwrap_err` 早就有同款检查，`unwrap` 漏了。）
        if len(args) != 0:
            return Err(i_r1005("unwrap 不接受参数", pos))
        if r.is_err():
            return Err(i_r1004("unwrap 失败: Err(" + i_to_str(r.err()) + ")", pos))
        return Ok(r.unwrap())
    if name == "unwrap_err":
        # M185（第 63 轮 · 第三方 PX-DEF-003）：`unwrap` 的**对偶** —— 断言必为 Err 并取值；
        #   Ok 上调用 ⇒ 响亮 R1004（不静默返回 null）。`ok()/err()` 是**查询**语义（另一侧给 null），
        #   写库要的是「断言 + 取值」这一个动作。
        if len(args) != 0:
            return Err(i_r1005("unwrap_err 不接受参数", pos))
        if r.is_ok():
            return Err(i_r1004("unwrap_err 失败: Ok(" + i_to_str(i_result_payload(r)) + ")", pos))
        return Ok(r.err())
    if name == "ok":
        if r.is_ok():
            return Ok(r.ok())
        return Ok(null)
    if name == "err":
        if r.is_err():
            return Ok(r.err())
        return Ok(null)
    return Err(i_r1007("类型 result 没有方法 '" + name + "'", pos))
