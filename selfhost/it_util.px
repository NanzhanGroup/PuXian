# ============================================================
# M-B7: it_util.px —— interp 工具层（供 cg_module.px 与 interp 复用）
# ------------------------------------------------------------
# 被 interp.px import。合并后闭包=主程序全局 env。
# 提供：
#   - cg_new_dict / rust_unescape（cg_module.px 依赖，从 codegen.px 对齐复制）
#   - it_dirname / it_new_dict / it_dict_copy / it_find
#   - it_pack_*（值包装构造）
# ============================================================

# 空 dict 构造（{} 是空块=null，必须用此方式）
def cg_new_dict():
    let d = {"_": 0}
    d.remove("_")
    return d

def it_new_dict():
    let d = {"_": 0}
    d.remove("_")
    return d

def it_dict_copy(d):
    var out = it_new_dict()
    let ks = d.keys()
    var i = 0
    while i < len(ks):
        out[ks[i]] = d[ks[i]]
        i += 1
    return out

# 路径目录名（对齐 Rust Path::parent 常用场景）
def it_dirname(path):
    var i = len(path) - 1
    while i >= 0:
        if path[i] == "/":
            if i == 0:
                return "/"
            return path[0:i]
        i -= 1
    return "."

# 子串查找（返回首次出现下标，找不到 -1）
def it_find(s, sub):
    let n = len(s)
    let m = len(sub)
    var i = 0
    while i + m <= n:
        var j = 0
        var ok = true
        while j < m:
            if s[i + j] != sub[j]:
                ok = false
                break
            j += 1
        if ok:
            return i
        i += 1
    return -1

# 字符串 debug 格式（rust_str_debug，带引号）→ 原始字符串
# 对齐 codegen.px rust_unescape（AST 字段为 debug 格式）
def rust_unescape(s):
    let body = s[1:len(s) - 1]
    var out = ""
    var i = 0
    while i < len(body):
        let c = body[i]
        if c == "\\":
            let nxt = body[i + 1]
            if nxt == "n":
                out += "\n"
                i += 2
            elif nxt == "t":
                out += "\t"
                i += 2
            elif nxt == "r":
                out += "\r"
                i += 2
            elif nxt == "0":
                out += "\u{0}"
                i += 2
            elif nxt == "\"":
                out += "\""
                i += 2
            elif nxt == "\\":
                out += "\\"
                i += 2
            elif nxt == "u":
                var j = i + 3
                var hex = ""
                while j < len(body) and body[j] != "}":
                    hex += body[j]
                    j += 1
                out += hex_to_char(hex)
                i = j + 1
            else:
                out += nxt
                i += 2
        else:
            out += c
            i += 1
    return out

# ---------- 值包装构造 ----------

# 用户函数包装：{"__ufn__": {"name","params","ret","body","closure","implicit"}}
#   body：list（stmts）或表达式节点；闭包 fn 表达式用 [ExprStmt]
def it_ufn(name, params, ret, body, closure, implicit):
    return {"__ufn__": {"name": name, "params": params, "ret": ret, "body": body, "closure": closure, "implicit": implicit}}

# 内置函数包装
def it_builtin(name):
    return {"__builtin__": name}

# struct 实例包装：{"__struct__": type_name, "__fields__": {f: v}}
def it_struct(tname, fields):
    return {"__struct__": tname, "__fields__": fields}

# enum 值包装：{"__enum__": type_name, "variant": name, "payload": v 或 null}
def it_enum(tname, variant, payload):
    return {"__enum__": tname, "variant": variant, "payload": payload}

# 类型对象包装：{"__typeref__": "struct"/"enum", "name": n}
def it_typeref(kind, name):
    return {"__typeref__": kind, "name": name}

# 生成器包装：{"__gen__": items(list), "cursor": n}
def it_gen(items, cursor):
    return {"__gen__": items, "cursor": cursor}
