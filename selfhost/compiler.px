# ============================================================
# M-B8: compiler.px —— PuXian 版完整编译器 CLI（自举证明）
# ------------------------------------------------------------
# 完整流水线：read → lex(pxlexer) → parse(parser) → resolve(import)
#            → generate(codegen) → C 源码到 stdout
# 用法：
#   px run compiler.px build <file.px>   # 解释模式
#   build/compiler build <file.px>       # 编译模式（自举）
#   build/compiler <file.px>             # 同上（file 为最后参数）
# 说明：主文件声明全部全局状态（import 不注册模块顶层 let），
#       import codegen.px 提供函数（parser/pxlexer/cg_* 全链）。
# 对拍契约（MINI_SUBSET §五 build 层）：输出 C 源码 norm_c 后与
#       Rust 版 `px build <file.px>` 产物逐字节一致。
#
# M89-S3-C2（2026-09-08）：并入 bc_emit.px —— 编译器正主自举收敛第一子步：
#       bc 发射能力从姊妹壳 bc_cli.px 并入 compiler.px 主链路，支持：
#         compiler.px <file>              # 默认 C 文本（旧轨 codegen，不变）
#         compiler.px bc <file>           # BCModule dump（字节码镜像，VM 轨）
#         compiler.px bc --emit-c <file>  # BCModule 静态 C 产物（emit-c）
#       自举证明规则随 C2 从 C 文本对拍切到 BC 镜像对拍（见 bootstrap_prove.sh）。
# ============================================================
import "codegen.px"
import "bc_emit.px"
# ---------- 全局状态（主文件声明；import 不注册模块顶层 let）----------
var g_src = ""
var g_len = 0
var g_pos = 0
var g_line = 1
var g_col = 1
var g_indent_stack = [0]
var g_at_line_start = true
var g_toks = []
var g_count = 0
var g_pending = []
let KEYWORDS = {"let": "let", "var": "var", "const": "const", "def": "def", "fn": "fn", "struct": "struct", "enum": "enum", "trait": "trait", "impl": "impl", "match": "match", "case": "case", "if": "if", "elif": "elif", "else": "else", "for": "for", "while": "while", "in": "in", "and": "and", "or": "or", "not": "not", "return": "return", "break": "break", "continue": "continue", "import": "import", "from": "from", "pub": "pub", "as": "as", "spawn": "spawn", "chan": "chan", "send": "send", "recv": "recv", "select": "select", "true": "true", "false": "false", "null": "null", "None": "null", "self": "self", "capture": "capture", "extern": "extern"}  # noqa
let CTRL_ALL = "\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{b}\u{c}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f}\u{7f}\u{80}\u{81}\u{82}\u{83}\u{84}\u{85}\u{86}\u{87}\u{88}\u{89}\u{8a}\u{8b}\u{8c}\u{8d}\u{8e}\u{8f}\u{90}\u{91}\u{92}\u{93}\u{94}\u{95}\u{96}\u{97}\u{98}\u{99}\u{9a}\u{9b}\u{9c}\u{9d}\u{9e}\u{9f}"  # noqa
var p_toks = []
var p_pos = 0
var cg_closures = ""
var cg_structs = {"_": 0}
var cg_enums = {"_": 0}
var cg_impls = {"_": 0}
var cg_vars = {"_": 0}
var cg_var_types = {"_": 0}
var cg_immutables = {"_": 0}
var cg_nonnull = {"_": 0}
var cg_ffi = {"_": 0}
var cg_const_enums = {"_": 0}  # M44：type X const 简化枚举
var cg_globals = []
var cg_err_labels = []
var cg_uidc = 0
var cg_closure_id = 0
var loaded = {"_": 0}
# bc_emit.px 模块级状态（import 不注册模块顶层 var → 主文件声明）
var g_bcm = null
# ---------- 版本（M63-L11：bootstrap/pxc --version/-v；对齐 tools/pxc SELFHOST_VER/MS） ----------
let PXC_VER = "0.2.0"
let PXC_MS = "M-B9a"
# ---------- 工具（bc dump 用；与 bc_cli.px 同构） ----------
def bc_basename(path):
    var i = len(path) - 1
    while i >= 0:
        if path[i] == "/":
            var b = path[i + 1:len(path)]
            if len(b) > 3 and b[len(b) - 3:len(b)] == ".px":
                return b[0:len(b) - 3]
            return b
        i -= 1
    if len(path) > 3 and path[len(path) - 3:len(path)] == ".px":
        return path[0:len(path) - 3]
    return path
# ---------- 入口 ----------
def main():
    let a = args()
    # M63-L11：pxc --version / -v（照 interp.px pxi 版本分支；args() 含 argv[0]）
    if len(a) == 2 and (a[1] == "--version" or a[1] == "-v"):
        print("pxc " + PXC_VER + " (普贤 PuXian · selfhosted " + PXC_MS + ")")
        return 0
    # M89-S3-C2：bc 子命令识别 —— 参数（非末位文件）含 "bc"/"--emit-c" → BCModule 轨
    #   （--emit-c 单独出现也进 BC 轨 emit-c，对齐 bc_cli 用法）。默认 = C 文本（旧轨）。
    var bc_mode = false
    var emit_c = false
    var ai = 1
    while ai < len(a) - 1:
        if a[ai] == "bc" or a[ai] == "--emit-c":
            bc_mode = true
        if a[ai] == "--emit-c":
            emit_c = true
        ai += 1
    # 支持：compiler.px <file>  /  compiler.px build <file>  /  compiler.px bc <file>
    let f = a[len(a) - 1]
    let base_dir = cg_dirname(f)
    p_toks = lex_tokens(read_file(f))
    p_pos = 0
    let ast = parse_program()
    let prog = cg_resolve_modules(ast, base_dir)
    if bc_mode:
        if emit_c:
            print(bc_emit_c_program(prog))
            return 0
        let m = bc_emit_program(prog)
        m["name"] = bc_basename(f)
        bc_dump_module(m)
        return 0
    var out = cg_generate(prog)
    # print 会追加一个换行：去掉末尾 \n 避免多一个空行（对齐 Rust 版写文件）
    let n = len(out)
    if n > 0 and out[n - 1] == "\n":
        out = out[0:n - 1]
    print(out)
