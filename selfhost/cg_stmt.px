# ============================================================
# M-B6: cg_stmt.px —— 语句生成（对齐 Rust codegen.gen_stmt）
# ------------------------------------------------------------
# 被 codegen.px import；函数引用主文件全局状态（cg_vars 等）。
# 全局变量/函数命名：cg_ 前缀避免与主文件/parser 冲突。
# ============================================================
# ---------- 语句生成 ----------
def cg_gen_stmt_inner(stmt, indent):
    let pad = cg_pad(indent)
    let ty = stmt[0]
    if ty == "VarDecl":
        let name = rust_unescape(stmt[2])
        # M112-S0（Issue 46）：语义检查移交轨无关共享层 cg_sem_vardecl
        #   （M41.2 不可变标记 + M41.3 E3003）——原先内联在此 ⇒ VM 轨无从复用
        cg_sem_vardecl(stmt)
        var rhs = "px_null()"
        if stmt[4] != null:
            rhs = cg_gen_expr(stmt[4])
        # M169（缺陷 181）：**模块体**（顶层，含嵌套块）里的声明 = 模块级全局
        #   （修前判据是「名字已在 cg_globals 且 cg_err_labels 空」⇒ 只认**直接顶层**的
        #    声明，嵌套块内的退化成帧局部、块外引用即 C undeclared；实测
        #    `if true: let x = 42` 后 `print(x)` = error: '_v1' undeclared）
        if cg_topbody:
            #   不再分配 `_vN` 帧局部，但**推进同一编号计数器**（cg_uid）⇒ 改后 `_vN`/`_tN`
            #   编号与改前逐一对齐 ⇒ 重定基差异只落在本族（同 M165/M166/M167 专用计数器之手法）
            cg_uid()
            return pad + "px_set_global(\"" + name + "\", " + rhs + ");\n"
        var hv = cg_var_of(name)
        if hv == null:
            # 未被函数顶预提升（如函数内 var 与模块顶层全局同名被 hoist 跳过）→ 就地声明
            hv = cg_new_var(name)
            # 类型推断：struct 构造
            if stmt[4] != null:
                let e = stmt[4]
                var cname = null
                if e[0] == "Constructor":
                    cname = rust_unescape(e[1])
                elif e[0] == "Call":
                    let callee = e[1]
                    if callee[0] == "Var":
                        cname = rust_unescape(callee[1])
                if cname != null:
                    if cg_structs.has(cname):
                        cg_var_types[name] = cname
            if cg_cells.has(name):
                cg_inited_add(name)
                return pad + "LXValue " + hv + " = px_cell(" + rhs + ");\n"
            cg_inited_add(name)
            return pad + "LXValue " + hv + " = " + rhs + ";\n"
        # M62-L5：变量已由函数顶预声明（px_null 初始，块作用域不新建），此处仅赋值
        # 类型推断：struct 构造（与就地声明路径一致）
        if stmt[4] != null:
            let e = stmt[4]
            var cname = null
            if e[0] == "Constructor":
                cname = rust_unescape(e[1])
            elif e[0] == "Call":
                let callee = e[1]
                if callee[0] == "Var":
                    cname = rust_unescape(callee[1])
            if cname != null:
                if cg_structs.has(cname):
                    cg_var_types[name] = cname
        let st_out2 = pad + cg_store_of(name, hv, rhs) + ";\n"
        # M181（缺陷 193）：声明执行完成 ⇒ 其后读它不再需要 px_chk_uninit（初始化单调）
        cg_inited_add(name)
        return st_out2
    if ty == "Assign":
        var rhs = cg_gen_expr(stmt[3])
        let tgt = stmt[1]
        let op = stmt[2]
        # M44：列表追加简写 `a <- 4` ≡ a.append(4)
        if op == "Append":
            let o = cg_gen_expr(tgt)
            let sj = cg_seq_join([tgt, stmt[3]], [o, rhs])  # M165（缺陷 178）
            let call_c = cg_seq_wrap(sj[0], "px_method(" + sj[1][0] + ", \"append\", (LXValue[]){" + sj[1][1] + "}, 1)")
            return pad + "(void)(" + call_c + ");\n"
        let tty = tgt[0]
        if tty == "Var":
            let name = rust_unescape(tgt[1])
            # M112-S0（Issue 46）：E3002/E3003 移交共享语义层（VM 轨同一条）
            cg_sem_assign(tgt, op, stmt[3])
            let v = cg_var_of(name)
            if v == null:
                # 全局变量
                if op == "Assign":
                    return pad + "px_set_global(\"" + name + "\", " + rhs + ");\n"
                let full = cg_assign_op_global(op, name, rhs)
                return pad + "px_set_global(\"" + name + "\", " + full + ");\n"
            let full = cg_assign_op_local(op, cg_load_ck(name, v), rhs)
            let st_out = pad + " " + cg_store_of(name, v, full) + ";\n"
            # M181（缺陷 193）：赋值式绑定即初始化（复合赋值同样读到过旧值）
            cg_inited_add(name)
            return st_out
        if tty == "Field":
            let o = cg_gen_expr(tgt[1])
            let fname = rust_unescape(tgt[2])
            let sj = cg_seq_join([tgt[1], stmt[3]], [o, rhs])  # M165（缺陷 178）
            return pad + cg_seq_wrap(sj[0], "px_field_set(" + sj[1][0] + ", \"" + fname + "\", " + sj[1][1] + ")") + ";\n"
        if tty == "Index":
            let o = cg_gen_expr(tgt[1])
            let i = cg_gen_expr(tgt[2])
            let sj = cg_seq_join([tgt[1], tgt[2], stmt[3]], [o, i, rhs])  # M165（缺陷 178）
            return pad + cg_seq_wrap(sj[0], "px_index_set(" + sj[1][0] + ", " + sj[1][1] + ", " + sj[1][2] + ")") + ";\n"
        return "不支持的赋值目标"
    if ty == "ExprStmt":
        let e = cg_gen_expr(stmt[1])
        return pad + "(void)(" + e + ");\n"
    if ty == "If":
        var s = ""
        let brs = stmt[1]
        # M181（缺陷 193）：**初始化数据流** —— 分支可能都不执行某声明 ⇒ 之后只保留
        #   各分支的**交集**（无 else 时与入口集求交）。方向纪律：多判无害、少判即缺陷。
        let entry = cg_inited_copy()
        var acc = null
        var bi = 0
        while bi < len(brs):
            cg_inited_restore(entry)
            let c = cg_gen_expr(brs[bi][0])
            var kw = "if"
            if bi > 0:
                kw = "else if"
            s += pad + kw + " (px_is_truthy(" + c + ")) {\n"
            let body = brs[bi][1]
            var si = 0
            while si < len(body):
                s += cg_gen_stmt(body[si], indent + 1)
                si += 1
            s += pad + "}\n"
            if acc == null:
                acc = cg_inited_copy()
            else:
                acc = cg_inited_intersect(acc, cg_inited_copy())
            bi += 1
        cg_inited_restore(entry)
        if stmt[2] != null:
            s += pad + "else {\n"
            let eb = stmt[2]
            var ei = 0
            while ei < len(eb):
                s += cg_gen_stmt(eb[ei], indent + 1)
                ei += 1
            s += pad + "}\n"
            acc = cg_inited_intersect(acc, cg_inited_copy())
        else:
            acc = cg_inited_intersect(acc, entry)
        cg_inited_restore(acc)
        return s
    if ty == "While":
        # M181（缺陷 193）：循环体可能**一次都不执行** ⇒ 之后回退入口集（保守）
        let wentry = cg_inited_copy()
        let c = cg_gen_expr(stmt[1])
        var s = pad + "while (px_is_truthy(" + c + ")) {\n"
        let body = stmt[2]
        var bi = 0
        while bi < len(body):
            s += cg_gen_stmt(body[bi], indent + 1)
            bi += 1
        s += pad + "}\n"
        cg_inited_restore(wentry)
        return s
    if ty == "For":
        # M181（缺陷 193）：入口集快照（iterable 在本状态求值；循环之后回退到它 ——
        #   可能 0 次迭代 ⇒ 循环变量不算已初始化，与解释轨一致：空迭代后读 ⇒ R1001）
        let fentry = cg_inited_copy()
        let it = cg_gen_expr(stmt[2])
        let it_var = cg_tmp()
        let idx_var = cg_tmp()
        # M167（缺陷 180）：多变量解包 —— For.var 单变量为字符串、多变量为名字列表
        let names = cg_for_names(stmt[1])
        let multi = len(names) > 1
        var item_var = ""
        var upn = 0
        if multi:
            item_var = cg_unpack_tmp()
            upn = len(names)
        # 逐个变量算「声明/赋值」文本（单变量与原实现逐字节一致）
        var decls = []
        # M169（缺陷 181）：模块体（含嵌套块）里的循环变量 = **模块级全局**
        #   （解释轨单一 env ⇒ 天然如此；VM 轨同轮把 `is_top` 的 for 改 SETG）。
        #   修前占**帧局部槽** ⇒ ① 循环后引用 = C undeclared 编译失败（实测
        #   `for p in l:` 后 `print(p)` → error: '_v3' undeclared，嵌套块更甚）；
        #   ② 顶层闭包捕获它时该槽不是 cell ⇒ 按值快照（解释轨是**引用**：20/20 vs 10/20）。
        var vi = 0
        while vi < len(names):
            let nm = names[vi]
            var fv_init = ""
            if multi:
                # M167：解包字段（item 已由 UNPACKCK 校验过类型与长度）
                fv_init = "px_index(" + item_var + ", px_int(" + str(vi) + "))"
            else:
                # M164（缺陷 170）：迭代元素取 **px_iter_at** —— dict 的「第 i 个键」只属迭代机制；
                #   用户面 `d[i]` 走 px_index（现严格报 R1002）。修前共用 px_index ⇒ 位置语义外漏。
                fv_init = "px_iter_at(" + it_var + ", px_int(" + idx_var + "))"
            if cg_topbody:
                #   不分配 `_vN` 帧局部，但推进同一编号计数器（cg_uid）⇒ 编号与改前对齐
                cg_uid()
                decls.append("px_set_global(\"" + nm + "\", " + fv_init + ");")
                vi += 1
                continue
            var vv = cg_var_of(nm)
            var vp = "LXValue "
            if vv == null:
                # 帧内未被预提升 → 就地声明
                vv = cg_new_var(nm)
            else:
                # M62-L5：函数内循环变量已由函数顶预声明（px_null 初始，Python 语义循环后保留最后值），循环内仅赋值
                vp = ""
            if vp == "LXValue ":
                # 就地声明
                if cg_cells.has(nm):
                    decls.append("LXValue " + vv + " = px_cell(" + fv_init + ");")
                else:
                    decls.append("LXValue " + vv + " = " + fv_init + ";")
            else:
                # 已声明（可能是 cell）
                decls.append(cg_store_of(nm, vv, fv_init) + ";")
            vi += 1
        var s = pad + "LXValue " + it_var + " = " + it + ";\n"
        # M166（缺陷 176）：**进入循环时快照长度** + 循环体开头复核 ⇒ 迭代期间长度变化报 R1003。
        #   长度局部用 `_ilN`（cg_iter_len_tmp，不进 cg_tmp 序列 ⇒ 其余发射文本不变）。
        let len_var = cg_iter_len_tmp()
        s += pad + "int " + len_var + " = px_iter_prepare(" + it_var + ");\n"
        s += pad + "for (int " + idx_var + " = 0; " + idx_var + " < " + len_var + "; " + idx_var + "++) {\n"
        s += pad + "    px_iter_ck(" + it_var + ", " + len_var + ");\n"
        if multi:
            # M167（缺陷 180）：多变量解包 —— 迭代元素先入 item 临时槽（`_upN`），
            #   **px_unpack_ck** 校验（list/tuple + 长度恰为 N，否则 R1002 同码同文；
            #   修前落到逐个 px_index ⇒ 报「R1003 列表索引越界」，长度不足时与解释轨分叉），
            #   再逐变量 px_index。变量声明顺序与原「先算变量槽、后写循环头」一致。
            s += pad + "    LXValue " + item_var + " = px_iter_at(" + it_var + ", px_int(" + idx_var + "));\n"
            s += pad + "    px_unpack_ck(" + item_var + ", " + str(upn) + ");\n"
            var di = 0
            while di < len(decls):
                s += pad + "    " + decls[di] + "\n"
                di += 1
        else:
            s += pad + "    " + decls[0] + "\n"
        let body = stmt[3]
        # M181（缺陷 193）：循环体内**循环变量必已初始化**（循环头就写它；模块体走全局，不入集）
        if not cg_topbody:
            var qn = 0
            while qn < len(names):
                cg_inited_add(names[qn])
                qn += 1
        var bi = 0
        while bi < len(body):
            s += cg_gen_stmt(body[bi], indent + 1)
            bi += 1
        s += pad + "}\n"
        cg_inited_restore(fentry)
        return s
    if ty == "Return":
        if stmt[1] != null:
            let e = cg_gen_expr(stmt[1])
            return pad + "return " + e + ";\n"
        return pad + "return px_null();\n"
    if ty == "Break":
        return pad + "break;\n"
    if ty == "Continue":
        return pad + "continue;\n"
    if ty == "Empty":
        return ""
    if ty == "ChanDecl":
        # M169（缺陷 181）：模块体里的通道绑定 = 模块级全局（VM 轨 `is_top` 分支同口径）
        let cn = rust_unescape(stmt[1])
        if cg_topbody:
            cg_uid()
            return pad + "px_set_global(\"" + cn + "\", px_chan_create(0));\n"
        let v = cg_new_var(cn)
        # M181（缺陷 193）：就地声明即初始化
        cg_inited_add(cn)
        return pad + "LXValue " + v + " = px_chan_create(0);\n"
    if ty == "Send":
        let c = cg_gen_expr(stmt[1])
        let v = cg_gen_expr(stmt[2])
        return pad + "px_chan_send(" + c + ", " + v + ");\n"
    if ty == "Recv":
        let c = cg_gen_expr(stmt[1])
        return pad + "px_chan_recv(" + c + ");\n"
    if ty == "Spawn":
        let ex = stmt[1]
        if ex[0] == "Call":
            let callee = ex[1]
            if callee[0] == "Var":
                let fname = rust_unescape(callee[1])
                let parts = []
                let args = ex[2]
                var ai = 0
                while ai < len(args):
                    parts.append(cg_gen_expr(args[ai]))
                    ai += 1
                let sj = cg_seq_join(args, parts)  # M165（缺陷 178）
                let call_c = cg_seq_wrap(sj[0], "px_spawn_name(\"" + fname + "\", (LXValue[]){" + join(", ", sj[1]) + "}, " + str(len(parts)) + ")")
                return pad + call_c + ";\n"
            let p = stmt[2]
            print_err("错误: " + str(p[0]) + ":" + str(p[1]) + ": 语义错误 E2011: spawn 只支持「直接函数调用」：spawn f(args)（方法调用请先绑定命名函数）")
            exit(1)
        let p2 = stmt[2]
        print_err("错误: " + str(p2[0]) + ":" + str(p2[1]) + ": 语义错误 E2011: spawn 只支持「直接函数调用」：spawn f(args)；匿名函数请先绑定命名函数（def work(): ... 然后 spawn work()）")
        exit(1)
    if ty == "Select":
        return cg_gen_select(stmt[1], stmt[2], indent)
    if ty == "Import":
        return pad + "/* import 忽略（MVP） */\n"
    if ty == "FuncDef":
        # M160（缺陷 160）：**函数体内的 `def`**（顶层 def 走 cg_generate，不进这里）——
        #   绑定为本帧局部，值 = 与匿名 fn 同构的闭包（自由变量按引用捕获，cell）。
        #   递归：该局部在函数顶已提升声明（cg_collect_hoist_vars），def 语句处赋值；
        #   闭包体读它时走的是**捕获的同一个 cell** ⇒ 自引用（递归）成立。
        let dname = rust_unescape(stmt[1])
        let dcv = cg_var_of(dname)
        # 注意：FuncDef 的 stmt[4] 是**语句列表**（Closure 节点的 expr[3] 是 Block **表达式**）
        #   ⇒ 这里显式包一层 Block，才能复用同一条闭包发射路径（否则体被当表达式生成 ⇒ 空函数）。
        let dfn = cg_gen_closure(stmt[2], ["Block", stmt[4]], dname)
        if cg_topbody:
            # M169（缺陷 181）：**模块体里的嵌套 def** = 模块级全局绑定。
            #   修前 `dcv == null` 直接 `return ""` ⇒ **绑定从未发生**，调用处走
            #   `px_get_global` ⇒ 运行期「未定义变量: f」（实测 `if true: def f(): 41`
            #   后 `print(f())`）；解释轨（单一 env）为 41，VM 轨同轮改 SETG。
            cg_uid()
            return pad + "px_set_global(\"" + dname + "\", " + dfn + ");\n"
        if dcv != null:
            let dfout = pad + cg_store_of(dname, dcv, dfn) + ";\n"
            # M181（缺陷 193）：帧内 def 执行完成 ⇒ 该名已初始化
            cg_inited_add(dname)
            return dfout
        return ""
    # StructDef/EnumDef/TraitDef/ImplDef → 空（顶层在 generate 处理）
    return ""
# M72-S2（Issue 10 D1）：cg_gen_stmt 入口 wrapper —— 编译产物运行时错误带 .px 源行号。
# 每条可执行语句（含 if/while/for 嵌套子语句，递归均经本 wrapper）生成前插
# px_srcline(<源行>) 追踪；stmt 末位恒为 pos [line, col]（parser 约定）。runtime 侧
# px_error 打印最近位置 → LLM 拿到错误即定位到 .px 源行。产物 C 仅多一行赋值，开销极微。
def cg_gen_stmt(stmt, indent):
    var line = 0
    if len(stmt) > 0:
        let p = stmt[len(stmt) - 1]
        if type(p) == "list" and len(p) >= 1 and type(p[0]) == "int":
            line = p[0]
    var pre = ""
    if line > 0:
        pre = cg_pad(indent) + "px_srcline(" + str(line) + ");\n"
    return pre + cg_gen_stmt_inner(stmt, indent)
# 复合赋值：全局变量（先读全局再运算再写回）
def cg_assign_op_global(op, name, rhs):
    if op == "Assign":
        return rhs
    if op == "Plus":
        return "px_add(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "Minus":
        return "px_sub(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "Star":
        return "px_mul(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "Slash":
        return "px_div(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "IntDiv":
        return "px_idiv(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "Mod":
        return "px_mod(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "Pow":
        return "px_pow(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "BitAnd":
        return "px_bitand(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "BitOr":
        return "px_bitor(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "BitXor":
        return "px_bitxor(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "Shl":
        return "px_shl(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "Shr":
        return "px_shr(px_get_global(\"" + name + "\"), " + rhs + ")"
    if op == "ShrU":
        return "px_ushr(px_get_global(\"" + name + "\"), " + rhs + ")"
    return rhs
# 复合赋值：局部变量
def cg_assign_op_local(op, v, rhs):
    if op == "Assign":
        return rhs
    if op == "Plus":
        return "px_add(" + v + ", " + rhs + ")"
    if op == "Minus":
        return "px_sub(" + v + ", " + rhs + ")"
    if op == "Star":
        return "px_mul(" + v + ", " + rhs + ")"
    if op == "Slash":
        return "px_div(" + v + ", " + rhs + ")"
    if op == "IntDiv":
        return "px_idiv(" + v + ", " + rhs + ")"
    if op == "Mod":
        return "px_mod(" + v + ", " + rhs + ")"
    if op == "Pow":
        return "px_pow(" + v + ", " + rhs + ")"
    if op == "BitAnd":
        return "px_bitand(" + v + ", " + rhs + ")"
    if op == "BitOr":
        return "px_bitor(" + v + ", " + rhs + ")"
    if op == "BitXor":
        return "px_bitxor(" + v + ", " + rhs + ")"
    if op == "Shl":
        return "px_shl(" + v + ", " + rhs + ")"
    if op == "Shr":
        return "px_shr(" + v + ", " + rhs + ")"
    if op == "ShrU":
        return "px_ushr(" + v + ", " + rhs + ")"
    return rhs
# ---------- select 生成（M4.2） ----------
def cg_gen_select(arms, else_branch, indent):
    let pad = cg_pad(indent)
    let n = len(arms)
    if n == 0:
        return "select 至少需要一个 case 分支"
    let uid = cg_uid()
    var s = ""
    # M181（缺陷 193）：select 有**重试环**（goto _sel_retry）⇒ 分支体里的声明可能从未执行
    #   ⇒ 之后必须回退入口集（保守；少判即漏报，见 cg_inited 的说明）
    let sentry = cg_inited_copy()
    let saved_vars = cg_dict_copy(cg_vars)
    let saved_types = cg_dict_copy(cg_var_types)
    let saved_cells = cg_dict_copy(cg_cells)
    # 为每个 arm 求值 chan 表达式（循环外只求值一次）
    let chan_parts = []
    var ci = 0
    while ci < n:
        let ex = arms[ci][1]
        if ex[0] == "Call":
            let callee = ex[1]
            if callee[0] == "Field":
                let mname = rust_unescape(callee[2])
                if mname == "recv":
                    chan_parts.append(cg_gen_expr(callee[1]))
                    ci += 1
                    continue
                return "select case 仅支持 ch.recv()（不支持 ." + mname + "）"
            return "select case 仅支持 ch.recv()"
        return "select case 仅支持 ch.recv()"
    s += pad + "LXValue _chans" + str(uid) + "[" + str(n) + "] = {" + join(", ", chan_parts) + "};\n"
    s += pad + "_sel_retry_" + str(uid) + ": {\n"
    let order_init = []
    var oi = 0
    while oi < n:
        order_init.append(str(oi))
        oi += 1
    s += pad + "    int _ord" + str(uid) + "[" + str(n) + "] = {" + join(", ", order_init) + "};\n"
    if n > 1:
        var shuffle = pad + "    for (int _i" + str(uid) + " = " + str(n) + " - 1; _i" + str(uid) + " > 0; _i" + str(uid) + "--) { "
        shuffle += "int _j" + str(uid) + " = rand() % (_i" + str(uid) + " + 1); "
        shuffle += "int _t" + str(uid) + " = _ord" + str(uid) + "[_i" + str(uid) + "]; _ord" + str(uid) + "[_i" + str(uid) + "] = _ord" + str(uid) + "[_j" + str(uid) + "]; _ord" + str(uid) + "[_j" + str(uid) + "] = _t" + str(uid) + "; "
        shuffle += "}\n"
        s += shuffle
    s += pad + "    LXValue _rv" + str(uid) + " = px_null();\n"
    s += pad + "    int _picked" + str(uid) + " = -1;\n"
    s += pad + "    for (int _k" + str(uid) + " = 0; _k" + str(uid) + " < " + str(n) + "; _k" + str(uid) + "++) {\n"
    s += pad + "        int _idx" + str(uid) + " = _ord" + str(uid) + "[_k" + str(uid) + "];\n"
    s += pad + "        if (px_chan_try_recv(_chans" + str(uid) + "[_idx" + str(uid) + "], &_rv" + str(uid) + ")) { _picked" + str(uid) + " = _idx" + str(uid) + "; break; }\n"
    s += pad + "    }\n"
    # 命中：执行对应 arm body
    s += pad + "    if (_picked" + str(uid) + " >= 0) {\n"
    var ai = 0
    while ai < n:
        let bind = arms[ai][0]
        let body = arms[ai][2]
        var cond = "if (_picked" + str(uid) + " == " + str(ai) + ")"
        if ai > 0:
            cond = "else if (_picked" + str(uid) + " == " + str(ai) + ")"
        s += pad + "        " + cond + " {\n"
        if bind != null:
            let v = cg_new_var(rust_unescape(bind))
            s += pad + "            LXValue " + v + " = _rv" + str(uid) + ";\n"
        var bi = 0
        while bi < len(body):
            s += cg_gen_stmt(body[bi], indent + 3)
            bi += 1
        s += pad + "        }\n"
        ai += 1
    s += pad + "        goto _sel_done_" + str(uid) + ";\n"
    s += pad + "    }\n"
    # else 分支
    if else_branch != null:
        s += pad + "    {\n"
        var ei = 0
        while ei < len(else_branch):
            s += cg_gen_stmt(else_branch[ei], indent + 2)
            ei += 1
        s += pad + "        goto _sel_done_" + str(uid) + ";\n"
        s += pad + "    }\n"
    # 无 else：阻塞等待后重试
    s += pad + "    px_select_wait();\n"
    s += pad + "}\n"
    s += pad + "goto _sel_retry_" + str(uid) + ";\n"
    s += pad + "_sel_done_" + str(uid) + ": ;\n"
    cg_vars = saved_vars
    cg_var_types = saved_types
    cg_cells = saved_cells
    cg_inited_restore(sentry)
    return s
