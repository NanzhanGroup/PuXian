# ============================================================
# M-B7: ival.px —— interp 值层（对齐 interp.rs 的值操作）
# ------------------------------------------------------------
# 对齐项：
#   type_name → i_type_name
#   fmt_value → i_to_str
#   is_truthy → i_truthy
#   PartialEq → i_eq
#   iter_values → i_iter
#   eval_index/as_index → i_index/i_as_index
#   eval_field → i_field
#   eval_slice/slice_indices → i_slice/i_slice_indices
#   eval_unary → i_eval_unary
#   eval_binary/bin_add/bin_numeric/bin_compare → i_eval_binary 系列
# ------------------------------------------------------------
# 设计：PuXian 原生值（int/float/str/bool/null/list/dict/tuple/result/range/bytes）
# 的运算符/方法/str/type 已与 Rust 版对齐（M0-M40 双模式验证），
# 直接透传；本层只补：包装值（fn/struct/enum/typeref/gen/builtin）的语义
# + 容器递归（可能内嵌包装值）+ 错误消息对齐。
# 返回 Result 的函数用 ? 传播子错误（仅 i_call_function 边界区分 __prop__）。
# ============================================================
# ---------- 类型名（对齐 runtime px_type_name） ----------
# M158 附带修复（缺陷 161）：函数值类型名此前是 "fn"/"builtin"，而 runtime
#   （px_type_name）返回 "function"/"native" ⇒ `type(f)` 三轨分叉（速查表事实
#   39/122 的"三轨一致"契约、MINI_SUBSET 类型名表都写 function）。本文件与
#   icall.px 的类型判断同步改为 runtime 口径。
def i_type_name(v):
    let t = type(v)
    if t == "dict":
        if v.has("__ufn__"):
            return "function"
        if v.has("__builtin__"):
            return "native"
        if v.has("__struct__"):
            return "struct"
        if v.has("__enum__"):
            return "enum"
        if v.has("__typeref__"):
            return "type"
        if v.has("__gen__"):
            return "generator"
    return t
# ---------- 字符串渲染（对齐 fmt_value） ----------
# 缺陷 125（M145）：**环保护**。此前 `var g = {}; g.set("me", g); str(g)` 在解释轨
#   无界递归 ⇒ C 栈溢出 ⇒ 段错误（编译轨 px_fmt_value 同族，两条轨同批修）。
#   语义：**路径**上的对象再次出现 ⇒ 渲染 `...`（共享而非环的对象照常完整渲染，
#   不采用累积集合——那会把 `{"p":a,"q":a}` 的第二次出现误渲染成 `...`）。
var STR_S_PATH = []
def i_to_str(v):
    let t0 = i_type_name(v)
    if t0 == "list" or t0 == "tuple" or t0 == "dict":
        let idv = object_id(v)
        if idv != 0 and contains(STR_S_PATH, idv):
            return "..."
        STR_S_PATH.append(idv)
        let r = i_to_str_raw(v)
        STR_S_PATH = STR_S_PATH[0:(len(STR_S_PATH) - 1)]
        return r
    return i_to_str_raw(v)
def i_to_str_raw(v):
    let t = i_type_name(v)
    if t == "list":
        let parts = []
        var i = 0
        while i < len(v):
            parts.append(i_to_str(v[i]))
            i += 1
        return "[" + join(", ", parts) + "]"
    if t == "tuple":
        let parts = []
        var i = 0
        while i < len(v):
            parts.append(i_to_str(v[i]))
            i += 1
        return "(" + join(", ", parts) + ")"
    if t == "dict":
        let parts = []
        let ks = v.keys()
        var i = 0
        while i < len(ks):
            parts.append(ks[i] + ": " + i_to_str(v[ks[i]]))
            i += 1
        let sp = sorted(parts)
        return "{" + join(", ", sp) + "}"
    if t == "function":
        return "<fn " + v["__ufn__"]["name"] + ">"
    if t == "native":
        return "<builtin " + v["__builtin__"] + ">"
    if t == "struct":
        return "<struct " + v["__struct__"] + ">"
    if t == "enum":
        let p = v["payload"]
        if p == null:
            return v["__enum__"] + "." + v["variant"]
        return v["__enum__"] + "." + v["variant"] + "(" + i_to_str(p) + ")"
    if t == "type":
        return "<type " + v["name"] + ">"
    if t == "generator":
        return "<gen " + str(len(v["__gen__"])) + " items, cursor=" + str(v["cursor"]) + ">"
    if t == "float":
        return i_fmt_float(v)
    return str(v)
# 浮点渲染（对齐 value.rs fmt_float）：
#   整值且有限且 |f| < 1e15 → 确保 ".0" 后缀（编译模式 str(float) 用 %g 会丢 .0）
#   M148：**非有限值在返回前短路** —— 文本仍走 `str(f)` 的**语言约定**
#     （`inf` / `-inf` / `nan`，与 golden/s09 一致；Go 的 `+Inf`/`NaN` 由
#     `go_float_text` / `fmt_float_dec` 提供），短路只为**避免 `int(±Inf)`**
#     这种未定义转换。
def i_fmt_float(f):
    var s = str(f)
    if f != f:
        return s
    if f > 1.7976931348623157e308:
        return s
    if f < (0.0 - 1.7976931348623157e308):
        return s
    var absf = f
    if f < 0.0:
        absf = -f
    # M216（缺陷 308 的连带回归 · m148_ieee_div 抓回）：`int(f)` 现在的**前置条件**是
    #   `[−2^63, 2^63)`（越界/非有限 ⇒ R1003 响亮）—— 而上面那条守卫是按 **double 范围**
    #   （`f > DBL_MAX`）短路 ±Inf/NaN，**`DBL_MAX` 本身不算越界** ⇒ 落到 `int(DBL_MAX)`
    #   ⇒ 解释轨 rc=1（修前靠 `int(DBL_MAX)` 静默给 INT64_MIN「碰巧」不出错 = 拿缺陷当护栏）。
    #   改为与后面**同一个阈值** `absf < 1e15` 短路（`and` 短路 ⇒ int(f) 必在范围内）。
    let is_int_val = absf < 1e15 and f == int(f)
    if is_int_val and absf < 1e15:
        if contains(s, ".") or contains(s, "e") or contains(s, "E") or contains(s, "inf") or contains(s, "nan"):
            return s
        return s + ".0"
    return s
# ---------- 真值（对齐 is_truthy） ----------
def i_truthy(v):
    let t = i_type_name(v)
    if t == "bool":
        return v
    if t == "int":
        return v != 0
    if t == "float":
        return v != 0.0
    if t == "null":
        return false
    if t == "string":
        return len(v) > 0
    if t == "list":
        return len(v) > 0
    if t == "dict":
        return len(v.keys()) > 0
    if t == "tuple":
        return len(v) > 0
    return true
# ---------- 相等（对齐 value.rs PartialEq） ----------
# 缺陷 125（M145）：**环保护**，语义与编译轨（runtime `compare_values`，对齐
#   Go `reflect.DeepEqual`）一致 —— 维护「已访问对象对」，再次遇到同一对 ⇒ 视为相等。
#   此前带 parent↔child 环的结构（BIRCH CF 树）上 `==` 无界递归 ⇒ 段错误。
var EQ_S_PATH = []
var EQ_S_DEPTH = 0
def eq_pair_seen(ida, idb):
    var i = 0
    while i < len(EQ_S_PATH):
        if EQ_S_PATH[i][0] == ida and EQ_S_PATH[i][1] == idb:
            return true
        i += 1
    return false
def i_eq(a, b):
    EQ_S_DEPTH += 1
    let r = i_eq_raw(a, b)
    EQ_S_DEPTH -= 1
    if EQ_S_DEPTH == 0:
        EQ_S_PATH = []
    return r
def i_eq_raw(a, b):
    let ta = i_type_name(a)
    let tb = i_type_name(b)
    if ta == "int" and tb == "int":
        return a == b
    if ta == "int" and tb == "float":
        return float(a) == b
    if ta == "float" and tb == "int":
        return a == float(b)
    if ta == "float" and tb == "float":
        return a == b
    if ta == "string" and tb == "string":
        return a == b
    if ta == "bool" and tb == "bool":
        return a == b
    if ta == "null" and tb == "null":
        return true
    # 缺陷 125（M145）：进入容器递归前登记对象对（环上不再下潜；与编译轨同源）
    if ta == "list" or ta == "tuple" or ta == "dict" or ta == "enum" or ta == "struct" or ta == "generator":
        let ida = object_id(a)
        let idb = object_id(b)
        if ida != 0 and idb != 0:
            if eq_pair_seen(ida, idb):
                return true
            EQ_S_PATH.append([ida, idb])
    if ta == "list" and tb == "list":
        if len(a) != len(b):
            return false
        var i = 0
        while i < len(a):
            if not i_eq(a[i], b[i]):
                return false
            i += 1
        return true
    if ta == "tuple" and tb == "tuple":
        if len(a) != len(b):
            return false
        var i = 0
        while i < len(a):
            if not i_eq(a[i], b[i]):
                return false
            i += 1
        return true
    if ta == "dict" and tb == "dict":
        # 普通 dict（包装值已在上层分支处理）
        let ka = a.keys()
        if len(ka) != len(b.keys()):
            return false
        var i = 0
        while i < len(ka):
            let k = ka[i]
            if not b.has(k):
                return false
            if not i_eq(a[k], b[k]):
                return false
            i += 1
        return true
    if ta == "enum" and tb == "enum":
        if a["__enum__"] != b["__enum__"]:
            return false
        if a["variant"] != b["variant"]:
            return false
        return i_eq(a["payload"], b["payload"])
    if ta == "struct" and tb == "struct":
        if a["__struct__"] != b["__struct__"]:
            return false
        let fa = a["__fields__"]
        let fb = b["__fields__"]
        let ka = fa.keys()
        if len(ka) != len(fb.keys()):
            return false
        var i = 0
        while i < len(ka):
            let k = ka[i]
            if not fb.has(k):
                return false
            if not i_eq(fa[k], fb[k]):
                return false
            i += 1
        return true
    if ta == "function" and tb == "function":
        return a["__ufn__"]["name"] == b["__ufn__"]["name"]
    if ta == "type" and tb == "type":
        return a["name"] == b["name"]
    if ta == "native" and tb == "native":
        return a["__builtin__"] == b["__builtin__"]
    if ta == "generator" and tb == "generator":
        return i_eq(a["__gen__"], b["__gen__"])
    if ta == "range" and tb == "range":
        return false
    if ta == "result" and tb == "result":
        if a.is_ok() != b.is_ok():
            return false
        return i_eq(a.ok(), b.ok()) and i_eq(a.err(), b.err())
    # M129（qg-issue 87 缺陷 43）：**bytes 按内容比较** —— 原实现漏了 bytes 分支，
    #   落到函数末尾的 `return false`（本函数是**白名单**设计，未列举类型恒不相等）。
    #   而编译轨（runtime `compare_values`）对 PX_BYTES **有**逐字节 memcmp 分支 ⇒
    #   同一程序两条轨行为相反，且解释器侧**静默错误**（不报错、只是分支走错）。
    #   影响面：所有用 `px run` 执行的自检/对拍/工具脚本（本仓库几乎全部 .px 自检都走
    #   px run）—— `bytes == bytes` 恒 false，会静默跳过断言分支。
    #   修法：hex 编码后比字符串（hex 是单射，二进制安全、含 NUL 亦无损）。
    if ta == "bytes" and tb == "bytes":
        return bytes_to_hex(a) == bytes_to_hex(b)
    # M129（缺陷 43 续）：末尾兜底对齐**编译轨**语义 —— runtime `compare_values` 的
    #   默认分支是 `strcmp(px_type_name(a), px_type_name(b))`，即「类型名相同即相等」。
    #   原实现 `return false` 会让 range 等类型与编译轨相反（`range == range`：
    #   编译轨 true / 解释器 false）。此处改为按类型名判定，与编译轨一致。
    return ta == tb
# ---------- 三态值比较（对齐编译轨 runtime `compare_values`） ----------
# M162（第 48 轮 · 缺陷 166）：**解释轨 sorted 的比较依据与编译轨不同** ——
#   旧 `i_builtin_sorted` 用 `i_to_str` 渲染串比较，编译轨用 `compare_values` 值比较：
#     `sorted([10, 9, 2])`         解释轨 [10, 2, 9]（错："10" < "2"）/ 编译轨 [2, 9, 10]
#     `sorted([[1,"a"],[1,"a2"]])` 解释轨 [[1,a2],[1,a]] / 编译轨 [[1,a],[1,a2]]
#     （后者 = 第三方 registry-px 登记的 PX-DEF-011）
#   本函数把 C 侧 `compare_values_raw` 的分支逐条复刻（含默认 `strcmp(px_type_name)`
#   兜底 ⇒ 结构体等"无专门分支"的类型按类型名判等 = 视为相等），并沿用 i_eq 的
#   **环保护**策略（已登记对象对再次出现 ⇒ 判 0，与 C 侧"不弹出"的 DeepEqual 语义一致）。
#   NaN：三态无法表达"不可比"，按 C 侧口径返回确定性非零（2 / 1 / -1，调用方看符号）。
#   ⚠️ 与 C 侧的唯一已知差异：C 的默认分支比 `px_type_name` 的 **strcmp**（字节序），
#     本函数比 i_type_name 的字符串（同为字节字典序）—— 两者对同一类型名同序。
var CMP_S_PATH = []
var CMP_S_DEPTH = 0
def cmp_pair_seen(ida, idb):
    var i = 0
    while i < len(CMP_S_PATH):
        if CMP_S_PATH[i][0] == ida and CMP_S_PATH[i][1] == idb:
            return true
        i += 1
    return false
def i_cmp_values(a, b):
    CMP_S_DEPTH += 1
    let r = i_cmp_values_raw(a, b)
    CMP_S_DEPTH -= 1
    if CMP_S_DEPTH == 0:
        CMP_S_PATH = []
    return r
def i_result_payload(v):
    if v.is_ok():
        return v.ok()
    return v.err()
def i_cmp_values_raw(a, b):
    let ta = i_type_name(a)
    let tb = i_type_name(b)
    let na = ta == "int" or ta == "float"
    let nb = tb == "int" or tb == "float"
    if ta == "int" and tb == "int":
        if a < b:
            return -1
        if a > b:
            return 1
        return 0
    if na and nb:
        let x = float(a)
        let y = float(b)
        if x != x:
            if y != y:
                return 2
            return 1
        if y != y:
            return -1
        if x < y:
            return -1
        if x > y:
            return 1
        return 0
    if ta == "string" and tb == "string":
        if a < b:
            return -1
        if a > b:
            return 1
        return 0
    if ta == "bytes" and tb == "bytes":
        let ha = bytes_to_hex(a)
        let hb = bytes_to_hex(b)
        if ha < hb:
            return -1
        if ha > hb:
            return 1
        return 0
    if ta == "bool" and tb == "bool":
        if a == b:
            return 0
        if a:
            return 1
        return -1
    if ta == "null" and tb == "null":
        return 0
    if ta == "enum" and tb == "enum":
        let va = a["variant"]
        let vb = b["variant"]
        if va < vb:
            return -1
        if va > vb:
            return 1
        return 0
    if ta == "list" or ta == "tuple" or ta == "dict" or ta == "result":
        let ida = object_id(a)
        let idb = object_id(b)
        if ida != 0 and idb != 0:
            if cmp_pair_seen(ida, idb):
                return 0
            CMP_S_PATH.append([ida, idb])
    if (ta == "list" or ta == "tuple") and (tb == "list" or tb == "tuple"):
        let la = len(a)
        let lb = len(b)
        var m = la
        if lb < m:
            m = lb
        var i = 0
        while i < m:
            let c = i_cmp_values(a[i], b[i])
            if c != 0:
                return c
            i += 1
        if la < lb:
            return -1
        if la > lb:
            return 1
        return 0
    if ta == "dict" and tb == "dict":
        let ka = a.keys()
        if len(ka) != len(b.keys()):
            if len(ka) < len(b.keys()):
                return -1
            return 1
        var i = 0
        while i < len(ka):
            let k = ka[i]
            if not b.has(k):
                return 1
            let c = i_cmp_values(a[k], b[k])
            if c != 0:
                return c
            i += 1
        return 0
    if ta == "result" and tb == "result":
        if a.is_ok() != b.is_ok():
            if a.is_ok():
                return 1
            return -1
        return i_cmp_values(i_result_payload(a), i_result_payload(b))
    if ta < tb:
        return -1
    if ta > tb:
        return 1
    return 0
# ---------- 迭代（对齐 iter_values） ----------
def i_iter(v, pos):
    let t = i_type_name(v)
    if t == "list":
        return Ok(v)
    if t == "tuple":
        return Ok(list(v))
    if t == "bytes":
        # M185（第 63 轮 · 缺陷 203）：bytes **迭代** ⇒ 逐字节 int（0..255），
        #   对齐 Python `for b in bytes` / Go `for _, b := range []byte`。
        #   修前解释轨 `R1002 此类型不可迭代`、VM/C 轨 `R1002 此类型不支持索引: bytes`
        #   ⇒ 三轨都缺且**词条还不同**（同一份源码三种行为）。
        var bout = []
        var bi = 0
        while bi < len(v):
            bout.append(bytes_get(v, bi))
            bi += 1
        return Ok(bout)
    if t == "string":
        var out = []
        var i = 0
        while i < len(v):
            out.append(v[i])
            i += 1
        return Ok(out)
    if t == "range":
        return Ok(list(v))
    if t == "dict":
        return Ok(v.keys())
    if t == "generator":
        return Ok(v["__gen__"])
    # M203（缺陷 243-b）：带**实际类型**；编译轨不再借 `len`（见 px_iter_prepare）
    return Err(i_r1002("此类型不可迭代: " + t, pos))
# ---------- 索引 ----------
def i_as_index(idx, n, pos):
    if type(idx) == "int":
        var i = idx
        if i < 0:
            i = i + n
            if i < 0:
                return Err(i_r1003("索引越界: " + i_to_str(i) + " (len=" + i_to_str(n) + ")", pos))
        if i >= n:
            return Err(i_r1003("索引越界: " + i_to_str(i) + " (len=" + i_to_str(n) + ")", pos))
        return Ok(i)
    # M179：与编译轨 px_req_int_idx 同文（修前只说「索引必须是整数」）
    return Err(i_r1002("索引必须是整数，实际是 " + i_type_name(idx), pos))
def i_index(v, idx, pos):
    let t = i_type_name(v)
    if t == "list" or t == "tuple":
        let n = len(v)
        let r = i_as_index(idx, n, pos)
        if r.is_err():
            return Err(r.err())
        var i = r.unwrap()
        if i >= n:
            return Err(i_r1003("索引越界: " + i_to_str(i) + " (len=" + i_to_str(n) + ")", pos))
        return Ok(v[i])
    if t == "string":
        # M111-S1：不再物化 n 元字符表（原每次 s[i] 为 O(n) ⇒ 循环内 O(n²)）。
        # 等价性：chars[j] ≡ v[j]（同一原生 rune 索引，len 亦同源）；原句
        # `if i >= n: 字符串索引越界` 不可达——i_as_index 已先对 i>=n 报错。
        let n = len(v)
        let r = i_as_index(idx, n, pos)
        if r.is_err():
            return Err(r.err())
        var i = r.unwrap()
        return Ok(v[i])
    if t == "bytes":
        # M185（第 63 轮 · 缺陷 203）：bytes 整数索引 ⇒ int 字节值（0..255），
        #   对齐 Python `bytes[i]` / Go `[]byte[i]`；负索引由 i_as_index 归一，
        #   越界 R1003 同码同文（与 list/string 一致）。修前落到末尾 `R1002 此类型不支持索引`。
        let bn = len(v)
        let br = i_as_index(idx, bn, pos)
        if br.is_err():
            return Err(br.err())
        return Ok(bytes_get(v, br.unwrap()))
    if t == "dict":
        if type(idx) != "string":
            return Err(i_r1002("字典索引键必须是字符串", pos))
        if v.has(idx):
            return Ok(v[idx])
        return Err(i_r1008("字典没有键 '" + idx + "'", pos))
    # M203（缺陷 243-a）：带**实际类型**（编译轨 px_index 一直如此）⇒ 三轨同文
    return Err(i_r1002("此类型不支持索引: " + t, pos))
# ---------- 字段访问（对齐 eval_field） ----------
def i_field(v, name, pos):
    let t = i_type_name(v)
    if t == "struct":
        let fs = v["__fields__"]
        if fs.has(name):
            return Ok(fs[name])
        return Err(i_r1008("结构体没有字段 '" + name + "'", pos))
    if t == "enum":
        return Err(i_r1007("枚举值 " + v["__enum__"] + "." + v["variant"] + " 没有字段 '" + name + "'", pos))
    if t == "type":
        if v["__typeref__"] == "enum":
            let en = v["name"]
            if g_enums.has(en) and contains(g_enums[en], name):
                return Ok(it_enum(en, name, null))
            return Err(i_r1008("枚举 " + en + " 没有变体 '" + name + "'", pos))
        return Err(i_r1007("类型 " + v["name"] + " 没有字段 '" + name + "'", pos))
    if t == "dict":
        if v.has(name):
            return Ok(v[name])
        return Err(i_r1008("字典没有键 '" + name + "'", pos))
    return Err(i_r1007("类型 " + t + " 没有字段 '" + name + "'", pos))
# ---------- 切片 ----------
# 返回 {"ok": bool, "idxs": [...], "err": msg}
def i_slice_indices(start, end, step, n):
    var st = 1
    if step != null:
        st = step
    if st == 0:
        return {"ok": false, "idxs": [], "err": "切片步长不能为 0"}
    var s = 0
    if start == null:
        if st < 0:
            s = n - 1
        else:
            s = 0
    else:
        s = start
        if s < 0:
            s = s + n
        if st > 0:
            if s < 0:
                s = 0
            if s > n:
                s = n
        else:
            if s < -1:
                s = -1
            if s > n - 1:
                s = n - 1
    var e = 0
    if end == null:
        if st < 0:
            e = -1
        else:
            e = n
    else:
        e = end
        if e < 0:
            e = e + n
        if st > 0:
            if e < 0:
                e = 0
            if e > n:
                e = n
        else:
            if e < -1:
                e = -1
            if e > n - 1:
                e = n - 1
    let idxs = []
    if st > 0:
        var i = s
        while i < e:
            idxs.append(i)
            i += st
    else:
        var i = s
        while i > e:
            idxs.append(i)
            i += st
    return {"ok": true, "idxs": idxs, "err": ""}
def i_slice(v, start, end, step, pos):
    # M216（第 95 轮 · 缺陷 308）：切片界与**索引位**同口径（M179/M189）—— 只收 int。
    #   修前解释轨把 float 界直接参与整数比较（`l[0:1e30]` ⇒ 整表 `[1,2,3,4,5]`），而编译
    #   两轨走 `int_val` 的 `(int64_t)1e30` = INT64_MIN（x86 `cvttsd2si` 的不定值）
    #   ⇒ `l[0:1e30]` 给 `[]`、`l[1e30:2]` 给 `[1,2]` —— **三轨分叉，且两侧都是静默错值**。
    #   收紧后三轨同码同文（与 VM/C 的 `px_req_slice_idx` 同一句话）。
    var bounds = [start, end, step]
    var bi = 0
    while bi < 3:
        if bounds[bi] != null and i_type_name(bounds[bi]) != "int":
            return Err(i_r1002("切片索引必须是整数，实际是 " + i_type_name(bounds[bi]), pos))
        bi += 1
    let t = i_type_name(v)
    if t == "bytes":
        # M185（第 63 轮 · 缺陷 203）：bytes 切片 ⇒ **bytes**（按字节），与 VM/C 轨
        #   （`px_slice` 的 kind==3 分支）逐字节一致；下标语义复用 `i_slice_indices`
        #   （与 list/tuple/string 同一条路径 ⇒ 负边界/步长/clamp 不会自成一套）。
        #   修前解释轨 `R1002 此类型不支持切片`，而编译两轨可用 ⇒ 三轨分叉。
        #   实现：逐字节取 int → 2 位十六进制 → `hex_to_bytes` 一次成型
        #   （避开 `bytes_concat` 的 O(n²)；`join` 走 M154 的线性口径）。
        let br = i_slice_indices(start, end, step, len(v))
        if not br["ok"]:
            return Err(i_r1006(br["err"], pos))
        let bidxs = br["idxs"]
        var bparts = []
        var bii = 0
        while bii < len(bidxs):
            bparts.append(int_to_hex(bytes_get(v, bidxs[bii]), 2))
            bii += 1
        return Ok(hex_to_bytes(join("", bparts)))
    if t == "string":
        # M111-S2：不再物化 n 元字符表；输出侧改「按索引取字符 → join 一次成串」，
        # 同时消除 `out += …` 的二次方拼接。等价性：取到的字符序列与索引表逐项相同。
        let r = i_slice_indices(start, end, step, len(v))
        if not r["ok"]:
            return Err(i_r1006(r["err"], pos))
        let idxs = r["idxs"]
        let parts = []
        var ii = 0
        while ii < len(idxs):
            parts.append(v[idxs[ii]])
            ii += 1
        return Ok(join("", parts))
    if t == "list":
        let r = i_slice_indices(start, end, step, len(v))
        if not r["ok"]:
            return Err(i_r1006(r["err"], pos))
        var out = []
        var ii = 0
        while ii < len(r["idxs"]):
            out.append(v[r["idxs"][ii]])
            ii += 1
        return Ok(out)
    if t == "tuple":
        let r = i_slice_indices(start, end, step, len(v))
        if not r["ok"]:
            return Err(i_r1006(r["err"], pos))
        var out = []
        var ii = 0
        while ii < len(r["idxs"]):
            out.append(v[r["idxs"][ii]])
            ii += 1
        return Ok(tuple(out))
    return Err(i_r1002("此类型不支持切片: " + t, pos))
# ---------- 一元运算（对齐 eval_unary） ----------
def i_eval_unary(op, v, pos):
    let t = i_type_name(v)
    if op == "Neg":
        if t == "int":
            return Ok(-v)
        if t == "float":
            return Ok(-v)
        return Err(i_r1002("无法取负: -" + t, pos))
    if op == "Not":
        # M179：`not` 走**真值**语义（与编译轨 px_not 一致；`if x:` / `and` / `or` 同源）。
        #   修前只收 bool ⇒ `not 1` 解释轨报错、编译轨给 false（三轨分叉）。
        return Ok(not i_truthy(v))
    if op == "BitNot":
        if t == "int":
            return Ok(-v - 1)
        return Err(i_r1002("按位取反 需要整数，实际是 " + t, pos))
    return Err(i_r1002("未知一元运算符 " + op, pos))
# ---------- 二元运算（对齐 eval_binary） ----------
def i_as_f64(v, pos):
    let t = i_type_name(v)
    if t == "int":
        return Ok(float(v))
    if t == "float":
        return Ok(v)
    return Err(i_r1002("需要数值", pos))
def i_eval_binary(op, l, r, pos):
    if op == "Add":
        return i_bin_add(l, r, pos)
    if op == "Eq":
        return Ok(i_eq(l, r))
    if op == "Ne":
        return Ok(not i_eq(l, r))
    if op == "Lt" or op == "Le" or op == "Gt" or op == "Ge":
        return i_bin_compare(op, l, r, pos)
    return i_bin_numeric(op, l, r, pos)
def i_bin_add(l, r, pos):
    let tl = i_type_name(l)
    let tr = i_type_name(r)
    if tl == "int" and tr == "int":
        return Ok(l + r)
    if tl == "int" and tr == "float":
        return Ok(float(l) + r)
    if tl == "float" and tr == "int":
        return Ok(l + float(r))
    if tl == "float" and tr == "float":
        return Ok(l + r)
    if tl == "string" and tr == "string":
        return Ok(l + r)
    if tl == "list" and tr == "list":
        var out = []
        var i = 0
        while i < len(l):
            out.append(l[i])
            i += 1
        var j = 0
        while j < len(r):
            out.append(r[j])
            j += 1
        return Ok(out)
    # M179：文案与编译轨（runtime px_add）同码同文
    return Err(i_r1002("无法相加: " + tl + " + " + tr, pos))
# ---------- M179（第 57 轮 · 缺陷 195/196）：运算族的**统一文案** ----------
# 与编译轨 runtime.c 一一对应（`px_req_num2` / `px_req_int`），三轨同码同文。
def i_bin_opname(op):
    if op == "Sub":
        return "相减"
    if op == "Mul":
        return "相乘"
    if op == "Div":
        return "相除"
    if op == "IntDiv":
        return "整除"
    if op == "Mod":
        return "取模"
    if op == "Pow":
        return "幂运算"
    return "运算"
def i_bin_opsym(op):
    if op == "Sub":
        return "-"
    if op == "Mul":
        return "*"
    if op == "Div":
        return "/"
    if op == "IntDiv":
        return "//"
    if op == "Mod":
        return "%"
    if op == "Pow":
        return "**"
    return "?"
def i_bit_opname(op):
    if op == "BitAnd":
        return "按位与"
    if op == "BitOr":
        return "按位或"
    if op == "BitXor":
        return "按位异或"
    if op == "Shl":
        return "左移"
    if op == "Shr":
        return "右移"
    if op == "ShrU":
        return "无符号右移"
    return "按位运算"
def i_bit_ops(op):
    return op == "BitAnd" or op == "BitOr" or op == "BitXor" or op == "Shl" or op == "Shr" or op == "ShrU"
def i_bin_numeric(op, l, r, pos):
    let tl = i_type_name(l)
    let tr = i_type_name(r)
    if tl == "int" and tr == "int":
        if op == "Sub":
            return Ok(l - r)
        if op == "Mul":
            return Ok(l * r)
        if op == "Div":
            # M148（缺陷 118）：`/` = IEEE 754 浮点除法，永不报错（÷0 → ±Inf / NaN）。
            #   整数操作数也走浮点除法（语言定义：`/` 就是浮点除法，`//` 才是整除）
            #   ⇒ 与 C 轨 px_div / VM 轨 PXOP_DIV 逐字对齐。修前这里对 r==0 报
            #   R1006「除零错误」。
            return Ok(float(l) / float(r))
        if op == "IntDiv":
            if r == 0:
                return Err(i_r1006("除零错误", pos))
            return Ok(l // r)
        if op == "Mod":
            if r == 0:
                return Err(i_r1006("除零错误", pos))
            return Ok(l % r)
        if op == "Pow":
            return Ok(l ** r)
        if op == "Shl":
            return Ok(l << r)
        if op == "Shr":
            return Ok(l >> r)
        if op == "ShrU":
            return Ok(i_shr_u(l, r))
        if op == "BitAnd":
            return Ok(l & r)
        if op == "BitOr":
            return Ok(l | r)
        if op == "BitXor":
            return Ok(l ^ r)
        return Err(i_r1002("未知运算符 " + op, pos))
    # M179：`str * int` = 重复（编译轨 px_mul 一直支持；修前解释轨报「需要数值」⇒ 分叉）
    #   n <= 0 ⇒ 空串（对齐 Python；编译轨同批修了负数下 xmalloc 的尺寸溢出）
    if tl == "string" and tr == "int":
        return Ok(l * r)
    # M179：类型守卫 —— 与编译轨 px_req_num2 同码同文
    let ln = tl == "int" or tl == "float"
    let rn = tr == "int" or tr == "float"
    if not (ln and rn):
        if i_bit_ops(op):
            let nmb = i_bit_opname(op)
            if not ln:
                return Err(i_r1002(nmb + " 需要整数，实际是 " + tl, pos))
            return Err(i_r1002(nmb + " 需要整数，实际是 " + tr, pos))
        return Err(i_r1002("无法" + i_bin_opname(op) + ": " + tl + " " + i_bin_opsym(op) + " " + tr, pos))
    let a = float(l)
    var b = float(r)
    if op == "Sub":
        return Ok(a - b)
    if op == "Mul":
        return Ok(a * b)
    if op == "Div":
        # M148（缺陷 118）：同上 —— 浮点除法完全 IEEE（÷0 → ±Inf / NaN）
        return Ok(a / b)
    if op == "IntDiv":
        if b == 0.0:
            return Err(i_r1006("除零错误", pos))
        return Ok(a // b)
    if op == "Mod":
        return Ok(a % b)
    if op == "Pow":
        return Ok(a ** b)
    # M179：位运算要求整数（至少一个 float 走到这里）—— 与编译轨 px_req_int 同文
    if i_bit_ops(op):
        let nmb2 = i_bit_opname(op)
        if tl != "int":
            return Err(i_r1002(nmb2 + " 需要整数，实际是 " + tl, pos))
        return Err(i_r1002(nmb2 + " 需要整数，实际是 " + tr, pos))
    return Err(i_r1002("此运算符要求整数操作数", pos))
# 逻辑右移（对齐 Rust (a as u64).wrapping_shr(b) as i64）
# 负数补码：算术右移后清除符号扩展的高位
#   mask = 2^(64-b) - 1 = (2^63 - 1) >> (b-1)
def i_shr_u(a, b):
    if b >= 64:
        b = b % 64
    if b == 0:
        return a
    if a >= 0:
        return a >> b
    let shifted = a >> b
    let mask = 9223372036854775807 >> (b - 1)
    return shifted & mask
def i_bin_compare(op, l, r, pos):
    let tl = i_type_name(l)
    let tr = i_type_name(r)
    # ---------- M215（第 94 轮 · 缺陷 307）：int 对 int 必须**按整数**比较 ----------
    #   修前这里**一律**走下面的 `float(l) < float(r)`，而 double 只有 53 位尾数 ⇒
    #   超过 2^53 的整数被舍入到**同一个** double ⇒
    #       `9223372036854775806 < 9223372036854775807` 给 **false**（真值 true）
    #       `2^53 < 2^53+1` 给 false · `2^62-1 < 2^62` 给 false · `INT64_MIN < INT64_MIN+1` 给 false
    #   而编译轨（runtime `px_lt/le/gt/ge`）**第一分支**就是 `a.as.i < b.as.i` ⇒ **三轨分叉**。
    #   本分支与 runtime 那四个函数逐条对齐：int-int ⇒ 整数；其余数值组合 ⇒ double。
    #   （`i_cmp_values_raw` 早就有同款 int-int 分支 —— 故 `sorted`/`min`/`max` 是对的、
    #    只有**比较运算符**这一条路漏了，属于「同一语义面只收口了一处」的旧疾。）
    #   权威口径：docs/PUXIAN_CHEATSHEET.md 事实 240。
    if tl == "int" and tr == "int":
        if op == "Lt":
            return Ok(l < r)
        if op == "Le":
            return Ok(l <= r)
        if op == "Gt":
            return Ok(l > r)
        if op == "Ge":
            return Ok(l >= r)
    let ln = tl == "int" or tl == "float"
    let rn = tr == "int" or tr == "float"
    if ln and rn:
        let a = float(l)
        var b = float(r)
        if op == "Lt":
            return Ok(a < b)
        if op == "Le":
            return Ok(a <= b)
        if op == "Gt":
            return Ok(a > b)
        if op == "Ge":
            return Ok(a >= b)
    # M179：**同类型** ⇒ 走值比较器（与编译轨 compare_values 同源：str/bytes/bool/list/dict/
    #   enum/… 全覆盖）；**跨型** ⇒ 响亮报错（与编译轨 px_req_cmp 同码同文）。
    #   修前：str-str 之外一律报「比较不支持」⇒ `[1] < [2]` 解释轨报错、编译轨给 true。
    if tl != tr:
        return Err(i_r1002("无法比较: " + tl + " vs " + tr, pos))
    let c = i_cmp_values(l, r)
    if op == "Lt":
        return Ok(c < 0)
    if op == "Le":
        return Ok(c <= 0)
    if op == "Gt":
        return Ok(c > 0)
    if op == "Ge":
        return Ok(c >= 0)
    return Err(i_r1002("未知比较运算 " + op, pos))
