# ============================================================
# M-B7: ival.px —— interp 值层（对齐 interp.rs 的值操作）
# ------------------------------------------------------------
# 对齐项：
#   type_name → i_type_name
#   fmt_value → i_to_str
#   is_truthy → i_truthy
#   PartialEq → i_eq
#   iter_values → i_iter
#   eval_index/as_index → i_index/i_as_index
#   eval_field → i_field
#   eval_slice/slice_indices → i_slice/i_slice_indices
#   eval_unary → i_eval_unary
#   eval_binary/bin_add/bin_numeric/bin_compare → i_eval_binary 系列
# ------------------------------------------------------------
# 设计：PuXian 原生值（int/float/str/bool/null/list/dict/tuple/result/range/bytes）
# 的运算符/方法/str/type 已与 Rust 版对齐（M0-M40 双模式验证），
# 直接透传；本层只补：包装值（fn/struct/enum/typeref/gen/builtin）的语义
# + 容器递归（可能内嵌包装值）+ 错误消息对齐。
# 返回 Result 的函数用 ? 传播子错误（仅 i_call_function 边界区分 __prop__）。
# ============================================================

# ---------- 类型名（对齐 interp.rs type_name） ----------
def i_type_name(v):
    let t = type(v)
    if t == "dict":
        if v.has("__ufn__"):
            return "fn"
        if v.has("__builtin__"):
            return "builtin"
        if v.has("__struct__"):
            return "struct"
        if v.has("__enum__"):
            return "enum"
        if v.has("__typeref__"):
            return "type"
        if v.has("__gen__"):
            return "generator"
    return t

# ---------- 字符串渲染（对齐 fmt_value） ----------
def i_to_str(v):
    let t = i_type_name(v)
    if t == "list":
        let parts = []
        let i = 0
        while i < len(v):
            parts.append(i_to_str(v[i]))
            i += 1
        return "[" + join(", ", parts) + "]"
    if t == "tuple":
        let parts = []
        let i = 0
        while i < len(v):
            parts.append(i_to_str(v[i]))
            i += 1
        return "(" + join(", ", parts) + ")"
    if t == "dict":
        let parts = []
        let ks = v.keys()
        let i = 0
        while i < len(ks):
            parts.append(ks[i] + ": " + i_to_str(v[ks[i]]))
            i += 1
        let sp = sorted(parts)
        return "{" + join(", ", sp) + "}"
    if t == "fn":
        return "<fn " + v["__ufn__"]["name"] + ">"
    if t == "builtin":
        return "<builtin " + v["__builtin__"] + ">"
    if t == "struct":
        return "<struct " + v["__struct__"] + ">"
    if t == "enum":
        let p = v["payload"]
        if p == null:
            return v["__enum__"] + "." + v["variant"]
        return v["__enum__"] + "." + v["variant"] + "(" + i_to_str(p) + ")"
    if t == "type":
        return "<type " + v["name"] + ">"
    if t == "generator":
        return "<gen " + str(len(v["__gen__"])) + " items, cursor=" + str(v["cursor"]) + ">"
    if t == "float":
        return i_fmt_float(v)
    return str(v)

# 浮点渲染（对齐 value.rs fmt_float）：
#   整值且有限且 |f| < 1e15 → 确保 ".0" 后缀（编译模式 str(float) 用 %g 会丢 .0）
def i_fmt_float(f):
    let s = str(f)
    let absf = f
    if f < 0.0:
        absf = -f
    let is_int_val = f == int(f)
    if is_int_val and absf < 1e15:
        if contains(s, ".") or contains(s, "e") or contains(s, "E") or contains(s, "inf") or contains(s, "nan"):
            return s
        return s + ".0"
    return s

# ---------- 真值（对齐 is_truthy） ----------
def i_truthy(v):
    let t = i_type_name(v)
    if t == "bool":
        return v
    if t == "int":
        return v != 0
    if t == "float":
        return v != 0.0
    if t == "null":
        return false
    if t == "string":
        return len(v) > 0
    if t == "list":
        return len(v) > 0
    if t == "dict":
        return len(v.keys()) > 0
    if t == "tuple":
        return len(v) > 0
    return true

# ---------- 相等（对齐 value.rs PartialEq） ----------
def i_eq(a, b):
    let ta = i_type_name(a)
    let tb = i_type_name(b)
    if ta == "int" and tb == "int":
        return a == b
    if ta == "int" and tb == "float":
        return float(a) == b
    if ta == "float" and tb == "int":
        return a == float(b)
    if ta == "float" and tb == "float":
        return a == b
    if ta == "string" and tb == "string":
        return a == b
    if ta == "bool" and tb == "bool":
        return a == b
    if ta == "null" and tb == "null":
        return true
    if ta == "list" and tb == "list":
        if len(a) != len(b):
            return false
        let i = 0
        while i < len(a):
            if not i_eq(a[i], b[i]):
                return false
            i += 1
        return true
    if ta == "tuple" and tb == "tuple":
        if len(a) != len(b):
            return false
        let i = 0
        while i < len(a):
            if not i_eq(a[i], b[i]):
                return false
            i += 1
        return true
    if ta == "dict" and tb == "dict":
        # 普通 dict（包装值已在上层分支处理）
        let ka = a.keys()
        if len(ka) != len(b.keys()):
            return false
        let i = 0
        while i < len(ka):
            let k = ka[i]
            if not b.has(k):
                return false
            if not i_eq(a[k], b[k]):
                return false
            i += 1
        return true
    if ta == "enum" and tb == "enum":
        if a["__enum__"] != b["__enum__"]:
            return false
        if a["variant"] != b["variant"]:
            return false
        return i_eq(a["payload"], b["payload"])
    if ta == "struct" and tb == "struct":
        if a["__struct__"] != b["__struct__"]:
            return false
        let fa = a["__fields__"]
        let fb = b["__fields__"]
        let ka = fa.keys()
        if len(ka) != len(fb.keys()):
            return false
        let i = 0
        while i < len(ka):
            let k = ka[i]
            if not fb.has(k):
                return false
            if not i_eq(fa[k], fb[k]):
                return false
            i += 1
        return true
    if ta == "fn" and tb == "fn":
        return a["__ufn__"]["name"] == b["__ufn__"]["name"]
    if ta == "type" and tb == "type":
        return a["name"] == b["name"]
    if ta == "builtin" and tb == "builtin":
        return a["__builtin__"] == b["__builtin__"]
    if ta == "generator" and tb == "generator":
        return i_eq(a["__gen__"], b["__gen__"])
    if ta == "range" and tb == "range":
        return false
    if ta == "result" and tb == "result":
        if a.is_ok() != b.is_ok():
            return false
        return i_eq(a.ok(), b.ok()) and i_eq(a.err(), b.err())
    return false

# ---------- 迭代（对齐 iter_values） ----------
def i_iter(v, pos):
    let t = i_type_name(v)
    if t == "list":
        return Ok(v)
    if t == "tuple":
        return Ok(list(v))
    if t == "string":
        let out = []
        let i = 0
        while i < len(v):
            out.append(v[i])
            i += 1
        return Ok(out)
    if t == "range":
        return Ok(list(v))
    if t == "dict":
        return Ok(v.keys())
    if t == "generator":
        return Ok(v["__gen__"])
    return Err(i_r1002("此类型不可迭代", pos))

# ---------- 索引 ----------
def i_as_index(idx, n, pos):
    if type(idx) == "int":
        let i = idx
        if i < 0:
            i = i + n
            if i < 0:
                return Err(i_r1003("索引越界", pos))
        if i >= n:
            return Err(i_r1003("索引越界", pos))
        return Ok(i)
    return Err(i_r1002("索引必须是整数", pos))

def i_index(v, idx, pos):
    let t = i_type_name(v)
    if t == "list" or t == "tuple":
        let n = len(v)
        let r = i_as_index(idx, n, pos)
        if r.is_err():
            return Err(r.err())
        let i = r.unwrap()
        if i >= n:
            return Err(i_r1003("列表索引越界", pos))
        return Ok(v[i])
    if t == "string":
        let chars = []
        let ci = 0
        while ci < len(v):
            chars.append(v[ci])
            ci += 1
        let n = len(chars)
        let r = i_as_index(idx, n, pos)
        if r.is_err():
            return Err(r.err())
        let i = r.unwrap()
        if i >= n:
            return Err(i_r1003("字符串索引越界", pos))
        return Ok(chars[i])
    if t == "dict":
        if type(idx) != "string":
            return Err(i_r1002("字典索引键必须是字符串", pos))
        if v.has(idx):
            return Ok(v[idx])
        return Err(i_r1008("字典没有键 '" + idx + "'", pos))
    return Err(i_r1002("此类型不支持索引", pos))

# ---------- 字段访问（对齐 eval_field） ----------
def i_field(v, name, pos):
    let t = i_type_name(v)
    if t == "struct":
        let fs = v["__fields__"]
        if fs.has(name):
            return Ok(fs[name])
        return Err(i_r1008("结构体没有字段 '" + name + "'", pos))
    if t == "enum":
        return Err(i_r1007("枚举值 " + v["__enum__"] + "." + v["variant"] + " 没有字段 '" + name + "'", pos))
    if t == "type":
        if v["__typeref__"] == "enum":
            let en = v["name"]
            if g_enums.has(en) and contains(g_enums[en], name):
                return Ok(it_enum(en, name, null))
            return Err(i_r1008("枚举 " + en + " 没有变体 '" + name + "'", pos))
        return Err(i_r1007("类型 " + v["name"] + " 没有字段 '" + name + "'", pos))
    if t == "dict":
        if v.has(name):
            return Ok(v[name])
        return Err(i_r1008("字典没有键 '" + name + "'", pos))
    return Err(i_r1007("类型 " + t + " 没有字段 '" + name + "'", pos))

# ---------- 切片 ----------
# 返回 {"ok": bool, "idxs": [...], "err": msg}
def i_slice_indices(start, end, step, n):
    let st = 1
    if step != null:
        st = step
    if st == 0:
        return {"ok": false, "idxs": [], "err": "切片步长不能为 0"}
    let s = 0
    if start == null:
        if st < 0:
            s = n - 1
        else:
            s = 0
    else:
        s = start
        if s < 0:
            s = s + n
        if st > 0:
            if s < 0:
                s = 0
            if s > n:
                s = n
        else:
            if s < -1:
                s = -1
            if s > n - 1:
                s = n - 1
    let e = 0
    if end == null:
        if st < 0:
            e = -1
        else:
            e = n
    else:
        e = end
        if e < 0:
            e = e + n
        if st > 0:
            if e < 0:
                e = 0
            if e > n:
                e = n
        else:
            if e < -1:
                e = -1
            if e > n - 1:
                e = n - 1
    let idxs = []
    if st > 0:
        let i = s
        while i < e:
            idxs.append(i)
            i += st
    else:
        let i = s
        while i > e:
            idxs.append(i)
            i += st
    return {"ok": true, "idxs": idxs, "err": ""}

def i_slice(v, start, end, step, pos):
    let t = i_type_name(v)
    if t == "string":
        let chars = []
        let ci = 0
        while ci < len(v):
            chars.append(v[ci])
            ci += 1
        let r = i_slice_indices(start, end, step, len(chars))
        if not r["ok"]:
            return Err(i_r1002(r["err"], pos))
        let out = ""
        let ii = 0
        while ii < len(r["idxs"]):
            out += chars[r["idxs"][ii]]
            ii += 1
        return Ok(out)
    if t == "list":
        let r = i_slice_indices(start, end, step, len(v))
        if not r["ok"]:
            return Err(i_r1002(r["err"], pos))
        let out = []
        let ii = 0
        while ii < len(r["idxs"]):
            out.append(v[r["idxs"][ii]])
            ii += 1
        return Ok(out)
    if t == "tuple":
        let r = i_slice_indices(start, end, step, len(v))
        if not r["ok"]:
            return Err(i_r1002(r["err"], pos))
        let out = []
        let ii = 0
        while ii < len(r["idxs"]):
            out.append(v[r["idxs"][ii]])
            ii += 1
        return Ok(tuple(out))
    return Err(i_r1002("此类型不支持切片", pos))

# ---------- 一元运算（对齐 eval_unary） ----------
def i_eval_unary(op, v, pos):
    let t = i_type_name(v)
    if op == "Neg":
        if t == "int":
            return Ok(-v)
        if t == "float":
            return Ok(-v)
        return Err(i_r1002("一元负号需要数值", pos))
    if op == "Not":
        if t == "bool":
            return Ok(not v)
        return Err(i_r1002("not 需要布尔值", pos))
    if op == "BitNot":
        if t == "int":
            return Ok(-v - 1)
        return Err(i_r1002("按位取反需要整数", pos))
    return Err(i_r1002("未知一元运算符 " + op, pos))

# ---------- 二元运算（对齐 eval_binary） ----------
def i_as_f64(v, pos):
    let t = i_type_name(v)
    if t == "int":
        return Ok(float(v))
    if t == "float":
        return Ok(v)
    return Err(i_r1002("需要数值", pos))

def i_eval_binary(op, l, r, pos):
    if op == "Add":
        return i_bin_add(l, r, pos)
    if op == "Eq":
        return Ok(i_eq(l, r))
    if op == "Ne":
        return Ok(not i_eq(l, r))
    if op == "Lt" or op == "Le" or op == "Gt" or op == "Ge":
        return i_bin_compare(op, l, r, pos)
    return i_bin_numeric(op, l, r, pos)

def i_bin_add(l, r, pos):
    let tl = i_type_name(l)
    let tr = i_type_name(r)
    if tl == "int" and tr == "int":
        return Ok(l + r)
    if tl == "int" and tr == "float":
        return Ok(float(l) + r)
    if tl == "float" and tr == "int":
        return Ok(l + float(r))
    if tl == "float" and tr == "float":
        return Ok(l + r)
    if tl == "string" and tr == "string":
        return Ok(l + r)
    if tl == "list" and tr == "list":
        let out = []
        let i = 0
        while i < len(l):
            out.append(l[i])
            i += 1
        let j = 0
        while j < len(r):
            out.append(r[j])
            j += 1
        return Ok(out)
    return Err(i_r1002("+ 不支持: " + tl + " + " + tr, pos))

def i_bin_numeric(op, l, r, pos):
    let tl = i_type_name(l)
    let tr = i_type_name(r)
    if tl == "int" and tr == "int":
        if op == "Sub":
            return Ok(l - r)
        if op == "Mul":
            return Ok(l * r)
        if op == "Div":
            if r == 0:
                return Err(i_r1006("除零错误", pos))
            return Ok(float(l) / float(r))
        if op == "IntDiv":
            if r == 0:
                return Err(i_r1006("除零错误", pos))
            return Ok(l // r)
        if op == "Mod":
            if r == 0:
                return Err(i_r1006("除零错误", pos))
            return Ok(l % r)
        if op == "Pow":
            return Ok(l ** r)
        if op == "Shl":
            return Ok(l << r)
        if op == "Shr":
            return Ok(l >> r)
        if op == "ShrU":
            return Ok(i_shr_u(l, r))
        if op == "BitAnd":
            return Ok(l & r)
        if op == "BitOr":
            return Ok(l | r)
        if op == "BitXor":
            return Ok(l ^ r)
        return Err(i_r1002("未知运算符 " + op, pos))
    let ar = i_as_f64(l, pos)
    if ar.is_err():
        return Err(ar.err())
    let br = i_as_f64(r, pos)
    if br.is_err():
        return Err(br.err())
    let a = ar.unwrap()
    let b = br.unwrap()
    if op == "Sub":
        return Ok(a - b)
    if op == "Mul":
        return Ok(a * b)
    if op == "Div":
        if b == 0.0:
            return Err(i_r1006("除零错误", pos))
        return Ok(a / b)
    if op == "IntDiv":
        if b == 0.0:
            return Err(i_r1006("除零错误", pos))
        return Ok(a // b)
    if op == "Mod":
        return Ok(a % b)
    if op == "Pow":
        return Ok(a ** b)
    return Err(i_r1002("此运算符要求整数操作数", pos))

# 逻辑右移（对齐 Rust (a as u64).wrapping_shr(b) as i64）
# 负数补码：算术右移后清除符号扩展的高位
#   mask = 2^(64-b) - 1 = (2^63 - 1) >> (b-1)
def i_shr_u(a, b):
    if b >= 64:
        b = b % 64
    if b == 0:
        return a
    if a >= 0:
        return a >> b
    let shifted = a >> b
    let mask = 9223372036854775807 >> (b - 1)
    return shifted & mask

def i_bin_compare(op, l, r, pos):
    let tl = i_type_name(l)
    let tr = i_type_name(r)
    let ln = tl == "int" or tl == "float"
    let rn = tr == "int" or tr == "float"
    if ln and rn:
        let a = float(l)
        let b = float(r)
        if op == "Lt":
            return Ok(a < b)
        if op == "Le":
            return Ok(a <= b)
        if op == "Gt":
            return Ok(a > b)
        if op == "Ge":
            return Ok(a >= b)
    if tl == "string" and tr == "string":
        if op == "Lt":
            return Ok(l < r)
        if op == "Le":
            return Ok(l <= r)
        if op == "Gt":
            return Ok(l > r)
        if op == "Ge":
            return Ok(l >= r)
    return Err(i_r1002("比较不支持: " + tl + " vs " + tr, pos))
