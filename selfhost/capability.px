section("4. 文件 IO")
# ============================================================
var tmp = "/tmp/px_b1_cap.txt"
write_file(tmp, "line1\nline2\n")
check("write_file + read_file", read_file(tmp) == "line1\nline2\n")
append_file(tmp, "line3\n")
check("append_file 追加", read_file(tmp) == "line1\nline2\nline3\n")
check("exists 存在", exists(tmp))
check("file_size 大小", file_size(tmp) == 18)
var lines = split(read_file(tmp), "\n")
check("读文件按行分割", lines[0] == "line1" and lines[2] == "line3")
remove(tmp)
check("remove 删除", not exists(tmp))
# 目录
var d = "/tmp/px_b1_dir"
mkdir(d)
write_file(d + "/a.txt", "A")
write_file(d + "/b.txt", "B")
var entries = list_dir(d)
check("list_dir 目录列举", len(entries) >= 2)
check("list_dir 包含文件", contains(entries, "a.txt") and contains(entries, "b.txt"))
remove(d + "/a.txt")
remove(d + "/b.txt")
remove(d)

