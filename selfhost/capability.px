section("5. 进程调用（os_spawn → gcc 工具链）")
# ============================================================
# 验证 os_spawn 能调用外部进程（写编译器需要调 gcc）
var pid = os_spawn("/bin/echo", ["b1-proc-ok"])
check("os_spawn 返回 PID", pid != null and pid > 0)
var code = os_wait(pid)
check("os_wait 退出码", code == 0)
# 验证 gcc 可用（自举后端依赖）
var gcc_pid = os_spawn("gcc", ["--version"])
check("gcc 可用（自举后端）", gcc_pid != null)
os_wait(gcc_pid)
# 环境变量
var home = env("HOME")
check("env 环境变量", home != null and len(home) > 0)

# ============================================================
section("6. Result / Option 错误处理（M39）")
# ============================================================
var a = Ok(42)
check("Ok 构造", type(a) == "result" and a.is_ok())
check("Result 解包 unwrap", a.unwrap() == 42)
var b = Err("boom")
check("Err 构造", b.is_err())
check("Result err 方法", b.err() == "boom")
# 嵌套解包
var c = Ok(Ok(7))
check("Result 嵌套", c.unwrap().unwrap() == 7)
# Some/None
check("Some 构造", Some(5) == 5 and Some(null) == null)
# ? 传播（写编译器核心：失败快速返回）
def try_div(x, y):
    if y == 0:
        return Err("div0")
    return Ok(x // y)

def chain(x):
    let v = try_div(x, 2)?
    var w = try_div(v, 3)?
    return Ok(w + 1)

var r1 = chain(12)
check("? 传播成功链", r1.is_ok() and r1.unwrap() == 3)
def chain_err():
    let v = try_div(10, 0)?
    return Ok(v)

var r2 = chain_err()
check("? 传播错误返回", r2.is_err() and r2.err() == "div0")
# ! 强制解包
var d = Ok(99)
check("! 强制解包", d! == 99)
# Result 的 JSON 序列化
var ej = json_stringify(Ok(5))
check("Result json", contains(ej, "\"ok\"") and contains(ej, "5"))

# ============================================================
section("7. 字符串插值（M40）")
# ============================================================
var name = "px"
var ver = 1
var kv = {"k": 2, "k1": 3}
check("插值-变量", "hello ${name}" == "hello px")
check("插值-表达式", "${1 + 2 * 3}" == "7")
check("插值-混合", "v${ver}.${name}" == "v1.px")
var kv_v = kv["k"]
check("插值-属性/索引", "${kv_v}" == "2")
check("插值-转义", "\${name}" == "$" + "{name}")
var kn = "k" + str(ver)
check("插值-嵌套", "${kv[kn]}" == "3")

# ============================================================
section("8. enum + match（AST 表示）")
# ============================================================
enum TokenKind:
    Int
    Ident
    Str
    Kw
    Eof

def kind_name(k):
    var r = match k:
        case Int:
            "int"
        case Ident:
            "ident"
        case Str:
            "str"
        case Kw:
            "kw"
        case Eof:
            "eof"
    return r

check("enum 构造+match 基础", kind_name(TokenKind.Ident) == "ident")
check("enum 相等比较", TokenKind.Int == TokenKind.Int)
check("enum 不相等", TokenKind.Int != TokenKind.Eof)
# AST 节点表示：无 payload enum（判别）+ struct（载荷）
# 注：data enum（带值变体）当前为半成品（payload 不存实际值），
#     自举编译器 AST 用「enum 判别 + struct 载荷」组合（Mini 子集锁定）
enum ExprKind:
    Number
    StrLit
    Call
    BinOp

struct AstNode:
    kind: ExprKind
    value: int
    name: str
    args: list

var n1 = AstNode(ExprKind.Number, 7, "", [])
check("enum+struct 表示 AST 节点", n1.kind == ExprKind.Number and n1.value == 7)
var call = AstNode(ExprKind.Call, 0, "fib", [1, 2])
check("struct 载荷 args", call.name == "fib" and len(call.args) == 2)
# match 判别分发（自举编译器核心模式）
def node_desc(node):
    var r = match node.kind:
        case Number:
            "num:" + str(node.value)
        case StrLit:
            "str"
        case Call:
            "call:" + node.name
        case BinOp:
            "bin"
    return r
check("match 分发 AST 节点", node_desc(n1) == "num:7")
check("match 分发 call", node_desc(call) == "call:fib")

# ============================================================
section("9. list / dict 容器")
# ============================================================
var lst = [1, 2, 3]
lst.append(4)
check("list append", len(lst) == 4 and lst[3] == 4)
check("list 切片", lst[1:3] == [2, 3])
check("list 负数索引", lst[-1] == 4)
check("list contains", contains(lst, 3) and not contains(lst, 99))
var rev = reversed(lst)
check("reversed 反转", rev[0] == 4 and rev[3] == 1)
check("sorted 排序", sorted([3, 1, 2]) == [1, 2, 3])
var dct = {"a": 1, "b": 2}
dct["c"] = 3
check("dict 增改", dct["c"] == 3 and len(dct) == 3)
var ks = dct.keys()
check("dict keys", contains(ks, "a") and contains(ks, "c"))
var vs = dct.values()
check("dict values", len(vs) == 3)
check("dict has", dct.has("b") and not dct.has("z"))
check("dict remove", dct.remove("a") and not dct.has("a"))
check("dict get 默认值", dct.get("zz", 9) == 9)
# 二维嵌套
var matrix = [[1, 2], [3, 4]]
check("二维列表", matrix[1][0] == 3)
var deep = {"x": {"y": [{"z": 42}]}}
check("深嵌套访问", deep["x"]["y"][0]["z"] == 42)

# ============================================================
section("10. 函数/闭包/高阶函数/递归")
# ============================================================
# 递归
def fact(n):
    if n <= 1:
        return 1
    return n * fact(n - 1)
check("递归 fact", fact(5) == 120)
# 高阶函数
check("map", map([1, 2, 3], fn(x) { x * 2 }) == [2, 4, 6])
check("filter", filter([1, 2, 3, 4], fn(x) { x > 2 }) == [3, 4])
check("reduce", reduce([1, 2, 3, 4], fn(a, b) { a + b }, 0) == 10)
# 闭包：编译模式仅支持无捕获闭包（捕获外部变量在 C 后端不可用，Mini 子集排除）
def make_outer():
    let f = fn() { return 42 }
    return f
var k = make_outer()
check("闭包（无捕获）", k() == 42)
# 默认参数
def greet(who, punct = "!"):
    return "hi " + who + punct
check("默认参数", greet("px") == "hi px!" and greet("px", "?") == "hi px?")
# 可变参数：当前不支持 *args（spec 超前，Mini 子集排除）→ 用 list 参数
def sum_all(xs):
    var t = 0
    for x in xs:
        t += x
    return t
check("list 参数聚合", sum_all([1, 2, 3, 4]) == 10)
# 关键字参数
def cfg(host, port = 8080, tls = false):
    if tls:
        return host + ":" + str(port) + "s"
    return host + ":" + str(port)
check("关键字参数", cfg("localhost") == "localhost:8080")
check("关键字参数-tls", cfg("localhost", 8080, true) == "localhost:8080s")

# ============================================================
section("11. 控制流")
# ============================================================
# for + range
var acc = 0
for i in range(5):
    acc += i
check("for range 累加", acc == 10)
# while
var w = 0
while w < 3:
    w += 1
check("while 循环", w == 3)
# break / continue
var bc = 0
for i in range(10):
    if i == 2:
        continue
    if i == 5:
        break
    bc += 1
check("break/continue", bc == 4)
# 列表推导式
check("列表推导式", [x * x for x in range(5)] == [0, 1, 4, 9, 16])
check("推导式带条件", [x for x in range(6) if x % 2 == 0] == [0, 2, 4])
# dict 推导式
var dc = {str(x): x for x in range(3)}
check("dict 推导式", dc["1"] == 1 and dc["2"] == 2)
# 生成器表达式
var g = (x * 2 for x in range(4))
check("生成器 gen_next", gen_next(g) == 0 and gen_next(g) == 2)
var g2 = (x for x in range(3))
check("生成器 list 转换", list(g2) == [0, 1, 2])
# 三元/可选链/空合并
var t1 = if true: 5 else: 9
check("三元表达式", t1 == 5)
var d1 = {"a": {"b": 42}}
check("可选链 ?.", d1?.a?.b == 42)
var d2 = {"a": null}
check("可选链短路", d2?.a?.b == null)
check("空合并 ??", (d2["a"] ?? 99) == 99)
# match 表达式
var mv = match 3:
    case 1:
        "one"
    case 3:
        "three"
    case _:
        "other"
check("match 表达式", mv == "three")

