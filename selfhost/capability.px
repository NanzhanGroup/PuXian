section("14. 位运算 / 进制")
# ============================================================
check("位与", (0b1100 & 0b1010) == 0b1000)
check("位或", (0b1100 | 0b1010) == 0b1110)
check("位移", (1 << 4) == 16 and (16 >> 2) == 4)
check("hex 转换", hex_to_int("ff") == 255 and int_to_hex(255, 2) == "ff")
var bb = int_to_bytes(258, 2)
check("bytes 转换", bytes_to_int(bb) == 258 and type(bb) == "bytes")

