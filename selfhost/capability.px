print("")
print("========== 能力自检汇总 ==========")
print("PASS: " + str(g_pass) + "  FAIL: " + str(g_fail))
if g_fail > 0:
    print("失败项：")
    for f in g_fails:
        print("  - " + f)
    exit(1)
else:
    print("门禁通过：写编译器所需能力全部具备 ✅")
