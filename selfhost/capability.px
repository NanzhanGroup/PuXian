section("15. M41 类型系统还债（不可变 E3002 / 空安全 E3003）")
# ============================================================
# M41.2 不可变：let 默认不可变、let mut/var 可变（E3002 为编译期错误，解释器宽松）
let m_imm = 1
var m_mut = 2
m_mut = 3
check("let 不可变 + var 可变", m_imm == 1 and m_mut == 3)
# M41.3 空安全：T? 可空类型声明 + null 赋值（编译模式通过、E3003 不触发）
var n_a: int? = null
var n_b: int? = 5
var n_c: int = 9
check("可空类型赋 null", n_a == null)
check("可空类型非 null + ?? 空合并", n_b ?? 0 == 5)
check("非空类型正常", n_c == 9)

# ============================================================
section("16. M41.4 定义级泛型（类型擦除）")
# ============================================================
# 泛型函数 def first[T]：返回列表首元素
def first[T](items: list[T]) -> T:
    return items[0]

# 泛型函数多参数 + 约束 T: Comparable（约束仅记录，渐进不强制）
def swap2[K, V](k: K, v: V) -> V:
    return v

def max2[T: Comparable](a: T, b: T) -> T:
    if a > b:
        return a
    return b

# 泛型结构体 struct Box[T] / Pair[A, B]
struct Box[T]:
    value: T
    tag: str

struct Pair[A, B]:
    x: A
    y: B

check("泛型函数 first[int]", first([10, 20, 30]) == 10)
check("泛型函数 first[str]", first(["甲", "乙"]) == "甲")
check("泛型函数 swap2 多参数", swap2(1, "one") == "one")
check("泛型函数 max2 约束", max2(3, 7) == 7)
var gb = Box("内容", "b")
check("泛型结构体 Box[T]", gb.value == "内容" and gb.tag == "b")
var gp = Pair(1, "一")
check("泛型结构体 Pair[A,B]", gp.x == 1 and gp.y == "一")
# 泛型与类型标注混用（渐进：标注不参与运行时）
var gnums: list[int] = [5, 6, 7]
check("泛型+类型标注", first(gnums) == 5)

# ============================================================
section("17. C-FFI 显式 C 库 import（M42）")
# ============================================================
# import "c/sqlite3" + extern def → ffi_call C 桥（编译/解释双模式一致）
var fdb = sqlite_open(":memory:")
check("C-FFI sqlite_open 返回句柄", type(fdb) == "int" and fdb > 0)
sqlite_exec(fdb, "CREATE TABLE t (id INT, name TEXT)")
sqlite_exec(fdb, "INSERT INTO t VALUES (1, '甲'), (2, '乙')")
var frows = sqlite_query(fdb, "SELECT id, name FROM t ORDER BY id")
check("C-FFI sqlite_query 返回行数", len(frows) == 2)
check("C-FFI 查询第一行", frows[0]["id"] == 1 and frows[0]["name"] == "甲")
check("C-FFI 查询第二行", frows[1]["id"] == 2 and frows[1]["name"] == "乙")
check("C-FFI sqlite_escape", sqlite_escape("O'Reilly") == "O''Reilly")
check("C-FFI sqlite_close", sqlite_close(fdb) == true)

# ============================================================
section("18. 文件即路由（M43 std.webroute）")
# ============================================================
# wr_parse_file：文件名（相对应用根）→ {method, pattern, fnname} 或 null
# 方法前缀 + _ 段拆分 + #name→:name + index 默认首页 + 特殊文件/私有/static 跳过
var wr1 = wr_parse_file("index.px")
check("wr index.px → GET /", wr1["method"] == "GET" and wr1["pattern"] == "/" and wr1["fnname"] == "index")
var wr2 = wr_parse_file("get_healthz.px")
check("wr get_healthz.px → GET /healthz", wr2["method"] == "GET" and wr2["pattern"] == "/healthz" and wr2["fnname"] == "get_healthz")
var wr3 = wr_parse_file("get_p_#id.px")
check("wr get_p_#id.px → GET /p/:id", wr3["method"] == "GET" and wr3["pattern"] == "/p/:id" and wr3["fnname"] == "get_p_id")
var wr4 = wr_parse_file("post_login.px")
check("wr post_login.px → POST /login", wr4["method"] == "POST" and wr4["pattern"] == "/login" and wr4["fnname"] == "post_login")
var wr5 = wr_parse_file("api/get_items.px")
check("wr api/get_items.px → GET /api/items", wr5["method"] == "GET" and wr5["pattern"] == "/api/items" and wr5["fnname"] == "api_get_items")
var wr6 = wr_parse_file("about.px")
check("wr about.px → GET /about（无方法前缀）", wr6["method"] == "GET" and wr6["pattern"] == "/about" and wr6["fnname"] == "about")
var wr7 = wr_parse_file("user_profile.px")
check("wr user_profile.px → GET /user_profile（首段非方法保持字面）", wr7["method"] == "GET" and wr7["pattern"] == "/user_profile" and wr7["fnname"] == "user_profile")
var wr8 = wr_parse_file("get.px")
check("wr get.px → GET /（方法前缀无 rest）", wr8["method"] == "GET" and wr8["pattern"] == "/" and wr8["fnname"] == "get")
check("wr main.px → null（特殊文件）", wr_parse_file("main.px") == null)
check("wr middleware.px → null（特殊文件）", wr_parse_file("middleware.px") == null)
check("wr generated_routes.px → null（特殊文件）", wr_parse_file("generated_routes.px") == null)
check("wr static/x.px → null（静态目录）", wr_parse_file("static/x.px") == null)
check("wr _private/helper.px → null（私有段）", wr_parse_file("_private/helper.px") == null)
check("wr hello.txt → null（非 .px）", wr_parse_file("hello.txt") == null)

# ============================================================
section("19. 语言糖打包（M44：简化枚举 + 列表追加简写）")
# ============================================================
# M44.1：type X const (A = v, B = v) 一行式带值枚举
type LogLevel const (Info = "info", Warn = "warn", Err = "error")
check("M44 常量访问字符串值", LogLevel.Info == "info" and LogLevel.Warn == "warn" and LogLevel.Err == "error")
type Code const (A = 1, B = 2, OK = true)
check("M44 常量访问整数/布尔值", Code.A == 1 and Code.B == 2 and Code.OK == true)
# match case 按绑定值匹配（PatLiteral → 值比较）
def lg_tag(lv):
    let r = match lv:
        case LogLevel.Info:
            "I"
        case LogLevel.Warn:
            "W"
        case _:
            "?"
    return r
check("M44 match 按值匹配", lg_tag(LogLevel.Warn) == "W" and lg_tag("x") == "?")
# 与无值 enum 并存
enum SugarKind:
    Int
    Str
check("M44 与无值 enum 并存", SugarKind.Int != null)
# M44.2：`a <- 4` ≡ a.append(4)
var sl = []
sl <- 1
sl <- 2
sl <- 3
check("M44 <- Var 目标追加", sl == [1, 2, 3])
var sl2 = []
sl2.append(1)
sl2.append(2)
sl2.append(3)
check("M44 <- 与 append 等价", sl == sl2)
var slm = {"k": []}
slm["k"] <- 9
check("M44 <- Index/dict 目标", slm["k"] == [9])
var slr = [[], []]
slr[1] <- 7
check("M44 <- 嵌套 list 目标", slr[1] == [7])
struct SugarBag:
    items: list
let sbag = SugarBag([])
sbag.items <- 5
check("M44 <- Field 目标", sbag.items == [5])
check("M44 比较运算不受影响", (5 < -1) == false and (5 < 1) == false and (-1 < 5) == true)

# ============================================================
section("20. registry 版本化（M45：semver 解析/比较/范围匹配）")
# ============================================================
# M45.1：sv_parse
let sp1 = sv_parse("1.2.3")
check("sv_parse 基础字段", sp1["major"] == 1 and sp1["minor"] == 2 and sp1["patch"] == 3 and sp1["pre"] == "" and sp1["build"] == "")
let sp2 = sv_parse("1.2.3-alpha.1+build5")
check("sv_parse pre+build", sp2["pre"] == "alpha.1" and sp2["build"] == "build5")
check("sv_parse 非法版本拒绝", sv_parse("1.2") == null and sv_parse("1.2.3.4") == null and sv_parse("1.2.x") == null)
check("sv_parse 前导零拒绝", sv_parse("01.2.3") == null and sv_parse("1.2.3-01") == null)
check("sv_parse prerelease 合法", sv_parse("1.2.3-rc.1") != null and sv_parse("1.2.3-beta.2") != null)
# M45.1：sv_cmp
check("sv_cmp 相等", sv_cmp("1.2.3", "1.2.3") == 0)
check("sv_cmp 数值比较（非字典序）", sv_cmp("1.2.3", "1.2.10") == -1 and sv_cmp("1.2.10", "1.2.3") == 1)
check("sv_cmp major 主导", sv_cmp("1.10.0", "2.0.0") == -1)
check("sv_cmp 预发布 < 正式版", sv_cmp("1.0.0-alpha", "1.0.0") == -1 and sv_cmp("1.0.0", "1.0.0-alpha") == 1)
check("sv_cmp 标识符数量多者大", sv_cmp("1.0.0-alpha", "1.0.0-alpha.1") == -1)
check("sv_cmp 数字标识符数值比较", sv_cmp("1.0.0-alpha.2", "1.0.0-alpha.10") == -1)
check("sv_cmp 数字 < 字母数字", sv_cmp("1.0.0-1", "1.0.0-alpha") == -1)
check("sv_cmp 字母数字按 ASCII", sv_cmp("1.0.0-alpha", "1.0.0-beta") == -1)
# M45.1：sv_satisfies（^ / ~ / 精确 / 通配）
check("sv_satisfies ^ 同 major", sv_satisfies("1.2.5", "^1.2.0") and not sv_satisfies("2.0.0", "^1.2.0"))
check("sv_satisfies ^0 语义", sv_satisfies("0.2.9", "^0.2.3") and not sv_satisfies("0.3.0", "^0.2.3"))
check("sv_satisfies ^0.0 语义", sv_satisfies("0.0.3", "^0.0.3") and not sv_satisfies("0.0.4", "^0.0.3"))
check("sv_satisfies ~ minor 内", sv_satisfies("1.2.9", "~1.2.3") and not sv_satisfies("1.3.0", "~1.2.3"))
check("sv_satisfies ~1.2 通配", sv_satisfies("1.2.0", "~1.2") and not sv_satisfies("1.3.0", "~1.2"))
check("sv_satisfies 精确版本", sv_satisfies("1.2.3", "1.2.3") and not sv_satisfies("1.2.4", "1.2.3"))
check("sv_satisfies 通配 x", sv_satisfies("1.2.9", "1.2.x") and not sv_satisfies("1.3.0", "1.2.x"))
check("sv_satisfies 通配 1.x", sv_satisfies("1.5.0", "1.x") and not sv_satisfies("2.0.0", "1.x"))
check("sv_satisfies * 任意", sv_satisfies("9.9.9", "*") and sv_satisfies("0.0.1", ""))
check("sv_satisfies 预发布拒绝", not sv_satisfies("1.2.3-alpha", "1.2.3"))
# M45.1：sv_best（选满足范围最高版本）
check("sv_best ^1.2.0 选最高", sv_best(["1.2.0", "1.2.5", "2.0.0"], "^1.2.0") == "1.2.5")
check("sv_best ^2.0.0", sv_best(["1.2.0", "1.2.5", "2.0.0"], "^2.0.0") == "2.0.0")
check("sv_best ^0.2.0", sv_best(["0.2.0", "0.2.5", "0.3.0"], "^0.2.0") == "0.2.5")
check("sv_best 无匹配返回 null", sv_best(["1.0.0", "1.2.0"], "^3.0.0") == null)

# ============================================================
# 21. QUIC 传输级 API（M46，import "c/ngtcp2"）
# ------------------------------------------------------------
# quic_listen/quic_accept/quic_connect/quic_send/quic_recv/
# quic_close/quic_close_listener —— 基于 ngtcp2 + quictls 静态编译。
# 完整握手回环见 examples/m46_quic_verify.sh（编译模式端到端 PASS）。
# 此处验证 FFI 绑定可加载 + 基础生命周期（双模式一致）。
# ============================================================
import "c/ngtcp2"

extern def quic_listen(port: int) -> int
extern def quic_close_listener(listener: int) -> bool
extern def quic_close(conn: int) -> bool

var ql = quic_listen(17996)
check("M46 quic_listen 返回有效 listener", ql > 0)
check("M46 quic_close_listener 关闭", quic_close_listener(ql) == true)
check("M46 quic_close 无效 conn 返回 false", quic_close(0) == false)

# ============================================================
# 22. HTTP/3 语义层（M47：QPACK 编解码 + HEADERS/DATA 帧）
# ------------------------------------------------------------
# h3_qenc/h3_qdec（QPACK 字段段编解码，无动态表 MVP）
# h3_frame（HTTP/3 帧构造：type + varint 长度 + payload）
# 完整握手回环见 examples/m47_h3_verify.sh（端到端 PASS）。
# ============================================================
import "c/ngtcp2"

extern def h3_qenc(headers: list) -> bytes
extern def h3_qdec(data: bytes) -> list
extern def h3_frame(type: int, payload) -> bytes

# QPACK roundtrip：编码 → 解码还原
var hdr = [["x-test", "1"], ["user-agent", "px-h3"]]
var enc = h3_qenc(hdr)
check("M47 h3_qenc 编码非空", enc != null)
var dec = h3_qdec(enc)
check("M47 h3_qdec 解码数量", dec != null and len(dec) == 2)
check("M47 QPACK roundtrip 字段1", dec[0][0] == "x-test" and dec[0][1] == "1")
check("M47 QPACK roundtrip 字段2", dec[1][0] == "user-agent" and dec[1][1] == "px-h3")
# 伪头字段 roundtrip（:method/:scheme/:path）
var pseudo = [["method", "GET"], ["scheme", "https"], ["path", "/hi"]]
var dec2 = h3_qdec(h3_qenc(pseudo))
check("M47 QPACK 伪头 roundtrip", dec2 != null and len(dec2) == 3 and dec2[0][1] == "GET" and dec2[2][1] == "/hi")
# 非法 QPACK（空/截断）返回 null（容错）
check("M47 QPACK 非法输入返回 null", h3_qdec("") == null)

# ============================================================
# 23. QPACK 完整 codec（M48：Huffman + 静态表压缩）
# ------------------------------------------------------------
# M47 的 QPACK MVP（仅 Literal Name、无压缩）内联实现迁出为
# runtime/runtime_h3_qpack.c 完整 codec，按 RFC 9204 升级：
#   - Indexed Field Line（静态表索引，RFC 9204 Appendix A 99 项）
#   - Literal Field Line with Name Reference（T=1 静态）
#   - Literal Field Line with Literal Name（name/value 可 Huffman）
#   - Huffman 编解码（RFC 7541 Appendix B，QPACK 复用同表）
# 仍无动态表（MaxTableCapacity=0：RIC/Base 恒 0，动态引用→null）。
# 纯 codec 语言接口不变（h3_qenc/h3_qdec），新增 h3_huff/h3_unhuff。
# 字节精确断言经 FFI 表 bytes_to_hex/hex_to_bytes（M48 注册，双模式一致）。
# ============================================================
import "c/ngtcp2"

extern def h3_huff(s: str) -> bytes
extern def h3_unhuff(data: bytes) -> str
extern def bytes_to_hex(data) -> str
extern def hex_to_bytes(s: str) -> bytes

# M48.1：Huffman 与 RFC 7541 Appendix C 官方向量逐字节一致（互操作基准）
check("M48 Huffman 官方向量 www.example.com", bytes_to_hex(h3_huff("www.example.com")) == "f1e3c2e5f23a6ba0ab90f4ff")
check("M48 Huffman 官方向量 no-cache", bytes_to_hex(h3_huff("no-cache")) == "a8eb10649cbf")
check("M48 Huffman 官方向量 custom-key", bytes_to_hex(h3_huff("custom-key")) == "25a849e95ba97d7f")
check("M48 Huffman 官方向量 custom-value", bytes_to_hex(h3_huff("custom-value")) == "25a849e95bb8e8b4bf")
check("M48 Huffman 解码官方向量", h3_unhuff(hex_to_bytes("f1e3c2e5f23a6ba0ab90f4ff")) == "www.example.com")

# M48.2：Huffman 编解码 roundtrip（URL/中文/大小写混合）
var hrt = h3_unhuff(h3_huff("px-h3://user:pass@example.com:8443/路径?q=1&b=中文"))
check("M48 Huffman roundtrip 复杂串", hrt == "px-h3://user:pass@example.com:8443/路径?q=1&b=中文")

# M48.3：QPACK 静态表压缩——[:method, GET] 命中表项 17 → 00 00 D1（字节精确）
check("M48 QPACK 静态表索引编码", bytes_to_hex(h3_qenc([[":method", "GET"]])) == "0000d1")
var st = h3_qdec(hex_to_bytes("0000d1"))
check("M48 QPACK 静态表索引解码", st != null and len(st) == 1 and st[0][0] == ":method" and st[0][1] == "GET")

# M48.4：完整 codec roundtrip（静态全匹配/静态名引用/字面名 Huffman 混合）
var full = [[":method", "GET"], [":scheme", "https"], [":path", "/index.html"], ["content-type", "text/html; charset=utf-8"], ["x-custom-48", "ab中文c"]]
var fdec = h3_qdec(h3_qenc(full))
check("M48 全 codec roundtrip 数量", fdec != null and len(fdec) == 5)
check("M48 全 codec roundtrip 伪头", fdec[0][0] == ":method" and fdec[0][1] == "GET" and fdec[1][1] == "https")
check("M48 全 codec roundtrip 静态/字面", fdec[2][1] == "/index.html" and fdec[3][1] == "text/html; charset=utf-8")
check("M48 全 codec roundtrip 自定义 Huffman", fdec[4][0] == "x-custom-48" and fdec[4][1] == "ab中文c")

# M48.5：容错——非法 Huffman / 动态表引用 / 动态 Indexed 拒绝（无动态表语义）
check("M48 Huffman 非法 padding 返回 null", h3_unhuff(hex_to_bytes("ff")) == null)
check("M48 QPACK 动态表引用拒绝", h3_qdec(hex_to_bytes("0100c1")) == null)
check("M48 QPACK 动态 Indexed 拒绝", h3_qdec(hex_to_bytes("000080")) == null)

# ============================================================
# 24. QPACK 动态表 + SETTINGS（M49：RFC 9204 连接级会话）
# ------------------------------------------------------------
# runtime/runtime_h3_qpack_dyn.c：QPACK 会话（encoder 动态表 + decoder 镜像）、
#   编码器流指令（Insert with Name Ref / Insert with Literal Name）、字段段
#   动态引用（RIC wrap + Base + Indexed T=0），以及 HTTP/3 SETTINGS 帧
#   （QPACK_MAX_TABLE_CAPACITY=0x01 / BLOCKED_STREAMS=0x07）。
# 双模式一致：语言层 extern def h3_qs_*/h3_settings_* 走 FFI 表（px_ffi_register）。
# ============================================================
import "c/ngtcp2"

extern def h3_qs_open(max_capacity: int) -> int
extern def h3_qs_close(sess: int) -> bool
extern def h3_qs_enc(sess: int, headers: list) -> bytes
extern def h3_qs_take_enc(sess: int) -> bytes
extern def h3_qs_dec_ingest(sess: int, enc_stream: bytes) -> bool
extern def h3_qs_dec(sess: int, section: bytes) -> list
extern def h3_settings_enc(pairs: list) -> bytes
extern def h3_settings_dec(frame: bytes) -> list

def qb_len(data):
    return len(bytes_to_hex(data)) // 2

# M49.1：会话打开/关闭
var qa = h3_qs_open(4096)
var qb = h3_qs_open(4096)
check("M49 会话打开", qa > 0 and qb > 0)
# M49.2：A 编码字段段（动态表插入指令入编码器流）+ 语义还原
var m49h = [[":method", "GET"], [":path", "/idx.html"], ["user-agent", "px-h3/1.0"], ["x-m49", "dyn-ok"]]
var m49s1 = h3_qs_enc(qa, m49h)
var m49e1 = h3_qs_take_enc(qa)
check("M49 首段产生编码器流指令", qb_len(m49e1) > 0)
check("M49 B ingest 编码器流", h3_qs_dec_ingest(qb, m49e1))
var m49d1 = h3_qs_dec(qb, m49s1)
check("M49 会话 roundtrip 数量", m49d1 != null and len(m49d1) == 4)
check("M49 会话 roundtrip 伪头", m49d1[0][1] == "GET" and m49d1[1][1] == "/idx.html")
check("M49 会话 roundtrip 自定义", m49d1[2][1] == "px-h3/1.0" and m49d1[3][1] == "dyn-ok")
# M49.3：同头复用 → 不再发插入指令（动态表命中）
var m49s2 = h3_qs_enc(qa, m49h)
var m49e2 = h3_qs_take_enc(qa)
check("M49 同头复用无新指令", qb_len(m49e2) == 0)
check("M49 同头复用字段段不增", qb_len(m49s2) <= qb_len(m49s1))
check("M49 B 解码复用段", (h3_qs_dec(qb, m49s2) != null and len(h3_qs_dec(qb, m49s2)) == 4))
# M49.4：压缩收益——动态表字段段 < M48 无动态表 h3_qenc 同头输出
var m49plain = h3_qenc(m49h)
check("M49 动态表压缩优于静态-only", qb_len(m49s1) < qb_len(m49plain))
h3_qs_close(qa)
h3_qs_close(qb)
check("M49 会话关闭", true)
# M49.5：SETTINGS 帧 roundtrip（QPACK_MAX_TABLE_CAPACITY/BLOCKED_STREAMS 字节精确）
var m49st = h3_settings_enc([[1, 4096], [7, 100]])
check("M49 SETTINGS 帧 hex", bytes_to_hex(m49st) == "0406015000074064")
var m49sd = h3_settings_dec(m49st)
check("M49 SETTINGS roundtrip 数量", m49sd != null and len(m49sd) == 2)
check("M49 SETTINGS MAX_TABLE_CAPACITY", m49sd[0][0] == 1 and m49sd[0][1] == 4096)
check("M49 SETTINGS BLOCKED_STREAMS", m49sd[1][0] == 7 and m49sd[1][1] == 100)

# ============================================================
# 25. HTTP/3 多路复用（M50：QUIC 多双向流 + H3 per-stream 语义层）
# ------------------------------------------------------------
# runtime_quic.c：per-stream 接收缓冲 + quic_open_stream / quic_send_stream /
#   quic_recv_stream / quic_poll（旧 quic_send/quic_recv 保留默认流兼容）；
# runtime_h3.c：per-sid 帧缓冲 + h3_serve_poll_stream / h3_serve_read_request_stream /
#   h3_serve_send_response_stream / h3_client_open_stream / h3_client_send_request_stream /
#   h3_client_read_response_stream。
# 完整端到端多流对拍见 examples/m50_h3_mux_verify.sh（编译+解释双模式）。
# 本 section 覆盖无效句柄/未开流容错的纯函数断言。
# ============================================================
import "c/ngtcp2"

extern def quic_open_stream(conn: int) -> int
extern def quic_send_stream(conn: int, sid: int, data: str) -> int
extern def quic_recv_stream(conn: int, sid: int, maxlen: int, timeout_ms: int) -> str
extern def quic_poll(conn: int, timeout_ms: int) -> int

check("M50 quic_open_stream 无效 conn → -1", quic_open_stream(0) == -1)
check("M50 quic_send_stream 无效 conn → -1", quic_send_stream(0, 0, "x") == -1)
check("M50 quic_recv_stream 无效 conn → 空串", quic_recv_stream(0, 0, 16, 5) == "")
check("M50 quic_poll 无效 conn → -1", quic_poll(0, 5) == -1)
check("M50 quic_open_stream 无效 conn(未监听) → -1", quic_open_stream(3) == -1)
check("M50 quic_recv_stream 指定流无数据(超时短) → 空串", quic_recv_stream(3, 0, 16, 5) == "")

