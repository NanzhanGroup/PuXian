# ============================================================
# M-B5 作用域环境（env.px）—— PuXian 版链式作用域
# ------------------------------------------------------------
# 对齐 Rust env.rs：
#   Env::new      → env_new
#   Env::define   → env_define
#   Env::get      → env_get（沿链向上，返回 {"found", "value"}）
#   Env::set      → env_set（就近赋值：找到第一个含该名的环境写入）
#   iter_vars     → env_items（GC 枚举）
#   clear_vars    → env_clear（GC 断循环）
# ------------------------------------------------------------
# 表示：{"vars": {name: value}, "parent": env 或 null}
# 注意（PuXian 语言限制）：{} 字面量是空块=null，不是空 dict！
#   空 dict 用 {"_": 0} 创建后 remove("_") 清空
# 对拍：selfhost/cases/v02_env.px
# ============================================================
# 创建环境（parent 可为 null）
# M181（第 59 轮 · 缺陷 193）：新增 **ub（unbound）** 层内集合 —— 帧内**声明式绑定的
#   名字**在帧入口就登记为「已声明、尚未执行」，读到即 R1001 未定义变量。为什么必须这样：
#   本仓从 M62-L5/M169 起是 Python 式**函数级作用域**（帧内声明式绑定归帧、遮蔽同名
#   模块/外层绑定）⇒ `var x = 99` + `def f(): print(x); let x = 1` 在编译两轨读到的是
#   **本帧未初始化的槽**（R1001）；而解释轨原先沿 env 链找到了模块的 99 ⇒ 三轨分叉
#   （p14 实测）。登记在**独立集合**里而不是塞进 vars，是为了不污染值域
#   （塞哨兵值会被用户用 `{"__unbound__": 1}` 这类字面量撞上）。
def env_new(parent):
    let vars = {"_": 0}
    vars.remove("_")
    let ub = {"_": 0}
    ub.remove("_")
    return {"vars": vars, "parent": parent, "ub": ub}
# 定义变量（当前层，覆盖同名；同时**解除**本层的「未绑定」登记）
def env_define(env, name, value):
    let vs = env["vars"]
    vs[name] = value
    let ub = env["ub"]
    if ub.has(name):
        ub.remove(name)
# M181（缺陷 193）：把帧内声明式绑定登记为「已声明、尚未执行」
def env_mark_unbound(env, name):
    env["ub"][name] = 1
# 查找变量：沿链向上
# 返回 {"found": bool, "value": 值或null[, "unbound": true]}
def env_get(env, name):
    var cur = env
    while cur != null:
        # M181（缺陷 193）：本层已声明但**尚未执行** ⇒ 停在这里报未定义（不得穿到外层）
        if cur["ub"].has(name):
            return {"found": true, "value": null, "unbound": true}
        let vs = cur["vars"]
        if vs.has(name):
            return {"found": true, "value": vs[name]}
        cur = cur["parent"]
    return {"found": false, "value": null}
# 就近赋值：找到第一个含 name 的环境写入；找不到返回 false
# M181（缺陷 193）：本层「已声明未执行」的名字 → 赋值即初始化**本层**绑定（不穿到外层，
#   与 M169 的遮蔽规则同一条真相：帧内声明式绑定遮蔽模块/外层同名绑定）。
def env_set(env, name, value):
    var cur = env
    while cur != null:
        if cur["ub"].has(name):
            env_define(cur, name, value)
            return true
        let vs = cur["vars"]
        if vs.has(name):
            vs[name] = value
            return true
        cur = cur["parent"]
    return false
# 当前层是否含 name
def env_has_local(env, name):
    return env["vars"].has(name) or env["ub"].has(name)
# 任意层是否含 name
def env_has(env, name):
    return env_get(env, name)["found"]
# 枚举当前层全部变量（GC 追踪用）：返回 list of [name, value]
def env_items(env):
    let out = []
    let vs = env["vars"]
    for k in vs.keys():
        out.append([k, vs[k]])
    return out
# 清空当前层（GC 断闭包循环）
def env_clear(env):
    let vs = {"_": 0}
    vs.remove("_")
    env["vars"] = vs
