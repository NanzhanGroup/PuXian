# M89-S3-A5 bc6.px —— 错误处理冒烟：FORCE(!) Ok 解包 + null 经 ? 传播
# get_val()! = 7（FORCE Ok 解包，若 FORCE 错会 px_error exit 非 0）；
# ret_null()? → null 就地传播（main RET null → driver _code=0 exit 0）；
#   若 null 未传播 → return 8 → exit 8（区分标记）。
def get_val():
    return Ok(7)

def ret_null():
    return null

def main():
    let v = get_val()!
    let z = ret_null()?
    return 8
