# ============================================================
# PuXian 仓库忽略规则（M-B9a：Rust 已退役，自举引导链）
# ============================================================

# Rust 编译产物（archive 保留源码，不参与构建）
archive/rust-compiler/target/

# 编译模式产物（生成的 C 源码与二进制）
examples/build/
examples/*/build/
selfhost/build/
selfhost/cases/build/
selfhost/cases_bad/build/
tools/build/

# M45 演示应用动态生成物（verify.sh 每次重建）
examples/m45_pkgdemo/app/
examples/m45_pkgdemo/registry_empty/

# 备份文件
*.bak
*.bak.*
*.orig
*~

# 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store

# 自举临时产物
/tmp/

# M61 gfx demo 运行时生成物（每次 verify 重建）
examples/m61_gfx/*.png
