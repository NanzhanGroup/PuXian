# m267_perf/src/onnx_mlp.px —— 端到端一步（MatMul + RMSNormalization + Gelu + MatMul + Silu · decoder FFN · T=16 D=512 H=1024）（M310 · 丙2 W2）
# ---------------------------------------------------------------
# 为什么内部跑 8 次：
#   W0-④ 门时长预算：单次测量落在 0.1–0.5 s 档（≈默认 REPS ×5 ⇒ 每负载 0.5–2.5 s，
#   5 个新负载合计 ≤10 s，远低于 900 s 门预算）；外层 time_run 再取 REPS 轮最小值（抗偶发）。
#
# 输出： OK <输出字节数>  —— 固定值，充当**正确性锚点**
#   （证明「模型真被解析 / 图真被执行 / 输出尺寸与声明一致」；
#    数值正确性由 m308_onnx_ops / m157 门守，本门只判性能）。
#
# usage: onnx_mlp <model.onnx> [内部重复次数]
let a = args()
if len(a) < 2:
    print("用法: onnx_mlp <model.onnx> [reps]\n")
    exit(2)
var reps = 8
if len(a) >= 3:
    reps = int(a[2])
let m = onnx_model_open(a[1])
if type(m) == "result":
    print("OPEN-ERR " + str(m) + "\n")
    exit(3)
var i = 0
var nb = 0
while i < reps:
    let res = onnx_run(m["id"], {})
    if type(res) == "result":
        print("RUN-ERR " + str(res) + "\n")
        exit(4)
    nb = res["outputs"]["out"]["nbytes"]
    i = i + 1
print("OK " + str(nb) + "\n")
onnx_model_close(m["id"])
