# ============================================================
# M293 门：H3 客户端 —— **0-RTT / 会话恢复**（走托管 listener）
#   这是 `docs/HTTP3_STANCE.md` §三.1 登记的「与缺陷 327 同族、尚未覆门」的路径之一。
# 契约行：M293-0RTT RESUME-OK …
#
# ⚠️ F4（M293 侦察发现，判据时序）：`quic_conn_resumed` == `SSL_session_reused`，
#   **握手完成前无意义** —— `quic_connect_0rtt` 返回时握手尚未完成 ⇒ 此刻查必然 false。
#   ⇒ 断言必须挪到**拿到响应之后**（本探针第一版就踩了这个：14/14 假红）。
# ============================================================
import "c/ngtcp2"

extern def quic_connect(ip: str, port: int, alpn: str) -> int
extern def quic_connect_0rtt(ip: str, port: int, alpn: str, s: str) -> int
extern def quic_0rtt_save(conn: int) -> str
extern def quic_0rtt_rejected(conn: int) -> bool
extern def quic_conn_handshake_done(conn: int) -> bool
extern def quic_conn_resumed(conn: int) -> bool
extern def quic_close(conn: int) -> bool
extern def h3_conn_setup(conn: int, qpack_cap: int) -> bool
extern def h3_client_open_stream(conn: int) -> int
extern def h3_client_send_request_stream(conn: int, sid: int, method: str, scheme: str, authority: str, path: str, headers: list, body: str) -> bool
extern def h3_client_read_response_stream(conn: int, sid: int, timeout_ms: int) -> dict

var h3p = 19694
var v = env("M293_HTTP_PORT")
if v != null:
    h3p = int(v) + 1

# ---------- ① 全新连接：拿到响应 + 存 0-RTT blob ----------
var c1 = quic_connect("127.0.0.1", h3p, "h3")
if c1 <= 0:
    print("M293-0RTT connect-fail")
    exit(2)
if h3_conn_setup(c1, 4096) == false:
    print("M293-0RTT setup-fail")
    exit(2)
var s1 = h3_client_open_stream(c1)
if s1 <= 0:
    print("M293-0RTT open-fail")
    exit(2)
h3_client_send_request_stream(c1, s1, "GET", "https", "localhost", "/m293", [], "")
var r1 = h3_client_read_response_stream(c1, s1, 8000)
if r1 == null:
    print("M293-0RTT warm-timeout")
    exit(3)
if r1["status"] != "200" or r1["body"] != "m293-ok":
    print("M293-0RTT warm-bad " + str(r1["status"]) + " [" + str(r1["body"]) + "]")
    exit(3)
var blob = quic_0rtt_save(c1)
if blob == "" or len(blob) < 1000:
    print("M293-0RTT save-fail len=" + str(len(blob)))
    exit(4)
quic_close(c1)

# ---------- ② 0-RTT 恢复连接：握手完成前就发 h3 请求 ----------
var c2 = quic_connect_0rtt("127.0.0.1", h3p, "h3", blob)
if c2 <= 0:
    print("M293-0RTT resume-connect-fail")
    exit(5)
var hd = quic_conn_handshake_done(c2)      # 记录用（此刻可能仍为 false）
if h3_conn_setup(c2, 4096) == false:
    print("M293-0RTT resume-setup-fail")
    exit(7)
var s2 = h3_client_open_stream(c2)
if s2 <= 0:
    print("M293-0RTT resume-open-fail")
    exit(7)
h3_client_send_request_stream(c2, s2, "GET", "https", "localhost", "/m293", [], "")
var r2 = h3_client_read_response_stream(c2, s2, 8000)
if r2 == null:
    print("M293-0RTT resume-timeout")
    exit(8)
if r2["status"] != "200" or r2["body"] != "m293-ok":
    print("M293-0RTT resume-bad " + str(r2["status"]) + " [" + str(r2["body"]) + "]")
    exit(9)
# F4：**此处**（响应已拿到 = 握手必然完成）才是 resumed 的有效观测点
var rs = quic_conn_resumed(c2)
if rs == false:
    print("M293-0RTT resumed-after-false")
    exit(10)
print("M293-0RTT RESUME-OK hd_before=" + str(hd) + " resumed_after=" + str(rs) + " rejected=" + str(quic_0rtt_rejected(c2)))
quic_close(c2)
