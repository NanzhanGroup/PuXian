# ══════════════════════════════════════════════════════════════════════
# M155 门 · 语义语料：**含内嵌 NUL 的字符串**（第 37 轮 · 缺陷 148/150）
# ---------------------------------------------------------------
# 判据一律是**数值或 ASCII 布尔**（`ok  <name>` / `FAIL <name>`）—— 不靠 print 的
# NUL 吞吐当判据（print 本身是本轮被修的对象，用它当尺子会「自证」）。
# 三轨（VM 默认轨 / C 轨 / 解释轨）必须与 `golden_sem.stdout` **逐字节一致**。
#
# 外部真值（Go 本尊实测，见 ISSUE.md §37 / docs 速查表事实 158–162）：
#   Go: s := "A\x00B"          ⇒ len 3
#       sha256.Sum256(s)       ⇒ 76fe3925c7167317f2df68454339f5ec3650e4062178b4f2be219b105a507907
#       base64.StdEncoding     ⇒ QQBC
#       json.Marshal(s)        ⇒ "A\u0000B"（10 字节：NUL 转义成 6 字符）
#       fmt.Sprint([]string{s})⇒ [A\x00B]（5 字节）
# ══════════════════════════════════════════════════════════════════════
let N = bytes_to_str(int_to_bytes(0, 1))  # 运行期构造的 NUL（不依赖字面量）
let A0B = "A" + N + "B"  # A NUL B（3 字节）
def ck(name, cond):
    if cond:
        print("ok   " + name + "\n")
    else:
        print("FAIL " + name + "\n")
# ── ① 字面量（缺陷 148 的直接判据：修前 len("\u{0}") == 0） ──
ck("lit.len1", len("\u{0}") == 1)
ck("lit.nul_eq_rt", "\u{0}" == N)
ck("lit.a0b.len3", len("a\u{0}b") == 3)
ck("lit.a0b.idx0", "a\u{0}b"[0] == "a")
ck("lit.a0b.idx1", "a\u{0}b"[1] == N)
ck("lit.a0b.idx2", "a\u{0}b"[2] == "b")
ck("lit.not_empty", "\u{0}" != "")
ck("lit.backslash0", len("\0") == 1)
ck("lit.backslash0_eq", "\0" == N)
ck("lit.head_nul", len("\u{0}a") == 2)
ck("lit.tail_nul", len("a\u{0}") == 2)
ck("lit.multi_nul", len("\u{0}\u{0}\u{0}") == 3)
# C 八进制转义歧义：`\000` 恒 3 位 ⇒ 后续数字**不被吞**（若发射成 `\0` 则 "\01" == 0x01）
ck("lit.octal_amb.len2", len("\u{0}1") == 2)
ck("lit.octal_amb.ch1", "\u{0}1"[1] == "1")
ck("lit.octal_amb.ch0", "\u{0}1"[0] == N)
ck("lit.octal_amb3.len3", len("\u{0}07") == 3)
ck("lit.octal_amb3.ch1", "\u{0}07"[1] == "0")
ck("lit.octal_amb3.ch2", "\u{0}07"[2] == "7")
# ── ② 运行期构造 / 运算（与字面量同口径） ──
ck("rt.bytes_roundtrip", len(bytes_to_str(hex_to_bytes("410042"))) == 3)
ck("rt.join_keeps", len(join("", ["a\u{0}b"])) == 3)
ck("rt.join_rt_keeps", len(join("", [A0B])) == 3)
ck("rt.plus_keeps", len("a\u{0}" + "b") == 3)
ck("rt.slice_keeps", len("x\u{0}y"[1:2]) == 1)
ck("rt.contains", contains(A0B, N))
ck("rt.eq_lit", A0B == "A\u{0}B")
ck("rt.ne_truncated", A0B != "AB")
ck("rt.dict_key_lit", {"A\u{0}B": 7}["A\u{0}B"] == 7)
ck("rt.dict_key_rt", {"A" + N + "B": 9}[A0B] == 9)
# ── ③ 渲染长度（str / str(容器)：内嵌 NUL 不得被 strlen 截断） ──
ck("render.str_identity", len(str(A0B)) == 3)
ck("render.list_len5", len(str([A0B])) == 5)  # [ A NUL B ] = 5
ck("render.dict_len8", len(str({"k": A0B})) == 8)  # { k :   A NUL B } = 8
ck("render.result_len7", len(str(Ok(A0B))) == 7)  # O k ( A NUL B ) = 7
ck("render.nested", len(str([A0B, "z"])) == 8)  # [ A NUL B ,   z ] = 8
# ── ④ 编码 / 摘要 / JSON（外部真值 = Go 本尊） ──
ck("hash.sha256", sha256(A0B) == "76fe3925c7167317f2df68454339f5ec3650e4062178b4f2be219b105a507907")
ck("b64.encode", base64_encode(A0B) == "QQBC")
#   `json_stringify_go` = Go 保真口径（NUL → 6 字符 \u0000；0x01 → \u0001）
ck("json.go_len10", len(json_stringify_go(A0B)) == 10)
ck("json.go_text", json_stringify_go(A0B) == "\"A\\u0000B\"")
ck("json.go_ctrl_escaped", json_stringify_go("A" + bytes_to_str(int_to_bytes(1, 1)) + "B") == "\"A\\u0001B\"")
ck("json.go_roundtrip", json_parse(json_stringify_go(A0B)) == A0B)
#   `json_stringify` = 语言自有变体（**控制字符裸输出**，契约见速查表 369 行）——
#   M155（缺陷 152）起**不再按 C 串截断**：长度与尾巴都保住，只是 NUL 裸出头
ck("json.raw_len_no_truncate", len(json_stringify(A0B)) == 5)  # " A NUL B " = 5
ck("json.raw_tail_kept", json_stringify(A0B)[4] == "\"")
print("M155-SEM-DONE")
