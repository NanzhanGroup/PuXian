# M183 门 ①：根栈「交棒窗口」（缺陷 197）—— 进程内 http_serve + http_request ×40
#   判据：每次都能取到服务端自定义头 X-M183（丢头 ⇒ 该请求的响应头 dict 被 GC 误回收）
PORT = 19311
URL = "http://127.0.0.1:" + str(PORT)

def h(req):
    return {"status": 200, "body": "b", "headers": {"X-M183": "hdr"}}

def srv():
    http_serve(PORT, h)

spawn srv()
# ⚠️ 就绪等待必须是**轮询**，不能是固定 sleep（M306 实测 · 与 M305 的 m118 同族）：
#   历史上本门 25–43s；M306 改了 runtime（onnx_*.c）⇒ 这一项的**构建变冷**
#   ⇒ 门耗时涨到 147–154s，于是固定 `sleep(400)` 在 4 路分片负载下变成**边缘**
#   ⇒ 实测 10 连跑里出现 1 次 `bad=1 / HANDOVER FAIL`（恰好第一个请求撞在
#   `http_serve` 还没绑定完上）。⇒ 改为「轮询到**至少有一次响应带上了响应头**为止」。
#   判据强度**不降**：本门要抓的是「**成功响应上丢头**」（缺陷 197），
#   而这里只等「服务端是否已能回应」；等到了之后，计数循环仍是原样的 40 次全绿要求。
#   （唯一的口径变化：就绪期内的失败不计入 bad —— 那是「还没起来」，不是「丢头」。）
var ready = false
for i in range(300):
    let r0 = http_request(URL + "/ready" + str(i), "GET")
    if type(r0) != "result":
        if r0.headers != null:
            ready = true
            break
    sleep(20)
if ready == false:
    print("READY-FAIL")
    exit(2)
bad = 0
for i in range(40):
    r = http_request(URL + "/p" + str(i), "GET")
    # M307 补（全量门实测 1/400 假红）：传输层失败**不是**缺陷 197 的形态。
    #   197 = 「成功响应上丢头」；而连接不上时 http_request 返回 Err（type=="result"）、
    #   r.headers 为 null ⇒ 旧判据把「连不上」记成「丢头」。
    #   实测（M307 全量门 18:27 一档）：10 连跑里 1 次 bad=1，而同门单跑 10/10 绿。
    #   ⇒ 对「不是成功响应」的那一笔做**有界重试**（500×10ms）；仍然拿不到成功响应才计入 bad
    #     （服务端真死了照样判红 —— 判据没有退化成「无限等」）。
    #   判据强度不降：**成功响应**缺 X-M183 / Content-Length ⇒ 立即计入 bad
    #     （负控 A 恢复缺陷 197 时走的正是这条，仍然必红）。
    var k = 0
    while type(r) == "result" and k < 500:
        sleep(10)
        r = http_request(URL + "/p" + str(i), "GET")
        k += 1
    hh = r.headers
    xm = false
    cl = false
    if hh != null:
        if hh.has("X-M183"):
            xm = true
        if hh.has("Content-Length"):
            cl = true
    if xm == false or cl == false:
        bad = bad + 1
print("bad=" + str(bad))
if bad == 0:
    print("HANDOVER OK")
else:
    print("HANDOVER FAIL")
    exit(1)
