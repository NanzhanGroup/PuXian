# ============================================================
# M64-S5 bench 自测语料：顶层 def 基准目标
# ------------------------------------------------------------
# 语义验证点：顶层可执行语句（print）被 pxbench 剔除不得运行；
#   bench_target 为无参基准目标（px bench 无参调用约定，对齐 Rust）。
# ============================================================
def bench_target():
    var s = 0
    var i = 0
    while i <= 500:
        s += i
        i += 1
    return s
def fib(n):
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)
print("TOP_SHOULD_NOT_RUN")
