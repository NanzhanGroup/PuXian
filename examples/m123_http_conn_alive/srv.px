# m123 原型：http_serve_unix + handler 内对端断开感知
#   /off  = 现有行为：一路算完（模拟 ws-approve 现状）
#   /on   = 应用 P0：每片 1/K 检查 http_conn_alive()，断开即提前收尾
def burn(n):
    var s = 0
    var i = 0
    while i < n:
        s = s + i % 7
        i = i + 1
    return s

def handler(req):
    let path = req["path"]
    if path == "/probe":
        burn(2000000)
        return {"status": 200, "body": "alive=" + str(http_conn_alive())}
    if path == "/health":
        return {"status": 200, "body": "ok"}
    if path == "/off":
        let r = burn(120000000)
        return {"status": 200, "body": "off-done " + str(r)}
    if path == "/on":
        var i = 0
        var acc = 0
        while i < 1200:
            acc = acc + burn(100000)
            i = i + 1
            if http_conn_alive() == 0:
                print("ALIVE0 at slice=" + str(i))
                return {"status": 499, "body": "aborted slice=" + str(i)}
        return {"status": 200, "body": "on-done " + str(acc)}
    return {"status": 404, "body": "nf"}

print("outside_handler alive=" + str(http_conn_alive()))
spawn http_serve_unix("/tmp/m123.sock", handler)
sleep(600000)
