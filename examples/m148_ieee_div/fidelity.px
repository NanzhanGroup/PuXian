# M148 门（PuXian 侧）—— IEEE 浮点除法/取模 + 非有限值文本 + Go `%v` 文本 native
# ---------------------------------------------------------------
# 与 truth/main.go（**Go 本尊**：IEEE 754 `/` / math.Mod / fmt.Sprint）**逐字节**对拍
# 同一份语料（corpus_div.txt / corpus_str.txt / corpus_gv.txt）。
#
# 输出顺序（verify.sh 只 diff 前 NTRUTH 行）：
#   ① corpus_div.txt → `<op>|<ahex>|<bhex>|<结果16位hex 或 nan>`
#   ② corpus_str.txt → `<hex>|<str(f) 文本>`
#   ③ corpus_gv.txt  → `<hex>|<bits>|<go_float_text(f,bits) 文本>`
#   然后才是自断言行（M148_ASSERT: nP/mF）。
#
# 为什么这个门必须存在：
#   · 缺陷 118：Go 的浮点换算是良定义的（x/0.0 = ±Inf、0.0/0.0 = NaN、
#     math.Mod(x,0) = NaN），而 PuXian 的 `/` 修前**一律 px_error 杀进程**
#     ⇒ 移植 Go 浮点算式（比值/余弦/成功率/均值）时必须手写零判断，
#     「÷0 → Inf/NaN」这条路表达不出来。修后 `/` 完全 IEEE；`//` 与整数 `%`
#     仍然除零报错（对齐 Go 的整数 panic）。
#   · 缺陷 132：`str()` 的**有限**浮点文本是语言自身约定（"250.0"、固定区更宽），
#     与 Go `fmt.Sprint`（"250"、十进制指数 ≥6 即科学计数）本来就不同 ⇒ 新增
#     native `go_float_text(f[, bits])` 把 **Go 的 `%v` 文本**搬进来（32/64 两套
#     最短往返），两侧逐字节钉死。
#   · `str()` 的**非有限**值文本对齐 Go（NaN/+Inf/-Inf，不是 libc 的 nan/inf）。
var m8_pass = 0
var m8_fail = 0
def m8_ck(name, cond):
    if cond:
        m8_pass = m8_pass + 1
        print("PASS " + name)
    else:
        m8_fail = m8_fail + 1
        print("FAIL " + name)
# 位模式文本 → int64 承载（>2^63 溢出 ⇒ 拆高低 32 位拼；拼合的回绕正是补码语义）
def m8_parse_bits(s):
    var hi = hex_to_int(s[0:8])
    var lo = hex_to_int(s[8:16])
    return hi * 4294967296 + lo
def m8_hex16(u):
    return int_to_hex(u, 16)
def m8_val(h):
    return bits_to_float64(m8_parse_bits(h))
# NaN 只归一为 `nan` 标记：NaN 的**符号位与载荷**在 C(x86) 与 Go 之间不是同一约定
# （实测 0.0/0.0 在 x86 给 0xfff8…，Go 的常量 NaN 是 0x7ff8…）⇒ 逐位比会假红。
# 「结果是不是 NaN」由 `r != r` 判（M146 修好的语义）。
def m8_bits_or_nan(r):
    if r != r:
        return "nan"
    return m8_hex16(float64_bits(r))
def m8_is_nan_bits(h):
    return m8_val(h) != m8_val(h)
const M8_PINF = "7ff0000000000000"
const M8_NINF = "fff0000000000000"
const M8_NAN = "7ff8000000000000"
const M8_PZ = "0000000000000000"
const M8_NZ = "8000000000000000"
const M8_ONE = "3ff0000000000000"
const M8_NONE = "bff0000000000000"
# ── ① 除法 / 取模语料（与 Go 真值对拍）──
def m8_div_pass():
    var text = read_file("corpus_div.txt")
    var lines = split(text, "\n")
    var n = 0
    for line in lines:
        if len(line) == 0:
            continue
        var p = split(line, "|")
        if len(p) != 3:
            continue
        var a = m8_val(p[1])
        var b = m8_val(p[2])
        var r = 0.0
        if p[0] == "d":
            r = a / b
        else:
            r = a % b
        print(p[0] + "|" + p[1] + "|" + p[2] + "|" + m8_bits_or_nan(r))
        n = n + 1
    return n
# ── ② str() 的**非有限值**文本（**语言约定**：`inf` / `-inf` / `nan`，不对拍 Go）──
#   这一族**不参与对拍**：`str()` 在有限值上本来就不向 Go 的 `%v` 看齐（250.0 vs 250），
#   只把非有限值单方面对齐没有意义（M148 一度这么改过，被 s09 的三个 golden 当场拦下）。
#   Go 的口径由 `go_float_text` / `fmt_float_dec` 提供（下面的 ③ 与断言 A30）。
#   这里改为**性质检查**：每个非有限值都必须落在语言约定的文本上（返回 [检查数, 失败数]）。
def m8_strnf_pass():
    var text = read_file("corpus_strnf.txt")
    var lines = split(text, "\n")
    var n = 0
    var bad = 0
    for line in lines:
        if len(line) == 0:
            continue
        var f = m8_val(line)
        var want = ""
        if f != f:
            # NaN 的文本**归一为 `nan`**（丢掉符号位，M148）：负 NaN 的符号位是平台/
            # 运算相关的（x86 的 0.0/0.0 就给负 NaN），而 `str()` 是**语言约定** ⇒ 必须确定。
            want = "nan"
        elif f > 1.7976931348623157e308:
            want = "inf"
        else:
            want = "-inf"
        n = n + 1
        if str(f) != want:
            bad = bad + 1
    return [n, bad]
# ── ③ go_float_text（Go `%v` 文本）──
def m8_gv_pass():
    var text = read_file("corpus_gv.txt")
    var lines = split(text, "\n")
    var n = 0
    for line in lines:
        if len(line) == 0:
            continue
        var p = split(line, "|")
        if len(p) != 2:
            continue
        var f = m8_val(p[0])
        var t = ""
        if p[1] == "32":
            t = go_float_text(f, 32)
        else:
            t = go_float_text(f)
        print(p[0] + "|" + p[1] + "|" + t)
        n = n + 1
    return n
# ── ④ str() 的**往返性质**（不参与对拍；这是 str() 自身的正确性判据）──
#   str() 的有限值文本是语言约定（"250.0"、定点舒适区 [-4,15)）⇒ 与 Go 的 %v
#   本来就不同；但「读回来还是同一个双精度」是语言自己必须成立的性质。
#   **缺陷 133**：fmt_num 的定点分支上界写死 `dec <= 17`，而 x ∈ [-4,-1] 的
#   0.000… 形态需要 17+|x| 位小数 ⇒ 落到**不往返**的文本，静默丢精度
#   （0x3f2d1ac1aeaf35e2 → "0.00022204984938272"，读回来已不是原值）。
#   返回 [检查数, 失败数]。
def m8_roundtrip():
    var text = read_file("corpus_str.txt")
    var lines = split(text, "\n")
    var n = 0
    var bad = 0
    for line in lines:
        if len(line) == 0:
            continue
        var f = m8_val(line)
        if f != f:
            continue
        if f > 1.7976931348623157e308 or f < (0.0 - 1.7976931348623157e308):
            continue
        n = n + 1
        if float(str(f)) != f:
            bad = bad + 1
    return [n, bad]
def main():
    var n_div = m8_div_pass()
    let snf = m8_strnf_pass()
    var n_gv = m8_gv_pass()
    let rt = m8_roundtrip()
    print("M148_ASSERT-BEGIN")
    # ── 缺陷 118：÷0 与 0/0（修前一律 px_error 杀进程 ⇒ 走到这里就已是证据）──
    m8_ck("A1 1.0/0.0 = +Inf（7ff0…）", m8_hex16(float64_bits(m8_val(M8_ONE) / m8_val(M8_PZ))) == M8_PINF)
    m8_ck("A2 -1.0/0.0 = -Inf（fff0…）", m8_hex16(float64_bits(m8_val(M8_NONE) / m8_val(M8_PZ))) == M8_NINF)
    m8_ck("A3 0.0/0.0 是 NaN", (m8_val(M8_PZ) / m8_val(M8_PZ)) != (m8_val(M8_PZ) / m8_val(M8_PZ)))
    m8_ck("A4 1.0/-0.0 = -Inf（符号异号）", m8_hex16(float64_bits(m8_val(M8_ONE) / m8_val(M8_NZ))) == M8_NINF)
    m8_ck("A5 -1.0/-0.0 = +Inf（符号同号）", m8_hex16(float64_bits(m8_val(M8_NONE) / m8_val(M8_NZ))) == M8_PINF)
    m8_ck("A6 Inf/Inf 是 NaN",
        (m8_val(M8_PINF) / m8_val(M8_PINF)) != (m8_val(M8_PINF) / m8_val(M8_PINF)))
    m8_ck("A7 溢出（最大有限/最小非规格化）= +Inf",
        m8_hex16(float64_bits(m8_val("7fefffffffffffff") / m8_val("0000000000000001"))) == M8_PINF)
    m8_ck("A8 下溢（最小非规格化/最大有限）= +0.0",
        m8_hex16(float64_bits(m8_val("0000000000000001") / m8_val("7fefffffffffffff"))) == M8_PZ)
    # ── 浮点取模 = fmod（IEEE；Go math.Mod 同）──
    m8_ck("A9 x % 0.0 是 NaN",
        (m8_val(M8_ONE) % m8_val(M8_PZ)) != (m8_val(M8_ONE) % m8_val(M8_PZ)))
    m8_ck("A10 -5.0 % 3.0 = -2.0（余数取被除数符号，不是欧几里得）",
        m8_hex16(float64_bits(m8_val("c014000000000000") % m8_val("4008000000000000")))
        == m8_hex16(float64_bits(0.0 - 2.0)))
    m8_ck("A11 Inf % 1.0 是 NaN",
        (m8_val(M8_PINF) % m8_val(M8_ONE)) != (m8_val(M8_PINF) % m8_val(M8_ONE)))
    # ── `//` 与整数 `%` 仍走整数语义（除零仍报错 —— 不在本门内触发，只钉正常面）──
    m8_ck("A12 // 仍是欧几里得商（-7//2 = -4）", (0 - 7) // 2 == 0 - 4)
    m8_ck("A13 整数 % 仍是 euclid 余数（-7 % 3 = 2）", (0 - 7) % 3 == 2)
    m8_ck("A14 整除与浮点除**不混**（5/2 = 2.5、5//2 = 2）", 5 / 2 == 2.5 and 5 // 2 == 2)
    # ── str() 的非有限值文本 = **语言约定**（inf/-inf/nan；有 golden/s09 钉着）──
    m8_ck("A15 str(+Inf) = \"inf\"（语言约定，非 Go 的 \"+Inf\"）", str(m8_val(M8_PINF)) == "inf")
    m8_ck("A16 str(-Inf) = \"-inf\"", str(m8_val(M8_NINF)) == "-inf")
    m8_ck("A17 str(NaN) = \"nan\"", str(m8_val(M8_NAN)) == "nan")
    m8_ck("A18 负 NaN 也给 \"nan\"（归一，不露符号位 —— 顺带修掉一条潜伏缺陷）",
          str(m8_val("fff8000000000000")) == "nan")
    m8_ck("A18b go_float_text 对两种 NaN 都是 Go 的 \"NaN\"",
          go_float_text(m8_val("fff8000000000000")) == "NaN"
          and go_float_text(m8_val(M8_NAN)) == "NaN")
    # ── 缺陷 132：str() 的语言约定**未被改动**，go_float_text 另走一路 ──
    m8_ck("A19 str(250.0) = \"250.0\"（语言约定，缺陷 132 边界）", str(250.0) == "250.0")
    m8_ck("A20 go_float_text(250.0) = \"250\"（Go %v 无 .0）", go_float_text(250.0) == "250")
    m8_ck("A21 两者**必然不同**", str(250.0) != go_float_text(250.0))
    m8_ck("A22 go_float_text(100000.0) = \"100000\"", go_float_text(100000.0) == "100000")
    m8_ck("A23 go_float_text(1234567.0) = \"1.234567e+06\"（Go 的 eprec=6 阈值）",
        go_float_text(1234567.0) == "1.234567e+06")
    m8_ck("A24 go_float_text(1e15) = \"1e+15\"", go_float_text(1e15) == "1e+15")
    m8_ck("A25 go_float_text(0.0001) = \"0.0001\"（指数 -4 仍定点）",
        go_float_text(0.0001) == "0.0001")
    m8_ck("A26 go_float_text(1e-5) = \"1e-05\"（指数 -5 转科学，两位幂）",
        go_float_text(1e-5) == "1e-05")
    m8_ck("A27 go_float_text(1.0/3.0) = \"0.3333333333333333\"",
        go_float_text(1.0 / 3.0) == "0.3333333333333333")
    m8_ck("A28 go_float_text(0.1+0.2) = \"0.30000000000000004\"",
        go_float_text(0.1 + 0.2) == "0.30000000000000004")
    m8_ck("A29 go_float_text(-0.0) = \"-0\"", go_float_text(m8_val(M8_NZ)) == "-0")
    m8_ck("A30 go_float_text(+Inf/-Inf/NaN) 与 Go 同文本",
        go_float_text(m8_val(M8_PINF)) == "+Inf"
        and go_float_text(m8_val(M8_NINF)) == "-Inf"
        and go_float_text(m8_val(M8_NAN)) == "NaN")
    # ── go_float_text 的 32 位字宽（Go `fmt.Sprint(float32(v))`）──
    m8_ck("A31 go_float_text(1.0, 32) = \"1\"", go_float_text(1.0, 32) == "1")
    m8_ck("A32 go_float_text(0.1, 32) = \"0.1\"", go_float_text(0.1, 32) == "0.1")
    m8_ck("A33 go_float_text(1.0/3.0, 32) = \"0.33333334\"（32 位最短往返）",
        go_float_text(1.0 / 3.0, 32) == "0.33333334")
    m8_ck("A34 32 位与 64 位文本**不同**（0.1 只是恰好同形）",
        go_float_text(1.0 / 3.0, 32) != go_float_text(1.0 / 3.0))
    m8_ck("A35 整型入参等价（go_float_text(42) = \"42\"）", go_float_text(42) == "42")
    m8_ck("A36 bits 只接受 32/64（其他值报错 —— 本门内不触发）",
        go_float_text(1.5, 64) == "1.5")
    # ── 语料规模（判据真的被灌进去了）──
    m8_ck("A37 div 语料 >= 600 行", n_div >= 600)
    m8_ck("A38 非有限值文本走语言约定（inf/-inf/nan）· 覆盖 >= 10 例",
          snf[1] == 0 and snf[0] >= 10)
    m8_ck("A39 gv 语料 >= 300 行（含 32 位面）", n_gv >= 300)
    m8_ck("A40 语料含 NaN 位模式（nan 归一这条判据在跑）", m8_is_nan_bits(M8_NAN))
    # ── 缺陷 133：str() 必须能往返（有限值）──
    m8_ck("A41 str() 往返：全部有限值 float(str(f)) == f（缺陷 133）", rt[1] == 0)
    m8_ck("A42 往返检查覆盖 >= 150 个有限值", rt[0] >= 150)
    m8_ck("A43 定点形态（0.000…）确实在语料里（缺陷 133 的触发面）",
          m8_hex16(float64_bits(float(str(m8_val("3f2d1ac1aeaf35e2"))))) == "3f2d1ac1aeaf35e2")
    print("M148_ASSERT: " + str(m8_pass) + "P/" + str(m8_fail) + "F")
    print("M148_RT: checked=" + str(rt[0]) + " bad=" + str(rt[1]))
