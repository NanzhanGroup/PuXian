# M26: >>> 无符号右移 验证（双模式）
let a = -8
print("a>>1  =", a >> 1)       # 算术右移 → -4
print("a>>>1 =", a >>> 1)      # 逻辑右移 → 9223372036854775804
print("a>>>63=", a >>> 63)     # → 1
let x = 255
print("x>>>4 =", x >>> 4)      # 15
let b = 16
b >>>= 2
print("b =", b)                # 4
let c = -1
print("c>>>1 =", c >>> 1)      # 9223372036854775807
print("c>>>64=", c >>> 64)     # 移位量 mod 64 = 0 → -1
print("c>>>-1 =", c >>> -1)    # 移位量 mod 64 = 63 → 1
