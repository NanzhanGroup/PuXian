# M26: >>> 无符号右移 验证（双模式：解释轨 px run 与编译轨 px build 输出必须一致）
# 语义（M217 · 缺陷 309 收口后，2026-xx）：
#   · 移位计数按 n & 63 取（64 ⇒ 视为 0；65 ⇒ 视为 1）
#   · **负数计数 ⇒ R1003 运行时错误**，不再「按 mod 64 折成 63」
#     —— 旧示例（本文件 2026-11-19 之前）写的是「-1 ⇒ 63 ⇒ 1」，那是 M217 之前的形态，
#        示例又恰好从没被任何门跑过 ⇒ 一直没人发现它和实现相反（缺陷 857）。
#   本文件现在全部改成断言式：可被 examples/m26_ushr/verify.sh 双轨真跑。
let a = -8
assert(a >> 1 == -4, "算术右移")
assert(a >>> 1 == 9223372036854775804, "逻辑右移")
assert(a >>> 63 == 1, "计数 63")
let x = 255
assert(x >>> 4 == 15, "255 >>> 4")
let mut b = 16
b >>>= 2
assert(b == 4, "复合赋值 >>>=")
let c = -1
assert(c >>> 1 == 9223372036854775807, "-1 >>> 1")
assert(c >>> 64 == c, "计数 64 ⇒ 按 0 取 ⇒ 原值")
print("M26 USHR TESTS PASSED")
