# ============================================================
# M207 压力筛探针 · **os_capture 容器**（缺陷 259）
# ------------------------------------------------------------
# 判据（与 probe_gen 同）：
#   · 正常档：`V=`（环境里没有 PX_M207_PERTURB）
#   · `--env PX_M207_PERTURB=1` 时压力档：`V=1` ⇒ **故意造出 stdout 差异**，
#     用来正判「逐字节比对这一层真的有牙」（负控 C）。
# ============================================================
let o = os_capture("/bin/sh", ["-c", "printf 'V=%s' \"$PX_M207_PERTURB\""])
print(o["stdout"])
print("rc=" + str(o["rc"]))
let n = int(trim(os_capture("/bin/echo", ["7"])["stdout"]))
print("n=" + str(n + 1))
