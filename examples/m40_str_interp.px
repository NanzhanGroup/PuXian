# M40 字符串插值 ${expr}（双模式一致示例）
# 语法：普通/多行字符串内 ${expr} → 自动 str(expr) 拼接；\${ 转义为字面
# 限定：表达式内不支持 {} 字面量（dict/set）、注释、跨行；表达式内字符串不递归展开
let name = "普贤"
let version = 2
let ratio = 3.14159
let ok = true
let nothing = null

# ① 变量插值（str 自动转换）
print("name=${name}")
print("version=${version} ratio=${ratio} ok=${ok} nothing=${nothing}")

# ② 表达式插值（优先级/括号/算术）
let x = 21
print("double=${x * 2} sum=${x + 1}")
print("prec=${1 + 2 * 3} paren=${(1 + 2) * 3}")
print("half=${3 / 2}")

# ③ 函数调用插值
def greet(n):
    return "hi " + n
print("${greet(name)}")
print("${name.upper()}")

# ④ 属性/索引插值 + 索引键插值
let d = {"k1": "v1", "k2": "v2"}
let lst = ["zero", "one", "two"]
let i = 1
print("d=${d["k${i}"]} lst=${lst[0]} ${lst[2]}")

# ⑤ 连续插值 + 空串插值
let p = "x"
print("${p}${p}${p}")
print("${x}")
print("a${p}b${p}c")

# ⑥ 转义 \${ 字面 + 裸 $（非 { 前缀）
print("literal: \${name}")
print("price is $5 and \$${x}")
print("nested-not-expanded: ${"a${i}b"}")

# ⑦ 多行字符串插值
let multi = """line1=${name}
line2=${x}
"""
print(multi)

# ⑧ 逻辑/比较插值
print("gt=${x > 20} and=${x > 20 and x < 30}")

print("M40_STR_INTERP_OK")
