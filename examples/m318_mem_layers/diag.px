# ============================================================
# M318 门：gc_diagnose() 的**三轨一致**探针
# ------------------------------------------------------------
# ⚠️ 刻意**不打印内存绝对值**（live_bytes / slab_bytes 的具体数字）：
#   三者随分配器与实现而变（解释轨自带 AST 堆，编译轨没有），逐字节比对必然分叉。
#   本层要证的是「**契约**一致」：字段齐全 · 类型正确 · 单位语义（bytes）单调关系成立。
#   绝对值面的判据在 [4]/[5] 层（服务场景 · 只对**编译轨**断言，且有数量级分离）。
# ============================================================
def main():
    var parts = []
    var i = 0
    while i < 100:
        parts.append("y" * 500)
        i += 1
    gc()
    var d = gc_diagnose()
    print("D keys=" + str(len(d)))
    print("D runs_ge1 " + str(d["runs"] >= 1))
    print("D objs_positive " + str(d["live_objs"] > 0))
    print("D live_positive " + str(d["live_bytes"] > 0))
    print("D slab_covers_live " + str(d["slab_bytes"] >= d["live_bytes"]))
    print("D trigger_default " + str(d["trigger_bytes"] == 536870912))
    print("D interval_default " + str(d["max_interval_ms"] == 30000))
    print("D alloc_field " + str(d["alloc_since_gc"] >= 0))
    print("D slab_fields " + str(d["slab_n"] >= 1))
    print("D free_le_total " + str(d["slab_free_slots"] >= 0))
    print("D pending_is_bool " + str(type(d["pending"])))
    print("D stress_is_bool " + str(type(d["stress"])))
    print("D runs_monotone " + str(d["runs"] >= 1))
    var s2 = "z" * 100000
    gc()
    var d2 = gc_diagnose()
    print("D second_runs_ge " + str(d2["runs"] >= d["runs"]))
    print("D payload " + str(len(parts) * 500 + len(s2)))
