# proxy.px —— M317 门：反代最小件（http_serve 里调 http_request）
#   这就是 Ma 的 proxy_routes 路径的形状：每请求都要在 handler 内建一次出站请求
#   ⇒ 每请求 ~10KB 垃圾（实测），是本缺陷唯一能稳定复现分配压力的最小装置。
def mk(upstream):
    def h(req):
        r = http_request(upstream, "GET", "", {"X-Probe": "1"})
        if type(r) != "dict":
            return {"status": 502, "body": "upstream err\n"}
        return {"status": r["status"], "body": "ok\n", "headers": {"Content-Type": "text/plain"}}
    return h

def run():
    av = args()
    port = 18985
    upstream = "http://127.0.0.1:18984/probe"
    if len(av) > 1:
        port = int(av[1])
    if len(av) > 2:
        upstream = "http://127.0.0.1:" + av[2] + "/probe"
    print("proxy ready port=" + str(port) + " upstream=" + upstream)
    flush()
    http_serve(port, mk(upstream))

run()
