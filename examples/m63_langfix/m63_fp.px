# ============================================================
# M63-L9: float→str 最短 roundtrip 全精度（双模式探针 + 断言）
# 编译/解释两模式应逐字节一致；roundtrip 断言 float(str(v))==v
# 预期文本（roundtrip，非 %g 6 位截断）：
#   0.1+0.2 → 0.30000000000000004（旧 %g → 0.3）
#   1/3     → 0.3333333333333333（旧 %g → 0.333333）
#   123456789.123 → 123456789.123（旧 %g → 1.23457e+08）
# ============================================================
def chk(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
    print("PASS: " + msg)

# --- roundtrip：str→float 回读必须还原原 double（最短可逆性） ---
var v1 = 0.1 + 0.2
var v2 = 1.0 / 3.0
var v3 = 123456789.123
var v4 = 1000000000000000.0
var v5 = 3.141592653589793
chk(float(str(v1)) == v1, "roundtrip 0.1+0.2")
chk(float(str(v2)) == v2, "roundtrip 1/3")
chk(float(str(v3)) == v3, "roundtrip 123456789.123")
chk(float(str(v4)) == v4, "roundtrip 1e15")
chk(float(str(v5)) == v5, "roundtrip pi")

# --- 精确文本断言（修复 6 位截断） ---
chk(str(v1) == "0.30000000000000004", "v1 text")
chk(str(v2) == "0.3333333333333333", "v2 text")
chk(str(v3) == "123456789.123", "v3 text")
chk(str(v4) == "1e+15", "v4 text 科学计数")
chk(str(3.0) == "3.0", ".0 语义保持")
chk(str(-3.0) == "-3.0", "负整值 .0 保持")
chk(str(0.0) == "0.0", "0.0 保持")
chk(str(-0.0) == "-0.0", "-0.0 保持")

# --- %g 风格边界值（全扫最短字符实现：定点/科学自适应，防 2.5e+02 类回归） ---
chk(str(250.0) == "250.0", "250.0 定点（非 2.5e+02）")
chk(str(0.0001) == "0.0001", "0.0001 定点（%g 边界）")
chk(str(1e-5) == "1e-05", "1e-5 科学")

# --- 打印（双模式 stdout 逐字节对拍载体） ---
print("v1=" + str(v1))
print("v2=" + str(v2))
print("v3=" + str(v3))
print("v4=" + str(v4))
print("sqrt2=" + str(1.4142135623730951))
print("all done")
