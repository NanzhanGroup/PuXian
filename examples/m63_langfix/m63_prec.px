# ============================================================
# M63-L10: 编译期浮点字面量全精度（codegen 不再 %g 6 位截断）
# 编译模式：px_float(3.141592653589793) 全精度常量 → double 精确
# 旧行为：codegen str(v) 6 位 → px_float(3.14159) → 断言 FAIL
# 与 m63_fp.px（打印 roundtrip）互补：本用例盯「字面量→C 常量」链
# ============================================================
def chk(cond, msg):
    if not cond:
        print("FAIL: " + msg)
        exit(1)
    print("PASS: " + msg)

# 高精度字面量（double 最近值 = 3.141592653589793）
var pi = 3.14159265358979323846
var sq2 = 1.4142135623730951
var third = 0.3333333333333333
var tiny = 2.718281828459045

chk(str(pi) == "3.141592653589793", "pi 字面量全精度")
chk(str(sq2) == "1.4142135623730951", "sqrt2 字面量全精度")
chk(str(third) == "0.3333333333333333", "1/3 近似字面量全精度")
chk(str(tiny) == "2.718281828459045", "e 近似全精度")

# 幂/数学函数值 roundtrip（编译模式 C 常量链）
var p = pow(2.0, 0.5)
chk(float(str(p)) == p, "pow(2,0.5) roundtrip")
chk(str(p) == "1.4142135623730951", "pow(2,0.5) text")

print("prec done")
