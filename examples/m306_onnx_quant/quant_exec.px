# ══════════════════════════════════════════════════════════════════════
# quant_exec.px —— M306 门用：跑一张 .onnx 图并把输出落盘（语言侧唯一入口）
# ---------------------------------------------------------------
# 用法： quant_exec <model.onnx> <feeds.json> <out.json>
# 输出 JSON：{"ok":true,"nodes":N,"by_op":{...},"outputs":{名:{"dims","dtype","nbytes","hex"}}}
#   用 hex 而不是数值列表：二进制安全（float32/int8 逐字节），参考实现自己解码。
# 失败：打印 ONNX-ERR / RUN-ERR 并以非 0 退出（门据此判负控）。
# 与 m157 的 onnx_exec.px **同构**（刻意各自持有：门的驱动脚本互相依赖会让
#   一个门的目录被移动打断另一个门）。
# ══════════════════════════════════════════════════════════════════════
let a = args()
if len(a) < 4:
    print("用法: quant_exec <model.onnx> <feeds.json> <out.json>\n")
    exit(2)
let r = onnx_model_open(a[1])
if type(r) == "result":
    print("ONNX-ERR: " + str(r) + "\n")
    exit(3)
let feeds = json_parse(read_file(a[2]))
let res = onnx_run(r["id"], feeds)
if type(res) == "result":
    print("RUN-ERR: " + str(res) + "\n")
    print("CLOSED=" + str(onnx_model_close(r["id"])) + "\n")
    exit(4)
var outs = {}
for nm in res["outputs"].keys():
    let o = res["outputs"][nm]
    outs[str(nm)] = {"dims": o["dims"], "dtype": o["dtype"], "nbytes": o["nbytes"],
        "hex": bytes_to_hex(o["data"])}
let dump = {"ok": true, "nodes": res["nodes"], "by_op": res["stats"]["by_op"], "outputs": outs}
write_file(a[3], json_stringify(dump))
print("M306-RUN-OK nodes=" + str(res["nodes"]) + " outputs=" + str(len(outs)) + "\n")
print("CLOSED=" + str(onnx_model_close(r["id"])) + "\n")
