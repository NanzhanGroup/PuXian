# ============================================================
# pxhwmond（M58 S3，Err 语义升级）notify.px —— 阈值告警 + 通知
# ------------------------------------------------------------
# 阈值 env（SECURITY/P0：无配置文件、无密钥落盘；未设 → 该类告警不启用）：
#   PXHWMON_ALERT_MEM_AVAIL_KB   mem_avail < 阈值 → 内存不足告警（单位 kB）
#   PXHWMON_ALERT_LOAD1          load1 > 阈值 → 负载告警（float 比较）
#   PXHWMON_ALERT_TEMP_MC        temp(毫°C) > 阈值 → 高温告警（temp=na 跳过）
# 通知通道：
#   1) 告警日志 append（PXHWMON_ALERT_LOG 覆盖，默认 /tmp/pxhwmond_alerts.jsonl）
#   2) webhook 真发（原 dry-run 已解禁）：PXHWMON_WEBHOOK 设置 → http_request
#      POST application/json 到目标；网络失败不再 panic（HTTP 客户端 Err 语义，
#      M58 dogfood 欠账 MINI_SUBSET §十三 #1/#2 修复后闭环），结果（sent 布尔 +
#      err/status）append 到发送日志（PXHWMON_WEBHOOK_LOG 覆盖，默认
#      /tmp/pxhwmond_webhook.jsonl）。超时 3s 不重试，daemon 采样不被拖死。
# ============================================================
import "collect.px"

# ---- 判定：SNAP 文本行 → 告警行 list（无告警 → 空 list）----
def check_alerts(line):
    var alerts = []
    var snap = parse_snap(line)
    var ts = str(now_ms())
    var e = env("PXHWMON_ALERT_MEM_AVAIL_KB")
    if e != null:
        var thr = int(e)
        var v = int(snap["mem_avail"])
        if v < thr:
            alerts.append("ALERT ts=" + ts + " type=mem_avail value=" + str(v) + " threshold=" + str(thr) + " unit=kB")
    var el = env("PXHWMON_ALERT_LOAD1")
    if el != null:
        var lt = float(el)
        var lv = float(snap["load1"])
        if lv > lt:
            alerts.append("ALERT ts=" + ts + " type=load1 value=" + snap["load1"] + " threshold=" + el)
    var et = env("PXHWMON_ALERT_TEMP_MC")
    if et != null and snap["temp"] != "na":
        var tv = int(snap["temp"])
        var tt = int(et)
        if tv > tt:
            alerts.append("ALERT ts=" + ts + " type=temp value=" + snap["temp"] + " threshold=" + et + " unit=mC")
    return alerts

# ---- 告警日志落盘 ----
def write_alert_log(alert):
    var path = "/tmp/pxhwmond_alerts.jsonl"
    var p = env("PXHWMON_ALERT_LOG")
    if p != null:
        path = p
    append_file(path, alert + "\n")

# ---- webhook 真发（Err 语义 dogfood 闭环）：失败可检查、进程不死 ----
# 发送载荷 {ts, source, alert}；结果日志 {ts, url, alert, sent, [err|status]}。
def webhook_send(alert):
    var url = env("PXHWMON_WEBHOOK")
    if url == null:
        return
    var log = "/tmp/pxhwmond_webhook.jsonl"
    var lp = env("PXHWMON_WEBHOOK_LOG")
    if lp != null:
        log = lp
    # 发送载荷（目标收到的 JSON）
    var payload = json_parse("{}")
    payload["ts"] = now_ms()
    payload["source"] = "pxhwmond"
    payload["alert"] = alert
    var hd = json_parse("{}")
    hd["Content-Type"] = "application/json"
    var opt = json_parse("{}")
    opt["timeout_ms"] = 3000
    opt["retries"] = 0
    # http_request 成功 → dict{status,headers,body}；网络失败 → Err(result)
    var resp = http_request(url, "POST", json_stringify(payload), hd, opt)
    # 结果记录（可追溯：url + 成功/失败 + 原因）
    var rec = json_parse("{}")
    rec["ts"] = now_ms()
    rec["url"] = url
    rec["alert"] = alert
    rec["sent"] = false
    if type(resp) == "result" and resp.is_err():
        # 网络失败（连接拒绝/超时/协议等）→ 记 err，进程继续存活
        rec["err"] = resp.err()
    else:
        var st = resp["status"]
        rec["status"] = st
        if st >= 200 and st < 300:
            rec["sent"] = true
        else:
            rec["err"] = "http_status=" + str(st)
    append_file(log, json_stringify(rec) + "\n")
