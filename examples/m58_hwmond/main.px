# ============================================================
# pxhwmond（M58）main.px —— 硬件健康守护 daemon 入口
# ------------------------------------------------------------
# 用法：
#   main                    常驻 daemon（默认每 5s 采样一轮，env 可覆盖）
#   main --once             采 1 轮即退出（CI / qemu / 回归自检用）
#   main --n N              采 N 轮退出（有限时长冒烟）
#   main --interval 2       采样间隔（秒，默认 5）
#   main --port N           HTTP 状态页端口（默认 19858；--no-http 关闭）
#   main --dump             读 mmap 共享区首行快照后退出（外部活读）
#   main --ctl MSG          写 mmap 共享区控制区（外部命令通道模拟）
#   main --shm PATH         共享文件路径（默认 /tmp/pxhwmond.shm）
#   main --no-shm           daemon 不写共享（纯输出模式）
# env 覆盖（SECURITY/P0：无配置文件、无密钥落盘）：
#   PXHWMON_INTERVAL        间隔秒（CLI --interval 优先）
#   PXHWMON_SHM             共享文件路径（CLI --shm 优先）
#   PXHWMON_PORT            HTTP 端口（CLI --port 优先）
#   PXHWMON_ALERT_*         告警阈值（见 notify.px）
#   PXHWMON_WEBHOOK         webhook URL（真发，见 notify.px）
#   PXHWMON_WEBHOOK_LOG     webhook 发送结果日志路径（默认 /tmp/pxhwmond_webhook.jsonl）
# 每轮输出（S3 起）：
#   SNAP ts= cpu= mem_total= mem_avail= load1= load5= load15= up=
#        temp= net_rx= net_tx= [ctl=<外部命令回显>]
# S3 增量：--port 起 serve_http（手写 HTTP /healthz JSON + / HTML + 404，
#   显式响应头）；每轮 check_alerts 阈值告警 → 告警日志 + webhook 真发
#   （Err 语义升级：HTTP 客户端网络失败可检查，daemon 内安全发送）。
# ============================================================
import "collect.px"
import "shm.px"
import "serve.px"
import "notify.px"

# ---- 参数解析 ----
def parse_mode():
    var cfg = {"once": false, "n": 0, "interval_ms": 5000, "interval_cli": false, "dump": false, "ctl": "", "shm": "/tmp/pxhwmond.shm", "no_shm": false, "port": 19858, "port_cli": false, "no_http": false}
    var a = args()
    var i = 1                 # a[0] = 程序路径，跳过
    while i < len(a):
        var arg = a[i]
        if arg == "--once":
            cfg["once"] = true
        elif arg == "--n":
            if i + 1 < len(a):
                cfg["n"] = int(a[i + 1])
                i = i + 1
        elif arg == "--interval":
            if i + 1 < len(a):
                cfg["interval_ms"] = int(a[i + 1]) * 1000
                cfg["interval_cli"] = true
                i = i + 1
        elif arg == "--port":
            if i + 1 < len(a):
                cfg["port"] = int(a[i + 1])
                cfg["port_cli"] = true
                i = i + 1
        elif arg == "--no-http":
            cfg["no_http"] = true
        elif arg == "--dump":
            cfg["dump"] = true
        elif arg == "--ctl":
            if i + 1 < len(a):
                cfg["ctl"] = a[i + 1]
                i = i + 1
        elif arg == "--shm":
            if i + 1 < len(a):
                cfg["shm"] = a[i + 1]
                i = i + 1
        elif arg == "--no-shm":
            cfg["no_shm"] = true
        i = i + 1
    return cfg

# ---- 一轮采集 + 告警 + 输出 + 写共享；返回本轮 cpu stat（作下轮前值）----
def do_round(prev, shm_path):
    var ctl = ""
    if shm_path != "":
        ctl = shm_read_ctl(shm_path)      # 先消费外部命令（双向活映射：外部写→本轮回显）
    var cur = read_stat_cpu()
    var cpu_s = "na"
    if prev != null and cur != null:
        var dT = cur[0] - prev[0]
        var dI = cur[1] - prev[1]
        if dT > 0:
            var p = ((dT - dI) * 100) // dT
            if p < 0:
                p = 0
            if p > 100:
                p = 100
            cpu_s = str(p)
    var mem = collect_mem()
    var ld = collect_load()
    var up = collect_uptime()
    var tp = temp_read()
    var nw = net_dev()
    var l1 = ld["load1"]
    if l1 == "":
        l1 = "na"
    var l5 = ld["load5"]
    if l5 == "":
        l5 = "na"
    var l15 = ld["load15"]
    if l15 == "":
        l15 = "na"
    var us = up["up"]
    if us == "":
        us = "na"
    var ts = tp["temp"]
    if ts == "":
        ts = "na"
    var line = "SNAP ts=" + str(now_ms())
    line = line + " cpu=" + cpu_s
    line = line + " mem_total=" + str(mem["total"])
    line = line + " mem_avail=" + str(mem["avail"])
    line = line + " load1=" + l1
    line = line + " load5=" + l5
    line = line + " load15=" + l15
    line = line + " up=" + us
    line = line + " temp=" + ts
    line = line + " net_rx=" + str(nw["rx"])
    line = line + " net_tx=" + str(nw["tx"])
    if ctl != "":
        line = line + " ctl=" + ctl
    # 阈值告警（MONITORING/P0：发现 + 通知）
    var al = check_alerts(line)
    for a in al:
        write_alert_log(a)
        webhook_send(a)
    if shm_path != "":
        shm_write_snap(shm_path, line + "\n")
    print(line)
    return cur

# ---- --dump：活读共享区首行快照 ----
def cmd_dump(shm_path):
    var s = shm_dump(shm_path)
    if s == "":
        print("dump: 快照为空或共享文件不存在: " + shm_path)
        exit(1)
    print(s)
    exit(0)

# ---- --ctl：外部写控制区（命令通道）----
def cmd_ctl(shm_path, msg):
    if not shm_write_ctl(shm_path, msg):
        print("ctl: 写控制区失败: " + shm_path)
        exit(1)
    print("ctl-written:" + msg)
    exit(0)

# ---- 入口 ----
def main():
    var cfg = parse_mode()
    # env 覆盖：PXHWMON_INTERVAL（秒）；CLI --interval 显式给出时优先
    if not cfg["interval_cli"] and not cfg["once"]:
        var ev = env("PXHWMON_INTERVAL")
        if ev != null:
            cfg["interval_ms"] = int(ev) * 1000
    # env 覆盖：PXHWMON_SHM
    if not cfg["no_shm"]:
        var se = env("PXHWMON_SHM")
        if se != null and cfg["shm"] == "/tmp/pxhwmond.shm":
            cfg["shm"] = se
    # env 覆盖：PXHWMON_PORT
    if not cfg["port_cli"] and not cfg["once"]:
        var pe = env("PXHWMON_PORT")
        if pe != null:
            cfg["port"] = int(pe)
    if cfg["no_shm"]:
        cfg["shm"] = ""
    if cfg["no_http"]:
        cfg["port"] = 0
    # 子命令分发（不 prepare，依赖 daemon 已建共享文件）
    if cfg["dump"]:
        cmd_dump(cfg["shm"])
        return
    if cfg["ctl"] != "":
        cmd_ctl(cfg["shm"], cfg["ctl"])
        return
    # daemon 模式：prepare 共享文件 + 起 HTTP 状态页（--once 单轮不起服务）
    if cfg["shm"] != "":
        shm_prepare(cfg["shm"])
    if cfg["port"] > 0 and not cfg["once"]:
        spawn serve_http(cfg["port"], cfg["shm"])
    var prev = read_stat_cpu()
    if cfg["once"]:
        sleep(300)                    # 300ms 短窗口出真实 CPU 差值
        do_round(prev, cfg["shm"])
        return
    if cfg["n"] > 0:
        var k = 0
        while k < cfg["n"]:
            sleep(cfg["interval_ms"])
            prev = do_round(prev, cfg["shm"])
            k = k + 1
        return
    while true:                       # 常驻 daemon
        sleep(cfg["interval_ms"])
        prev = do_round(prev, cfg["shm"])
