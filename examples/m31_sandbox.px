# M31 沙箱安全 + 限流防爆破（纯函数，双模式一致）
# sandbox_enter(opts{memory_mb, deny, drop_priv}) → bool
#   deny 激活后：被禁函数调用报错（沙箱：函数 X 已被禁用）；示例不触发（报错终止脚本）
# rate_limit(key, max, window_sec) → bool：滑动窗口限流（true 放行 / false 超限）

print("== sandbox_enter ==")
r = sandbox_enter({"deny": ["os_spawn", "os_kill"], "memory_mb": 512, "drop_priv": false})
assert(r == true)
print("sandbox_enter:", r)
# deny 表已激活（os_spawn/os_kill 被禁），但普通内置函数不受影响
print("deny active, normal fns ok:", str(sha256("abc")).len() == 64)

print("== rate_limit ==")
# 窗口 60s 内 max=3：前 3 次放行，第 4 次超限
r1 = rate_limit("demo_key", 3, 60)
r2 = rate_limit("demo_key", 3, 60)
r3 = rate_limit("demo_key", 3, 60)
r4 = rate_limit("demo_key", 3, 60)
assert(r1 == true and r2 == true and r3 == true)
assert(r4 == false)
print("3/3 then block:", str(r1), str(r2), str(r3), str(r4))
# 不同 key 独立计数
r5 = rate_limit("other_key", 3, 60)
assert(r5 == true)
print("independent key:", r5)
# 窗口内不重置（同 key 继续超限）
r6 = rate_limit("demo_key", 3, 60)
assert(r6 == false)
print("still blocked:", r6)
print("ALL OK")
