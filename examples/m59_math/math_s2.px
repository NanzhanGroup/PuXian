# ============================================================
# M59 S2 math_s2.px —— floor/ceil/round + log/log10/exp + e 常量
# ------------------------------------------------------------
# 断言策略同 math_s1.px（M59-S1 实测：高精度 float 字面量被编译期
# 截断 ~6 位有效数字，期望值用表达式/低精度字面量；容差 1e-12）。
# 域错误语义（M59-PLAN §3.3）：log(-1)→NaN、exp(1000)→+inf 透传不终止。
# 退出：全过 → "M59-S2 OK" 退出码 0；失败 → assert 终止 exit 1
# ============================================================

def approx(actual, expected, tol):
    return abs(actual - expected) <= tol

# ---- floor（向下取整）----
assert(floor(2.7) == 2.0, "floor(2.7)==2")
assert(floor(-2.1) == -3.0, "floor(-2.1)==-3（向负无穷）")
assert(floor(2) == 2.0, "floor(2) int 入参→2.0")
assert(type(floor(2)) == "float", "floor 返回 float（与 sqrt 一致）")

# ---- ceil（向上取整）----
assert(ceil(2.1) == 3.0, "ceil(2.1)==3")
assert(ceil(-2.7) == -2.0, "ceil(-2.7)==-2（向正无穷）")
assert(ceil(3) == 3.0, "ceil(3)==3")

# ---- round（C99 .5 远离零）----
assert(round(2.5) == 3.0, "round(2.5)==3（.5 远离零）")
assert(round(2.4) == 2.0, "round(2.4)==2")
assert(round(-2.5) == -3.0, "round(-2.5)==-3（负 .5 远离零）")
assert(round(-2.4) == -2.0, "round(-2.4)==-2")
assert(round(3.0) == 3.0, "round(3.0)==3")
assert(round(0.5) == 1.0, "round(0.5)==1")

# ---- log（自然对数 ln）----
assert(log(1) == 0.0, "log(1)==0")
assert(approx(log(e), 1.0, 1e-12), "log(e)≈1（e 全精度隐式验证：若 e 截 6 位则差 4.9e-7 会失败）")

# ---- log10 ----
assert(log10(1) == 0.0, "log10(1)==0")
assert(approx(log10(1000), 3.0, 1e-12), "log10(1000)≈3")
assert(approx(log10(100), 2.0, 1e-12), "log10(100)≈2")
assert(approx(log10(10), 1.0, 1e-12), "log10(10)≈1")

# ---- exp ----
assert(exp(0) == 1.0, "exp(0)==1")
assert(approx(exp(1), e, 1e-12), "exp(1)≈e（全精度互证）")

# ---- e 常量 ----
assert(type(e) == "float", "e 是 float")
assert(e * 1000000 > 2718281 and e * 1000000 < 2718283, "e 前 7 位 ≈ 2.718282")
print("e =", e)

# ---- 域错误透传（不终止即通过：若 px_error 则脚本 exit 1 被 verify 捕获）----
var nanv = log(-1)     # NaN，不终止
print("log(-1) =", nanv)   # 打印 nan
var infv = exp(1000)   # +inf，不终止
print("exp(1000) =", infv)
var nanv2 = log(0)     # -inf
print("log(0) =", nanv2)

print("M59-S2 OK")
