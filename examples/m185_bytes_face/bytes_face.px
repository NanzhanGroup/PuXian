# M185 门 · 语料①：bytes 的「索引 / 切片 / 迭代」三面统一（缺陷 203）
def iter_bytes(v):
    var out = []
    for x in v:
        out.append(x)
    return out

def main():
    let b = bytes("abcd")
    print("i0=", b[0])
    print("i3=", b[3])
    print("im1=", b[-1])
    print("ieq=", bytes_get(b, 2) == b[2])
    print("s13=", bytes_to_str(b[1:3]))
    print("se2=", bytes_to_str(b[::2]))
    print("srev=", bytes_to_str(b[::-1]))
    print("sneg=", bytes_to_str(b[-2:]))
    print("slen=", bytes_len(b[1:3]))
    print("sfull=", bytes_to_str(b[:]))
    print("iter=", iter_bytes(b))
    var tot = 0
    for x in b:
        tot += x
    print("sum=", tot)
    let zh = bytes("你好")
    print("zhlen=", bytes_len(zh))
    print("zhiter=", iter_bytes(zh))
    print("zhslice=", bytes_to_hex(zh[0:3]))
    print("zhidx0=", zh[0])
    let e = bytes("")
    print("elen=", bytes_len(e))
    print("eslice=", bytes_len(e[0:0]))
    print("eiter=", len(iter_bytes(e)))
    let raw = hex_to_bytes("00ff10")
    print("rlen=", bytes_len(raw))
    print("riter=", iter_bytes(raw))
    print("rslice=", bytes_to_hex(raw[1:3]))
    print("ridx=", raw[1])
    # 索引与切片同轴（同一字节）
    print("same=", b[1] == bytes_get(b[1:2], 0))
    print("same2=", b[2] == bytes_get(b[-2:-1], 0))
