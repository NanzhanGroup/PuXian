# ============================================================
# M51 QPACK 会话接入线上：客户端（HTTP/3 + QPACK 动态表走真实单向流）
# ------------------------------------------------------------
# 流程：quic_connect（QUIC 握手）
#       → h3_conn_setup(c, 4096)：本端开 3 条单向流（控制流=首条 uni + SETTINGS、
#         编码器流 0x02、解码器流 0x03），建 QPACK 动态表会话
#       → open bidi 请求流 → 发请求 A（长自定义头 x-token 强制动态表插入）
#       → 读响应 → 发请求 B（同头同路径，验证动态表复用：编码器流零新增指令）
# 关键断言：本端 enc_sent（编码器流累计发送）在请求 B 后不再增长 = 动态表复用；
#           对端 peer_qcap==4096（SETTINGS 经真实控制流协商）；
#           响应字段还原正确（status/body/headers 与请求一一对应）。
# 验证：examples/m51_h3_qpack_wire_verify.sh（编译+解释双模式输出逐字节一致）
# ============================================================
import "c/ngtcp2"

extern def quic_connect(ip: str, port: int, alpn: str) -> int
extern def quic_close(conn: int) -> bool
extern def quic_open_uni_stream(conn: int) -> int
extern def h3_conn_setup(conn: int, qpack_cap: int) -> bool
extern def h3_conn_close(conn: int) -> bool
extern def h3_conn_peer(conn: int) -> dict
extern def h3_conn_stats(conn: int) -> dict
extern def h3_client_open_stream(conn: int) -> int
extern def h3_client_send_request_stream(conn: int, sid: int, method: str, scheme: str, authority: str, path: str, headers: list, body: str) -> bool
extern def h3_client_read_response_stream(conn: int, sid: int, timeout_ms: int) -> dict

var c = quic_connect("127.0.0.1", 17999, "puxian")
assert(c > 0, "client: quic_connect 失败")
print("client: connected " + str(c))

# 建立 HTTP/3 连接会话：开 3 条单向流 + SETTINGS + QPACK 动态表
var ok = h3_conn_setup(c, 4096)
assert(ok, "client: h3_conn_setup 失败")
var st0 = h3_conn_stats(c)
assert(st0 != null and st0["enc_sid"] > 0, "client: setup 后应有本端编码器流")
print("client: setup ok ctrl=" + str(st0["ctrl_sid"]) + " enc=" + str(st0["enc_sid"]) + " dec=" + str(st0["dec_sid"]))

# 通用请求头（含长自定义值 → 强制 QPACK 动态表插入；两端共享静态表不含 x-token）
var hdrs = [["x-token", "tok-abcdef0123456789-http3-qpack-wire"], ["x-round", "m51"]]

# 请求 A：第一次发（authority/path/x-token/x-round 均入动态表 → 编码器流有 Insert 指令）
var s1 = h3_client_open_stream(c)
assert(s1 > 0, "client: open_stream 失败")
print("client: request A stream " + str(s1))
ok = h3_client_send_request_stream(c, s1, "GET", "https", "localhost:17999", "/wire-a", hdrs, "body-a")
assert(ok, "client: send A 失败")
var stA = h3_conn_stats(c)
print("client: after A enc_sects=" + str(stA["enc_sects"]) + " enc_sent=" + str(stA["enc_sent"]))
assert(stA["enc_sects"] >= 1 and stA["enc_sent"] > 0, "client: 请求 A 应产生编码器流指令")

var r1 = h3_client_read_response_stream(c, s1, 8000)
assert(r1 != null, "client: 响应 A 超时/缺失")
assert(r1["status"] == "200" and r1["body"] == "echo-wire:/wire-a:stream-" + str(s1), "client: 响应 A 内容错误")
print("client: resp A status=" + r1["status"] + " body=[" + r1["body"] + "]")

# 对端（server）SETTINGS 应已从真实控制流解析
var p1 = h3_conn_peer(c)
print("client: peer ctrl=" + str(p1["peer_ctrl"]) + " enc=" + str(p1["peer_enc"]) + " qcap=" + str(p1["peer_qcap"]) + " enc_bytes=" + str(p1["peer_enc_bytes"]))
assert(p1["peer_ctrl"] > 0 and p1["peer_enc"] > 0, "client: 未发现对端控制/编码器流")
assert(p1["peer_qcap"] == 4096, "client: 对端 SETTINGS 容量协商错误")

# 请求 B：同头同路径 → 动态表全命中 → 编码器流零新增指令
var s2 = h3_client_open_stream(c)
assert(s2 > 0, "client: open_stream B 失败")
print("client: request B stream " + str(s2))
ok = h3_client_send_request_stream(c, s2, "GET", "https", "localhost:17999", "/wire-a", hdrs, "body-b")
assert(ok, "client: send B 失败")
var stB = h3_conn_stats(c)
print("client: after B enc_sects=" + str(stB["enc_sects"]) + " enc_sent=" + str(stB["enc_sent"]))
assert(stB["enc_sent"] == stA["enc_sent"], "client: 请求 B 应复用动态表（编码器流零新增）")

var r2 = h3_client_read_response_stream(c, s2, 8000)
assert(r2 != null, "client: 响应 B 超时/缺失")
assert(r2["status"] == "200" and r2["body"] == "echo-wire:/wire-a:stream-" + str(s2), "client: 响应 B 内容错误")
print("client: resp B status=" + r2["status"] + " body=[" + r2["body"] + "]")

print("client: qpack dynamic table over uni streams OK")
h3_conn_close(c)
quic_close(c)
print("client: done")
