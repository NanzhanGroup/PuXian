# ============================================================
# M409 门探针 · **容器生命周期**（缺陷 267：mark 之后仍在执行的对象不得被本轮回收）
# ------------------------------------------------------------
# 形态（两条执行流 + 主控）：
#   · victim ×2（跑在协程 worker 线程上）：**只在循环外建一次** dict/list，循环内只做
#     「改写已存在的槽 + 读回自查」——**循环里绝不分配**（v2 教训见下），对象始终挂在
#     该线程的 TLS 登记根栈上。
#   · 主控：显式 `gc()` × N（**由探针自己决定 GC 时刻** ⇒ 判据不靠"跑久碰巧撞上"）。
#   · 门用注入（`PX_GC_FORCE_EARLY_RESUME=1` + `PX_GC_M409_HOLD_US=<us>`）把
#     「某线程提前挣脱暂停 → 建根面快照」的窗口拉宽 ⇒ 窗口必现。
#     hold 期间 executor 不再发信号，已挣脱的 victim 在用户态改写自己的容器 ⇒
#     这些容器**不会被本轮 mark**（它已 paused=0，根面不扫）⇒ 负控（`PX_GC_EARLY_ABORT=0`）
#     下会被 sweep 回收 ⇒ 后续改写落在复用存储上 ⇒ `[M257-CTR]` / LIVECHK / SIG / BAD>0。
#
# ⚠️ v2（已废弃，2026-11-16 08:3x）为什么不行：victim 在循环里 `{}`/`[]` 分配。
#   本运行时**分配路径要拿 g_gc_mu**（executor 全程持有）⇒ 挣脱线程一分配就阻塞在锁上，
#   根本走不进「mark 之后新分配」的窗口 ⇒ 负控 `BAD=0` 恒绿（假绿）。实测
#   `[M409-HOLD] objs 314->314`（hold 50ms 内对象数零增长）即为此。
#
# 修后期望：`M409-PROBE-DONE` + `BAD=0` + 无 CTR 无信号，且 `[M409-STAT] 因挣脱放弃 sweep>0`
#   （后者是**前提自证**：装置真的制造出了挣脱窗口，否则这扇门就是空转假绿）。
#
# ⚠️ 本探针不发网络包、不碰端口、不写数据目录（M264 门间隔离），只吃内存 + stdout。
# ============================================================
var ROUNDS = 24        # 主控 gc() 轮数（可由 M409_PROBE_ROUNDS 覆盖）
var stop = 0
var bad = 0

def victim(tag):
    # 容器只建一次：此后整段存活期都挂在本线程 TLS 登记根栈上
    let d = {"a": 0, "b": tag}
    let l = [0, 0, 0]
    var i = 1
    while stop == 0:
        d["a"] = i          # 只改已有槽 ⇒ 不分配（见文件头 v2 教训）
        l[0] = i
        # 读回自查：存储若被回收/复用，这里读到的是垃圾（S3a 守卫/LIVECHK 先响亮）
        if d["a"] != i:
            bad += 1
        if d["b"] != tag:
            bad += 1
        if l[0] != i:
            bad += 1
        i += 1
    return 0

let _r = env("M409_PROBE_ROUNDS")
if _r != null:
    if _r != "":
        ROUNDS = int(_r)

spawn victim("w1")
spawn victim("w2")
var r = 0
while r < ROUNDS:
    gc()
    r += 1
stop = 1
sleep(200)
print("M409-PROBE-BAD=" + str(bad))
print("M409-PROBE-DONE")
