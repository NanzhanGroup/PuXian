# M35③ HTTP/2 的**设计边界**：px-serve 明确拒绝 h2（doc: docs/HTTP2_DECISION.md）
# ------------------------------------------------------------
# 旧版本示例断言「h2 端到端可用」—— 与产品口径（h2 不做）相反，等于教用户用一个
# 不存在的功能（缺陷 872）。本版只证明「拒绝是响亮的、可预期的」：
#   ① h2c 升级请求 → 服务端**不**回 101，按 HTTP/1.1 正常响应
#   ② HTTP/2 prior-knowledge 前导 → 服务端拒绝（不回任何 HTTP/2 帧）
#   ③ 拒绝之后服务仍存活（还能服务 HTTP/1.1）—— 防「崩溃也算拒绝」
PORT = 18163
D = "/tmp/px_m35_h2"
mkdir(D)
write_file(D + "/index.html", "H2-STATIC")

write_file("/tmp/h2_client.py", '''
import socket, sys
port = int(sys.argv[1])

def talk(payload, want_headers_only=True):
    s = socket.create_connection(("127.0.0.1", port), timeout=5)
    s.settimeout(4)
    s.sendall(payload)
    data = b""
    try:
        while True:
            ch = s.recv(4096)
            if not ch:
                break
            data += ch
            if want_headers_only and b"\\r\\n\\r\\n" in data:
                break
    except Exception:
        pass
    s.close()
    return data

# ① h2c 升级：必须不回 101
d1 = talk(b"GET /index.html HTTP/1.1\\r\\nHost: 127.0.0.1\\r\\nConnection: Upgrade\\r\\n"
          b"Upgrade: h2c\\r\\nHTTP2-Settings: AAMAAABkAAQCAAAAAAIAAAAA\\r\\n\\r\\n")
first = d1.split(b"\\r\\n")[0] if d1 else b""
no101 = b"101" not in first
http11 = first.startswith(b"HTTP/1.1")

# ② prior-knowledge 前导：必须不产生 HTTP/2 帧
d2 = talk(b"PRI * HTTP/2.0\\r\\n\\r\\nSM\\r\\n\\r\\n", want_headers_only=False)
no_h2 = b"PuXian HTTP/2" not in d2

# ③ 拒绝之后仍能服务 HTTP/1.1
d3 = talk(b"GET /index.html HTTP/1.1\\r\\nHost: x\\r\\nConnection: close\\r\\n\\r\\n", False)
alive = d3.startswith(b"HTTP/1.1 200") and b"H2-STATIC" in d3

print("first_line=[" + first.decode("latin1") + "]")
print("no101=%s http11=%s no_h2_frames=%s" % (no101, http11, no_h2))
print("STILL_ALIVE" if alive else "NOT_ALIVE")
print("H2_REJECT_AS_DESIGNED" if (no101 and http11 and no_h2 and alive) else "H2_REJECT_FAIL")
''')

def serve():
    # 不带 h2_demo：口径是「h2 不做」，示例不应演示一个产品不支持的能力
    px_serve(PORT, D, 10000)
spawn serve()
sleep(600)

os_spawn("/bin/sh", ["-c", "python3 /tmp/h2_client.py " + str(PORT) + " > /tmp/m35_h2_res.txt 2>&1"])
sleep(2000)
res = read_file("/tmp/m35_h2_res.txt")
print("h2 client:", res)
assert(contains(res, "H2_REJECT_AS_DESIGNED"), "h2 必须被明确拒绝（且拒绝后仍可服务）")
print("M35_H2_REJECT_OK")
