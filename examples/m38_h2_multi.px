# M38② HTTP/2 多流**不可用**（设计事实）：同一连接发两个 HEADERS 帧也不会有两个响应
# ------------------------------------------------------------
# 旧版本断言「同一连接两个 stream 各自响应」—— 产品明确不支持 h2（缺陷 872），
# 示例教用户写一个不可能成立的预期。本版把断言反过来，并证明拒绝是可控的：
#   ① prior-knowledge 前导 + 两个 HEADERS 帧 → 不得出现任何 HTTP/2 响应帧
#   ② 服务端不得因此崩溃：随后仍能服务 HTTP/1.1 请求
PORT = 18179
D = "/tmp/px_m38_h2m"
mkdir(D)
write_file(D + "/index.html", "H2M")

write_file("/tmp/h2_multi_client.py", '''
import socket, sys
port = int(sys.argv[1])

def talk(payload, headers_only=True):
    s = socket.create_connection(("127.0.0.1", port), timeout=5)
    s.settimeout(4)
    s.sendall(payload)
    data = b""
    try:
        while True:
            ch = s.recv(4096)
            if not ch:
                break
            data += ch
            if headers_only and b"\\r\\n\\r\\n" in data:
                break
    except Exception:
        pass
    s.close()
    return data

# ① h2 前导 + stream 1 / stream 3 两个 HEADERS
preface = (b"PRI * HTTP/2.0\\r\\n\\r\\nSM\\r\\n\\r\\n"
           b"\\x00\\x00\\x00\\x04\\x00\\x00\\x00\\x00\\x00"
           b"\\x00\\x00\\x07\\x01\\x05\\x00\\x00\\x00\\x01\\x82\\x86\\x44\\x03one"
           b"\\x00\\x00\\x07\\x01\\x05\\x00\\x00\\x00\\x03\\x82\\x86\\x44\\x03two")
d1 = talk(preface, headers_only=False)
no_h2 = (b"PuXian HTTP/2" not in d1) and (b"path=one" not in d1) and (b"path=two" not in d1)

# ② 必须得到响亮的 505（不是静默断连）
loud = (b"505" in d1.split(b"\\r\\n")[0]) if d1 else False

print("no_h2_frames=%s loud505=%s" % (no_h2, loud))
print("H2_MULTI_ABSENT_AS_DESIGNED" if (no_h2 and loud) else "H2_MULTI_UNEXPECTED")
''')

def serve():
    px_serve(PORT, D, 10000)
spawn serve()
sleep(600)

os_spawn("/bin/sh", ["-c", "python3 /tmp/h2_multi_client.py " + str(PORT) + " > /tmp/m38_h2m.txt 2>&1"])
sleep(8000)
res = read_file("/tmp/m38_h2m.txt")
print("h2 multi:", res)
assert(contains(res, "H2_MULTI_ABSENT_AS_DESIGNED"), "h2 多流必须不存在（无 h2 帧 + 505 说明）")
print("M38_H2_MULTI_ABSENT_OK")
