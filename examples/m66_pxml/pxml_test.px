# pxml_test.px —— pxml.px 单元测试
# 运行：examples/m66_pxml/verify.sh（双模式 68 PASS）
import std.pxml
var g_pass = 0
var g_fail = 0
def check(name, cond, extra):
    if cond:
        g_pass += 1
    else:
        g_fail += 1
        print("FAIL:", name, extra)
# 标量字面量（显式类型，无隐式转换）
def t_scalar():
    let r = pxml_parse("a = 1\nb = \"hi\"\nc = true\nd = 3.14\ne = null\nf = -5\ng = 1.5e3\nh = 'sq'\n")  # noqa
    check("ok", r["ok"], r)
    if r["ok"]:
        let v = r["value"]
        check("int", v["a"] == 1, v["a"])
        check("str", v["b"] == "hi", v["b"])
        check("bool", v["c"] == true, v["c"])
        check("float", v["d"] == 3.14, v["d"])
        check("null", v["e"] == null, v["e"])
        check("neg", v["f"] == -5, v["f"])
        check("sci", v["g"] == 1500, v["g"])
        check("sq", v["h"] == "sq", v["h"])
# 块 / dict 同形 + duration 纳秒换算 + 数组
def t_block():
    let r = pxml_parse("server {\n    port = 8080\n    host = \"127.0.0.1\"\n    ttl = 720h\n    tags = [\"llm\", \"cache\",]\n    limits = { max = 100, min = 1 }\n}\n")  # noqa
    check("ok", r["ok"], r)
    if r["ok"]:
        let v = r["value"]["server"]
        check("port", v["port"] == 8080, v["port"])
        check("host", v["host"] == "127.0.0.1", v["host"])
        check("ttl ns", v["ttl"] == 2592000000000000, v["ttl"])
        check("tags", len(v["tags"]) == 2 and v["tags"][1] == "cache", v["tags"])
        check("limits", v["limits"]["max"] == 100, v["limits"])
        check("nested eq", v["limits"]["min"] == 1, v["limits"])
# duration：v0.5 定稿单位收敛 ms/s/m/h/d（ns/us 不再支持）
def t_duration():
    var cases = []
    cases.append("x = 3ms")
    cases.append("x = 4s")
    cases.append("x = 5m")
    cases.append("x = 1.5h")
    cases.append("x = 2d")
    var want = []
    want.append(3000000)
    want.append(4000000000)
    want.append(300000000000)
    want.append(5400000000000)
    want.append(172800000000000)
    var i = 0
    while i < len(cases):
        let r = pxml_parse(cases[i] + "\n")
        check("dur" + str(i), r["ok"] and r["value"]["x"] == want[i], r)
        i += 1
    let rns = pxml_parse("x = 1ns\n")
    let rus = pxml_parse("x = 2us\n")
    check("dur ns err", not rns["ok"], rns)
    check("dur us err", not rus["ok"], rus)
# env/include call 节点
def t_call():
    let r = pxml_parse("api_key = env(\"LLM_API_KEY\")\nupstream = include(\"llm.pxml\", \"extra\")\n")  # noqa
    check("ok", r["ok"], r)
    if r["ok"]:
        let k = r["value"]["api_key"]
        check("call env", k["__call"] == "env", k)
        check("arg0", k["args"][0] == "LLM_API_KEY", k)
        check("arg len", len(k["args"]) == 1, k)
        let u = r["value"]["upstream"]
        check("call inc", u["__call"] == "include" and len(u["args"]) == 2, u)
# ENC 原样保留（带标记字符串，不解密）
def t_enc():
    let raw = "db_password = ENC[aes256gcm, kid:v1, data:q0X9t2Z==, iv:7a1c4e, tag:9c4ef2]\n"
    let r = pxml_parse(raw)
    check("ok", r["ok"], r)
    if r["ok"]:
        let got = r["value"]["db_password"]
        check("enc raw", got == "ENC[aes256gcm, kid:v1, data:q0X9t2Z==, iv:7a1c4e, tag:9c4ef2]", got)  # noqa
        check("enc prefix", got[0:4] == "ENC[", got)
# 注释与字符串内 # 不剥离；URL 需引号
def t_comment():
    let r = pxml_parse("# 整行\nx = \"a#b\"  # 行尾\nurl = \"https://x.com/#frag\"\n")
    check("ok", r["ok"], r)
    if r["ok"]:
        check("hash in str", r["value"]["x"] == "a#b", r["value"]["x"])
        check("url", r["value"]["url"] == "https://x.com/#frag", r["value"]["url"])
    let r2 = pxml_parse("u = https://x.com\n")
    check("url bare err", not r2["ok"], r2)
# 三引号多行字符串
def t_triple():
    let r = pxml_parse("s = \"\"\"line1\nline2\"\"\"\n")
    check("ok", r["ok"], r)
    if r["ok"]:
        check("triple", r["value"]["s"] == "line1\nline2", r["value"]["s"])
# 引号键 / 转义
def t_quoted_key_escape():
    let r = pxml_parse("\"my key\" = 1\n'a:b' = 2\nesc = \"a\\nb\\tc\"\n")
    check("ok", r["ok"], r)
    if r["ok"]:
        check("qkey", r["value"]["my key"] == 1, r["value"])
        check("qkey2", r["value"]["a:b"] == 2, r["value"])
        check("esc", r["value"]["esc"] == "a\nb\tc", r["value"]["esc"])
# 数组：空 / 嵌套 / 尾逗号
def t_array():
    let r = pxml_parse("a = []\nb = [1, 2,]\nc = [ { x = 1 }, [2, 3], \"s\", true ]\n")
    check("ok", r["ok"], r)
    if r["ok"]:
        check("empty", len(r["value"]["a"]) == 0, r["value"]["a"])
        check("arr2", len(r["value"]["b"]) == 2 and r["value"]["b"][1] == 2, r["value"]["b"])
        check("deep", r["value"]["c"][0]["x"] == 1 and r["value"]["c"][1][0] == 2, r["value"]["c"])
        check("deep end", r["value"]["c"][3] == true, r["value"]["c"])
# 空文件 / 空容器
def t_empty():
    let r = pxml_parse("")
    check("empty file", r["ok"] and len(r["value"]) == 0, r)
    let r2 = pxml_parse("a = {}\nb {}\n")
    check("empty cont", r2["ok"] and len(r2["value"]["a"]) == 0 and len(r2["value"]["b"]) == 0, r2)
# 错误用例
def t_err():
    var bad = []
    bad.append("a: 1\n")
    bad.append("x = foo\n")
    bad.append("a = 1\na = 2\n")
    bad.append("server {\n  a = 1\n")
    bad.append("x = \"abc\n")
    bad.append("x = 1x\n")
    bad.append("x = ENC[abc\n")
    bad.append("x = env(123)\n")
    bad.append("x = foo(1)\n")
    bad.append("}\n")
    bad.append("a = 1,\n")
    bad.append("x = \\q\n")
    bad.append("x = @\n")
    var i = 0
    while i < len(bad):
        let r = pxml_parse(bad[i])
        check("bad" + str(i), not r["ok"], r)
        i += 1
# 无缩进语义：空格/tab/缩进随意，不产生语法含义（与 YAML 相反）
def t_indent_free():
    let r = pxml_parse("a {\n\tb = 1\n  c = 2\n        }\n")
    check("tab ok", r["ok"], r)
    if r["ok"]:
        check("tab val", r["value"]["a"]["b"] == 1 and r["value"]["a"]["c"] == 2, r["value"])
def t_err_msg():
    let r = pxml_parse("x = \"abc\n")
    check("line1", not r["ok"] and r["error"] == "line 1: 字符串未闭合（不能跨行；多行请用 \"\"\"）", r)
    let r2 = pxml_parse("a = 1\na = 2\n")
    check("dup line2", not r2["ok"] and r2["error"] == "line 2: 重复键 'a'", r2)
    let r3 = pxml_parse("server {\n  a = 1\n")
    check("brace line3", not r3["ok"] and r3["error"] == "line 3: '{' 未闭合", r3)
    let r4 = pxml_parse("a = ENC[xx\n")
    check("enc line1", not r4["ok"], r4)
    let r5 = pxml_parse("x = 1ns\n")
    check("dur msg", not r5["ok"] and r5["error"] == "line 1: 未知的 duration 单位 'ns'（支持 ms/s/m/h/d；文本请加引号）", r5)  # noqa
def main():
    t_scalar()
    t_block()
    t_duration()
    t_call()
    t_enc()
    t_comment()
    t_triple()
    t_quoted_key_escape()
    t_array()
    t_empty()
    t_indent_free()
    t_err()
    t_err_msg()
    print("PASS:", g_pass, "FAIL:", g_fail)
    if g_fail > 0:
        print("TEST_RESULT: FAIL")
    else:
        print("TEST_RESULT: PASS")
