print("== json_path ==")
d = json_parse('{"a": [10, 20, {"b": "x"}], "user": {"name": "普贤", "tags": ["px", "lang"]}}')
print("a[1]:", json_path(d, "$.a[1]"))
print("a[2].b:", json_path(d, "$.a[2].b"))
print("user.name:", json_path(d, "$.user.name"))
print("user.tags[-1]:", json_path(d, "$.user.tags[-1]"))
print("missing:", json_path(d, "$.nope"))
d2 = json_path_set(d, "$.a[1]", 99)
print("set a[1]:", json_path(d2, "$.a[1]"))
d3 = json_path_set(d, "$.user.age", 30)
print("set age:", json_path(d3, "$.user.age"))
d4 = json_path_set(d, "$.x[2]", "z")
print("set x[2]:", json_path(d4, "$.x[2]"))
print("orig a[1]:", json_path(d, "$.a[1]"))
print("str input:", json_path('{"k": [1,2]}', "$.k[0]"))
print("stringify:", json_stringify(d4))
