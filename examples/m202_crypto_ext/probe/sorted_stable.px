# M202 探针 · 正例⑤：稳定性 + **无 key 时的零回归**（M162 语义不得被扩展破坏）
def p(tag, v):
    print(tag + "=" + str(v))

def main():
    # 键相等 ⇒ 保持原序（1.0 与 1 数值相等、渲染不同 ⇒ 顺序可观测）
    p("s01", sorted([1.0, 1, 0.5], fn (x): x))
    p("s02", sorted([1, 1.0, 0.5], fn (x): x))
    # 键相等但可区分（同键不同值）⇒ 原序保持
    p("s03", sorted([["a", 1], ["a", 2], ["a", 3], ["b", 0]], fn (p): p[0]))
    p("s04", sorted([[1, "z"], [1, "y"], [0, "x"]], fn (p): p[0]))
    # 全等键 ⇒ 完全原序
    p("s05", sorted([5, 4, 3, 2, 1], fn (x): 0))
    # ---- 零回归：无 key 的既有语义（值比较 + 稳定）逐字节不变 ----
    p("s06", sorted([10, 9, 2]))
    p("s07", sorted([[1, "a"], [1, "a2"]]))
    p("s08", sorted([1.0, 1, 0.5]))
    p("s09", sorted([1, 1.0, 0.5]))
    p("s10", sorted([true, "a", 1]))
    p("s11", sorted([[2], 1]))
    p("s12", sorted("cba"))
    p("s13", sorted((3, 1, 2)))
