# M153 门（预算语料）：分配率硬阈值门的输入
#   三个相位分别打「字面量常量」「单字符索引」「空串」这三类池化目标。
#   池化生效 ⇒ 每次迭代几乎零分配；任一类退回新建 ⇒ 计数成百万级回升。
var N = 200000
let S = "abcdefghij"

def phase_literals():
    var i = 0
    var n = 0
    while i < N:
        let a = "abc"
        let b = ""
        if a == "abc" and b != "x" and len(a) == 3:
            n = n + 1
        i = i + 1
    return n

def phase_chars():
    var i = 0
    var n = 0
    while i < N:
        let c = S[i % 10]
        if c >= "0" and c <= "9":
            n = n + 1
        else:
            n = n + len(c)
        i = i + 1
    return n

def phase_empty():
    var i = 0
    var n = 0
    while i < N:
        let e = ""
        let f = "" + ""
        if e == "" and len(f) == 0:
            n = n + 1
        i = i + 1
    return n

print("alloc-corpus " + str(phase_literals()) + " " + str(phase_chars()) + " " + str(phase_empty()))
