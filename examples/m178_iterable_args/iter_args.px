# M178 门 · 用例 A：可迭代实参矩阵（四种形态 × 四个入口）
#   形态 = list / tuple / 生成器 / 字符串（str 按 **rune**）
#   入口 = join / sorted / reversed / contains
# 判据：三轨（解释 · VM · C）stdout **逐字节一致** + 定点行在。
print("1  join_list=" + join("-", [1, 2, 3]))
print("2  join_tuple=" + join("-", (1, 2, 3)))
print("3  join_gen=" + join("-", (x for x in [1, 2, 3])))
print("4  join_str=" + join("-", "abc"))
print("5  join_gen_str=" + join("", (c for c in "中文")))
print("6  join_cjk_sep=" + join("、", (x for x in ["中", "文"])))
print("7  join_mixed=" + join(",", (1, "a", true)))
print("8  join_gen_empty=[" + join("-", (x for x in [])) + "]")
print("9  sorted_list=" + str(sorted([3, 1, 2])))
print("10 sorted_tuple=" + str(sorted((3, 1, 2))))
print("11 sorted_gen=" + str(sorted((x for x in [3, 1, 2]))))
print("12 sorted_str=" + str(sorted("cab")))
print("13 sorted_dup=" + str(sorted((x for x in [2, 1, 2, 1]))))
print("14 sorted_gen_empty=" + str(sorted((x for x in []))))
print("15 rev_list=" + str(reversed([1, 2, 3])))
print("16 rev_tuple=" + str(reversed((1, 2, 3))))
print("17 rev_gen=" + str(reversed((x for x in [1, 2, 3]))))
print("18 rev_str=" + reversed("abc"))
print("19 rev_str_cjk=" + reversed("中文"))
print("20 rev_str_mix=" + reversed("a中b"))
print("21 rev_str_empty=[" + reversed("") + "]")
print("22 rev_nested=" + str(reversed([[1, 2], "ab"])))
print("23 rev_gen_empty=" + str(reversed((x for x in []))))
print("24 contains_list=" + str(contains([1, 2, 3], 2)))
print("25 contains_tuple=" + str(contains((1, 2, 3), 2)))
print("26 contains_gen=" + str(contains((x for x in [1, 2, 3]), 2)))
print("27 contains_str=" + str(contains("abc", "b")))
print("28 contains_str_nonstr=" + str(contains("abc", 1)))
print("29 contains_gen_str=" + str(contains((c for c in "abc"), "a")))
print("30 contains_gen_empty=" + str(contains((x for x in []), 1)))
print("31 contains_gen_miss=" + str(contains((x for x in [1, 2]), 9)))
print("M178A-ITERABLE-ARGS-OK")
