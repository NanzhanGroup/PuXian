## 普贤标准库演示（M5）
## 覆盖：std.io / std.fs / std.json / std.time / std.collections（普贤自举库）/ 高阶函数

import std.collections

def main():
    # ---- std.io / std.fs：文件读写 ----
    let path = "/tmp/px_std_demo.txt"
    write_file(path, "hello 普贤\n")
    append_file(path, "line2\n")
    assert(exists(path), "文件应存在")
    let content = read_file(path)
    print("文件内容:", content.trim())

    # ---- 目录操作 ----
    mkdir("/tmp/px_std_demo_dir")
    let entries = list_dir("/tmp/px_std_demo_dir")
    print("目录条目数:", len(entries))

    # ---- std.json ----
    let data = json_parse("{\"name\": \"px\", \"tags\": [1, 2, 3], \"ok\": true}")
    print("JSON name:", data["name"])
    print("JSON tags[0]:", data["tags"][0])
    print("JSON 回写:", json_stringify(data))

    # ---- std.time ----
    print("当前时间:", now())
    let t0 = now_ms()
    sleep(10)
    print("sleep 10ms 耗时:", now_ms() - t0)

    # ---- std.collections（普贤自举库）----
    let nums = [3, 1, 4, 1, 5, 9, 2, 6]
    print("unique:", unique(nums))
    print("flatten:", flatten([[1, 2], [3], [4, 5]]))
    print("chunk:", chunk([1, 2, 3, 4, 5], 2))
    print("zip:", zip_lists([1, 2, 3], ["a", "b", "c"]))
    print("sort_by:", sort_by(nums, fn(x) { x % 3 }))

    # ---- 高阶函数（builtin map/filter/reduce）----
    print("map x*2:", map(nums, fn(x) { x * 2 }))
    print("filter 偶数:", filter(nums, fn(x) { x % 2 == 0 }))
    print("reduce 求和:", reduce(nums, fn(a, b) { a + b }, 0))
    print("reduce 求积:", reduce([1, 2, 3, 4], fn(a, b) { a * b }, 1))

    # ---- std.string 组合 ----
    let words = split("a,b,c", ",")
    print("split:", words)
    print("join:", join("-", words))
    print("replace:", replace("hello world", "world", "px"))
    print("starts_with:", starts_with("pxlang", "px"))
    print("ends_with:", ends_with("pxlang", "lang"))

    print("STD_DEMO OK")

# main() 由运行时自动调用（def main 约定），无需显式调用
