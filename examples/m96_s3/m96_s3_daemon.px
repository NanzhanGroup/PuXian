# M96-S3 服务 daemon：http_serve(18889) + http_serve_unix(/tmp/m96s3.sock)
#   + ws_serve(18903 echo) —— S3 综合对拍（offload vs 直调）的目标服务
def hh(req):
    let p = req["path"]
    if p == "/post":
        return req["method"] + ":" + req["body"]
    if p == "/data":
        return "M96DATA-0123456789-ABCDEFGHIJKLMNOPQRSTUVWXYZ-abcdefghijklmnopqrstuvwxyz-0123456789-DATA-END"
    if p == "/hi":
        return "hi"
    return {"status": 404, "body": "nf"}

def wh(conn):
    while true:
        var m = ws_recv(conn)
        if m == null:
            break
        ws_send(conn, "echo:" + m)

spawn http_serve(18889, hh)
spawn ws_serve(18903, wh)
spawn http_serve_unix("/tmp/m96s3.sock", hh)
sleep(300000)
exit(0)
