# M204 探针 · 正例①：复合赋值在 **Index / Field / Var** 三种目标上的三轨一致
#   （缺陷 245：C 轨在 Index / Field 上**静默丢弃运算符**）
def p(tag, v):
    print(tag + "=" + str(v))

struct P:
    x: int
    y: int

def main():
    # ---- Index（list）----
    let l = [1, 2, 3]
    l[0] += 10
    p("i01", l)
    l[1] -= 1
    p("i02", l)
    l[2] *= 3
    p("i03", l)
    l[0] //= 2
    p("i04", l)
    l[0] %= 4
    p("i05", l)
    l[1] **= 2
    p("i06", l)
    l[0] &= 6
    p("i07", l)
    l[0] |= 9
    p("i08", l)
    l[0] ^= 3
    p("i09", l)
    l[0] <<= 2
    p("i10", l)
    l[0] >>= 1
    p("i11", l)
    # ---- Index（dict）----
    let d = {"k": 5, "j": 1}
    d["k"] += 1
    p("d01", d)
    d["j"] *= 7
    p("d02", d)
    # ---- Field（struct）----
    let s = P(1, 2)
    s.x += 10
    p("f01", s.x)
    s.y -= 1
    p("f02", s.y)
    s.x *= 3
    p("f03", s.x)
    # ---- Field（dict 取值后的字段？用 dict 的键赋值已覆盖）----
    # ---- Var（原有正确路径，零回归）----
    var g = 5
    g += 3
    p("v01", g)
    g *= 2
    p("v02", g)
    # ---- 显式展开（一直是对的，作为对照）----
    let m = [1, 2]
    m[0] = m[0] + 100
    p("x01", m)
    # ---- 嵌套：列表里套列表 ----
    let n = [[1, 2], [3, 4]]
    n[1][0] += 10
    p("n01", n)
