# ============================================================
# M257 门 · 基线语料：容器（dict/list）读写 —— 供「容器存储失效自检」的注入式正判据使用
# ------------------------------------------------------------
# 本门要证的不是这个程序多正确，而是：**当容器存储失效时，守卫真的会拦住并响亮报告**。
# 由于普贤侧构造不出「容器存储被复用」这种状态，正判据采用**注入式**：
#   把 px_dict_set 的期望类型从 PX_DICT 改成 PX_LIST（唯一性锚点替换）⇒ 每次字典写都应
#   被守卫拒绝并打印 [M257-CTR] ⇒ 输出必然退化（键写不进去）。见 verify.sh 层 [3]。
# ============================================================

let d = {"a": 1, "b": 2}
d["c"] = 3
d.set("d", 4)
let l = [1, 2]
l.append(3)

print("DICT=" + str(len(d)))
print("A=" + str(d["a"]))
print("C=" + str(d["c"]))
print("D=" + str(d.get("d")))
print("LIST=" + str(len(l)))
print("M257-BASE-OK")
