# M99-S2 TLS daemon —— px_serve TLS 连接事件化 IDLE 验证（docs/M99_PLAN.md §S3 TLS）
# tls_server(cert,key) 注册进程级服务端 TLS → px_serve accept 后 px_conn_init 走 mbedtls
# 握手，整连接 TLS。验证：TLS keep-alive 空闲连接同样交 IDLE（PxConn rbuf TLS 缓冲残留
# 入在途判定 px_pxserve_inflight_data → 不悬挂不丢）；事件循环 detect 可读 → 投回续读。
# 用法：m99_s2_tls_daemon [port] [cert] [key]（默认 18199 / /tmp/px_m99_cert.pem / key）
var tls_port = 18199
var m99_cert = "/tmp/px_m99_cert.pem"
var m99_key = "/tmp/px_m99_key.pem"
let av = args()
if len(av) > 1:
    tls_port = int(av[1])
if len(av) > 2:
    m99_cert = av[2]
if len(av) > 3:
    m99_key = av[3]

def fast_handler(req, params):
    return {"status": 200, "body": "TLS-FAST"}

def setup():
    let r = tls_server(m99_cert, m99_key)   # 进程级服务端 TLS（g_srv_tls_ready）
    if r != true:
        print("tls_server failed: " + str(r))
        exit(1)
    route("GET", "/fast", fast_handler)
    let D = "/tmp/px_m99_tls_docroot"
    mkdir(D)
    write_file(D + "/index.txt", "TLS-OK")
    px_serve(tls_port, D, 30000, {"max_conn": 2})   # max_conn=2：20 TLS 并发铁证
    exit(0)

spawn setup()
sleep(300000)
exit(0)
