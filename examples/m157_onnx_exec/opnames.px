# ══════════════════════════════════════════════════════════════════════
# opnames.px —— 打印运行时**算子表**（语言侧唯一入口，门用它核对覆盖）
# 输出两行：ops=<个数> / <逗号分隔的名字>
# ══════════════════════════════════════════════════════════════════════
let o = onnx_op_names()
print("ops=" + str(len(o)) + "\n")
var s = ""
for i in range(len(o)):
    if i > 0:
        s = s + ","
    s = s + o[i]
print(s + "\n")
