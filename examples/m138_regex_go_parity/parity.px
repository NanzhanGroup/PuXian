# m138 · 正则的 Go 保真（PuXian 侧）—— 与 truth/ 的 Go 真值逐字节对拍
#
# 看输出：verify.sh 把本程序的 stdout 与 Go 真值 diff（两轨都跑）。
# 语料与真值同源手写（两边都打印 pattern/text，任何语料漂移都会直接体现为 diff）。
#
# ⚠️ Px 源码里正则的反斜杠必须写 `\\`（词法层先吃掉一层）；Go 侧用裸串 `\b`。

def hex2(v):
    var d = "0123456789abcdef"
    let a = v // 16
    let b = v % 16
    return d[a:a + 1] + d[b:b + 1]

def esc(s):
    # 与 truth/main.go::esc 逐字节同构：可打印 ASCII 原样，其余 \xNN（按 rune）
    var out = ""
    for c in s:
        let o = ord(c)
        if o >= 32 and o != 127:
            out = out + c
        else:
            out = out + "\\x" + hex2(o)
    return out

def emit_f(pat, text):
    var line = "f|" + esc(pat) + "|" + esc(text) + "|"
    if not regex_valid(pat):
        print(line + "0|-|-|-|-")
        return
    line = line + "1|"
    # find（左起首个匹配）
    let m = regex_find(pat, text)
    if m == null:
        line = line + "-|"
    else:
        line = line + esc(m) + "|"
    # find_all（Go FindAllStringIndex 的迭代语义）
    let all = regex_find_all(pat, text)
    line = line + str(len(all)) + ":"
    var k = 0
    while k < len(all):
        if k > 0:
            line = line + ","
        line = line + esc(all[k])
        k = k + 1
    line = line + "|"
    # search（start/end + 9 个捕获组）
    let sm = regex_search(pat, text)
    if sm == null:
        line = line + "-|-"
    else:
        line = line + str(sm["start"]) + "," + str(sm["end"]) + "|"
        let gl = sm["groups"]
        var g = 0
        while g < len(gl):
            if g > 0:
                line = line + ","
            if gl[g] == null:
                line = line + "-"
            else:
                line = line + esc(gl[g])
            g = g + 1
        line = line + "|"
    # 全匹配（regex_match = 整串匹配；Go 侧用 ^(?:…)$ 包装的等价判据）
    if regex_match(pat, text):
        line = line + "1"
    else:
        line = line + "0"
    print(line)

def emit_r(pat, text, repl):
    var line = "r|" + esc(pat) + "|" + esc(text) + "|" + esc(repl) + "|"
    if not regex_valid(pat):
        print(line + "0|-")
        return
    print(line + "1|" + esc(regex_replace(pat, text, repl)))

def emit_s(pat, text):
    var line = "s|" + esc(pat) + "|" + esc(text) + "|"
    if not regex_valid(pat):
        print(line + "0|-")
        return
    let parts = regex_split(pat, text)
    line = line + "1|" + str(len(parts)) + ":"
    var k = 0
    while k < len(parts):
        if k > 0:
            line = line + ","
        line = line + esc(parts[k])
        k = k + 1
    print(line)

var texts = []
texts <- "hello world"
texts <- "foo_bar baz9"
texts <- "api_key=secret"
texts <- "  api_key: abc  "
