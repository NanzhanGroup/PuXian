# M66-S4 std.lunar 锚点测试（双模式）
import std.lunar
var g_pass = 0
var g_fail = 0
def check(name, cond):
    if cond:
        g_pass += 1
    else:
        g_fail += 1
        print("FAIL " + name)
def s2l(y, m, d):
    let r = lr_solar_to_lunar(y, m, d)
    var lp = "0"
    if r["leap"]:
        lp = "1"
    return str(r["year"]) + "-" + str(r["month"]) + "-" + str(r["day"]) + "-" + lp
# 锚点（与寿星天文历/权威数据对拍）—— 覆盖春节/除夕/闰月/月末/边界
check("2024 春节", s2l(2024, 2, 10) == "2024-1-1-0")
check("2024 除夕前", s2l(2024, 2, 9) == "2023-12-30-0")
check("2026 春节", s2l(2026, 2, 17) == "2026-1-1-0")
check("2023 春节", s2l(2023, 1, 22) == "2023-1-1-0")
check("2023 闰二月", s2l(2023, 3, 22) == "2023-2-1-1")
check("2023 闰二月廿", s2l(2023, 4, 10) == "2023-2-20-1")
check("2023 闰月末", s2l(2023, 4, 19) == "2023-2-29-1")
check("2023 三月初一", s2l(2023, 4, 20) == "2023-3-1-0")
check("2025 春节", s2l(2025, 1, 29) == "2025-1-1-0")
check("2025 腊月", s2l(2025, 1, 20) == "2024-12-21-0")
check("2000 春节", s2l(2000, 2, 5) == "2000-1-1-0")
check("2000 腊月三十", s2l(2000, 2, 4) == "1999-12-29-0")
check("2000 后", s2l(2000, 3, 5) == "2000-1-30-0")
check("1900 起点", s2l(1900, 1, 31) == "1900-1-1-0")
check("1900 二月", s2l(1900, 3, 1) == "1900-2-1-0")
check("2100 春节", s2l(2100, 2, 9) == "2100-1-1-0")
check("2100 腊月", s2l(2100, 12, 31) == "2100-12-1-0")
check("1996 春节", s2l(1996, 2, 19) == "1996-1-1-0")
check("1996 八月十五", s2l(1996, 9, 27) == "1996-8-15-0")
check("2033 春节", s2l(2033, 1, 31) == "2033-1-1-0")
# 互转往返（多组）
def roundtrip(y, m, d):
    let a = lr_solar_to_lunar(y, m, d)
    let b = lr_lunar_to_solar(a["year"], a["month"], a["day"], a["leap"])
    return b["year"] == y and b["month"] == m and b["day"] == d
check("往返 2024-02-10", roundtrip(2024, 2, 10))
check("往返 2023-03-22", roundtrip(2023, 3, 22))
check("往返 2026-08-15", roundtrip(2026, 8, 15))
check("往返 1990-06-01", roundtrip(1990, 6, 1))
check("往返 1900-12-31", roundtrip(1900, 12, 31))
# 闰月辅助
check("2023 闰月号=2", lr_leap_month(2023) == 2)
check("2024 无闰月", lr_leap_month(2024) == 0)
check("2025 闰六月", lr_leap_month(2025) == 6)
check("2023 闰月天数29", lr_leap_days(2023) == 29)
check("2025 闰月天数29", lr_leap_days(2025) == 29)
check("2023 年天数384", lr_year_days(2023) == 384)
check("2024 年天数354", lr_year_days(2024) == 354)
# ws-todo lunar:M-D 落点
check("2026 农历八月初八", lr_md_in_year(8, 8, 2026)["day"] == 18 and lr_md_in_year(8, 8, 2026)["month"] == 9)  # noqa
check("2025 农历六月初六", lr_md_in_year(6, 6, 2025)["day"] == 30 and lr_md_in_year(6, 6, 2025)["month"] == 6)  # noqa
check("2026 正月初一", lr_md_in_year(1, 1, 2026)["day"] == 17 and lr_md_in_year(1, 1, 2026)["month"] == 2)  # noqa
check("2027 农历腊月初一(2026年腊月跨年)", lr_md_in_year(12, 1, 2027)["day"] == 8 and lr_md_in_year(12, 1, 2027)["month"] == 1)  # noqa
print("PASS: " + str(g_pass) + " FAIL: " + str(g_fail))
if g_fail > 0:
    print("TEST_RESULT: FAIL")
else:
    print("TEST_RESULT: PASS")
