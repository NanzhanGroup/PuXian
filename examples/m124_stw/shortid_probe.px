# M124 · qg-issue 80 P2 探针：short_id 形态循环 × 并发 GC 压力下是否卡死
#   假设 A：同一协程被 ≥2 worker 并发执行（帧槽竞态）→ s 读数不收敛
#   假设 B：帧槽引用对象被误回收（UAF）→ len(s) 恒为 1/2 → while 永不退出
#   两者都表现为「单次调用卡在函数内部、hx/n 不变、s 长度 1↔2 振荡」→ 本探针用
#   「耗时 > 3s 仍未退出循环」作为卡死判据（生产实测卡了 57 分钟）。
# 用法：./build/shortid_probe <跑秒数> [分配风暴协程数]
def churn(ms: int, ch):
    var acc = ""
    var t0 = now_ms()
    var i = 0
    var alive = true
    while alive:
        acc = acc + "0123456789" + str(i)
        if len(acc) > 256:
            acc = ""
        i = i + 1
        if i % 4096 == 0 and now_ms() - t0 >= ms:
            alive = false
    ch.send(i)

def probe_once(id: int) -> int:
    var t0 = now_ms()
    var hx = str(id)
    var s = ""
    var need = 4 - len(hx)
    if need < 1:
        need = 1
    while len(s) < need:
        s = "0" + s
        if now_ms() - t0 > 3000:
            print("[HANG] id=" + str(id) + " s_len=" + str(len(s)) + " hx=" + hx)
            return 1
    return 0

def probe_batch(n: int) -> int:
    var h = 0
    var i = 0
    while i < n:
        h = h + probe_once(i)
        i = i + 1
    return h

def handler(req):
    var h = probe_batch(5000)
    return "hangs=" + str(h)

var A = args()
var SECS = 60
var N = 8
if len(A) > 1:
    SECS = int(A[1])
if len(A) > 2:
    N = int(A[2])

print("=== shortid_probe: secs=" + str(SECS) + " churn=" + str(N) + " ===")
var ch = chan[int](N + 2)
var k = 0
while k < N:
    spawn churn(SECS * 1000, ch)
    k = k + 1

spawn http_serve_unix("/tmp/m124_probe.sock", handler)
sleep(300)

var t0 = now_ms()
var rounds = 0
var probes = 0
var bad = 0
while now_ms() - t0 < SECS * 1000:
    var r = http_unix("/tmp/m124_probe.sock", "/x", "GET")
    if str(r) == "":
        bad = bad + 1
    rounds = rounds + 1
    probes = probes + 5000
    if rounds % 25 == 0:
        print("  rounds=" + str(rounds) + " probes=" + str(probes) + " it=" + str(now_ms() - t0) + "ms")
print("=== probe done: rounds=" + str(rounds) + " probes=" + str(probes) + " bad=" + str(bad) + " elapsed=" + str(now_ms() - t0) + "ms ===")
