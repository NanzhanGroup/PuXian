# ============================================================
# ws-web —— 用 PuXian 写的新时代 Web 服务器（v0.5.0 模块化 + md 多语言站点）
# ------------------------------------------------------------
# 对齐 Go 版 v0.3.0：多站点 vhost / deny / SPA fallback / 反向代理 /
#   访问日志 / TLS-SNI / HTTP→HTTPS 301
# v0.5.0 新增：
#   - 模块化拆分：cfg.px 配置 / http.px HTTP 层 / md_render.px md 渲染 /
#     template.px 模板+i18n / llm.px LLM 通道 / translate.px 翻译 /
#     md_site.px md 站点构建与预热
#   - md 多语言站点模式：src/*.md + templates + i18n + LLM 翻译
#     → 构建多语言静态 HTML 到 out/（默认语言裸路径 / 其它 /<lang>/）
#   - LLM key 不入 config.json：环境变量，或 --llm-key 加密 key 文件
#   - M53-S4（同步）：config "http3": true|{port,cert,key} 启用 HTTP/3
# 运行（生产，编译模式）：
#   ./build.sh && ./build/ws-web --config /path/config.json
# 端点：
#   GET /healthz    健康检查 → {"ok": true, "uptime": ms}
# 说明：
#   - 所有站点注册 vhost(host, handler)，handler 内完成 deny/SPA/反代/静态全链路
#   - 访问日志在 handler 内 append_file
#   - Mini 子集：多行 list/dict 字面量禁止、函数内不嵌套 def、fn 不捕获外部变量
# ============================================================

import "cfg.px"
import "http.px"
import "md_render.px"
import "template.px"
import "llm.px"
import "translate.px"
import "md_site.px"

version = "0.5.0"
started_at = now_ms()

# ---- 全局配置（apply_config 填充） ----
cfg_sites = {"_": 0}
cfg_sites.remove("_")
http_port = 80
https_port = 443
cert_dir = "/etc/nginx/ssl"
default_root = "/data/www"
access_log_path = ""
spawn_http = 1
log_ready = 0
# M53-S4：HTTP/3（QUIC/UDP）—— config "http3": true|{port,cert,key}；0 = 关闭
h3_port = 0
h3_cert = ""
h3_key = ""
# ---- LLM 全局（llm.px 使用；key 只经环境变量或加密 key 文件，不落 config） ----
llm_cfg = {"_": 0}
llm_cfg.remove("_")
llm_key = ""
llm_enabled = 0
# ---- md 站点状态：host -> {"ready": 0/1, "building": 0/1} ----
md_state = {"_": 0}
md_state.remove("_")

def main():
    av = args()
    cfg_path = ""
    i = 1
    while i < len(av):
        a = av[i]
        if a == "--version":
            print("ws-web " + version)
            return
        if a == "--config":
            if i + 1 < len(av):
                cfg_path = av[i + 1]
                i = i + 1
        elif starts_with(a, "--config="):
            cfg_path = a[9:]
        i = i + 1
    c = load_config(cfg_path)
    apply_config(c)
    # --llm-key <secret>：加密写 key 文件（须在 apply_config 后以读取 key_file 路径）
    j = 1
    while j < len(av):
        if av[j] == "--llm-key" and j + 1 < len(av):
            llm_setup_key_cmd(av[j + 1])
            return
        j += 1
    llm_apply()
    # 注册 vhost（deny/SPA/反代/静态/md 全链路在 handler 内）
    setup_http()
    # 80 → 301
    if spawn_http == 1:
        spawn http_serve(http_port, redirect_http)
    # md 站点预热（后台构建）+ 热更监听
    md_start()
    # 443 主服务
    serve_https()

main()
