# ============================================================
# ws-web/template.px —— 页面模板组装 + i18n 文案 + 导航 + 语言切换 + SEO
# ------------------------------------------------------------
# 页面模板 templates/page.html 由站点自持（含 head/css/导航占位/页脚），
# 本模块负责注入：{{TITLE}} {{DESC}} {{LANG}} {{CANONICAL}} {{HREFLANG}}
#   {{NAV}} {{LANGSWITCH}} {{CONTENT}}（正文 HTML 已由 md_render 产出）
# i18n 文案：i18n/<lang>.json（dict）。nav 配置在 site.nav。
# 站内绝对路径一律 / 开头；默认语言无前缀，其它语言 /<lang>/ 前缀。
# ============================================================

def lang_prefix(lang, deflang):
    if lang == deflang:
        return ""
    return "/" + lang

def lang_href(lang, deflang, url_path):
    return lang_prefix(lang, deflang) + url_path

def i18n_load(site, lang):
    p = site["root"] + "/i18n/" + lang + ".json"
    if exists(p):
        c = json_parse(read_file(p))
        if type(c) == "dict":
            return c
    return {"_": 0}

def ui_get(i18n, key, defv):
    if i18n.has(key):
        return i18n[key]
    return defv

def lang_label(lang):
    if lang == "zh":
        return "中文"
    if lang == "en":
        return "English"
    if lang == "ja":
        return "日本語"
    if lang == "ko":
        return "한국어"
    if lang == "fr":
        return "Français"
    if lang == "de":
        return "Deutsch"
    if lang == "ru":
        return "Русский"
    if lang == "es":
        return "Español"
    return to_upper(lang)

# 语言切换器：跳各语言当前页
def tmpl_switch(langs, deflang, lang, url_path):
    out = "<div class=\"lang-switch\">"
    for l in langs:
        cls = ""
        if l == lang:
            cls = " class=\"active\""
        out += "<a href=\"" + lang_href(l, deflang, url_path) + "\"" + cls + ">" + lang_label(l) + "</a>"
        if l != langs[len(langs) - 1]:
            out += "<span class=\"sep\">|</span>"
    out += "</div>"
    return out

# 主导航：site.nav = [{"href": "/learn.html", "label": "...", "i18n": "nav_learn"}]
def tmpl_nav(site, i18n, lang, deflang, url_path):
    out = "<nav class=\"site-nav\">"
    if site.has("nav") and type(site["nav"]) == "list":
        items = site["nav"]
        for it in items:
            href = it["href"]
            label = ""
            if it.has("i18n") and i18n.has(it["i18n"]):
                label = i18n[it["i18n"]]
            elif it.has("label"):
                label = it["label"]
            cls = ""
            if url_path == href or (href != "/" and starts_with(url_path, href)):
                cls = " class=\"active\""
            out += "<a href=\"" + lang_href(lang, deflang, href) + "\"" + cls + ">" + label + "</a>"
    out += "</nav>"
    return out

# SEO：canonical + hreflang（绝对 URL 基于 public_url）
def tmpl_seo(pu, deflang, langs, url_path):
    out = ""
    if pu != "":
        out += "<link rel=\"canonical\" href=\"" + pu + url_path + "\">\n"
        for l in langs:
            out += "<link rel=\"alternate\" hreflang=\"" + l + "\" href=\"" + pu + lang_href(l, deflang, url_path) + "\">\n"
    return out

def tmpl_apply(tpl, site, i18n, lang, deflang, langs, url_path, pu, meta, content):
    title = meta["title"]
    if title == "":
        title = ui_get(i18n, "site_name", "Site")
    desc = meta["description"]
    if desc == "":
        desc = ui_get(i18n, "site_desc", "")
    t = tpl
    t = replace(t, "{{TITLE}}", esc_attr(title))
    t = replace(t, "{{DESC}}", esc_attr(desc))
    t = replace(t, "{{LANG}}", lang)
    nav = tmpl_nav(site, i18n, lang, deflang, url_path)
    t = replace(t, "{{NAV}}", nav)
    sw = tmpl_switch(langs, deflang, lang, url_path)
    t = replace(t, "{{LANGSWITCH}}", sw)
    seo = tmpl_seo(pu, deflang, langs, url_path)
    t = replace(t, "{{HREFLANG}}", seo)
    t = replace(t, "{{CONTENT}}", content)
    return t

def esc_attr(s):
    s = replace(s, "&", "&amp;")
    s = replace(s, "\"", "&quot;")
    s = replace(s, "<", "&lt;")
    return s

# 从正文第一个标题推断 title（front-matter 缺 title 时兜底）
def title_from_md(md):
    lines = split(md, "\n")
    for line in lines:
        t = trim(line)
        if starts_with(t, "# ") and not starts_with(t, "## ") and not starts_with(t, "### "):
            return t[2:]
    return ""
