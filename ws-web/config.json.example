{
  "http_addr": ":80",
  "https_addr": ":443",
  "cert_dir": "/etc/nginx/ssl",
  "default_root": "/data/www",
  "access_log": "/var/log/ws-web/access.log",
  "spawn_http": 1,
  "http3": true,
  "llm": {
    "provider": "mock",
    "base_url": "",
    "model": "",
    "api_key_env": "WS_WEB_LLM_KEY",
    "key_file": "/etc/ws-web/llm.key.enc"
  },
  "sites": {
    "static.example.com": {
      "root": "/data/www/static_site",
      "spa_fallback": true,
      "proxy_routes": [
        { "prefix": "/api/", "target": "http://127.0.0.1:8901" }
      ]
    },
    "docs.example.com": {
      "type": "md",
      "root": "/data/www/docs_site",
      "default_lang": "zh",
      "langs": ["zh", "en", "ja"],
      "public_url": "https://docs.example.com",
      "nav": [
        { "href": "/index.html", "i18n": "nav_home" },
        { "href": "/learn.html", "i18n": "nav_learn" }
      ]
    }
  }
}
