# ============================================================
# ws-web/llm.px —— LLM 通道（OpenAI 兼容）+ key 安全获取 + ws 生态网关
# ------------------------------------------------------------
# key 不落 config.json（安全约定）：
#   1) 环境变量：config.llm.api_key_env 指定，如 WS_WEB_LLM_KEY（推荐）
#   2) 加密 key 文件：--llm-key <secret> 写入 llm_cfg.key_file（0600，
#      AES-256-GCM 加密存储；主钥在程序内，防静态泄漏/日志误贴，
#      高安全场景建议环境变量/system secret 注入）
#   3) ws 生态网关自动发现（config.llm.ws_token_cache = true）：
#      从 $WS_PATH/.env（默认 /data/app/ws/.env）读取 WS_TOKEN_CACHE_TOKEN
#      与 WS_SOCK_DIR，经 token-cache 词元缓存网关调用大模型 —— key 不落盘、
#      不直连供应商，翻译走统一缓存与计费。socket 可用 config.llm.unix_socket 覆盖。
# 传输：
#   - config.llm.unix_socket 配置（或 ws_token_cache 自动发现）→ 走 Unix
#     domain socket（http_unix 内建，M56 runtime），否则走 TCP/TLS http_request。
# provider = "mock"（缺省）：不调真实 LLM，翻译走本地模拟（离线联调）
# 全局（main.px 声明）：llm_cfg / llm_key / llm_sock / llm_enabled
# ============================================================

def llm_provider():
    if llm_cfg.has("provider"):
        return llm_cfg["provider"]
    return "mock"

def llm_model():
    if llm_cfg.has("model"):
        return llm_cfg["model"]
    return ""

def llm_base_url():
    if llm_cfg.has("base_url"):
        return llm_cfg["base_url"]
    return ""

# ---- key 加密存取（AES-256-GCM；主钥=代码派生常量，用途：防静态明文/日志泄漏） ----

def llm_enc_key():
    return sha256("ws-web-llm-keyfile-v1")

def llm_enc_iv():
    return sha256("ws-web-llm-iv-v1")[0:32]

def llm_enc(secret):
    return aes_gcm_encrypt(secret, llm_enc_key(), llm_enc_iv())

def llm_dec(enc):
    return aes_gcm_decrypt(enc, llm_enc_key(), llm_enc_iv())

# ---- ws 生态自动发现（token-cache 词元缓存网关） ----

def llm_ws_setup():
    # 目标 ws 根：优先 config.llm.ws_path → 环境 WS_PATH → 默认 /data/app/ws
    ws_path = "/data/app/ws"
    if llm_cfg.has("ws_path") and llm_cfg["ws_path"] != "":
        ws_path = llm_cfg["ws_path"]
    else:
        p = env("WS_PATH")
        if p != null and p != "":
            ws_path = p
    envfile = ws_path + "/.env"
    if not exists(envfile):
        print("ws-web: llm ws_token_cache 启用但找不到 " + envfile)
        return 0
    tok = ""
    sockdir = ""
    content = read_file(envfile)
    lines = split(content, "\n")
    for line in lines:
        ln = trim(line)
        if starts_with(ln, "WS_TOKEN_CACHE_TOKEN="):
            kv = split(ln, "=")
            if len(kv) >= 2:
                tok = trim(kv[1])
        elif starts_with(ln, "WS_SOCK_DIR="):
            kv = split(ln, "=")
            if len(kv) >= 2:
                sockdir = trim(kv[1])
    if tok == "":
        print("ws-web: llm ws_token_cache .env 缺 WS_TOKEN_CACHE_TOKEN")
        return 0
    llm_key = tok
    if llm_cfg.has("unix_socket") and llm_cfg["unix_socket"] != "":
        llm_sock = llm_cfg["unix_socket"]
    elif sockdir != "":
        sd = sockdir
        if sd[len(sd) - 1] != "/":
            sd = sd + "/"
        llm_sock = sd + "ws-token-cache.sock"
    else:
        print("ws-web: llm ws_token_cache 缺 WS_SOCK_DIR/unix_socket")
        return 0
    return 1

def llm_apply():
    llm_key = ""
    llm_sock = ""
    llm_enabled = 0
    prov = llm_provider()
    if prov == "mock":
        llm_enabled = 1
        return
    # ws 生态网关优先（key 统一由 token-cache 管理，零落盘）
    if llm_cfg.has("ws_token_cache") and llm_cfg["ws_token_cache"] == true:
        if llm_ws_setup() == 1:
            print("ws-web: llm 走 ws 词元缓存网关 (socket=" + llm_sock + ", model=" + llm_model() + ")")
            llm_enabled = 1
            return
        print("ws-web: llm ws_token_cache 发现失败，回退标准通道")
    if llm_cfg.has("api_key_env"):
        k = env(llm_cfg["api_key_env"])
        if k != null:
            llm_key = k
    if llm_key == "" and llm_cfg.has("key_file"):
        kf = llm_cfg["key_file"]
        if exists(kf):
            raw = trim(read_file(kf))
            if starts_with(raw, "enc:"):
                llm_key = llm_dec(raw[4:])
            else:
                llm_key = raw
    # 标准通道：key + base_url 或 unix_socket 至少一项
    has_url = llm_base_url() != ""
    has_sock = llm_cfg.has("unix_socket") and llm_cfg["unix_socket"] != ""
    if llm_key == "":
        print("ws-web: llm 未配置完整（缺 api_key_env/key_file/ws_token_cache），翻译降级源语言")
        llm_enabled = 0
        return
    if not has_url and not has_sock:
        print("ws-web: llm 未配置完整（缺 base_url 或 unix_socket），翻译降级源语言")
        llm_enabled = 0
        return
    if has_sock:
        llm_sock = llm_cfg["unix_socket"]
    llm_enabled = 1

def llm_ready():
    return llm_enabled

def llm_write_key_file(path, secret):
    enc = "enc:" + llm_enc(secret)
    write_file(path, enc)

def llm_setup_key_cmd(secret):
    kf = "/etc/ws-web/llm.key.enc"
    if llm_cfg.has("key_file"):
        kf = llm_cfg["key_file"]
    llm_write_key_file(kf, secret)
    print("ws-web: llm key 已写入 " + kf + " (加密存储)")

def llm_trim_slash(s):
    if s == "":
        return s
    if s[len(s) - 1] == "/":
        return s[0:len(s) - 1]
    return s

# ---- chat（OpenAI 兼容 chat/completions；unix socket 或 TCP/TLS）----

def llm_chat(system_prompt, user_prompt):
    prov = llm_provider()
    if prov == "mock":
        # mock：不调真实 LLM（离线联调标记）
        return {"ok": 1, "text": user_prompt, "mock": 1}
    if llm_enabled == 0 or llm_key == "":
        return {"ok": 0, "err": "llm not ready"}
    model = llm_model()
    if model == "":
        return {"ok": 0, "err": "llm model missing"}
    body = {"model": model, "messages": [{"role": "system", "content": system_prompt}, {"role": "user", "content": user_prompt}], "temperature": 0.2}
    hdrs = {"_": 0}
    hdrs.remove("_")
    hdrs["Content-Type"] = "application/json"
    hdrs["Authorization"] = "Bearer " + llm_key
    resp = null
    if llm_sock != "":
        resp = http_unix(llm_sock, "/v1/chat/completions", "POST", json_stringify(body), hdrs)
    else:
        url = llm_trim_slash(llm_base_url()) + "/chat/completions"
        resp = http_request(url, "POST", json_stringify(body), hdrs)
    if resp.has("status") and resp["status"] == 200:
        j = json_parse(resp["body"])
        text = j["choices"][0]["message"]["content"]
        return {"ok": 1, "text": text}
    err = resp["body"]
    if len(err) > 300:
        err = err[0:300]
    return {"ok": 0, "err": "llm http " + str(resp["status"]) + ": " + err}
