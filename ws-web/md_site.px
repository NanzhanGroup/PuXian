# ============================================================
# ws-web/md_site.px —— md 多语言站点：扫描/构建/预热/热更
# ------------------------------------------------------------
# 站点目录约定（root 为 site.root）：
#   src/*.md（front-matter: title/description/order/lang/prompt）+ 子目录
#   templates/page.html（{{TITLE}}{{DESC}}{{LANG}}{{NAV}}{{LANGSWITCH}}
#                        {{HREFLANG}}{{CONTENT}}）
#   i18n/<lang>.json（界面文案）
#   public/**（静态资源，直读不复制）
#   cache/（翻译缓存，deny 对外）
#   out/（构建产物：默认语言裸路径 + /<lang>/ 前缀；HTTP 层服务）
# 构建：源 md →（翻译缓存/LLM）→ md_render → tmpl_apply → 写 out
# 预热：启动 spawn 后台构建；watch 每 60s 源树 hash 变化自动重建
# ============================================================

# ---------- 基础 ----------

def md_ensure_state(host):
    if not md_state.has(host):
        md_state[host] = {"ready": 0, "building": 0}

def md_src_root(site):
    return site["root"] + "/src"

def md_url_of(rel):
    if rel == "index.md":
        return "/index.html"
    return "/" + rel[0:len(rel) - 3] + ".html"

def md_out_rel(rel):
    # 产物相对 out 根：index.md → index.html；learn/01.md → learn/01.html
    if rel == "index.md":
        return "index.html"
    return rel[0:len(rel) - 3] + ".html"

def md_mkdir_p(path):
    if exists(path):
        return
    parts = split(path, "/")
    cur = ""
    for part in parts:
        if part == "":
            if cur == "":
                cur = "/"
            continue
        if cur == "/":
            cur = cur + part
        elif cur == "":
            cur = part
        else:
            cur = cur + "/" + part
        if not exists(cur):
            mkdir(cur)

def md_write_out(site, sub, content):
    out = site["root"] + "/out"
    md_mkdir_p(out)
    full = out + sub
    i = len(full) - 1
    while i >= 0 and full[i] != "/":
        i -= 1
    if i > len(out):
        md_mkdir_p(full[0:i])
    write_file(full, content)

# ---------- 扫描（src 布局纪律：仅 .md 文件与子目录） ----------

def md_scan_dir(abs_dir, rel_dir, out):
    items = list_dir(abs_dir)
    for name in items:
        if starts_with(name, "."):
            continue
        if ends_with(name, ".md"):
            rel = name
            if rel_dir != "":
                rel = rel_dir + "/" + name
            out.append(rel)
        else:
            sub = abs_dir + "/" + name
            if exists(sub):
                rel2 = name
                if rel_dir != "":
                    rel2 = rel_dir + "/" + name
                md_scan_dir(sub, rel2, out)

def md_scan(src_root):
    out = []
    if exists(src_root):
        md_scan_dir(src_root, "", out)
    return out

# ---------- 页面排序（index 优先，其次 order，再文件名） ----------

def md_order_num(meta):
    if meta.has("order"):
        o = meta["order"]
        if o != "":
            return int(o)
    return 999

def md_sort_pages(rels, metas):
    # 冒泡：index 最前；其余 order 升序
    n = len(rels)
    i = 0
    while i < n - 1:
        j = 0
        while j < n - 1 - i:
            a = rels[j]
            b = rels[j + 1]
            if md_page_less(b, a, metas):
                rels[j] = b
                rels[j + 1] = a
                metas[b] = metas[a]
                metas[a] = metas[b]
            j += 1
        i += 1

def md_page_less(a, b, metas):
    # a 是否应排在 b 前
    if a == "index.md":
        return true
    if b == "index.md":
        return false
    ma = 999
    mb = 999
    if metas.has(a) and metas[a].has("order"):
        if metas[a]["order"] != "":
            ma = int(metas[a]["order"])
    if metas.has(b) and metas[b].has("order"):
        if metas[b]["order"] != "":
            mb = int(metas[b]["order"])
    if ma != mb:
        return ma < mb
    return a < b

# ---------- 站点树 hash（热更检测） ----------

def md_tree_hash(src_root):
    rels = md_scan(src_root)
    h = ""
    for rel in rels:
        h = h + rel + ":" + sha256(read_file(src_root + "/" + rel)) + "\n"
    if h == "":
        return "empty"
    return sha256(h)

# ---------- 单站点构建 ----------

def md_build_host(host, site):
    md_ensure_state(host)
    if md_state[host]["building"] == 1:
        return {"ok": 0, "warn": "busy"}
    md_state[host]["building"] = 1
    root = site["root"]
    src_root = md_src_root(site)
    tpl_path = root + "/templates/page.html"
    if not exists(src_root) or not exists(tpl_path):
        print("ws-web: md 站点 " + host + " 缺少 src/ 或 templates/page.html，跳过")
        md_state[host]["building"] = 0
        return {"ok": 0, "warn": "missing src or template"}
    tpl = read_file(tpl_path)
    deflang = md_default_lang(site)
    langs = md_langs(site)
    pu = md_public_url(site)
    # 预加载 i18n
    i18ns = {"_": 0}
    i18ns.remove("_")
    for l in langs:
        i18ns[l] = i18n_load(site, l)
    # 扫描 + 排序
    rels = md_scan(src_root)
    metas = {"_": 0}
    metas.remove("_")
    for rel in rels:
        fm = md_split_front(read_file(src_root + "/" + rel))
        metas[rel] = fm["meta"]
    md_sort_pages(rels, metas)
    # 逐页逐语言构建
    built = 0
    warned = 0
    for rel in rels:
        src_text = read_file(src_root + "/" + rel)
        url_path = md_url_of(rel)
        for l in langs:
            prefix = lang_prefix(l, deflang)
            tr = tr_translate_doc(site, deflang, l, src_text)
            text = tr["text"]
            if tr["ok"] != 1:
                text = src_text
                warned = warned + 1
                print("ws-web: 翻译失败 " + host + " " + rel + " -> " + l + ": " + tr["err"] + "，降级源语言")
            fm = md_split_front(text)
            meta = fm["meta"]
            if meta["title"] == "":
                meta["title"] = title_from_md(fm["body"])
            content = md_render(fm["body"], prefix)
            page_html = tmpl_apply(tpl, site, i18ns[l], l, deflang, langs, url_path, pu, meta, content)
            out_rel = md_out_rel(rel)
            if l == deflang:
                md_write_out(site, "/" + out_rel, page_html)
            else:
                md_write_out(site, "/" + l + "/" + out_rel, page_html)
            built = built + 1
    # sitemap / robots
    md_write_sitemap(site, deflang, langs, pu, rels)
    md_write_robots(site, pu)
    md_state[host]["building"] = 0
    md_state[host]["ready"] = 1
    warn_str = ""
    if warned > 0:
        warn_str = "（" + str(warned) + " 警告）"
    print("ws-web: md 站点 " + host + " 构建完成: " + str(built) + " 页产物" + warn_str)
    return {"ok": 1, "warn": warned}

def md_write_sitemap(site, deflang, langs, pu, rels):
    if pu == "":
        return
    lines = ["<?xml version=\"1.0\" encoding=\"UTF-8\"?>", "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">"]
    for rel in rels:
        url_path = md_url_of(rel)
        for l in langs:
            u = pu + lang_href(l, deflang, url_path)
            lines.append("<url><loc>" + u + "</loc></url>")
    lines.append("</urlset>")
    md_write_out(site, "/sitemap.xml", join("\n", lines))

def md_write_robots(site, pu):
    body = "User-agent: *\nAllow: /\n"
    if pu != "":
        body = body + "Sitemap: " + pu + "/sitemap.xml\n"
    md_write_out(site, "/robots.txt", body)

# ---------- 预热 / 热更（后台线程） ----------

def md_sites_list():
    out = []
    hosts = cfg_sites.keys()
    for h in hosts:
        site = cfg_sites[h]
        if site_is_md(site):
            out.append([h, site])
    return out

def md_worker():
    sites = md_sites_list()
    for pair in sites:
        h = pair[0]
        s = pair[1]
        md_ensure_state(h)
        # 注入默认 deny（防泄漏 src/cache/templates/i18n）
        if not s.has("deny_dirs"):
            s["deny_dirs"] = ["src", "cache", "templates", "i18n"]
        elif not contains(join(",", s["deny_dirs"]), "cache"):
            s["deny_dirs"].append("cache")
        md_build_host(h, s)

def md_watch_worker():
    lasts = {"_": 0}
    lasts.remove("_")
    while true:
        sleep(60000)
        sites = md_sites_list()
        for pair in sites:
            h = pair[0]
            s = pair[1]
            if not md_state.has(h) or md_state[h]["ready"] != 1:
                continue
            hh = md_tree_hash(md_src_root(s))
            if lasts.has(h) and lasts[h] != hh:
                print("ws-web: md 站点 " + h + " 源变化，自动重建")
                md_build_host(h, s)
            lasts[h] = hh

def md_start():
    spawn md_worker()
    spawn md_watch_worker()
