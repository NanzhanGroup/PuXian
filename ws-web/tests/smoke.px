# ============================================================
# ws-web 冒烟测试（M-B9b.1 纯静态服务器核心）
# 运行（编译模式）：
#   ./tools/pxc build ws-web/tests/smoke.px && ./ws-web/tests/build/smoke
# 覆盖：静态文件 / deny 403 / SPA fallback / 反代 / 404 / healthz
# ============================================================

# 测试目录
TMP = "/tmp/wsweb_smoke"
SITE_A = TMP + "/site_a"
SITE_B = TMP + "/site_b"

def setup():
    os_spawn("/bin/sh", ["-c", "rm -rf " + TMP])
    sleep(200)
    mkdir(SITE_A)
    mkdir(SITE_B)
    write_file(SITE_A + "/index.html", "SMOKE-A-INDEX")
    write_file(SITE_B + "/index.txt", "SMOKE-B-TXT")
    write_file(SITE_B + "/secret.db", "SECRET")
    write_file(SITE_B + "/public.txt", "PUBLIC")

# 起 ws-web（编译模式二进制，测试端口 18990/18991）
def start_server():
    cfg = TMP + "/config.json"
    write_file(cfg, '{"http_addr": ":18990", "https_addr": ":18991", "cert_dir": "' + TMP + '/certs", "default_root": "' + SITE_A + '", "spawn_http": 0, "sites": {"a.test": {"root": "' + SITE_A + '", "spa_fallback": true}, "b.test": {"root": "' + SITE_B + '", "deny_dirs": ["backup", ".git"], "deny_exts": [".db", ".key", ".env"]}}}')
    p = os_spawn("/bin/sh", ["-c", "exec " + TMP + "/ws-web --config " + cfg + " 2>" + TMP + "/server.log"])
    sleep(800)
    return p

def main():
    setup()
    # 复制 ws-web 二进制到测试目录（build.sh 产物；开发路径，可改）
    os_spawn("/bin/sh", ["-c", "cp /data/code/PuXian/ws-web/build/ws-web " + TMP + "/ws-web"])
    sleep(300)
    p = start_server()

    # 1. healthz
    r = http_request("http://127.0.0.1:18991/healthz", "GET", "", {"Host": "a.test"})
    assert r["status"] == 200
    d = json_parse(r["body"])
    assert d["ok"] == true
    print("1 healthz: OK")

    # 2. 静态文件
    r = http_request("http://127.0.0.1:18991/", "GET", "", {"Host": "a.test"})
    assert r["status"] == 200 and r["body"] == "SMOKE-A-INDEX"
    print("2 静态 a.test: OK")
    r = http_request("http://127.0.0.1:18991/index.txt", "GET", "", {"Host": "b.test"})
    assert r["status"] == 200 and r["body"] == "SMOKE-B-TXT"
    print("3 静态 b.test: OK")

    # 3. deny 403
    r = http_request("http://127.0.0.1:18991/secret.db", "GET", "", {"Host": "b.test"})
    assert r["status"] == 403
    print("4 deny .db: OK")
    r = http_request("http://127.0.0.1:18991/.git/config", "GET", "", {"Host": "b.test"})
    assert r["status"] == 403
    print("5 deny .git: OK")

    # 4. SPA fallback
    r = http_request("http://127.0.0.1:18991/foo", "GET", "", {"Host": "a.test"})
    assert r["status"] == 200 and r["body"] == "SMOKE-A-INDEX"
    print("6 SPA fallback: OK")

    # 5. 404
    r = http_request("http://127.0.0.1:18991/nope.txt", "GET", "", {"Host": "b.test"})
    assert r["status"] == 404
    print("7 404: OK")

    # 6. 未知 host 404
    r = http_request("http://127.0.0.1:18991/", "GET", "", {"Host": "unknown.test"})
    assert r["status"] == 404
    print("8 未知host 404: OK")

    os_kill(p, 15)
    sleep(300)
    os_wait(p)
    print("SMOKE ALL PASSED")

main()
