# BUG 复现：vhost handler dict headers 仅透传 Content-Type（Cache-Control/Location 等丢失）
# 期望：301 响应带 Location/Cache-Control 头；实际：全部丢失（runtime px_vhost_normalize 只取 Content-Type）
PORT = 18139
D = "/tmp/px_bug_hdr_doc"
mkdir(D)
write_file(D + "/index.txt", "docroot")

def hh(req):
    return {"status": 301, "headers": {"Location": "https://new.example/go", "Cache-Control": "no-store"}, "body": ""}
vhost("h.test", hh)

def serve():
    px_serve(PORT, D, 10000)
spawn serve()
sleep(300)

r = http_request("http://127.0.0.1:" + str(PORT) + "/go", "GET", "", {"Host": "h.test"})
print("status:", str(r["status"]))
hdrs = r["headers"]
loc = "false"
if hdrs.has("Location"):
    loc = "true"
cc = "false"
if hdrs.has("Cache-Control"):
    cc = "true"
print("has Location:", loc)
print("has Cache-Control:", cc)
print("REPRO_DONE")
