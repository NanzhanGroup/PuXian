# ============================================================
# ws-web/translate.px —— md 翻译编排：缓存 / 代码围栏保护 / 三层提示词 / mock
# ------------------------------------------------------------
# 设计要点：
#   - 翻译发生在 md 层（纯文本），不翻 HTML；代码围栏天然隔离、diff 可审
#   - 缓存：cache/tr_<sha256(src+provider+model)>_<lang>.md 磁盘持久；
#     源文件一改 hash 变化自动只重翻那一页（增量）
#   - 提示词三层：内置硬规则（领域无关）+ 站点级 prompt/prompt_file
#     + 页级 front-matter prompt（llm 通道由 llm.px 提供）
#   - 代码围栏保护（MVP）：译文 fences 数量与语言标记必须与原文一致，
#     不一致重试 1 次，仍失败返回 err（调用方降级源语言）——宁可不翻不可翻错
#   - provider=mock：本地模拟（front-matter title 加语言标注），离线联调
# 全局（main.px 声明）：llm_cfg / llm_key / llm_enabled
# ============================================================

# ---------- 语言名（提示词用） ----------

def tr_lang_name(lang):
    if lang == "zh":
        return "Chinese"
    if lang == "en":
        return "English"
    if lang == "ja":
        return "Japanese"
    if lang == "ko":
        return "Korean"
    if lang == "fr":
        return "French"
    if lang == "de":
        return "German"
    if lang == "ru":
        return "Russian"
    if lang == "es":
        return "Spanish"
    return lang

# ---------- 提示词三层 ----------

def tr_hard_rules():
    r = "You are a professional document translator.\n"
    r = r + "Hard rules (must follow):\n"
    r = r + "1. Translate only natural-language text. Preserve code, commands, output, URLs, file names, inline code spans and link destinations verbatim.\n"
    r = r + "2. Inside fenced code blocks you MAY translate comment lines only (lines starting with # or // etc.); NEVER alter code lines, indentation, blank lines or the ``` fence markers.\n"
    r = r + "3. Preserve the complete Markdown structure exactly: headings level, list markers, table rows/separators, code fences count and language tags. Do not add or remove any line.\n"
    r = r + "4. If the document starts with YAML front-matter (--- block), translate only the values of title/description; keep all keys and the --- lines unchanged.\n"
    r = r + "5. Output ONLY the translated document. No explanations, no preamble, no trailing notes.\n"
    return r

def tr_site_prompt(site):
    p = ""
    if site.has("prompt"):
        p = p + site["prompt"] + "\n"
    if site.has("prompt_file"):
        pf = site["prompt_file"]
        if not starts_with(pf, "/"):
            pf = site["root"] + "/" + pf
        if exists(pf):
            p = p + read_file(pf) + "\n"
    return p

def tr_page_prompt(meta):
    if meta.has("prompt"):
        return meta["prompt"] + "\n"
    return ""

def tr_build_prompt(site, meta, srclang, dstlang):
    sp = tr_hard_rules()
    sp = sp + "\nSite-specific guidance:\n" + tr_site_prompt(site)
    if tr_site_prompt(site) == "":
        sp = sp + "(none)\n"
    pg = tr_page_prompt(meta)
    if pg != "":
        sp = sp + "\nPage-specific guidance:\n" + pg
    return sp

def tr_dir_text(src, dst):
    return "Translate the document below from " + tr_lang_name(src) + " to " + tr_lang_name(dst) + ".\n\n"

# ---------- 缓存 ----------

def tr_cache_dir(site):
    return site["root"] + "/cache"

def tr_cache_key(src_text):
    prov = ""
    if llm_cfg.has("provider"):
        prov = llm_cfg["provider"]
    model = ""
    if llm_cfg.has("model"):
        model = llm_cfg["model"]
    return sha256(src_text + "\n#prov=" + prov + " model=" + model)

def tr_cache_path(site, src_text, lang):
    return tr_cache_dir(site) + "/tr_" + tr_cache_key(src_text) + "_" + lang + ".md"

def tr_cache_get(site, src_text, lang):
    p = tr_cache_path(site, src_text, lang)
    if exists(p):
        return read_file(p)
    return ""

def tr_cache_put(site, src_text, lang, text):
    mkdir(tr_cache_dir(site))
    write_file(tr_cache_path(site, src_text, lang), text)

# ---------- 代码围栏提取与校验（MVP：数量 + 语言标记一致） ----------

def tr_fence_info(md):
    # 返回 fences 的 lang 标记列表（只统计 ``` 开行）
    lines = split(md, "\n")
    infos = []
    in_fence = 0
    for line in lines:
        t = trim(line)
        if starts_with(t, "```"):
            if in_fence == 0:
                infos.append(trim(t[3:]))
                in_fence = 1
            else:
                in_fence = 0
    return infos

def tr_fences_ok(src, dst):
    a = tr_fence_info(src)
    b = tr_fence_info(dst)
    if len(a) != len(b):
        return false
    i = 0
    while i < len(a):
        if a[i] != b[i]:
            return false
        i += 1
    return true

# ---------- mock 翻译（provider=mock 离线联调） ----------

def tr_mock_title(src_text, lang):
    # front matter title 值加语言标注，正文不变 → 可见"翻译"生效且结构零风险
    fm = md_split_front(src_text)
    meta = fm["meta"]
    title = meta["title"]
    if title == "":
        title = "Untitled"
    title = title + " [" + lang + "·mock]"
    body = fm["body"]
    out = "---\ntitle: \"" + title + "\""
    if meta.has("description") and meta["description"] != "":
        out = out + "\ndescription: \"" + meta["description"] + "\""
    if meta.has("order") and meta["order"] != "" and meta["order"] != "0":
        out = out + "\norder: " + meta["order"]
    out = out + "\n---\n\n" + body
    return out

# ---------- 整篇翻译（真实 LLM） ----------

def tr_translate_block(site, meta, srclang, dstlang, block):
    sysp = tr_build_prompt(site, meta, srclang, dstlang)
    userp = tr_dir_text(srclang, dstlang) + block
    r = llm_chat(sysp, userp)
    if r["ok"] != 1:
        return r
    text = r["text"]
    if trim(text) == "":
        return {"ok": 0, "err": "empty llm response"}
    # 去除模型可能附加的围栏包装（以 ``` 开头/结尾且非文档 fence 时）
    return {"ok": 1, "text": text}

# 大文档按 "## " 标题切块（切点不破坏列表/表格/围栏）
def tr_split_doc(text):
    if len(text) <= 6000:
        return [text]
    chunks = []
    buf = ""
    lines = split(text, "\n")
    for line in lines:
        if starts_with(line, "## ") and buf != "":
            chunks.append(buf)
            buf = ""
        buf = buf + line + "\n"
    if trim(buf) != "":
        chunks.append(buf)
    return chunks

def tr_translate_doc(site, srclang, dstlang, src_text):
    if dstlang == srclang:
        return {"ok": 1, "text": src_text}
    # 1. mock 本地模拟
    if llm_provider() == "mock":
        out = tr_mock_title(src_text, dstlang)
        tr_cache_put(site, src_text, dstlang, out)
        return {"ok": 1, "text": out}
    # 2. 缓存命中
    cached = tr_cache_get(site, src_text, dstlang)
    if cached != "":
        return {"ok": 1, "text": cached}
    if not llm_ready():
        return {"ok": 0, "err": "llm disabled", "fallback": 1}
    # 3. 页级 meta（用于 front-matter prompt）
    pmeta = md_split_front(src_text)["meta"]
    # 4. 切块翻译
    chunks = tr_split_doc(src_text)
    translated = ""
    i = 0
    fail = 0
    while i < len(chunks):
        r = tr_translate_block(site, pmeta, srclang, dstlang, chunks[i])
        if r["ok"] != 1:
            fail = 1
            break
        translated = translated + r["text"]
        i += 1
    if fail == 1:
        return {"ok": 0, "err": "translate failed"}
    # 5. 代码围栏结构保护：不一致重试 1 次，仍失败 → err（调用方降级源语言）
    if not tr_fences_ok(src_text, translated):
        r2 = tr_translate_block(site, pmeta, srclang, dstlang, src_text)
        if r2["ok"] == 1 and tr_fences_ok(src_text, r2["text"]):
            translated = r2["text"]
        else:
            return {"ok": 0, "err": "code fence mismatch after retry", "fallback": 1}
    tr_cache_put(site, src_text, dstlang, translated)
    return {"ok": 1, "text": translated}
