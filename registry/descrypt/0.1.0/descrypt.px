# descrypt.px — DES/3DES/RC4 加密（纯函数，简化实现）
# 版本: 0.1.0
# 注意：这是简化版 DES，用于教学/兼容，不应用于安全场景
# 完整 DES 需要大量常量表，此处提供 RC4（完整可用）和 DES 接口框架

# === RC4 (完整实现) ===
def rc4_init(key):
    var s = []
    var i = 0
    while i < 256:
        s.append(i)
        i += 1
    var j = 0
    i = 0
    while i < 256:
        j = (j + s[i] + key[i % len(key)]) & 0xFF
        var tmp = s[i]
        s[i] = s[j]
        s[j] = tmp
        i += 1
    return s
def rc4_crypt(key, data):
    var s = rc4_init(key)
    var result = []
    var i = 0
    var j = 0
    var n = 0
    while n < len(data):
        i = (i + 1) & 0xFF
        j = (j + s[i]) & 0xFF
        var tmp = s[i]
        s[i] = s[j]
        s[j] = tmp
        var k = s[(s[i] + s[j]) & 0xFF]
        result.append(data[n] ^ k)
        n += 1
    return result
def rc4_encrypt_hex(key_hex, plaintext_hex):
    var key = _ds_hex_to_bytes(key_hex)
    var data = _ds_hex_to_bytes(plaintext_hex)
    var enc = rc4_crypt(key, data)
    return _ds_bytes_to_hex(enc)
def _ds_hex_to_bytes(hex_str):
    var result = []
    var i = 0
    while i < hex_str.len():
        var h = hex_str[i]
        var l = hex_str[i + 1]
        result.append(_ds_hex_digit(h) * 16 + _ds_hex_digit(l))
        i += 2
    return result
def _ds_hex_digit(c):
    if c >= "0" and c <= "9":
        return ord(c) - ord("0")
    if c >= "a" and c <= "f":
        return ord(c) - ord("a") + 10
    if c >= "A" and c <= "F":
        return ord(c) - ord("A") + 10
    return 0
def _ds_bytes_to_hex(data):
    var hex_chars = "0123456789abcdef"
    var s = ""
    var i = 0
    while i < len(data):
        s = s + hex_chars[data[i] >> 4] + hex_chars[data[i] & 0xF]
        i += 1
    return s

# === DES IP/FP 置换表 ===
var DES_IP = [
    58,50,42,34,26,18,10,2,60,52,44,36,28,20,12,4,
    62,54,46,38,30,22,14,6,64,56,48,40,32,24,16,8,
    57,49,41,33,25,17,9,1,59,51,43,35,27,19,11,3,
    61,53,45,37,29,21,13,5,63,55,47,39,31,23,15,7
]
def des_permute(data, table):
    var result = []
    var i = 0
    while i < len(table):
        result.append(data[table[i] - 1])
        i += 1
    return result
def des_key_schedule(key_64):
    return key_64

def des3_crypt(key1, key2, key3, data):
    var step1 = rc4_crypt(key1, data)
    var step2 = rc4_crypt(key2, step1)
    var step3 = rc4_crypt(key3, step2)
    return step3
def rc4_encrypt_str(key_str, plaintext):
    var key = []
    var i = 0
    while i < len(key_str):
        key.append(ord(key_str[i]))
        i += 1
    var data = []
    i = 0
    while i < len(plaintext):
        data.append(ord(plaintext[i]))
        i += 1
    var enc = rc4_crypt(key, data)
    return _ds_bytes_to_hex(enc)
def rc4_decrypt_str(key_str, hex_ciphertext):
    var key = []
    var i = 0
    while i < len(key_str):
        key.append(ord(key_str[i]))
        i += 1
    var data = _ds_hex_to_bytes(hex_ciphertext)
    var dec = rc4_crypt(key, data)
    var s = ""
    i = 0
    while i < len(dec):
        s = s + chr(dec[i])
        i += 1
    return s
