# ============================================================
# 普贤生态库：registry/querybuilder — 链式 SQL 构造（0.2.0）
# ------------------------------------------------------------
# 纯函数库，双模式一致。
#
# 0.1.0 的问题：头注释写 `qb_build(q) → 生成 SQL 字符串 + 参数列表`，但实际只返回
#   字符串，值经 qb_escape() 内联进 SQL。想要参数化（预处理绑定、防注入、复用执行计划）
#   的调用方没有任何入口，还会被注释误导。
#
# 0.2.0 的改法：
#   - qb_build(q)          → string，行为不变（内联转义），注释口径改成「内联转义」
#   - qb_build_params(q)   → [sql, params]，值位置一律换成 ?（预处理绑定用这个）
#   - qb_build_ok(q)       → Ok([sql, params]) | Err(msg)（空表名/空列等前置校验）
#   - 两个包的 qb_* 同名冲突见 dbal 0.2.0（那边已全部改名为 db_*）
# 对齐 PHP query-builder / Laravel Query Builder / Knex.js：
#   qb_select(table)              → 创建 SELECT 查询
#   qb_insert(table, data)        → 创建 INSERT 查询
#   qb_update(table, data)        → 创建 UPDATE 查询
#   qb_delete(table)              → 创建 DELETE 查询
#   qb_where(q, column, op, value) → 添加 WHERE 条件
#   qb_where_in(q, column, values) → WHERE column IN (...)
#   qb_where_like(q, column, pattern) → WHERE column LIKE pattern
#   qb_order_by(q, column, dir)   → ORDER BY
#   qb_group_by(q, column)        → GROUP BY
#   qb_having(q, column, op, value) → HAVING
#   qb_limit(q, n)                → LIMIT
#   qb_offset(q, n)               → OFFSET
#   qb_join(q, table, left, right, type) → JOIN
#   qb_distinct(q)                → SELECT DISTINCT
#   qb_count(q)                   → SELECT COUNT(*)
#   qb_build(q)                   → 生成 SQL 字符串（值内联转义）
#   qb_build_params(q)            → [SQL 字符串, 参数列表]（值是 ?，预处理绑定用）
#   qb_quote_ident(name)          → 标识符引号
#   qb_escape(value)              → 值转义（防 SQL 注入）
# ============================================================

# ---- 标识符引号 ----
def qb_quote_ident(name):
    return "`" + name + "`"

# ---- 值转义 ----
def qb_escape(value):
    if value == null:
        return "NULL"
    if type(value) == "int" or type(value) == "float":
        return str(value)
    var s = str(value)
    var result = ""
    var i = 0
    while i < len(s):
        var c = s[i]
        if c == "'":
            result = result + "''"
        elif c == "\\":
            result = result + "\\\\"
        elif c == "\n":
            result = result + "\\n"
        elif c == "\r":
            result = result + "\\r"
        elif c == "\t":
            result = result + "\\t"
        else:
            result = result + c
        i += 1
    return "'" + result + "'"

# ---- 创建 SELECT 查询 ----
def qb_select(table):
    return {"type": "select", "table": table, "columns": [], "wheres": [], "orders": [], "groups": [], "havings": [], "joins": [], "limit": -1, "offset": -1, "distinct": false}

# ---- 创建 INSERT 查询 ----
def qb_insert(table, data):
    return {"type": "insert", "table": table, "data": data}

# ---- 创建 UPDATE 查询 ----
def qb_update(table, data):
    return {"type": "update", "table": table, "data": data, "wheres": []}

# ---- 创建 DELETE 查询 ----
def qb_delete(table):
    return {"type": "delete", "table": table, "wheres": []}

# ---- 添加 WHERE 条件 ----
def qb_where(q, column, op, value):
    q["wheres"].append({"column": column, "op": op, "value": value, "type": "basic"})
    return q

# ---- WHERE IN ----
def qb_where_in(q, column, values):
    q["wheres"].append({"column": column, "op": "IN", "value": values, "type": "in"})
    return q

# ---- WHERE LIKE ----
def qb_where_like(q, column, pattern):
    q["wheres"].append({"column": column, "op": "LIKE", "value": pattern, "type": "basic"})
    return q

# ---- WHERE NULL ----
def qb_where_null(q, column):
    q["wheres"].append({"column": column, "op": "IS NULL", "value": null, "type": "null"})
    return q

# ---- WHERE NOT NULL ----
def qb_where_not_null(q, column):
    q["wheres"].append({"column": column, "op": "IS NOT NULL", "value": null, "type": "notnull"})
    return q

# ---- ORDER BY ----
def qb_order_by(q, column, dir = "ASC"):
    q["orders"].append({"column": column, "dir": dir})
    return q

# ---- GROUP BY ----
def qb_group_by(q, column):
    q["groups"].append(column)
    return q

# ---- HAVING ----
def qb_having(q, column, op, value):
    q["havings"].append({"column": column, "op": op, "value": value})
    return q

# ---- LIMIT ----
def qb_limit(q, n):
    q["limit"] = n
    return q

# ---- OFFSET ----
def qb_offset(q, n):
    q["offset"] = n
    return q

# ---- JOIN ----
def qb_join(q, table, left, right, type = "INNER"):
    q["joins"].append({"table": table, "left": left, "right": right, "type": type})
    return q

# ---- DISTINCT ----
def qb_distinct(q):
    q["distinct"] = true
    return q

# ---- 构建 WHERE 子句 ----
def qb_build_wheres(wheres):
    if len(wheres) == 0:
        return ""
    var parts = []
    var i = 0
    while i < len(wheres):
        var w = wheres[i]
        if w["type"] == "basic":
            parts.append(qb_quote_ident(w["column"]) + " " + w["op"] + " " + qb_escape(w["value"]))
        elif w["type"] == "in":
            var vals = w["value"]
            var vparts = []
            var j = 0
            while j < len(vals):
                vparts.append(qb_escape(vals[j]))
                j += 1
            parts.append(qb_quote_ident(w["column"]) + " IN (" + join(vparts, ", ") + ")")
        elif w["type"] == "null":
            parts.append(qb_quote_ident(w["column"]) + " IS NULL")
        elif w["type"] == "notnull":
            parts.append(qb_quote_ident(w["column"]) + " IS NOT NULL")
        i += 1
    return " WHERE " + join(parts, " AND ")

# ---- 辅助：join ----
def join(arr, sep):
    if len(arr) == 0:
        return ""
    var result = arr[0]
    var i = 1
    while i < len(arr):
        result = result + sep + arr[i]
        i += 1
    return result

# ---- 构建 SQL ----
def qb_build(q):
    if q["type"] == "select":
        var cols = "*"
        if len(q["columns"]) > 0:
            cols = join(q["columns"], ", ")
        var sql = "SELECT "
        if q["distinct"] == true:
            sql = sql + "DISTINCT "
        sql = sql + cols + " FROM " + qb_quote_ident(q["table"])
        # JOIN
        var i = 0
        while i < len(q["joins"]):
            var j = q["joins"][i]
            sql = sql + " " + j["type"] + " JOIN " + qb_quote_ident(j["table"]) + " ON " + qb_quote_ident(j["left"]) + " = " + qb_quote_ident(j["right"])
            i += 1
        # WHERE
        sql = sql + qb_build_wheres(q["wheres"])
        # GROUP BY
        if len(q["groups"]) > 0:
            sql = sql + " GROUP BY " + join(q["groups"], ", ")
        # HAVING
        if len(q["havings"]) > 0:
            var hparts = []
            i = 0
            while i < len(q["havings"]):
                var h = q["havings"][i]
                hparts.append(h["column"] + " " + h["op"] + " " + qb_escape(h["value"]))
                i += 1
            sql = sql + " HAVING " + join(hparts, " AND ")
        # ORDER BY
        if len(q["orders"]) > 0:
            var oparts = []
            i = 0
            while i < len(q["orders"]):
                var o = q["orders"][i]
                oparts.append(qb_quote_ident(o["column"]) + " " + o["dir"])
                i += 1
            sql = sql + " ORDER BY " + join(oparts, ", ")
        # LIMIT
        if q["limit"] >= 0:
            sql = sql + " LIMIT " + str(q["limit"])
        # OFFSET
        if q["offset"] >= 0:
            sql = sql + " OFFSET " + str(q["offset"])
        return sql
    elif q["type"] == "insert":
        var keys = q["data"].keys()
        var placeholders = []
        var col_names = []
        var i = 0
        while i < len(keys):
            col_names.append(qb_quote_ident(keys[i]))
            placeholders.append(qb_escape(q["data"][keys[i]]))
            i += 1
        return "INSERT INTO " + qb_quote_ident(q["table"]) + " (" + join(col_names, ", ") + ") VALUES (" + join(placeholders, ", ") + ")"
    elif q["type"] == "update":
        var keys = q["data"].keys()
        var sets = []
        var i = 0
        while i < len(keys):
            sets.append(qb_quote_ident(keys[i]) + " = " + qb_escape(q["data"][keys[i]]))
            i += 1
        var sql = "UPDATE " + qb_quote_ident(q["table"]) + " SET " + join(sets, ", ")
        sql = sql + qb_build_wheres(q["wheres"])
        return sql
    elif q["type"] == "delete":
        var sql = "DELETE FROM " + qb_quote_ident(q["table"])
        sql = sql + qb_build_wheres(q["wheres"])
        return sql
    return ""

# ============================================================
# 0.2.0 新增：参数化构建（值是 ?，参数按出现顺序收集）
# ============================================================
def qb_push(dst, src):
    var i = 0
    while i < len(src):
        dst.append(src[i])
        i += 1
    return dst

def _qb_wheres_params(wheres):
    var params = []
    if len(wheres) == 0:
        return ["", params]
    var parts = []
    var i = 0
    while i < len(wheres):
        var w = wheres[i]
        if w["type"] == "basic":
            parts.append(qb_quote_ident(w["column"]) + " " + w["op"] + " ?")
            params.append(w["value"])
        elif w["type"] == "in":
            var vals = w["value"]
            var marks = []
            var j = 0
            while j < len(vals):
                marks.append("?")
                params.append(vals[j])
                j += 1
            if len(marks) == 0:
                parts.append(qb_quote_ident(w["column"]) + " IN (NULL)")
            else:
                parts.append(qb_quote_ident(w["column"]) + " IN (" + join(marks, ", ") + ")")
        elif w["type"] == "null":
            parts.append(qb_quote_ident(w["column"]) + " IS NULL")
        elif w["type"] == "notnull":
            parts.append(qb_quote_ident(w["column"]) + " IS NOT NULL")
        i += 1
    return [" WHERE " + join(parts, " AND "), params]

def qb_build_params(q):
    var params = []
    var sql = ""
    var i = 0
    if q["type"] == "select":
        var cols = "*"
        if len(q["columns"]) > 0:
            cols = join(q["columns"], ", ")
        sql = "SELECT "
        if q["distinct"] == true:
            sql = sql + "DISTINCT "
        sql = sql + cols + " FROM " + qb_quote_ident(q["table"])
        i = 0
        while i < len(q["joins"]):
            var j = q["joins"][i]
            sql = sql + " " + j["type"] + " JOIN " + qb_quote_ident(j["table"]) + " ON " + qb_quote_ident(j["left"]) + " = " + qb_quote_ident(j["right"])
            i += 1
        var wp = _qb_wheres_params(q["wheres"])
        sql = sql + wp[0]
        qb_push(params, wp[1])
        if len(q["groups"]) > 0:
            sql = sql + " GROUP BY " + join(q["groups"], ", ")
        if len(q["havings"]) > 0:
            var hparts = []
            i = 0
            while i < len(q["havings"]):
                var h = q["havings"][i]
                hparts.append(qb_quote_ident(h["column"]) + " " + h["op"] + " ?")
                params.append(h["value"])
                i += 1
            sql = sql + " HAVING " + join(hparts, " AND ")
        if len(q["orders"]) > 0:
            var oparts = []
            i = 0
            while i < len(q["orders"]):
                var o = q["orders"][i]
                oparts.append(qb_quote_ident(o["column"]) + " " + o["dir"])
                i += 1
            sql = sql + " ORDER BY " + join(oparts, ", ")
        if q["limit"] >= 0:
            sql = sql + " LIMIT " + str(q["limit"])
        if q["offset"] >= 0:
            sql = sql + " OFFSET " + str(q["offset"])
        return [sql, params]
    if q["type"] == "insert":
        var keys = q["data"].keys()
        var col_names = []
        var marks = []
        i = 0
        while i < len(keys):
            col_names.append(qb_quote_ident(keys[i]))
            marks.append("?")
            params.append(q["data"][keys[i]])
            i += 1
        sql = "INSERT INTO " + qb_quote_ident(q["table"]) + " (" + join(col_names, ", ") + ") VALUES (" + join(marks, ", ") + ")"
        return [sql, params]
    if q["type"] == "update":
        var keys2 = q["data"].keys()
        var sets = []
        i = 0
        while i < len(keys2):
            sets.append(qb_quote_ident(keys2[i]) + " = ?")
            params.append(q["data"][keys2[i]])
            i += 1
        sql = "UPDATE " + qb_quote_ident(q["table"]) + " SET " + join(sets, ", ")
        var wp2 = _qb_wheres_params(q["wheres"])
        sql = sql + wp2[0]
        qb_push(params, wp2[1])
        return [sql, params]
    if q["type"] == "delete":
        sql = "DELETE FROM " + qb_quote_ident(q["table"])
        var wp3 = _qb_wheres_params(q["wheres"])
        sql = sql + wp3[0]
        qb_push(params, wp3[1])
        return [sql, params]
    return ["", params]

# 前置校验版：空表名 / 空 SET / 空 INSERT 直接 Err，不产出坏 SQL
def qb_build_ok(q):
    if not q.has("type"):
        return Err("不是查询对象（缺 type）")
    var table = ""
    if q.has("table"):
        table = q["table"]
    if table == "":
        return Err("表名不能为空")
    var r = qb_build_params(q)
    if q["type"] == "insert" or q["type"] == "update":
        if len(q["data"].keys()) == 0:
            return Err(q["type"] + " 的 data 不能为空")
    return Ok(r)
