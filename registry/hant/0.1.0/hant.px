# ============================================================
# 普贤生态库：registry/hant —— 简繁中文转换（保守单字子集）
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对照 OpenCC / hanziconv 心智（0.1.0：常用字单字映射子集，不处理分词/短语转换）：
#   hant_s2t(s) → Ok(str)   # 简体 → 繁体
#   hant_t2s(s) → Ok(str)   # 繁体 → 简体（由映射表运行时求逆）
# 说明：
#   - 映射表由 OpenCC 数据生成，并做了两道过滤：
#     ① 语境敏感字（了/出/面/家/表/制/里/于/线/发/后/复/台/只/干 等）不在表内，
#        单独/分词转换会选错写法，本库保守跳过（例如 "发展" 的 "发" 保持原形）；
#     ② 仅保留双向可逆的无歧义对子（t2s(tc) == s）。
#   - 表外字符原样透传（含 ASCII、拼音、未收录繁体）。
# ============================================================
# 简→繁单字映射（常用字内嵌子集；已做双向可逆 + 语境敏感黑名单过滤，0.1.0 保守映射）
const HANT_S2T = {
"这": "這", "为": "為", "个": "個", "国": "國", "时": "時", "来": "來", "们": "們", "对": "對", "会": "會", "动": "動",
"过": "過", "说": "說", "产": "産", "种": "種", "学": "學", "经": "經", "进": "進", "着": "著", "电": "電", "现": "現",
"实": "實", "两": "兩", "体": "體", "机": "機", "当": "當", "点": "點", "从": "從", "业": "業", "应": "應", "开": "開",
"还": "還", "义": "義", "间": "間", "样": "樣", "与": "與", "关": "關", "内": "內", "数": "數", "么": "麼", "质": "質",
"气": "氣", "向": "嚮", "变": "變", "条": "條", "没": "沒", "结": "結", "问": "問", "无": "無", "军": "軍", "并": "並",
"题": "題", "党": "黨", "员": "員", "总": "總", "设": "設", "长": "長", "头": "頭", "资": "資", "边": "邊", "级": "級",
"图": "圖", "统": "統", "较": "較", "将": "將", "组": "組", "见": "見", "计": "計", "别": "彆", "论": "論", "运": "運",
"农": "農", "几": "幾", "区": "區", "强": "強", "决": "決", "战": "戰", "回": "迴", "则": "則", "据": "據", "处": "處",
"队": "隊", "给": "給", "门": "門", "规": "規", "热": "熱", "领": "領", "东": "東", "导": "導", "压": "壓", "志": "誌",
"争": "爭", "济": "濟", "阶": "階", "术": "術", "极": "極", "联": "聯", "认": "認", "权": "權", "证": "證", "转": "轉",
"单": "單", "风": "風", "带": "帶", "场": "場", "车": "車", "务": "務", "万": "萬", "达": "達", "积": "積", "议": "議",
"声": "聲", "报": "報", "类": "類", "离": "離", "华": "華", "确": "確", "才": "纔", "张": "張", "马": "馬", "节": "節",
"话": "話", "况": "況", "温": "溫", "传": "傳", "许": "許", "广": "廣", "记": "記", "观": "觀", "织": "織", "装": "裝",
"众": "眾", "书": "書", "儿": "兒", "须": "須", "际": "際", "验": "驗", "连": "連", "断": "斷", "难": "難", "矿": "礦",
"千": "韆", "备": "備", "办": "辦", "习": "習", "响": "響", "约": "約", "劳": "勞", "团": "團", "历": "曆", "克": "剋",
"构": "構", "称": "稱", "号": "號", "维": "維", "划": "劃", "选": "選", "标": "標", "写": "寫", "亲": "親", "养": "養",
"层": "層", "却": "卻", "专": "專", "状": "狀", "厂": "廠", "识": "識", "适": "適", "属": "屬", "圆": "圓", "调": "調",
"满": "滿", "县": "縣", "参": "參", "红": "紅", "细": "細", "听": "聽", "该": "該", "铁": "鐵", "价": "價", "严": "嚴",
"龙": "龍", "飞": "飛",
}
# 单字映射查找
def o_lookup(c):
    if HANT_S2T.has(c):
        return HANT_S2T[c]
    return c
# 简体 → 繁体
def hant_s2t(s):
    var out = ""
    var i = 0
    while i < len(s):
        out = out + o_lookup(s[i])
        i += 1
    return Ok(out)
# 运行时求逆表（字典无内置 invert）
def hant_t2s(s):
    var inv = {}
    var ks = HANT_S2T.keys()
    var j = 0
    while j < len(ks):
        var k = ks[j]
        inv.set(HANT_S2T[k], k)
        j += 1
    var out = ""
    var i = 0
    while i < len(s):
        var c = s[i]
        if inv.has(c):
            out = out + inv[c]
        else:
            out = out + c
        i += 1
    return Ok(out)
