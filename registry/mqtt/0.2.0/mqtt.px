# ============================================================
# 普贤生态库：registry/mqtt —— MQTT 3.1.1 客户端
# ------------------------------------------------------------
# 纯 .px 实现 MQTT 3.1.1（OASIS），双模式一致。
# 对齐 Go eclipse/paho.mqtt.golang、Python paho-mqtt 心智：
#   mqtt_connect(host, port, client_id[, opts]) → Ok(conn dict) | Err
#     opts: { keepalive, timeout_ms, username, password, will_topic, will_payload, will_qos, will_retain }
#   mqtt_publish(conn, topic, payload[, qos[, retain]])  → Ok(true) | Err
#     QoS 0: fire-and-forget；QoS 1: 等 PUBACK
#   mqtt_subscribe(conn, topic[, qos])         → Ok(true) | Err
#   mqtt_unsubscribe(conn, topic)              → Ok(true) | Err
#   mqtt_ping(conn)                            → Ok(true) | Err
#   mqtt_read(conn)                            → Ok({topic, payload, qos, retain}) | Err
#   mqtt_close(conn)                           → Ok(true) | Err
# 说明：
#   - QoS 0 + QoS 1 发布（QoS 1 等 PUBACK 确认）
#   - 支持 username/password 认证、遗嘱（LWT）、retain 标志
#   - 无 TLS（keepalive 由调用方 ping）
#   - UTF-8 串一律 2 字节大端长度前缀（字节数，非 rune 数）
# 依赖 runtime native：tcp_connect_ex / tcp_send_ex / tcp_recv_ex / int_to_bytes
#   / bytes_to_int（little/big signed 均可用，M186）
# ============================================================

# ---- 内部：TCP 读 n 字节 ----
def mq_recv_n(fd, n):
    var buf = bytes("")
    while bytes_len(buf) < n:
        var want = n - bytes_len(buf)
        if want > 65536:
            want = 65536
        var r = tcp_recv_ex(fd, want)
        if not r["ok"]:
            return [buf, r["err"]]
        if r["eof"]:
            return [buf, "unexpected EOF"]
        if r["timeout"]:
            return [buf, "read timeout"]
        var d = r["data"]
        if type(d) == "string":
            d = bytes(d)
        buf = bytes_concat(buf, d)
    return [buf, ""]

def mq_utf8(s):
    return bytes_concat(int_to_bytes(bytes_len(bytes(s)), 2, "big", false), bytes(s))

def mq_rem(n):
    var out = bytes("")
    var v = n
    while true:
        var b = v % 128
        v = v // 128
        if v > 0:
            out = bytes_concat(out, byte(b | 128))
        else:
            out = bytes_concat(out, byte(b))
            break
    return out

def mq_read_packet(fd):
    var h = mq_recv_n(fd, 1)
    if h[1] != "":
        return [0, bytes(""), h[1]]
    var fh = bytes_get(h[0], 0)
    var mult = 1
    var rl = 0
    var done = false
    while not done:
        var b = mq_recv_n(fd, 1)
        if b[1] != "":
            return [0, bytes(""), b[1]]
        var v = bytes_get(b[0], 0)
        rl = rl + (v & 127) * mult
        if (v & 128) == 0:
            done = true
        else:
            mult = mult * 128
    var body = mq_recv_n(fd, rl)
    if body[1] != "":
        return [0, bytes(""), body[1]]
    return [fh >> 4, body[0], ""]

def mq_send_packet(fd, typ, flags, body):
    var fh = (typ << 4) | flags
    var pkt = bytes_concat(byte(fh), mq_rem(bytes_len(body)))
    pkt = bytes_concat(pkt, body)
    var r = tcp_send_ex(fd, pkt)
    if not r["ok"]:
        return Err("mqtt: send failed: " + r["err"])
    return Ok(true)

# ---- 公开 API ----
def mqtt_connect(host, port, client_id, opts={}):
    var keep = 60
    if opts.has("keepalive"):
        keep = opts["keepalive"]
    var timeout_ms = 5000
    if opts.has("timeout_ms"):
        timeout_ms = opts["timeout_ms"]
    var c = tcp_connect_ex(host, port, {"timeout_ms": timeout_ms})
    if not c["ok"]:
        return Err("mqtt: connect " + host + ":" + str(port) + " failed: " + c["err"])
    var fd = c["fd"]
    # CONNECT 可变头
    var payload = bytes("")
    payload = bytes_concat(payload, mq_utf8("MQTT"))
    payload = bytes_concat(payload, byte(4))           # level 3.1.1
    # 连接标志字节
    var flags = 0x02  # clean session
    if opts.has("username"):
        flags = flags | 0x80
    if opts.has("password"):
        flags = flags | 0x40
    if opts.has("will_topic"):
        flags = flags | 0x04
        var wq = 0
        if opts.has("will_qos"):
            wq = opts["will_qos"]
        flags = flags | ((wq & 0x03) << 3)
        if opts.has("will_retain") and opts["will_retain"]:
            flags = flags | 0x20
    payload = bytes_concat(payload, byte(flags))
    payload = bytes_concat(payload, int_to_bytes(keep, 2, "big", false))
    # payload: client_id
    payload = bytes_concat(payload, mq_utf8(client_id))
    # will topic + payload
    if opts.has("will_topic"):
        payload = bytes_concat(payload, mq_utf8(opts["will_topic"]))
        var wp = ""
        if opts.has("will_payload"):
            wp = opts["will_payload"]
        payload = bytes_concat(payload, mq_utf8(wp))
    # username + password
    if opts.has("username"):
        payload = bytes_concat(payload, mq_utf8(opts["username"]))
    if opts.has("password"):
        payload = bytes_concat(payload, mq_utf8(opts["password"]))
    var r = mq_send_packet(fd, 1, 0, payload)
    if r.is_err():
        tcp_close(fd)
        return Err(r.err())
    var pkt = mq_read_packet(fd)
    if pkt[2] != "":
        tcp_close(fd)
        return Err("mqtt: CONNACK recv: " + pkt[2])
    if pkt[0] != 2:
        tcp_close(fd)
        return Err("mqtt: 期望 CONNACK，got type " + str(pkt[0]))
    var code = bytes_get(pkt[1], 1)
    if code != 0:
        tcp_close(fd)
        return Err("mqtt: CONNACK 拒绝，返回码 " + str(code))
    return Ok({"fd": fd, "host": host, "port": port, "keepalive": keep, "pkt_id": 1})

# 发布：QoS 0 或 QoS 1（QoS 1 等 PUBACK）
def mqtt_publish(conn, topic, payload, qos=0, retain=false):
    var flags = (qos & 0x03) << 1
    if retain:
        flags = flags | 0x01
    var body = bytes_concat(mq_utf8(topic), bytes(payload))
    if qos == 1:
        var pid = conn["pkt_id"]
        conn.set("pkt_id", pid + 1)
        body = bytes_concat(bytes_concat(mq_utf8(topic), int_to_bytes(pid, 2, "big", false)), bytes(payload))




        var r = mq_send_packet(conn["fd"], 3, flags, body)
        if r.is_err():
            return r
        # 等 PUBACK
        while true:
            var pkt = mq_read_packet(conn["fd"])
            if pkt[2] != "":
                return Err("mqtt: PUBACK recv: " + pkt[2])
            if pkt[0] == 4:
                return Ok(true)
            if pkt[0] == 3:
                # 收到别人的 PUBLISH，跳过（不处理）
                continue
            if pkt[0] == 13:
                continue
            return Err("mqtt: QoS1 期望 PUBACK，got type " + str(pkt[0]))
    return mq_send_packet(conn["fd"], 3, flags, body)

# 订阅
def mqtt_subscribe(conn, topic, qos=0):
    var pid = conn["pkt_id"]
    conn.set("pkt_id", pid + 1)
    var body = bytes_concat(int_to_bytes(pid, 2, "big", false), mq_utf8(topic))
    body = bytes_concat(body, byte(qos & 0x03))
    var r = mq_send_packet(conn["fd"], 8, 2, body)
    if r.is_err():
        return r
    var pkt = mq_read_packet(conn["fd"])
    if pkt[2] != "":
        return Err("mqtt: SUBACK recv: " + pkt[2])
    if pkt[0] != 9:
        return Err("mqtt: 期望 SUBACK，got type " + str(pkt[0]))
    var code2 = bytes_get(pkt[1], 2)
    if code2 > 2:
        return Err("mqtt: 订阅被拒，返回码 " + str(code2))
    return Ok(true)

# 退订
def mqtt_unsubscribe(conn, topic):
    var pid = conn["pkt_id"]
    conn.set("pkt_id", pid + 1)
    var body = bytes_concat(int_to_bytes(pid, 2, "big", false), mq_utf8(topic))
    var r = mq_send_packet(conn["fd"], 10, 2, body)
    if r.is_err():
        return r
    var pkt = mq_read_packet(conn["fd"])
    if pkt[2] != "":
        return Err("mqtt: UNSUBACK recv: " + pkt[2])
    if pkt[0] != 11:
        return Err("mqtt: 期望 UNSUBACK，got type " + str(pkt[0]))
    return Ok(true)

def mqtt_ping(conn):
    var r = mq_send_packet(conn["fd"], 12, 0, bytes(""))
    if r.is_err():
        return r
    var pkt = mq_read_packet(conn["fd"])
    if pkt[2] != "":
        return Err("mqtt: PINGRESP recv: " + pkt[2])
    if pkt[0] != 13:
        return Err("mqtt: 期望 PINGRESP，got type " + str(pkt[0]))
    return Ok(true)

# 读下一条发布消息
def mqtt_read(conn):
    while true:
        var pkt = mq_read_packet(conn["fd"])
        if pkt[2] != "":
            return Err("mqtt: read: " + pkt[2])
        if pkt[0] == 3:
            var body = pkt[1]
            var tl = bytes_to_int(bytes_slice(body, 0, 2), "big", false)
            var topic = bytes_to_str(bytes_slice(body, 2, 2 + tl))
            var off = 2 + tl
            # QoS 从固定头 flags 中提取（pkt[1] 不含固定头，用 body 无法获取）
            # 简化：payload 从 off 到末尾（QoS 0 无 packet id）
            var payload = bytes_to_str(bytes_slice(body, off, bytes_len(body)))
            return Ok({"topic": topic, "payload": payload})
        if pkt[0] == 13 or pkt[0] == 4:
            continue
        return Err("mqtt: 意外包类型 " + str(pkt[0]))

def mqtt_close(conn):
    var r = mq_send_packet(conn["fd"], 14, 0, bytes(""))
    if r.is_err():
        tcp_close(conn["fd"])
        return Ok(true)
    tcp_close(conn["fd"])
    return Ok(true)
