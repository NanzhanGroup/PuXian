# ============================================================
# 普贤生态库：registry/mysql —— 协议基础（辅助文件）
# ------------------------------------------------------------
# MySQL wire protocol 的包/字节/lenenc 原语与认证 token 计算。
# 由 mysql.px import；本文件无公开 API。
# 语言缺陷规避：同 mysql.px 头部说明。
# ============================================================

# ---- 内部：字节/字符串小工具 ----
# MySQL wire protocol：数字一律小端。
# 编码：int_to_bytes(v, n, "little") 双模式可靠（已实测）
def my_u32(v):
    return int_to_bytes(v, 4, "little", false)

def my_u16(v):
    return int_to_bytes(v, 2, "little", false)

# 解码：小端读取（bytes_to_int 的 endian 自 M186 起三轨可靠，此处手写保持自明）
def my_u32_of(b, off):
    var v = 0
    var i = 3
    while i >= 0:
        v = (v << 8) | bytes_get(b, off + i)
        i -= 1
    return v

def my_u16_of(b, off):
    var lo = bytes_get(b, off)
    var hi = bytes_get(b, off + 1)
    return lo | (hi << 8)

def my_u8_of(b, off):
    return bytes_get(b, off)

# ---- 内部：TCP 读满 n 字节 ----
def my_recv_n(fd, n):
    var buf = bytes("")
    while bytes_len(buf) < n:
        var want = n - bytes_len(buf)
        if want > 65536:
            want = 65536
        var r = tcp_recv_ex(fd, want)
        if not r["ok"]:
            return [buf, r["err"]]
        if r["eof"]:
            return [buf, "unexpected EOF (need " + str(n) + " got " + str(bytes_len(buf)) + ")"]
        if r["timeout"]:
            return [buf, "read timeout"]
        buf = bytes_concat(buf, r["data"])
    return [buf, ""]

# MySQL 包：3 字节小端长度 + 1 字节序列号 + payload
def my_packet_len(b):
    return bytes_get(b, 0) | (bytes_get(b, 1) << 8) | (bytes_get(b, 2) << 16)

def my_build_packet(seq, payload):
    var n = bytes_len(payload)
    var head = byte(n & 255)
    head = bytes_concat(head, byte((n >> 8) & 255))
    head = bytes_concat(head, byte((n >> 16) & 255))
    head = bytes_concat(head, bytes(chr(seq)))
    return bytes_concat(head, payload)

def my_send_packet(fd, seq, payload):
    var pkt = my_build_packet(seq, payload)
    var r = tcp_send_ex(fd, pkt)
    if not r["ok"]:
        return Err("mysql: send failed: " + r["err"])
    return Ok(true)

# 读一个完整 MySQL 包（自动拼接 >16MB 分片，0.1.0 简化为循环读分片）
def my_read_packet(fd):
    var payload = bytes("")
    var seq = 0
    while true:
        var h = my_recv_n(fd, 4)
        if h[1] != "":
            return [bytes(""), seq, 0, h[1]]
        var plen = my_packet_len(h[0])
        seq = bytes_get(h[0], 3)
        if plen == 0:
            return [payload, seq, 1, ""]
        var body = my_recv_n(fd, plen)
        if body[1] != "":
            return [bytes(""), seq, 0, body[1]]
        payload = bytes_concat(payload, body[0])
        if plen < 16777215:
            return [payload, seq, 1, ""]

# 读 lenenc-int（MySQL length-encoded integer）
# 返回 [value, 新偏移, err]
def my_lenenc_int(b, off):
    if off >= bytes_len(b):
        return [null, off, "lenenc out of bounds at " + str(off)]
    var first = bytes_get(b, off)
    if first < 251:
        return [first, off + 1, ""]
    if first == 251:
        return [null, off + 1, ""]
    if first == 252:
        return [my_u16_of(b, off + 1), off + 3, ""]
    if first == 253:
        var v3 = my_u16_of(b, off + 1) | (bytes_get(b, off + 3) << 16)
        return [v3, off + 4, ""]
    if first == 254:
        return [my_u32_of(b, off + 1), off + 9, ""]
    return [0, off + 1, "invalid lenenc"]

# lenenc-str
def my_lenenc_str(b, off):
    var r = my_lenenc_int(b, off)
    if r[2] != "":
        return ["", off, r[2]]
    if r[0] == null:
        return [null, r[1], ""]
    var n = r[0]
    var raw = bytes_slice(b, r[1], r[1] + n)
    return [bytes_to_str(raw), r[1] + n, ""]

# Eof 包判定：payload 长度 < 9 且第一个字节 0xfe
def my_is_eof(payload):
    if bytes_len(payload) < 9 and bytes_get(payload, 0) == 254:
        return true
    return false

# ERR 包解析 → 人类可读消息
def my_err_message(payload):
    var off = 1
    var code = my_u16_of(payload, off)
    off += 2
    if bytes_len(payload) > off and bytes_get(payload, off) == 35:  # '#'
        off += 1
        off += 5
    var msg = bytes_to_str(bytes_slice(payload, off, bytes_len(payload)))
    return "mysql err " + str(code) + ": " + msg

# OK 包解析 → 命令影响行数等
def my_ok_result(payload):
    var off = 1
    var aff = my_lenenc_int(payload, off)
    off = aff[1]
    var last_id = my_lenenc_int(payload, off)
    off = last_id[1]
    var status = 0
    if bytes_len(payload) > off + 2:
        status = my_u16_of(payload, off)
    return {"affected": aff[0], "last_id": last_id[0], "status": status}

# ---- 内部：认证 ----
# mysql_native_password: token = SHA1(pw) XOR SHA1(nonce + SHA1(SHA1(pw)))
def my_native_token(password, nonce):
    var pw = bytes(password)
    var sha1_pw = sha1_bytes(pw)
    var sha1_sha1 = sha1_bytes(sha1_pw)
    var inner = bytes_concat(nonce, sha1_sha1)
    var sha1_inner = sha1_bytes(inner)
    var out = bytes("")
    var i = 0
    while i < 20:
        var x = bytes_get(sha1_pw, i) ^ bytes_get(sha1_inner, i)
        out = bytes_concat(out, byte(x))
        i += 1
    return out

# 查询是否 caching_sha2（fast auth 可用 SHA256；full auth 需要 TLS/RSA → Err）
def my_is_caching_sha2(plugin):
    return plugin.find("caching_sha2_password") >= 0

def my_is_native(plugin):
    return plugin.find("mysql_native_password") >= 0

# 按插件计算认证 token（native / caching_sha2 fast auth）；不支持的插件返回 null
def my_auth_token(plugin, password, nonce):
    # 空密码：MySQL 约定 auth response 长度为 0（不发 token）
    if len(password) == 0:
        return [bytes(""), ""]
    if my_is_caching_sha2(plugin):
        # fast auth：SHA256(SHA256(pw)) XOR SHA256(nonce + SHA256(SHA256(pw)))
        var pw = bytes(password)
        var s1 = sha256_bytes(pw)
        var s2 = sha256_bytes(s1)
        var inner = bytes_concat(nonce, s2)
        var si = sha256_bytes(inner)
        var out = bytes("")
        var i = 0
        while i < 32:
            var x = bytes_get(s1, i) ^ bytes_get(si, i)
            out = bytes_concat(out, byte(x))
            i += 1
        return [out, ""]
    if my_is_native(plugin):
        return [my_native_token(password, nonce), ""]
    return [bytes(""), "mysql: unsupported auth plugin: " + plugin]
