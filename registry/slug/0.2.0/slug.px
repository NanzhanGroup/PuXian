# ============================================================
# 普贤生态库：registry/slug —— slug / URL 友好标识
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Python python-slugify / Go gosimple/slug / Rust slug 心智（0.1.0）：
#   sl_slug(s)        → str   默认：ASCII 字母数字小写 + 中文 CJK 保留，
#                             其余分隔字符折叠为单个 "-"（首尾去除）
#   sl_slug_ascii(s)  → str   严格 ASCII：非 ASCII 一律折叠为 "-"
# 说明：
#   - 未做拉丁变音转写（á→a 需要 unicode 表，无 native 见登记 PX-DEF-015 一族），
#     非 ASCII 默认策略 = 保留 CJK / 丢弃其它
#   - 复数与停用词不做处理（0.1.0 子集）
# ============================================================
def sl_is_ascii_alnum(c):
    return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9")
# CJK 统一表意文字 0x4E00..0x9FFF（含扩展 A 部分常用面）
def sl_is_cjk(c):
    return ord(c) >= 19968 and ord(c) <= 40959
# 内部：核心折叠逻辑（keep_cjk 控制是否保留中文）
def sl_build(s, keep_cjk):
    var out = ""
    var prev_dash = false
    var i = 0
    while i < len(s):
        var c = s[i]
        var lc = to_lower(c)
        if sl_is_ascii_alnum(lc):
            out = out + lc
            prev_dash = false
        elif keep_cjk and sl_is_cjk(c):
            out = out + c
            prev_dash = false
        else:
            if len(out) > 0 and not prev_dash:
                out = out + "-"
                prev_dash = true
        i += 1
    while len(out) > 0 and out[len(out) - 1] == "-":
        out = out[0:len(out) - 1]
    return out
def sl_slug(s):
    return sl_build(s, true)
def sl_slug_ascii(s):
    return sl_build(s, false)
# ============================================================
# 0.2.0 新增函数
# ============================================================
# 带分隔符的 slug
def sl_slug_sep(s, sep):
    var result = sl_slug(s)
    var out = ""
    var i = 0
    while i < len(result):
        if result[i] == "-":
            out = out + sep
        else:
            out = out + result[i]
        i += 1
    return out
# 带最大长度限制的 slug
def sl_slug_max(s, max_len):
    var result = sl_slug(s)
    if len(result) <= max_len:
        return result
    # 在 max_len 内找最后一个分隔符截断
    var cut = max_len
    while cut > 0 and result[cut - 1] == "-":
        cut -= 1
    return result[0:cut]
# 带前缀的 slug
def sl_slug_prefix(s, prefix):
    var result = sl_slug(s)
    if len(prefix) == 0:
        return result
    return prefix + "-" + result
# 检查是否为合法 slug
def sl_is_valid(s):
    if len(s) == 0:
        return false
    var i = 0
    while i < len(s):
        var c = s[i]
        if not sl_is_ascii_alnum(c) and c != "-" and not sl_is_cjk(c):
            return false
        i += 1
    # 首尾不能是 -
    if s[0] == "-" or s[len(s) - 1] == "-":
        return false
    # 不能有连续 -
    i = 0
    while i + 1 < len(s):
        if s[i] == "-" and s[i + 1] == "-":
            return false
        i += 1
    return true
# 去重 slug：如果 slug 已存在于列表，追加 -2, -3 等
def sl_slug_unique(s, existing):
    var base = sl_slug(s)
    if not sl_contains(existing, base):
        return base
    var n = 2
    while true:
        var candidate = base + "-" + str(n)
        if not sl_contains(existing, candidate):
            return candidate
        n += 1
def sl_contains(arr, v):
    var i = 0
    while i < len(arr):
        if arr[i] == v:
            return true
        i += 1
    return false
# 反转 slug 为可读标题
def sl_unslug(s):
    if len(s) == 0:
        return s
    var out = ""
    var i = 0
    while i < len(s):
        var c = s[i]
        if c == "-":
            out = out + " "
        elif i == 0 or s[i - 1] == "-":
            out = out + to_upper(c)
        else:
            out = out + c
        i += 1
    return out
# 生成 URL 友好 ID（含时间戳后缀）
def sl_slug_id(s, suffix):
    var base = sl_slug(s)
    return base + "-" + suffix
# ============================================================
# 从 slugify 合并的函数（2026-10-06 异名同功能合并）
# 迁入函数：sl_strip_accents / sl_transliterate / sl_slugify_unicode / sl_custom_map /
#           sl_slugify / sl_truncate_slug / sl_make_unique
# slugify 库已删除，全部功能由 slug 提供（2026-10-06 异名同功能合并）
# ============================================================
# 去除重音符号（常见 Latin-1 Supplement）
def sl_strip_accents(text):
    var result = ""
    var i = 0
    while i < len(text):
        var c = text[i]
        var code = ord(c)
        if code == 224 or code == 225 or code == 226 or code == 227 or code == 228 or code == 229:
            result = result + "a"
        elif code == 232 or code == 233 or code == 234 or code == 235:
            result = result + "e"
        elif code == 236 or code == 237 or code == 238 or code == 239:
            result = result + "i"
        elif code == 242 or code == 243 or code == 244 or code == 245 or code == 246:
            result = result + "o"
        elif code == 249 or code == 250 or code == 251 or code == 252:
            result = result + "u"
        elif code == 241:
            result = result + "n"
        elif code == 231:
            result = result + "c"
        elif code == 192 or code == 193 or code == 194 or code == 195 or code == 196 or code == 197:
            result = result + "A"
        elif code == 200 or code == 201 or code == 202 or code == 203:
            result = result + "E"
        elif code == 204 or code == 205 or code == 206 or code == 207:
            result = result + "I"
        elif code == 210 or code == 211 or code == 212 or code == 213 or code == 214:
            result = result + "O"
        elif code == 217 or code == 218 or code == 219 or code == 220:
            result = result + "U"
        elif code == 209:
            result = result + "N"
        elif code == 199:
            result = result + "C"
        else:
            result = result + c
        i += 1
    return result
# 音译（常见 Unicode → ASCII）
def sl_transliterate(text):
    var result = ""
    var i = 0
    while i < len(text):
        var c = text[i]
        var code = ord(c)
        if code < 128:
            result = result + c
        elif code == 8217 or code == 8216:
            result = result + "'"
        elif code == 8220 or code == 8221:
            result = result + "\""
        elif code == 8211:
            result = result + "-"
        elif code == 8212:
            result = result + "--"
        elif code == 8230:
            result = result + "..."
        elif code == 8482:
            result = result + "TM"
        elif code == 169:
            result = result + "(c)"
        elif code == 174:
            result = result + "(R)"
        else:
            result = result + sl_strip_accents(c)
        i += 1
    return result
# Unicode slugify（先音译再 slugify）
def sl_slugify_unicode(text, separator = "-"):
    var trans = sl_transliterate(text)
    return sl_slugify(trans, separator)
# 自定义字符映射
def sl_custom_map(text, char_map):
    var result = ""
    var i = 0
    while i < len(text):
        var c = text[i]
        if char_map.contains(c):
            result = result + char_map[c]
        else:
            result = result + c
        i += 1
    return result
# slugify 风格的 slug 生成（支持自定义分隔符）
def sl_slugify(text, separator = "-"):
    var result = ""
    var i = 0
    var last_was_sep = false
    while i < len(text):
        var c = text[i]
        var code = ord(c)
        if (code >= 65 and code <= 90) or (code >= 97 and code <= 122) or (code >= 48 and code <= 57):
            if code >= 65 and code <= 90:
                c = chr(code + 32)
            result = result + c
            last_was_sep = false
        else:
            if not last_was_sep and len(result) > 0:
                result = result + separator
                last_was_sep = true
        i += 1
    if len(result) > 0:
        var last = result[len(result) - 1]
        if last == separator[0]:
            result = result[0 : len(result) - 1]
    return result
# 截断 slug
def sl_truncate_slug(slug, max_len):
    if len(slug) <= max_len:
        return slug
    return slug[0 : max_len]
# 确保 slug 唯一（与 sl_slug_unique 功能相同，保留兼容）
def sl_make_unique(slug, existing):
    if not sl_contains(existing, slug):
        return slug
    var n = 2
    while true:
        var candidate = slug + "-" + str(n)
        if not sl_contains(existing, candidate):
            return candidate
        n += 1
