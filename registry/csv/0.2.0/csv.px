# ============================================================
# 普贤生态库：registry/csv 0.2.0 —— RFC 4180 CSV 解析与序列化（增强版）
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Go encoding/csv 心智：
#
# 0.1.0 API（全部保留，向后兼容）：
#   csv_parse(s) → Ok(rows) | Err(msg)    rows = [[str,...],...]
#   csv_serialize(rows) → Ok(str) | Err
#
# 0.2.0 新增：
#   csv_parse_opts(s, opts)     → 自定义分隔符/引号/注释符/跳空行
#   csv_parse_header(s)         → Ok(list[dict]) 首行作 header
#   csv_serialize_header(rows, headers) → Ok(str) 带 header 行
#   csv_serialize_row(row)      → Ok(str) 单行序列化
#   csv_parse_tsv(s)            → Tab 分隔快捷
#   csv_parse_delim(s, delim)   → 自定义分隔符快捷
#   csv_get_col(rows, idx)      → 提取某列为 list
#   csv_filter_rows(rows, idx, val) → 筛选某列等于 val 的行
# ============================================================
# ---- 0.1.0 核心解析（保留）----
def csv_parse(s):
    return csv_parse_opts(s, {})
# 0.2.0 增强解析（支持自定义分隔符/引号/注释/跳空行）
def csv_parse_opts(s, opts):
    var delim = ","
    var quote = "\""
    var comment = ""
    var skip_empty = false
    if opts != null and type(opts) == "dict":
        if opts.has("delim"):
            delim = opts["delim"]
        if opts.has("quote"):
            quote = opts["quote"]
        if opts.has("comment"):
            comment = opts["comment"]
        if opts.has("skip_empty"):
            skip_empty = opts["skip_empty"]
    var rows = []
    var row = []
    var field = ""
    var i = 0
    var n = len(s)
    var in_quotes = false
    var field_started = false
    var line_start = true
    while i < n:
        var c = s[i]
        # 注释行：行首匹配 comment 前缀 → 跳到行尾
        if line_start and len(comment) > 0 and i + len(comment) <= n and s[i:i + len(comment)] == comment:
            while i < n and s[i] != "\n":
                i += 1
            if i < n:
                i += 1
            row = []
            field = ""
            field_started = false
            line_start = true
            continue
        line_start = false
        if in_quotes:
            if c == quote:
                if i + 1 < n and s[i + 1] == quote:
                    field = field + quote
                    i += 2
                    continue
                in_quotes = false
                i += 1
                continue
            field = field + c
            i += 1
            continue
        if c == quote:
            if len(field) == 0:
                in_quotes = true
                field_started = true
            else:
                field = field + c
            i += 1
            continue
        if c == delim:
            row.append(field)
            field = ""
            field_started = false
            i += 1
            continue
        if c == "\n":
            if field_started or len(field) > 0 or len(row) > 0:
                row.append(field)
                rows.append(row)
            elif not skip_empty and len(row) > 0:
                row.append(field)
                rows.append(row)
            row = []
            field = ""
            field_started = false
            line_start = true
            i += 1
            continue
        if c == "\r":
            i += 1
            continue
        field = field + c
        field_started = true
        i += 1
    if in_quotes:
        return Err("csv: 未闭合的引号")
    if len(field) > 0 or field_started or len(row) > 0:
        row.append(field)
        rows.append(row)
    return Ok(rows)
# ---- 序列化 ----
def csv_needs_quote(f, delim):
    if contains(f, delim):
        return true
    if contains(f, "\""):
        return true
    if contains(f, "\n"):
        return true
    if contains(f, "\r"):
        return true
    return false
def csv_escape_quotes(f):
    var out = ""
    var i = 0
    while i < len(f):
        if f[i] == "\"":
            out = out + "\"\""
        else:
            out = out + f[i]
        i += 1
    return out
def csv_serialize(rows):
    return csv_serialize_opts(rows, {})
# 0.2.0 带选项序列化
def csv_serialize_opts(rows, opts):
    var delim = ","
    if opts != null and type(opts) == "dict" and opts.has("delim"):
        delim = opts["delim"]
    var out = ""
    var r = 0
    while r < len(rows):
        var line = ""
        var c = 0
        while c < len(rows[r]):
            if c > 0:
                line = line + delim
            var f = str(rows[r][c])
            if csv_needs_quote(f, delim):
                line = line + "\"" + csv_escape_quotes(f) + "\""
            else:
                line = line + f
            c += 1
        out = out + line + "\n"
        r += 1
    return Ok(out)
# 单行序列化
def csv_serialize_row(row):
    var r = csv_serialize_opts([row], {})
    if r.is_err():
        return r
    var s = r.unwrap()
    return Ok(s[0:len(s) - 1])
# ---- 0.2.0 header 处理 ----
# 首行作 header → list[dict]
def csv_parse_header(s):
    var r = csv_parse(s)
    if r.is_err():
        return r
    var rows = r.unwrap()
    if len(rows) < 1:
        return Ok([])
    var headers = rows[0]
    var result = []
    var i = 1
    while i < len(rows):
        var obj = {}
        var j = 0
        while j < len(headers) and j < len(rows[i]):
            obj.set(headers[j], rows[i][j])
            j += 1
        result.append(obj)
        i += 1
    return Ok(result)
# 带 header 行序列化
def csv_serialize_header(rows, headers):
    var all_rows = [headers]
    var i = 0
    while i < len(rows):
        all_rows.append(rows[i])
        i += 1
    return csv_serialize(all_rows)
# ---- 0.2.0 快捷方法 ----
def csv_parse_tsv(s):
    return csv_parse_opts(s, {"delim": "\t"})
def csv_parse_delim(s, delim):
    return csv_parse_opts(s, {"delim": delim})
# 提取某列
def csv_get_col(rows, idx):
    var col = []
    var i = 0
    while i < len(rows):
        if idx < len(rows[i]):
            col.append(rows[i][idx])
        else:
            col.append("")
        i += 1
    return col
# 筛选某列等于 val 的行
def csv_filter_rows(rows, idx, val):
    var result = []
    var i = 0
    while i < len(rows):
        if idx < len(rows[i]) and rows[i][idx] == val:
            result.append(rows[i])
        i += 1
    return result
# ============================================================
# 从 csvutil 合并的函数（2026-10-06 异名同功能合并）
# 迁入函数：csv_escape_field / csv_unescape_field / csv_sort / csv_unique /
#           csv_build / csv_build_header / csv_filter / csv_column
# csvutil 库已删除，全部功能由 csv 提供
# 注意：csvutil 的 csv_parse / csv_parse_header 与 csv 已有同名函数冲突，
#       csv 已有等价功能（csv_parse / csv_parse_header），不再迁入。
# ============================================================

# 辅助：全局替换
def csv_replace_all(text, old, new):
    var result = ""
    var i = 0
    while i < len(text):
        if i + len(old) <= len(text) and text[i : i + len(old)] == old:
            result = result + new
            i = i + len(old)
        else:
            result = result + text[i]
            i += 1
    return result

# 转义字段
def csv_escape_field(field, delimiter = ",", quote = "\""):
    var needs_quote = false
    if field.contains(delimiter) or field.contains(quote) or field.contains("\n") or field.contains("\r"):
        needs_quote = true
    if needs_quote:
        var escaped = csv_replace_all(field, quote, quote + quote)
        return quote + escaped + quote
    return field

# 反转义字段
def csv_unescape_field(field, quote = "\""):
    if len(field) >= 2 and field[0] == quote and field[len(field) - 1] == quote:
        var inner = field[1 : len(field) - 1]
        return csv_replace_all(inner, quote + quote, quote)
    return field

# 构建 CSV 文本（csvutil 风格，支持自定义分隔符/引号）
def csv_build(rows, delimiter = ",", quote = "\""):
    var result = ""
    var i = 0
    while i < len(rows):
        var row = rows[i]
        var j = 0
        while j < len(row):
            result = result + csv_escape_field(str(row[j]), delimiter, quote)
            if j < len(row) - 1:
                result = result + delimiter
            j += 1
        result = result + "\n"
        i += 1
    return result

# 构建带表头 CSV（csvutil 风格，dict 行）
def csv_build_header(rows, headers):
    var all_rows = [headers]
    var i = 0
    while i < len(rows):
        var row = []
        var j = 0
        while j < len(headers):
            if rows[i].contains(headers[j]):
                row.append(rows[i][headers[j]])
            else:
                row.append("")
            j += 1
        all_rows.append(row)
        i += 1
    return csv_build(all_rows)

# 按列过滤（dict 行，列名+值）
def csv_filter(rows, column, value):
    var result = []
    var i = 0
    while i < len(rows):
        if rows[i].contains(column) and rows[i][column] == value:
            result.append(rows[i])
        i += 1
    return result

# 按列排序（冒泡，dict 行）
def csv_sort(rows, column, ascending = true):
    var result = []
    var i = 0
    while i < len(rows):
        result.append(rows[i])
        i += 1
    i = 0
    while i < len(result):
        var j = 0
        while j < len(result) - i - 1:
            var swapped = false
            if result[j].contains(column) and result[j + 1].contains(column):
                if ascending:
                    if result[j][column] > result[j + 1][column]:
                        var tmp = result[j]
                        result[j] = result[j + 1]
                        result[j + 1] = tmp
                        swapped = true
                else:
                    if result[j][column] < result[j + 1][column]:
                        var tmp = result[j]
                        result[j] = result[j + 1]
                        result[j + 1] = tmp
                        swapped = true
            j += 1
        i += 1
    return result

# 提取单列（dict 行）
def csv_column(rows, column):
    var result = []
    var i = 0
    while i < len(rows):
        if rows[i].contains(column):
            result.append(rows[i][column])
        i += 1
    return result

# 去重（按指定列）
def csv_unique(rows, column):
    var seen = {}
    var result = []
    var i = 0
    while i < len(rows):
        if rows[i].contains(column):
            var val = rows[i][column]
            if not seen.contains(val):
                seen[val] = true
                result.append(rows[i])
        else:
            result.append(rows[i])
        i += 1
    return result
