# ============================================================
# 普贤生态库：registry/pwgen —— 口令生成器
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态；随机源 = 原生 random + os_random_hex 混合），双模式一致。
# 对齐 Python secrets / go-password-generator 心智（0.1.0）：
#   pw_generate(opts={}) → Ok(str) | Err
# opts: {len(默认 16), lower, upper, digits, symbols(默认均 true),
#        ensure_each(默认 true)：四类各至少一个}
#   pw_pool(opts) → str（参与抽样的字符池）
#   pw_entropy(pw, classes) → float（log2(池大小^长度)）
# 说明：非密码学用途请叠加 os_random_hex 熵源（0.1.0 用 random()，足够口令演示）。
# ============================================================

const PW_LOWER = "abcdefghijklmnopqrstuvwxyz"
const PW_UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
const PW_DIGITS = "0123456789"
const PW_SYMBOLS = "!@#$%^&*()-_=+[]{};:,.<>?"

def pw_has(opts, key):
    return not opts.has(key) or opts[key]

def pw_classes(opts):
    var cs = []
    if pw_has(opts, "lower"):
        cs.append(PW_LOWER)
    if pw_has(opts, "upper"):
        cs.append(PW_UPPER)
    if pw_has(opts, "digits"):
        cs.append(PW_DIGITS)
    if pw_has(opts, "symbols"):
        cs.append(PW_SYMBOLS)
    return cs

def pw_pool(opts):
    var pool = ""
    var cs = pw_classes(opts)
    var i = 0
    while i < len(cs):
        pool = pool + cs[i]
        i += 1
    return pool

def pw_one(s):
    return s[int(random() * float(len(s)))]

def pw_generate(opts={}):
    var n = 16
    if opts.has("len"):
        n = opts["len"]
    if n <= 0:
        return Err("pwgen: 长度须 > 0")
    var cs = pw_classes(opts)
    if len(cs) == 0:
        return Err("pwgen: 至少选一类字符")
    var pool = pw_pool(opts)
    var ensure = true
    if opts.has("ensure_each"):
        ensure = opts["ensure_each"]
    var chars = []
    if ensure:
        var k = 0
        while k < len(cs):
            chars.append(pw_one(cs[k]))
            k += 1
    while len(chars) < n:
        chars.append(pw_one(pool))
    # 洗牌（重建法，避免依赖列表赋值）
    var positions = []
    var i = 0
    while i < len(chars):
        positions.append(i)
        i += 1
    var out = ""
    while len(positions) > 0:
        var idx = int(random() * float(len(positions)))
        out = out + chars[positions[idx]]
        positions = positions[0:idx] + positions[idx + 1:len(positions)]
    return Ok(out)

# 熵估计：log2(池大小) × 长度
def pw_entropy(pw, opts={}):
    var pool = pw_pool(opts)
    if pool == "":
        return Err("pwgen: 空字符池")
    return Ok(float(len(pw)) * log(float(len(pool))) / log(2.0))
# ============================================================
# 0.2.0 新增：generate_pin / generate_passphrase / check_rules
# ============================================================

# 生成纯数字 PIN → str
def pw_generate_pin(length=4):
    var out = ""
    var i = 0
    while i < length:
        out = out + str(int(random() * 10.0))
        i += 1
    return out

# 生成助记词组（简单词库）→ str
def pw_generate_passphrase(words=4, sep="-"):
    var wordlist = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta",
        "iota", "kappa", "lambda", "mu", "nu", "xi", "omicron", "pi", "rho", "sigma",
        "tau", "upsilon", "phi", "chi", "psi", "omega", "river", "mountain", "ocean",
        "forest", "desert", "meadow", "valley", "canyon", "island", "harbor", "bridge",
        "tower", "castle", "garden", "temple", "palace", "village", "summer", "winter",
        "spring", "autumn", "morning", "evening", "twilight", "sunrise", "sunset", "storm"]
    var out = ""
    var i = 0
    while i < words:
        if i > 0:
            out = out + sep
        out = out + wordlist[int(random() * float(len(wordlist)))]
        i += 1
    return out

# 检查密码规则 → {ok, issues}
def pw_check_rules(pw, opts={}):
    var min_len = 8
    if opts.has("min_len"):
        min_len = opts["min_len"]
    var issues = []
    if len(pw) < min_len:
        issues.append("长度不足 " + str(min_len) + " 位")
    var has_lower = false
    var has_upper = false
    var has_digit = false
    var has_special = false
    var i = 0
    while i < len(pw):
        var c = pw[i]
        if c >= "a" and c <= "z":
            has_lower = true
        elif c >= "A" and c <= "Z":
            has_upper = true
        elif c >= "0" and c <= "9":
            has_digit = true
        else:
            has_special = true
        i += 1
    if not has_lower:
        issues.append("缺少小写字母")
    if not has_upper:
        issues.append("缺少大写字母")
    if not has_digit:
        issues.append("缺少数字")
    if not has_special:
        issues.append("缺少特殊字符")
    return {"ok": len(issues) == 0, "issues": issues}

# 生成并确保满足规则 → str
def pw_generate_strong(length=16):
    var pw = pw_generate({"length": length, "lower": true, "upper": true, "digit": true, "special": true}).unwrap()
    return pw
