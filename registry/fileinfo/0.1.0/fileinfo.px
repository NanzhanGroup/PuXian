# fileinfo.px — 文件信息对象（对应 PHP SplFileInfo）
# 版本: 0.1.0
# 依赖: 无
def _fi_rfind(s, ch):
    var j = s.len() - 1
    while j >= 0 and s[j] != ch:
        j -= 1
    return j
def fi_new(path):
    return {"_path": path}
def fi_get_path(fi):
    return fi["_path"]
def fi_get_filename(fi):
    var path = fi["_path"]
    var sep = _fi_rfind(path, "/")
    if sep >= 0:
        return path[sep + 1:]
    return path
def fi_get_extension(fi):
    var name = fi_get_filename(fi)
    var dot = _fi_rfind(name, ".")
    if dot > 0:
        return name[dot + 1:]
    return ""
def fi_get_basename(fi):
    var name = fi_get_filename(fi)
    var dot = _fi_rfind(name, ".")
    if dot > 0:
        return name[:dot]
    return name
def fi_get_dirname(fi):
    var path = fi["_path"]
    var sep = _fi_rfind(path, "/")
    if sep > 0:
        return path[:sep]
    if sep == 0:
        return "/"
    return "."
def fi_to_string(fi):
    return fi["_path"]

def fi_is_absolute(fi):
    var path = fi["_path"]
    if len(path) > 0 and path[0] == "/":
        return true
    return false
def fi_join(base, sub):
    if len(base) > 0 and base[len(base) - 1] == "/":
        return base + sub
    return base + "/" + sub
def fi_normalize(path):
    var parts = path.split("/")
    var result = []
    var i = 0
    while i < len(parts):
        if parts[i] == "..":
            if len(result) > 0:
                result = result[:len(result) - 1]
        elif parts[i] == "." or parts[i] == "":
            0
        else:
            result.append(parts[i])
        i += 1
    var out = ""
    if len(path) > 0 and path[0] == "/":
        out = "/"
    var j = 0
    while j < len(result):
        if j > 0:
            out = out + "/"
        out = out + result[j]
        j += 1
    return out
