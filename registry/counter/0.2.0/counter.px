# ============================================================
# 普贤生态库：registry/counter —— 计数（collections.Counter 心智）
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态，计数状态以 dict 显式传递），双模式一致。
# 对齐 Python collections.Counter / Go 计数 map 心智（0.1.0）：
#   ct_count(l)           → dict     从 list 计数（元素 → 次数）
#   ct_add(c, v, n=1)     → c        增量（默认 +1，可链式）
#   ct_get(c, v)          → int      次数（无则 0）
#   ct_total(c)           → int      总次数
#   ct_len(c)             → int      不同元素的个数
#   ct_most_common(c)     → [[key, count]...]  按次数降序
#   ct_merge(a, b)        → dict     合并（次数相加）
# 元素类型：string（dict 键限定 str，见 docs/语言缺陷.md 写库限制）。
# ============================================================
def ct_count(l):
    var c = {}
    var i = 0
    while i < len(l):
        var v = l[i]
        if type(v) == "string":
            if c.has(v):
                c.set(v, c[v] + 1)
            else:
                c.set(v, 1)
        i += 1
    return c
def ct_add(c, v, n = 1):
    if n < 0:
        return Err("counter: n 须 >= 0")
    var cur = 0
    if c.has(v):
        cur = c[v]
    c.set(v, cur + n)
    return c
def ct_get(c, v):
    if c.has(v):
        return c[v]
    return 0
def ct_total(c):
    var ks = c.keys()
    var sum = 0
    var i = 0
    while i < len(ks):
        sum = sum + c[ks[i]]
        i += 1
    return sum
def ct_len(c):
    return len(c)
# 按次数降序；同次数顺序不保证（0.1.0 用天然排序反转）
def ct_most_common(c):
    var items = []
    var ks = c.keys()
    var i = 0
    while i < len(ks):
        items.append([c[ks[i]], ks[i]])
        i += 1
    var s = sorted(items)
    s.reverse()
    var out = []
    var j = 0
    while j < len(s):
        out.append([s[j][1], s[j][0]])
        j += 1
    return out
def ct_merge(a, b):
    var r = {}
    var ks = a.keys()
    var i = 0
    while i < len(ks):
        r.set(ks[i], a[ks[i]])
        i += 1
    var kb = b.keys()
    var j = 0
    while j < len(kb):
        var k = kb[j]
        var cur = 0
        if r.has(k):
            cur = r[k]
        r.set(k, cur + b[k])
        j += 1
    return r
# ============================================================
# 0.2.0 新增函数
# ============================================================
# 减法：a - b（次数相减，下限 0）
def ct_subtract(a, b):
    var r = {}
    var ks = a.keys()
    var i = 0
    while i < len(ks):
        r.set(ks[i], a[ks[i]])
        i += 1
    var kb = b.keys()
    var j = 0
    while j < len(kb):
        var k = kb[j]
        var cur = 0
        if r.has(k):
            cur = r[k]
        var diff = cur - b[k]
        if diff > 0:
            r.set(k, diff)
        elif r.has(k):
            r.remove(k)
        j += 1
    return r
# 交集：min(a[k], b[k])
def ct_intersect(a, b):
    var r = {}
    var ks = a.keys()
    var i = 0
    while i < len(ks):
        var k = ks[i]
        if b.has(k):
            var av = a[k]
            var bv = b[k]
            if av <= bv:
                r.set(k, av)
            else:
                r.set(k, bv)
        i += 1
    return r
# 并集：max(a[k], b[k])
def ct_union(a, b):
    var r = {}
    var ks = a.keys()
    var i = 0
    while i < len(ks):
        r.set(ks[i], a[ks[i]])
        i += 1
    var kb = b.keys()
    var j = 0
    while j < len(kb):
        var k = kb[j]
        var cur = 0
        if r.has(k):
            cur = r[k]
        if b[k] > cur:
            r.set(k, b[k])
        j += 1
    return r
# 取前 N 个最常见
def ct_top_n(c, n):
    var mc = ct_most_common(c)
    var out = []
    var i = 0
    while i < n and i < len(mc):
        out.append(mc[i])
        i += 1
    return out
# 取最少见的 N 个
def ct_least_common(c):
    var mc = ct_most_common(c)
    mc.reverse()
    return mc
# 按次数过滤：返回次数 >= min_count 的键列表
def ct_keys_above(c, min_count):
    var out = []
    var ks = c.keys()
    var i = 0
    while i < len(ks):
        if c[ks[i]] >= min_count:
            out.append(ks[i])
        i += 1
    return out
# 转为频率分布（占比）
def ct_frequencies(c):
    var total = ct_total(c)
    if total == 0:
        return {}
    var r = {}
    var ks = c.keys()
    var i = 0
    while i < len(ks):
        r.set(ks[i], c[ks[i]] / total)
        i += 1
    return r
# 唯一键列表（次数 > 0）
def ct_keys(c):
    return c.keys()
# 从 dict 构建 Counter（直接使用，验证值为正整数）
def ct_from_dict(d):
    var r = {}
    var ks = d.keys()
    var i = 0
    while i < len(ks):
        var v = d[ks[i]]
        if type(v) == "int" and v > 0:
            r.set(ks[i], v)
        i += 1
    return r
