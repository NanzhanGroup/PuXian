# ============================================================
# 普贤生态库：registry/bench —— 微基准计时
# ------------------------------------------------------------
# 纯函数库（IO：now_ns 计时，无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Rust criterion / Python-timeit 心智（0.1.0 最小面）：
#   bn_time(f, n) → Ok({total_ns, ns_per_op, ops_per_sec}) | Err
# n <= 0 → Err；时间源 = now_ns（墙钟纳秒，非 CPU 时间）。解释轨性能远低于
# 编译轨属预期（PX-DEF-024 同族），bench 主要用于编译轨产物对比。
# ============================================================

def bn_time(f, n):
    if n <= 0:
        return Err("bench: n 须 > 0")
    var t0 = now_ns()
    var i = 0
    while i < n:
        f()
        i += 1
    var t1 = now_ns()
    var total = t1 - t0
    if total < 0:
        total = 0
    var per = total // n
    var ops = 0.0
    if total > 0:
        ops = float(n) * 1000000000.0 / float(total)
    return Ok({"total_ns": total, "ns_per_op": per, "ops_per_sec": ops})
# ============================================================
# 0.2.0 新增：time_ms / compare / stats / bench_async
# ============================================================

# 毫秒级计时 → float
def bn_time_ms(f, n):
    var start = now_ns()
    var i = 0
    while i < n:
        f()
        i += 1
    var elapsed = now_ns() - start
    return float(elapsed) / 1000000.0

# 对比两个函数性能 → {name_a, name_b, ms_a, ms_b, ratio}
def bn_compare(fa, fb, n, name_a="a", name_b="b"):
    var ms_a = bn_time_ms(fa, n)
    var ms_b = bn_time_ms(fb, n)
    var ratio = ms_a / ms_b
    return {"name_a": name_a, "name_b": name_b, "ms_a": ms_a, "ms_b": ms_b, "ratio": ratio}

# 统计多次运行 → {min, max, avg, total}
def bn_stats(f, n, runs=5):
    var times = []
    var i = 0
    while i < runs:
        times.append(bn_time_ms(f, n))
        i += 1
    var mn = times[0]
    var mx = times[0]
    var total = 0.0
    var j = 0
    while j < len(times):
        if times[j] < mn:
            mn = times[j]
        if times[j] > mx:
            mx = times[j]
        total = total + times[j]
        j += 1
    return {"min": mn, "max": mx, "avg": total / float(runs), "total": total}

# 格式化时间 → str
def bn_format(ms):
    if ms < 1.0:
        return str(int(ms * 1000.0)) + " μs"
    if ms < 1000.0:
        return str(int(ms)) + " ms"
    return str(ms / 1000.0) + " s"
