import std.yaml
# ============================================================
# 普贤生态库：registry/config —— 配置合并与读取
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Go viper 心智（0.1.0 子集）：
#   cfg_from_yaml(s, defaults?) → Ok(dict) | Err   # 解析 YAML，可与默认值合并
#   cfg_merge(base, overlay)    → dict             # 递归合并（overlay 覆盖 base）
#   cfg_get(d, "a.b.c", default) → 值               # 点路径读取
#   cfg_set(d, "a.b.c", v)                          # 点路径写入（原地改 dict）
#   cfg_apply_env(d, "APP")     → dict             # 环境变量 APP_<KEY> 覆盖
# 说明：env 值均为字符串；cfg_apply_env 对 "true/false"、"整数"、"浮点"
#   做自动类型转换。
# ============================================================
# 深度合并：overlay 的 dict 键递归合并，非 dict 值直接覆盖。
def cfg_merge(base, overlay):
    var out = {}
    var bk = base.keys()
    var i = 0
    while i < len(bk):
        out.set(bk[i], base[bk[i]])
        i += 1
    var ok = overlay.keys()
    var j = 0
    while j < len(ok):
        var k = ok[j]
        var ov = overlay[k]
        if type(ov) == "dict" and out.has(k) and type(out[k]) == "dict":
            out.set(k, cfg_merge(out[k], ov))
        else:
            out.set(k, ov)
        j += 1
    return out
# 解析 YAML 文本 → Ok(dict) | Err（底层 std.yaml；非 dict 顶层返回 Err）
def cfg_from_yaml(s, defaults = null):
    var r = yaml_parse(s)
    if not r["ok"]:
        return Err("config: YAML 解析失败: " + str(r["error"]))
    var v = r["value"]
    if type(v) != "dict":
        return Err("config: YAML 顶层必须是映射")
    if defaults != null:
        return Ok(cfg_merge(defaults, v))
    return Ok(v)
# 按点路径读取：cfg_get(d, "a.b.c", 默认值)
def cfg_get(d, path, default = null):
    var parts = split(path, ".")
    var cur = d
    var i = 0
    while i < len(parts):
        var k = parts[i]
        if type(cur) == "dict" and cur.has(k):
            cur = cur[k]
        else:
            return default
        i += 1
    return cur
# 按点路径写入（原地修改 d；中间 dict 不存在则创建）
def cfg_set(d, path, v):
    var parts = split(path, ".")
    var cur = d
    var i = 0
    while i < len(parts) - 1:
        var k = parts[i]
        if not cur.has(k) or type(cur[k]) != "dict":
            cur.set(k, {})
        cur = cur[k]
        i += 1
    cur.set(parts[len(parts) - 1], v)
# 环境变量字符串 → 自动类型
def cfg_cast_env(s):
    if s == "true":
        return true
    if s == "false":
        return false
    # 整数
    if s != "" and s[0] >= "0" and s[0] <= "9" or (starts_with(s, "-") and len(s) > 1):
        var all_num = true
        var i = 0
        while i < len(s):
            var c = s[i]
            if not ((c >= "0" and c <= "9") or c == "-" or c == "."):
                all_num = false
            i += 1
        if all_num:
            if contains(s, "."):
                return float(s)
            return int(s)
    return s
# 用环境变量 <prefix>_<KEY> 覆盖 dict 顶层键（KEY 大写、- 转 _）。
# 例如 prefix=APP：环境变量 APP_PORT 覆盖 d["port"]。
def cfg_apply_env(d, prefix):
    var out = {}
    var keys = d.keys()
    var i = 0
    while i < len(keys):
        out.set(keys[i], d[keys[i]])
        i += 1
    var ek = out.keys()
    var j = 0
    while j < len(ek):
        var k = ek[j]
        var envname = prefix + "_" + to_upper(k)
        envname = replace(envname, "-", "_")
        var ev = env(envname)
        if ev != null:
            out.set(k, cfg_cast_env(ev))
        j += 1
    return out
# ============================================================
# 0.2.0 新增函数
# ============================================================
# 从 JSON 文本加载配置
def cfg_from_json(s, defaults = null):
    var r = json_parse(s)
    if r == null:
        return Err("config: JSON 解析失败")
    if type(r) != "dict":
        return Err("config: JSON 顶层必须是对象")
    if defaults != null:
        return Ok(cfg_merge(defaults, r))
    return Ok(r)
# 序列化配置为 JSON
def cfg_to_json(d):
    return json_stringify(d)
# 校验必填键（点路径列表）；返回缺失路径列表（空 = 全部存在）
def cfg_validate(d, required):
    var missing = []
    var i = 0
    while i < len(required):
        var path = required[i]
        var val = cfg_get(d, path, null)
        if val == null:
            missing.append(path)
        i += 1
    return missing
# 递归 env 覆盖：遍历所有叶子键，PREFIX_KEY_PATH 覆盖
# 例如 prefix=APP, d={"db": {"host": "x"}} → APP_DB_HOST 覆盖
def cfg_apply_env_recursive(d, prefix):
    return cfg_env_recurse(d, prefix, "")
def cfg_env_recurse(d, prefix, path_prefix):
    var out = {}
    var keys = d.keys()
    var i = 0
    while i < len(keys):
        var k = keys[i]
        var v = d[k]
        var env_path = ""
        if len(path_prefix) > 0:
            env_path = path_prefix + "_" + k
        else:
            env_path = k
        var envname = prefix + "_" + to_upper(env_path)
        envname = replace(envname, "-", "_")
        if type(v) == "dict":
            out.set(k, cfg_env_recurse(v, prefix, env_path))
        else:
            var ev = env(envname)
            if ev != null:
                out.set(k, cfg_cast_env(ev))
            else:
                out.set(k, v)
        i += 1
    return out
# 按点路径批量读取 → dict
def cfg_get_all(d, paths):
    var out = {}
    var i = 0
    while i < len(paths):
        var p = paths[i]
        out.set(p, cfg_get(d, p, null))
        i += 1
    return out
# 深拷贝配置（避免共享引用）
def cfg_clone(d):
    if type(d) != "dict":
        return d
    var out = {}
    var keys = d.keys()
    var i = 0
    while i < len(keys):
        var k = keys[i]
        var v = d[k]
        if type(v) == "dict":
            out.set(k, cfg_clone(v))
        elif type(v) == "list":
            var new_list = []
            var j = 0
            while j < len(v):
                if type(v[j]) == "dict":
                    new_list.append(cfg_clone(v[j]))
                else:
                    new_list.append(v[j])
                j += 1
            out.set(k, new_list)
        else:
            out.set(k, v)
        i += 1
    return out
# 扁平化嵌套 dict → {"a.b.c": v} 形式
def cfg_flatten(d, prefix = ""):
    var out = {}
    var keys = d.keys()
    var i = 0
    while i < len(keys):
        var k = keys[i]
        var v = d[k]
        var path = ""
        if len(prefix) > 0:
            path = prefix + "." + k
        else:
            path = k
        if type(v) == "dict":
            var sub = cfg_flatten(v, path)
            var sk = sub.keys()
            var j = 0
            while j < len(sk):
                out.set(sk[j], sub[sk[j]])
                j += 1
        else:
            out.set(path, v)
        i += 1
    return out
