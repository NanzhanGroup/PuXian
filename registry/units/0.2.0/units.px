# ============================================================
# 普贤生态库：registry/units —— 常用单位换算
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Python pint / Rust uom 心智（0.1.0 子集）：
#   un_convert(value, from, to) → Ok(float) | Err
# 类别（base 因子）：长度 m（km/cm/mm/in/ft/yd/mi）、质量 kg（g/mg/t/lb/oz）、
#   时间 s（min/h/day/week/ms）、数据量 B（KB/MB/GB/TB，1024 进制）；
#   温度 C/F/K 独立公式；跨类/未知单位 Err。
# 单位名大小写不敏感。
# ============================================================

def un_clean(u):
    return to_lower(u)

# → [类别, 相对 base 因子]；未知 → [null, 0]
def un_info(u):
    var t = un_clean(u)
    if t == "m":
        return ["length", 1.0]
    if t == "km":
        return ["length", 1000.0]
    if t == "cm":
        return ["length", 0.01]
    if t == "mm":
        return ["length", 0.001]
    if t == "in":
        return ["length", 0.0254]
    if t == "ft":
        return ["length", 0.3048]
    if t == "yd":
        return ["length", 0.9144]
    if t == "mi":
        return ["length", 1609.344]
    if t == "kg":
        return ["mass", 1.0]
    if t == "g":
        return ["mass", 0.001]
    if t == "mg":
        return ["mass", 0.000001]
    if t == "t":
        return ["mass", 1000.0]
    if t == "lb":
        return ["mass", 0.45359237]
    if t == "oz":
        return ["mass", 0.028349523125]
    if t == "s":
        return ["time", 1.0]
    if t == "ms":
        return ["time", 0.001]
    if t == "min":
        return ["time", 60.0]
    if t == "h":
        return ["time", 3600.0]
    if t == "day":
        return ["time", 86400.0]
    if t == "week":
        return ["time", 604800.0]
    if t == "b":
        return ["data", 1.0]
    if t == "kb":
        return ["data", 1024.0]
    if t == "mb":
        return ["data", 1048576.0]
    if t == "gb":
        return ["data", 1073741824.0]
    if t == "tb":
        return ["data", 1099511627776.0]
    return [null, 0.0]

def un_is_temp(u):
    var t = un_clean(u)
    return t == "c" or t == "f" or t == "k"

def un_to_c(v, u):
    var t = un_clean(u)
    if t == "c":
        return v
    if t == "k":
        return v - 273.15
    return (v - 32.0) * 5.0 / 9.0

def un_from_c(c, u):
    var t = un_clean(u)
    if t == "c":
        return c
    if t == "k":
        return c + 273.15
    return c * 9.0 / 5.0 + 32.0

def un_convert(value, frm, to):
    if un_is_temp(frm) or un_is_temp(to):
        if not un_is_temp(frm) or not un_is_temp(to):
            return Err("units: 温度只能与温度互转")
        return Ok(un_from_c(un_to_c(value, frm), to))
    var fi = un_info(frm)
    var ti = un_info(to)
    if fi[0] == null:
        return Err("units: 未知单位 " + frm)
    if ti[0] == null:
        return Err("units: 未知单位 " + to)
    if fi[0] != ti[0]:
        return Err("units: 跨类换算 " + fi[0] + " -> " + ti[0])
    return Ok(value * fi[1] / ti[1])
# ============================================================
# 0.2.0 新增：convert_temp / convert_data / convert_speed / list_units
# ============================================================

# 温度转换 → float
def un_convert_temp(value, frm, to):
    var c = 0.0
    # 转摄氏
    if frm == "C" or frm == "celsius":
        c = float(value)
    elif frm == "F" or frm == "fahrenheit":
        c = (float(value) - 32.0) * 5.0 / 9.0
    elif frm == "K" or frm == "kelvin":
        c = float(value) - 273.15
    # 转目标
    if to == "C" or to == "celsius":
        return c
    if to == "F" or to == "fahrenheit":
        return c * 9.0 / 5.0 + 32.0
    if to == "K" or to == "kelvin":
        return c + 273.15
    return c

# 数据大小转换 → float
def un_convert_data(value, frm, to):
    var units = ["B", "KB", "MB", "GB", "TB", "PB"]
    var fi = 0
    var ti = 0
    var i = 0
    while i < len(units):
        if frm == units[i]:
            fi = i
        if to == units[i]:
            ti = i
        i += 1
    var diff = fi - ti
    var result = float(value)
    if diff > 0:
        var j = 0
        while j < diff:
            result = result * 1024.0
            j += 1
    elif diff < 0:
        var j = 0
        while j < -diff:
            result = result / 1024.0
            j += 1
    return result

# 速度转换 → float
def un_convert_speed(value, frm, to):
    # 转米/秒
    var mps = 0.0
    if frm == "m/s":
        mps = float(value)
    elif frm == "km/h":
        mps = float(value) / 3.6
    elif frm == "mph":
        mps = float(value) * 0.44704
    elif frm == "ft/s":
        mps = float(value) * 0.3048
    # 转目标
    if to == "m/s":
        return mps
    if to == "km/h":
        return mps * 3.6
    if to == "mph":
        return mps / 0.44704
    if to == "ft/s":
        return mps / 0.3048
    return mps

# 列出支持的单位 → [str]
def un_list_units():
    return ["length", "weight", "temperature", "data", "speed"]
