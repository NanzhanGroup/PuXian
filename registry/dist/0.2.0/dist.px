# ============================================================
# 普贤生态库：registry/dist —— 随机分布采样
# ------------------------------------------------------------
# 纯函数库（无状态；底层用原生 random() [0,1) 均匀浮点），双模式一致。
# 对齐 Go math/rand / Python random / Rust rand_distr 心智（0.1.0）：
#   di_uniform(a, b)      → float
#   di_normal(mean, sd)   → float（Box-Muller）
#   di_exponential(rate)  → float（-ln(1-u)/rate，rate>0）
#   di_bernoulli(p)       → int（0/1，概率 p）
#   di_poisson(lambda)    → int（Knuth，λ≥0）
#   di_randint(a, b)      → int（闭区间均匀）
# 说明：0.1.0 不做密码学用途（安全随机用 secure_random + 拒绝采样）。
# ============================================================

# 保证 (0,1] 避免 ln(0)
def di_unit():
    var u = random()
    if u == 0.0:
        u = 0.0000000001
    return u

def di_uniform(a, b):
    return a + (b - a) * random()

def di_randint(a, b):
    var span = b - a + 1
    var n = int(random() * float(span))
    return a + n

def di_normal(mean, sd):
    if sd < 0.0:
        return Err("dist: sd 须 >= 0")
    var u1 = di_unit()
    var u2 = random()
    var z = sqrt(-2.0 * log(u1)) * cos(2.0 * 3.141592653589793 * u2)
    return Ok(mean + sd * z)

def di_exponential(rate):
    if rate <= 0.0:
        return Err("dist: rate 须 > 0")
    return Ok(0.0 - log(di_unit()) / rate)

def di_bernoulli(p):
    if p < 0.0 or p > 1.0:
        return Err("dist: p 须在 0..1")
    if random() < p:
        return Ok(1)
    return Ok(0)

def di_poisson(lambda_v):
    if lambda_v < 0.0:
        return Err("dist: lambda 须 >= 0")
    var l = exp(0.0 - lambda_v)
    var k = 0
    var prod = 1.0
    while true:
        prod = prod * di_unit()
        if prod <= l:
            return Ok(k)
        k = k + 1
# ============================================================
# 0.2.0 新增：mean / variance / std / median / percentile
# ============================================================

# erf 近似（Abramowitz-Stegun 7.1.26，最大误差 1.5e-7）
def di_erf(x):
    var p = 0.3275911
    var a1 = 0.254829592
    var a2 = -0.284496736
    var a3 = 1.421413741
    var a4 = -1.453152027
    var a5 = 1.061405429
    var sign = 1.0
    var xx = x
    if x < 0.0:
        sign = -1.0
        xx = 0.0 - x
    var t = 1.0 / (1.0 + p * xx)
    var poly = (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t
    return sign * (1.0 - poly * exp(0.0 - xx * xx))

# 正态分布 CDF → float
def di_normal_cdf(x, mean, sd):
    var z = (float(x) - float(mean)) / float(sd)
    return 0.5 * (1.0 + di_erf(z / 1.41421356))

# 指数分布 CDF → float
def di_exponential_cdf(x, rate):
    if float(x) < 0.0:
        return 0.0
    return 1.0 - exp(-float(rate) * float(x))

# 伯努利分布均值 → float
def di_bernoulli_mean(p):
    return float(p)

# 泊松分布均值 → float
def di_poisson_mean(lambda_v):
    return float(lambda_v)

# 泊松分布方差 → float
def di_poisson_var(lambda_v):
    return float(lambda_v)

# 设置随机种子 → null
# 注：PuXian 无 srand 内建，使用 random_seed() 若可用，否则为 no-op
def di_seed(s):
    random_seed(s)

# 从列表中随机选择 → any
def di_choice(items):
    if len(items) == 0:
        return Err("dist: 空列表")
    return Ok(items[int(random() * float(len(items)))])

# 打乱列表 → [any]
def di_shuffle(items):
    var out = items
    var i = len(out) - 1
    while i > 0:
        var j = int(random() * float(i + 1))
        var tmp = out[i]
        out[i] = out[j]
        out[j] = tmp
        i -= 1
    return out
