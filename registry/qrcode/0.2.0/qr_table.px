# ============================================================
# 普贤生态库：registry/qrcode —— QR 码生成（内部表）
# ------------------------------------------------------------
# 内部模块（被 qrcode.px / qr_core.px import）。
# 容量/块结构取自 ISO/IEC 18004 表 9（与 Python segno 1.6.6 同源，防手误）：
#   每项 "ec" 为分组串 "nblocks,total,data[,...]"（多组用逗号续接）：
#     nblocks: 该组块数；total: 每块总码字（数据+纠错）；data: 每块数据码字
#   支持版本 1..10（21..53 模块）；纠错级 L/M/Q/H：
#     L≈7%  M≈15%  Q≈25%  H≈30%
# ============================================================
const QR_ECC = {
    "v1": {"L": "1,26,19", "M": "1,26,16", "Q": "1,26,13", "H": "1,26,9"},
    "v2": {"L": "1,44,34", "M": "1,44,28", "Q": "1,44,22", "H": "1,44,16"},
    "v3": {"L": "1,70,55", "M": "1,70,44", "Q": "2,35,17", "H": "2,35,13"},
    "v4": {"L": "1,100,80", "M": "2,50,32", "Q": "2,50,24", "H": "4,25,9"},
    "v5": {"L": "1,134,108", "M": "2,67,43", "Q": "2,33,15,2,34,16", "H": "2,33,11,2,34,12"},
    "v6": {"L": "2,86,68", "M": "4,43,27", "Q": "4,43,19", "H": "4,43,15"},
    "v7": {"L": "2,98,78", "M": "4,49,31", "Q": "2,32,14,4,33,15", "H": "4,39,13,1,40,14"},
    "v8": {"L": "2,121,97", "M": "2,60,38,2,61,39",
        "Q": "4,40,18,2,41,19", "H": "4,40,14,2,41,15"},
    "v9": {"L": "2,146,116", "M": "3,58,36,2,59,37",
        "Q": "4,36,16,4,37,17", "H": "4,36,12,4,37,13"},
    "v10": {"L": "2,86,68,2,87,69", "M": "4,69,43,1,70,44",
        "Q": "6,43,19,2,44,20", "H": "6,43,15,2,44,16"},
}
# 对齐图案中心坐标（按版本；v1 无）
const QR_ALIGN = {
    "v1": [],
    "v2": [6, 18], "v3": [6, 22], "v4": [6, 26], "v5": [6, 30], "v6": [6, 34],
    "v7": [6, 22, 38], "v8": [6, 24, 42], "v9": [6, 26, 46], "v10": [6, 28, 50],
}
# 纠错级 → 格式信息 2bit 标记
def qr_ec_bits(ec):
    if ec == "L":
        return 1
    if ec == "M":
        return 0
    if ec == "Q":
        return 3
    return 2  # H
# 模块边长
def qr_size(version):
    return 17 + 4 * version
# 解析分组串 → [[nblocks, total, data], ...]
def qr_parse_groups(v, ec):
    var s = QR_ECC["v" + str(v)][ec]
    var nums = s.split(",")
    var out = []
    var i = 0
    while i + 2 < len(nums):
        out.append([int(nums[i]), int(nums[i + 1]), int(nums[i + 2])])
        i = i + 3
    return out
# 数据码字总数（决定容量）
def qr_data_count(v, ec):
    var groups = qr_parse_groups(v, ec)
    var total = 0
    var i = 0
    while i < len(groups):
        total = total + groups[i][0] * groups[i][2]
        i += 1
    return total
# 格式信息 15bit 值表（ISO/IEC 18004，与 segno FORMAT_INFO 同源；已含 BCH+XOR）。
# 偏移：L=8 M=0 H=16 Q=24；取值下标 = 偏移 + 掩码号（0..7）
const QR_FORMAT_INFO = [
    0x5412, 0x5125, 0x5e7c, 0x5b4b, 0x45f9, 0x40ce,
    0x4f97, 0x4aa0, 0x77c4, 0x72f3, 0x7daa, 0x789d,
    0x662f, 0x6318, 0x6c41, 0x6976, 0x1689, 0x13be,
    0x1ce7, 0x19d0, 0x762, 0x255, 0xd0c, 0x83b,
    0x355f, 0x3068, 0x3f31, 0x3a06, 0x24b4, 0x2183,
    0x2eda, 0x2bed,
]
# 版本信息 18bit 值表（v7..v10；与 segno VERSION_INFO 同源）
const QR_VERSION_INFO = [0x7c94, 0x85bc, 0x9a99, 0xa4d3]
def qr_format_code(ec, mask):
    var off = 8
    if ec == "M":
        off = 0
    elif ec == "H":
        off = 16
    elif ec == "Q":
        off = 24
    return QR_FORMAT_INFO[off + mask]
