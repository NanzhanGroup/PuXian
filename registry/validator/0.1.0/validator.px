# ============================================================
# 普贤生态库：registry/validator —— 字段校验
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Go go-playground/validator 心智（0.1.0 子集）：
#   val_validate(data, rules) → Ok(null) | Err("field1: 消息; field2: 消息")
#     rules = {"field": "rule1|rule2|..."}（| 分隔或 [rule1, rule2]）
# 规则：
#   required               非 null 且非空（""/空 list/空 dict 不过）
#   email                  简单邮箱格式
#   min=N / max=N          str 长度、int 数值、list 长度
#   length=A,B             长度区间
#   int_range=A,B          int 数值区间
#   in=a,b,c               值 ∈ 列表
# 单值校验函数也可直接复用：val_required/val_email/val_min/val_max。
# ============================================================

# ---- 单值校验（返回 bool）----

def val_required(v):
    if v == null:
        return false
    var t = type(v)
    if t == "string":
        return len(v) > 0
    if t == "list":
        return len(v) > 0
    if t == "dict":
        return len(v.keys()) > 0
    return true

def val_email(v):
    if type(v) != "string":
        return false
    return regex_match("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", v)

# min/max：语义按类型分派
def val_min(v, n):
    if v == null:
        return false
    var t = type(v)
    if t == "string" or t == "list":
        return len(v) >= n
    if t == "int" or t == "float":
        return v >= n
    return false

def val_max(v, n):
    if v == null:
        return false
    var t = type(v)
    if t == "string" or t == "list":
        return len(v) <= n
    if t == "int" or t == "float":
        return v <= n
    return false

def val_int_range(v, a, b):
    if type(v) != "int":
        return false
    return v >= a and v <= b

# ---- 规则解析 ----

# 分割规则串："required|min=3|in=a,b" → list
def val_split_rules(rs):
    if type(rs) == "list":
        return rs
    return split(rs, "|")

# 校验一个字段的规则 → 错误消息（null 表示全部通过）
def val_check_field(name, value, rules):
    var errs = ""
    var i = 0
    while i < len(rules):
        var rule = rules[i]
        var rn = rule
        var arg = ""
        var eq = tmpl_find_v(rule, "=", 0)
        if eq >= 0:
            rn = rule[0:eq]
            arg = rule[eq + 1:len(rule)]
        var pass_v = true
        var msg = ""
        if rn == "required":
            pass_v = val_required(value)
            msg = "必填"
        elif rn == "email":
            pass_v = val_email(value)
            msg = "邮箱格式错误"
        elif rn == "min":
            pass_v = val_min(value, int(arg))
            msg = "不能小于 " + arg
        elif rn == "max":
            pass_v = val_max(value, int(arg))
            msg = "不能大于 " + arg
        elif rn == "length":
            var ab = split(arg, ",")
            if len(ab) == 2:
                var a = int(ab[0])
                var b = int(ab[1])
                pass_v = len(value) >= a and len(value) <= b
                msg = "长度须在 " + str(a) + "-" + str(b)
        elif rn == "int_range":
            var ab2 = split(arg, ",")
            if len(ab2) == 2:
                pass_v = val_int_range(value, int(ab2[0]), int(ab2[1]))
                msg = "须在 [" + ab2[0] + "," + ab2[1] + "]"
        elif rn == "in":
            var items = split(arg, ",")
            pass_v = false
            var j = 0
            while j < len(items):
                if str(value) == items[j]:
                    pass_v = true
                j += 1
            msg = "须为 " + arg + " 之一"
        else:
            msg = "未知规则 " + rn
            pass_v = false
        if not pass_v:
            if len(errs) > 0:
                errs = errs + "; "
            errs = errs + name + ": " + msg
        i += 1
    if len(errs) == 0:
        return null
    return errs

# 子串查找辅助（无 index_of native）
def tmpl_find_v(s, sub, from_idx):
    if len(sub) == 0:
        return from_idx
    var i = from_idx
    while i <= len(s) - len(sub):
        if s[i:i + len(sub)] == sub:
            return i
        i += 1
    return -1

# ---- 主入口 ----

def val_validate(data, rules):
    var errs = ""
    var fields = rules.keys()
    var i = 0
    while i < len(fields):
        var f = fields[i]
        var value = null
        if data.has(f):
            value = data[f]
        var rs = val_split_rules(rules[f])
        var e = val_check_field(f, value, rs)
        if e != null:
            if len(errs) > 0:
                errs = errs + "; "
            errs = errs + e
        i += 1
    if len(errs) > 0:
        return Err(errs)
    return Ok(null)