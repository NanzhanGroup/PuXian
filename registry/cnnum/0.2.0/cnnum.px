# ============================================================
# 普贤生态库：registry/cnnum —— 中文数字转换
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
#   cnnum_parse(s)   → Ok(int) | Err    "一万二千三百四十五" → 12345
#   cnnum_format(n)  → Ok(str)         12345 → "一万二千三百四十五"
# 支持范围：0 ~ 99999999（亿内）；"零"用于位间占位。
# 说明：
#   - format 采用自然中文读数（无前导"/"后缀）
#   - parse 容错：严格模式（非法字符 → Err）；数字前允许"一"省略（如 "十二"）
# ============================================================
const CN_DIGIT = "零一二三四五六七八九"
const CN_UNIT = ["千", "百", "十", ""]
# 单字 → 数字（-1 非法）
def cn_digit(c):
    var i = 0
    while i < 10:
        if CN_DIGIT[i] == c:
            return i
        i += 1
    return -1
# 中文 → 整数（支持 亿/万/千/百/十/零）
def cnnum_parse(s):
    var total = 0
    var section = 0
    var number = 0
    var i = 0
    while i < len(s):
        var c = s[i]
        var d = cn_digit(c)
        if d >= 0:
            number = d
            i += 1
            continue
        if c == "零":
            number = 0
            i += 1
            continue
        if c == "十":
            if number == 0:
                number = 1
            section = section + number * 10
            number = 0
            i += 1
            continue
        if c == "百":
            if number == 0:
                number = 1
            section = section + number * 100
            number = 0
            i += 1
            continue
        if c == "千":
            if number == 0:
                number = 1
            section = section + number * 1000
            number = 0
            i += 1
            continue
        if c == "万":
            total = total + (section + number) * 10000
            section = 0
            number = 0
            i += 1
            continue
        if c == "亿":
            return Err("cnnum: 超出 0-99999999 范围")
        return Err("cnnum: 非法字符: " + c)
    total = total + section + number
    if total > 99999999:
        return Err("cnnum: 超出 0-99999999 范围")
    return Ok(total)
# 组内数字（<10000）格式化为中文
def cn_group(n):
    if n == 0:
        return "零"
    var out = ""
    var uni = [1000, 100, 10, 1]
    var uk = 0
    var started = false
    var pending_zero = false
    while uk < 4:
        var base = uni[uk]
        var d = n // base
        n = n % base
        if d > 0:
            if pending_zero and started:
                out = out + "零"
            pending_zero = false
            if base >= 100:
                out = out + CN_DIGIT[d]
                out = out + CN_UNIT[uk]
            elif base == 10:
                if d > 1 or started:
                    out = out + CN_DIGIT[d]
                out = out + CN_UNIT[uk]
            else:
                out = out + CN_DIGIT[d]
            started = true
        else:
            if started:
                pending_zero = true
        uk += 1
    return out
# 整数 → 中文（0 ~ 99999999）
def cnnum_format(n):
    if n < 0 or n > 99999999:
        return Err("cnnum: 超出 0-99999999 范围")
    if n == 0:
        return Ok("零")
    var wan = n // 10000
    var rest = n % 10000
    var out = ""
    if wan > 0:
        out = out + cn_group(wan) + "万"
        if rest > 0 and rest < 1000:
            out = out + "零"
    if rest > 0:
        out = out + cn_group(rest)
    return Ok(out)
# ============================================================
# 金额大写扩展（人民币）：cn_amount_str —— 财务/汇票大写
# ------------------------------------------------------------
# cn_amount_str("1234.56") → Ok("壹仟贰佰叁拾肆元伍角陆分") | Err
#   - 支持 0 ~ 9999999999999 元（万亿级）；负号前缀；最多两位小数。
#   - 零位规则：整数组间零补位；角=0 分>0 → "X元零Y分"；分=0 → 尾加"整"。
#   - 0 → "零元整"；0.05 → "伍分"；3.10 → "叁元壹角整"。
# ============================================================
const CN_BIG = "零壹贰叁肆伍陆柒捌玖"
# int 数字 0..9 → 大写字符
def cn_big_digit(d):
    return CN_BIG[d]
# 小写中文数字串（cn_group 输出 0..9999）→ 大写
def cn_big_text(s):
    var out = ""
    var i = 0
    if len(s) > 0 and s[0] == "十":
        out = "壹拾"
        i = 1
    while i < len(s):
        var c = s[i]
        if c == "十":
            out = out + "拾"
        elif c == "百":
            out = out + "佰"
        elif c == "千":
            out = out + "仟"
        else:
            var dv = cn_digit(c)
            if dv >= 1 and dv <= 9:
                out = out + cn_big_digit(dv)
            else:
                out = out + c
        i += 1
    return out
# 4 位一组（0..9999）→ 大写（复用 cn_group 中文小写再转大写）
def cn_big_group(n):
    if n == 0:
        return ""
    return cn_big_text(cn_group(n))
# 金额字符串 → 大写（0~9999999999999 元；两位小数；支持负号）
def cn_amount_str(s):
    var neg = false
    var t = s
    if len(t) > 0 and t[0] == "-":
        neg = true
        t = t[1:len(t)]
    var parts = split(t, ".")
    if len(parts) > 2:
        return Err("cnnum: 非法金额（多个小数点）")
    var yi = 0
    var int_txt = parts[0]
    if int_txt == "":
        int_txt = "0"
    var ki = 0
    while ki < len(int_txt):
        var oc = ord(int_txt[ki])
        if oc < 48 or oc > 57:
            return Err("cnnum: 非法数字字符: " + int_txt[ki])
        ki += 1
    yi = int(int_txt)
    if yi > 9999999999999:
        return Err("cnnum: 超出万亿级范围")
    var jiao = 0
    var fen = 0
    if len(parts) > 1:
        var frac = parts[1]
        if len(frac) > 2:
            return Err("cnnum: 小数最多两位")
        var jf = 0
        while jf < len(frac):
            var fc = ord(frac[jf])
            if fc < 48 or fc > 57:
                return Err("cnnum: 非法小数位: " + frac[jf])
            jf += 1
        if len(frac) >= 1:
            jiao = int(frac[0])
        if len(frac) >= 2:
            fen = int(frac[1])
    var g3 = yi // 1000000000000
    var g2 = (yi // 100000000) % 10000
    var g1 = (yi // 10000) % 10000
    var g0 = yi % 10000
    var gs = [g3, g2, g1, g0]
    var us = ["万亿", "亿", "万", ""]
    var out = ""
    var prev_zero = false
    var any_nonzero = false
    var k = 0
    while k < 4:
        var g = gs[k]
        if g > 0:
            if prev_zero and any_nonzero:
                out = out + "零"
            out = out + cn_big_group(g) + us[k]
            any_nonzero = true
            prev_zero = false
        else:
            if any_nonzero:
                prev_zero = true
        k += 1
    var head = ""
    if any_nonzero:
        head = out + "元"
    else:
        head = ""
    var tail = ""
    if jiao == 0 and fen == 0:
        if any_nonzero:
            tail = "整"
        else:
            if neg:
                return Ok("负零元整")
            return Ok("零元整")
    elif fen == 0:
        tail = cn_big_digit(jiao) + "角整"
    else:
        if jiao == 0 and any_nonzero:
            tail = "零"
        if jiao > 0:
            tail = tail + cn_big_digit(jiao) + "角"
        tail = tail + cn_big_digit(fen) + "分"
    var res = head + tail
    if neg:
        res = "负" + res
    return Ok(res)
