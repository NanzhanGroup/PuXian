# ============================================================
# 普贤生态库：registry/money —— 金额格式化 / 解析
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Go shopspring/decimal、Python money / babel 心智（0.1.0）：
#   mn_format(amount, currency="CNY") → Ok(str)
#   mn_parse(s, currency="CNY")       → Ok(float) | Err
#   mn_symbol(currency) / mn_decimals(currency)
# 货币：CNY ¥ / USD $ / EUR € / GBP £ / JPY ¥（0 位小数，其余 2 位）。
# 格式化用整数分（cents = round(amount*100)）避免浮点尾数；
# 千分位为自实现字符串分组，不经 int 转换（任意长度安全）。
# ============================================================
def mn_symbol(currency):
    var c = currency
    if c == "CNY":
        return "¥"
    if c == "USD":
        return "$"
    if c == "EUR":
        return "€"
    if c == "GBP":
        return "£"
    if c == "JPY":
        return "¥"
    return c
def mn_decimals(currency):
    if currency == "JPY":
        return 0
    return 2
# 数字串 → 千分位
def mn_digits(s):
    var out = ""
    var cnt = 0
    var i = len(s) - 1
    while i >= 0:
        out = s[i] + out
        cnt += 1
        if cnt % 3 == 0 and i > 0:
            out = "," + out
        i -= 1
    return out
def mn_format(amount, currency = "CNY"):
    var dec = mn_decimals(currency)
    var neg = false
    var v = amount
    if v < 0:
        neg = true
        v = 0 - v
    var out = ""
    if dec == 2:
        var cents = int(v * 100.0 + 0.5)
        var ip = cents // 100
        var fp = cents % 100
        var frac = str(fp)
        if fp < 10:
            frac = "0" + frac
        out = mn_digits(str(ip)) + "." + frac
    else:
        out = mn_digits(str(int(v + 0.5)))
    if neg:
        return Ok("-" + mn_symbol(currency) + out)
    return Ok(mn_symbol(currency) + out)
# 解析：去掉符号/千分位/空白 → float
def mn_parse(s, currency = "CNY"):
    var t = ""
    var i = 0
    while i < len(s):
        var c = s[i]
        if c == "," or c == " " or c == "¥" or c == "$" or c == "€" or c == "£":
            i += 1
            continue
        t = t + c
        i += 1
    if len(t) == 0:
        return Err("money: 空串")
    if is_int_str(t):
        return Ok(float(int(t)))
    if is_float_str(t):
        return Ok(float(t))
    return Err("money: 非法金额: " + s)
# ============================================================
# 0.2.0 新增函数
# ============================================================
# 加法（按货币精度对齐）
def mn_add(a, b, currency = "CNY"):
    var dec = mn_decimals(currency)
    var factor = 100
    if dec == 0:
        factor = 1
    var ca = int(a * float(factor) + 0.5)
    var cb = int(b * float(factor) + 0.5)
    return float(ca + cb) / float(factor)
# 减法
def mn_sub(a, b, currency = "CNY"):
    var dec = mn_decimals(currency)
    var factor = 100
    if dec == 0:
        factor = 1
    var ca = int(a * float(factor) + 0.5)
    var cb = int(b * float(factor) + 0.5)
    return float(ca - cb) / float(factor)
# 乘法（金额 × 数量）
def mn_mul(amount, quantity, currency = "CNY"):
    var dec = mn_decimals(currency)
    var factor = 100
    if dec == 0:
        factor = 1
    var cents = int(amount * float(factor) + 0.5)
    var result = cents * quantity
    return float(result) / float(factor)
# 除法（金额 ÷ 数量）
def mn_div(amount, quantity, currency = "CNY"):
    var dec = mn_decimals(currency)
    var factor = 100
    if dec == 0:
        factor = 1
    var cents = int(amount * float(factor) + 0.5)
    return float(cents) / float(factor) / quantity
# 比较两个金额（返回 -1/0/1）
def mn_compare(a, b, currency = "CNY"):
    var dec = mn_decimals(currency)
    var factor = 100
    if dec == 0:
        factor = 1
    var ca = int(a * float(factor) + 0.5)
    var cb = int(b * float(factor) + 0.5)
    if ca < cb:
        return 0 - 1
    if ca > cb:
        return 1
    return 0
# 等于
def mn_eq(a, b, currency = "CNY"):
    return mn_compare(a, b, currency) == 0
# 大于
def mn_gt(a, b, currency = "CNY"):
    return mn_compare(a, b, currency) > 0
# 小于
def mn_lt(a, b, currency = "CNY"):
    return mn_compare(a, b, currency) < 0
# 均分：将金额均分给 n 人，余数分配给前几人
def mn_split(amount, n, currency = "CNY"):
    if n <= 0:
        return []
    var dec = mn_decimals(currency)
    var factor = 100
    if dec == 0:
        factor = 1
    var total_cents = int(amount * float(factor) + 0.5)
    var base = total_cents // n
    var remainder = total_cents % n
    var results = []
    var i = 0
    while i < n:
        var cents = base
        if i < remainder:
            cents = cents + 1
        results.append(float(cents) / float(factor))
        i += 1
    return results
# 百分比计算：amount × percentage%
def mn_percent(amount, percentage, currency = "CNY"):
    return mn_mul(amount, percentage / 100.0, currency)
# 折扣：原价 × (1 - discount%)
def mn_discount(amount, discount_percent, currency = "CNY"):
    var after = mn_mul(amount, 1.0 - discount_percent / 100.0, currency)
    return after
# 税后：amount × (1 + tax%)
def mn_with_tax(amount, tax_percent, currency = "CNY"):
    return mn_mul(amount, 1.0 + tax_percent / 100.0, currency)
# 货币转换
def mn_convert(amount, rate):
    return amount * rate
# 更多货币符号
def mn_symbol_ext(currency):
    var c = currency
    if c == "CNY":
        return "¥"
    if c == "USD":
        return "$"
    if c == "EUR":
        return "€"
    if c == "GBP":
        return "£"
    if c == "JPY":
        return "¥"
    if c == "KRW":
        return "₩"
    if c == "INR":
        return "₹"
    if c == "RUB":
        return "₽"
    if c == "BRL":
        return "R$"
    if c == "CHF":
        return "Fr"
    if c == "CAD":
        return "C$"
    if c == "AUD":
        return "A$"
    return c
# 更多货币精度
def mn_decimals_ext(currency):
    if currency == "JPY" or currency == "KRW":
        return 0
    return 2
