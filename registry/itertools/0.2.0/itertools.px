# ============================================================
# 普贤生态库：registry/itertools —— 集合组合子
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Python itertools / Rust itertools 心智（0.1.0 子集，结果全部物化为 list）：
#   it_product(lists)                 → [[...]]    笛卡尔积
#   it_permutations(arr, k)           → [[...]]    排列（有序）
#   it_combinations(arr, k)           → [[...]]    组合（无序）
#   it_chain(arrays)                  → [...]     展平
#   it_enumerate(arr)                 → [[idx, item], ...]
#   it_unique(arr)                    → [...]     去重保序
#   it_take(arr, n)                   → Ok([...]) | Err   前 n 个
#   it_drop(arr, n)                   → Ok([...]) | Err   跳过 n 个
#   it_take_while(arr, pred)          → [...]     满足谓词的前缀（pred 返回 bool）
#   it_repeat(x, n)                   → Ok([...]) | Err   x 重复 n 次
#   it_count(start, step, n)          → Ok([...]) | Err   等差序列 n 项
#   it_cycle(arr, n)                  → Ok([...]) | Err   循环取前 n 个
#   it_chunk(arr, n)                  → Ok([...]) | Err   分块（末块可短）
#   it_window(arr, n)                 → Ok([...]) | Err   滑动窗口
#   it_zip_longest(a, b, fill)        → [[...]]    按长者对齐
# 说明：所有结果即时返回 list（PuXian 无惰性生成器语义）；n < 0 一律 Err。
# ============================================================
# ---- 内部工具 ----
def it_append_copy(lst, x):
    var out = []
    var i = 0
    while i < len(lst):
        out.append(lst[i])
        i += 1
    out.append(x)
    return out
def it_dict_copy(d):
    var out = {}
    var keys = d.keys()
    var i = 0
    while i < len(keys):
        out.set(keys[i], d[keys[i]])
        i += 1
    return out
def it_check_n(n):
    if n < 0:
        return Err("itertools: n 不能为负: " + str(n))
    return Ok(n)
# ---- 组合 ----
def it_product(lists):
    var out = []
    if len(lists) == 0:
        out.append([])
        return out
    it_product_rec(lists, 0, [], out)
    return out
def it_product_rec(lists, idx, cur, out):
    if idx >= len(lists):
        out.append(cur)
        return
    var arr = lists[idx]
    var i = 0
    while i < len(arr):
        it_product_rec(lists, idx + 1, it_append_copy(cur, arr[i]), out)
        i += 1
def it_permutations(arr, k):
    var out = []
    it_perm_rec(arr, 0, k, [], {}, out)
    return out
def it_perm_rec(arr, depth, k, cur, used, out):
    if depth == k:
        out.append(cur)
        return
    var i = 0
    while i < len(arr):
        var key = str(i)
        if not used.has(key) or not used[key]:
            var u = it_dict_copy(used)
            u.set(key, true)
            it_perm_rec(arr, depth + 1, k, it_append_copy(cur, arr[i]), u, out)
        i += 1
def it_combinations(arr, k):
    var out = []
    it_comb_rec(arr, 0, k, [], out)
    return out
def it_comb_rec(arr, start, k, cur, out):
    if len(cur) == k:
        out.append(cur)
        return
    var i = start
    while i < len(arr):
        it_comb_rec(arr, i + 1, k, it_append_copy(cur, arr[i]), out)
        i += 1
# ---- 基础变换 ----
def it_chain(arrays):
    var out = []
    var i = 0
    while i < len(arrays):
        var arr = arrays[i]
        var j = 0
        while j < len(arr):
            out.append(arr[j])
            j += 1
        i += 1
    return out
def it_enumerate(arr):
    var out = []
    var i = 0
    while i < len(arr):
        out.append([i, arr[i]])
        i += 1
    return out
def it_unique(arr):
    var out = []
    var seen = {}
    var i = 0
    while i < len(arr):
        var item = arr[i]
        var key = str(item)
        if not seen.has(key) or not seen[key]:
            seen.set(key, true)
            out.append(item)
        i += 1
    return out
def it_take_while(arr, pred):
    var out = []
    var i = 0
    while i < len(arr):
        if pred(arr[i]):
            out.append(arr[i])
        else:
            break
        i += 1
    return out
# ---- 序列（返回 Result） ----
def it_take(arr, n):
    var c = it_check_n(n)
    if c.is_err():
        return Err("itertools: n 不能为负: " + str(n))
    var out = []
    var i = 0
    while i < n and i < len(arr):
        out.append(arr[i])
        i += 1
    return Ok(out)
def it_drop(arr, n):
    var c = it_check_n(n)
    if c.is_err():
        return Err("itertools: n 不能为负: " + str(n))
    var out = []
    var i = n
    while i < len(arr):
        out.append(arr[i])
        i += 1
    return Ok(out)
def it_repeat(x, n):
    var c = it_check_n(n)
    if c.is_err():
        return Err("itertools: n 不能为负: " + str(n))
    var out = []
    var i = 0
    while i < n:
        out.append(x)
        i += 1
    return Ok(out)
def it_count(start, step, n):
    var c = it_check_n(n)
    if c.is_err():
        return Err("itertools: n 不能为负: " + str(n))
    var out = []
    var v = start
    var i = 0
    while i < n:
        out.append(v)
        v = v + step
        i += 1
    return Ok(out)
def it_cycle(arr, n):
    var c = it_check_n(n)
    if c.is_err():
        return Err("itertools: n 不能为负: " + str(n))
    if len(arr) == 0:
        return Ok([])
    var out = []
    var i = 0
    while i < n:
        out.append(arr[i % len(arr)])
        i += 1
    return Ok(out)
def it_chunk(arr, n):
    var c = it_check_n(n)
    if c.is_err():
        return Err("itertools: n 不能为负: " + str(n))
    if n == 0:
        return Err("itertools: n 不能为 0")
    var out = []
    var i = 0
    while i < len(arr):
        var part = []
        var j = 0
        while j < n and i + j < len(arr):
            part.append(arr[i + j])
            j += 1
        out.append(part)
        i = i + n
    return Ok(out)
def it_window(arr, n):
    var c = it_check_n(n)
    if c.is_err():
        return Err("itertools: n 不能为负: " + str(n))
    if n == 0:
        return Err("itertools: n 不能为 0")
    var out = []
    var i = 0
    while i + n <= len(arr):
        var part = []
        var j = 0
        while j < n:
            part.append(arr[i + j])
            j += 1
        out.append(part)
        i += 1
    return Ok(out)
def it_zip_longest(a, b, fill):
    var out = []
    var m = len(a)
    if len(b) > m:
        m = len(b)
    var i = 0
    while i < m:
        var x = fill
        var y = fill
        if i < len(a):
            x = a[i]
        if i < len(b):
            y = b[i]
        out.append([x, y])
        i += 1
    return out
# ============================================================
# 0.2.0 新增函数
# ============================================================
# zip：按短者对齐
def it_zip(a, b):
    var out = []
    var n = len(a)
    if len(b) < n:
        n = len(b)
    var i = 0
    while i < n:
        out.append([a[i], b[i]])
        i += 1
    return out
# zip3：三个列表
def it_zip3(a, b, c):
    var out = []
    var n = len(a)
    if len(b) < n:
        n = len(b)
    if len(c) < n:
        n = len(c)
    var i = 0
    while i < n:
        out.append([a[i], b[i], c[i]])
        i += 1
    return out
# filter：按谓词筛选
def it_filter(arr, pred):
    var out = []
    var i = 0
    while i < len(arr):
        if pred(arr[i]):
            out.append(arr[i])
        i += 1
    return out
# map：函数映射
def it_map(arr, f):
    var out = []
    var i = 0
    while i < len(arr):
        out.append(f(arr[i]))
        i += 1
    return out
# reduce：归约（左折叠）
def it_reduce(arr, f, init):
    var acc = init
    var i = 0
    while i < len(arr):
        acc = f(acc, arr[i])
        i += 1
    return acc
# flat_map：映射后展平
def it_flat_map(arr, f):
    var out = []
    var i = 0
    while i < len(arr):
        var mapped = f(arr[i])
        var j = 0
        while j < len(mapped):
            out.append(mapped[j])
            j += 1
        i += 1
    return out
# group_by：按键函数分组 → dict {key: [items]}
def it_group_by(arr, key_fn):
    var out = {}
    var i = 0
    while i < len(arr):
        var key = str(key_fn(arr[i]))
        if not out.has(key):
            out.set(key, [])
        out[key].append(arr[i])
        i += 1
    return out
# partition：按谓词分两组 → [true_list, false_list]
def it_partition(arr, pred):
    var yes = []
    var no = []
    var i = 0
    while i < len(arr):
        if pred(arr[i]):
            yes.append(arr[i])
        else:
            no.append(arr[i])
        i += 1
    return [yes, no]
# interleave：交错合并两个列表
def it_interleave(a, b):
    var out = []
    var n = len(a)
    if len(b) > n:
        n = len(b)
    var i = 0
    while i < n:
        if i < len(a):
            out.append(a[i])
        if i < len(b):
            out.append(b[i])
        i += 1
    return out
# compact：去除 null 元素
def it_compact(arr):
    var out = []
    var i = 0
    while i < len(arr):
        if arr[i] != null:
            out.append(arr[i])
        i += 1
    return out
# pairwise：相邻元素配对 → [[a0,a1], [a1,a2], ...]
def it_pairwise(arr):
    var out = []
    var i = 0
    while i + 1 < len(arr):
        out.append([arr[i], arr[i + 1]])
        i += 1
    return out
# accumulate：前缀累积 → [a0, a0+a1, a0+a1+a2, ...]
def it_accumulate(arr, f, init):
    var out = []
    var acc = init
    var i = 0
    while i < len(arr):
        acc = f(acc, arr[i])
        out.append(acc)
        i += 1
    return out
# range：等差序列 [start, start+step, ..., <stop)
def it_range(start, stop, step = 1):
    var out = []
    if step > 0:
        var v = start
        while v < stop:
            out.append(v)
            v = v + step
    elif step < 0:
        var v = start
        while v > stop:
            out.append(v)
            v = v + step
    return out
# reverse：反转列表
def it_reverse(arr):
    var out = []
    var i = len(arr) - 1
    while i >= 0:
        out.append(arr[i])
        i = i - 1
    return out
# slice：切片 [start, stop)
def it_slice(arr, start, stop):
    var out = []
    if start < 0:
        start = 0
    if stop > len(arr):
        stop = len(arr)
    var i = start
    while i < stop:
        out.append(arr[i])
        i += 1
    return out
# max_by / min_by：按键函数取极值元素
def it_max_by(arr, key_fn):
    if len(arr) == 0:
        return null
    var best = arr[0]
    var best_key = key_fn(arr[0])
    var i = 1
    while i < len(arr):
        var k = key_fn(arr[i])
        if k > best_key:
            best = arr[i]
            best_key = k
        i += 1
    return best
def it_min_by(arr, key_fn):
    if len(arr) == 0:
        return null
    var best = arr[0]
    var best_key = key_fn(arr[0])
    var i = 1
    while i < len(arr):
        var k = key_fn(arr[i])
        if k < best_key:
            best = arr[i]
            best_key = k
        i += 1
    return best
# sum：求和
def it_sum(arr):
    var s = 0
    var i = 0
    while i < len(arr):
        s = s + arr[i]
        i += 1
    return s
