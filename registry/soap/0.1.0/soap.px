# soap.px — SOAP 协议构造/解析（纯函数）
# 版本: 0.1.0
def soap_build_envelope(body_xml, header_xml):
    var env = "<?xml version=\"1.0\"?>"
    env = env + "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">"
    if header_xml != "":
        env = env + "<soap:Header>" + header_xml + "</soap:Header>"
    env = env + "<soap:Body>" + body_xml + "</soap:Body>"
    env = env + "</soap:Envelope>"
    return env
def soap_build_request(method, params, namespace):
    var body = "<ns:" + method + " xmlns:ns=\"" + namespace + "\">"
    var ks = params.keys()
    var i = 0
    while i < len(ks):
        body = body + "<ns:" + ks[i] + ">" + str(params[ks[i]]) + "</ns:" + ks[i] + ">"
        i += 1
    body = body + "</ns:" + method + ">"
    return soap_build_envelope(body, "")
def _soap_find_body_open(envelope):
    var i = 0
    while i < len(envelope) - 5:
        if envelope[i] == "<" and envelope[i + 1] != "/":
            var j = i + 1
            while j < len(envelope) and envelope[j] != ":" and envelope[j] != "B" and envelope[j] != " " and envelope[j] != ">":
                j += 1
            if j < len(envelope) and envelope[j] == ":" and j + 5 <= len(envelope):
                if envelope[j + 1:j + 5] == "Body":
                    var gt = _soap_find_str(envelope, ">", j + 5)
                    if gt >= 0:
                        return gt + 1
            if j < len(envelope) and envelope[j] == "B" and j + 4 <= len(envelope):
                if envelope[j:j + 4] == "Body":
                    var gt = _soap_find_str(envelope, ">", j + 4)
                    if gt >= 0:
                        return gt + 1
        i += 1
    return -1
def _soap_find_body_close(envelope, after):
    var i = after
    while i < len(envelope) - 7:
        if envelope[i] == "<" and envelope[i + 1] == "/":
            var j = i + 2
            while j < len(envelope) and envelope[j] != ":" and envelope[j] != "B" and envelope[j] != ">":
                j += 1
            if j < len(envelope) and envelope[j] == ":" and j + 5 <= len(envelope):
                if envelope[j + 1:j + 5] == "Body":
                    return i
            if j < len(envelope) and envelope[j] == "B" and j + 4 <= len(envelope):
                if envelope[j:j + 4] == "Body":
                    return i
        i += 1
    return -1
def soap_extract_body(envelope):
    var start = _soap_find_body_open(envelope)
    if start < 0:
        return ""
    var end = _soap_find_body_close(envelope, start)
    if end < 0:
        return ""
    return envelope[start:end]
def soap_extract_fault(envelope):
    var body = soap_extract_body(envelope)
    var fault_start = body.find("<Fault>")
    if fault_start < 0:
        fault_start = body.find(":Fault>")
        if fault_start >= 0:
            fault_start += 7
    if fault_start < 0:
        return null
    if body[fault_start] == ">":
        fault_start += 1
    else:
        fault_start = _soap_find_str(body, ">", fault_start) + 1
    var fault_end = body.find("</Fault>")
    if fault_end < 0:
        fault_end = body.find(":Fault>")
    if fault_end < 0:
        return null
    var fault_xml = body[fault_start:fault_end]
    var result = {}
    var fc = fault_xml.find("<faultcode>")
    if fc >= 0:
        var fc_end = fault_xml.find("</faultcode>")
        result.set("code", fault_xml[fc + 11:fc_end])
    var fs = fault_xml.find("<faultstring>")
    if fs >= 0:
        var fs_end = fault_xml.find("</faultstring>")
        result.set("string", fault_xml[fs + 13:fs_end])
    return result

def _soap_find_str(s, sub, start):
    var i = start
    while i <= len(s) - len(sub):
        var ok = true
        var j = 0
        while j < len(sub):
            if s[i + j] != sub[j]:
                ok = false
            j += 1
        if ok:
            return i
        i += 1
    return -1
