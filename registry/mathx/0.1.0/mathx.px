# mathx.px — 扩展数学函数（PHP Math 扩展：双曲/取模/角度/常数）
# 版本: 0.1.0
# 依赖: 无（用 native math sin/cos/exp）
#
# 函数列表:
#   mx_sinh(x)              → float   # 双曲正弦
#   mx_cosh(x)              → float   # 双曲余弦
#   mx_tanh(x)              → float   # 双曲正切
#   mx_asinh(x)             → float   # 反双曲正弦
#   mx_acosh(x)             → float   # 反双曲余弦
#   mx_atanh(x)             → float   # 反双曲正切
#   mx_fmod(a, b)           → float   # 浮点取模
#   mx_deg2rad(deg)         → float   # 角度→弧度
#   mx_rad2deg(rad)         → float   # 弧度→角度
#   mx_hypot(a, b)          → float   # sqrt(a²+b²)
#   mx_sign(x)              → int     # 符号函数 -1/0/1
#   mx_clamp(x, lo, hi)     → float   # 钳位
#   mx_lerp(a, b, t)        → float   # 线性插值
#   mx_gcd(a, b)            → int     # 最大公约数
#   mx_lcm(a, b)            → int     # 最小公倍数
#   mx_is_prime(n)          → bool    # 质数判定
#   mx_factorial(n)         → int     # 阶乘
#   mx_fibonacci(n)         → int     # 斐波那契

# ---- 数学常数 ----
var MX_PI = 3.14159265358979323846
var MX_E = 2.71828182845904523536
var MX_SQRT2 = 1.41421356237309504880
var MX_SQRT3 = 1.73205080756887729353
var MX_LN2 = 0.69314718055994530942
var MX_LN10 = 2.30258509299404568402
var MX_LOG2E = 1.44269504088896340736
var MX_LOG10E = 0.43429448190325182765
var MX_PI_2 = 1.57079632679489661923
var MX_PI_4 = 0.78539816339744830962
var MX_1_PI = 0.31830988618379067154
var MX_2_PI = 0.63661977236758134308
var MX_EULER = 0.57721566490153286061
var MX_GOLDEN = 1.61803398874989484820

# ---- 双曲函数 ----
def mx_sinh(x):
    return (exp(x) - exp(-x)) / 2.0

def mx_cosh(x):
    return (exp(x) + exp(-x)) / 2.0

def mx_tanh(x):
    var e = exp(2.0 * x)
    return (e - 1.0) / (e + 1.0)

def mx_asinh(x):
    return log(x + sqrt(x * x + 1.0))

def mx_acosh(x):
    return log(x + sqrt(x * x - 1.0))

def mx_atanh(x):
    return log((1.0 + x) / (1.0 - x)) / 2.0

# ---- 浮点取模 ----
def mx_fmod(a, b):
    if b == 0.0:
        return 0.0
    return a - b * int(a / b)

# ---- 角度弧度 ----
def mx_deg2rad(deg):
    return deg * MX_PI / 180.0

def mx_rad2deg(rad):
    return rad * 180.0 / MX_PI

# ---- 勾股 ----
def mx_hypot(a, b):
    return sqrt(a * a + b * b)

# ---- 符号/钳位/插值 ----
def mx_sign(x):
    if x > 0:
        return 1
    if x < 0:
        return -1
    return 0

def mx_clamp(x, lo, hi):
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

def mx_lerp(a, b, t):
    return a + (b - a) * t

# ---- 数论 ----
def mx_gcd(a, b):
    a = abs(a)
    b = abs(b)
    while b != 0:
        var t = b
        b = a % b
        a = t
    return a

def mx_lcm(a, b):
    if a == 0 or b == 0:
        return 0
    return abs(a * b) // mx_gcd(a, b)

def mx_is_prime(n):
    if n < 2:
        return false
    if n < 4:
        return true
    if n % 2 == 0:
        return false
    var i = 3
    while i * i <= n:
        if n % i == 0:
            return false
        i += 2
    return true

def mx_factorial(n):
    if n < 0:
        return 0
    var r = 1
    var i = 2
    while i <= n:
        r = r * i
        i += 1
    return r

def mx_fibonacci(n):
    if n < 0:
        return 0
    if n <= 1:
        return n
    var a = 0
    var b = 1
    var i = 2
    while i <= n:
        var t = a + b
        a = b
        b = t
        i += 1
    return b
