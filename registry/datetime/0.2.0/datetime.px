# ============================================================
# 普贤生态库：registry/datetime 0.2.0 —— 时间运算（增强版）
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Go time / Python datetime / Rust chrono 心智：
#
# 0.1.0 API（全部保留，向后兼容）：
#   dt_now() / dt_now_sec() / dt_parse(s, fmt?) / dt_format(sec, fmt?)
#   dt_add / dt_diff / dt_add_days / dt_days_between
#   dt_weekday(y, m, d) / dt_iso_format(sec) / dt_iso_parse(s) / dt_humane(now, then)
#
# 0.2.0 新增：
#   dt_quarter(y, m)           → 1..4 季度
#   dt_week_of_year(y, m, d)   → 年中周数（ISO 8601 周历）
#   dt_is_leap_year(y)         → 闰年判断
#   dt_days_in_month(y, m)     → 月内天数
#   dt_compare(a_sec, b_sec)   → -1/0/1
#   dt_duration_parse(s)       → Ok(秒数) | Err（"1h30m" / "90s" / "2d" / "1:30:00"）
#   dt_duration_format(sec)    → "1h30m15s" 紧凑格式
#   dt_to_timezone(sec, off_sec) → 指定时区偏移的格式化字符串
#   dt_date_only(sec)          → "YYYY-MM-DD"（UTC）
#   dt_time_only(sec)          → "HH:MM:SS"（UTC）
#   dt_year(sec) / dt_month(sec) / dt_day(sec) / dt_hour(sec) / dt_minute(sec) / dt_second(sec)
# ============================================================
const DT_FMT = "%Y-%m-%d %H:%M:%S"
const DT_DAY = 86400
def dt_now():
    return now()
def dt_now_sec():
    return now_sec()
def dt_parse(s, fmt = DT_FMT):
    return time_parse(s, fmt)
def dt_format(sec, fmt = DT_FMT):
    return time_format(int(sec), fmt)
def dt_add(sec, delta_sec):
    return sec + delta_sec
def dt_diff(a_sec, b_sec):
    return a_sec - b_sec
def dt_add_days(sec, n):
    return sec + n * DT_DAY
def dt_days_between(a_sec, b_sec):
    var diff = b_sec - a_sec
    var days = diff // DT_DAY
    if diff % DT_DAY != 0 and diff < 0:
        days -= 1
    return days
# ---- 0.1.0 加固（保留）----
# 周一=0 的工作日（Zeller 同余）
def dt_weekday(y, m, d):
    var yy = y
    var mm = m
    if mm < 3:
        mm = mm + 12
        yy = yy - 1
    var k = yy % 100
    var j = yy // 100
    var h = (d + 13 * (mm + 1) // 5 + k + k // 4 + j // 4 + 5 * j) % 7
    return (h + 5) % 7
# ISO8601 → Unix 秒
def dt_iso_parse(s):
    var t = s
    var off_sec = 0
    var tidx = t.find("T")
    if tidx < 0:
        t = t + " 00:00:00"
    else:
        var pos = -1
        var sig = 0
        var pi = tidx + 1
        while pi < len(t):
            var c = t[pi]
            if c == "+" or c == "-":
                pos = pi
                if c == "+":
                    sig = 1
                else:
                    sig = -1
            pi += 1
        if pos > 0:
            var zs = t[pos + 1:len(t)]
            var zh = 0
            var zm = 0
            var colon = zs.find(":")
            if colon >= 0:
                zh = int(zs[0:colon])
                zm = int(zs[colon + 1:len(zs)])
            else:
                if len(zs) >= 2:
                    zh = int(zs[0:2])
                if len(zs) >= 4:
                    zm = int(zs[2:4])
            off_sec = sig * (zh * 3600 + zm * 60)
            t = t[0:pos]
        var dot = t.find(".")
        if dot > tidx:
            t = t[0:dot]
        t = t[0:tidx] + " " + t[tidx + 1:len(t)]
    var sec = time_parse(t, "%Y-%m-%d %H:%M:%S")
    if sec == null:
        return Err("datetime: 无法解析 ISO 时间: " + s)
    return Ok(sec - off_sec)
# Unix 秒 → ISO8601
def dt_iso_format(sec):
    return time_format(int(sec), "%Y-%m-%dT%H:%M:%SZ")
# 相对时间（中文）
def dt_humane(now_sec, then_sec):
    var d = now_sec - then_sec
    var ab = d
    if ab < 0:
        ab = 0 - ab
    if ab < 60:
        return "刚刚"
    var n = 0
    var unit = ""
    var suffix = "前"
    if d < 0:
        suffix = "后"
    if ab < 3600:
        n = ab // 60
        unit = "分钟"
    elif ab < 86400:
        n = ab // 3600
        unit = "小时"
    elif ab < 2592000:
        n = ab // 86400
        unit = "天"
    elif ab < 31536000:
        n = ab // 2592000
        unit = "个月"
    else:
        n = ab // 31536000
        unit = "年"
    return str(n) + unit + suffix
# ---- 0.2.0 新增 ----
# 闰年
def dt_is_leap_year(y):
    if y % 400 == 0:
        return true
    if y % 100 == 0:
        return false
    if y % 4 == 0:
        return true
    return false
# 月内天数
def dt_days_in_month(y, m):
    if m == 2:
        if dt_is_leap_year(y):
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11:
        return 30
    return 31
# 季度
def dt_quarter(y, m):
    return (m - 1) // 3 + 1
# 年中周数（ISO 8601 周历）
# 算法：找到该年的第一个周四（ISO 周第 1 周），计算差值
def dt_week_of_year(y, m, d):
    # 该日是该年第几天
    var doy = d
    var mm = 1
    while mm < m:
        doy = doy + dt_days_in_month(y, mm)
        mm += 1
    # 该日是周几（周一=1..周日=7）
    var wd = dt_weekday(y, m, d) + 1
    # ISO 周 = (doy - wd + 10) / 7（整数除法）
    var week = (doy - wd + 10) // 7
    if week < 1:
        # 属于上一年最后一周
        var prev_y = y - 1
        return dt_week_of_year(prev_y, 12, 31)
    if week > 52:
        # 检查是否属于下一年第 1 周
        var wd_jan1 = dt_weekday(y + 1, 1, 1) + 1
        if wd_jan1 <= 4:
            return 1
    return week
# 日期比较 → -1/0/1
def dt_compare(a_sec, b_sec):
    if a_sec < b_sec:
        return -1
    if a_sec > b_sec:
        return 1
    return 0
# duration 解析："1h30m" / "90s" / "2d" / "1:30:00" / "45m30s"
def dt_duration_parse(s):
    if len(s) == 0:
        return Err("datetime: 空 duration")
    # 冒号格式 H:MM:SS 或 M:SS
    if contains(s, ":"):
        var parts = split(s, ":")
        if len(parts) == 2:
            return Ok(int(parts[0]) * 60 + int(parts[1]))
        if len(parts) == 3:
            return Ok(int(parts[0]) * 3600 + int(parts[1]) * 60 + int(parts[2]))
        return Err("datetime: duration 冒号格式错误: " + s)
    # 单位后缀格式
    var total = 0
    var num = ""
    var i = 0
    while i < len(s):
        var c = s[i]
        if (c >= "0" and c <= "9") or c == "-":
            num = num + c
        else:
            # 解析单位
            var unit = c
            if i + 1 < len(s) and s[i + 1] == "s":
                i += 1
            if len(num) == 0:
                return Err("datetime: duration 缺数字: " + s)
            var n = int(num)
            if unit == "d":
                total = total + n * 86400
            elif unit == "h":
                total = total + n * 3600
            elif unit == "m":
                total = total + n * 60
            elif unit == "s":
                total = total + n
            else:
                return Err("datetime: duration 未知单位: " + unit)
            num = ""
        i += 1
    # 末尾纯数字 = 秒
    if len(num) > 0:
        total = total + int(num)
    return Ok(total)
# duration 格式化 → "1h30m15s" 紧凑
def dt_duration_format(sec):
    if sec == 0:
        return "0s"
    var neg = false
    var s = sec
    if s < 0:
        neg = true
        s = 0 - s
    var out = ""
    if s >= 86400:
        var d = s // 86400
        out = out + str(d) + "d"
        s = s % 86400
    if s >= 3600:
        var h = s // 3600
        out = out + str(h) + "h"
        s = s % 3600
    if s >= 60:
        var m = s // 60
        out = out + str(m) + "m"
        s = s % 60
    if s > 0:
        out = out + str(s) + "s"
    if neg:
        return "-" + out
    return out
# 指定时区偏移格式化
def dt_to_timezone(sec, off_sec):
    var adjusted = int(sec) + off_sec
    return time_format(adjusted, "%Y-%m-%d %H:%M:%S")
# 提取日期部分
def dt_date_only(sec):
    return time_format(int(sec), "%Y-%m-%d")
def dt_time_only(sec):
    return time_format(int(sec), "%H:%M:%S")
# 从 Unix 秒提取各字段
def dt_year(sec):
    return int(time_format(int(sec), "%Y"))
def dt_month(sec):
    return int(time_format(int(sec), "%m"))
def dt_day(sec):
    return int(time_format(int(sec), "%d"))
def dt_hour(sec):
    return int(time_format(int(sec), "%H"))
def dt_minute(sec):
    return int(time_format(int(sec), "%M"))
def dt_second(sec):
    return int(time_format(int(sec), "%S"))
# ============================================================
# 从 dateutil 合并的函数（2026-10-06 异名同功能合并）
# 迁入全部 du_ 函数，保留原前缀以兼容旧代码
# dateutil 库已删除，全部功能由 datetime 提供
# 独有功能：du_to_rfc822 / du_to_julian / du_from_julian / du_relative_time /
#           du_day_of_year / du_to_timestamp / du_components / du_day_of_week
# ============================================================

# 辅助：判断闰年（du_ 前缀）
def du_is_leap_year(year):
    if year % 400 == 0:
        return true
    if year % 100 == 0:
        return false
    if year % 4 == 0:
        return true
    return false

# 月天数
def du_days_in_month(year, month):
    var days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if month < 1 or month > 12:
        return 0
    var d = days[month - 1]
    if month == 2 and du_is_leap_year(year):
        d = 29
    return d

# 从时间戳提取年月日时分秒
def du_components(ts):
    var secs = int(ts)
    var days = int(secs / 86400)
    var rem = secs % 86400
    var hour = int(rem / 3600)
    rem = rem % 3600
    var minute = int(rem / 60)
    var second = rem % 60
    var year = 1970
    while true:
        var yd = 365
        if du_is_leap_year(year):
            yd = 366
        if days < yd:
            break
        days = days - yd
        year += 1
    var month = 1
    while month <= 12:
        var md = du_days_in_month(year, month)
        if days < md:
            break
        days = days - md
        month += 1
    var day = days + 1
    return [year, month, day, hour, minute, second]

# 辅助：替换
def du_replace(text, old, new):
    var result = ""
    var i = 0
    while i < len(text):
        if i + len(old) <= len(text) and text[i : i + len(old)] == old:
            result = result + new
            i = i + len(old)
        else:
            result = result + text[i]
            i += 1
    return result

# 辅助：补零2位
def du_pad2(n):
    if n < 10:
        return "0" + str(n)
    return str(n)

# 辅助：补零4位
def du_pad4(n):
    if n < 10:
        return "000" + str(n)
    if n < 100:
        return "00" + str(n)
    if n < 1000:
        return "0" + str(n)
    return str(n)

# 格式化（du_ 风格）
def du_format(ts, fmt):
    var c = du_components(ts)
    var year = c[0]
    var month = c[1]
    var day = c[2]
    var hour = c[3]
    var minute = c[4]
    var second = c[5]
    var result = fmt
    result = du_replace(result, "YYYY", du_pad4(year))
    result = du_replace(result, "YY", du_pad2(year % 100))
    result = du_replace(result, "mm", du_pad2(month))
    result = du_replace(result, "dd", du_pad2(day))
    result = du_replace(result, "HH", du_pad2(hour))
    result = du_replace(result, "MM", du_pad2(minute))
    result = du_replace(result, "SS", du_pad2(second))
    return result

# 当前时间戳
def du_now():
    return time()

# RFC 822 格式
def du_to_rfc822(ts):
    var c = du_components(ts)
    var days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
    var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    var dow = du_day_of_week(c[0], c[1], c[2])
    return days[dow] + ", " + du_pad2(c[2]) + " " + months[c[1] - 1] + " " + du_pad4(c[0]) + " " + du_pad2(c[3]) + ":" + du_pad2(c[4]) + ":" + du_pad2(c[5]) + " GMT"

# ISO 8601 格式
def du_to_iso8601(ts):
    var c = du_components(ts)
    return du_pad4(c[0]) + "-" + du_pad2(c[1]) + "-" + du_pad2(c[2]) + "T" + du_pad2(c[3]) + ":" + du_pad2(c[4]) + ":" + du_pad2(c[5]) + "Z"

# 年月日时分秒 → 时间戳
def du_to_timestamp(year, month, day, hour, minute, second):
    var days = 0
    var y = 1970
    while y < year:
        var yd = 365
        if du_is_leap_year(y):
            yd = 366
        days = days + yd
        y += 1
    var m = 1
    while m < month:
        days = days + du_days_in_month(year, m)
        m += 1
    days = days + day - 1
    return days * 86400 + hour * 3600 + minute * 60 + second

# 从 ISO 8601 解析
def du_from_iso8601(s):
    var year = int(s[0 : 4])
    var month = int(s[5 : 7])
    var day = int(s[8 : 10])
    var hour = 0
    var minute = 0
    var second = 0
    if len(s) >= 19:
        hour = int(s[11 : 13])
        minute = int(s[14 : 16])
        second = int(s[17 : 19])
    return du_to_timestamp(year, month, day, hour, minute, second)

# 加减时间
def du_add_seconds(ts, n):
    return ts + n

def du_add_minutes(ts, n):
    return ts + n * 60

def du_add_hours(ts, n):
    return ts + n * 3600

def du_add_days(ts, n):
    return ts + n * 86400

# 差值
def du_diff(ts1, ts2):
    return ts2 - ts1

def du_diff_days(ts1, ts2):
    return int((ts2 - ts1) / 86400)

# 星期几（0=周日）
def du_day_of_week(year, month, day):
    var y = year
    var m = month
    if m < 3:
        m = m + 12
        y = y - 1
    var k = y % 100
    var j = int(y / 100)
    var h = (day + int(13 * (m + 1) / 5) + k + int(k / 4) + int(j / 4) + 5 * j) % 7
    return int((h + 6) % 7)

# 年中第几天
def du_day_of_year(year, month, day):
    var doy = 0
    var m = 1
    while m < month:
        doy = doy + du_days_in_month(year, m)
        m += 1
    doy = doy + day
    return doy

# 年中第几周
def du_week_of_year(year, month, day):
    var doy = du_day_of_year(year, month, day)
    return int((doy - 1) / 7) + 1

# 儒略日
def du_to_julian(year, month, day):
    var a = int((14 - month) / 12)
    var y = year + 4800 - a
    var m = month + 12 * a - 3
    return day + int((153 * m + 2) / 5) + 365 * y + int(y / 4) - int(y / 100) + int(y / 400) - 32045

# 从儒略日
def du_from_julian(jd):
    var a = jd + 32044
    var b = int((4 * a + 3) / 146097)
    var c = a - int(b * 146097 / 4)
    var d = int((4 * c + 3) / 1461)
    var e = c - int(d * 1461 / 4)
    var m = int((5 * e + 2) / 153)
    var day = e - int((153 * m + 2) / 5) + 1
    var month = m + 3 - 12 * int(m / 10)
    var year = 100 * b + d - 4800 + int(m / 10)
    return [year, month, day]

# 相对时间描述
def du_relative_time(ts):
    var now = du_now()
    var diff = now - ts
    if diff < 0:
        diff = 0 - diff
        if diff < 60:
            return "in " + str(int(diff)) + " seconds"
        if diff < 3600:
            return "in " + str(int(diff / 60)) + " minutes"
        if diff < 86400:
            return "in " + str(int(diff / 3600)) + " hours"
        return "in " + str(int(diff / 86400)) + " days"
    if diff < 60:
        return str(int(diff)) + " seconds ago"
    if diff < 3600:
        return str(int(diff / 60)) + " minutes ago"
    if diff < 86400:
        return str(int(diff / 3600)) + " hours ago"
    return str(int(diff / 86400)) + " days ago"
