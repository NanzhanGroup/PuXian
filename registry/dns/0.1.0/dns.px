# ============================================================
# 普贤生态库：registry/dns —— 轻量 DNS 客户端（UDP，A/AAAA/CNAME/NS/MX/TXT/PTR）
# ------------------------------------------------------------
# 纯函数 + 无状态网络查询（编译 px build 与解释 px run 双模式一致；0.1.0）。
# 对照 Go miekg/dns、Python dnspython 心智：
#   dns_name_encode(name)          → Ok(bytes) | Err   # 域名 → 查询标签（RFC 1035 §3.1）
#   dns_query(server, name[, qtype_str]) → Ok(dict) | Err
#   dns_resolve_a(server, name)    → Ok([ip...]) | Err  # A 记录便捷取 IP 列表
#   dns_qtype_code(name)           → Ok(int) | Err      # "A"→1 ... 未知 Err
# 返回 dict：
#   { status, rcode, answers: [ {name, type, ttl, data} ... ] }
#   status ∈ "noerror" | "nxdomain" | "servfail" | "refused" | "truncated" | "rcode:N" | "error"
# 说明：
#   - 查询 UDP/53（rd=1, qclass=IN）；响应 4096 字节上限；TC 置位 → status="truncated"。
#   - 名字压缩（0xC0 指针）递归/跳转解析，跳转上限 128 防环。
#   - rdata 按类型：A → "1.2.3.4"；AAAA → IPv6 文本；CNAME/NS/PTR → 域名；
#     MX → "10 mail.example.com."；TXT → [多个字符串]。
#   - 服务端不可达/超时由调用方控制（无超时 native；udp_recv 阻塞）。
# ============================================================

# 常用 qtype 名称 → 编码
def dns_qtype_code(qtype_str):
    if qtype_str == "A":
        return Ok(1)
    if qtype_str == "NS":
        return Ok(2)
    if qtype_str == "CNAME":
        return Ok(5)
    if qtype_str == "PTR":
        return Ok(12)
    if qtype_str == "MX":
        return Ok(15)
    if qtype_str == "TXT":
        return Ok(16)
    if qtype_str == "AAAA":
        return Ok(28)
    return Err("dns: 未知 qtype: " + qtype_str)

# 域名 → 查询标签字节（每段 ≤63，总长 ≤255）
def dns_name_encode(name):
    var out = bytes("")
    var parts = split(name, ".")
    var total = 0
    var i = 0
    while i < len(parts):
        var p = parts[i]
        var n = len(p)
        if n == 0 or n > 63:
            return Err("dns: 非法标签长度: " + p)
        total = total + n + 1
        if total > 255:
            return Err("dns: 域名总长超 255")
        out = bytes_concat(out, byte(n), bytes(p))
        i += 1
    return Ok(bytes_concat(out, byte(0)))

# 构造查询报文；tid 16 位事务 ID
def o_make_query(tid, qname, qtype):
    var hdr = bytes_concat(
        int_to_bytes(tid, 2, "big", false),
        int_to_bytes(0x0100, 2, "big", false),   # flags: RD=1
        int_to_bytes(1, 2, "big", false),        # QDCOUNT
        int_to_bytes(0, 2, "big", false),
        int_to_bytes(0, 2, "big", false),
        int_to_bytes(0, 2, "big", false))
    return bytes_concat(hdr, qname, int_to_bytes(qtype, 2, "big", false), int_to_bytes(1, 2, "big", false))

# 读 pkt[off] 单字节
def o_u8(pkt, off):
    return bytes_to_int(bytes_slice(pkt, off, off + 1), "big", false)

def o_u16(pkt, off):
    return bytes_to_int(bytes_slice(pkt, off, off + 2), "big", false)

def o_u32(pkt, off):
    return bytes_to_int(bytes_slice(pkt, off, off + 4), "big", false)

# 解析名字（压缩指针递归/跳转）；返回 Ok([name, name字段结束偏移]) | Err
def o_read_name(pkt, off):
    var labels = []
    var pos = off
    var jumped = false
    var out_off = 0
    var hop = 0
    while hop < 128:
        var b = o_u8(pkt, pos)
        if b == 0:
            if not jumped:
                out_off = pos + 1
            break
        elif b & 0xC0 == 0xC0:
            if not jumped:
                out_off = pos + 2
                jumped = true
            var ptr = ((b & 0x3F) << 8) | o_u8(pkt, pos + 1)
            pos = ptr
        else:
            var ln = b
            if ln > 63:
                return Err("dns: 标签长度非法: " + str(ln))
            labels <- bytes_to_str(bytes_slice(pkt, pos + 1, pos + 1 + ln))
            pos = pos + 1 + ln
        hop += 1
    if hop >= 128:
        return Err("dns: 名字压缩跳转超限")
    if len(labels) == 0:
        return Ok(["", out_off])
    return Ok([join(".", labels), out_off])

# 跳过响应头部后的 question 区，返回 answer 起始偏移
def o_skip_question(pkt):
    var off = 12
    while true:
        var b = o_u8(pkt, off)
        if b == 0:
            off = off + 1
            break
        elif b & 0xC0 == 0xC0:
            off = off + 2
            break
        else:
            off = off + 1 + b
    return off + 4

# 解析 rdata（按类型）
def o_parse_rdata(pkt, off, rdlen, rtype):
    if rtype == 1:   # A
        if rdlen != 4:
            return Ok("")
        return Ok(str(o_u8(pkt, off)) + "." + str(o_u8(pkt, off + 1)) + "." + str(o_u8(pkt, off + 2)) + "." + str(o_u8(pkt, off + 3)))
    if rtype == 28:  # AAAA
        if rdlen != 16:
            return Ok("")
        var groups = []
        var g = 0
        while g < 8:
            groups <- bytes_to_hex(bytes_slice(pkt, off + g * 2, off + g * 2 + 2))
            g += 1
        return Ok(join(":", groups))
    if rtype == 2 or rtype == 5 or rtype == 12:  # NS / CNAME / PTR
        var nm = o_read_name(pkt, off)?
        return Ok(nm[0])
    if rtype == 15:  # MX
        var pref = o_u16(pkt, off)
        var nm = o_read_name(pkt, off + 2)?
        return Ok(str(pref) + " " + nm[0])
    if rtype == 16:  # TXT（可能多段字符串）
        var strs = []
        var p = off
        var end = off + rdlen
        while p < end:
            var ln = o_u8(pkt, p)
            if p + 1 + ln > end:
                return Ok(strs)
            strs <- bytes_to_str(bytes_slice(pkt, p + 1, p + 1 + ln))
            p = p + 1 + ln
        return Ok(strs)
    # 未知类型：hex 原样
    return Ok(bytes_to_hex(bytes_slice(pkt, off, off + rdlen)))

# 解析响应 → dict{status, rcode, answers}
def o_parse_response(pkt):
    if bytes_len(pkt) < 12:
        return Err("dns: 响应过短")
    var flags = o_u16(pkt, 2)
    var rcode = flags & 0x000F
    var tc = flags & 0x0200
    var ancount = o_u16(pkt, 6)
    var status = ""
    if tc != 0:
        status = "truncated"
    elif rcode == 0:
        status = "noerror"
    elif rcode == 2:
        status = "servfail"
    elif rcode == 3:
        status = "nxdomain"
    elif rcode == 5:
        status = "refused"
    else:
        status = "rcode:" + str(rcode)
    var off = o_skip_question(pkt)
    var answers = []
    var i = 0
    while i < ancount:
        var nm = o_read_name(pkt, off)?
        off = nm[1]
        var rtype = o_u16(pkt, off)
        var rclass = o_u16(pkt, off + 2)
        var ttl = o_u32(pkt, off + 4)
        var rdlen = o_u16(pkt, off + 8)
        var rd = o_parse_rdata(pkt, off + 10, rdlen, rtype)
        if rd.is_err():
            return rd
        answers <- {"name": nm[0], "type": rtype, "ttl": ttl, "class": rclass, "data": rd.unwrap()}
        off = off + 10 + rdlen
        i += 1
    return Ok({"status": status, "rcode": rcode, "answers": answers})

# 主查询：server 为 IP 字符串，name 为域名或反解名，qtype_str 默认 "A"
def dns_query(server, name, qtype_str):
    var qtype = dns_qtype_code(qtype_str)?
    var qname = dns_name_encode(name)?
    var tid = now_ms() % 65536
    var pkt = o_make_query(tid, qname, qtype)
    var sock = udp_open(0)
    if sock <= 0:
        return Err("dns: udp_open 失败")
    var sent = udp_send(sock, server, 53, pkt)
    if sent != bytes_len(pkt):
        udp_close(sock)
        return Err("dns: 发送不完整")
    var r = udp_recv(sock, 4096)
    udp_close(sock)
    if r == null:
        return Err("dns: 无响应")
    var resp = r["data"]
    if bytes_len(resp) < 12:
        return Err("dns: 响应过短")
    var rtid = o_u16(resp, 0)
    if rtid != tid:
        return Err("dns: 事务 ID 不匹配")
    return o_parse_response(resp)

# A 记录便捷取 IP 列表（过滤 type==1）
def dns_resolve_a(server, name):
    var d = dns_query(server, name, "A")?
    var out = []
    var i = 0
    while i < len(d["answers"]):
        var a = d["answers"][i]
        if a["type"] == 1:
            out <- a["data"]
        i += 1
    return Ok(out)