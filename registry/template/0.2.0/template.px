# ============================================================
# 普贤生态库：registry/template 0.2.0 —— 轻量模板渲染（增强版）
# ------------------------------------------------------------
# 纯函数库（无 IO、无状态），编译（px build）与解释（px run）双模式一致。
# 对齐 Go text/template 子集心智：
#
# 0.1.0 语法（全部保留，向后兼容）：
#   {{key}} / {{a.b.c}}        变量替换（点路径）
#   {{if key}} ... {{end}}     条件（支持 {{else}}）
#   {{each list as x}} ... {{end}}  循环
#
# 0.2.0 新增：
#   {{if x > 5}} ... {{end}}           比较运算符（> < >= <= == !=）
#   {{each list as x, i}} ... {{end}}  循环索引变量
#   {{key | upper}}                    过滤器管道（upper/lower/trim/len/default/replace）
#   {{with key}} ... {{end}}           作用域绑定（key 为 dict 时内部用其字段）
#   {{with key}} ... {{else}} ... {{end}}  with 的 else 分支（key 为空时）
# ============================================================
# 子串查找
def tmpl_find(s, sub, from_idx):
    if len(sub) == 0:
        return from_idx
    var i = from_idx
    while i <= len(s) - len(sub):
        if s[i:i + len(sub)] == sub:
            return i
        i += 1
    return -1
def tmpl_trim(s):
    return trim(s)
# 从 start 找匹配的 {{end}}，返回其位置
def tmpl_find_end(tpl, start):
    var depth = 0
    var i = start
    while i < len(tpl):
        var o = tmpl_find(tpl, "{{", i)
        if o < 0:
            return -1
        var c = tmpl_find(tpl, "}}", o + 2)
        if c < 0:
            return -1
        var tag = trim(tpl[o + 2:c])
        if starts_with(tag, "if ") or starts_with(tag, "each ") or starts_with(tag, "with "):
            depth += 1
        elif tag == "end":
            if depth == 0:
                return o
            depth -= 1
        i = c + 2
    return -1
# 点路径取值
def tmpl_lookup(data, path):
    var parts = split(path, ".")
    var cur = data
    var i = 0
    while i < len(parts):
        if type(cur) == "dict" and cur.has(parts[i]):
            cur = cur[parts[i]]
        else:
            return null
        i += 1
    return cur
# 真值判断
def tmpl_truthy(v):
    if v == null:
        return false
    if type(v) == "bool":
        return v
    if type(v) == "string":
        return len(v) > 0
    if type(v) == "list":
        return len(v) > 0
    if type(v) == "dict":
        return len(v.keys()) > 0
    return true
# ---- 0.2.0 比较运算 ----
# 解析比较表达式 "x > 5" / "x == 'foo'" / "x != null" / "x" (纯真值)
# 返回 {op, left, right} 或 null（纯路径）
def tmpl_parse_cond(expr):
    var ops = ["==", "!=", ">=", "<=", ">", "<"]
    var i = 0
    while i < len(ops):
        var op = ops[i]
        var oi = tmpl_find(expr, " " + op + " ", 0)
        if oi >= 0:
            var left = trim(expr[0:oi])
            var right = trim(expr[oi + len(op) + 2:len(expr)])
            return {"op": op, "left": left, "right": right}
        i += 1
    return null
# 解析值字面量：'str' / "str" / null / true / false / 数字 / 路径
def tmpl_parse_literal(s, data):
    if s == "null":
        return null
    if s == "true":
        return true
    if s == "false":
        return false
    if len(s) >= 2 and s[0] == "'" and s[len(s) - 1] == "'":
        return s[1:len(s) - 1]
    if len(s) >= 2 and s[0] == "\"" and s[len(s) - 1] == "\"":
        return s[1:len(s) - 1]
    if is_int_str(s):
        return int(s)
    # 否则当作路径
    return tmpl_lookup(data, s)
# 求值比较条件
def tmpl_eval_cond(expr, data):
    var parsed = tmpl_parse_cond(expr)
    if parsed == null:
        return tmpl_truthy(tmpl_lookup(data, expr))
    var lv = tmpl_parse_literal(parsed["left"], data)
    var rv = tmpl_parse_literal(parsed["right"], data)
    var op = parsed["op"]
    if op == "==":
        return lv == rv
    if op == "!=":
        return lv != rv
    if op == ">":
        return lv > rv
    if op == "<":
        return lv < rv
    if op == ">=":
        return lv >= rv
    if op == "<=":
        return lv <= rv
    return false
# ---- 0.2.0 过滤器 ----
def tmpl_filter_upper(v):
    if type(v) == "string":
        return to_upper(v)
    return v
def tmpl_filter_lower(v):
    if type(v) == "string":
        return to_lower(v)
    return v
def tmpl_filter_trim(v):
    if type(v) == "string":
        return trim(v)
    return v
def tmpl_filter_len(v):
    if v == null:
        return 0
    return len(v)
def tmpl_filter_default(v, fallback):
    if v == null or (type(v) == "string" and len(v) == 0):
        return fallback
    return v
def tmpl_filter_replace(v, old, new):
    if type(v) == "string":
        return replace(v, old, new)
    return v
# 应用过滤器管道：value | filter1 | filter2(arg)
def tmpl_apply_filters(v, filter_str, data):
    if filter_str == null or len(filter_str) == 0:
        return v
    var parts = split(filter_str, "|")
    var i = 0
    while i < len(parts):
        var f = trim(parts[i])
        if len(f) == 0:
            i += 1
            continue
        # 解析 filter 名和参数
        var fname = f
        var farg = ""
        var lp = tmpl_find(f, "(", 0)
        if lp >= 0 and ends_with(f, ")"):
            fname = f[0:lp]
            farg = f[lp + 1:len(f) - 1]
        if fname == "upper":
            v = tmpl_filter_upper(v)
        elif fname == "lower":
            v = tmpl_filter_lower(v)
        elif fname == "trim":
            v = tmpl_filter_trim(v)
        elif fname == "len":
            v = tmpl_filter_len(v)
        elif fname == "default":
            var dv = tmpl_parse_literal(farg, data)
            v = tmpl_filter_default(v, dv)
        elif fname == "replace":
            var args = split(farg, ",")
            if len(args) == 2:
                v = tmpl_filter_replace(v, tmpl_parse_literal(trim(args[0]), data), tmpl_parse_literal(trim(args[1]), data))
        i += 1
    return v
# 解析变量标签 "key | filter" → {path, filters}
def tmpl_parse_var(tag):
    var parts = split(tag, "|")
    var path = trim(parts[0])
    var filters = ""
    if len(parts) > 1:
        var i = 1
        while i < len(parts):
            if len(filters) > 0:
                filters = filters + "|"
            filters = filters + trim(parts[i])
            i += 1
    return {"path": path, "filters": filters}
# 渲染文本
def tmpl_render_data(tpl, data):
    var out = ""
    var i = 0
    var n = len(tpl)
    while i < n:
        var o = tmpl_find(tpl, "{{", i)
        if o < 0:
            out = out + tpl[i:n]
            i = n
            continue
        out = out + tpl[i:o]
        var c = tmpl_find(tpl, "}}", o + 2)
        if c < 0:
            return Err("template: 缺少 }}")
        var tag = trim(tpl[o + 2:c])
        var after = c + 2
        if starts_with(tag, "if "):
            var cond_expr = trim(tag[3:len(tag)])
            var e = tmpl_find_end(tpl, after)
            if e < 0:
                return Err("template: if 缺少 end")
            var block = tpl[after:e]
            var else_i = tmpl_find(block, "{{else}}", 0)
            var if_part = block
            var else_part = ""
            if else_i >= 0:
                if_part = block[0:else_i]
                else_part = block[else_i + 8:len(block)]
                if contains(else_part, "{{else}}"):
                    return Err("template: 多个 else")
            var truthy = tmpl_eval_cond(cond_expr, data)
            if truthy:
                var rr = tmpl_render_data(if_part, data)
                if rr.is_err():
                    return rr
                out = out + rr.unwrap()
            else:
                var rr2 = tmpl_render_data(else_part, data)
                if rr2.is_err():
                    return rr2
                out = out + rr2.unwrap()
            var ec = tmpl_find(tpl, "}}", e + 2)
            if ec < 0:
                return Err("template: if end 缺少 }}")
            i = ec + 2
            continue
        if starts_with(tag, "each "):
            var spec = trim(tag[5:len(tag)])
            var as_i = tmpl_find(spec, " as ", 0)
            if as_i < 0:
                return Err("template: each 需 ' as ' 语法")
            var list_path = trim(spec[0:as_i])
            var item_part = trim(spec[as_i + 4:len(spec)])
            # 解析 item_name 和可选 index名 "x, i"
            var item_name = item_part
            var idx_name = ""
            var comma_i = tmpl_find(item_part, ",", 0)
            if comma_i >= 0:
                item_name = trim(item_part[0:comma_i])
                idx_name = trim(item_part[comma_i + 1:len(item_part)])
            var lst = tmpl_lookup(data, list_path)
            var e2 = tmpl_find_end(tpl, after)
            if e2 < 0:
                return Err("template: each 缺少 end")
            var body = tpl[after:e2]
            var k = 0
            if type(lst) == "list":
                while k < len(lst):
                    var scope = {}
                    var sks = data.keys()
                    var si = 0
                    while si < len(sks):
                        scope.set(sks[si], data[sks[si]])
                        si += 1
                    scope.set(item_name, lst[k])
                    if len(idx_name) > 0:
                        scope.set(idx_name, k)
                    var rr3 = tmpl_render_data(body, scope)
                    if rr3.is_err():
                        return rr3
                    out = out + rr3.unwrap()
                    k += 1
            var ec2 = tmpl_find(tpl, "}}", e2 + 2)
            if ec2 < 0:
                return Err("template: each end 缺少 }}")
            i = ec2 + 2
            continue
        if starts_with(tag, "with "):
            var with_path = trim(tag[5:len(tag)])
            var with_val = tmpl_lookup(data, with_path)
            var e3 = tmpl_find_end(tpl, after)
            if e3 < 0:
                return Err("template: with 缺少 end")
            var block3 = tpl[after:e3]
            var else3_i = tmpl_find(block3, "{{else}}", 0)
            var with_part = block3
            var else3_part = ""
            if else3_i >= 0:
                with_part = block3[0:else3_i]
                else3_part = block3[else3_i + 8:len(block3)]
            if tmpl_truthy(with_val):
                var scope3 = {}
                if type(with_val) == "dict":
                    var wks = with_val.keys()
                    var wi = 0
                    while wi < len(wks):
                        scope3.set(wks[wi], with_val[wks[wi]])
                        wi += 1
                var rr4 = tmpl_render_data(with_part, scope3)
                if rr4.is_err():
                    return rr4
                out = out + rr4.unwrap()
            else:
                var rr5 = tmpl_render_data(else3_part, data)
                if rr5.is_err():
                    return rr5
                out = out + rr5.unwrap()
            var ec3 = tmpl_find(tpl, "}}", e3 + 2)
            if ec3 < 0:
                return Err("template: with end 缺少 }}")
            i = ec3 + 2
            continue
        if tag == "end":
            return Err("template: 多余的 end")
        if tag == "else":
            return Err("template: 多余的 else")
        # 变量替换（含过滤器管道）
        var pv = tmpl_parse_var(tag)
        var raw_v = tmpl_lookup(data, pv["path"])
        var fv = tmpl_apply_filters(raw_v, pv["filters"], data)
        if fv != null:
            out = out + str(fv)
        i = after
    return Ok(out)
# 公开入口
def tmpl_render(tpl, data):
    return tmpl_render_data(tpl, data)
