# ============================================================
# 普贤生态库：registry/eventloop — 事件循环（同步模拟，0.2.0）
# ------------------------------------------------------------
# 纯函数库，双模式一致。
#
# 0.1.0 的问题：
#   1) el_add_timer(loop, fn, delay) 没有 arg 形参，定时器回调收到的永远是 null；
#      同一个回调既当 task 又当 timer 用时，得在函数里猜参数从哪来。
#   2) el_tick() 期间新加的任务会丢：它在遍历后把 loop["_tasks"] 整体替换成
#      remaining，而在回调里 append 进原列表的任务不在 remaining 里 —— 静默丢失。
#
# 0.2.0 的改法：
#   - el_add_timer(loop, fn, delay, arg = null)：arg 可传，旧调用（三参）行为不变。
#   - el_add_repeat(loop, fn, interval, arg = null)：周期定时器，每次触发后自动重挂。
#   - el_tick() 保留「快照期间新加的任务」，不再丢。
#   - 新增 el_clear(loop) / el_tasks(loop) / el_tick_count(loop)。
#
# 函数：
#   el_new() / el_clear(loop) / el_tasks(loop) / el_tick_count(loop)
#   el_add_task(loop, fn, arg)              → task id
#   el_add_timer(loop, fn, delay, arg = null) → task id
#   el_add_repeat(loop, fn, interval, arg = null) → task id
#   el_cancel(loop, task_id) → bool
#   el_tick(loop) → int（本轮处理的事件数）
#   el_run(loop)  → int（累计处理数）
#   el_pending_count(loop) → int
# ============================================================

def el_new():
    return {"_tasks": [], "_next_id": 1, "_tick": 0}

def el_clear(loop):
    loop["_tasks"] = []
    loop["_tick"] = 0
    return loop

def el_tasks(loop):
    return loop["_tasks"]

def el_tick_count(loop):
    return loop["_tick"]

def _el_add(loop, callback, arg, delay, repeat, interval):
    var task_id = loop["_next_id"]
    loop["_next_id"] = task_id + 1
    var task = {"id": task_id, "fn": callback, "arg": arg, "delay": delay, "cancelled": false, "repeat": repeat, "interval": interval}
    loop["_tasks"].append(task)
    return task_id

def el_add_task(loop, callback, arg = null):
    return _el_add(loop, callback, arg, 0, false, 0)

# 0.2.0：arg 变成可选第四参，旧的三参调用行为不变
def el_add_timer(loop, callback, delay, arg = null):
    return _el_add(loop, callback, arg, delay, false, 0)

def el_add_repeat(loop, callback, interval, arg = null):
    return _el_add(loop, callback, arg, interval, true, interval)

def el_cancel(loop, task_id):
    var tasks = loop["_tasks"]
    var i = 0
    while i < len(tasks):
        if tasks[i]["id"] == task_id:
            tasks[i]["cancelled"] = true
            return true
        i += 1
    return false

def el_tick(loop):
    var tasks = loop["_tasks"]
    var snapshot = len(tasks)
    var remaining = []
    var processed = 0
    var i = 0
    while i < snapshot:
        var task = tasks[i]
        if task["cancelled"]:
            i += 1
        elif task.has("delay") and task["delay"] > 0:
            task["delay"] = task["delay"] - 1
            remaining.append(task)
            i += 1
        else:
            # 先快照回调与参数：回调里可能改动任务表
            var cb = task["fn"]
            var carg = task["arg"]
            cb(carg)
            processed += 1
            if task.has("repeat") and task["repeat"]:
                task["delay"] = task["interval"]
                remaining.append(task)
            i += 1
    # 快照之后新加的任务（回调里 append 的）不能被丢掉
    var fresh = []
    var j = snapshot
    while j < len(tasks):
        fresh.append(tasks[j])
        j += 1
    loop["_tasks"] = remaining
    j = 0
    while j < len(fresh):
        loop["_tasks"].append(fresh[j])
        j += 1
    loop["_tick"] = loop["_tick"] + 1
    return processed

def el_run(loop):
    var total = 0
    var guard = 0
    while el_pending_count(loop) > 0 and guard < 10000:
        total += el_tick(loop)
        guard += 1
    return total

def el_pending_count(loop):
    var cnt = 0
    var tasks = loop["_tasks"]
    var i = 0
    while i < len(tasks):
        if not tasks[i]["cancelled"]:
            cnt += 1
        i += 1
    return cnt
