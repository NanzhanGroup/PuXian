# ============================================================
# tools/pxlint.px —— PuXian 静态检查器 CLI（自举版，px lint 等价物）
# ------------------------------------------------------------
# 对齐 Rust archive/rust-compiler/src/lint.rs 的 L001-L008：
#   L001 未使用变量  L002 未定义变量引用  L003 不可达代码
#   L004 空块        L005 重复顶层定义    L006 命名规范
#   L007 长行(>100)  L008 行尾空白
# 用法（编译版）：pxlint <file.px> [--json] [--strict] [--version]
#   退出码：有 Error → 1；仅 Warning → 0；--strict 时 Warning 也 → 1
# 架构：
#   - import ../selfhost/parser.px（复用自举 lexer+parser 产 AST）
#   - import lint_core.px（纯函数 lint 核心，零顶层数据）
#   - 主文件重复声明 parser/pxlexer 引用全部顶层全局（interp.px 同构惯例）
# 构建：tools/pxc build tools/pxlint.px → cp tools/build/pxlint bootstrap/pxlint
# ============================================================
import "../selfhost/parser.px"
import "lint_core.px"
# ---------- lex/parser 全局状态（主文件声明；import 不合并模块顶层 let） ----------
var g_src = ""
var g_len = 0
var g_pos = 0
var g_line = 1
var g_col = 1
var g_indent_stack = [0]
var g_at_line_start = true
var g_toks = []
var g_count = 0
var g_pending = []
let KEYWORDS = {"let": "let", "var": "var", "const": "const", "def": "def", "fn": "fn", "struct": "struct", "enum": "enum", "trait": "trait", "impl": "impl", "match": "match", "case": "case", "if": "if", "elif": "elif", "else": "else", "for": "for", "while": "while", "in": "in", "and": "and", "or": "or", "not": "not", "return": "return", "break": "break", "continue": "continue", "import": "import", "from": "from", "pub": "pub", "as": "as", "spawn": "spawn", "chan": "chan", "send": "send", "recv": "recv", "select": "select", "true": "true", "false": "false", "null": "null", "None": "null", "self": "self", "capture": "capture", "extern": "extern"}  # noqa
let CTRL_ALL = "\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{b}\u{c}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f}\u{7f}\u{80}\u{81}\u{82}\u{83}\u{84}\u{85}\u{86}\u{87}\u{88}\u{89}\u{8a}\u{8b}\u{8c}\u{8d}\u{8e}\u{8f}\u{90}\u{91}\u{92}\u{93}\u{94}\u{95}\u{96}\u{97}\u{98}\u{99}\u{9a}\u{9b}\u{9c}\u{9d}\u{9e}\u{9f}"  # noqa
var p_toks = []
var p_pos = 0
# ---------- 内置函数/构造器已知名 ----------
# 名册**单一事实源**：lint_core.px 的 BUILTIN_NAMES（本文件 import 取用）。
# 源 = runtime 注册表（tools/gen_builtin_list.sh 派生），门 = selfhost/builtin_list_check.sh。
# 原先本文件手抄一份 254 名副本，与 pxcheck 双向漂移（Issue 63）→ 已删，勿再引入副本。
# ---------- 路径/import 名收集（L002 免误报） ----------
# 目标文件的 import 会把被导入模块的顶层 def 并入（cg_resolve_modules 语义），
# 因此把 import 的文件（std.* / 相对路径 / 用户点分）的顶层函数名加入 known。
# 边界：被 import 方依赖宿主全局的函数（如 it_util 用 hex_to_char）单文件 lint
# 仍会报 L002 —— 属模块惯例固有边界（Rust lint.rs 同），dogfood 白名单留档。
def lx_dirname(path):
    var i = len(path) - 1
    while i >= 0:
        if path[i] == "/":
            if i == 0:
                return "/"
            return path[0:i]
        i -= 1
    return "."
def lx_stdlib_dir():
    let e = env("PX_STDLIB")
    if e != null and exists(e):
        return e
    let cands = ["stdlib", "./stdlib", "../stdlib", "../../stdlib", "/data/code/puxian/stdlib"]
    var i = 0
    while i < len(cands):
        let c = cands[i]
        if exists(c):
            return c
        i += 1
    return null
def lx_mod_candidates(module, base):
    # module: qstr list；返回候选源文件路径（按优先级，可能为空）
    let first = lc_unq(module[0])
    if first == "std" and len(module) >= 2:
        let d2 = lx_stdlib_dir()
        if d2 == null:
            return []
        var p = d2
        var si = 1
        while si < len(module):
            p += "/" + lc_unq(module[si])
            si += 1
        return [p + ".px", p + "/mod.px"]
    if len(module) == 1 and (contains(first, "/") or contains(first, ".px")):
        var p2 = first
        if not (len(first) > 0 and first[0] == "/"):
            p2 = base + "/" + first
        return [p2]
    var p3 = base
    var si2 = 0
    while si2 < len(module):
        p3 += "/" + lc_unq(module[si2])
        si2 += 1
    return [p3 + ".px", p3 + "/mod.px"]
# 递归扫描模块文件：收集其顶层 FuncDef 名 + 其自身 import（对齐
# cg_resolve_modules 递归合并语义 → 主程序可见全部级联函数）。
# visited 防循环；基础路径 = 各文件自身目录。
def lx_scan_imports(path, known, visited):
    if visited.has(path):
        return
    visited[path] = 1
    if not exists(path):
        return
    let src = read_file(path)
    p_toks = lex_tokens(src)
    p_pos = 0
    let ast = parse_program()
    let sts = ast[1]
    let decls = lc_decl_names(sts)
    var si = 0
    while si < len(decls):
        lc_dset(known, decls[si])
        si += 1
    let base = lx_dirname(path)
    var ii = 0
    while ii < len(sts):
        let st3 = sts[ii]
        if st3[0] == "Import":
            let cands = lx_mod_candidates(st3[1], base)
            var ci = 0
            while ci < len(cands):
                if exists(cands[ci]):
                    lx_scan_imports(cands[ci], known, visited)
                    ci = len(cands)
                ci += 1
        ii += 1
def lx_collect_import_names(items, known, file):
    let dir = lx_dirname(file)
    let visited = lc_dnew()
    var i = 0
    while i < len(items):
        let st = items[i]
        if st[0] == "Import":
            let cands = lx_mod_candidates(st[1], dir)
            var ci = 0
            while ci < len(cands):
                if exists(cands[ci]):
                    lx_scan_imports(cands[ci], known, visited)
                    ci = len(cands)
                ci += 1
        i += 1
# ---------- 主流程 ----------
def lx_run(file, jmode, strict):
    if not exists(file):
        let emsg = "pxlint: 无法读取文件 '" + file + "'"
        print(emsg)
        exit(1)
    let src = read_file(file)
    p_toks = lex_tokens(src)
    p_pos = 0
    let ast = parse_program()
    let items = ast[1]
    let known = lc_dnew()
    var bi = 0
    while bi < len(BUILTIN_NAMES):
        lc_dset(known, BUILTIN_NAMES[bi])
        bi += 1
    lc_dset(known, "pi")
    lc_dset(known, "e")
    lx_collect_import_names(items, known, file)
    let diags = []
    lc_check_program(items, src, known, diags)
    var errs = 0
    var warns = 0
    if jmode:
        let out = []
        var di = 0
        while di < len(diags):
            let d = diags[di]
            var lv = "warning"
            if d[1] == "E":
                lv = "error"
            let jo = {"file": file}
            jo["line"] = d[2]
            jo["col"] = d[3]
            jo["level"] = lv
            jo["code"] = d[0]
            jo["message"] = d[4]
            out.append(jo)
            if d[1] == "E":
                errs += 1
            else:
                warns += 1
            di += 1
        print(json_stringify(out))
    else:
        var di = 0
        while di < len(diags):
            let d = diags[di]
            var lv = "W"
            if d[1] == "E":
                lv = "E"
            print(file + ":" + str(d[2]) + ":" + str(d[3]) + ": " + lv + " " + d[0] + ": " + d[4])
            if d[1] == "E":
                errs += 1
            else:
                warns += 1
            di += 1
        print(file + ": " + str(errs) + " 错误, " + str(warns) + " 警告")
    if errs > 0:
        exit(1)
    if strict and warns > 0:
        exit(1)
    exit(0)
def usage():
    print("pxlint —— PuXian 静态检查器（自举，M64b）")
    print("用法: pxlint <file.px> [--json] [--strict] [--version|-v] [-h]")
def main():
    let as_ = args()
    var file = ""
    var jmode = false
    var strict = false
    var i = 0
    while i < len(as_):
        let a = as_[i]
        if a == "--json":
            jmode = true
        elif a == "--strict":
            strict = true
        elif a == "--version" or a == "-v":
            print("pxlint 0.1.0 (普贤 PuXian lint · M64b 自举)")
            exit(0)
        elif a == "--help" or a == "-h":
            usage()
            exit(0)
        elif starts_with(a, "-"):
            print("pxlint: 未知选项 '" + a + "'")
            usage()
            exit(1)
        else:
            file = a
        i += 1
    if file == "":
        usage()
        exit(1)
    lx_run(file, jmode, strict)
