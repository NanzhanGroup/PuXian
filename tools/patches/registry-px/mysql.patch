+# M314：服务器 ERR 包消息的固定前缀（**全文件唯一来源**）
+#   声明在文件顶部：my_err_message 与 my_err_is_server 都读它，
+#   避免「先读后声明」（缺陷 193）。
+var MY_ERR_PREFIX = "mysql err "
+
 # ---- 内部：字节/字符串小工具 ----
 # MySQL wire protocol：数字一律小端。
 # 编码：int_to_bytes(v, n, "little") 双模式可靠（已实测）
@@ -132,7 +137,51 @@
