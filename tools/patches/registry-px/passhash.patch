# ============================================================
# 本地补丁：registry/passhash/0.1.0/passhash.px
# ------------------------------------------------------------
# 为什么有这个补丁（M189 第 67 轮）：
#   `pass_verify` 里 `var iters = int(parts[1])` 直接吃**畸形存储串**。
#   PuXian **M184（缺陷 200 = 第三方 PX-DEF-002）** 把 `int()` 从
#   「C atoi 式宽容前缀解析」收紧为「整体必须合法，否则 R1002」——
#   这是**我方有意**的语义变更（静默错值 → 响亮报错）。
#   于是 `pass_verify("pw", "pbkdf2$abc$x$y")`（上游测试明确期望 false）
#   从「静默 0 后误判」变成「抛 R1002」⇒ 库需要跟着改一行守卫。
#
# 补丁内容 = 上游测试的原始期望（畸形 ⇒ false），只加一行判定，不动其它语义：
#   用 M185 新增的 `is_int_str()`（与 `int()` **同一谓词**，见 M185 缺陷 204 的收口）
#   做前置判断 ⇒ 表达式 `is_int_str(s)` ⇔ `int(s) 不回错` 由**构造**保证，不会漂移。
#
# 上游修复后撤销本补丁即可（删除 tools/patches/registry-px/passhash.patch，
# 再跑一次 `tools/import_registry_px.sh --src <检出> --apply`）。
# 已备好可直接反馈上游的说明：`docs/PX_DEF_TRIAGE.md` §五。
# ============================================================
--- passhash.px
+++ passhash.px
@@ -33,6 +33,8 @@
         return false
     if parts[0] != "pbkdf2":
         return false
+    if not is_int_str(parts[1]):
+        return false
     var iters = int(parts[1])
     var salt = parts[2]
     var want = parts[3]
