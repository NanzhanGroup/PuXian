#!/usr/bin/env bash
# ============================================================
# pxc —— PuXian 版工具链（M-B9a：Rust 版退役后的用户入口）
# ------------------------------------------------------------
# 基于自举产物（bootstrap/pxc 编译器 + bootstrap/pxi 解释器），
# 完全无需 Rust 工具链。行为对齐 Rust 版 px：
#   pxc build <file.px>                    编译为静态二进制（<dir>/build/<name>）
#   pxc build --no-quic <file.px>          裁剪 QUIC/H3（去掉 ngtcp2/openssl 依赖，
#                                           runtime 侧 -DPX_NO_QUIC，M57-S4 边缘设备用）
#   pxc build --target <arch> <file.px>        高层交叉开关（M71-S2，对齐 GOOS/GOARCH）：
#                                           arch ∈ x86_64|aarch64|armv7|riscv64，自动折叠
#                                           cc/mbedtls-lib/sqlite-obj/zlib-lib/--no-quic
#                                           （aarch64 库仓库预置；armv7/riscv64 先 cross_multiarch）
#   pxc build --cc <cc> [--mbedtls-lib <dir>] [--sqlite-obj <file>] --no-quic <file.px>
#                                           交叉编译（M57-S4）：cc 指定交叉编译器，
#                                           mbedtls-lib/sqlite-obj 指定目标架构静态库
#   pxc build [--zlib-lib <dir>] <file.px>    zlib 外部库目录（M61-S0：缺省按 cc 自动探测，
#                                            gcc→lib，aarch64→lib-aarch64，armv7→lib-armv7，riscv64→lib-riscv64）
#   pxc run <file.px> [args...]            解释执行
#   pxc lex <file.px>                      打印 Token 流（调试，走 PuXian lexer）
#   pxc parse <file.px>                    打印 AST（调试，走 PuXian parser）
#   pxc --version / -v                     输出版本号
#   pxc help                               帮助
# 说明：
#   - build 模式：bootstrap/pxc 生成 C 源码 → runtime 预编译 .o 缓存（M71-S1：
#     $PXC_HOME/.rtcache/<key>，key=runtime源×cc×no_quic，命中只编 base.c+链接，
#     二次 build 亚秒；改 runtime/换 cc/切 quic 自动重建）→ gcc 静态链接，
#     参数对齐 Rust 版 run_build（-static -O2 -pthread + sqlite/miniz/mbedtls）
#   - 对拍契约（MINI_SUBSET §五）：build 产物与 Rust 版 px build 逐字节一致
#   - 版本：随 PuXian 编译器演进，用 SELFHOST_VER 标记自举里程碑
#   - M57-S4：交叉编译默认配 --no-quic —— 第三方预编译库（ngtcp2/openssl-quictls）
#     只有 x86_64 版，aarch64 目标需裁剪 QUIC/H3（runtime 加 -DPX_NO_QUIC 条件编译）；
#     mbedtls/sqlite 均纯 C，可用目标架构交叉编译（tools/cross_aarch64.sh）。
# ============================================================
set -u
# M71-S4：argv0 自发现 —— readlink 解析符号链接到真实位置（软链安装
# /usr/local/bin/pxc → 包/tools/pxc 时 PXC_HOME 仍定位到包根，免 PX_STDLIB）
PXC_SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
PXC_HOME="$(cd "$(dirname "$PXC_SELF")/.." && pwd)"
# stdlib 自动定位：包根存在 stdlib 且用户未显式设 PX_STDLIB → 注入（包外任意 cwd 可用）
if [ -z "${PX_STDLIB:-}" ] && [ -d "$PXC_HOME/stdlib" ]; then
    export PX_STDLIB="$PXC_HOME/stdlib"
fi
PXC_BIN="$PXC_HOME/bootstrap/pxc"
PXI_BIN="$PXC_HOME/bootstrap/pxi"
PXL_BIN="$PXC_HOME/bootstrap/pxl"     # lexer.px 编译版（pxc lex 用）
PXPAR_BIN="$PXC_HOME/bootstrap/pxpar" # parser.px 编译版（pxc parse 用）
PXFMT_BIN="$PXC_HOME/bootstrap/pxfmt" # fmt_core+pxfmt 编译版（pxc fmt 用，M64a）
PXLINT_BIN="$PXC_HOME/bootstrap/pxlint" # lint_core+pxlint 编译版（pxc lint 用，M64b）
PXDOC_BIN="$PXC_HOME/bootstrap/pxdoc"   # pxdoc 编译版（pxc doc 用，M64c）
PXTEST_BIN="$PXC_HOME/bootstrap/pxtest" # pxtest 编译版（pxc test 用，M64c）
PXBENCH_BIN="$PXC_HOME/bootstrap/pxbench" # pxbench 编译版（pxc bench 用，M64c）
PXLSP_BIN="$PXC_HOME/bootstrap/pxlsp"   # pxlsp 编译版（pxc lsp 用，M65-S2）
PXCHECK_BIN="$PXC_HOME/bootstrap/pxcheck" # pxcheck 诊断器（pxlsp 子进程，M65-S2）
PXMCP_BIN="$PXC_HOME/bootstrap/pxmcp"   # pxmcp 编译版（pxc mcp 用，M65-S4）
RT_DIR="$PXC_HOME/runtime"
SELFHOST_VER="0.1.0"
SELFHOST_MILESTONE="M-B9a"

usage() {
    cat <<EOF
pxc $(echo "$SELFHOST_VER") (普贤 PuXian · selfhosted $SELFHOST_MILESTONE)

用法:
  pxc build <file.px>                         编译为静态二进制（输出 <目录>/build/<name>）
  pxc build [--no-quic] [--target <arch>] [--cc <cc>]
            [--mbedtls-lib <dir>] [--sqlite-obj <file>] <file.px>
                                               裁剪/交叉编译选项（M57-S4 / M71-S2）：
                                                 --target <arch> 高层交叉开关：x86_64|aarch64|
                                                                  armv7|riscv64，自动折叠 cc/
                                                                  mbedtls-lib/sqlite-obj/zlib-lib/
                                                                  --no-quic（显式 flag 优先）
                                                 --no-quic       去掉 QUIC/H3（-DPX_NO_QUIC，
                                                                  不链 ngtcp2/openssl）
                                                 --cc <cc>       指定 C 编译器（交叉用，
                                                                  如 aarch64-linux-musl-gcc）
                                                 --mbedtls-lib   目标架构 mbedtls 库目录
                                                                  （缺省 runtime/mbedtls/lib）
                                                 --sqlite-obj    目标架构 sqlite3 .o 文件
                                                                  （缺省 third_party/sqlite3/sqlite3.o）
                                                 --zlib-lib      目标架构 zlib 库目录
                                                                  （缺省按 cc 自动探测：gcc→lib，aarch64/armv7/riscv64→lib-<arch>）
  pxc run <file.px> [args...]                 解释执行
  pxc lex <file.px>                           词法分析并打印 Token 流（调试）
  pxc parse <file.px>                         语法分析并打印 AST（调试）
  pxc fmt <file.px> [-w] [--check] [--diff]   代码格式化（M64a 自举；默认 stdout，
                                              -w 写回 / --check 仅检查 / --diff 打印差异）
  pxc lint <file.px> [--json] [--strict]      静态检查 L001-L008（M64b 自举；有错退出 1，
                                              --strict 时警告也退出 1 / --json 机器可读）
  pxc doc <file.px> [--output out.md]         从 ## 文档注释生成 Markdown（M64c 自举；
                                              默认 stdout，--output 写文件）
  pxc test <file.px> [filter] [--list]        运行顶层 def test_xxx() 测试（M64c 自举；
                                              逐用例独立 pxi 子进程，有失败退出 1）
  pxc bench <file.px> <func> [--count N] [--repeat R]
                                              基准测试（M64c 自举；N 次循环调用 × R 轮）
  pxc lsp                                    LSP 服务器（M65-S3 自举；stdio 即协议通道，
                                             编辑器以子进程拉起；诊断走 pxcheck 子进程，
                                             补全/跳转/悬停走 lsp_core 文本级符号层）
  pxc mcp                                    MCP 服务器（M65-S4 自举；stdio 即协议通道，
                                             agent 以子进程拉起；9 工具 run/fmt/lint/test/
                                             bench/doc/ast/build/version 经 os_spawn_capture
                                             调 bootstrap 各二进制，隔离崩溃不污染协议）
  pxc --version                               输出版本号
  pxc help                                    显示本帮助
EOF
}

# ---- M71-S1：runtime 预编译 .o 增量缓存（等价 Go build cache）----
# build 不再每次全量现编 runtime*.c：预编译 .o 入 $PXC_HOME/.rtcache/<key>/，
# 命中时只编 base.c + 链接（二次 build 亚秒）。key = runtime 源内容 × cc × no_quic
# → 改 runtime 源码 / 换 cc / 切 quic 自动重建缓存。
# 注意：mbedtls/ngtcp2/openssl 为第三方 git 预置（include 不随 key 变；升级三方库后
#       若缓存行为异常 rm -rf .rtcache 重建即可）。
rt_src_files() {
    # 参数：no_quic(0/1) → 输出需进缓存的 runtime 源（相对 $RT_DIR）
    local no_quic="$1"
    local list="runtime.h runtime.c runtime_aes.c runtime_xml.c runtime_zip.c \
        runtime_ws.c runtime_rsa.c runtime_sqlite.c runtime_route.c runtime_h2.c \
        runtime_ffi.c runtime_zlib.c arch.h arch_x86_64.h arch_aarch64.h \
        arch_armv7.h arch_riscv64.h"
    if [ "$no_quic" != "1" ]; then
        list="$list runtime_quic.c runtime_h3.c runtime_h3_qpack.c \
            runtime_h3_qpack_dyn.c runtime_h3_qpack.h runtime_h3_qpack_tbl.h \
            runtime_h3_qpack_dyn.h"
    fi
    echo "$list"
}
rt_key() {
    # 参数：no_quic cc → 16 位缓存键（runtime 源 + miniz + sqlite 头内容哈希）
    local no_quic="$1" cc="$2" f key_src=""
    for f in $(rt_src_files "$no_quic") \
             third_party/miniz/miniz.c third_party/miniz/miniz_tinfl.c \
             third_party/miniz/miniz_tdef.c third_party/miniz/miniz.h \
             third_party/miniz/miniz_common.h third_party/miniz/miniz_tinfl.h \
             third_party/miniz/miniz_tdef.h third_party/miniz/miniz_export.h \
             third_party/sqlite3/sqlite3.h; do
        if [ -f "$RT_DIR/$f" ]; then
            key_src="$key_src $(sha256sum "$RT_DIR/$f" | cut -c1-16)"
        fi
    done
    echo "$key_src cc=$(basename "$cc") noquic=$no_quic" | sha256sum | cut -c1-16
}
rt_cache_compile() {
    # 参数：dir（cache 目录）no_quic cc —— 复制源到 dir 并逐 .c 预编译 .o（一次性）
    local dir="$1" no_quic="$2" cc="$3"
    local mbedtls_inc="$RT_DIR/mbedtls/include"
    local zlib_inc="$RT_DIR/third_party/zlib/include"
    local sqlite_dir="$RT_DIR/third_party/sqlite3"
    local f
    # 复制源（同目录相对 include 语义，对齐旧 copy_runtime 的 build_dir 布局）
    for f in $(rt_src_files "$no_quic"); do
        cp "$RT_DIR/$f" "$dir/" || return 1
    done
    for f in miniz.c miniz_tinfl.c miniz_tdef.c miniz.h miniz_common.h \
             miniz_tinfl.h miniz_tdef.h miniz_export.h; do
        cp "$RT_DIR/third_party/miniz/$f" "$dir/" 2>/dev/null
    done
    cp "$sqlite_dir/sqlite3.h" "$dir/" 2>/dev/null
    # 预编译 .c（runtime 源 + miniz；sqlite3 走既有预编译 .o/.c 通道不进缓存）
    local common="-O2 -pthread -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DEFAULT_FOREIGN_KEYS=1 \
        -I\"$dir\" -I\"$RT_DIR/third_party/miniz\" -I\"$mbedtls_inc\" \
        -I\"$sqlite_dir\" -I\"$zlib_inc\""
    if [ "$no_quic" = "1" ]; then
        common="$common -DPX_NO_QUIC"
    else
        common="$common -I\"$RT_DIR/third_party/ngtcp2/include\" -I\"$RT_DIR/third_party/openssl/include\""
    fi
    local srcs="runtime.c runtime_aes.c runtime_xml.c runtime_zip.c runtime_ws.c \
        runtime_rsa.c runtime_sqlite.c runtime_route.c runtime_h2.c runtime_ffi.c \
        runtime_zlib.c"
    if [ "$no_quic" != "1" ]; then
        srcs="$srcs runtime_quic.c runtime_h3.c runtime_h3_qpack.c runtime_h3_qpack_dyn.c"
    fi
    srcs="$srcs miniz.c miniz_tinfl.c miniz_tdef.c"
    local src base
    for src in $srcs; do
        base="$(basename "$src" .c)"
        if ! eval "$cc -c $common -o \"$dir/$base.o\" \"$dir/$src\"" 2>>/tmp/pxc_rtcc.log; then
            echo "错误: runtime 预编译失败 $src（$cc）—— 日志 /tmp/pxc_rtcc.log" >&2
            return 1
        fi
    done
    touch "$dir/.complete"
    return 0
}
rt_ensure() {
    # 参数：no_quic cc → stdout 输出 cache_dir；缺失则现编
    local no_quic="$1" cc="$2" key dir
    key="$(rt_key "$no_quic" "$cc")"
    dir="$PXC_HOME/.rtcache/$key"
    if [ -d "$dir" ] && [ -f "$dir/.complete" ]; then
        echo "$dir"
        return 0
    fi
    mkdir -p "$dir"
    if ! rt_cache_compile "$dir" "$no_quic" "$cc"; then
        rm -rf "$dir"
        return 1
    fi
    echo "$dir"
    return 0
}

# ---- M71-S2：--target 高层折叠（对齐 GOOS/GOARCH，交叉 5 flag 折叠为一条命令）----
# 输出键值行：cc / mbedtls_lib / sqlite_obj / zlib_lib / no_quic。
# aarch64 仓库预置库；armv7/riscv64 无仓库预置 → 探测 CI/本机 cross_multiarch
#   --outdir 布局 /opt/px-multiarch/<arch>/（M67 cross cache 约定）。
target_defaults() {
    local arch="$1"
    case "$arch" in
        x86_64)
            echo "cc=gcc"; echo "no_quic=0"
            echo "mbedtls_lib=$RT_DIR/mbedtls/lib"
            echo "sqlite_obj=$RT_DIR/third_party/sqlite3/sqlite3.o"
            echo "zlib_lib=$RT_DIR/third_party/zlib/lib"
            return 0 ;;
        aarch64)
            echo "cc=aarch64-linux-musl-gcc"; echo "no_quic=1"
            echo "mbedtls_lib=$RT_DIR/mbedtls/lib-aarch64"
            echo "sqlite_obj=$RT_DIR/third_party/sqlite3/sqlite3-aarch64.o"
            echo "zlib_lib=$RT_DIR/third_party/zlib/lib-aarch64"
            return 0 ;;
        armv7|riscv64)
            local cc="$arch-linux-musl-gcc"
            [ "$arch" = "armv7" ] && cc="armv7l-linux-musleabihf-gcc"
            echo "cc=$cc"; echo "no_quic=1"
            local base="$RT_DIR/mbedtls/lib-$arch"
            local so="$RT_DIR/third_party/sqlite3/sqlite3-$arch.o"
            local zl="$RT_DIR/third_party/zlib/lib-$arch"
            # 仓库未预置 armv7/riscv64 库 → 探测 /opt/px-multiarch/<arch>/ 布局
            if [ ! -d "$base" ] && [ -d "/opt/px-multiarch/$arch/mbedtls/lib-$arch" ]; then
                base="/opt/px-multiarch/$arch/mbedtls/lib-$arch"
                so="/opt/px-multiarch/$arch/sqlite3/sqlite3-$arch.o"
                zl="/opt/px-multiarch/$arch/zlib/lib-$arch"
            fi
            echo "mbedtls_lib=$base"; echo "sqlite_obj=$so"; echo "zlib_lib=$zl"
            return 0 ;;
        *)
            echo "错误: 未知 --target $arch（支持 x86_64|aarch64|armv7|riscv64）" >&2
            return 1 ;;
    esac
}

# build：AST → C → gcc 静态二进制（对齐 Rust run_build）
cmd_build() {
    local no_quic=0 cc="gcc" mbedtls_lib="" sqlite_obj="" zlib_lib="" target=""
    local cc_set=0 no_quic_set=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-quic) no_quic=1; no_quic_set=1; shift ;;
            --cc) cc="$2"; cc_set=1; shift 2 ;;
            --target|-t) target="$2"; shift 2 ;;
            --mbedtls-lib) mbedtls_lib="$2"; shift 2 ;;
            --sqlite-obj) sqlite_obj="$2"; shift 2 ;;
            --zlib-lib) zlib_lib="$2"; shift 2 ;;
            -h|--help) usage; return 0 ;;
            --) shift; break ;;
            -*) echo "未知选项: $1" >&2; usage >&2; return 1 ;;
            *) break ;;
        esac
    done
    local file="${1:-}"
    [ -n "$file" ] || { echo "用法: pxc build [选项] <file.px>" >&2; exit 1; }
    [ -f "$file" ] || { echo "错误: 无法读取文件 $file" >&2; return 1; }
    # M71-S2：--target 高层折叠（显式 flag 优先于 target 默认；缺省 x86_64 语义 = 现状）
    if [ -n "$target" ]; then
        local t_out t_cc="" t_mb="" t_so="" t_zl="" t_nq=""
        t_out="$(target_defaults "$target")" || return 1
        local t_line
        while IFS= read -r t_line; do
            case "$t_line" in
                cc=*) t_cc="${t_line#cc=}" ;;
                mbedtls_lib=*) t_mb="${t_line#mbedtls_lib=}" ;;
                sqlite_obj=*) t_so="${t_line#sqlite_obj=}" ;;
                zlib_lib=*) t_zl="${t_line#zlib_lib=}" ;;
                no_quic=*) t_nq="${t_line#no_quic=}" ;;
            esac
        done <<< "$t_out"
        [ "$cc_set" = 1 ] || cc="$t_cc"
        [ "$no_quic_set" = 1 ] || no_quic="${t_nq:-0}"
        [ "$mbedtls_lib" = "" ] && mbedtls_lib="$t_mb"
        [ "$sqlite_obj" = "" ] && sqlite_obj="$t_so"
        [ "$zlib_lib" = "" ] && zlib_lib="$t_zl"
        # 交叉 cc 不在 PATH → 友好指引（不联网下载；CI/用户自备工具链）
        if ! command -v "$cc" >/dev/null 2>&1; then
            echo "错误: --target $target 需要交叉编译器 $cc（不在 PATH）" >&2
            echo "  获取方式（任一）：" >&2
            echo "    1) musl.cc：https://musl.cc/ 下载 ${cc%-gcc}-cross.tgz，解压把 bin 加入 PATH" >&2
            echo "    2) zig cc：装 zig 后建 wrapper（${cc%-gcc}-gcc → 'zig cc -target <triple>'）入 PATH（CI 已用此路）" >&2
            echo "    3) 交叉静态库：armv7/riscv64 先 tools/cross_multiarch.sh --arch $target --outdir /opt/px-multiarch/$target（aarch64 库仓库已预置）" >&2
            return 1
        fi
        # 目标架构静态库完整性检查
        if [ ! -d "$mbedtls_lib" ] || [ ! -f "$mbedtls_lib/libmbedcrypto.a" ]            || [ ! -f "$sqlite_obj" ] || [ ! -f "$zlib_lib/libz.a" ]; then
            echo "错误: --target $target 缺目标架构静态库（mbedtls/sqlite3/zlib）" >&2
            echo "  仓库预置：aarch64 已含 runtime/mbedtls/lib-aarch64 + sqlite3-aarch64.o + zlib/lib-aarch64" >&2
            echo "  armv7/riscv64：先 tools/cross_multiarch.sh --arch $target --outdir /opt/px-multiarch/$target 现编" >&2
            return 1
        fi
    fi
    [ "$mbedtls_lib" = "" ] && mbedtls_lib="$RT_DIR/mbedtls/lib"
    # M61-S0：zlib 外部静态库 —— 显式 --zlib-lib 优先，否则按 cc 架构自动探测
    # M67-S5：多架构扩展（aarch64/armv7/riscv64 → lib-<arch>，缺省 lib 兼容）
    if [ "$zlib_lib" = "" ]; then
        case "$cc" in
            *aarch64*) zlib_lib="$RT_DIR/third_party/zlib/lib-aarch64" ;;
            *armv7*)   zlib_lib="$RT_DIR/third_party/zlib/lib-armv7" ;;
            *riscv64*) zlib_lib="$RT_DIR/third_party/zlib/lib-riscv64" ;;
            *)         zlib_lib="$RT_DIR/third_party/zlib/lib" ;;
        esac
    fi
    [ -f "$zlib_lib/libz.a" ] || { echo "错误: 缺少 zlib 静态库 $zlib_lib/libz.a（先跑 tools/build_zlib.sh）" >&2; return 1; }
    local base parent build_dir
    base="$(basename "$file" .px)"
    parent="$(cd "$(dirname "$file")" && pwd)"
    build_dir="$parent/build"
    mkdir -p "$build_dir"

    local c_path="$build_dir/$base.c"
    local out_path="$build_dir/$base"

    # 1) PuXian 版编译器生成 C 源码（stdout）
    "$PXC_BIN" build "$file" > "$c_path" 2>/dev/null || {
        echo "错误: 编译失败（$file）" >&2
        # 重跑拿错误信息
        "$PXC_BIN" build "$file" 2>&1 | head -20 >&2
        return 1
    }
    # 2) M71-S1：runtime 预编译 .o 缓存（命中 → 只编 base.c + 链接；miss → 现编入缓存）
    local cache_dir
    cache_dir="$(rt_ensure "$no_quic" "$cc")" || { echo "错误: runtime 预编译缓存建立失败" >&2; return 1; }
    # 3) 编译生成的 C 单文件 + 链接预编译 .o（不再每次全量现编 runtime）
    local mbedtls_inc="$RT_DIR/mbedtls/include"
    local sqlite_dir="$RT_DIR/third_party/sqlite3"
    local sqlite_src=""
    if [ -n "$sqlite_obj" ] && [ -f "$sqlite_obj" ]; then
        sqlite_src="$sqlite_obj"
    elif [ -f "$sqlite_dir/sqlite3.o" ]; then
        sqlite_src="$sqlite_dir/sqlite3.o"
    else
        sqlite_src="$sqlite_dir/sqlite3.c"
    fi
    local cc_cmd
    local common_def="-O2 -pthread -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DEFAULT_FOREIGN_KEYS=1 \
        -I\"$cache_dir\" -I\"$RT_DIR/third_party/miniz\" -I\"$mbedtls_inc\" \
        -I\"$sqlite_dir\" -I\"$RT_DIR/third_party/zlib/include\""
    if [ "$no_quic" = "1" ]; then
        common_def="$common_def -DPX_NO_QUIC"
    else
        common_def="$common_def -I\"$RT_DIR/third_party/ngtcp2/include\" -I\"$RT_DIR/third_party/openssl/include\""
    fi
    # 用户 C 单文件现编（与 runtime .o 同 defines/include → ABI 一致）
    if ! eval "$cc -c $common_def -o \"$build_dir/$base.o\" \"$c_path\"" 2>/tmp/pxc_gcc_err.log; then
        echo "编译失败: $base.c" >&2
        tail -20 /tmp/pxc_gcc_err.log >&2
        return 1
    fi
    # 链接：base.o + runtime/miniz 预编译 .o + sqlite3 + 三方静态库
    local objs="" f
    for f in "$cache_dir"/*.o; do
        [ -f "$f" ] || { echo "错误: 缺少预编译对象 $f" >&2; return 1; }
        objs="$objs \"$f\""
    done
    # M67-S7：riscv64 musl 默认 static-pie 报 "read-only segment has dynamic
    # relocations" → riscv64 交叉加 -no-pie 传统静态
    local pie_flag=""
    case "$cc" in *riscv64*) pie_flag=" -no-pie" ;; esac
    cc_cmd="$cc -static -O2 -pthread$pie_flag -o \"$out_path\" \"$build_dir/$base.o\" $objs \
        \"$sqlite_src\""
    cc_cmd="$cc_cmd \
        \"$mbedtls_lib/libmbedtls.a\" \"$mbedtls_lib/libmbedx509.a\" \"$mbedtls_lib/libmbedcrypto.a\""
    if [ "$no_quic" != "1" ]; then
        cc_cmd="$cc_cmd \
        \"$RT_DIR/third_party/ngtcp2/lib/libngtcp2.a\" \"$RT_DIR/third_party/ngtcp2/lib/libngtcp2_crypto_quictls.a\" \
        \"$RT_DIR/third_party/openssl/lib/libssl.a\" \"$RT_DIR/third_party/openssl/lib/libcrypto.a\""
    fi
    # M61-S0：zlib 外部静态库（无条件链，.a ~150KB；--cc 交叉已自动切架构库）
    cc_cmd="$cc_cmd \"$zlib_lib/libz.a\""
    cc_cmd="$cc_cmd -lm -ldl"
    if ! eval "$cc_cmd" 2> /tmp/pxc_gcc_err.log; then
        echo "编译失败: $out_path" >&2
        tail -20 /tmp/pxc_gcc_err.log >&2
        return 1
    fi
    local size
    size=$(stat -c %s "$out_path" 2>/dev/null || echo 0)
    echo "编译成功: $out_path （$size 字节）"
    return 0
}

cmd_run() {
    local file="$1"; shift
    # pxi 取最后一个参数为文件；其余参数透传（当前 Mini 子集解释器仅支持单文件）
    "$PXI_BIN" "$file" "$@" 2>&1
}

cmd_lex() {
    local file="$1"
    "$PXL_BIN" "$file" 2>&1
}

cmd_parse() {
    local file="$1"
    "$PXPAR_BIN" "$file" 2>&1
}

# M64a：px fmt（PuXian 自举格式化器，bootstrap/pxfmt）
cmd_fmt() {
    "$PXFMT_BIN" "$@"
}

# M64b：px lint（PuXian 自举静态检查器，bootstrap/pxlint）
cmd_lint() {
    "$PXLINT_BIN" "$@"
}

# M64c：px doc（PuXian 自举文档生成器，bootstrap/pxdoc）
cmd_doc() {
    "$PXDOC_BIN" "$@"
}

# M64c：px test（PuXian 自举测试运行器，bootstrap/pxtest）
# 注入 PX_PXI：pxtest 内部 os_spawn(bootstrap/pxi) 逐用例执行（语言内编排）
cmd_test() {
    PX_PXI="$PXI_BIN" "$PXTEST_BIN" "$@"
}

# M64c：px bench（PuXian 自举基准工具，bootstrap/pxbench）
cmd_bench() {
    PX_PXI="$PXI_BIN" "$PXBENCH_BIN" "$@"
}

# M65-S2：px lsp（PuXian 自举 LSP 服务器，bootstrap/pxlsp）
# stdio 即 LSP transport：exec 替换进程保留 fd 0/1（编辑器以子进程拉起）。
# 注入 PX_PXCHECK：pxlsp 内部 os_spawn_capture(bootstrap/pxcheck) 做深度诊断
cmd_lsp() {
    PX_PXCHECK="$PXCHECK_BIN" exec "$PXLSP_BIN" "$@"
}

# M65-S4：px mcp（PuXian 自举 MCP 服务器，bootstrap/pxmcp）
# stdio 即 MCP transport：exec 替换进程保留 fd 0/1（agent 以子进程拉起）。
# 注入 PX_BOOT：pxmcp 内部 os_spawn_capture(bootstrap/<工具>) 执行各工具
# （隔离崩溃 + 捕获输出不污染协议 stdout）；test/bench 子进程还需 PX_PXI；
# build 工具还需 PX_PXC（tools/pxc，M71-S3 交付腿）
cmd_mcp() {
    PX_BOOT="$PXC_HOME/bootstrap" PX_PXI="$PXI_BIN" PX_PXC="$PXC_HOME/tools/pxc" exec "$PXMCP_BIN" "$@"
}

# ---- 入口 ----
cmd="${1:-help}"
case "$cmd" in
    build) shift; cmd_build "$@" ;;
    run)   shift; [ $# -ge 1 ] || { echo "用法: pxc run <file.px>" >&2; exit 1; }; cmd_run "$@" ;;
    lex)   shift; [ $# -ge 1 ] || { echo "用法: pxc lex <file.px>" >&2; exit 1; }; cmd_lex "$1" ;;
    parse) shift; [ $# -ge 1 ] || { echo "用法: pxc parse <file.px>" >&2; exit 1; }; cmd_parse "$1" ;;
    fmt)   shift; [ $# -ge 1 ] || { echo "用法: pxc fmt <file.px> [-w] [--check] [--diff]" >&2; exit 1; }; cmd_fmt "$@" ;;
    lint)  shift; [ $# -ge 1 ] || { echo "用法: pxc lint <file.px> [--json] [--strict]" >&2; exit 1; }; cmd_lint "$@" ;;
    doc)   shift; [ $# -ge 1 ] || { echo "用法: pxc doc <file.px> [--output out.md]" >&2; exit 1; }; cmd_doc "$@" ;;
    test)  shift; [ $# -ge 1 ] || { echo "用法: pxc test <file.px> [filter] [--list]" >&2; exit 1; }; cmd_test "$@" ;;
    bench) shift; [ $# -ge 2 ] || { echo "用法: pxc bench <file.px> <func> [--count N] [--repeat R]" >&2; exit 1; }; cmd_bench "$@" ;;
    lsp)   shift; cmd_lsp "$@" ;;
    mcp)   shift; cmd_mcp "$@" ;;
    --version|-v) echo "pxc $SELFHOST_VER (普贤 PuXian · selfhosted $SELFHOST_MILESTONE)";;
    help|--help|-h) usage ;;
    *) echo "未知子命令: $cmd" >&2; usage >&2; exit 1 ;;
esac
