# ============================================================
# tools/pxmcp.px —— PuXian MCP 服务器（自举版，pxc mcp，M65-S4）
# ------------------------------------------------------------
# 对齐 Rust archive/rust-compiler/src/mcp.rs（2024-11-05 协议，stdio
# transport）：initialize + tools/list（8 工具 + inputSchema）+
# tools/call（按工具分派）+ notifications/initialized 忽略 +
# shutdown/exit + JSON-RPC error（未知方法 -32601）。
# 架构（M65-S1 侦查 A + S2 实测 #1 决策）：
#   - 工具执行全部走子进程 os_spawn_capture（对齐 Rust run_cli 语义 +
#     pxlsp pxcheck 先例）：自举 parser/lexer 对语法错误 print+panic
#     杀进程（不可捕获）→ 语言内直调核心会把 pxmcp 服务器一起杀掉；
#     子进程隔离崩溃安全，输出捕获回传，也不污染协议 stdout。
#   - 统一入口：环境变量 PX_BOOT 指向 bootstrap/（pxc mcp 注入绝对路径），
#     按工具 spawn 对应静态二进制：run→pxi、fmt→pxfmt、lint→pxlint、
#     test→pxtest（需 PX_PXI，pxc mcp 一并注入）、bench→pxbench、
#     doc→pxdoc、ast→pxpar；version 内联版本串。
#   - code 输入（run/fmt/lint/ast）写临时文件（TMPDIR/pxmcp_<pid>_<seq>.px）
#     执行后删除（对齐 Rust write_temp + pxlsp 惯例）。
# 协议约定：服务器禁用 print（污染协议 stdout）；调试输出 write(2)。
# 依赖：bootstrap/pxi pxfmt pxlint pxtest pxbench pxdoc pxpar（环境变量
#   PX_BOOT 指定 bootstrap 目录绝对路径，pxc mcp 注入）
# 构建：tools/pxc build tools/pxmcp.px → cp tools/build/pxmcp bootstrap/pxmcp
# ============================================================
import "jsonrpc_core.px"
# ---------- 常量 ----------
let PXMC_VER = "0.1.0"
let PXMC_MS = "M65-S4"
let MCP_PROTO = "2024-11-05"
# 与 tools/pxc SELFHOST_VER/SELFHOST_MILESTONE 对齐的版本串（version 工具内联）
let PXC_VER_INFO = "pxc 0.1.0 (普贤 PuXian · selfhosted M-B9a)"
var g_seq = 0  # 临时文件序号（防并发覆盖）
var g_shutdown = false
def mcp_err(msg):
    write(2, msg + "\n")
# ---------- 工具元数据（对齐 Rust mcp.rs TOOLS）----------
# 每项：name, description, params（数组，每参 name/desc/required）
def mp(name, desc, req):
    let d = jr_dnew()
    d["name"] = name
    d["desc"] = desc
    d["req"] = req
    return d
def tool(name, desc, params):
    let d = jr_dnew()
    d["name"] = name
    d["description"] = desc
    d["params"] = params
    return d
# 8 工具元数据（单条构造，PuXian 不支持跨行复合字面量）
def tools_meta():
    let t = []
    let run_p = []
    run_p.append(mp("file", "普贤源码文件路径", false))
    run_p.append(mp("code", "普贤源码字符串", false))
    t.append(tool("run", "运行普贤脚本（file 或 code）", run_p))
    let fmt_p = []
    fmt_p.append(mp("file", "普贤源码文件路径", false))
    fmt_p.append(mp("code", "普贤源码字符串", false))
    t.append(tool("fmt", "格式化普贤代码（file 或 code）", fmt_p))
    let lint_p = []
    lint_p.append(mp("file", "普贤源码文件路径", false))
    lint_p.append(mp("code", "普贤源码字符串", false))
    t.append(tool("lint", "静态检查普贤代码 L001-L008", lint_p))
    let test_p = []
    test_p.append(mp("file", "普贤源码文件路径", true))
    t.append(tool("test", "运行普贤测试用例 def test_*", test_p))
    let bench_p = []
    bench_p.append(mp("file", "普贤源码文件路径", true))
    bench_p.append(mp("func", "要测试的函数名", true))
    t.append(tool("bench", "基准测试普贤函数", bench_p))
    let doc_p = []
    doc_p.append(mp("file", "普贤源码文件路径", true))
    t.append(tool("doc", "从 ## 注释生成 Markdown 文档", doc_p))
    let ast_p = []
    ast_p.append(mp("file", "普贤源码文件路径", false))
    ast_p.append(mp("code", "普贤源码字符串", false))
    t.append(tool("ast", "查看普贤源码的 AST 树形结构", ast_p))
    t.append(tool("version", "获取普贤编译器版本信息", []))
    return t
# ---------- 工具定位 ----------
# 返回 bootstrap 目录绝对路径（env PX_BOOT）；未注入 → ""（pxc mcp 必须注入）
def mcp_boot():
    let b = env("PX_BOOT")
    if b == null:
        return ""
    return b
# bin 名 → bootstrap 下二进制绝对路径（未注入返回原 bin 名，spawn 时靠 PATH）
def mcp_bin(name):
    let b = mcp_boot()
    if b == "":
        return name
    return b + "/" + name
# ---------- 临时文件（code 输入用）----------
# 写 code 到 TMPDIR 下唯一 .px，返回路径；失败返回 ""
def mcp_tempfile(code):
    var td = env("TMPDIR")
    if td == null or td == "":
        td = "/tmp"
    let tmp = td + "/pxmcp_" + str(os_pid()) + "_" + str(g_seq) + ".px"
    g_seq += 1
    let werr = write_file(tmp, code)
    if werr != null:
        mcp_err("[pxmcp] 写临时文件失败: " + str(werr))
        return ""
    return tmp
# ---------- 工具入参解析 ----------
# 从 arguments 取 file 或 code：有 file 用之；否则有 code 写临时文件；
# 返回 [ok, path, isTemp]
def mcp_resolve(arg):
    if arg.has("file"):
        if type(arg["file"]) == "string":
            if arg["file"] != "":
                return [true, arg["file"], false]
    if arg.has("code"):
        if type(arg["code"]) == "string":
            if arg["code"] != "":
                let tmp = mcp_tempfile(arg["code"])
                if tmp == "":
                    return [false, "写临时文件失败", false]
                return [true, tmp, true]
    return [false, "缺少参数：需要 file 或 code", false]
# ---------- 单工具执行（子进程捕获）----------
# bin + args → [rc, text]（rc!=0 视为 isError）
def mcp_spawn(bin, args):
    let res = os_spawn_capture(bin, args)
    if type(res) != "list":
        return [127, "启动失败: " + bin]
    return [res[0], res[1]]
# 执行工具：name + arguments(dict) → MCP result dict
#   result = {"content": [{"type": "text", "text": ...}], "isError": bool}
def mcp_call_tool(name, arg):
    let res = jr_dnew()
    let content = []
    var text = ""
    var is_err = false
    var need_clean = false
    var path = ""
    if name == "version":
        text = PXC_VER_INFO
        text = text + "\npxmcp " + PXMC_VER + " (MCP " + MCP_PROTO + " · " + PXMC_MS + ")"
    elif name == "run" or name == "fmt" or name == "lint" or name == "ast":
        let r = mcp_resolve(arg)
        if not r[0]:
            text = r[1]
            is_err = true
        else:
            path = r[1]
            need_clean = r[2]
            var bin = ""
            if name == "run":
                bin = mcp_bin("pxi")
            elif name == "fmt":
                bin = mcp_bin("pxfmt")
            elif name == "lint":
                bin = mcp_bin("pxlint")
            else:
                bin = mcp_bin("pxpar")
            let sp = mcp_spawn(bin, [path])
            text = sp[1]
            if sp[0] != 0:
                is_err = true
    elif name == "test":
        if arg.has("file"):
            if type(arg["file"]) == "string":
                if arg["file"] != "":
                    let sp = mcp_spawn(mcp_bin("pxtest"), [arg["file"]])
                    text = sp[1]
                    if sp[0] != 0:
                        is_err = true
                else:
                    text = "缺少参数：file"
                    is_err = true
            else:
                text = "缺少参数：file"
                is_err = true
        else:
            text = "缺少参数：file"
            is_err = true
    elif name == "bench":
        var okf = false
        var okg = false
        if arg.has("file"):
            if type(arg["file"]) == "string":
                if arg["file"] != "":
                    okf = true
        if arg.has("func"):
            if type(arg["func"]) == "string":
                if arg["func"] != "":
                    okg = true
        if okf and okg:
            let sp = mcp_spawn(mcp_bin("pxbench"), [arg["file"], arg["func"]])
            text = sp[1]
            if sp[0] != 0:
                is_err = true
        else:
            text = "缺少参数：需要 file 和 func"
            is_err = true
    elif name == "doc":
        if arg.has("file"):
            if type(arg["file"]) == "string":
                if arg["file"] != "":
                    let sp = mcp_spawn(mcp_bin("pxdoc"), [arg["file"]])
                    text = sp[1]
                    if sp[0] != 0:
                        is_err = true
                else:
                    text = "缺少参数：file"
                    is_err = true
            else:
                text = "缺少参数：file"
                is_err = true
        else:
            text = "缺少参数：file"
            is_err = true
    else:
        text = "未知工具: " + name
        is_err = true
    # 清理临时文件
    if need_clean:
        if path != "":
            remove(path)
    let item = jr_dnew()
    item["type"] = "text"
    item["text"] = text
    content.append(item)
    res["content"] = content
    res["isError"] = is_err
    return res
# ---------- tools/list 结果（含 inputSchema JSON Schema）----------
def mcp_tools_list():
    let res = jr_dnew()
    let tools = []
    let meta = tools_meta()
    var i = 0
    while i < len(meta):
        let t = meta[i]
        let tj = jr_dnew()
        tj["name"] = t["name"]
        tj["description"] = t["description"]
        let schema = jr_dnew()
        schema["type"] = "object"
        let props = jr_dnew()
        let required = []
        let ps = t["params"]
        var j = 0
        while j < len(ps):
            let p = ps[j]
            let pj = jr_dnew()
            pj["type"] = "string"
            pj["description"] = p["desc"]
            props[p["name"]] = pj
            if p["req"]:
                required.append(p["name"])
            j += 1
        schema["properties"] = props
        schema["required"] = required
        tj["inputSchema"] = schema
        tools.append(tj)
        i += 1
    res["tools"] = tools
    return res
# ---------- initialize 结果 ----------
def mcp_initialize():
    let res = jr_dnew()
    res["protocolVersion"] = MCP_PROTO
    let caps = jr_dnew()
    let tc = jr_dnew()
    tc["listChanged"] = false
    caps["tools"] = tc
    res["capabilities"] = caps
    let info = jr_dnew()
    info["name"] = "px-mcp"
    info["version"] = PXMC_VER + " (" + PXMC_MS + ")"
    res["serverInfo"] = info
    return res
# ---------- 消息分发（返回待发送消息列表）----------
def mcp_handle(msg):
    let outs = []
    let c = jr_classify(msg)
    if c == "response" or c == "invalid":
        return outs
    let method = jr_method_of(msg)
    let is_req = (c == "request")
    let id = jr_id_of(msg)
    if is_req:
        if method == "initialize":
            outs.append(jr_response(id, mcp_initialize()))
        elif method == "tools/list":
            outs.append(jr_response(id, mcp_tools_list()))
        elif method == "tools/call":
            var arg = jr_dnew()
            var tname = ""
            if msg.has("params"):
                if type(msg["params"]) == "dict":
                    let pp = msg["params"]
                    if pp.has("name"):
                        if type(pp["name"]) == "string":
                            tname = pp["name"]
                    if pp.has("arguments"):
                        if type(pp["arguments"]) == "dict":
                            arg = pp["arguments"]
            outs.append(jr_response(id, mcp_call_tool(tname, arg)))
        elif method == "ping":
            outs.append(jr_response(id, jr_dnew()))
        elif method == "shutdown":
            g_shutdown = true
            outs.append(jr_response(id, jr_dnew()))
        else:
            outs.append(jr_method_not_found(id, method))
        return outs
    # ---------- notifications ----------
    if method == "notifications/initialized":
        return outs
    if method == "exit":
        return outs
    # 未知 notification：按 JSON-RPC 忽略
    return outs
# ---------- 服务器主循环（对齐 pxlsp）----------
def mcp_serve():
    var buf = bytes("")
    var done = false
    while not done:
        let rd = read(0, 65536)
        if type(rd) != "bytes" or bytes_len(rd) == 0:
            done = true
            break
        buf = bytes_concat(buf, rd)
        var pull = true
        while pull:
            let r = jr_pull(buf)
            buf = r[0]
            let m = r[1]
            if m == null:
                pull = false
            elif type(m) == "string":
                if m == "__jr_bad__":
                    mcp_err("[pxmcp] 协议坏头（无 Content-Length），终止")
                    jr_write(jr_parse_error_resp())
                    done = true
                else:
                    jr_write(jr_parse_error_resp())
            else:
                let outs = mcp_handle(m)
                var oi = 0
                while oi < len(outs):
                    jr_write(outs[oi])
                    oi += 1
                if jr_method_of(m) == "exit" and jr_classify(m) == "notification":
                    done = true
    return 0
def usage():
    print("pxmcp —— PuXian MCP 服务器（自举，M65-S4）")
    print("用法: pxmcp [--version]")
    print("  服务器入口：stdio 即 MCP transport（pxc mcp 直通执行）")
def main():
    let as_ = args()
    var i = 1
    while i < len(as_):
        let a = as_[i]
        if a == "--version" or a == "-v":
            print("pxmcp " + PXMC_VER + " (普贤 PuXian mcp · " + PXMC_MS + ")")
            exit(0)
        elif a == "--help" or a == "-h":
            usage()
            exit(0)
        elif starts_with(a, "-"):
            mcp_err("pxmcp: 未知选项 '" + a + "'")
            usage()
            exit(1)
        i += 1
    exit(mcp_serve())
