# ---- M71-S1：runtime 预编译 .o 增量缓存（等价 Go build cache）----
# build 不再每次全量现编 runtime*.c：预编译 .o 入 $PXC_HOME/.rtcache/<key>/，
# 命中时只编 base.c + 链接（二次 build 亚秒）。key = runtime 源内容 × cc × no_quic
# → 改 runtime 源码 / 换 cc / 切 quic 自动重建缓存。
# 注意：mbedtls/ngtcp2/openssl 为第三方 git 预置（include 不随 key 变；升级三方库后
#       若缓存行为异常 rm -rf .rtcache 重建即可）。
# ---- M85-S1：模块裁剪开关集（--no-<mod>，与 --no-quic 正交可组合）----
# cuts = 空格分隔的已裁项集合（quic + sqlite ws zip xml aes rsa ed25519 img route zlib h2）
# 每模块对应 runtime 源文件与 -DPX_NO_<MOD> 宏；缓存 key 纳入 cuts（不同裁剪组合缓存隔离）
cut_has() { # $1=cuts串 $2=name → 0 含 / 1 不含
    case " $1 " in *" $2 "*) return 0 ;; *) return 1 ;; esac
}
mod_srcs() { # $1=mod → 该模块 runtime 源文件（空格分隔，从 rt_src_files/cache 剔除）
    case "$1" in
        sqlite)   echo "runtime_sqlite.c" ;;
        ws)       echo "runtime_ws.c" ;;
        zip)      echo "runtime_zip.c" ;;
        xml)      echo "runtime_xml.c" ;;
        aes)      echo "runtime_aes.c" ;;
        rsa)      echo "runtime_rsa.c" ;;
        ed25519)  echo "runtime_ed25519.c tweetnacl.c tweetnacl.h" ;;
        img)      echo "runtime_image.c third_party/stb/stb_image.h third_party/stb/stb_image_write.h" ;;
        onnx)     echo "onnx.h onnx_proto.c onnx_tensor.h onnx_tensor.c onnx_ops.c onnx_exec.c runtime_onnx.c" ;;
        route)    echo "runtime_route.c" ;;
        zlib)     echo "runtime_zlib.c" ;;
        h2)       echo "runtime_h2.c" ;;
    esac
}
mod_macro() { # $1=mod → -DPX_NO_<MOD>
    echo "-DPX_NO_$(echo "$1" | tr '[:lower:]' '[:upper:]')"
}
rt_src_files() {
    # 参数：cuts（空格分隔已裁项）→ 输出需进缓存的 runtime 源（相对 $RT_DIR）
    local cuts="$1"
    local list="runtime.h locktrack.h runtime.c runtime_aes.c runtime_xml.c runtime_zip.c \
        runtime_ws.c runtime_rsa.c runtime_sqlite.c runtime_route.c runtime_h2.c \
        runtime_ffi.c runtime_zlib.c runtime_ed25519.c tweetnacl.c tweetnacl.h \
        runtime_image.c third_party/stb/stb_image.h third_party/stb/stb_image_write.h \
        onnx.h onnx_proto.c onnx_tensor.h onnx_tensor.c onnx_ops.c onnx_exec.c runtime_onnx.c \
        vm.h vm.c coro.c \
        arch.h arch_x86_64.h arch_aarch64.h \
        arch_armv7.h arch_riscv64.h runtime_unicode_tbl.h"
    local m f
    for m in sqlite ws zip xml aes rsa ed25519 img route zlib h2 onnx; do
        if cut_has "$cuts" "$m"; then
            for f in $(mod_srcs "$m"); do
                list="${list/ $f/ }"
            done
        fi
    done
    if ! cut_has "$cuts" "quic"; then
        list="$list runtime_quic.c runtime_h3.c runtime_h3_qpack.c \
            runtime_h3_qpack_dyn.c runtime_h3_qpack.h runtime_h3_qpack_tbl.h \
            runtime_h3_qpack_dyn.h"
    fi
    echo "$list"
}
# ---- M439-1（缺陷 921）：**语义指纹** —— 注释不计入缓存键/源码链指纹 ----
# 病象：改 2 行注释 ⇒ rt_key 变 ⇒ .rtcache 全冷 ⇒ 全量链从 2h 变 2.5–4h
#       （超时红门 914/918 的成因之一）；rebake --check-all 由 14/14 掉到 0/14 ⇒ 重烘。
# 判据：注释不是语义 ⇒ 指纹只认「归一化后的源码」（tools/pxnorm.c）。
#   两档规则：C 档可丢行（行号不进产物，实测 .o 逐字节相同）；
#             .px 档必须保行（行号进模块，错误定位/栈回溯用）。
# 安全阀：缺 cc / 编译失败 / 文件解析异常 ⇒ 全部回落 raw（**等价 M438 之前的口径**），
#   宁可少省一次重烘，不改语义。PX_NORM=raw 可强制关掉（排障用）。
PXNORM_BIN=""
pxnorm_bin() {   # → stdout 打印可执行文件路径；不可用返回 1
    [ "${PX_NORM:-}" = "raw" ] && return 1
    [ -n "${PXNORM_BIN:-}" ] && { printf '%s' "$PXNORM_BIN"; return 0; }
    local src="$PXC_HOME/tools/pxnorm.c" d="$PXC_HOME/.rtcache/bin" k out
    [ -f "$src" ] || return 1
    k="$(sha256sum "$src" 2>/dev/null | cut -c1-16)"; [ -n "$k" ] || return 1
    out="$d/pxnorm-$k"
    if [ ! -x "$out" ]; then
        mkdir -p "$d" 2>/dev/null || return 1
        ${CC:-cc} -O2 -o "$out.$$.tmp" "$src" 2>/dev/null || { rm -f "$out.$$.tmp"; return 1; }
        chmod +x "$out.$$.tmp" 2>/dev/null
        mv -f "$out.$$.tmp" "$out" 2>/dev/null || { rm -f "$out.$$.tmp"; return 1; }
    fi
    PXNORM_BIN="$out"; printf '%s' "$out"
}
# sem_join 文件… → 16hex 语义指纹。
#   两级：先算 raw 键（一次 sha256sum，M430-补 的老口径），命中 .semmap 就零解析返回；
#   未命中才调 pxnorm（约 60–90ms）并把 raw→sem 记进映射 ⇒ 稳态耗时与改口径前相同。
sem_join() {
    local bin raw sem map="$PXC_HOME/.rtcache/.semmap"
    [ $# -gt 0 ] || return 1
    # 逃生口必须在最前面：PX_NORM=raw ⇒ 连映射缓存也不许用（否则「关掉归一化」会被 map 静默绕过，
    #   实测踩过：门 P5 负控在 map 命中时给出与 sem 相同的键）。
    [ "${PX_NORM:-}" = "raw" ] && return 1
    raw="$(sha256sum "$@" 2>/dev/null | cut -c1-16 | tr '\n' ' ' | sha256sum | cut -c1-16)"
    [ -n "$raw" ] || return 1
    if [ -f "$map" ]; then
        sem="$(grep -m1 "^$raw " "$map" 2>/dev/null | cut -d' ' -f2)"
        [ -n "$sem" ] && { printf '%s' "$sem"; return 0; }
    fi
    bin="$(pxnorm_bin)" || return 1
    sem="$("$bin" --join "$@" 2>/dev/null)" || return 1
    [ -n "$sem" ] || return 1
    if mkdir -p "${map%/*}" 2>/dev/null && printf '%s %s\n' "$raw" "$sem" >> "$map" 2>/dev/null; then
        if [ "$(wc -l < "$map" 2>/dev/null || echo 0)" -gt 4096 ]; then
            tail -2048 "$map" > "$map.$$.tmp" 2>/dev/null && mv -f "$map.$$.tmp" "$map" 2>/dev/null
        fi
    fi
    printf '%s' "$sem"
}
rt_key() {
    # 参数：cuts cc [lto] → 16 位缓存键（runtime 源 + miniz + sqlite 头**语义**哈希 + cuts + lto）
    # M430-补：产物缓存（缺陷 883）现在每次 build 都要 rt_key ⇒ 逐文件 `sha256sum` 是 30 次
    #   fork（实测把 m425_build_cache 的 P2 命中耗时顶到 692ms，判据 ≤400ms/≤0.25×冷构建）。
    #   改成**一次** sha256sum 多文件（输出行序由参数序固定，与逐文件拼接等价）。
    # M439-1：键改成 **sem**（注释不计入）⇒ 只改注释不再冷缓存；pxnorm 不可用 ⇒ 回落老的 raw 拼接。
    local cuts="$1" cc="$2" lto="${3:-0}" gcs="${4:-0}" f files="" key_src=""
    for f in $(rt_src_files "$cuts") \
             third_party/miniz/miniz.c third_party/miniz/miniz_tinfl.c \
             third_party/miniz/miniz_tdef.c third_party/miniz/miniz.h \
             third_party/miniz/miniz_common.h third_party/miniz/miniz_tinfl.h \
             third_party/miniz/miniz_tdef.h third_party/miniz/miniz_export.h \
             third_party/sqlite3/sqlite3.h; do
        [ -f "$RT_DIR/$f" ] && files="$files $RT_DIR/$f"
    done
    if ! key_src="$(sem_join $files)"; then
        key_src="$(sha256sum $files 2>/dev/null | cut -c1-16 | tr '\n' ' ')"
    fi
    # M441：gcs=0 时哈希串与改动前**逐字节一致**（不加空字段）—— 让默认路径命中旧
    #   .rtcache 目录：既不冷缓存，产物也逐字节不变（判据实测可验证）。
    echo " $key_src cc=$(basename "$cc") cuts=$cuts lto=$lto$([ "$gcs" = 1 ] && echo " gcs=1")" | sha256sum | cut -c1-16
}
rt_cache_compile() {
    # 参数：dir（cache 目录）cuts cc [lto] [gcs] —— 复制源到 dir 并逐 .c 预编译 .o（一次性）
    local dir="$1" cuts="$2" cc="$3" lto="${4:-0}" gcs="${5:-0}"
    local mbedtls_inc="$RT_DIR/mbedtls/include"
    local zlib_inc="$RT_DIR/third_party/zlib/include"
    local sqlite_dir="$RT_DIR/third_party/sqlite3"
    local f
    # 复制源（同目录相对 include 语义，对齐旧 copy_runtime 的 build_dir 布局）
    for f in $(rt_src_files "$cuts"); do
        cp "$RT_DIR/$f" "$dir/" || return 1
    done
    for f in miniz.c miniz_tinfl.c miniz_tdef.c miniz.h miniz_common.h \
             miniz_tinfl.h miniz_tdef.h miniz_export.h; do
        cp "$RT_DIR/third_party/miniz/$f" "$dir/" 2>/dev/null
    done
    cp "$sqlite_dir/sqlite3.h" "$dir/" 2>/dev/null
    # 预编译 .c（runtime 源 + miniz；sqlite3 走既有预编译 .o/.c 通道不进缓存）
    # ---- M168：**工具链能力预检**（把"缺能力"变成一句可执行的指引）----
    #   实锤（2026-09-21 · el7 终验首跑红）：`runtime/runtime.c` 用 `#include <stdatomic.h>`
    #   + `_Atomic`（C11 原子），而 **gcc 4.9 才支持** —— CentOS 7 自带 **gcc 4.8.5**
    #   ⇒ 报错是 "stdatomic.h: No such file or directory"，用户看到的是"编译器坏了"。
    #   本预检在编译 runtime 前问一次 `$cc` 有没有这个能力；没有就给出**可执行的替代**
    #   （el7：devtoolset / 指定 CC），而不是让 20 个 .c 依次报同一个头文件缺失。
    #   与「静态 libc 预检」（链接前）同族：**缺件要说清缺什么、怎么补**。
    # 作用面：**只对宿主默认编译器**预检（`--cc`/`--target` 的交叉工具链不预检）——
    #   本预检服务的是"宿主 gcc 太老"（el7）这类场景；musl/zig 交叉链的 `<stdatomic.h>`
    #   来自各自工具链、且其自举链已被 CI 的 M159 交叉档覆盖（编译 runtime 全量）。
    #   缩小作用面 = 降低"预检自己成为交叉路径新变量"的风险（**非**修 bug：无证据表明交叉受影响）。
    if [ "$cc" = "${PX_CC:-gcc}" ] && [ "${_PX_C11ATOMIC_OK:-}" != 1 ]; then
        # M191（缺陷 215）：探针文件名必须**唯一** —— 固定名会让两个并发 `px build` 互删探针，
        #   其中一个报「不支持 C11 原子 / 缺静态 libc」而**构建失败**（实测：并发跑门时假红）。
        local _pc _po
        _pc="$(mktemp --suffix=.c "${TMPDIR:-/tmp}/.px_c11probe.XXXXXX")" || { echo "错误: mktemp 失败" >&2; return 1; }
        _po="${_pc%.c}.o"
        printf '#include <stdatomic.h>\nint main(void){_Atomic int x=0;__atomic_store_n(&x,1,__ATOMIC_SEQ_CST);return (int)__atomic_load_n(&x,__ATOMIC_SEQ_CST);}\n' > "$_pc"
        if $cc -c "$_pc" -o "$_po" >/dev/null 2>&1; then
            _PX_C11ATOMIC_OK=1
            rm -f "$_pc" "$_po"
        else
            rm -f "$_pc" "$_po"
            echo "错误: $cc 不支持 C11 原子（<stdatomic.h>）—— PuXian 的 runtime 需要它" >&2
            echo "      需要 gcc ≥ 4.9（本机：$($cc --version 2>/dev/null | head -1)）" >&2
            echo "  ⚠ 最终裁定（2026-09-21）：请自行升级 gcc 到 ≥ 4.9 —— PuXian 不为 gcc < 4.9 提供回退" >&2
            echo "      （C11 原子是 runtime 的硬需求；加兼容层会拖慢并复杂化核心热路径。）" >&2
            echo "  RHEL/CentOS 7（自带 gcc 4.8.5）: sudo yum install -y centos-release-scl" >&2
            echo "      && sudo yum install -y devtoolset-9 && scl enable devtoolset-9 bash" >&2
            echo "      （或 PX_CC=/opt/rh/devtoolset-9/root/usr/bin/gcc $0 build <file.px>）" >&2
            echo "  Debian/Ubuntu: 自带 gcc 均 ≥ 5，通常不需处理" >&2
            return 1
        fi
    fi
    local common="-O2 -pthread -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DEFAULT_FOREIGN_KEYS=1 \
        -I\"$dir\" -I\"$RT_DIR/third_party/miniz\" -I\"$mbedtls_inc\" \
        -I\"$sqlite_dir\" -I\"$zlib_inc\"$([ "$lto" = 1 ] && echo " -flto")$([ "$gcs" = 1 ] && echo " -ffunction-sections -fdata-sections")"
    local m
    for m in quic sqlite ws zip xml aes rsa ed25519 img route zlib h2 onnx; do
        if cut_has "$cuts" "$m"; then
            common="$common $(mod_macro "$m")"
        fi
    done
    if ! cut_has "$cuts" "quic"; then
        common="$common -I\"$RT_DIR/third_party/ngtcp2/include\" -I\"$RT_DIR/third_party/openssl/include\""
    fi
    # 需编译的 .c = rt_src_files 输出中所有 .c（被裁模块已剔除，顺序一致）+ miniz
    local srcs=""
    for f in $(rt_src_files "$cuts"); do
        case "$f" in *.c) srcs="$srcs $f" ;; esac
    done
    srcs="$srcs miniz.c miniz_tinfl.c miniz_tdef.c"
    local src base
    local _err; _err="$(px_cc_err_log)"
    for src in $srcs; do
        base="$(basename "$src" .c)"
        if ! eval "$cc -c $common -o \"$dir/$base.o\" \"$dir/$src\"" 2>>"$_err"; then
            echo "错误: runtime 预编译失败 $src（$cc）—— 日志 $_err" >&2
            tail -20 "$_err" >&2
            return 1
        fi
    done
    rm -f "$_err"
    rt_fp_emit "$dir" "$(basename "$dir")" "$cc" "$common" || return 1
    touch "$dir/.complete"
    return 0
}
# M152（第 34 轮 · 缺陷 144）：**runtime 缓存指纹** —— 把 `PXRT-<key>` 常量编成缓存目录里的
#   一个 .o（`__rtfp.o`）。它随 `$CACHE/*.o` 一起被链进产物 ⇒「这个产物链的是哪份 runtime」
#   从"只能靠目录 mtime 猜"变成**可从产物读回的事实**（与既有 `PXSRC-…` 编译器源码链指纹同族）。
#   为什么必须有：`.rtcache/<key>` 按 key 隔离，但**选中哪个 key** 是另一个问题 ——
#   第 34 轮实锤：`rebake_bin.sh` 的 check_cache 按"目录 mtime 最新"选，源码回退后当前 key 的
#   目录**不是最新写入**（缓存命中不再刷新 mtime）⇒ 把**另一份 runtime** 的 .o 链进入库件，
#   而所有门都绿（门测编译器行为、指纹只看源码，都不看 runtime 层）。
#   实锤证据：以 M151 源码重烘出的 `bootstrap/pxc` 里 `strings | grep PX_GC_TRIGGER_BYTES` = 1
#   （该串只存在于尚未提交的 M152 runtime）。**能"自动挑选"的东西，也要能"自动核对挑对没有"。**
rt_fp_emit() {   # $1=dir $2=key $3=cc $4=common_flags（引号原样，走 eval）
    local dir="$1" key="$2" cc="$3" common="$4"
    [ -f "$dir/__rtfp.o" ] && return 0
    cat > "$dir/__rtfp.c" <<EOF
/* 自动生成（tools/px）：runtime 缓存指纹。勿手改。 */
const char* px_rt_fp_$key(void) { return "PXRT-$key"; }
EOF
    local _err; _err="$(px_cc_err_log)"
    eval "$cc -c $common -o \"$dir/__rtfp.o\" \"$dir/__rtfp.c\"" 2>"$_err" || {
        echo "错误: runtime 缓存指纹编译失败（$cc）—— 日志 $_err" >&2
        tail -20 "$_err" >&2
        return 1
    }
    rm -f "$_err"
    return 0
}
rt_ensure() {
    # 参数：cuts cc [lto] → stdout 输出 cache_dir；缺失则现编
    local cuts="$1" cc="$2" lto="${3:-0}" gcs="${4:-0}" key dir
    key="$(rt_key "$cuts" "$cc" "$lto" "$gcs")"
    dir="$PXC_HOME/.rtcache/$key"
    if [ -d "$dir" ] && [ -f "$dir/.complete" ]; then
        # 旧缓存（M152 前）没有指纹 .o ⇒ 就地补上（不重编 runtime）
        local common="-O2 -pthread -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DEFAULT_FOREIGN_KEYS=1 \
        -I\"$dir\" -I\"$RT_DIR/third_party/miniz\" -I\"$RT_DIR/mbedtls/include\" \
        -I\"$RT_DIR/third_party/sqlite3\" -I\"$RT_DIR/third_party/zlib/include\""
        rt_fp_emit "$dir" "$key" "$cc" "$common" || return 1
        echo "$dir"
        return 0
    fi
    mkdir -p "$dir"
    if ! rt_cache_compile "$dir" "$cuts" "$cc" "$lto" "$gcs"; then
        rm -rf "$dir"
        return 1
    fi
    echo "$dir"
    return 0
}
# ---- M159（R45 · 缺口 G2）：宿主机架构识别 ----
# 存在理由：aarch64/riscv64 **原生**跑 `px build` 此前会失败 —— mbedtls 库路径写死仓库
#   x86_64 布局（lib），QUIC 静态库（ngtcp2/openssl-quictls）只有 x86_64 预置 ⇒ 用户必须手写
#   --cc/--mbedtls-lib/--sqlite-obj/--zlib-lib/--no-quic 一长串（第三方 px-openEuler-bootstrap
#   就是被这条逼出来自己写自举脚本的）。此处把「宿主是谁」变成工具知道的事实。
# PX_HOST_ARCH 可显式覆盖（测试/交叉场景用；空值 = 按 uname 探测）。
host_arch() {
    if [ -n "${PX_HOST_ARCH:-}" ]; then
        echo "$PX_HOST_ARCH"
        return 0
    fi
    local m
    m="$(uname -m 2>/dev/null || echo unknown)"
    case "$m" in
        x86_64|amd64)    echo x86_64 ;;
        aarch64|arm64)   echo aarch64 ;;
        armv7l|armv6l|arm) echo armv7 ;;
        riscv64)         echo riscv64 ;;
        *)               echo "" ;;
    esac
}

# ---- M159（R45 · 缺口 G2 续）：**编译轨二进制可执行性预检** ----
# 存在理由：入库 bootstrap/* 是 x86_64 件 ⇒ aarch64/riscv64 **原生**解压后 `px build`
#   会以 "Exec format error" 收场，用户既看不到「为什么」也看不到「怎么办」（第三方
#   px-openEuler-bootstrap 写自举脚本正是被这一步逼的）。此处把"跑不动"变成一条
#   自带修复命令的诊断。
cmp_runnable() { "$1" --version >/dev/null 2>&1; }
bin_arch_hint() {
    local a=""
    a="$(file -b "$1" 2>/dev/null | sed -n 's/^ELF \([^,]*\).*/\1/p')"
    [ -n "$a" ] && echo "$a" || echo "未知"
}
# 编译轨解析：打印 "<bin>|<sub>"（engine=c → pxc build；engine=vm → pxc_vm --emit-c）
resolve_cmp_bin() {
    local eng="$1"
    if [ "$eng" = "c" ]; then
        # M159：本机架构专用件优先（selfhost/native_bootstrap.sh --install 的落点）——
        #   解压包里 bootstrap/pxc 是 x86_64 件时，aarch64 用户装上本机件即可零参数可用。
        local ha="" sp=""
        ha="$(host_arch)"
        [ -n "$ha" ] && sp="$PXC_HOME/bootstrap/pxc-$ha"
        if [ -n "$sp" ] && [ -x "$sp" ] && cmp_runnable "$sp"; then echo "$sp|build"; return 0; fi
        echo "$PXC_BIN|build"; return 0
    fi
    if [ -n "${PXC_VM_BIN:-}" ]; then echo "$PXC_VM_BIN|--emit-c"; return 0; fi
    if [ -x "$PXC_HOME/bootstrap/pxc_vm" ]; then echo "$PXC_HOME/bootstrap/pxc_vm|--emit-c"; return 0; fi
    echo "$PXC_HOME/selfhost/build/compiler_vm|--emit-c"
}
require_runnable() {   # $1=bin $2=用途标签
    [ -x "$1" ] || { echo "错误: 缺 $2：$1（不存在或不可执行）" >&2; return 1; }
    cmp_runnable "$1" && return 0
    echo "错误: $2 无法在本机执行：$1" >&2
    echo "  本机架构 $(uname -m) ≠ 该二进制架构 $(bin_arch_hint "$1")（入库 bootstrap/* 只带 x86_64 件）" >&2
    echo "  ⇒ 用本机自带 gcc 自举一套原生编译器（只需 gcc，约 1-3 分钟）：" >&2
    echo "       ./selfhost/native_bootstrap.sh --outdir /tmp/px-native-bootstrap" >&2
    echo "       PX_PXC_BIN=/tmp/px-native-bootstrap/pxc PX_BUILD_ENGINE=c px build <file.px>" >&2
    echo "     （发布包内若带 bootstrap/pxc-$(uname -m)，可直接 PX_PXC_BIN=<包>/bootstrap/pxc-$(uname -m)）" >&2
    return 1
}

# ---- M71-S2：--target 高层折叠（对齐 GOOS/GOARCH，交叉 5 flag 折叠为一条命令）----
# 输出键值行：cc / mbedtls_lib / sqlite_obj / zlib_lib / no_quic。
# aarch64 仓库预置库；armv7/riscv64 无仓库预置 → 探测 CI/本机 cross_multiarch
#   --outdir 布局 /opt/px-multiarch/<arch>/（M67 cross cache 约定）。
target_defaults() {
    local arch="$1"
    case "$arch" in
        x86_64)
            echo "cc=gcc"; echo "no_quic=0"
            echo "mbedtls_lib=$RT_DIR/mbedtls/lib"
            echo "sqlite_obj=$RT_DIR/third_party/sqlite3/sqlite3.o"
            echo "zlib_lib=$RT_DIR/third_party/zlib/lib"
            return 0 ;;
        x86_64-windows)
            # Issue 14 W1：OS 维度交叉（GOOS=windows, GOARCH=x86_64）——mingw/zig cc 出 PE
            # .exe。cc 探测：PATH 中 x86_64-w64-mingw32-gcc（EPEL mingw64-gcc 或 zig
            # wrapper 均可）；库布局 lib-windows/ 对齐 lib-<arch> 约定；默认 --no-quic
            # （QUIC/ngtcp2+openssl 交叉 Windows 暂裁剪，M57-S4 边缘线同款）。
            echo "cc=x86_64-w64-mingw32-gcc"; echo "no_quic=1"
            echo "mbedtls_lib=$RT_DIR/mbedtls/lib-windows"
            echo "sqlite_obj=$RT_DIR/third_party/sqlite3/sqlite3-windows.o"
            echo "zlib_lib=$RT_DIR/third_party/zlib/lib-windows"
            return 0 ;;
        aarch64)
            echo "cc=aarch64-linux-musl-gcc"; echo "no_quic=1"
            echo "mbedtls_lib=$RT_DIR/mbedtls/lib-aarch64"
            echo "sqlite_obj=$RT_DIR/third_party/sqlite3/sqlite3-aarch64.o"
            echo "zlib_lib=$RT_DIR/third_party/zlib/lib-aarch64"
            return 0 ;;
        armv7|riscv64)
            local cc="$arch-linux-musl-gcc"
            [ "$arch" = "armv7" ] && cc="armv7l-linux-musleabihf-gcc"
            echo "cc=$cc"; echo "no_quic=1"
            local base="$RT_DIR/mbedtls/lib-$arch"
            local so="$RT_DIR/third_party/sqlite3/sqlite3-$arch.o"
            local zl="$RT_DIR/third_party/zlib/lib-$arch"
            # 仓库未预置 armv7/riscv64 库 → 探测 /opt/px-multiarch/<arch>/ 布局
            if [ ! -d "$base" ] && [ -d "/opt/px-multiarch/$arch/mbedtls/lib-$arch" ]; then
                base="/opt/px-multiarch/$arch/mbedtls/lib-$arch"
                so="/opt/px-multiarch/$arch/sqlite3/sqlite3-$arch.o"
                zl="/opt/px-multiarch/$arch/zlib/lib-$arch"
            fi
            echo "mbedtls_lib=$base"; echo "sqlite_obj=$so"; echo "zlib_lib=$zl"
            return 0 ;;
        *)
            echo "错误: 未知 --target $arch（支持 x86_64|x86_64-windows|aarch64|armv7|riscv64）" >&2
            return 1 ;;
    esac
}

# build：AST → C → gcc 静态二进制（对齐 Rust run_build）
# ── M442-S3：`px build --pxe` —— 轻轨（只发射 PXE1 字节码，不链 runtime）────────
# 为什么单开一条轨：静态产物 3.15MB 里 ~3MB 是 runtime；.pxe 只带程序自己的字节码
#   （实测 hello 331B / 带 if 486B / 结构体 515B / 闭包 743B / pxslice 5.4KB），
#   runtime 由宿主 pxvm 提供 ⇒ 「一份 runtime 加载任意多个模块」（M444 的方向）。
# 口径：
#   · 编译前端与静态轨**同一件**（pxc_vm），只把 --emit-c 换成 --emit-pxe；
#   · 产物落 <src>/build/<base>.pxe，不污染源码目录（编译器 --out 直接写目标路径）；
#   · 缓存 key 与静态产物缓存同源但 **engine=vm-pxe 分桶**（否则两种产物串味）；
#   · 命中前校验 sha16；写盘先 tmp 再 mv。
cmd_build_pxe() { # $1=file.px $2=cc
    local file="$1" cc="${2:-gcc}"
    local parent base build_dir out
    parent="$(cd "$(dirname "$file")" 2>/dev/null && pwd)" \
        || { echo "错误: 无法进入目录 $(dirname "$file")" >&2; return 1; }
    base="$(basename "$file")"
    case "$base" in *.px) base="${base%.px}" ;; esac
    build_dir="$parent/build"
    mkdir -p "$build_dir" 2>/dev/null
    out="$build_dir/$base.pxe"

    local cmp_bin cmp_sub
    IFS='|' read -r cmp_bin cmp_sub <<< "$(resolve_cmp_bin vm)"
    require_runnable "$cmp_bin" "编译轨（--pxe）" || return 1

    # ---- .pxecache：与静态产物缓存同源分桶 ----
    local bkey="" cdir="" hit=0
    if [ -z "${PX_BUILD_NOCACHE:-}" ]; then
        bkey="$(build_cache_key "$(readlink -f "$file" 2>/dev/null || echo "$file")" \
                               "$base" "vm-pxe" 0 "$cc" 0 "" "" 0 0)"
        if [ -n "$bkey" ]; then
            cdir="$BUILD_CACHE/$bkey"
            if [ -f "$cdir/prog.pxe" ] && [ -f "$cdir/prog.pxe.sha16" ] \
               && [ "$(sha256sum "$cdir/prog.pxe" 2>/dev/null | cut -c1-16)" = "$(cat "$cdir/prog.pxe.sha16" 2>/dev/null)" ]; then
                if cp -f "$cdir/prog.pxe" "$out.$$" 2>/dev/null \
                   && chmod 644 "$out.$$" 2>/dev/null \
                   && mv -f "$out.$$" "$out" 2>/dev/null; then
                    hit=1
                else
                    rm -f "$out.$$" 2>/dev/null
                fi
            fi
        fi
    fi
    if [ "$hit" = 1 ]; then
        if [ "${PX_BUILD_VERBOSE:-0}" = "1" ]; then
            echo "[px build --pxe] 缓存命中 key=$bkey（跳过 emit-pxe）" >&2
        fi
        echo "编译成功(PXE): $out （$(stat -c %s "$out" 2>/dev/null || echo 0) 字节）"
        return 0
    fi

    # ---- 发射（tmp → mv，读者不会看到半个文件）----
    local tmp="$out.tmp.$$" terr="$out.tmp.$$.err"
    if ! "$cmp_bin" --emit-pxe --out "$tmp" "$file" >/dev/null 2>"$terr"; then
        echo "错误: .pxe 发射失败（$file）" >&2
        [ -s "$terr" ] && head -10 "$terr" >&2
        echo "  若提示未知子命令 --emit-pxe：当前编译器不带 .pxe 发射能力" >&2
        echo "  ⇒ 仓库内：./selfhost/rebake_bin.sh --entries=pxc,pxc_vm  重新烘出" >&2
        rm -f "$tmp" "$terr"
        return 1
    fi
    if [ -s "$terr" ]; then
        echo "警告: 编译期诊断（$file）:" >&2
        head -10 "$terr" >&2
    fi
    rm -f "$terr"
    [ -s "$tmp" ] || { echo "错误: 编译器产出了空文件（$file）" >&2; rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$out" || { rm -f "$tmp"; return 1; }

    # ---- 写缓存 ----
    if [ -n "$cdir" ]; then
        mkdir -p "$cdir" 2>/dev/null
        if cp -f "$out" "$cdir/prog.pxe.$$" 2>/dev/null \
           && mv -f "$cdir/prog.pxe.$$" "$cdir/prog.pxe" 2>/dev/null; then
            sha256sum "$cdir/prog.pxe" 2>/dev/null | cut -c1-16 > "$cdir/prog.pxe.sha16"
        else
            rm -f "$cdir/prog.pxe.$$" 2>/dev/null
        fi
    fi
    echo "编译成功(PXE): $out （$(stat -c %s "$out" 2>/dev/null || echo 0) 字节）"
    return 0
}

# M442-S3：.pxe 宿主解析（运行 .pxe 必需）。顺序：环境变量 > 仓库 bootstrap > 安装目录
resolve_pxvm_bin() {
    local c
    for c in "${PXVM_BIN:-}" "$PXC_HOME/bootstrap/pxvm" "$PXC_HOME/bin/pxvm" \
             "/usr/share/puxian/bin/pxvm" "/usr/share/puxian/bootstrap/pxvm"; do
        [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
    done
    echo "错误: 找不到 pxvm（运行 .pxe 的宿主程序）" >&2
    echo "  仓库内构建：./selfhost/build_pxvm.sh \$PXC_HOME/bootstrap/pxvm" >&2
    echo "  rpm 安装包：/usr/share/puxian/bin/pxvm（v0.2.445 起随包分发）" >&2
    return 1
}
cmd_run_pxe() { # $1=.pxe [程序参数…]
    local pf="$1"; shift 2>/dev/null || true
    local vm
    vm="$(resolve_pxvm_bin)" || return 2
    exec "$vm" "$pf" "$@"
}

# ══════════════════════════════════════════════════════════════
# M444（缺陷 932）：构建前「入口级定义检查」
# ------------------------------------------------------------
# 病史（2026-11-24）：ws-todo 的兜底函数 infer_ws_root_from_argv 里写了 to_str(...)，
#   而 to_str 从未定义 —— 编译成功、**运行到兜底路径才炸** R1001；偏偏那条路径正是
#   「WS_PATH 缺失」的救命索 ⇒ 兜底比没有兜底更糟。
#   三条轨（解释 / 字节码 / C）都只在「运行到那一刻」查名字，构建期一个字都不查。
#
# 为什么放在 build 而不是塞进 sema（实测依据，不是口味）：
#   全仓 lint 扫 selfhost/ 24 件 ⇒ L002 报 1000+ 处假红（bc_emit 112 / cg_expr 176 /
#   ibuiltin 295 …）—— 这些**模块文件**按惯例引用「主文件声明的全局」（interp.px 同构
#   惯例），单文件静态分析看不到宿主那一份声明。把这种判定塞进编译期 ⇒ 现有构建全判红。
#   而**入口文件**这一层是干净的：examples/*.px 120 个入口 L002 = 0 处（实测）。
#   ⇒ 检查的边界 = 「用户交付的入口程序」，正是 ws-todo 那类程序的位置。
#
# 口径：只看 E L002（未定义标识符）；L001/L003 等风格项不管（那是 px lint 的事）。
# 口径豁免（2026-11-25 05:5x 实测，写死在代码里、注释里给了病历）：
#   未定义名以 `__` 开头 —— runtime 内部注入名（不进名册），pxlint 必然看不到
# 版本身份：**门外 error（拒构建）· 门里 warn（出声不阻断）** —— run_gates.sh 统一导出
#   PX_DEFCHK=warn；要严格档的门自己 PX_DEFCHK=error 覆盖。
# 逃生舱（两个，各有用处）：
#   PX_SKIP_DEFCHK=1  完全关闭（旧布局/特殊夹具）
#   PX_DEFCHK=warn    降级为告警（迁移期：先看看有多少存量，不阻断构建）
# 零命中即放过；检查器不存在也放过（不因为「检查器没装」把构建打死）。
defchk_entry() {   # defchk_entry <file.px> → 0 通过/跳过 · 1 发现未定义标识符
    local f="$1" mode="${PX_DEFCHK:-error}" out n002 nint raw
    [ "${PX_SKIP_DEFCHK:-0}" = "1" ] && return 0
    [ -n "${PXLINT_BIN:-}" ] && [ -x "$PXLINT_BIN" ] || return 0
    [ -f "$f" ] || return 0
    out="$("$PXLINT_BIN" "$f" 2>&1)" || true
    # import 在静态期解析不到 ⇒ pxlint 已剔除全部 L002 并给 L010 警告（M444）。
    #   构建期的工作区路径可能与 lint 那一刻不同（实测 examples/m282_registry_020 的
    #   ftp 探针：import ../registry/... 只在 gate 的临时工作区里成立）⇒ 此时判红就是误杀。
    if printf '%s\n' "$out" | grep -q 'L010'; then
        echo "提示: 该文件的 import 无法在静态期解析 ⇒ 跳过未定义标识符检查（构建期路径可能不同）" >&2
        return 0
    fi
    raw="$(printf '%s\n' "$out" | grep 'E L002' || true)"
    # 豁免②（M444 修 · 实测 selfhost/interp.px 2 处）：`__` 前缀 = runtime **内部注入名**
    #   （runtime.c 明文注释「`__` 前缀 = 内部名，不进公开名册/索引」，gen_builtin_list.sh
    #   ① 也按 `__` 排除）⇒ 名册里永远没有 __guard_call / __iter_len，pxlint 必报 L002。
    #   这不是「未定义」，是名册口径的已知边界 ⇒ 不计入判红，但要出声（可见、不静默）。
    nint="$(printf '%s\n' "$raw" | grep -cE "未定义变量: *['\"]?__" || true)"
    nint="${nint:-0}"
    [ "$nint" -gt 0 ] && echo "提示: 另有 $nint 处 \`__\` 内部名（runtime 注入，不进名册）⇒ 不计" >&2
    n002="$(printf '%s\n' "$raw" | grep -vE "未定义变量: *['\"]?__" | grep -c . || true)"
    n002="${n002:-0}"
    [ "$n002" -gt 0 ] || return 0
    printf '%s\n' "$raw" | grep -vE "未定义变量: *['\"]?__" | head -20 >&2
    [ "$n002" -le 20 ] || echo "   ……（共 $n002 处，只列前 20）" >&2
    if [ "$mode" = "warn" ]; then
        echo "警告: 入口文件有 $n002 处未定义标识符（L002）· PX_DEFCHK=warn ⇒ 本次不阻断" >&2
        return 0
    fi
    echo "错误: 构建前静态检查发现 $n002 处未定义标识符（L002）——" >&2
    echo "  编译期不查这个名字，只有运行到那条路径才会 R1001 炸掉（缺陷 932）。" >&2
    echo "  修改源文件补上定义/改正拼写；确有需要绕过：PX_SKIP_DEFCHK=1 px build …" >&2
    echo "  只想先看告警不阻断：PX_DEFCHK=warn px build …" >&2
    return 1
}

cmd_build() {    # M91：默认引擎 = vm（VM 字节码轨）。优先级：显式 flag(--c/--vm/--bc，后写胜)
    #   > PX_BUILD_ENGINE env(c|vm) > 默认 vm。--c = C 轨逃生舱（fn_* 文本轨）。
    # M168：宿主编译器可用 PX_CC 覆盖（el7 的 devtoolset 场景：PX_CC=/opt/rh/devtoolset-9/root/usr/bin/gcc）
    local no_quic=0 cc="${PX_CC:-gcc}" mbedtls_lib="" sqlite_obj="" zlib_lib="" target="" full=0
    local engine="${PX_BUILD_ENGINE:-vm}"
    # M104-S5：LTO 构建档（--lto / PX_BUILD_LTO=1）—— 跨 TU 内联（D0 实测 C 轨 1.16x）。
    #   默认 0（保持既有构建口径）；开启时 runtime 预编译缓存键含 lto 位，不与默认档混用。
    local lto=0
    case "${PX_BUILD_LTO:-0}" in 1|true|yes|on) lto=1 ;; esac
    case "$engine" in
        c|vm) ;;
        *) echo "警告: 未知 PX_BUILD_ENGINE=$engine（取 c|vm，退默认 vm）" >&2; engine=vm ;;
    esac
    local mods="" cuts=""
    local cc_set=0 no_quic_set=0 print_plan=0 gcs=0 pxe=0
    [ "${PX_BUILD_PRINT_PLAN:-0}" = "1" ] && print_plan=1
    while [ $# -gt 0 ]; do
        case "$1" in
            --print-plan) print_plan=1; shift ;;
            --no-quic) no_quic=1; no_quic_set=1; shift ;;
            --min) no_quic=1; no_quic_set=1; mods="$mods sqlite ws zip xml aes rsa ed25519 img route zlib h2 onnx"; shift ;;
            --full|--max) full=1; shift ;;
            --c) engine=c; shift ;;              # M91：C 轨逃生舱（显式）
            --vm|--bc) engine=vm; shift ;;       # M91：VM 轨（显式 = 新默认；保留旧 flag 兼容）
            --lto) lto=1; shift ;;               # M104-S5：LTO 构建档（gcc -flto 全链）
            --no-sqlite) mods="$mods sqlite"; shift ;;
            --no-ws) mods="$mods ws"; shift ;;
            --no-zip) mods="$mods zip"; shift ;;
            --no-xml) mods="$mods xml"; shift ;;
            --no-aes) mods="$mods aes"; shift ;;
            --no-rsa) mods="$mods rsa"; shift ;;
            --no-ed25519) mods="$mods ed25519"; shift ;;
            --no-img) mods="$mods img"; shift ;;
            --no-route) mods="$mods route"; shift ;;
            --no-zlib) mods="$mods zlib"; shift ;;
            --no-h2) mods="$mods h2"; shift ;;
            # M441（缺陷 923）：onnx 的 runtime 侧裁剪（-DPX_NO_ONNX + 源文件移出编译集 +
            #   native_mod_map 条目）自 M156 起就全部就绪，**只差 tools/px 这一处未接线** ——
            #   实测基线：hello.px 默认产物 nm | grep -c onnx = 121 个符号 / 56,090B（1.8%）。
            --no-onnx) mods="$mods onnx"; shift ;;
            # M441：--gc-sections（**opt-in，默认行为不变**）—— 编译期 -ffunction-sections
            #   -fdata-sections，链接期 -Wl,--gc-sections。口径同 --prune：不默认、不动默认产物。
            --gc-sections) gcs=1; shift ;;
            # M442-S3：`px build --pxe` —— 轻轨：只发射 PXE1 字节码，**不链 runtime**。
            #   产物 <src>/build/<base>.pxe（几百字节～几 KB），由宿主 pxvm 执行。
            #   与静态轨共用同一编译前端（pxc_vm），只把 --emit-c 换成 --emit-pxe。
            --pxe) pxe=1; shift ;;
            --cc) cc="$2"; cc_set=1; shift 2 ;;
            --target|-t) target="$2"; shift 2 ;;
            --mbedtls-lib) mbedtls_lib="$2"; shift 2 ;;
            --sqlite-obj) sqlite_obj="$2"; shift 2 ;;
            --zlib-lib) zlib_lib="$2"; shift 2 ;;
            -h|--help) usage; return 0 ;;
            --) shift; break ;;
            -*) echo "未知选项: $1" >&2; usage >&2; return 1 ;;
            *) break ;;
        esac
    done
    local file="${1:-}"
    [ -n "$file" ] || { echo "用法: px build [选项] <file.px>" >&2; exit 1; }
    [ -f "$file" ] || { echo "错误: 无法读取文件 $file" >&2; return 1; }
    # M444（缺陷 932）：构建前入口级定义检查 —— 放在 --pxe 分叉**之前**，
    #   两条轨（静态 / 轻轨）都必须过这一关，否则「换个 flag 就绕过检查」。
    defchk_entry "$file" || return 1
    # M442-S3：--pxe 轻轨在此分叉 —— 后续 --target/静态库/引用集裁剪全都与它无关
    if [ "$pxe" = 1 ]; then
        cmd_build_pxe "$file" "$cc"
        return $?
    fi
    # M71-S2：--target 高层折叠（显式 flag 优先于 target 默认；缺省 x86_64 语义 = 现状）
    if [ -n "$target" ]; then
        local t_out t_cc="" t_mb="" t_so="" t_zl="" t_nq=""
        t_out="$(target_defaults "$target")" || return 1
        local t_line
        while IFS= read -r t_line; do
            case "$t_line" in
                cc=*) t_cc="${t_line#cc=}" ;;
                mbedtls_lib=*) t_mb="${t_line#mbedtls_lib=}" ;;
                sqlite_obj=*) t_so="${t_line#sqlite_obj=}" ;;
                zlib_lib=*) t_zl="${t_line#zlib_lib=}" ;;
                no_quic=*) t_nq="${t_line#no_quic=}" ;;
            esac
        done <<< "$t_out"
        [ "$cc_set" = 1 ] || cc="$t_cc"
        [ "$no_quic_set" = 1 ] || no_quic="${t_nq:-0}"
        [ "$mbedtls_lib" = "" ] && mbedtls_lib="$t_mb"
        [ "$sqlite_obj" = "" ] && sqlite_obj="$t_so"
        [ "$zlib_lib" = "" ] && zlib_lib="$t_zl"
        # 交叉 cc 不在 PATH → 友好指引（不联网下载；CI/用户自备工具链）
        if ! command -v "$cc" >/dev/null 2>&1; then
            echo "错误: --target $target 需要交叉编译器 $cc（不在 PATH）" >&2
            echo "  获取方式（任一）：" >&2
            echo "    1) musl.cc：https://musl.cc/ 下载 ${cc%-gcc}-cross.tgz，解压把 bin 加入 PATH" >&2
            echo "    2) zig cc：装 zig 后建 wrapper（${cc%-gcc}-gcc → 'zig cc -target <triple>'）入 PATH（CI 已用此路）" >&2
            echo "    3) 交叉静态库：armv7/riscv64 先 tools/cross_multiarch.sh --arch $target --outdir /opt/px-multiarch/$target（aarch64 库仓库已预置）" >&2
            return 1
        fi
        # 目标架构静态库完整性检查
        if [ ! -d "$mbedtls_lib" ] || [ ! -f "$mbedtls_lib/libmbedcrypto.a" ]            || [ ! -f "$sqlite_obj" ] || [ ! -f "$zlib_lib/libz.a" ]; then
            echo "错误: --target $target 缺目标架构静态库（mbedtls/sqlite3/zlib）" >&2
            echo "  仓库预置：aarch64 已含 runtime/mbedtls/lib-aarch64 + sqlite3-aarch64.o + zlib/lib-aarch64" >&2
            echo "  armv7/riscv64：先 tools/cross_multiarch.sh --arch $target --outdir /opt/px-multiarch/$target 现编" >&2
            return 1
        fi
    fi
    # ---- M159（R45 · 缺口 G2）：宿主机架构自适应（未给 --target 时生效）----
    #   规则：① 未显式 --mbedtls-lib/--sqlite-obj/--zlib-lib ⇒ 取 lib-<host> 布局；
    #         ② 宿主非 x86_64 ⇒ 自动 --no-quic（QUIC/H3 预编译库仅 x86_64），**明确提示**，
    #            不静默；逃生舱 PX_HOST_QUIC=1（自备该架构 QUIC 库时用）；
    #         ③ 显式 flag 一律优先；--target 交叉语义完全不受影响（走上支 target_defaults）。
    local host_a=""
    host_a="$(host_arch)"
    if [ -z "$target" ] && [ -n "$host_a" ] && [ "$host_a" != "x86_64" ]; then
        local host_mb="$RT_DIR/mbedtls/lib-$host_a"
        local host_so="$RT_DIR/third_party/sqlite3/sqlite3-$host_a.o"
        local host_zl="$RT_DIR/third_party/zlib/lib-$host_a"
        # armv7/riscv64 仓库未预置 → 与 --target 同款约定：探测 /opt/px-multiarch/<arch>/
        if [ ! -f "$host_mb/libmbedcrypto.a" ] && [ -d "/opt/px-multiarch/$host_a/mbedtls/lib-$host_a" ]; then
            host_mb="/opt/px-multiarch/$host_a/mbedtls/lib-$host_a"
            host_so="/opt/px-multiarch/$host_a/sqlite3/sqlite3-$host_a.o"
            host_zl="/opt/px-multiarch/$host_a/zlib/lib-$host_a"
        fi
        if [ "$mbedtls_lib" = "" ]; then
            if [ ! -f "$host_mb/libmbedcrypto.a" ]; then
                echo "错误: 宿主机 $host_a 缺预置 mbedtls 静态库 $host_mb/libmbedcrypto.a" >&2
                echo "  获取方式：tools/cross_aarch64.sh（aarch64）或 tools/cross_multiarch.sh --arch $host_a --outdir /opt/px-multiarch/$host_a" >&2
                echo "  亦可显式指定：px build --mbedtls-lib <dir> --sqlite-obj <file> --zlib-lib <dir> <file.px>" >&2
                return 1
            fi
            mbedtls_lib="$host_mb"
        fi
        [ "$sqlite_obj" = "" ] && [ -f "$host_so" ] && sqlite_obj="$host_so"
        [ "$zlib_lib" = "" ] && [ -f "$host_zl/libz.a" ] && zlib_lib="$host_zl"
        if [ "$no_quic_set" = 0 ] && [ "${PX_HOST_QUIC:-0}" != "1" ]; then
            no_quic=1
            echo "提示: 宿主机 $host_a —— QUIC/H3 预编译静态库（ngtcp2/openssl-quictls）仅 x86_64 提供" >&2
            echo "      ⇒ 本次自动 --no-quic（该平台 QUIC/H3 能力不可用；自备库可设 PX_HOST_QUIC=1 保留）" >&2
        fi
    fi
    [ "$mbedtls_lib" = "" ] && mbedtls_lib="$RT_DIR/mbedtls/lib"
    # ---- M159（R45）：宿主非 x86_64 ⇒ VM 轨自动落 C 轨（明确提示，不静默）----
    # ---- M168（分发可移植性收口）：判据由「**架构不符**」放宽为「**本机跑不起来**」----
    #   实锤（2026-09-21 用户报障同源）：入库 bootstrap/pxc_vm 曾是**动态件**且要求
    #   GLIBC_2.34 ⇒ 在 el7（glibc 2.17）上 `px build`（用户面默认 VM 轨）一 exec 就崩；
    #   而旧判据只看「宿主架构 ≠ x86_64」⇒ **x86_64 的 el7 被整类漏掉**（架构对、
    #   glibc 不够）。现在统一按「能否在本机执行」判定，失败即落 C 轨并说明真实原因；
    #   要强制失败（例如 CI 断言 VM 轨可用）设 PX_STRICT_VM=1。
    if [ "$engine" = "vm" ] && [ -z "${PXC_VM_BIN:-}" ]; then
        local _vmb="$PXC_HOME/bootstrap/pxc_vm"
        if [ ! -x "$_vmb" ] || ! cmp_runnable "$_vmb"; then
            if [ "${PX_STRICT_VM:-0}" = 1 ]; then
                echo "错误: PX_STRICT_VM=1 要求 VM 轨可用，但 $_vmb 在本机不可执行" >&2
                echo "  件架构 $(bin_arch_hint "$_vmb") / 本机 $(uname -m)" >&2
                echo "  依赖自检：selfhost/check_bin_portability.sh $_vmb" >&2
                return 1
            fi
            engine=c
            echo "提示: 入库 VM 版编译器（bootstrap/pxc_vm）**在本机不可执行** ⇒ 本次自动走 C 轨（= PX_BUILD_ENGINE=c）" >&2
            echo "      件架构 $(bin_arch_hint "$_vmb") / 本机 $(uname -m)；常见原因：① 跨架构 ② 该件所需 glibc 高于本机" >&2
            echo "      依赖自检：selfhost/check_bin_portability.sh $_vmb" >&2
            echo "      自备本机 VM 件时设 PXC_VM_BIN 保留 VM 轨；要它对失败响亮报错设 PX_STRICT_VM=1" >&2
        fi
    fi
    # M61-S0：zlib 外部静态库 —— 显式 --zlib-lib 优先，否则按 cc 架构自动探测
    # M67-S5：多架构扩展（aarch64/armv7/riscv64 → lib-<arch>，缺省 lib 兼容）
    if [ "$zlib_lib" = "" ]; then
        case "$cc" in
            *aarch64*) zlib_lib="$RT_DIR/third_party/zlib/lib-aarch64" ;;
            *armv7*)   zlib_lib="$RT_DIR/third_party/zlib/lib-armv7" ;;
            *riscv64*) zlib_lib="$RT_DIR/third_party/zlib/lib-riscv64" ;;
            *)         zlib_lib="$RT_DIR/third_party/zlib/lib" ;;
        esac
    fi
    [ -f "$zlib_lib/libz.a" ] || { echo "错误: 缺少 zlib 静态库 $zlib_lib/libz.a（先跑 tools/build_zlib.sh）" >&2; return 1; }
    # M159：--print-plan（或 PX_BUILD_PRINT_PLAN=1）—— 打印"解析后的构建计划"后退出（不编译）。
    #   存在理由：宿主架构自适应这类决策**无法在 x86_64 上端到端验证**（跨架构库装不进本机
    #   链接器）⇒ 把决策本身做成可断言输出，配合 PX_HOST_ARCH 覆盖即可在任意宿主上把关。
    if [ "$print_plan" = 1 ]; then
        echo "plan: host_arch=$host_a"
        echo "plan: cc=$cc"
        echo "plan: engine=$engine"
        echo "plan: target=${target:-<none>}"
        echo "plan: mbedtls_lib=$mbedtls_lib"
        echo "plan: sqlite_obj=$sqlite_obj"
        echo "plan: zlib_lib=$zlib_lib"
        echo "plan: no_quic=$no_quic"
        echo "plan: lto=$lto"
        echo "plan: file=$file"
        local _cb="" _cs=""
        IFS='|' read -r _cb _cs <<< "$(resolve_cmp_bin "$engine")"
        echo "plan: pxc=$_cb"
        echo "plan: pxc_sub=$_cs"
        if [ ! -x "$_cb" ]; then echo "plan: pxc_run=missing"
        elif cmp_runnable "$_cb"; then echo "plan: pxc_run=ok"
        else echo "plan: pxc_run=other-arch"; fi
        return 0
    fi
    local base parent build_dir
    base="$(basename "$file" .px)"
    parent="$(cd "$(dirname "$file")" && pwd)"
    build_dir="$parent/build"
    mkdir -p "$build_dir"

    # ---- M168：清掉输出目录里的 **runtime 影子副本**（缺陷 151 同源，用户面同一条纪律）----
    #   症状（本机复现）：`px build tools/pxfmt.px` 报
    #     warning: implicit declaration of function 'px_dict_get_ci' / 'px_exit_code_final'
    #   成因：生成 C 里的 `#include "runtime.h"` 搜索顺序是「**包含者所在目录** → -I 列表」，
    #     而输出目录里若躺着**旧版 px 留下的** runtime.{h,c}（本仓 tools/build/ 就有
    #     2026-09-05 那一批），它会盖过「按当前源码生成的 -I $cache_dir」⇒ 生成的 C 对着
    #     **旧头**编译（新增的原型对它不可见）。`selfhost/rebake_bin.sh`（M155/缺陷 151）
    #     早已有同名清理；此处把同一条纪律搬到用户面，免得用户以为"编译器坏了"。
    local _sf
    for _sf in runtime.h runtime.c vm.h vm.c; do
        if [ -e "$build_dir/$_sf" ]; then
            rm -f "$build_dir/$_sf"
            echo "提示: 已清理输出目录里的运行时影子副本 $_sf（旧头会遮蔽 -I 解析 ⇒ 误报 implicit declaration）" >&2
        fi
    done

    local c_path="$build_dir/$base.c"
    local out_path="$build_dir/$base"

    # ── M425（缺陷 866）：**产物缓存** —— 同一份源码重复构建白付 ~1.3 s ────────────
    #   实测（2026-11-20 本机 · 3 行程序连跑 5 次）：1251/1345/1371/1372/1623 ms，
    #   产物逐字节相同；拆解 emit-c 11 ms + gcc -c 128 ms + **静态链接 ≈1.1 s**。
    #   `.rtcache` 只缓存 runtime 的 .o（按引用集分桶），用户程序这一层零缓存。
    # 口径：缓存只许影响快慢，不许影响语义 ——
    #   key = 主脚本内容 + 依赖闭包内容 + 工具链指纹 + 构建 flag 签名 + **产物 basename**
    #     （实测产物内嵌程序名：aaa.px 与 bbb.px 同内容 ⇒ 产物 sha 不同；名不进 key 就串味）
    #   命中前校验产物 sha16（M271 同口径）；写盘先 tmp 再 mv（读者不会看到半个二进制）
    #   有编译期诊断（.c.stderr 非空）⇒ 不写缓存（诊断不许被缓存吞掉）
    #   --print-plan / --target（交叉）/ PX_BUILD_NOCACHE=1 ⇒ 完全绕过
    local bkey="" bdir="" cache_hit=0
    if [ "$print_plan" = 0 ] && [ -z "${PX_BUILD_NOCACHE:-}" ] && [ -z "$target" ]; then
        bkey="$(build_cache_key "$(readlink -f "$file" 2>/dev/null || echo "$file")" \
                               "$base" "$engine" "$lto" "$cc" "$no_quic" "$mods" "$cuts" "$full" "$gcs")"
        if [ -n "$bkey" ]; then
            bdir="$BUILD_CACHE/$bkey"
            if [ -f "$bdir/prog" ] && [ -f "$bdir/prog.sha16" ] \
               && [ "$(sha256sum "$bdir/prog" 2>/dev/null | cut -c1-16)" = "$(cat "$bdir/prog.sha16" 2>/dev/null)" ]; then
                if cp -f "$bdir/prog" "$out_path.pxcache.$$" 2>/dev/null \
                   && chmod 755 "$out_path.pxcache.$$" 2>/dev/null \
                   && mv -f "$out_path.pxcache.$$" "$out_path" 2>/dev/null; then
                    cache_hit=1
                else
                    rm -f "$out_path.pxcache.$$" 2>/dev/null
                fi
            fi
        fi
    fi
    if [ "$cache_hit" = 1 ]; then
        [ -f "$bdir/prog.c" ] && cp -f "$bdir/prog.c" "$c_path" 2>/dev/null
        [ -f "$bdir/prog.o" ] && cp -f "$bdir/prog.o" "$build_dir/$base.o" 2>/dev/null
        if [ "${PX_BUILD_VERBOSE:-0}" = "1" ]; then
            echo "[px build] 缓存命中 key=$bkey（跳过 emit-c + gcc + 链接）" >&2
        fi
        local _csz; _csz=$(stat -c %s "$out_path" 2>/dev/null || echo 0)
        echo "编译成功: $out_path （$_csz 字节）"
        return 0
    fi

    # 1) PuXian 版编译器生成产物 C 源码（stdout）：
    #    VM 轨（默认 engine=vm）= VM 版编译器 --emit-c：BCModule 字节码镜像 C
    #      （M89-S3-C2 试做 / M91 默认化）→ 链 runtime 含 vm.o → 显式帧 VM 执行
    #    C 轨（--c / PX_BUILD_ENGINE=c 逃生舱）= bootstrap/pxc build（fn_* C 文本）
    # M159（R45）：编译轨解析 + **可执行性预检**（跨架构解压即用的核心诊断）
    local cmp_bin="" cmp_sub=""
    IFS='|' read -r cmp_bin cmp_sub <<< "$(resolve_cmp_bin "$engine")"
    require_runnable "$cmp_bin" "编译轨（engine=$engine）" || {
        if [ "$engine" = "vm" ] && [ -n "$host_a" ] && [ "$host_a" != "x86_64" ]; then
            echo "  本机非 x86_64 ⇒ VM 轨不可用；加 PX_BUILD_ENGINE=c 走 C 轨（配本机自举件）" >&2
        fi
        echo "  逃生舱：PX_BUILD_ENGINE=c（C 轨）/ PXC_VM_BIN（自备 VM 件）/ PX_PXC_BIN（自备 C 轨件）" >&2
        return 1
    }
    # M112-S0（Issue 45）：产物 = stdout，诊断 = stderr —— 必须分 fd。
    #   原先 `> "$c_path" 2>/dev/null` 把 stderr 丢掉，而编译器把报错写 stdout
    #   （cg_perr 旧实现用 print）→ 错误文本被当作 C 源码存进 .c。
    local cerr_log="${c_path}.stderr"
    if ! "$cmp_bin" $cmp_sub "$file" > "$c_path" 2> "$cerr_log"; then
        echo "错误: 编译失败（$file）" >&2
        head -20 "$cerr_log" >&2
        return 1
    fi
    # M112-S0（Issue 42）：编译成功但有非致命诊断（如模块缺失）→ 透传给用户，不再吞掉
    if [ -s "$cerr_log" ]; then
        echo "警告: 编译期诊断（$file）:" >&2
        head -20 "$cerr_log" >&2
    fi
    # 2) M71-S1：runtime 预编译 .o 缓存（命中 → 只编 base.c + 链接；miss → 现编入缓存）
    local cache_dir
    # M86-S2 / M91：自动按需裁剪 —— 裸 `px build <file>` = 按引用集自动最小；
    #   --full / --max 逃生舱 = 全能力（跳过自动）。优先级：
    #   显式 flag（--no-xxx / --min / --no-quic / --target 物理约束）> 自动；
    #   自动只补"未显式声明"且"引用集未命中"的模块。引用集提取分轨：
    #   C 轨 = C 产物 px_get_global；VM 轨产物无 px_get_global → 提取 BCModule
    #   镜像 s_G 字符串表（全部全局/native 引用名，等价信息，实测含 http_serve
    #   等 native）。后续 map 反推/补裁逻辑两轨共用。
    if [ "$full" = 0 ]; then
        local refs_tmp used am
        refs_tmp="$(mktemp /tmp/px_auto_refs_XXXXXX)" || return 1
        if [ "$engine" = "vm" ]; then
            # 提取 `static const char* s_G[] = { "a", "b", ... };` 块内字符串
            sed -n '/s_G\[\] = {/,/};/p' "$c_path" \
                | grep -oE '"([^"]+)"' | tr -d '"' | LC_ALL=C sort -u > "$refs_tmp"
        else
            # M86-S1：C 轨引用集 = C 产物里的 px_get_global("名") 调用串
            # M112-S2（Issue 53）：**外加 C 轨 FFI 调用桥里的函数名**。
            #   C 轨 FFI 名以字符串字面量出现在 ffi_call 桥里
            #   （px_call(px_get_global("ffi_call"), (LXValue[]){px_str("sqlite_query"), …}），
            #   不是 px_get_global 调用 ⇒ 原提取看不见 ⇒ 自动裁剪把 sqlite 模块裁掉
            #   ⇒ 运行期 bi_ffi_call 命中不到注册表，返回 px_err（result 类型），
            #   下游表现为 "len 不支持类型 result" —— 与真实病因（模块被裁）毫不相干。
            #   VM 轨无此问题（FFI 名经 GETG 落进 s_G，上面 sed 已覆盖）。
            {
                grep -oE 'px_get_global\("([^"]+)"' "$c_path" \
                    | sed 's/px_get_global("//; s/"$//'
                grep -oE 'px_get_global\("ffi_call"\), \(LXValue\[\]\)\{px_str\("[^"]+"\)' "$c_path" \
                    | grep -oE 'px_str\("[^"]+"\)' | sed 's/px_str("//; s/")$//'
            } | LC_ALL=C sort -u > "$refs_tmp"
        fi
        local MAP="$PXC_HOME/runtime/native_mod_map.txt"
        if [ -f "$MAP" ]; then
            # 被引用模块 = 引用集 ∩ map 的 mod 集合
            used="$(awk -F= 'NR==FNR{ref[$1]=1; next} ref[$1]{print $2}' "$refs_tmp" "$MAP" | LC_ALL=C sort -u | tr '\n' ' ')"
            # M441：onnx 在此**故意不列** —— 自动裁剪（M86-S2）的默认行为一字不改
            #   （硬约束：不改默认产物行为）。要最小化请显式 --no-onnx / --min。
            for am in sqlite ws zip xml aes rsa ed25519 img route zlib h2 quic; do
                case " $mods " in *" $am "*) continue ;; esac   # 显式已裁
                [ "$am" = quic ] && [ "$no_quic_set" = 1 ] && continue
                case " $used " in
                    *" $am "*) ;;                              # 被引用 → 保留
                    *) if [ "$am" = quic ]; then no_quic=1; else mods="$mods $am"; fi ;;
                esac
            done
        fi
        rm -f "$refs_tmp"
    fi
    cuts="$mods"; [ "$no_quic" = "1" ] && cuts="$cuts quic"
    # M430-补（缺陷 883）：cuts 是「被裁模块的**集合**」，但它的书写顺序直接进了
    #   rt_ensure 的缓存键 ⇒ `--min`（sqlite ws zip xml aes rsa ed25519 img route zlib h2）
    #   与手写的等价组合（同集合、不同顺序）命中两份不同 .rtcache，各自现编一遍 ⇒
    #   同一组裁剪却产出两份字节不同的产物（实测 m85_s2：3138640 vs 3142736，.rodata 差 32B，
    #   文件因页对齐差 4096）。集合语义不该带顺序 ⇒ 统一去重排序后再进键与编译。
    #   注意：源码挑选走 rt_src_files 的固定清单（cut_has 只看集合），与顺序无关，故安全。
    cuts="$(printf '%s\n' $cuts | LC_ALL=C sort -u | tr '\n' ' ' | sed 's/ *$//')"
    cache_dir="$(rt_ensure "$cuts" "$cc" "$lto" "$gcs")" || { echo "错误: runtime 预编译缓存建立失败" >&2; return 1; }
    # 3) 编译生成的 C 单文件 + 链接预编译 .o（不再每次全量现编 runtime）
    local mbedtls_inc="$RT_DIR/mbedtls/include"
    local sqlite_dir="$RT_DIR/third_party/sqlite3"
    local sqlite_src=""
    if [ -n "$sqlite_obj" ] && [ -f "$sqlite_obj" ]; then
        sqlite_src="$sqlite_obj"
    elif [ -f "$sqlite_dir/sqlite3.o" ]; then
        sqlite_src="$sqlite_dir/sqlite3.o"
    else
        sqlite_src="$sqlite_dir/sqlite3.c"
    fi
    local lto_flag=""; [ "$lto" = 1 ] && lto_flag=" -flto"
    local cc_cmd
    local common_def="-O2 -pthread -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_DEFAULT_FOREIGN_KEYS=1 \
        -I\"$cache_dir\" -I\"$RT_DIR/third_party/miniz\" -I\"$mbedtls_inc\" \
        -I\"$sqlite_dir\" -I\"$RT_DIR/third_party/zlib/include\"$lto_flag$([ "$gcs" = 1 ] && echo " -ffunction-sections -fdata-sections")"
    local m2
    for m2 in quic sqlite ws zip xml aes rsa ed25519 img route zlib h2 onnx; do
        if cut_has "$cuts" "$m2"; then
            common_def="$common_def $(mod_macro "$m2")"
        fi
    done
    if ! cut_has "$cuts" "quic"; then
        common_def="$common_def -I\"$RT_DIR/third_party/ngtcp2/include\" -I\"$RT_DIR/third_party/openssl/include\""
    fi
    # 用户 C 单文件现编（与 runtime .o 同 defines/include → ABI 一致）
    local _err; _err="$(px_cc_err_log)"
    if ! eval "$cc -c $common_def -o \"$build_dir/$base.o\" \"$c_path\"" 2>"$_err"; then
        echo "编译失败: $base.c" >&2
        tail -20 "$_err" >&2
        return 1
    fi
    rm -f "$_err"
    # 链接：base.o + runtime/miniz 预编译 .o + sqlite3 + 三方静态库
    local objs="" f
    for f in "$cache_dir"/*.o; do
        [ -f "$f" ] || { echo "错误: 缺少预编译对象 $f" >&2; return 1; }
        objs="$objs \"$f\""
    done
    # M67-S7：riscv64 musl 默认 static-pie 报 "read-only segment has dynamic
    # relocations" → riscv64 交叉加 -no-pie 传统静态
    # M422 补3（缺陷 858 · 2026-11-20 · CI run 44571916900 实测）：**默认 PIE 宿主上 -static 不够**。
    #   本仓预置三方静态库非 PIC（`runtime/mbedtls/lib/libmbedtls.a` 的 ssl_ciphersuites.o
    #   带 `R_X86_64_32 against .bss`）；Red Hat 系 gcc 默认非 PIE ⇒ 本机恒绿（120/120）；
    #   Ubuntu gcc（CI，--enable-default-pie）把 `-static` 仍按 PIE 口径链接 ⇒
    #   `relocation ... can not be used when making a PIE object` ⇒ 3 个示例链 mbedtls 时红。
    #   本机复现：同一条链接命令加 `-static-pie`（等价 CI 的实际口径）⇒ 逐字同一个错；
    #   加 `-no-pie` ⇒ rc=0。⇒ 口径：**显式声明非 PIE**（mingw/Win 无 PIE 选项，除外）。
    local pie_flag=" -no-pie"
    case "$cc" in *mingw*) pie_flag="" ;; esac
    # ---- M168：静态 libc 预检（**响亮报因**，不让用户对着 gcc 的 "cannot find -lc" 发呆）----
    #   `px build` 一律以 -static 链接产物（口径见文件头）⇒ 本机必须有静态 libc：
    #     RHEL / openEuler → glibc-static · Debian / Ubuntu → libc6-dev
    #   实锤（2026-09-21 报障同源）：rpm 的 Requires 只写了 gcc，用户装完就栽在这里。
    #   本次运行只探测一次（结果缓存在 _PX_STATIC_LIBC_OK）。
    if [ "${_PX_STATIC_LIBC_OK:-}" != 1 ]; then
        # M191（缺陷 215）：同上 —— 固定名 ⇒ 并发构建互相踩，实测「缺静态 libc」假报。
        local _probe_c _probe_b
        _probe_c="$(mktemp --suffix=.c "${TMPDIR:-/tmp}/.px_static_probe.XXXXXX")" || { echo "错误: mktemp 失败" >&2; return 1; }
        _probe_b="${_probe_c%.c}.bin"
        printf 'int main(void){return 0;}\n' > "$_probe_c"
        if $cc -static -o "$_probe_b" "$_probe_c" >/dev/null 2>&1; then
            _PX_STATIC_LIBC_OK=1
            rm -f "$_probe_c" "$_probe_b"
        else
            rm -f "$_probe_c" "$_probe_b"
            echo "错误: $cc 无法静态链接（缺**静态 libc**）—— PuXian 产物一律 -static" >&2
            echo "  RHEL / openEuler: sudo dnf install -y glibc-static" >&2
            echo "  Debian / Ubuntu:  sudo apt-get install -y libc6-dev" >&2
            echo "  （走 rpm 包安装时：puxian 的 Requires 已含 glibc-static，请确认装全）" >&2
            return 1
        fi
    fi
    cc_cmd="$cc -static -O2 -pthread$pie_flag$lto_flag -o \"$out_path\" \"$build_dir/$base.o\" $objs"
    # M441：--gc-sections（opt-in）—— .o 已按 function/data 分节 ⇒ 此处按引用集回收未用节
    [ "$gcs" = 1 ] && cc_cmd="$cc_cmd -Wl,--gc-sections"
    if ! cut_has "$cuts" sqlite; then
        cc_cmd="$cc_cmd \"$sqlite_src\""
    fi
    cc_cmd="$cc_cmd \
        \"$mbedtls_lib/libmbedtls.a\" \"$mbedtls_lib/libmbedx509.a\" \"$mbedtls_lib/libmbedcrypto.a\""
    if ! cut_has "$cuts" "quic"; then
        cc_cmd="$cc_cmd \
        \"$RT_DIR/third_party/ngtcp2/lib/libngtcp2.a\" \"$RT_DIR/third_party/ngtcp2/lib/libngtcp2_crypto_quictls.a\" \
        \"$RT_DIR/third_party/openssl/lib/libssl.a\" \"$RT_DIR/third_party/openssl/lib/libcrypto.a\""
    fi
    # M61-S0：zlib 外部静态库（无条件链，.a ~150KB；--cc 交叉已自动切架构库）
    if ! cut_has "$cuts" zlib; then
        cc_cmd="$cc_cmd \"$zlib_lib/libz.a\""
    fi
    cc_cmd="$cc_cmd -lm -ldl"
    local _err; _err="$(px_cc_err_log)"
    if ! eval "$cc_cmd" 2> "$_err"; then
        echo "编译失败: $out_path" >&2
        tail -20 "$_err" >&2
        return 1
    fi
    rm -f "$_err"
    local size
    size=$(stat -c %s "$out_path" 2>/dev/null || echo 0)
    echo "编译成功: $out_path （$size 字节）"
    # M425：成功且**无编译期诊断** ⇒ 落盘（诊断非空时不写，免得下次命中把警告吞掉）
    if [ -n "$bkey" ] && [ "$cache_hit" = 0 ] && [ ! -s "$cerr_log" ]; then
        if mkdir -p "$bdir" 2>/dev/null; then
            if cp -f "$out_path" "$bdir/prog.tmp.$$" 2>/dev/null \
               && mv -f "$bdir/prog.tmp.$$" "$bdir/prog" 2>/dev/null; then
                sha256sum "$bdir/prog" 2>/dev/null | cut -c1-16 > "$bdir/prog.sha16" 2>/dev/null
                [ -f "$c_path" ] && cp -f "$c_path" "$bdir/prog.c" 2>/dev/null
                [ -f "$build_dir/$base.o" ] && cp -f "$build_dir/$base.o" "$bdir/prog.o" 2>/dev/null
                if [ "${PX_BUILD_VERBOSE:-0}" = "1" ]; then
                    echo "[px build] 缓存写入 key=$bkey" >&2
                fi
            fi
            rm -f "$bdir/prog.tmp.$$" 2>/dev/null
        fi
    fi
    # M180（晨曦 QA 清单 P1-4）：**能力行**（默认静默，PV_BUILD_FEATURES=1 时才打）——
    #   判据不该靠 `strings` 猜；但**成功路径不能往 stderr 加噪声**：
    #   `selfhost/engine_parity.sh` 的判据是「正例：默认轨 stderr 必须为空」
    #   （M180 实测踩中，见 CHANGELOG M180 的教训条）
    #   ⇒ 能力行做成**按需**：`PX_BUILD_FEATURES=1 px build …`（走 stderr，stdout 逐字节不变）。
    #   口径：h2 不做（docs/HTTP2_DECISION.md）；QUIC/H3 需 ngtcp2 静态库（仅 x86_64 预置）。
    if [ "${PX_BUILD_FEATURES:-0}" = "1" ]; then
        local _q="on"
        if [ "$no_quic" = "1" ]; then _q="off"; fi
        if cut_has "$cuts" quic; then _q="off"; fi
        echo "  能力: quic=$_q h2=off（口径见 docs/HTTP2_DECISION.md） 宿主=$(uname -m)" >&2
        if [ "$_q" = "off" ]; then
            echo "  ⚠️  本产物无 HTTP/3：opts{\"http3\": true} 会**响亮报错**（不会静默不服务）" >&2
            echo "      需要 H3 请用 x86_64（预置 ngtcp2/openssl-quictls）且不加 --no-quic" >&2
        fi
    fi
    return 0
}

# ══════════════════════════════════════════════════════════════
# M268（第 145 轮）：`px run --fast` —— **用户脚本构建缓存**
# ------------------------------------------------------------
# 来历：晨曦《px run（解释轨）性能》+ 清歌《性能基线 v2》。实测（本机 0.2.281）：
#   `pxi`（tree-walking）11.6 s  ⇄  `px build` 产物 30.7 ms  = **378×**
#   （python3 28.9 ms；四条轨 stdout 逐字节一致。见 docs/PERF_BASELINE_V2.md §六）
#
# 为什么**默认关**（不采纳"默认开缓存"）：
#   `px run` 的秒起（5–8 ms）不是体验问题，是**基础设施属性** —— 仓内 20 个门用
#   `px run`、66 个直接用 `bootstrap/pxi`，CI 脚本与大量 verify.sh 依赖它。
#   默认加编译 ⇒ 每个调用点 +0.5–1 s ⇒ 全仓 CI 被拉长。
#   ⇒ 收益不打折：重计算脚本改用 `px run --fast` 或 `px build`。
#
# ⚠️ 语义口径（**缓存不得改变语义**）：
#   解释轨只支持 Mini 子集（并发原语仅编译轨，docs/MINI_SUBSET.md §边界表）。
#   若缓存命中就直接 exec 编译产物，则「这脚本能不能 spawn」会变成由「有没有开
#   --fast」决定 —— **缓存只许影响快慢，不许影响语义**。
#   ⇒ 本实现带**子集守卫**：脚本含并发构造 ⇒ 打印提示 + **回落解释轨**（行为不变）。
#
# 环境变量：PX_RUNCACHE_DIR（缓存根，默认 $PXC_HOME/.runcache）· PX_RUN_NOCACHE=1（禁用）
# ══════════════════════════════════════════════════════════════
PXPAR_BIN_RUN="$PXPAR_BIN"

# ══════════════════════════════════════════════════════════════
# M425（缺陷 866）：`px build` 产物缓存
# ------------------------------------------------------------
# 病根：`.rtcache` 只缓存 **runtime 的 .o**（按引用集分桶），用户程序产物零缓存 ⇒
#   改一行注释重编译、门里重复构建、CI 重跑，每次白付 emit-c 11 ms + gcc -c 128 ms +
#   静态链接 ≈1.1 s（实测 1251–1623 ms，产物逐字节相同）。
# key 必须由「真正决定产物的输入」驱动（M169/M271/M378 同一条纪律）：
#   主脚本内容 · 依赖闭包内容 · 工具链指纹（版本 / rtkey / pxc_vm / pxi / engine）·
#   构建 flag 签名（engine/lto/cc/no_quic/mods/cuts/full）· cc 版本 · **产物 basename**
#   ⚠️ basename 必须进 key：实测产物**内嵌程序名**（aaa.px 与 bbb.px 同内容 ⇒ 产物 sha 不同）
#      —— 名不进 key 就会「拿 aaa 的二进制当 bbb」（错误缓存，比不缓存更糟）。
# 环境：PX_BUILDCACHE_DIR（默认 $PXC_HOME/.buildcache）· PX_BUILD_NOCACHE=1（禁用）
#       PX_BUILD_VERBOSE=1（打印 key / 命中 / 写入，走 stderr，stdout 逐字节不变）
# ══════════════════════════════════════════════════════════════
BUILD_CACHE="${PX_BUILDCACHE_DIR:-$PXC_HOME/.buildcache}"

# ── M425 补1（缺陷 867）：**编译器身份必须进 key** ─────────────────────────
# 实测（2026-11-20 20:26 · /tmp/diag425 · 独立缓存目录）：
#   ① 默认编译器建 hello.px ⇒ 缓存写入 key=adb1c793…
#   ② `PX_PXC_BIN=/bin/false`（**根本不能产 C 的「编译器」**）再建同一份源码
#      ⇒ 打印「缓存命中 key=adb1c793…（跳过 emit-c + gcc + 链接）· 编译成功 3138176 字节」
#   ⇒ 缓存把一个**不同的编译器**（甚至是坏的）的产物冒充成本次产物。
#   后果不是「慢」，是**语义**：任何「换编译器再构建」的负控都被静默中和 ——
#   M425 首轮链 10 红（m204/m233/m237/m246/m301/m166/m218/m220/m239）全是这条：
#   它们打桩后会 `PX_PXC_BIN=/tmp/pxcdev px build …`，命中旧条目 ⇒ C 轨仍是好实现
#   ⇒ 「负控必须判红」失败 ⇒ 门的牙被我的缓存拔掉了。
#   （本文件 1030 行的老注释就写着「错误缓存比不缓存更糟」，当时只给 basename 上了锁。）
# 口径：权威是**内容哈希**（M271）；用 (size,mtime,ino) 记忆化，避免每次多付 ~200 ms 全量 sha。
# 覆盖：C 轨编译器（PX_PXC_BIN / bootstrap/pxc）、VM 轨编译器（PXC_VM_BIN / bootstrap/pxc_vm）、
#       解释器（PX_PXI_BIN / bootstrap/pxi）—— 前两者决定产物，后者决定 --fast 契约。
comp_fp() { # stdout: "comp=<sha16>"（编译器）与 "std=<sha16>"（stdlib 每件一行）；缺失项不写行
    # ⚠️ 性能纪律：本函数在 `px run --fast` 的每次命中也跑 ⇒ 单次 stat + mapfile + bash 比对，
    #   不许 fork awk/sha（首版 3×stat+3×awk 实测把 --fast 从 168–191ms 拖到 209–243ms）。
    #
    # M425 补1（缺陷 867）两个洞都在这里堵：
    #   ① **编译器身份**：PX_PXC_BIN / PXC_VM_BIN / PX_PXI_BIN 是门里打桩用的覆盖口，
    #      不进 key ⇒ 负控「换编译器再构建」会命中旧产物（实测 /bin/false 也能「编译成功」）。
    #   ② **stdlib 内容**：`import std.*` 由 PX_STDLIB 解析，px_resolve_import 对 std.* 直接
    #      返回空（1206 行，为沙箱复制不漂移）⇒ stdlib/*.px **不在依赖闭包里** ⇒ 改 stdlib
    #      仍命中旧产物（实测：改 stdlib/semver.px 后 build 仍「缓存命中」；m302 3B 就因此红：
    #      解释轨读新 stdlib、VM/C 轨拿旧二进制 ⇒ 三轨分叉）。这里按内容逐件进 key。
    #   ⚠️ memo 写回必须**保留本轮命中的条目**：首版只写 pend（新算的），把命中的编译器行
    #      prune 掉了 ⇒ 下一次全部重算 sha（3×10MB ≈ 210ms），--fast 从 190ms 变 400ms。
    local memo="$BUILD_CACHE/.compiler.fp" out="" p key l sha size mt ino skip k sdir tgt
    local -a paths=( "${PX_PXC_BIN:-$PXC_HOME/bootstrap/pxc}" \
                     "${PXC_VM_BIN:-$PXC_HOME/bootstrap/pxc_vm}" \
                     "${PX_PXI_BIN:-$PXC_HOME/bootstrap/pxi}" )
    sdir="${PX_STDLIB:-$PXC_HOME/stdlib}"
    if [ -d "$sdir" ]; then
        for p in "$sdir"/*.px ; do [ -f "$p" ] || continue; paths+=("$p"); done
    fi
    local -A det=() mem=() res=()
    local stl
    stl="$(stat --printf='%n\t%s\t%Y\t%i\n' -- "${paths[@]}" 2>/dev/null)"
    while IFS=$'\t' read -r p size mt ino; do
        [ -n "$p" ] || continue
        det["$p"]="$size"$'\t'"$mt"$'\t'"$ino"
    done <<< "$stl"
    if [ -f "$memo" ]; then
        local -a _l=(); mapfile -t _l < "$memo" 2>/dev/null
        for l in "${_l[@]}"; do
            [ -n "$l" ] || continue
            mem["${l%$'\t'*}"]="${l##*$'\t'}"
        done
    fi
    local dirty=0
    for p in "${paths[@]}"; do
        [ -n "$p" ] && [ -n "${det[$p]:-}" ] || continue
        key="$p"$'\t'"${det[$p]}"
        sha="${mem[$key]:-}"
        if [ -z "$sha" ]; then
            sha="$(sha256sum "$p" 2>/dev/null | cut -c1-16)"
            [ -n "$sha" ] || continue
            dirty=1
        fi
        res["$key"]="$sha"
        case "$p" in
            "$sdir"/*) out="$out std=$sha" ;;
            *)         out="$out comp=$sha" ;;
        esac
    done
    if [ "$dirty" = 1 ] && { [ -d "$BUILD_CACHE" ] || mkdir -p "$BUILD_CACHE" 2>/dev/null; }; then
        local tmpd="$memo.tmp.$$"
        {
            # 保留与本轮**无关**的旧条目（别的 stdlib 路径等），本轮涉及的路径一律用 res 重写
            for k in "${!mem[@]}"; do
                skip=""
                for p in "${paths[@]}"; do
                    case "$k" in "$p"$'\t'*) skip=1 ;; esac
                done
                [ -n "$skip" ] && continue
                printf '%s\t%s\n' "$k" "${mem[$k]}"
            done
            for k in "${!res[@]}"; do
                printf '%s\t%s\n' "$k" "${res[$k]}"
            done
        } > "$tmpd" 2>/dev/null && mv -f "$tmpd" "$memo" 2>/dev/null
        rm -f "$tmpd" 2>/dev/null
    fi
    [ -n "$out" ] && printf '%s\n' "${out# }"
    return 0
}

build_cache_key() { # $1=主脚本绝对路径 $2=base $3=engine $4=lto $5=cc $6=no_quic $7=mods $8=cuts $9=full ${10}=gcs
    local f="$1" base="$2" engine="$3" lto="$4" cc="$5" nq="$6" mods="$7" cuts="$8" full="$9" gcs="${10:-0}"
    {
        printf 'base=%s\nengine=%s\nlto=%s\ncc=%s\nnoquic=%s\nfull=%s\n' \
               "$base" "$engine" "$lto" "$cc" "$nq" "$full"
        printf 'mods=%s\ncuts=%s\ngcs=%s\n' "$mods" "$cuts" "$gcs"
        # M441（缺陷 924）：**构建器自身内容必须进产物缓存的键**。
        #   实测（2026-11-24 02:1x）：改了 tools/px 的自动裁剪逻辑后，默认构建 secs=1
        #   直接命中旧产物（返回的是改动前编译的二进制），而 dump 里 cuts='' ——
        #   key 只覆盖「源码 + toolchain + comp_fp」，**没有覆盖构建器本身**。
        #   ⇒ 升级 px 后可能拿到旧产物的行为；门里也不可能察觉（产物 sha 与缓存自洽）。
        #   与缺陷 922（M440 备忘漏登记 stdlib）同族：**键必须覆盖所有会影响产物的输入**。
        sha256sum "$PXC_SELF" 2>/dev/null | cut -c1-16
        printf 'rtkey=%s\n' "$(rt_key "$cuts" "$cc" "$lto" "$gcs")"
        "$cc" --version 2>/dev/null | head -1
        sha256sum "$f" 2>/dev/null | cut -c1-16
        while IFS= read -r _df; do
            [ "$_df" = "$f" ] && continue
            sha256sum "$_df" 2>/dev/null | cut -c1-16
        done < <(px_dep_closure "$f" 2>/dev/null) | LC_ALL=C sort
        toolchain_fp
        comp_fp          # M425 补1（缺陷 867）：编译器身份 —— 少了它就会「换个编译器还命中」
    } | sha256sum | cut -c1-32
}

# ── M383-速度：单次 --fast 内主脚本 AST 只解析一次 ──────────────────────────
# 病根：`run_subset_ok`（子集守卫）打一次 pxpar，`px_dep_closure → px_import_keys`
#   对**同一个主脚本**再打一次 pxpar ⇒ 同一份 AST 解析两遍（实测 pxpar 26 ms/次）。
#
# ⚠️ 传递机制 = **环境变量**（父 shell export，子 shell 只读）。
#   为什么不用函数内赋值做记忆：`x="$(f)"` 里 f 跑在**子 shell**，它对全局变量的赋值
#   随子 shell 消失 —— 那样写出来的缓存是**假的**（看着在缓存，实际每次重解析）。
#   父→子单向正是我们要的方向：父算一次，子只读。
# ⚠️ 硬边界：Linux 单个环境变量上限 MAX_ARG_STRLEN = 128 KB。
#   实测 AST 8 KB（hello）～186 KB（m57 那批大脚本）⇒ 只对**字符数 ≤ 32768**
#   （最坏 UTF-8 3 字节/字符 ≈ 96 KB）的 AST 启用传递；更大的不传，退回各调用点
#   自行解析（行为与优化前完全一致，零风险）。
# ⚠️ 只对「主脚本」生效：依赖文件在 dep_closure 里各解析一次，本来就只需一次。
_PX_AST_F=""
_PX_AST_V=""
px_ast_of() { # $1=文件 ⇒ stdout AST（命中已预解析的主脚本时零 fork）
    local f v rc
    case "$1" in
        /*) f="$1" ;;
        *)  f="$(readlink -f "$1" 2>/dev/null || echo "$1")" ;;
    esac
    if [ -n "${_PX_AST_F:-}" ] && [ "$f" = "$_PX_AST_F" ] && [ -n "${_PX_AST_V:-}" ]; then
        printf '%s\n' "$_PX_AST_V"; return 0
    fi
    v="$("$PXPAR_BIN_RUN" "$f" 2>/dev/null)"; rc=$?
    [ "$rc" -eq 0 ] || return "$rc"
    printf '%s\n' "$v"
}

# 预解析主脚本，把 AST 交给后续子 shell（cmd_run_fast 在用到 AST 之前调一次）
px_ast_prime() { # $1=绝对路径；解析失败返回 1（由调用方按原逻辑回落）
    local v
    _PX_AST_F=""; _PX_AST_V=""
    v="$("$PXPAR_BIN_RUN" "$1" 2>/dev/null)" || return 1
    [ "${#v}" -le 32768 ] || return 0     # 大 AST 不传（MAX_ARG_STRLEN 128 KB 上限）
    _PX_AST_F="$1"; _PX_AST_V="$v"
    export _PX_AST_F _PX_AST_V
    return 0
}

# 子集守卫：脚本是否**在解释轨（Mini 子集）能力范围内** ⇒ 0=在（可走编译轨）
#   名单来源：examples/m201_interp_ffi/verify.sh 的 WAIVED（6 条 native，机器核对过）
#           + istmt.px/iexpr.px 的语句级拒绝（Spawn/Chan/Send/Recv/Select）。
#   判据形态：**解析出的 AST**（不是源码文本）⇒ 不误命中注释与字符串字面量。
#   方向：**过近似**（假阳性只损失速度，不损失正确性）。
run_subset_ok() { # $1=脚本；stdout 输出违例名单（空=通过）
    local ast
    ast="$(px_ast_of "$1")" || { echo "解析失败"; return 1; }
    local bad=""
    if printf '%s' "$ast" | grep -qE '^[[:space:]]*(Spawn|Chan|Send|Recv|Select)[[:space:]]*\{'; then
        bad="并发语句(spawn/chan/send/recv/select)"
    fi
    local nm
    nm="$(printf '%s' "$ast" | grep -oE 'name: "(spawn|chan|chan_try_recv|select_try|mutex|rwlock)"' \
          | sed 's/name: "//; s/"//' | LC_ALL=C sort -u | tr '\n' ' ')"
    if [ -n "$nm" ]; then bad="${bad:+$bad }并发 native(${nm% })"; fi
    [ -z "$bad" ] && return 0
    printf '%s' "$bad"; return 1
}

# ── M378（晨曦 PX-BUG-20261106-01）：--fast 沙箱必须带项目内依赖 ─────────────
# 病根：旧实现只把主脚本 cp 进 mktemp 沙箱，不带它 import 的项目内 .px，也不传
#   include 路径；编译器找不到模块时**只警告、仍退出 0 并出产物**（非
#   PX_STRICT_MODULE 口径）⇒ 缓存写进一条必然 R1001 的二进制，此后每次命中都
#   exec 它 —— 把编译期错误静默固化成运行期错误。
# 口径：① 沙箱 = 「与源目录可编译性等价的最小树」；② 依赖提取结果**同时**驱动
#   沙箱内容与缓存 key（分两处写会漂移 ⇒ 改依赖不失效 = 跑旧逻辑）。
px_import_keys() { # $1=文件 ⇒ stdout 每行一个 module key（点分：module: ["std","time"]）
    px_ast_of "$1" 2>/dev/null | awk '
        /^[[:space:]]*Import \{/ { inimp = 1; inmod = 0; key = ""; next }
        inimp && /^[[:space:]]*module: \[[[:space:]]*$/ { inmod = 1; next }
        inmod && /^[[:space:]]*\],?[[:space:]]*$/ {
            inmod = 0; inimp = 0
            if (key != "") { print key; key = "" }
            next
        }
        inmod {
            rest = $0
            while (match(rest, /"[^"]*"/)) {
                s = substr(rest, RSTART + 1, RLENGTH - 2)
                key = (key == "" ? s : key "." s)
                rest = substr(rest, RSTART + RLENGTH)
            }
        }
    '
}

px_resolve_import() { # $1=module key  $2=base_dir ⇒ stdout 绝对路径（std / c/ / 无解 ⇒ 空）
    # 解析口径对齐 selfhost/cg_module.px 的 cg_find_module_path：
    #   相对路径 / std.* / 用户点分包（base_dir → .px_modules → 其无点子目录 → mod.px）
    local key="$1" base="$2" dst="" m
    case "$key" in
        std|std.*|c/*) return 0 ;;          # std 由 PX_STDLIB 解析；c/ 是显式 C 库声明
    esac
    case "$key" in
        */*|*.px)                            # 相对 / 绝对路径导入
            case "$key" in
                /*) [ -f "$key" ] && readlink -f "$key" ;;
                *)  [ -f "$base/$key" ] && readlink -f "$base/$key" ;;
            esac
            return 0 ;;
    esac
    local -a mods; IFS='.' read -r -a mods <<< "$key"
    local -a bases; bases=("$base")
    if [ -d "$base/.px_modules" ]; then
        bases+=("$base/.px_modules")
        for m in "$base/.px_modules"/*; do
            [ -d "$m" ] || continue
            case "${m##*/}" in *.*) continue ;; esac
            bases+=("$m")
        done
    fi
    for base in "${bases[@]}"; do
        dst="$base"
        for m in "${mods[@]}"; do dst="$dst/$m"; done
        [ -f "$dst.px" ] && { readlink -f "$dst.px"; return 0; }
        [ -f "$dst/mod.px" ] && { readlink -f "$dst/mod.px"; return 0; }
    done
    return 0
}

px_dep_closure() { # $1=主脚本 ⇒ stdout：主脚本 + 全部项目内 .px 依赖（绝对路径、去重、BFS）
    # ⚠️ 递归基准 = **被 import 文件自己的目录**（对齐 cg_load_module 的 mod_dir），
    #   不是主脚本目录 —— 否则子目录里的相对 import 会解析错。
    local cur d rp
    local -a queue; queue=()
    local -A seen; seen=()
    cur="$(readlink -f "$1")"
    seen["$cur"]=1; printf '%s\n' "$cur"; queue=("$cur")
    while [ "${#queue[@]}" -gt 0 ]; do
        cur="${queue[0]}"; queue=("${queue[@]:1}")
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            rp="$(px_resolve_import "$d" "$(dirname "$cur")")"
            [ -n "$rp" ] || continue
            if [ -n "${seen[$rp]:-}" ]; then continue; fi
            seen["$rp"]=1; printf '%s\n' "$rp"; queue+=("$rp")
        done < <(px_import_keys "$cur")
    done
}

px_is_under() { # $1=路径 $2=目录 ⇒ 0=在下面（含相等）
    [ "$1" = "$2" ] && return 0
    case "$1" in "$2"/*) return 0 ;; esac
    return 1
}

px_common_root() { # $@=文件/目录 ⇒ 公共祖先目录（沙箱内保持相对路径用）
    [ "$#" -gt 0 ] || { printf '/\n'; return 0; }
    local root="$1" p
    [ -d "$root" ] || root="$(dirname "$root")"
    shift
    for p in "$@"; do
        [ -d "$p" ] || p="$(dirname "$p")"
        while ! px_is_under "$p" "$root"; do
            [ "$root" = "/" ] && break
            root="$(dirname "$root")"
        done
        [ "$root" = "/" ] && break
    done
    printf '%s\n' "$root"
}

# ── M383-速度：工具链指纹缓存（--fast 热态 670 ms → 15 ms 的关键）──────────
# 病根（2026-11-09 实测本机，`px run --fast hello.px` 热态中位数 845 ms）：
#     px --version 自调用             38 ms   bash 重解析 85KB 脚本
#     px rtkey 自调用                461 ms   内部对 30 个 runtime 源逐个 fork sha256sum
#     sha256sum bootstrap/pxc_vm      73 ms   10 MB
#     sha256sum bootstrap/pxi         98 ms   10 MB
#                                    ─────
#                                    670 ms   ＝ 热态的 79%
#   而它们**在工具链不变时是常量** —— 每次调用都重算是纯粹的重复劳动。
#
# 口径（只改快慢，不改语义）：
#   指纹内容 = 旧实现那 5 个信号，一个不多一个不少（版本 / rtkey / pxc_vm / pxi / engine）
#   ⇒ key 逐字节不变 ⇒ 既有 .runcache 条目继续命中，不做无谓重建。
#   有效性 = `find -newer` 抓 runtime/、bootstrap/{pxc_vm,pxi}、VERSION 的**任何** mtime 更新
#            （实测 317 个文件全扫 6–8 ms）+ 两个自举产物 size 双保险 + TTL 兜底。
#   失效即重算并覆盖缓存 —— 结果与「每次重算」等价，只是省掉了重复。
#   ⚠️ 已知边界（诚实写在这里）：若有人**原地改写文件同时刻意保留 mtime 与 size**，
#      快路径不会失效 ⇒ 由 TTL（PX_TOOLCHAIN_FP_TTL，默认 1800 s）兜住，最坏滞后一个 TTL。
#      不读内容就检测不到这种改动；要彻底消除只能每次全算（= 现状 670 ms）。这是一笔明账。
# ── M440：工具链输入清单（**唯一真源**）────────────────────────────────────
# 为什么抽出来：`--fast` 的命中决策备忘（px_memo_*）与 toolchain_fp 的 stat 签名
#   必须盯**同一批文件** —— 两份手写清单必然漂移（M435 缺陷 902 的同族）。
#   输出顺序即 stat 顺序（逐字节可比）。
px_toolchain_files() {
    printf '%s\n' \
        "$PXC_HOME/bootstrap/pxc_vm" "$PXC_HOME/bootstrap/pxi" "$PXC_HOME/VERSION" \
        "$RT_DIR"/*.c "$RT_DIR"/*.h \
        "$RT_DIR"/third_party/miniz/*.c "$RT_DIR"/third_party/miniz/*.h \
        "$RT_DIR"/third_party/sqlite3/sqlite3.h
}

toolchain_fp() { # stdout=5 行指纹（与旧实现逐字节同流）
    local fp="$RUN_CACHE/.toolchain.fp"
    local stamp="$RUN_CACHE/.toolchain.stamp"
    local ttl="${PX_TOOLCHAIN_FP_TTL:-1800}"
    # ── M425 补2（缺陷 868）：有效性判据必须**双向** ──────────────────────────
    #   病灶（2026-11-20 23:2x M425 全量门红 · m233 负控 B 的「确定性层仍绿」判据）：
    #   m233 负控 A 把 `runtime.c` 的兜底退回 `fmt_num` ⇒ 该次构建把「**回退版** rt_key」
    #   写进 memo；`negctl restore` 用 shutil.copy2 **保留原 mtime** ⇒ 复原后的 runtime.c
    #   比 `$stamp` 还**旧** ⇒ `find -newer` 只看得见「变新」、看不见「改回旧值」⇒ memo 判有效、
    #   继续吐回退版 rt_key ⇒ 产物缓存把「回退版 runtime」与「正式版 runtime」算成同一输入
    #   ⇒ A 的坏产物以**正式 key** 落盘，之后 B / 正式构建全部命中坏产物（确定性判据红）。
    #   修法：额外记一份 **stat 签名**（路径:size:mtime:ino，覆盖 rt_key 的全部源 + 两个
    #   自举件 + VERSION；单次 stat 聚合 ≈4 ms），要求**逐字节相等**才算命中 —— 变新、变旧、
    #   换文件都失效。`find -newer` 保留，兜住 runtime/third_party 下**不在 key 内**的源
    #   （mbedtls 头等）被原地更新的情形。内容哈希仍是权威（慢路径重算 rt_key）。
    local sig
    # ⚠️ engine 也是 memo 的输入（指纹最后一行 `engine=…` 在 body 里）—— 必须一起进签名，
    #    否则「vm 档算出的 memo」会被 c 档复用（实测：同源同内容两次构建拿到两把不同的 key，
    #    缓存命中率与判据稳定性一起坏）。`cuts`/`lto`/`--cc` 不进这里：它们各自进 build_cache_key。
    sig="$( { stat -c '%n:%s:%Y:%i' -- $(px_toolchain_files) 2>/dev/null
            echo "engine=${PX_BUILD_ENGINE:-vm}" 2>/dev/null; } | md5sum | cut -c1-16)"
    if [ -f "$fp" ] && [ -f "$stamp" ] && [ -n "${sig:-}" ]; then
        local now age
        # EPOCHSECONDS 是 bash 5 内建（零 fork）；el7 的 4.2 没有 ⇒ 惰性回退 date
        now="${EPOCHSECONDS:-$(date +%s 2>/dev/null || echo 0)}"
        age=$(( now - $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
        # mapfile 是内建（零 fork）—— 快路径每省一次 fork 都是真金白银：这条路径走 N 次
        local -a _fp; mapfile -t _fp < "$fp" 2>/dev/null
        if [ "$age" -lt "$ttl" ] \
           && [ "${_fp[0]:-}" = "#SIG $sig" ] && [ "${_fp[1]:-}" = "#FP" ]; then
            if [ -z "$(find "$RT_DIR" "$PXC_HOME/bootstrap/pxc_vm" \
                           "$PXC_HOME/bootstrap/pxi" "$PXC_HOME/VERSION" \
                           -newer "$stamp" -print -quit 2>/dev/null)" ]; then
                # 命中：只吐指纹本体（跳过 #SIZES 与 #FP 两行标记）
                printf '%s\n' "${_fp[@]:2}"
                return 0
            fi
        fi
    fi
    # 慢路径：算一次（内联调用，省掉两次 bash 自调用的 ~76 ms）
    local out
    out="$( {
        echo "px $RELEASE_VER" | head -1
        rt_key "" gcc 0 | head -1
        sha256sum "$PXC_HOME/bootstrap/pxc_vm" 2>/dev/null | cut -c1-16
        sha256sum "$PXC_HOME/bootstrap/pxi"    2>/dev/null | cut -c1-16
        echo "engine=${PX_BUILD_ENGINE:-vm}"
    } 2>/dev/null )"
    if mkdir -p "$RUN_CACHE" 2>/dev/null; then
        { printf '#SIG %s\n#FP\n%s\n' "$sig" "$out"; } > "$fp.tmp.$$" 2>/dev/null \
            && mv "$fp.tmp.$$" "$fp" 2>/dev/null \
            && touch "$stamp" 2>/dev/null
        rm -f "$fp.tmp.$$" 2>/dev/null
    fi
    printf '%s\n' "$out"
}

run_cache_key() { # $1=脚本绝对路径 ⇒ stdout key（只由"会影响产物"的东西决定）
    # ⚠️ **必须含脚本内容** —— .rtcache 的 key 不含（那是 runtime 的缓存且按"引用集
    #    cuts"分桶，正确）；这里若不含脚本内容，改了脚本还命中旧产物 = 错误的缓存。
    #
    # ⚠️ 各来源都是**内容/版本信号**，不用 mtime（M169 缺陷 185 / M223 缺陷 323：
    #   可自动挑选的东西必须也可自动核对；mtime 会因 touch/cp/解包而漂移）。
    {
        sha256sum "$1" | cut -c1-16
        # M378（晨曦 PX-BUG-20261106-01 B）：**依赖内容也进 key**。
        #   旧 key 只含主脚本 ⇒ 改 lib.px 仍命中旧产物（跑旧逻辑、毫无提示），
        #   与本函数「key 必须由真正决定行为的输入驱动」的注释口径相悖。
        #   与沙箱复制共用 px_dep_closure ⇒ 两处判据不漂移。
        #   无依赖脚本不追加任何行 ⇒ 既有缓存不作废（不做无谓重建）。
        while IFS= read -r _df; do
            [ "$_df" = "$1" ] && continue
            sha256sum "$_df" 2>/dev/null | cut -c1-16
        done < <(px_dep_closure "$1") | LC_ALL=C sort
        # M383-速度：以下 5 个信号（版本 / rtkey / pxc_vm / pxi / engine）整体由
        #   toolchain_fp 提供 —— 内容逐字节同旧实现，只是不再每次重算。
        toolchain_fp
        # M271（晨曦 D1 第 1 条）：**运行器契约** = Mini 子集判据自身。
        #   子集判据是**代码**（selfhost/istmt.px 的 Spawn/Chan/Send/Recv/Select、
        #   selfhost/iexpr.px 的 chan/mutex/rwlock 构造），其载体就是 bootstrap/pxi
        #   ⇒ 取其哈希 = 「这一版运行器到底接受什么」的身份。
        #   ⚠️ 为什么必须含它：若将来放宽/收紧 MINI_SUBSET 而 key 不含此项，
        #     老缓存条目会按**旧契约**命中 ⇒ 本应被响亮拒绝的脚本悄悄跑起来
        #     （= 缓存改变了语义）。与 .rtcache 的教训同构：
        #     **key 必须由「真正决定行为的输入」驱动**。
        #   （M383：该信号由上面的 toolchain_fp 一并提供）
        #   ⚠️ M425 补1（缺陷 867）：toolchain_fp 取的是 **PXC_HOME 下的** pxc_vm/pxi，
        #     不含 PX_PXI_BIN / PXC_VM_BIN / PX_PXC_BIN 这些**覆盖口**。门里的负控正是靠
        #     覆盖口把「被打桩的解释器/编译器」换进来（/tmp/pxidev、/tmp/pxcdev）——
        #     覆盖口不进 key ⇒ 负控命中旧条目 ⇒ 门的牙被拔掉（M425 首轮链 10 红同源）。
        comp_fp
    } | sha256sum | cut -c1-16
}

cmd_run_fast() {
    local file="$1"; shift
    [ -f "$file" ] || { echo "[px run --fast] 读取文件失败: $file" >&2; return 1; }
    if [ -n "${PX_RUN_NOCACHE:-}" ]; then "$PXI_BIN" "$@" "$file"; return $?; fi

    local abs; abs="$(readlink -f "$file" 2>/dev/null || echo "$file")"
    # ── M440：**命中决策备忘**（热态 190–215 ms → ~40 ms）───────────────────
    #   命中 ⇒ exec，不返回；未命中 ⇒ 落到下面原全量路径（并在结束时重写备忘）。
    #   为什么在子集守卫**之前**：备忘本身就把「子集判定结果」记在签名里 ——
    #   源码/运行器契约一变（ctime 变）就必然重判，语义与「先判源码」等价（M271 口径）。
    #   verbose 模式一律不走备忘：它要打印 key 与依赖清单（那是全量路径的产物）。
    #   （文件最前面已试过一次；那里只覆盖 `run --fast <file>` 这一种形式 —— 标志异位
    #     等其它形式到这里才试，用 _PX_MEMO_TRIED 避免同一份备忘被白试两遍）
    if [ "${PX_RUN_VERBOSE:-0}" != "1" ] && [ -z "${_PX_MEMO_TRIED:-}" ]; then
        px_memo_try "$abs" "$@" || true
    fi
    # M383-速度：主脚本 AST 在这里解析一次，下面 run_subset_ok（子 shell）与
    #   px_dep_closure → px_import_keys（子 shell）都通过环境变量复用，不再重解析。
    #   解析失败不在这里报错 —— 让 run_subset_ok 按原逻辑报「解析失败」并回落解释轨。
    px_ast_prime "$abs" || true

    # ── M271（晨曦 D1 第 2 条）：**先判源码，再查缓存** ──────────────────────
    #   为什么顺序要紧：若「命中 ⇒ 直接 exec」，则子集判据一旦收紧，老缓存会按
    #   **旧契约**命中 ⇒ 本应被响亮拒绝的脚本悄悄跑起来 = 缓存改变了语义。
    #   契约：一个脚本在任一次运行里「是否被拒」**只由源码决定**（＋运行器契约）。
    #   ⚠️ 代价：每次 --fast 多一次 AST 解析（毫秒级），换的是语义中性 —— 值得。
    local viol
    if ! viol="$(run_subset_ok "$abs")"; then
        echo "[px run --fast] 本脚本含 Mini 子集之外的构造（$viol）⇒ **回落解释轨**" >&2
        echo "  · 理由：缓存只许影响快慢，不许影响语义（解释轨同样会拒绝这些构造）" >&2
        "$PXI_BIN" "$@" "$file"
        return $?
    fi

    local key; key="$(run_cache_key "$abs")"
    # D（晨曦建议）：PX_RUN_VERBOSE=1 打印 key + 依赖清单 —— 出问题能一眼看出缓存里
    #   到底装了哪些输入（命中与未命中都打，命中时另标一行）。
    if [ "${PX_RUN_VERBOSE:-0}" = "1" ]; then
        local -a _dl; _dl=()
        while IFS= read -r _d; do [ -n "$_d" ] && _dl+=("$_d"); done < <(px_dep_closure "$abs")
        echo "[px run --fast] key=$key deps=${#_dl[@]}" >&2
        printf '  · %s\n' "${_dl[@]}" >&2
    fi
    local dir="$RUN_CACHE/$key"
    local prog="$dir/prog"
    local progsum="$dir/prog.sha256"
    # ── M271（晨曦 D1 第 4 条）：**缓存完整性** ─────────────────────────────
    #   命中前校验产物哈希。没有这一步时，「手工写坏/替换缓存条目」会**静默产出
    #   不同的结果** —— 而缓存只许影响快慢。
    #   不符 ⇒ 当作**未命中** ⇒ 重建（重建同样满足契约，且比「响亮失败」体验好）。
    #   M440：判据从「每次全量 sha256(3.1 MB) 27 ms」改成「stat 签名 1 次 ≈1 ms，
    #   签名不符才回落 sha256」。判定强度不降：任何写入都会顶 ctime（用户无法伪造），
    #   sha 仍是权威，只是不再每次都付它的钱。
    if [ -x "$prog" ] && px_prog_intact "$prog" "$progsum"; then
        [ "${PX_RUN_VERBOSE:-0}" = "1" ] && echo "[px run --fast] 缓存命中 key=$key" >&2
        # 备忘写回（此处 deps 还没算 —— 闭包只在**未命中备忘**这条慢路上取一次）
        local -a _mdeps=(); local _md
        while IFS= read -r _md; do [ -n "$_md" ] && _mdeps+=("$_md"); done < <(px_dep_closure "$abs")
        px_memo_write "$abs" "$key" "$prog" "${_mdeps[@]}"
        exec "$prog" "$@"
    fi

    echo "[px run --fast] 首次运行：编译并缓存（此后命中缓存直接 exec，约 30 ms）" >&2
    local work; work="$(mktemp -d "${TMPDIR:-/tmp}/pxrun.XXXXXX")"
    local base; base="$(basename "$abs")"
    # ── M378（晨曦 PX-BUG-20261106-01 A）：**沙箱 = 主脚本 + 项目内依赖闭包** ──
    #   按「公共根」复制并保持相对路径 ⇒ 沙箱内的模块解析与源目录一致（含 ../ 上跳、
    #   .px_modules、子目录 mod.px）。旧实现只 cp 主脚本 ⇒ 依赖缺席 ⇒ 警告+退出 0。
    local -a deps; deps=()
    while IFS= read -r _d; do [ -n "$_d" ] && deps+=("$_d"); done < <(px_dep_closure "$abs")
    [ "${#deps[@]}" -gt 0 ] || deps=("$abs")
    local root; root="$(px_common_root "${deps[@]}")"
    local tree="$work/tree" _rel
    mkdir -p "$tree"
    for _d in "${deps[@]}"; do
        _rel="${_d#"$root"/}"
        mkdir -p "$tree/$(dirname "$_rel")"
        cp -p "$_d" "$tree/$_rel" || {
            echo "[px run --fast] ❌ 依赖复制失败: $_d" >&2; return 1; }
    done
    local sdir; sdir="$(dirname "$abs")"
    local rundir; rundir="$tree"
    [ "$sdir" != "$root" ] && rundir="$tree/${sdir#"$root"/}"
    # 严格模式：依赖已进沙箱 ⇒ 再「找不到模块」就是真缺失，必须**响亮失败**而不是
    #   警告+成功（这正是本缺陷的根）。stdlib 未装全的布局除外（保持旧兼容口径）。
    local -a benv; benv=()
    if [ -n "${PX_STDLIB:-}" ] && [ -d "${PX_STDLIB:-/nonexistent}" ]; then
        benv=("PX_STRICT_MODULE=1")
    fi
    # D：verbose 下补沙箱口径（公共根 / 严格模式），与上面的 key/依赖清单互补
    if [ "${PX_RUN_VERBOSE:-0}" = "1" ]; then
        echo "[px run --fast] 沙箱: root=$root strict=${benv[*]:-off} 文件=${#deps[@]}" >&2
    fi
    # ── M271（晨曦 D1 第 3 条）：编译失败**响亮失败**，禁止回落解释轨 ────────
    #   到这里脚本已确认**在子集内** ⇒ 编译本应成功 ⇒ 失败就是真故障
    #   （编译器 bug / 工具链缺失 / 磁盘）⇒ 回落会把「故障」静默成「慢但正确」
    #   ⇒ 同一个 flag 两种行为、CI 结果随机器状态变化。口径照 `px build`。
    if ! ( cd "$rundir" && env ${benv[@]+"${benv[@]}"} "$PXC_SELF" build "$base" ) >"$work/build.log" 2>&1; then
        echo "[px run --fast] ❌ 编译失败（脚本在 Mini 子集内，本应编译成功）—— **不回落解释轨**" >&2
        echo "  · 日志：$work/build.log（保留供排查）" >&2
        tail -8 "$work/build.log" >&2
        echo "  · 若要强制走解释轨：px run --interp $file" >&2
        return 1
    fi
    # 兜底（严格模式未开时）：诊断文件里出现「找不到模块」⇒ 产物必然在运行期报
    #   未定义 —— **绝不写缓存**（写进去就是本缺陷：缓存固化坏死产物）。
    if grep -qs '找不到模块' "$rundir/build"/*.c.stderr 2>/dev/null; then
        echo "[px run --fast] ❌ 沙箱内仍缺模块 —— 产物必然 R1001，**不写缓存、不回落**" >&2
        grep -hs '找不到模块' "$rundir/build"/*.c.stderr 2>/dev/null | head -5 >&2
        echo "  · 日志：$work/build.log  产物目录：$rundir/build（保留供排查）" >&2
        echo "  · 逃生舱：px build $file（在源目录编译，任意相对路径都能解析）" >&2
        return 1
    fi
    local out="$rundir/build/${base%.px}"
    if [ ! -x "$out" ]; then
        echo "[px run --fast] ❌ 产物缺失（$out）—— 同上，**不回落解释轨**" >&2
        echo "  · 日志：$work/build.log（保留供排查）" >&2
        return 1
    fi
    if ! mkdir -p "$dir" || ! { cp "$out" "$prog.tmp" && mv "$prog.tmp" "$prog" && chmod +x "$prog"; }; then
        # 缓存写不进去（只读 FS / 配额）⇒ 直接跑编译产物：**语义与 --fast 完全一致**
        # （编译产物就是 --fast 的语义），只是下次还要重编。
        # ⚠️ 这**不是**「回落解释轨」—— 回落到解释轨才是语义改变。
        echo "[px run --fast] ⚠️ 缓存写入失败（$dir）⇒ 直接执行编译产物（语义不变）" >&2
        exec "$out" "$@"
    fi
    sha256sum "$prog" 2>/dev/null | cut -c1-16 > "$progsum.tmp" && mv "$progsum.tmp" "$progsum"
    # M440：记下产物的 stat 签名（下次完整性校验走 1 ms 快路）+ 写命中决策备忘
    px_stat_sig "$prog" 2>/dev/null > "$prog.stat.tmp" \
        && mv "$prog.stat.tmp" "$prog.stat" 2>/dev/null
    px_memo_write "$abs" "$key" "$prog" "${deps[@]}"
    rm -rf "$work"
    exec "$prog" "$@"
}

# ============================================================
# M436-2（晨曦 CX 请求 2026-11-23 03:22 · 缺陷 906）· `px --deps <file.px> [--json]`
# ------------------------------------------------------------
# 为什么有它：晨曦的 Ma（构建调度）现在按「脚本所在目录下的**全部** .px」算缓存 key
#   ⇒ 改一个脚本要重编同目录 17 个；一站 200 个脚本时改一处 = 200 次重建 + 640MB
#   产物轮转。她要的是「与 px run --fast 缓存 key **同一个闭包真源**」的**只读**出口，
#   不要她另写一份 import 解析器。
# 口径（关键）：直接复用 px_dep_closure + run_cache_key —— **不许另写一份** import
#   解析器：两份实现必然漂移（M435 缺陷 902 的病根就是「同一件事两份实现」，
#   防护只落在其中一份上）。
# 输出（文本）：
#   file <abs>
#   key  <16 hex>          ← 与 px run --fast 的命中判据**逐字节相同**
#   deps <n>
#   <sha256 前16>  <abs>   ← 每行一个；BFS 闭包顺序，第一行是主脚本自己
# --json：{"file":…,"key":…,"deps":[{"path":…,"sha256_16":…}, …]}
# 退出码：0 成功 / 1 文件不存在或取不到 key / 2 用法错误
# 只读：不建目录、不写缓存、不编译、不跑 pxi。
# ============================================================
cmd_deps() {
    local json=0 file=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json=1; shift ;;
            --) shift; break ;;
            -h|--help) echo "用法: px --deps <file.px> [--json]"; return 0 ;;
            *) file="$1"; shift ;;
        esac
    done
    [ -n "$file" ] || { echo "用法: px --deps <file.px> [--json]" >&2; return 2; }
    [ -f "$file" ] || { echo "[px --deps] 读取文件失败: $file" >&2; return 1; }
    local abs key
    abs="$(readlink -f "$file")"
    key="$(run_cache_key "$abs")" || { echo "[px --deps] 取不到缓存 key: $abs" >&2; return 1; }
    [ "${#key}" -eq 16 ] || { echo "[px --deps] key 形态异常（${#key} 字符）: $key" >&2; return 1; }
    local -a deps=()
    local d
    while IFS= read -r d; do [ -n "$d" ] && deps+=("$d"); done < <(px_dep_closure "$abs")
    [ "${#deps[@]}" -ge 1 ] || { echo "[px --deps] 依赖闭包为空（import 解析失败？）: $abs" >&2; return 1; }
    if [ "$json" = 1 ]; then
        # ⚠️ 这里**不能**用 heredoc 给 python（heredoc 会顶掉 stdin，实测 deps 恒为空）——
        #   依赖列表一律走 argv。教训同「判据读文本时注释里的代码也算代码」：入口也是契约。
        python3 -c '
import hashlib, json, sys
main, key = sys.argv[1], sys.argv[2]
deps = []
for p in sys.argv[3:]:
    try:
        h = hashlib.sha256(open(p, "rb").read()).hexdigest()[:16]
    except OSError as e:
        sys.stderr.write("[px --deps] 读取失败: %s (%s)\n" % (p, e))
        sys.exit(1)
    deps.append({"path": p, "sha256_16": h})
print(json.dumps({"file": main, "key": key, "deps": deps}, ensure_ascii=False))
' "$abs" "$key" "${deps[@]}"
    else
        printf 'file %s\n' "$abs"
        printf 'key  %s\n' "$key"
        printf 'deps %d\n' "${#deps[@]}"
        local p
        for p in "${deps[@]}"; do
            printf '%s  %s\n' "$(sha256sum "$p" 2>/dev/null | cut -c1-16)" "$p"
        done
    fi
}

cmd_run() {
    # M268：显式开关。默认**完全不变**（见文件上方 M268 段的理由）。
    local fast=0
    case "${1:-}" in
        --fast|--cache) fast=1; shift ;;
        --interp)       fast=0; shift ;;
    esac
    local file="${1:-}"; shift 2>/dev/null || true
    if [ -z "$file" ]; then
        echo "用法: px run [--fast|--interp] <file.px> [args...]" >&2
        return 2
    fi
    [ "$fast" = 1 ] && { cmd_run_fast "$file" "$@"; return $?; }
    # M442-S3：`.pxe` 不走解释器 —— 它是编译后的字节码，交给宿主 pxvm 直接执行。
    case "$file" in
        *.pxe) cmd_run_pxe "$file" "$@"; return $? ;;
    esac
    # pxi 约定：**最后一个参数**才是脚本（selfhost/interp.px：`let f = a[len(a) - 1]`），
    # 前置参数按数据文件透传（当前 Mini 子集解释器仅支持单文件）。
    # M106-S4 修正：$file 必须放**末尾**。旧版放首位 → `px run prog.px data.txt`
    # 会把 data.txt 当源码编译，症状是 "未定义变量: 'just'" / "读取文件失败"，
    # 与真实病因（参数顺序）毫不相干，极难定位（本次自测即踩中）。
    # M151（qg-issue 87 第 33 轮 · 缺陷 138 同批）：**不再合并 stderr**。
    #   旧版尾部带 `2>&1`（M86-S0 起就有的顺带写法）⇒ 诊断（`[警告] 找不到模块 …`、
    #   `运行时错误 …`）与程序输出混进同一个流：`px run p.px > data.txt` 会把警告写进
    #   数据文件，`VAR=$(px run p.px)` 会把警告吃进变量。编译轨（pxc）从不合并
    #   （Issue 45：诊断走 stderr ⇒ 不污染 .c 产物），同一工具链两条入口不该两套口径。
    #   需要合并的调用方自己写 `2>&1`（仓库内既有脚本本来就是这么写的）。
    #
    # M271（晨曦 D1 第 5 条）：**发现性提示** —— 默认关会留一个缺口：
    #   那 378× 只有「已经读过文档的人」能拿到，而「跑得慢」的人恰恰最不会去翻文档。
    #   本提示**不改默认、不编译、不影响 CI 计时**，只把能力放到需要它的人眼前。
    #   实现用 bash 内建 `SECONDS`（**零 fork**）—— 秒起场景（4.7 ms）多 fork 一次
    #   `date` 就是 +40% 开销，这条提示不能自己变成瓶颈。
    # M429（缺陷 878）：**px 不再「杀父留孙」** —— 解释轨必须把信号转给 pxi。
    #   修前形状（实锤 2026-11-21 15:50 · /tmp/m429）：
    #     px(3251927) ── child ──> pxi(3251933) 监听 :18931
    #     kill -TERM 3251927 ⇒ px 退出、**pxi 照旧 LISTEN**（端口永不释放、进程永久孤儿）
    #   为什么不是简单加 `exec`：M271 的发现性提示要在**子进程退出之后**打印耗时，
    #   exec 之后脚本就没机会说话了（那 378× 只有读过文档的人能拿到 —— 缺陷 470 的口径）。
    #   ⇒ 保留 fork，补三件事：① 转发 INT/TERM/HUP/QUIT 给子进程；② 等子进程**真消失**
    #     再返回（被 trap 打断的 wait 会提前返回）；③ 只有正常退出才打提示。
    #   ⚠️ 转发不到的情形：px 自身被 SIGKILL（不可捕获）⇒ 孙进程仍会孤儿 —— 文档写明。
    #   ⚠️ 组杀（kill -9 -<pgid>）本来就有效，本轮只补「单杀父进程」这条最容易被写进示例的路。
    local _t0=$SECONDS _rc=0 _el=0 _child=0 _sig=0 _n=0
    _px_fwd() {
        [ "$_sig" = 0 ] && _sig="$1"
        if [ "$_child" -gt 0 ] && kill -0 "$_child" 2>/dev/null; then
            kill -"$1" "$_child" 2>/dev/null || true
        fi
    }
    trap '_px_fwd TERM' TERM
    trap '_px_fwd INT'  INT
    trap '_px_fwd HUP'  HUP
    trap '_px_fwd QUIT' QUIT
    # M436（缺陷 905）：**异步子进程的 stdin 必须继承调用方的 stdin**。
    #   病灶（晨曦 2026-11-23 01:35 报 · 本地复现）：`printf 'hello=world' | px run t.px`
    #   解释轨读到 len=0，而 `px run --fast` 与 `bootstrap/pxi` 直跑都是 11。
    #   原因：M429 为了能转发信号，把直调改成 `"$PXI_BIN" … &`；而 bash 在**非交互**
    #   模式下对异步命令默认把 fd0 接到 /dev/null（无 job control）⇒ pxi 拿到空 stdin，
    #   管道内容被静默丢弃（不报错、不阻塞 —— 最难查的一类）。**与 M429 无关的回归**：
    #   M429 之前是前台直调，stdin 天然继承，所以这条直到 M429 之后才出现。
    #   修法：`0<&0` 显式把当前 stdin 复制给子进程。不改任何开关，也不影响 M429 的
    #   「kill px ⇒ pxi 一起消失」（那条由 trap + wait 循环负责，已复验）。
    #   门：`m436_pxrun_stdin`（三轨对拍 + /dev/null 不阻塞 + 负控撤 0<&0 必红）。
    "$PXI_BIN" "$@" "$file" 0<&0 &
    _child=$!
    while :; do
        wait "$_child"; _rc=$?
        kill -0 "$_child" 2>/dev/null || break
        # 转发过信号而子进程 5 秒仍未退（0.2s × 25）⇒ 兜底 KILL，不许 px 挂死在这里
        _n=$((_n + 1))
        if [ "$_n" -ge 25 ]; then
            kill -KILL "$_child" 2>/dev/null || true
            wait "$_child"; _rc=$?
            break
        fi
        sleep 0.2
    done
    trap - TERM INT HUP QUIT
    _el=$((SECONDS - _t0))
    # M271 补（缺陷 470）：发现性提示**只对 TTY 说话**。
    #   修前无条件写 stderr ⇒ 任何 `px run x.px > out 2>&1` 的单流捕获都会多出一行
    #   （实测：examples/m148_ieee_div 的「三轨输出逐字节一致」当场判红 —— 提示行混进
    #    被 diff 的解释轨输出里）。**发现性提示的前提是不改变任何可观测输出** ——
    #   它是给人看的，不是给脚本看的。
    #   `PX_RUN_HINT=1` 可强制打开（供门做动态断言）；非 TTY 且未强制 ⇒ 不打。
    #   M429：被信号收走的那一路不打提示（用户是在停服务，不是在学习怎么提速）。
    if [ "$_sig" = 0 ] && [ "$_el" -ge "${PX_RUN_HINT_SEC:-2}" ] && { [ -t 2 ] || [ "${PX_RUN_HINT:-0}" = "1" ]; }; then
        echo "提示：本脚本解释执行耗时 ${_el}s。可用 px run --fast 或 px build 获得约 378×（首次编译 +0.5–1 s）" >&2
    fi
    return $_rc
}

cmd_lex() {
    local file="$1"
    "$PXL_BIN" "$file" 2>&1
}

cmd_parse() {
    local file="$1"
    "$PXPAR_BIN" "$file" 2>&1
}

# M64a：px fmt（PuXian 自举格式化器，bootstrap/pxfmt）
cmd_fmt() {
    "$PXFMT_BIN" "$@"
}

# M64b：px lint（PuXian 自举静态检查器，bootstrap/pxlint）
cmd_lint() {
    "$PXLINT_BIN" "$@"
}

# M64c：px doc（PuXian 自举文档生成器，bootstrap/pxdoc）
cmd_doc() {
    "$PXDOC_BIN" "$@"
}

# M64c：px test（PuXian 自举测试运行器，bootstrap/pxtest）
# 注入 PX_PXI：pxtest 内部 os_spawn(bootstrap/pxi) 逐用例执行（语言内编排）
cmd_test() {
    PX_PXI="$PXI_BIN" "$PXTEST_BIN" "$@"
}

# M64c：px bench（PuXian 自举基准工具，bootstrap/pxbench）
cmd_bench() {
    PX_PXI="$PXI_BIN" "$PXBENCH_BIN" "$@"
}

# M65-S2：px lsp（PuXian 自举 LSP 服务器，bootstrap/pxlsp）
# stdio 即 LSP transport：exec 替换进程保留 fd 0/1（编辑器以子进程拉起）。
# 注入 PX_PXCHECK：pxlsp 内部 os_spawn_capture(bootstrap/pxcheck) 做深度诊断
cmd_lsp() {
    PX_PXCHECK="$PXCHECK_BIN" exec "$PXLSP_BIN" "$@"
}

# M65-S4：px mcp（PuXian 自举 MCP 服务器，bootstrap/pxmcp）
# stdio 即 MCP transport：exec 替换进程保留 fd 0/1（agent 以子进程拉起）。
# 注入 PX_BOOT：pxmcp 内部 os_spawn_capture(bootstrap/<工具>) 执行各工具
# （隔离崩溃 + 捕获输出不污染协议 stdout）；test/bench 子进程还需 PX_PXI；
# build 工具还需 PX_PXC（tools/px，M71-S3 交付腿）
cmd_mcp() {
    PX_BOOT="$PXC_HOME/bootstrap" PX_PXI="$PXI_BIN" PX_PXC="$PXC_HOME/tools/px" exec "$PXMCP_BIN" "$@"
}

# ---- M86-S1：px refs（编译器 C 产物引用集提取 —— 自动裁剪的"引用采集"）----
# 原理：pxc build <file> 把 .px 编译为 C（stdout）；所有全局名引用都落成
#   px_get_global("name") 调用串 → 提取即得"被引用全局/native 名集合"。
#   import 递归天然覆盖（resolve 展开后一并生成）；比编译器内打点更可靠
#   （提取的是最终代码生成结果，零漏报），且零编译器改动（不破坏自举）。
# 输出：每行一个名（LC_ALL=C 排序去重）；编译失败 → 空 + 退出 1（装配器退全量）。
cmd_refs() {
    local file="${1:-}"
    [ -n "$file" ] || { echo "用法: px refs <file.px>" >&2; exit 1; }
    [ -f "$file" ] || { echo "错误: 无法读取文件 $file" >&2; exit 1; }
    local c
    c="$(mktemp "${TMPDIR:-/tmp}/px_refs_XXXXXX.c")" || return 1
    local _err; _err="$(px_cc_err_log)"
    if ! "$PXC_BIN" build "$file" > "$c" 2>"$_err"; then
        rm -f "$c"
        echo "错误: 编译失败（$file）—— 自动裁剪退全量" >&2
        tail -20 "$_err" >&2
        return 1
    fi
    # M112-S2（Issue 53）：与 cmd_build 自动裁剪同一口径 —— 必须**同时**提取
    #   FFI 桥函数名（px_str("名")），否则 px refs 与自动裁剪两处结论不一致
    #   （「两处各写一遍」正是本轮收口的病根族）。
    {
        grep -oE 'px_get_global\("([^"]+)"' "$c" \
            | sed 's/px_get_global("//; s/"$//'
        grep -oE 'px_get_global\("ffi_call"\), \(LXValue\[\]\)\{px_str\("[^"]+"\)' "$c" \
            | grep -oE 'px_str\("[^"]+"\)' | sed 's/px_str("//; s/")$//'
    } | LC_ALL=C sort -u
    rm -f "$c" "$_err"
}

# ---- 入口 ----
cmd="${1:-help}"
case "$cmd" in
    build) shift; cmd_build "$@" ;;
    run)   shift; [ $# -ge 1 ] || { echo "用法: px run <file.px>" >&2; exit 1; }; cmd_run "$@" ;;
    # M436-2（缺陷 906）：依赖闭包 + 缓存 key 的只读出口（与 px run --fast 同一真源）
    --deps|deps) shift; cmd_deps "$@" ;;
    lex)   shift; [ $# -ge 1 ] || { echo "用法: px lex <file.px>" >&2; exit 1; }; cmd_lex "$1" ;;
    parse) shift; [ $# -ge 1 ] || { echo "用法: px parse <file.px>" >&2; exit 1; }; cmd_parse "$1" ;;
    fmt)   shift; [ $# -ge 1 ] || { echo "用法: px fmt <file.px> [-w] [--check] [--diff]" >&2; exit 1; }; cmd_fmt "$@" ;;
    lint)  shift; [ $# -ge 1 ] || { echo "用法: px lint <file.px> [--json] [--strict]" >&2; exit 1; }; cmd_lint "$@" ;;
    doc)   shift; [ $# -ge 1 ] || { echo "用法: px doc <file.px> [--output out.md]" >&2; exit 1; }; cmd_doc "$@" ;;
    test)  shift; [ $# -ge 1 ] || { echo "用法: px test <file.px> [filter] [--list]" >&2; exit 1; }; cmd_test "$@" ;;
    bench) shift; [ $# -ge 2 ] || { echo "用法: px bench <file.px> <func> [--count N] [--repeat R]" >&2; exit 1; }; cmd_bench "$@" ;;
    lsp)   shift; cmd_lsp "$@" ;;
    mcp)   shift; cmd_mcp "$@" ;;
    refs)  shift; cmd_refs "$@" ;;
    # M152（缺陷 144）：打印当前源码对应的 runtime 缓存目录（**按 rt_key**，不猜 mtime）
    #   用法：px rtcache [cuts...] —— 供 rebake_bin.sh 等"必须链对 runtime"的路径使用。
    rtcache) shift; rt_ensure "${1:-}" "${2:-gcc}" "${3:-0}" ;;
    # M439-1（缺陷 921）：**语义指纹**出口（注释不计入）。rebake_bin.sh / bootstrap_prove_bc.sh 共用。
    #   用法：px norm --join FILE…  → 16hex 语义指纹
    #         px norm --fp FILE…    → 每文件 raw=/sem=/state=
    #         px norm --selftest · --emit c|px FILE · --premise DIR
    #   不可用（缺 cc / 缺 tools/pxnorm.c）⇒ rc=3，调用方必须回落 raw（不许静默当绿）。
    norm)   shift
            _pxnb="$(pxnorm_bin)" || { echo "❌ pxnorm 不可用（缺 cc 或 tools/pxnorm.c）" >&2; exit 3; }
            "$_pxnb" "$@" ;;
    # M153（缺陷 147）：**只算 key 不编译** —— 门用。为什么需要：rtcache 会因为
    #   runtime 编译失败而报错退出，而调用方若把"取不到 key"当成"跳过核对"，
    #   就会在**runtime 链错**的情况下报绿（第 35 轮实测踩中：门打印"⚠️ 取不到
    #   当前 rt_key ⇒ 跳过 runtime 核对"，随后仍输出"✅ 全件源码链一致"）。
    rtkey)   shift; rt_key "${1:-}" "${2:-gcc}" "${3:-0}" ;;
    # M437（缺陷 860）：常驻 worker 协议 —— 直接 exec 解释器（省掉一层 bash 包装）。
    #   任务帧走 stdin，结果帧走 fd 3（见 runtime.c px_pool_spawn / selfhost/interp.px
    #   _wt_worker_loop）。stdout 留给被解释脚本，由 worker 在执行期重定向到捕获文件。
    --worker) shift; exec "$PXI_BIN" --worker ;;
    --version|-v) echo "px $RELEASE_VER";;
    help|--help|-h) usage ;;
    *) echo "未知子命令: $cmd" >&2; usage >&2; exit 1 ;;
esac
