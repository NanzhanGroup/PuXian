#!/usr/bin/env bash
# ============================================================
# px —— PuXian 版工具链（M-B9a：Rust 版退役后的用户入口；M86-S0 起官方命令名
#   px，pxc 为兼容别名 —— tools/pxc → symlink px，历史脚本/文档照跑）
# ------------------------------------------------------------
# 基于自举产物（bootstrap/pxc 编译器 + bootstrap/pxi 解释器），
# 完全无需 Rust 工具链。行为对齐 Rust 版 px：
#   px build <file.px>                    编译为静态二进制（<dir>/build/<name>）
#                                          M91 起默认 = VM 字节码轨（compiler_vm
#                                          --emit-c → BCModule 镜像 → 链 vm.o）；
#                                          --c / PX_BUILD_ENGINE=c = C 轨逃生舱
#   px build --no-quic <file.px>          裁剪 QUIC/H3（去掉 ngtcp2/openssl 依赖，
#                                           runtime 侧 -DPX_NO_QUIC，M57-S4 边缘设备用）
#   px build --target <arch> <file.px>        高层交叉开关（M71-S2，对齐 GOOS/GOARCH）：
#                                           arch ∈ x86_64|aarch64|armv7|riscv64，自动折叠
#                                           cc/mbedtls-lib/sqlite-obj/zlib-lib/--no-quic
#                                           （aarch64 库仓库预置；armv7/riscv64 先 cross_multiarch）
#   px build --target x86_64-windows <file.px>  OS 维度交叉（Issue 14 W1，对齐 GOOS/GOARCH
#                                           双维心智）：mingw/zig cc 出 PE .exe，折叠
#                                           cc=x86_64-w64-mingw32-gcc + lib-windows 库布局，
#                                           默认 --no-quic（QUIC 交叉 Windows 暂裁剪）
#   px build --cc <cc> [--mbedtls-lib <dir>] [--sqlite-obj <file>] --no-quic <file.px>
#                                           交叉编译（M57-S4）：cc 指定交叉编译器，
#                                           mbedtls-lib/sqlite-obj 指定目标架构静态库
#   px build [--zlib-lib <dir>] <file.px>    zlib 外部库目录（M61-S0：缺省按 cc 自动探测，
#                                            gcc→lib，aarch64→lib-aarch64，armv7→lib-armv7，riscv64→lib-riscv64）
#   px run <file.px> [args...]            解释执行（tree-walking，秒起 ≈5 ms）
#   px run --fast <file.px> [args...]     构建缓存：首次编译（≈1 s）→ 此后 exec 产物
#                                         （≈30 ms，**378×**）；含 Mini 子集守卫，
#                                          子集外脚本自动回落解释轨
#   px lex <file.px>                      打印 Token 流（调试，走 PuXian lexer）
#   px parse <file.px>                    打印 AST（调试，走 PuXian parser）
#   px --version / -v                     输出版本号
#   px help                               帮助
# 说明：
#   - build 模式（M91 默认 VM 轨）：compiler_vm --emit-c 生成 BCModule 字节码镜像
#     C（bootstrap/pxc_vm 或 PXC_VM_BIN 覆盖；--c/PX_BUILD_ENGINE=c 逃生舱走
#     bootstrap/pxc fn_* C 文本）→ runtime 预编译 .o 缓存（M71-S1：
#     $PXC_HOME/.rtcache/<key>，key=runtime源×cc×no_quic，命中只编 base.c+链接，
#     二次 build 亚秒；改 runtime/换 cc/切 quic 自动重建）→ gcc 静态链接，
#     参数对齐 Rust 版 run_build（-static -O2 -pthread + sqlite/miniz/mbedtls）
#   - 对拍契约（MINI_SUBSET §五）：build 产物与 Rust 版 px build 逐字节一致
#   - 版本：随 PuXian 编译器演进，用 SELFHOST_VER 标记自举里程碑
#   - M57-S4：交叉编译默认配 --no-quic —— 第三方预编译库（ngtcp2/openssl-quictls）
#     只有 x86_64 版，aarch64 目标需裁剪 QUIC/H3（runtime 加 -DPX_NO_QUIC 条件编译）；
#     mbedtls/sqlite 均纯 C，可用目标架构交叉编译（tools/cross_aarch64.sh）。
#   - M159（R45，缺口 G2）：**宿主机架构自适应** —— 未给 --target 时按 uname -m 取
#     lib-<host> 库布局，宿主非 x86_64 自动 --no-quic 并明确提示（逃生舱 PX_HOST_QUIC=1）；
#     环境变量 PX_HOST_ARCH 可覆盖宿主探测（测试/特殊场景）。⇒ 原生 aarch64 上裸
#     `px build x.px` 直接可用，无需手写 --cc/--mbedtls-lib/--sqlite-obj/--zlib-lib/--no-quic。
#     `px build --print-plan` 打印解析后的计划（不编译），宿主架构这类决策据此可断言。
# ============================================================
set -u
# ── 缺陷 573（M324 补 5）：编译器 stderr 日志**不得**用固定 /tmp 名 ──
#   实锤：CI run 39977180550 · step 90（m324 用 sudo 以 root 跑）
#     tools/px: line 821: /tmp/pxc_gcc_err.log: Permission denied
#     ⇒ gcc 根本没跑起来，却被报成「编译失败: probe.c」（真死因=共享 /tmp 文件）
#   机理：同一 job 内普通用户（runner）与 root 门共用 /tmp/pxc_gcc_err.log；/tmp 是
#   sticky 世界可写目录，文件属主 ≠ 当前 fsuid ⇒ 以 O_CREAT 打开外属主既有文件即 EACCES
#   （fs.protected_regular / ACL 任一开启；GitHub runner 默认 =2）。
#   同族：/tmp/pxc_rtcc.log、/tmp/px_refs_err.log —— 一并收口。
#   口径：每次编译独占一个文件（mktemp，尊重 TMPDIR），成功即删，失败留现场并打印路径。
px_cc_err_log() {
    local f
    f="$(mktemp "${TMPDIR:-/tmp}/.px_cc_err.XXXXXX" 2>/dev/null)" && { printf '%s\n' "$f"; return 0; }
    printf '%s\n' "${TMPDIR:-/tmp}/.px_cc_err.$$"
}
# M71-S4：argv0 自发现 —— readlink 解析符号链接到真实位置（软链安装
# /usr/local/bin/px → 包/tools/px、/usr/local/bin/pxc → 包/tools/pxc（→px）时
# PXC_HOME 仍定位到包根，免 PX_STDLIB）
PXC_SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
PXC_HOME="$(cd "$(dirname "$PXC_SELF")/.." && pwd)"
# stdlib 自动定位：包根存在 stdlib 且用户未显式设 PX_STDLIB → 注入（包外任意 cwd 可用）
if [ -z "${PX_STDLIB:-}" ] && [ -d "$PXC_HOME/stdlib" ]; then
    export PX_STDLIB="$PXC_HOME/stdlib"
fi
# M159（R45）：C 轨编译器路径 —— PX_PXC_BIN 可覆盖（自举出的原生件不在默认位置时用，
#   例：PX_PXC_BIN=/tmp/px-native-bootstrap/pxc PX_BUILD_ENGINE=c px build x.px）
PXC_BIN="${PX_PXC_BIN:-$PXC_HOME/bootstrap/pxc}"
PXI_BIN="${PX_PXI_BIN:-$PXC_HOME/bootstrap/pxi}"   # M372：开发期可指向 /tmp/pxidev（与 PX_PXC_BIN 同口径）
PXL_BIN="$PXC_HOME/bootstrap/pxl"     # lexer.px 编译版（px lex 用）
PXPAR_BIN="$PXC_HOME/bootstrap/pxpar" # parser.px 编译版（px parse 用）
PXFMT_BIN="$PXC_HOME/bootstrap/pxfmt" # fmt_core+pxfmt 编译版（px fmt 用，M64a）
PXLINT_BIN="$PXC_HOME/bootstrap/pxlint" # lint_core+pxlint 编译版（px lint 用，M64b）
PXDOC_BIN="$PXC_HOME/bootstrap/pxdoc"   # pxdoc 编译版（px doc 用，M64c）
PXTEST_BIN="$PXC_HOME/bootstrap/pxtest" # pxtest 编译版（px test 用，M64c）
PXBENCH_BIN="$PXC_HOME/bootstrap/pxbench" # pxbench 编译版（px bench 用，M64c）
PXLSP_BIN="$PXC_HOME/bootstrap/pxlsp"   # pxlsp 编译版（px lsp 用，M65-S2）
PXCHECK_BIN="$PXC_HOME/bootstrap/pxcheck" # pxcheck 诊断器（pxlsp 子进程，M65-S2）
PXMCP_BIN="$PXC_HOME/bootstrap/pxmcp"   # pxmcp 编译版（px mcp 用，M65-S4）
RT_DIR="$PXC_HOME/runtime"
SELFHOST_VER="0.2.445"
SELFHOST_MILESTONE="M-B9a"   # 自举内核血统标识（M87 起用户可见版本=RELEASE_VER，此标识留内部诊断用）

# 用户可见版本号（M87：对齐 go/python 单版本号心智，一行、无括号长文案）。
# 发布包由 make_release.sh 从 git tag 生成 VERSION（如 0.1.0-m86）；源码直跑
# 无此文件 → 退回语义版 SELFHOST_VER。--version 与 usage 头部均用 RELEASE_VER。
RELEASE_VER="$SELFHOST_VER"
if [ -f "$PXC_HOME/VERSION" ]; then
    _RV="$(cat "$PXC_HOME/VERSION" 2>/dev/null || true)"
    [ -n "$_RV" ] && RELEASE_VER="$_RV"
    unset _RV
fi

# ══════════════════════════════════════════════════════════════
# M440：热路径前移 —— **`px run --fast` 命中时在文件最前面 exec**
# ------------------------------------------------------------
# 为什么必须放在这里（实测依据，2026-11-24）：bash 是「逐条解析→执行」，
#   `exec` 之后**后面的函数定义不会再被解析**。把备忘命中放在文件开头，
#   就顺手省掉了「解析 124 KB 入口」的 35 ms —— 而这是纯结构收益，不复制任何实现。
#   （放在 usage() 之后、或放在 cmd_run_fast 里，都要先付这 35 ms。）
# 触发条件严格限定在 `px run --fast|--cache <file> [args...]` 这一种形式；
#   其它一切形式（包括 --verbose / 标志异位 / 其它子命令）**原样落到**下面的完整实现，
#   行为与加这段之前逐字节相同。
# ══════════════════════════════════════════════════════════════
RUN_CACHE="${PX_RUNCACHE_DIR:-$PXC_HOME/.runcache}"

# ══════════════════════════════════════════════════════════════
# M440：`px run --fast` **命中决策备忘**（热态 192 ms → 实测 40 ms）
# ------------------------------------------------------------
# 口径（不变式）：**缓存只许影响快慢，不许影响语义**。
#   失效判据 = 所有会影响产物的输入的 stat 签名（size:inode:mtime:ctime，**纳秒级**）
#   逐项相等；任一不等 ⇒ 落回原全量路径（并重写备忘）。
#   ctime 是权威：Linux 上用户改不了 ctime（utimensat 只改 atime/mtime，改它们本身
#   会把 ctime 顶到当前）⇒ 「改内容后把 size/mtime 复原」照样被抓到。
#   设计说明 / 覆盖输入清单 / 已知边界：见下方 px_memo_write 上方的长注释与 CHANGELOG M440。
#   逃生口：PX_RUN_NOCACHE=1 · PX_RUN_VERBOSE=1（这两者都不走备忘）。
# ══════════════════════════════════════════════════════════════
# 签名口径（**唯一真源**）：size:inode:mtime(纳秒):ctime(纳秒)
#   ⚠️ 必须用 %y/%z（带纳秒的人类可读格式），**不能用 %Y/%Z**（只到秒）——
#   2026-11-24 本机实测踩到：同一秒内覆写产物并复原 mtime ⇒ %Z 完全相同 ⇒ 备忘命中
#   被篡改的产物（exec 报 Exec format error）。换成纳秒级后 ctime 差异可见。
PX_STATFMT='%s:%i:%y:%z'
px_stat_sig() { stat -c "$PX_STATFMT" -- "$@"; }

px_memo_env() {
    printf 'engine=%s|stdlib=%s|strict=%s|pi=%s|pxc=%s|vmb=%s|par=%s|norm=%s|ms=%s|ttl=%s' \
        "${PX_BUILD_ENGINE:-vm}" "${PX_STDLIB:-}" "${PX_STRICT_MODULE:-}" \
        "${PX_PXI_BIN:-}" "${PX_PXC_BIN:-}" "${PXC_VM_BIN:-}" "${PXPAR_BIN_RUN:-${PXPAR_BIN:-}}" \
        "${PX_NORM:-}" "${PX_MOD_STRICT:-}" "${PX_TOOLCHAIN_FP_TTL:-}"
}

# 排障：PX_MEMO_DEBUG=1 时打印「为什么没命中」（门用它做负控断言）
px_memo_why() { [ "${PX_MEMO_DEBUG:-0}" = "1" ] && echo "[px run --fast] memo 未命中：$1" >&2; return 1; }

# 试命中：$1=abs 其余=脚本参数。命中 ⇒ exec（**不返回**）；未命中 ⇒ return 1
px_memo_try() {
    local abs="$1"; shift
    local memo="$RUN_CACHE/idx/${abs#/}/memo"
    [ -f "$memo" ] || { px_memo_why "无备忘文件（$memo）"; return 1; }
    local TAB=$'\t' l ver="" envl="" key="" prog="" r
    local -a L=() paths=() psig=()
    mapfile -t L < "$memo" 2>/dev/null || return 1
    [ "${L[0]:-}" = "#PX-MEMO 1" ] || { px_memo_why "备忘首行不是 #PX-MEMO 1"; return 1; }
    for l in "${L[@]:1}"; do
        case "$l" in
            v"$TAB"*) ver="${l#*"$TAB"}" ;;
            e"$TAB"*) envl="${l#*"$TAB"}" ;;
            k"$TAB"*) key="${l#*"$TAB"}" ;;
            g"$TAB"*) prog="${l#*"$TAB"}" ;;
            p"$TAB"*) r="${l#*"$TAB"}"; psig+=("${r%%"$TAB"*}"); paths+=("${r#*"$TAB"}") ;;
            *) px_memo_why "备忘行无法解析：${l:0:30}"; return 1 ;;
        esac
    done
    [ -n "$key" ] && [ -n "$prog" ] && [ "${#paths[@]}" -gt 0 ] \
        || { px_memo_why "备忘缺 key/prog/输入项"; return 1; }
    [ "$ver" = "$RELEASE_VER" ] || { px_memo_why "版本变了（$ver → $RELEASE_VER）"; return 1; }
    [ "$envl" = "$(px_memo_env)" ] || { px_memo_why "覆盖口环境变了"; return 1; }
    [ -x "$prog" ] || { px_memo_why "产物不存在或不可执行（$prog）"; return 1; }
    local cur
    cur="$(px_stat_sig "${paths[@]}" 2>/dev/null)"
    local -a cl=(); mapfile -t cl <<< "$cur"
    [ "${#cl[@]}" -eq "${#psig[@]}" ] \
        || { px_memo_why "输入项数量变了（${#psig[@]} → ${#cl[@]}：有文件被删/改名）"; return 1; }
    local j
    for j in "${!psig[@]}"; do
        [ "${cl[j]:-}" = "${psig[j]}" ] \
            || { px_memo_why "输入变了：${paths[j]}（签名 ${psig[j]} → ${cl[j]:-空}）"; return 1; }
    done
    if [ "${PX_MEMO_DEBUG:-0}" = "1" ]; then
        echo "[px run --fast] memo 命中 key=$key（${#paths[@]} 项输入签名全等：跳过 AST/子集/key/完整性）" >&2
    fi
    exec "$prog" "$@"
}


case "${1:-}:${2:-}" in
    run:--fast|run:--cache)
        if [ "${PX_RUN_VERBOSE:-0}" != "1" ] && [ -z "${PX_RUN_NOCACHE:-}" ] && [ -n "${3:-}" ]; then
            _px_abs="$(readlink -f "$3" 2>/dev/null || echo "$3")"
            _PX_MEMO_TRIED=1
            px_memo_try "$_px_abs" "${@:4}"
        fi
        ;;
esac

# 产物完整性：stat 签名优先（1 fork ≈1 ms），签名不符才付 sha256(3.1 MB) 的 27 ms
px_prog_intact() { # $1=prog $2=progsum（sha16 记录）⇒ 0=完好；1=不可信（按未命中处理）
    local p="$1" sum="$2" st cur
    [ -f "$sum" ] || { px_memo_why "产物缺 sha 记录（$sum）"; return 1; }
    cur="$(px_stat_sig "$p" 2>/dev/null)"
    [ -n "$cur" ] || { px_memo_why "产物 stat 取不到（$p）"; return 1; }
    st="$p.stat"
    if [ -f "$st" ] && [ "$cur" = "$(cat "$st" 2>/dev/null)" ]; then return 0; fi
    local a b
    a="$(sha256sum "$p" 2>/dev/null | cut -c1-16)"
    b="$(cat "$sum" 2>/dev/null)"
    [ -n "$a" ] && [ "$a" = "$b" ] || { px_memo_why "产物 sha 不符（stat 签名也不符）⇒ 按篡改处理"; return 1; }
    printf '%s\n' "$cur" > "$st.tmp.$$" 2>/dev/null && mv "$st.tmp.$$" "$st" 2>/dev/null
    return 0
}

# 写备忘：$1=abs 主脚本  $2=key  $3=prog  其余=依赖闭包
px_memo_write() {
    local abs="$1" key="$2" prog="$3"; shift 3
    local memo="$RUN_CACHE/idx/${abs#/}/memo" i d
    local -a all=() dirs=()
    all+=("$abs")
    for d in "$@"; do [ "$d" = "$abs" ] || all+=("$d"); done
    all+=("$prog" "$PXC_SELF" "$PXC_HOME/tools/pxnorm.c")
    while IFS= read -r d; do [ -n "$d" ] && all+=("$d"); done < <(px_toolchain_files)
    # ⚠️ bootstrap/ 全部自举件：pxpar（子集判定的载体）、pxc/pxc_vm（编译）都在这里。
    #   少登记一件 = 「换了解析器/编译器仍命中旧结论」—— 与 M271 的「运行器契约」同族。
    for d in "$PXC_HOME"/bootstrap/*; do [ -f "$d" ] && all+=("$d"); done
    # ⚠️ stdlib/*.px 必须逐件登记：px_resolve_import 对 std.* 直接返回空（沙箱复制不漂移），
    #   ⇒ **stdlib 不在依赖闭包里** ⇒ 不登记就会「改了 stdlib 仍命中旧产物」
    #   （M425 补1 缺陷 867 的原形：m302 3B 因此三轨分叉）。口径与 comp_fp 的 glob 一致。
    local sdir="${PX_STDLIB:-$PXC_HOME/stdlib}"
    if [ -d "$sdir" ]; then
        for d in "$sdir"/*.px; do [ -f "$d" ] && all+=("$d"); done
        dirs+=("$sdir")
    fi
    dirs+=("$RT_DIR" "$RT_DIR/third_party/miniz" "$RT_DIR/third_party/sqlite3" \
           "$PXC_HOME/bootstrap" "$PXC_HOME/tools" "$PXC_HOME")
    for d in "$abs" "$@"; do
        local dd; dd="$(dirname "$d")"
        dirs+=("$dd")
        [ -d "$dd/.px_modules" ] && dirs+=("$dd/.px_modules")
    done
    all+=("${dirs[@]}")
    # ⚠️ 只登记**当场存在**的项：stat 对缺失路径不输出行 ⇒ 若登记了不存在的项，
    #   比对时行数错位（首版实测：VERSION 不存在 ⇒ 63 行 vs 62 行 ⇒ 永远不命中）。
    #   一个「当时不存在、后来出现」的文件由**所在目录的 mtime**兜住（建/删都会改）。
    local -a ex=()
    for d in "${all[@]}"; do [ -e "$d" ] && ex+=("$d"); done
    all=("${ex[@]}")
    local sig
    sig="$(px_stat_sig "${all[@]}" 2>/dev/null)"
    [ -n "$sig" ] || return 0
    local -a sg=(); mapfile -t sg <<< "$sig"
    mkdir -p "${memo%/*}" 2>/dev/null || return 0
    {
        printf '#PX-MEMO 1\nv\t%s\ne\t%s\nk\t%s\ng\t%s\n' \
            "$RELEASE_VER" "$(px_memo_env)" "$key" "$prog"
        for i in "${!sg[@]}"; do
            [ -n "${all[i]:-}" ] || continue
            printf 'p\t%s\t%s\n' "${sg[i]}" "${all[i]}"
        done
    } > "$memo.tmp.$$" 2>/dev/null && mv "$memo.tmp.$$" "$memo" 2>/dev/null
    rm -f "$memo.tmp.$$" 2>/dev/null
    return 0
}


usage() {
    cat <<EOF
px $RELEASE_VER

（M86-S0 起官方命令名为 px；pxc 为兼容别名，等价可用）

用法:
  px build <file.px>                         编译为静态二进制（输出 <目录>/build/<name>）
                                             M444 起构建前做**入口级定义检查**（未定义标识符 ⇒
                                             拒绝构建；PX_SKIP_DEFCHK=1 关 / PX_DEFCHK=warn 降级）
                                              （M91：默认 = VM 字节码轨；--c = C 轨逃生舱）
  px build [--no-quic] [--target <arch>] [--cc <cc>]
            [--mbedtls-lib <dir>] [--sqlite-obj <file>] <file.px>
                                               裁剪/交叉编译选项（M57-S4 / M71-S2）：
                                                 --target <arch|os-arch> 高层交叉开关：x86_64|aarch64|
                                                                  armv7|riscv64|x86_64-windows，自动折叠 cc/
                                                                  mbedtls-lib/sqlite-obj/zlib-lib/
                                                                  --no-quic（显式 flag 优先）
                                                 --full/--max   全能力编译（M86-S2 逃生舱：跳过自动裁剪，
                                                                  runtime 全模块链接 ≈ 9.0M 基线；可与显式
                                                                  --no-xxx 组合 = 显式裁剪其余全能力）
                                                 --vm/--bc       VM 轨（M91 起 = 默认，flag 保留兼容）：
                                                                  编译器 = VM 版 compiler_vm --emit-c，
                                                                  产物 = BCModule 字节码镜像 C → 链 runtime
                                                                  含 vm.o → 程序跑在显式帧 VM 上；默认自动
