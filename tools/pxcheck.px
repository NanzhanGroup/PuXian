# ============================================================
# tools/pxcheck.px —— PuXian 独立诊断器（LSP 用子进程，M65-S2）
# ------------------------------------------------------------
# pxlsp 服务器不自持 parser/lint（parser/lexer 语法错误 = print+panic
# 杀进程，M65-S1 侦查 A）→ 深度诊断必须在子进程做，pxcheck 即该子进程。
# 输出契约（pxlsp 据此解析）：
#   - parse 成功：stdout 输出单行 JSON 数组（lint 诊断），退出码
#     0=无 Error / 1=含 Error（JSON 始终输出，pxlsp 以 stdout 判定）
#   - parse/lex 失败：parser 先 print 错误行再 panic → 进程退出码 1，
#     stdout+stderr 含错误行（"L:C: 语法错误 CODE: msg" / "错误: L:C:
#     词法错误 CODE: msg"），pxlsp 按文本模式解析（无 JSON）
#   - 文件不可读/参数错：stderr 提示，退出码 2
# JSON 数组元素：{"code","level","line","col","message"}
#   code = L001-L008 / 内置错误码；level = "E" | "W"；line/col = 1-based
# ⚠️ 范围（M114 尾显式声明）：**只做 lint 层**（规则 L001-L008）+ 词法/语法错误 + import 名收集；
#   **不含**编译期静态语义层 E3002/E3003/E3004（那属编译器，两轨均已实现，见 qg-issue 46）。
#   故对 `let x = 1` / `x = 2` 这类语义负例，本工具输出 `[]` 且 rc=0 —— 这是**契约内行为**，
#   不是静默放行。**--semantic（M115 · qg-issue 65）**：显式开启后，本工具再起一次编译器
#   （默认 VM 轨 pxc_vm --emit-c，stdout 丢弃 / stderr 分离捕获），把编译期语义诊断
#   （E3002/E3003/E3004…）**并入同一个 JSON 数组**，level=E 且整体 rc=1。
#   ⚠️ 位置限制（不假装）：编译器**目前不输出行/列**（共享语义层 cg_perr 只打印
#     `编译错误 CODE: msg`）⇒ 语义类诊断一律上报 line=1/col=1，message 正文与
#     `px build` 的 stderr **逐字一致**。位置缺口属编译器侧，非本工具可闭合。
#   ⚠️ 不静默放行：编译器找不到 → level=W 的 L000 显式上报；编译器 rc≠0 却无
#     可解析诊断行 → E3000 + 原始首行，绝不返回空数组当作"语义无错"。
#   编译器定位：PX_SEMANTIC_BIN → 本程序同目录 pxc_vm → 同目录 pxc → PATH pxc_vm。
# 用法（编译版）：pxcheck <file.px> [--base <dir>] [--semantic] [--version]
#   --base：import 名收集的解析根目录（LSP 文档在临时目录但 import 相对
#   真实文件所在目录，M65-S2 决策）——缺省用文件自身目录（pxlint 语义）
# 架构：同 pxlint（import parser + lint_core，主文件声明全局），仅输出
#   契约不同（LSP 化 JSON）。lint 规则 L001-L008 复用 lint_core.px。
# 构建：tools/pxc build tools/pxcheck.px → cp tools/build/pxcheck bootstrap/pxcheck
# ============================================================
import "../selfhost/parser.px"
import "lint_core.px"
# ---------- lex/parser 全局状态（import 不合并顶层 let，主文件声明） ----------
var g_src = ""
var g_len = 0
var g_pos = 0
var g_line = 1
var g_col = 1
var g_indent_stack = [0]
var g_at_line_start = true
var g_toks = []
var g_count = 0
var g_pending = []
let KEYWORDS = {"let": "let", "var": "var", "const": "const", "def": "def", "fn": "fn", "struct": "struct", "enum": "enum", "trait": "trait", "impl": "impl", "match": "match", "case": "case", "if": "if", "elif": "elif", "else": "else", "for": "for", "while": "while", "in": "in", "and": "and", "or": "or", "not": "not", "return": "return", "break": "break", "continue": "continue", "import": "import", "from": "from", "pub": "pub", "as": "as", "spawn": "spawn", "chan": "chan", "send": "send", "recv": "recv", "select": "select", "true": "true", "false": "false", "null": "null", "None": "null", "self": "self", "capture": "capture", "extern": "extern"}  # noqa
let CTRL_ALL = "\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{b}\u{c}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f}\u{7f}\u{80}\u{81}\u{82}\u{83}\u{84}\u{85}\u{86}\u{87}\u{88}\u{89}\u{8a}\u{8b}\u{8c}\u{8d}\u{8e}\u{8f}\u{90}\u{91}\u{92}\u{93}\u{94}\u{95}\u{96}\u{97}\u{98}\u{99}\u{9a}\u{9b}\u{9c}\u{9d}\u{9e}\u{9f}"  # noqa
var p_toks = []
var p_pos = 0
var g_semantic = 0  # --semantic：并入编译器语义诊断（M115 · qg-issue 65）
var g_self = ""  # argv[0]（同目录编译器定位用）
# ---------- 内置函数/构造器已知名 ----------
# 名册**单一事实源**：lint_core.px 的 BUILTIN_NAMES（本文件 import 取用，与 pxlint 同源）。
# 源 = runtime 注册表（tools/gen_builtin_list.sh 派生），门 = selfhost/builtin_list_check.sh。
# ---------- 目录/import 名收集（L002 免误报；同 pxlint） ----------
def px_dirname(path):
    var i = len(path) - 1
    while i >= 0:
        if path[i] == "/":
            if i == 0:
                return "/"
            return path[0:i]
        i -= 1
    return "."
def px_stdlib_dir():
    let e = env("PX_STDLIB")
    if e != null and e != "" and exists(e):
        return e
    # M188-STDLIB（缺陷 210）：删硬编码开发机路径（同 pxlint）
    let sp = os_self_path()
    if sp != null and len(sp) > 0:
        let self_std = px_dirname(sp) + "/../stdlib"
        if exists(self_std):
            return self_std
    let cands = ["stdlib", "./stdlib", "../stdlib", "../../stdlib"]
    var i = 0
    while i < len(cands):
        let c = cands[i]
        if exists(c):
            return c
        i += 1
    return null
def px_mod_candidates(module, base):
    let first = lc_unq(module[0])
    if first == "std" and len(module) >= 2:
        let d2 = px_stdlib_dir()
        if d2 == null:
            return []
        var p = d2
        var si = 1
        while si < len(module):
            p += "/" + lc_unq(module[si])
            si += 1
        return [p + ".px", p + "/mod.px"]
    if len(module) == 1 and (contains(first, "/") or contains(first, ".px")):
        var p2 = first
        if not (len(first) > 0 and first[0] == "/"):
            p2 = base + "/" + first
        return [p2]
    var p3 = base
    var si2 = 0
    while si2 < len(module):
        p3 += "/" + lc_unq(module[si2])
        si2 += 1
    let out3 = [p3 + ".px", p3 + "/mod.px"]
    let mc = px_modules_cands(module, base)
    var mi = 0
    while mi < len(mc):
        out3.append(mc[mi])
        mi += 1
    return out3
# M171：`.px_modules` 包布局（spec §8.6 / registry 规范；同 pxlint，勿漂移）
def px_modules_cands(module, base):
    var segs = ""
    var i = 0
    while i < len(module):
        segs += "/" + lc_unq(module[i])
        i += 1
    let out = []
    let root = base + "/.px_modules"
    out.append(root + segs + ".px")
    out.append(root + segs + "/mod.px")
    if exists(root):
        let entries = list_dir(root)
        var j = 0
        while j < len(entries):
            # list_dir 返回目录项名（非全路径）⇒ 补 root 前缀（同 pxlint）
            var ent = entries[j]
            if not contains(ent, "/"):
                ent = root + "/" + ent
            out.append(ent + segs + ".px")
            out.append(ent + segs + "/mod.px")
            j += 1
    return out
def px_scan_imports(path, known, visited):
    if visited.has(path):
        return
    visited[path] = 1
    if not exists(path):
        return
    let src = read_file(path)
    p_toks = lex_tokens(src)
    p_pos = 0
    let ast = parse_program()
    let sts = ast[1]
    let decls = lc_decl_names(sts)
    var si = 0
    while si < len(decls):
        lc_dset(known, decls[si])
        si += 1
    let base = px_dirname(path)
    var ii = 0
    while ii < len(sts):
        let st3 = sts[ii]
        if st3[0] == "Import":
            let cands = px_mod_candidates(st3[1], base)
            var ci = 0
            while ci < len(cands):
                if exists(cands[ci]):
                    px_scan_imports(cands[ci], known, visited)
                    ci = len(cands)
                ci += 1
        ii += 1
# base_root：import 名收集根目录（pxlsp 传 --base；缺省=文件自身目录）
def px_collect_import_names(items, known, base_root):
    let visited = lc_dnew()
    var i = 0
    while i < len(items):
        let st = items[i]
        if st[0] == "Import":
            let cands = px_mod_candidates(st[1], base_root)
            var ci = 0
            while ci < len(cands):
                if exists(cands[ci]):
                    px_scan_imports(cands[ci], known, visited)
                    ci = len(cands)
                ci += 1
        i += 1
# ---------- 语义诊断（M115 · qg-issue 65）：起编译器，stderr 分离捕获 ----------
# 编译器定位：PX_SEMANTIC_BIN → 本程序同目录 pxc_vm → 同目录 pxc → PATH pxc_vm
def px_semantic_bin():
    let e1 = env("PX_SEMANTIC_BIN")
    if e1 != null and e1 != "":
        return e1
    let d = px_dirname(g_self)
    if d != "" and d != ".":
        if exists(d + "/pxc_vm"):
            return d + "/pxc_vm"
        if exists(d + "/pxc"):
            return d + "/pxc"
    return "pxc_vm"
# 编译器 stderr 文本 → 诊断数组（只取 `编译错误 CODE: msg` 行；位置见文件头说明）
def px_sem_lines(text):
    let out = []
    let lines = split(text, "\n")
    var i = 0
    while i < len(lines):
        let ln = trim(lines[i])
        if starts_with(ln, "编译错误 "):
            let toks = split(ln, " ")
            if len(toks) >= 2:
                let head = toks[1]
                let code = split(head, ":")[0]
                let msg = trim(replace(ln, "编译错误 " + head + " ", ""))
                let jo = {"code": code}
                jo["level"] = "E"
                jo["line"] = 1
                jo["col"] = 1
                jo["message"] = msg
                out.append(jo)
        i += 1
    return out
# 编译一次（--emit-c 产物丢弃）→ 语义诊断；不可用/异常显式上报，不静默放行
def px_semantic_diags(file):
    let bin = px_semantic_bin()
    var ok = false
    if contains(bin, "/"):
        ok = exists(bin)
    else:
        let probe = os_capture("command", ["-v", bin])
        ok = probe["rc"] == 0
    if not ok:
        let jo = {"code": "L000"}
        jo["level"] = "W"
        jo["line"] = 1
        jo["col"] = 1
        jo["message"] = "语义检查不可用：未找到编译器 '" + bin + "'（--semantic 本次未生效，可用 PX_SEMANTIC_BIN 指定绝对路径）"
        let only = [jo]
        return only
    let r = os_capture(bin, ["--emit-c", file])
    let ds = px_sem_lines(r["stderr"])
    if len(ds) > 0:
        return ds
    if r["rc"] != 0:
        var raw = trim(r["stderr"])
        if raw == "":
            raw = "编译器以 rc=" + str(r["rc"]) + " 退出且无 stderr 正文"
        let fs = split(raw, "\n")
        let je = {"code": "E3000"}
        je["level"] = "E"
        je["line"] = 1
        je["col"] = 1
        je["message"] = fs[0]
        let only2 = [je]
        return only2
    let empty = []
    return empty
# ---------- 主流程：诊断 JSON（仅 stdout 单行） ----------
def px_err(msg):
    write(2, msg + "\n")
def px_run(file, base_root):
    if not exists(file):
        px_err("pxcheck: 无法读取文件 '" + file + "'")
        exit(2)
    let src = read_file(file)
    p_toks = lex_tokens(src)
    p_pos = 0
    let ast = parse_program()
    let items = ast[1]
    let known = lc_dnew()
    var bi = 0
    while bi < len(BUILTIN_NAMES):
        lc_dset(known, BUILTIN_NAMES[bi])
        bi += 1
    lc_dset(known, "pi")
    lc_dset(known, "e")
    px_collect_import_names(items, known, base_root)
    let diags = []
    lc_check_program(items, src, known, diags)
    let out = []
    var errs = 0
    var di = 0
    while di < len(diags):
        let d = diags[di]
        let jo = {"code": d[0]}
        jo["level"] = d[1]
        jo["line"] = d[2]
        jo["col"] = d[3]
        jo["message"] = d[4]
        out.append(jo)
        if d[1] == "E":
            errs += 1
        di += 1
    if g_semantic == 1:
        let sds = px_semantic_diags(file)
        var sj = 0
        while sj < len(sds):
            out.append(sds[sj])
            if sds[sj]["level"] == "E":
                errs += 1
            sj += 1
    print(json_stringify(out))
    if errs > 0:
        exit(1)
    exit(0)
def usage():
    print("pxcheck —— PuXian 独立诊断器（LSP 子进程，M65-S2）")
    print("用法: pxcheck <file.px> [--base <dir>] [--semantic] [--version]")
    print("  --semantic  并入编译期语义诊断（E3002/E3003/E3004…；位置一律 1/1，见文件头）")
    print("输出: parse 成功 → stdout JSON 诊断数组；parse 失败 → 文本错误行")
def main():
    let as_ = args()
    # 编译版 args() 首元素 = 程序自身路径，用户参数自 i=1 起
    var file = ""
    var base_root = ""
    if len(as_) > 0:
        g_self = as_[0]
    var i = 1
    while i < len(as_):
        let a = as_[i]
        if a == "--version" or a == "-v":
            print("pxcheck 0.1.0 (普贤 PuXian diagnostics · M65-S2)")
            exit(0)
        elif a == "--help" or a == "-h":
            usage()
            exit(0)
        elif a == "--base":
            if i + 1 < len(as_):
                i += 1
                base_root = as_[i]
            else:
                px_err("pxcheck: --base 缺目录")
                exit(2)
        elif a == "--semantic":
            g_semantic = 1
        elif starts_with(a, "-"):
            px_err("pxcheck: 未知选项 '" + a + "'")
            usage()
            exit(2)
        elif file == "":
            file = a
        i += 1
    if file == "":
        usage()
        exit(2)
    if base_root == "":
        base_root = px_dirname(file)
    px_run(file, base_root)
