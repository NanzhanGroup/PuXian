# ============================================================
# tools/routegen.px —— 文件即路由生成器（M43）
# ------------------------------------------------------------
# 用法（解释器无 argv，用环境变量传参）：
#   PX_APP_DIR=examples/m43_webapp bootstrap/pxi run tools/routegen.px
# 或包装脚本：tools/routegen <app_dir>
#
# 功能：递归扫描应用目录 *.px → std.webroute.wr_parse_file 解析路由
#       → 扫描 handler 顶部 `# rate_limit: max/window` 注释（限流）
#       → 检测 middleware.px（导出 global_middleware）
#       → 生成 <app_dir>/generated_routes.px（import + route 注册）
#
# 双模式：Mini 子集编写（list_dir/read_file/exists/env 白名单内），
#       pxi 解释器直接跑；也可 pxc build 编译为静态二进制。
# 约定：应用目录只放 .px 文件与子目录（static/、build/、_开头 自动跳过）；
#       数据文件放 static/ 或应用目录外。
# ============================================================
import std.webroute
# ---- 递归收集 *.px 相对路径（排除 build/ static/ _开头 私有）----
def rg_walk(dir_path, prefix, out):
    let entries = list_dir(dir_path)
    var i = 0
    while i < len(entries):
        let name = entries[i]
        if name == "build":
            i += 1
            continue
        if name == "static":
            i += 1
            continue
        if starts_with(name, "_"):
            i += 1
            continue
        let rel = prefix + name
        if ends_with(name, ".px"):
            out.append(rel)
        else:
            # 子目录递归（约定：非 .px 项均为目录）
            rg_walk(dir_path + "/" + name, rel + "/", out)
        i += 1
# ---- 解析 handler 顶部限流注释：`# rate_limit: max/window_sec` ----
# 返回 {"max", "window_sec"} 或 null
def rg_rate_limit(app_dir, rel):
    let content = read_file(app_dir + "/" + rel)
    let lines = split(content, "\n")
    var i = 0
    while i < len(lines) and i < 20:
        let line = trim(lines[i])
        if starts_with(line, "# rate_limit:"):
            let rest = trim(line[13:len(line)])
            let parts = split(rest, "/")
            if len(parts) == 2:
                return {"max": int(parts[0]), "window_sec": int(parts[1])}
            return null
        i += 1
    return null
# ---- 生成 generated_routes.px ----
def rg_generate(app_dir):
    let files = []
    rg_walk(app_dir, "", files)
    # 1. 解析路由 + 检测 middleware
    let routes = []
    var has_middleware = false
    var i = 0
    while i < len(files):
        let rel = files[i]
        let r = wr_parse_file(rel)
        if r != null:
            let opts = rg_rate_limit(app_dir, rel)
            routes.append({"rel": rel, "method": r["method"], "pattern": r["pattern"], "fnname": r["fnname"], "opts": opts})  # noqa: 跨行 dict 非法，语言强制单行
        elif rel == "middleware.px":
            has_middleware = true
        i += 1
    # 2. 重复检测（fnname 全局唯一；method+pattern 唯一）
    var j = 0
    while j < len(routes):
        var k = j + 1
        while k < len(routes):
            let a = routes[j]
            let b = routes[k]
            if a["fnname"] == b["fnname"]:
                var r1 = "routegen 错误: fnname 重复 " + a["rel"]
                r1 += " 与 " + b["rel"] + " -> " + a["fnname"]
                print(r1)
                exit(1)
            if a["method"] == b["method"] and a["pattern"] == b["pattern"]:
                var r2m = "routegen 错误: 路由重复 " + a["rel"]
                r2m += " 与 " + b["rel"] + " -> " + a["method"] + " " + a["pattern"]
                print(r2m)
                exit(1)
            k += 1
        j += 1
    # 3. 组装输出（import 只合并定义类语句，route 注册须包进 register_routes() 由主文件调用）
    var out = "# 由 routegen 自动生成（tools/routegen.px），勿手改\n"
    var ii = 0
    while ii < len(routes):
        out += "import \"" + routes[ii]["rel"] + "\"\n"
        ii += 1
    if has_middleware:
        out += "import \"middleware.px\"\n"
    out += "\ndef register_routes():\n"
    if has_middleware:
        out += "    middleware(global_middleware)\n"
    var ri = 0
    while ri < len(routes):
        let r2 = routes[ri]
        var line = "    route(\"" + r2["method"] + "\", \"" + r2["pattern"] + "\", " + r2["fnname"]
        if r2["opts"] != null:
            line += ", {\"rate_limit\": {\"max\": " + str(r2["opts"]["max"])
            line += ", \"window_sec\": " + str(r2["opts"]["window_sec"]) + "}}"
        line += ")\n"
        out += line
        ri += 1
    write_file(app_dir + "/generated_routes.px", out)
    var summary = "✅ generated_routes.px 生成（" + str(len(routes)) + " 路由"
    if has_middleware:
        summary += " + middleware"
    summary += "）"
    print(summary)
# ---- 入口 ----
def main():
    let app_dir = env("PX_APP_DIR")
    if app_dir == null or app_dir == "":
        print("用法: PX_APP_DIR=<app_dir> pxi run tools/routegen.px（或 tools/routegen <app_dir>）")
        exit(1)
    rg_generate(app_dir)
